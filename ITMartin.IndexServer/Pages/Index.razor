@page "/"

@using ITMartin.Shared.UI.Components
@inject IConfiguration Config

<div class="index-page">

    <SectionTitle Title="ITMartin Suite" />

    <ContentCard CssClass="mb-4">
        <p class="mb-0">
            Launch your tools from one place.
        </p>
    </ContentCard>

    <div class="main-category-row mt-4">

        <ContentCard>
            <h4>🎬 FileSorter</h4>
            <p>Organize, scan and export media files</p>
            <a href="@Config["Apps:FileSorterUrl"]"
               class="btn btn-primary mt-3"
               target="_blank">
                Open App
            </a>
        </ContentCard>

        <ContentCard>
            <h4>💰 Budget</h4>
            <p>Personal budget management</p>
            <a href="@Config["Apps:BudgetUrl"]"
               class="btn btn-primary mt-3"
               target="_blank">
                Open App
            </a>
        </ContentCard>

        <ContentCard>
            <h4>🃏 Magic</h4>
            <p>MTG card scanner and collection manager</p>
            <a href="@Config["Apps:MagicUrl"]"
               class="btn btn-primary mt-3"
               target="_blank">
                Open App
            </a>
        </ContentCard>

        <ContentCard>
            <h4>🧾 Receipt</h4>
            <p>Photograph grocery receipts and extract clean item lists</p>
            <a href="@Config["Apps:ReceiptUrl"]"
               class="btn btn-primary mt-3"
               target="_blank">
                Open App
            </a>
        </ContentCard>

        <ContentCard>
            <h4>📚 Library</h4>
            <p>Scan and manage books, DVDs and cartoons</p>
            <a href="@Config["Apps:LibraryUrl"]"
               class="btn btn-primary mt-3"
               target="_blank">
                Open App
            </a>
        </ContentCard>

        <ContentCard>
            <h4>🎵 Chord Finder</h4>
            <p>Detect chords from MP3 files</p>
            <button class="btn btn-secondary mt-3" disabled>
                Coming Soon
            </button>
        </ContentCard>

    </div>

</div>
