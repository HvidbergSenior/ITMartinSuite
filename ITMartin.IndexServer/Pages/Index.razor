@page "/"
@using Microsoft.AspNetCore.Components.Web
@inject IConfiguration Config

<PageTitle>ITMartin Suite</PageTitle>

<div class="idx-page">

    <div class="idx-hero">
        <div class="idx-hero-inner">
            <div class="idx-logo">⚡</div>
            <h1 class="idx-title">ITMartin Suite</h1>
            <p class="idx-sub">Alle dine apps samlet ét sted — byg til dig og dem du kender</p>
        </div>
    </div>

    @* ── MEDIER & FILER ───────────────────────────────────── *@
    <div class="idx-category">
        <div class="idx-cat-header">
            <div class="idx-cat-line"></div>
            <span class="idx-cat-label">Medier &amp; Filer</span>
            <div class="idx-cat-line"></div>
        </div>
        <div class="idx-grid">

            <a class="idx-card" href="@Config["Apps:FileSorterUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a1f35 0%, #0d3b6e 100%)">
                    <div class="idx-preview-icon">🗂️</div>
                    <div class="idx-preview-label">FileSorter</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">FileSorter</div>
                    <div class="idx-card-desc">Sorter og organiser dine mediefiler automatisk med AI-klassificering. Scanner mapper, finder dubletter og eksporterer struktureret til dit bibliotek.</div>
                    <div class="idx-card-tag">Billeder · Video · AI</div>
                    <div class="idx-card-url">@Config["Apps:FileSorterUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:GalleryUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a2820 0%, #0d4a2e 100%)">
                    <div class="idx-preview-icon">🖼️</div>
                    <div class="idx-preview-label">Galleri</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Galleri</div>
                    <div class="idx-card-desc">Gennemse og del dit billedgalleri. Støtter billeder og videoer, organiseret efter år og kategori. Kan deles med familie og venner via privat URL.</div>
                    <div class="idx-card-tag">Billeder · Video · Deling</div>
                    <div class="idx-card-url">@Config["Apps:GalleryUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:CuratorUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a1a2a 0%, #2a2a5a 100%)">
                    <div class="idx-preview-icon">🎬</div>
                    <div class="idx-preview-label">Curator</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Curator</div>
                    <div class="idx-card-desc">Kuratér og organiser dit mediebibliotek. Gennemgå film og videoer, marker favoritter og sæt kategorier på tværs af hele samlingen.</div>
                    <div class="idx-card-tag">Medier · Bibliotek · Organisering</div>
                    <div class="idx-card-url">@Config["Apps:CuratorUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:ScanUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a1015 0%, #3a1535 100%)">
                    <div class="idx-preview-icon">📷</div>
                    <div class="idx-preview-label">Scan</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Scan</div>
                    <div class="idx-card-desc">Universel scanningsapp til at registrere og organisere genstande med kamera. Identificér, kategorisér og gem items i dit personlige register.</div>
                    <div class="idx-card-tag">Scanner · Registrering · AI</div>
                    <div class="idx-card-url">@Config["Apps:ScanUrl"]</div>
                </div>
            </a>

        </div>
    </div>

    @* ── MUSIK ────────────────────────────────────────────── *@
    <div class="idx-category">
        <div class="idx-cat-header">
            <div class="idx-cat-line"></div>
            <span class="idx-cat-label">Musik</span>
            <div class="idx-cat-line"></div>
        </div>
        <div class="idx-grid">

            <a class="idx-card" href="@Config["Apps:MusikUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1e1030 0%, #4a1a7a 100%)">
                    <div class="idx-preview-icon">🎵</div>
                    <div class="idx-preview-label">Martin Musik</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Martin Musik</div>
                    <div class="idx-card-desc">Øv dine egne sange med afspiller, tekst og akkorder synkroniseret. Transponer akkorder med ét tryk, og få AI-coaching til forbedring af tekster og fremførelse.</div>
                    <div class="idx-card-tag">Musik · Akkorder · AI Coach</div>
                    <div class="idx-card-url">@Config["Apps:MusikUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:MusikStudioUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #0d0820 0%, #2a1560 100%)">
                    <div class="idx-preview-icon">🎛️</div>
                    <div class="idx-preview-label">Musik Studio</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Musik Studio</div>
                    <div class="idx-card-desc">Administrer og rediger din musiksamling. Tilføj sange, opdater tekster og akkorder, og organiser dit repertoire med avancerede redigeringsmuligheder.</div>
                    <div class="idx-card-tag">Musik · Redigering · Admin</div>
                    <div class="idx-card-url">@Config["Apps:MusikStudioUrl"]</div>
                </div>
            </a>

        </div>
    </div>

    @* ── ØKONOMI ──────────────────────────────────────────── *@
    <div class="idx-category">
        <div class="idx-cat-header">
            <div class="idx-cat-line"></div>
            <span class="idx-cat-label">Økonomi</span>
            <div class="idx-cat-line"></div>
        </div>
        <div class="idx-grid">

            <a class="idx-card" href="@Config["Apps:BudgetUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a2a10 0%, #2d5a1a 100%)">
                    <div class="idx-preview-icon">💰</div>
                    <div class="idx-preview-label">Budget</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Budget</div>
                    <div class="idx-card-desc">Hold styr på din personlige og familiens økonomi. Registrer udgifter, sæt budgetmål og få overblik over dine forbrug måned for måned.</div>
                    <div class="idx-card-tag">Økonomi · Familie · Oversigt</div>
                    <div class="idx-card-url">@Config["Apps:BudgetUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:ReceiptUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a2010 0%, #3d5a0a 100%)">
                    <div class="idx-preview-icon">🧾</div>
                    <div class="idx-preview-label">Kvittering</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Kvittering</div>
                    <div class="idx-card-desc">Tag et billede af din dagligvarekvittering og lad AI udtrække en ren vareliste. Saml og søg i alle dine kvitteringer på ét sted.</div>
                    <div class="idx-card-tag">Kvitteringer · AI · Dagligvarer</div>
                    <div class="idx-card-url">@Config["Apps:ReceiptUrl"]</div>
                </div>
            </a>

        </div>
    </div>

    @* ── SAMLINGER ────────────────────────────────────────── *@
    <div class="idx-category">
        <div class="idx-cat-header">
            <div class="idx-cat-line"></div>
            <span class="idx-cat-label">Samlinger</span>
            <div class="idx-cat-line"></div>
        </div>
        <div class="idx-grid">

            <a class="idx-card" href="@Config["Apps:MagicUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #200a0a 0%, #6b1a1a 100%)">
                    <div class="idx-preview-icon">🃏</div>
                    <div class="idx-preview-label">Magic</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Magic</div>
                    <div class="idx-card-desc">Scan og administrer din Magic: The Gathering kortsamling. Brug kamera til at registrere kort, se samlingsværdi og søg i alle dine kort.</div>
                    <div class="idx-card-tag">MTG · Samling · Scanner</div>
                    <div class="idx-card-url">@Config["Apps:MagicUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:LibraryUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #0a1a30 0%, #1a3a6a 100%)">
                    <div class="idx-preview-icon">📚</div>
                    <div class="idx-preview-label">Scan Bøger</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Scan Bøger</div>
                    <div class="idx-card-desc">Scan en hel bogreol med kameraet — AI identificerer automatisk bøgerne og registrerer dem i dit bibliotek.</div>
                    <div class="idx-card-tag">Bøger · AI · Kamera</div>
                    <div class="idx-card-url">@Config["Apps:LibraryUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:LibrarySearchUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #0a1520 0%, #0a3050 100%)">
                    <div class="idx-preview-icon">🔍</div>
                    <div class="idx-preview-label">Søg Bøger</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Søg Bøger</div>
                    <div class="idx-card-desc">Søg i alle bøger identificeret fra scannede bogreoler. Find hurtigt en titel eller forfatter på tværs af hele samlingen.</div>
                    <div class="idx-card-tag">Bøger · Søgning · Samling</div>
                    <div class="idx-card-url">@Config["Apps:LibrarySearchUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:MagicCollectionUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #150505 0%, #400d0d 100%)">
                    <div class="idx-preview-icon">👁️</div>
                    <div class="idx-preview-label">Magic Samling</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Magic Samling</div>
                    <div class="idx-card-desc">Vis din Magic: The Gathering samling som et læsbart katalog. Del dit kortbibliotek med andre uden at give adgang til at redigere.</div>
                    <div class="idx-card-tag">MTG · Samling · Deling</div>
                    <div class="idx-card-url">@Config["Apps:MagicCollectionUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:MagazineUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a1000 0%, #4a2d00 100%)">
                    <div class="idx-preview-icon">📰</div>
                    <div class="idx-preview-label">Blade</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Blade</div>
                    <div class="idx-card-desc">Scan og registrer dine blade og magasiner med kameraet. Hold styr på din samling og find nemt tilbage til specifikke udgaver og artikler.</div>
                    <div class="idx-card-tag">Blade · Scanner · Samling</div>
                    <div class="idx-card-url">@Config["Apps:MagazineUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:MagazineSearchUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #120d00 0%, #362000 100%)">
                    <div class="idx-preview-icon">🔎</div>
                    <div class="idx-preview-label">Søg Blade</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Søg Blade</div>
                    <div class="idx-card-desc">Søg i din magasinsamling. Find hurtigt en specifik udgave eller et bestemt emne på tværs af hele din samling af blade.</div>
                    <div class="idx-card-tag">Blade · Søgning · Samling</div>
                    <div class="idx-card-url">@Config["Apps:MagazineSearchUrl"]</div>
                </div>
            </a>

        </div>
    </div>

    @* ── FAMILIE & FÆLLESSKAB ─────────────────────────────── *@
    <div class="idx-category">
        <div class="idx-cat-header">
            <div class="idx-cat-line"></div>
            <span class="idx-cat-label">Familie &amp; Fællesskab</span>
            <div class="idx-cat-line"></div>
        </div>
        <div class="idx-grid">

            <a class="idx-card" href="@Config["Apps:FamilyUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a1020 0%, #4a2060 100%)">
                    <div class="idx-preview-icon">🏠</div>
                    <div class="idx-preview-label">Familie</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Familie</div>
                    <div class="idx-card-desc">Fælles opgavetavle for hele familien. Tilføj, tag og afslut opgaver sammen. Alle kan se hvad der mangler og hvem der gør hvad.</div>
                    <div class="idx-card-tag">Familie · Opgaver · Planlægning</div>
                    <div class="idx-card-url">@Config["Apps:FamilyUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:AdhdUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a2030 0%, #1a4060 100%)">
                    <div class="idx-preview-icon">🧠</div>
                    <div class="idx-preview-label">FindIt</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">FindIt</div>
                    <div class="idx-card-desc">Husk hvor du lagde tingene. Tag et billede og beskriv en genstand — find den igen med en hurtig søgning. Perfekt til dem der glemmer tingenes plads.</div>
                    <div class="idx-card-tag">ADHD · Huskeseddel · Genstande</div>
                    <div class="idx-card-url">@Config["Apps:AdhdUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:ClubUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #101a20 0%, #1a3a50 100%)">
                    <div class="idx-preview-icon">🤝</div>
                    <div class="idx-preview-label">Club</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Club</div>
                    <div class="idx-card-desc">Fælles platform for grupper og foreninger. Del vigtige dokumenter med læsekvittering, planlæg begivenheder, sæt opgaver og skriv opslag — alt samlet ét sted.</div>
                    <div class="idx-card-tag">Forening · Dokumenter · Kalender</div>
                    <div class="idx-card-url">@Config["Apps:ClubUrl"]</div>
                </div>
            </a>

        </div>
    </div>

    @* ── SJOV & UNDERHOLDNING ─────────────────────────────── *@
    <div class="idx-category">
        <div class="idx-cat-header">
            <div class="idx-cat-line"></div>
            <span class="idx-cat-label">Sjov &amp; Underholdning</span>
            <div class="idx-cat-line"></div>
        </div>
        <div class="idx-grid">

            <a class="idx-card" href="@Config["Apps:BarTabUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a1500 0%, #5a4500 100%)">
                    <div class="idx-preview-icon">🍺</div>
                    <div class="idx-preview-label">BarTab</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">BarTab</div>
                    <div class="idx-card-desc">Hold styr på drinks og regninger til fester og arrangementer. Opret deltagere, registrer forbrug og se hvem der skylder hvad.</div>
                    <div class="idx-card-tag">Bar · Drinks · Regninger</div>
                    <div class="idx-card-url">@Config["Apps:BarTabUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:AuctionUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #1a0a00 0%, #5a2000 100%)">
                    <div class="idx-preview-icon">🔨</div>
                    <div class="idx-preview-label">Auktion</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Auktion</div>
                    <div class="idx-card-desc">Afhold live auktioner med realtidsbud. Opret genstande med billeder og startbud — deltagere byder fra deres telefon og vinder ved højeste bud.</div>
                    <div class="idx-card-tag">Auktion · Bud · Live</div>
                    <div class="idx-card-url">@Config["Apps:AuctionUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:MarketUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #001a10 0%, #004a30 100%)">
                    <div class="idx-preview-icon">🏪</div>
                    <div class="idx-preview-label">Marked</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Marked</div>
                    <div class="idx-card-desc">Køb og sælg ting i dit netværk. Upload billeder, sæt en pris eller byd-knap, og kommuniker direkte med sælger. Markér som solgt når handlen er i hus.</div>
                    <div class="idx-card-tag">Køb · Salg · Netværk</div>
                    <div class="idx-card-url">@Config["Apps:MarketUrl"]</div>
                </div>
            </a>

        </div>
    </div>

    @* ── AI VÆRKTØJER ─────────────────────────────────────── *@
    <div class="idx-category">
        <div class="idx-cat-header">
            <div class="idx-cat-line"></div>
            <span class="idx-cat-label">AI Værktøjer</span>
            <div class="idx-cat-line"></div>
        </div>
        <div class="idx-grid">

            <a class="idx-card" href="@Config["Apps:ImageGenUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #0d0820 0%, #2d1060 100%)">
                    <div class="idx-preview-icon">🎨</div>
                    <div class="idx-preview-label">Billedgenerator</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">Billedgenerator</div>
                    <div class="idx-card-desc">Beskriv et billede med ord — AI genererer det. Tilpas med feedback, sæt en bestemt person ind med et foto, og gem det færdige billede til din webshop.</div>
                    <div class="idx-card-tag">AI · Billeder · Webshop</div>
                    <div class="idx-card-url">@Config["Apps:ImageGenUrl"]</div>
                </div>
            </a>

        </div>
    </div>

    @* ── SPIL & GAMING ────────────────────────────────────── *@
    <div class="idx-category">
        <div class="idx-cat-header">
            <div class="idx-cat-line"></div>
            <span class="idx-cat-label">Spil &amp; Gaming</span>
            <div class="idx-cat-line"></div>
        </div>
        <div class="idx-grid">

            <a class="idx-card" href="@Config["Apps:R6AssistantUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #0a1520 0%, #0a3040 100%)">
                    <div class="idx-preview-icon">🎮</div>
                    <div class="idx-preview-label">R6 Assistant</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">R6 Assistant</div>
                    <div class="idx-card-desc">Din personlige assistent til Rainbow Six Siege. Hold styr på operatorer, strategier og holdkonfigurationer til dine næste matches.</div>
                    <div class="idx-card-tag">R6 · Spil · Strategi</div>
                    <div class="idx-card-url">@Config["Apps:R6AssistantUrl"]</div>
                </div>
            </a>

            <a class="idx-card" href="@Config["Apps:R6IntelUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #0d0a1a 0%, #1a1040 100%)">
                    <div class="idx-preview-icon">🕵️</div>
                    <div class="idx-preview-label">R6 Intel</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">R6 Intel</div>
                    <div class="idx-card-desc">Real-time intel og statistik til Rainbow Six Siege. Analysér modstanderens operatorer og styrk din forberedelse til ranked-matches.</div>
                    <div class="idx-card-tag">R6 · Intel · Statistik</div>
                    <div class="idx-card-url">@Config["Apps:R6IntelUrl"]</div>
                </div>
            </a>

        </div>
    </div>

    @* ── KVALITETSSIKRING ─────────────────────────────────── *@
    <div class="idx-category">
        <div class="idx-cat-header">
            <div class="idx-cat-line"></div>
            <span class="idx-cat-label">Kvalitetssikring</span>
            <div class="idx-cat-line"></div>
        </div>
        <div class="idx-grid">

            <a class="idx-card" href="@Config["Apps:TestHubUrl"]" target="_blank">
                <div class="idx-preview" style="background: linear-gradient(135deg, #0a1a10 0%, #1a4020 100%)">
                    <div class="idx-preview-icon">🧪</div>
                    <div class="idx-preview-label">TestHub</div>
                </div>
                <div class="idx-card-body">
                    <div class="idx-card-name">TestHub</div>
                    <div class="idx-card-desc">Koordiner manuelle tests af alle ITMartin-apps. Opret testrunder, tildel opgaver og følg feedback og resultater — alt ét sted.</div>
                    <div class="idx-card-tag">Test · Kvalitet · Feedback</div>
                    <div class="idx-card-url">@Config["Apps:TestHubUrl"]</div>
                </div>
            </a>

        </div>
    </div>

    <div class="idx-footer">
        Bygget af Martin Hvidberg · Kørende på dit eget NAS
    </div>

</div>

<style>
    :root, [data-theme="dark"] {
        --idx-bg: #0a0d14;
        --idx-text: #f0f0f0;
        --idx-muted: #64748b;
        --idx-muted2: #94a3b8;
        --idx-faint: #475569;
        --idx-border: rgba(255,255,255,.08);
        --idx-surface: rgba(255,255,255,.03);
    }
    [data-theme="light"] {
        --idx-bg: #f5f5f7;
        --idx-text: #16181d;
        --idx-muted: #6b7280;
        --idx-muted2: #6b7280;
        --idx-faint: #9ca3af;
        --idx-border: #e2e2e8;
        --idx-surface: #ffffff;
    }

    * { box-sizing: border-box; }
    body { margin: 0; background: var(--idx-bg); color: var(--idx-text); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

    .idx-page { max-width: 1100px; margin: 0 auto; padding: 0 16px 60px; }

    .idx-hero { text-align: center; padding: 60px 16px 48px; }
    .idx-hero-inner { max-width: 600px; margin: 0 auto; }
    .idx-logo { font-size: 52px; margin-bottom: 16px; }
    .idx-title { font-size: 40px; font-weight: 900; margin: 0 0 12px; letter-spacing: -.02em; }
    .idx-sub { font-size: 17px; color: var(--idx-muted); margin: 0; line-height: 1.5; }

