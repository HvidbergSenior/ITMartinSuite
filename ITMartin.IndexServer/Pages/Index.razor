@page "/"

@using Microsoft.AspNetCore.Components.Web
@using ITMartin.Shared.UI.Components
@inject IConfiguration Config

<PageTitle>ITMartin Suite</PageTitle>

<div class="page-container">

    <div style="margin-bottom: 28px;">
        <h1 style="font-size:32px; font-weight:800; margin:0 0 8px;">ITMartin Suite</h1>
        <div class="text-muted">Launch your tools from one place.</div>
    </div>

    <div class="suite-grid">

        <div class="content-card">
            <div class="suite-card-title">🎬 FileSorter</div>
            <div class="suite-card-desc">Organize, scan and export media files</div>
            <a href="@Config["Apps:FileSorterUrl"]" class="btn btn-primary" target="_blank">Open App</a>
        </div>

        <div class="content-card">
            <div class="suite-card-title">💰 Budget</div>
            <div class="suite-card-desc">Personal and family budget management</div>
            <a href="@Config["Apps:BudgetUrl"]" class="btn btn-primary" target="_blank">Open App</a>
        </div>

        <div class="content-card">
            <div class="suite-card-title">🃏 Magic</div>
            <div class="suite-card-desc">MTG card scanner and collection manager</div>
            <a href="@Config["Apps:MagicUrl"]" class="btn btn-primary" target="_blank">Open App</a>
        </div>

        <div class="content-card">
            <div class="suite-card-title">🧾 Receipt</div>
            <div class="suite-card-desc">Photograph grocery receipts and extract clean item lists</div>
            <a href="@Config["Apps:ReceiptUrl"]" class="btn btn-primary" target="_blank">Open App</a>
        </div>

        <div class="content-card">
            <div class="suite-card-title">📚 Library</div>
            <div class="suite-card-desc">Scan and manage books, DVDs and cartoons</div>
            <a href="@Config["Apps:LibraryUrl"]" class="btn btn-primary" target="_blank">Open App</a>
        </div>

        <div class="content-card">
            <div class="suite-card-title">🧠 FindIt</div>
            <div class="suite-card-desc">ADHD helper — remember where you put things</div>
            <a href="@Config["Apps:AdhdUrl"]" class="btn btn-primary" target="_blank">Open App</a>
        </div>

        <div class="content-card">
            <div class="suite-card-title">🎵 Chord Finder</div>
            <div class="suite-card-desc">Detect chords from MP3 files</div>
            <button class="btn btn-secondary" disabled>Coming Soon</button>
        </div>

    </div>

</div>
