@using static Microsoft.AspNetCore.Components.Web.RenderMode

<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        (function () {
            var theme = localStorage.getItem('index_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="manifest" href="/manifest.json" />
    <base href="/" />

    <link rel="stylesheet" href="_content/ITMartin.Shared.UI/css/Shared.css" />
    <link rel="stylesheet" href="app.css" />

    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
<Routes @rendermode="InteractiveServer" />
<script src="_framework/blazor.web.js"></script>
    <div id="components-reconnect-modal">
        <span class="reconnect-msg">🔄 Forbinder igen...</span>
        <span class="reconnect-failed-msg">😴 Forbindelsen er tabt — <button onclick="location.reload()">Genindlæs</button></span>
    </div>

    <button id="themeToggleBtn" title="Skift lys/mørk visning"
            style="position:fixed;bottom:20px;right:20px;z-index:9999;width:52px;height:52px;border-radius:50%;border:2px solid #fff;background:linear-gradient(135deg,#f472b6,#a855f7);color:#fff;font-size:22px;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center">
        🌓
    </button>
    <script>
    (function () {
        var btn = document.getElementById('themeToggleBtn');
        function sync() {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            btn.textContent = current === 'light' ? '🌙' : '☀️';
        }
        btn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('index_theme', next);
            sync();
        });
        sync();
    })();
    </script>
</body>
</html>
