    private static readonly CloudServiceDef[] StorageServices = AllServices.Where(s => s.Group == "lager").ToArray();
    private static readonly CloudServiceDef[] StreamServices  = AllServices.Where(s => s.Group == "stream").ToArray();
    private static readonly CloudServiceDef[] AppsServices    = AllServices.Where(s => s.Group == "apps").ToArray();
    private const decimal RecommendedStoragePrice = 75m; // Google One 2TB family

    // Wizard state
    private int _step = 0;
    private HashSet<string> _selected = new();
    private int _familySize = 2;
    private Dictionary<string, int[]> _planPerPerson = new();
    private string? _stepError;

    private IEnumerable<CloudServiceDef> SelectedServices =>
        AllServices.Where(s => _selected.Contains(s.Id));

    private decimal CurrentTotal =>
        SelectedServices.Sum(svc =>
            _planPerPerson[svc.Id].Where(i => i > 0).Sum(i => svc.Plans[i - 1].Price));

    private decimal StorageCost =>
        SelectedServices.Where(s => s.Group == "lager").Sum(svc =>
            _planPerPerson[svc.Id].Where(i => i > 0).Sum(i => svc.Plans[i - 1].Price));

    private void EnsurePersonPlans(string id)
    {
        if (!_planPerPerson.TryGetValue(id, out var arr) || arr.Length != _familySize)
        {
            var next = new int[_familySize];
            if (arr != null) Array.Copy(arr, next, Math.Min(arr.Length, _familySize));
            _planPerPerson[id] = next;
        }
    }

    private void SetFamilySize(int size)
    {
        _familySize = size;
        foreach (var id in _planPerPerson.Keys.ToList())
        {
            var old = _planPerPerson[id];
            var next = new int[size];
            Array.Copy(old, next, Math.Min(old.Length, size));
            _planPerPerson[id] = next;
        }
    }

    private void Toggle(string id)
    {
        if (!_selected.Remove(id))
        {
            _selected.Add(id);
            EnsurePersonPlans(id);
        }
        _stepError = null;
    }

    private void GoToStep2()
    {
        if (_selected.Count == 0)
        {
            _stepError = "Vælg mindst én tjeneste for at fortsætte.";
            return;
        }
        foreach (var id in _selected) EnsurePersonPlans(id);
        _stepError = null;
        _step = 2;
    }

}
