@page "/shop-upload"
@page "/shop-upload/{LedgerId}"
@page "/laeg-ind"
@layout ITMartinBudget.Server.Layout.KolibriLayout
@inject IConfiguration Config
@* No @rendermode: plain HTML form + fetch() instead of Blazor InputFile, which needs a live SignalR circuit -
   it has got stuck on "Forbinder..." through the Cloudflare tunnel before. *@

<PageTitle>Læg ind – MitBudget</PageTitle>

<details class="k-card mb-box">
    <summary class="mb-sum"><span class="k-card-title">Om siden</span></summary>
    <p>Her lægger du et kontoudtog ind. MitBudget kender selv formatet fra de danske banker. Betalinger, der allerede er lagt ind, bliver sprunget over.</p>
    <p><b>Sådan gør du:</b> hent kontoudtoget i din netbank som CSV-fil (fx under Konti, Eksporter). Vælg filen herunder. Bagefter ser du betalingerne under Kategorier.</p>
</details>

<div class="k-card">
    <h1 class="k-card-title">Læg kontoudtog ind</h1>
    <p class="k-card-sub">Hver konto holdes for sig, fx din egen og forretningens.</p>

    <div class="k-stack">
        <div>
            <label class="k-label" for="ledgerId">Kontoens navn</label>
            <input id="ledgerId" class="k-input" value="@_ledger" autocapitalize="off" autocorrect="off" spellcheck="false" />
        </div>

        <fieldset class="mb-fieldset">
            <legend class="k-label">Hvad bruges kontoen til?</legend>
            <label class="mb-radio"><input type="radio" name="scopeMode" value="Both" checked /> Både privat og forretning</label>
            <label class="mb-radio"><input type="radio" name="scopeMode" value="PrivateOnly" /> Kun privat</label>
            <label class="mb-radio"><input type="radio" name="scopeMode" value="BusinessOnly" /> Kun forretning</label>
            <p class="k-muted mb-small">Vælges kun første gang en konto lægges ind.</p>
        </fieldset>

        <div>
            <label class="k-btn k-btn-primary" for="csvFile">Vælg CSV-fil</label>
            <input type="file" id="csvFile" accept=".csv" class="k-visually-hidden" />
        </div>

        <div id="status" aria-live="polite"></div>
    </div>
</div>

<script>
// Deferred one tick: Blazor can still be inserting this markup when the script runs.
setTimeout(function () {
    const fileInput = document.getElementById('csvFile');
    const ledgerInput = document.getElementById('ledgerId');
    const status = document.getElementById('status');
    if (!fileInput) return;
    const show = (kind, html) => status.innerHTML = `<div class="k-alert k-alert-${kind}">${html}</div>`;

    fileInput.addEventListener('change', async () => {
        const file = fileInput.files[0];
        // Lowercased here and on the server - "Familie" and "familie" must be the same account.
        const ledgerId = ledgerInput.value.trim().toLowerCase();
        if (!file) return;
        if (!ledgerId) { show('danger', 'Skriv kontoens navn først.'); fileInput.value = ''; return; }
        if (!file.name.toLowerCase().endsWith('.csv')) { show('danger', 'Filen skal være en CSV-fil fra netbanken.'); fileInput.value = ''; return; }

        show('info', 'Lægger ind...');
        const form = new FormData();
        form.append('ledgerId', ledgerId);
        form.append('scopeMode', document.querySelector('input[name="scopeMode"]:checked')?.value || 'Both');
        form.append('file', file);
        try {
            const res = await fetch('/api/shop/upload', { method: 'POST', body: form });
            if (!res.ok) { show('danger', await res.text()); return; }
            const body = await res.json();
            const msg = body.imported > 0
                ? `${body.imported} betalinger er lagt ind på "${ledgerId}".`
                : 'Der var ingen nye betalinger. Dem, der allerede var lagt ind, er sprunget over.';
            show('ok', `${msg}<div class="k-mt"><a class="k-btn k-btn-primary k-btn-sm" href="/kategorier/${encodeURIComponent(ledgerId)}">Se kategorierne</a></div>`);
        } catch (e) {
            show('danger', 'Det lykkedes ikke at lægge filen ind. Prøv igen.');
        } finally {
            fileInput.value = '';
        }
    });
}, 0);
</script>

@code {
    [Parameter] public string? LedgerId { get; set; }
    private string _ledger => string.IsNullOrWhiteSpace(LedgerId) ? (Config["Budget:DefaultLedger"] ?? "familie") : LedgerId;
}
