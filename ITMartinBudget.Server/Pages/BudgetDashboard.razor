@page "/"

@using ITMartinBudget.Domain.Entities
@using ITMartinBudget.Domain.Enums
@using ITMartinBudget.Infrastructure
@using Microsoft.EntityFrameworkCore
@inject BudgetDbContext Db

<PageTitle>Familieøkonomi</PageTitle>

<div class="budget-container">

    <div class="stack">

        <div>

            <h1 class="page-title">
                Familieøkonomi
            </h1>

            <div class="meta">
                Live overblik over familiens økonomi
            </div>

        </div>

        <div class="kpi-grid">

            <div class="kpi-card kpi-income">

                <div class="kpi-title">
                    Indkomst
                </div>

                <div class="kpi-value">
                    @TotalIncome.ToString("N0") kr.
                </div>

            </div>

            <div class="kpi-card kpi-expense">

                <div class="kpi-title">
                    Udgifter
                </div>

                <div class="kpi-value">
                    @TotalExpenses.ToString("N0") kr.
                </div>

            </div>

            <div class="kpi-card kpi-net clickable-card"
                 @onclick="() => ToggleFixedExpensesTransactions()">

                <div class="kpi-title">
                    Faste udgifter
                </div>

                <div class="kpi-value">
                    @FixedExpenses.ToString("N0") kr.
                </div>

            </div>

            <div class="kpi-card kpi-net clickable-card"
                 @onclick="() => ToggleFixedIncomeTransactions()">

                <div class="kpi-title">
                    Fast indkomst
                </div>

                <div class="kpi-value">
                    @FixedIncome.ToString("N0") kr.
                </div>

            </div>

        </div>

        @if (ExpandedCard == "fixed-expenses")
        {
            <div class="transaction-section">

                <h2 class="transaction-section-title">
                    Faste udgifter
                </h2>

                <div class="transaction-list">

                    @foreach (var tx in FixedExpenseTransactions
                        .OrderByDescending(x => Math.Abs(x.Amount)))
                    {
                        <div class="transaction-row expense">

                            <div class="transaction-date">
                                @tx.Date.ToString("dd/MM/yyyy")
                            </div>

                            <div class="transaction-description">

                                <div class="transaction-title">
                                    @tx.Title
                                </div>

                                <div class="transaction-category">
                                    @tx.Description
                                </div>

                            </div>

                            <div class="transaction-amount negative">
                                @Math.Abs(tx.Amount).ToString("N0") kr.
                            </div>

                        </div>
                    }

                </div>

            </div>
        }

        @if (ExpandedCard == "fixed-income")
        {
            <div class="transaction-section">

                <h2 class="transaction-section-title">
                    Fast indkomst
                </h2>

                <div class="transaction-list">

                    @foreach (var tx in FixedIncomeTransactions
                        .OrderByDescending(x => x.Amount))
                    {
                        <div class="transaction-row income">

                            <div class="transaction-date">
                                @tx.Date.ToString("dd/MM/yyyy")
                            </div>

                            <div class="transaction-description">

                                <div class="transaction-title">
                                    @tx.Title
                                </div>

                                <div class="transaction-category">
                                    @tx.Description
                                </div>

                            </div>

                            <div class="transaction-amount positive">
                                @tx.Amount.ToString("N0") kr.
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
        @if (UncategorizedTransactions.Any())
        {
            <div class="transaction-section">

                <h2 class="transaction-section-title">
                    Ukategoriserede transaktioner
                </h2>

                <div class="transaction-list">

                    @foreach (var tx in UncategorizedTransactions.Take(50))
                    {
                        <div class="transaction-row">

                            <div class="transaction-date">
                                @tx.Date.ToString("dd/MM/yyyy")
                            </div>

                            <div class="transaction-description">

                                <div class="transaction-title">
                                    @tx.Title
                                </div>

                                <div class="transaction-category">
                                    @tx.Description
                                </div>

                            </div>

                            <div class="transaction-amount @(tx.Amount >= 0 ? "positive" : "negative")">

                                @tx.Amount.ToString("N0") kr.

                            </div>

                        </div>
                    }

                </div>

            </div>
        }
        <div class="category-summary-row">

            @foreach (var category in CategorySummaries)
            {
                var transactions =
                    Transactions
                        .Where(x => x.Category == category.Category)
                        .OrderByDescending(x => x.Date)
                        .Take(5)
                        .ToList();

                <div class="category-summary-card clickable-card"
                     @onclick="() => ToggleCategory(category.Category)">

                    <div class="category-summary-top">

                        <div>

                            <div class="category-summary-title">
                                @category.Category
                            </div>

                            <div class="meta">
                                @category.TransactionCount transaktioner
                            </div>

                        </div>

                        <div class="category-summary-count">

                            @((category.Total / MonthsLoaded).ToString("N0")) kr/md

                        </div>

                    </div>

                    <div class="category-summary-amount">

                        @category.Total.ToString("N0") kr.

                    </div>

                    <div class="category-summary-transactions">

                        @foreach (var tx in transactions)
                        {
                            <div class="category-transaction">

                                <div class="category-transaction-left">

                                    <div class="category-transaction-title">
                                        @tx.Title
                                    </div>

                                    <div class="category-transaction-date">
                                        @tx.Date.ToString("dd MMM")
                                    </div>

                                </div>

                                <div class="category-transaction-right">

                                    <div class="category-transaction-amount @(tx.Amount >= 0 ? "positive" : "negative")">

                                        @Math.Abs(tx.Amount).ToString("N0") kr.

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                    @if (ExpandedCategory == category.Category)
                    {
                        <div class="expanded-category-transactions">

                            @foreach (var tx in Transactions
                                          .Where(x => x.Category == category.Category)
                                          .OrderByDescending(x => x.Date))
                            {
                                <div class="transaction-row @(tx.Amount >= 0 ? "income" : "expense")">

                                    <div class="transaction-date">
                                        @tx.Date.ToString("dd/MM/yyyy")
                                    </div>

                                    <div class="transaction-description">

                                        <div class="transaction-title">
                                            @tx.Title
                                        </div>

                                        <div class="transaction-category">
                                            @tx.Description
                                        </div>

                                    </div>

                                    <div class="transaction-amount @(tx.Amount >= 0 ? "positive" : "negative")">

                                        @tx.Amount.ToString("N0") kr.

                                    </div>

                                </div>
                            }

                        </div>
                    }
                </div>
            }

        </div>

        <div class="transaction-section">

            <h2 class="transaction-section-title">
                Seneste bevægelser
            </h2>

            <div class="transaction-list">

                @foreach (var tx in Transactions
                    .OrderByDescending(x => x.Date)
                    .Take(25))
                {
                    <div class="transaction-row @(tx.Amount >= 0 ? "income" : "expense")">

                        <div class="transaction-date">

                            @tx.Date.ToString("dd/MM/yyyy")

                        </div>

                        <div class="transaction-description">

                            <div class="transaction-title">

                                @tx.Title

                            </div>

                            <div class="transaction-category">

                                @tx.Description

                            </div>

                        </div>

                        <div class="transaction-amount @(tx.Amount >= 0 ? "positive" : "negative")">

                            @tx.Amount.ToString("N0") kr.

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

</div>

@code {

    private List<BankTransaction> Transactions = [];

    private List<CategorySummaryModel> CategorySummaries = [];
    private List<BankTransaction>
        UncategorizedTransactions =>
        Transactions
            .Where(x =>
                x.BudgetGroup ==
                BudgetGroup.Uncategorized)
            .OrderByDescending(x => x.Date)
            .ToList();

    private decimal UncategorizedTotal =>
        Math.Abs(
            UncategorizedTransactions
                .Sum(x => x.Amount));
    private string? ExpandedCard;
    private Category? ExpandedCategory;
    private decimal TotalIncome;
    private decimal TotalExpenses;
    private decimal NetAmount;
    private decimal FixedExpenses;
    private decimal FixedIncome;
    private decimal DisposableAmount;

    private int MonthsLoaded = 1;

    private void ToggleFixedExpensesTransactions()
    {
        ExpandedCard =
            ExpandedCard == "fixed-expenses"
                ? null
                : "fixed-expenses";
    }
    
    private void ToggleFixedIncomeTransactions()
    {
        ExpandedCard =
            ExpandedCard == "fixed-income"
                ? null
                : "fixed-income";
    }
    private void ToggleCategory(
        Category category)
    {
        ExpandedCategory =
            ExpandedCategory == category
                ? null
                : category;
    }
    private List<BankTransaction>
        FixedExpenseTransactions =>
        Transactions
            .Where(x =>
                x.BudgetGroup ==
                BudgetGroup.FixedExpense)
            .ToList();

    private List<BankTransaction>
        FixedIncomeTransactions =>
        Transactions
            .Where(x =>
                x.BudgetGroup ==
                BudgetGroup.FixedIncome)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        Transactions = await Db.Transactions
            .OrderByDescending(x => x.Date)
            .ToListAsync();

        var firstDate = Transactions.MinBy(x => x.Date)?.Date;
        var lastDate = Transactions.MaxBy(x => x.Date)?.Date;

        if (firstDate.HasValue && lastDate.HasValue)
        {
            MonthsLoaded =
                Math.Max(
                    1,
                    ((lastDate.Value.Year - firstDate.Value.Year) * 12)
                    + lastDate.Value.Month
                    - firstDate.Value.Month
                    + 1);
        }

        TotalIncome =
            Transactions
                .Where(x =>
                    x.Amount > 0 &&
                    x.BudgetGroup != BudgetGroup.InternalTransfer)
                .Sum(x => x.Amount);

        TotalExpenses =
            Math.Abs(
                Transactions
                    .Where(x =>
                        x.Amount < 0 &&
                        x.BudgetGroup != BudgetGroup.InternalTransfer)
                    .Sum(x => x.Amount));
        
        NetAmount =
            TotalIncome - TotalExpenses;
        
        FixedExpenses =
            Math.Abs(
                Transactions
                    .Where(x => x.BudgetGroup == BudgetGroup.FixedExpense)
                    .Sum(x => x.Amount));

        FixedIncome =
            Transactions
                .Where(x => x.BudgetGroup == BudgetGroup.FixedIncome)
                .Sum(x => x.Amount);

        DisposableAmount =
            NetAmount;

        CategorySummaries =
            Transactions

                .Where(x =>
                    x.BudgetGroup !=
                    BudgetGroup.Uncategorized)

                .GroupBy(x => x.Category)

                .Select(x => new CategorySummaryModel
                {
                    Category = x.Key,
                    Total = Math.Abs(x.Sum(y => y.Amount)),
                    TransactionCount = x.Count()
                })

                .OrderByDescending(x => x.Total)

                .ToList();
    }

    public class CategorySummaryModel
    {
        public Category Category { get; set; }

        public decimal Total { get; set; }

        public int TransactionCount { get; set; }
    }
}