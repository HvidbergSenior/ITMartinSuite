@page "/budget"
@layout BudgetMainLayout
@rendermode InteractiveServer

@using ITMartinBudget.Domain.Entities
@using ITMartinBudget.Domain.Enums
@using ITMartinBudget.Infrastructure
@using ITMartinBudget.Server.Budget
@using Microsoft.EntityFrameworkCore

@inject BudgetDbContext Db
@inject NavigationManager Nav

<div class="budget-container">

    <div class="budget-header">

        <div>

            <h1 class="page-title">
                Budget Overview
            </h1>

            <div class="page-subtitle">
                Family economy overview
            </div>

        </div>

        <div class="header-actions">

            <button class="btn"
                    @onclick="GoToUpload">

                Upload / Reset

            </button>

        </div>

    </div>

    <div class="kpi-grid">

        <div class="kpi-card kpi-income">

            <div class="kpi-label">
                All Money In
            </div>

            <div class="kpi-value">
                @Format(AllMoneyIn)
            </div>

        </div>

        <div class="kpi-card kpi-expense">

            <div class="kpi-label">
                All Money Out
            </div>

            <div class="kpi-value">
                @Format(AllMoneyOut)
            </div>

        </div>

        <div class="kpi-card">

            <div class="kpi-label">
                Net Bank Movement
            </div>

            <div class="kpi-value">
                @Format(NetMovement)
            </div>

        </div>

        <div class="kpi-card">

            <div class="kpi-label">
                Real Spending
            </div>

            <div class="kpi-value">
                @Format(RealExpenses)
            </div>

        </div>

        <div class="kpi-card">

            <div class="kpi-label">
                Fixed Expenses
            </div>

            <div class="kpi-value">
                @Format(FixedExpenses)
            </div>

        </div>

        <div class="kpi-card kpi-income">

            <div class="kpi-label">
                Free Money
            </div>

            <div class="kpi-value">
                @Format(FreeMoney)
            </div>

        </div>

    </div>

    <div class="explanation-grid">

        <details class="explanation-card">

            <summary>

                <div class="explanation-title">
                    💰 All Money In
                </div>

                <div class="explanation-small">
                    Everything entering the accounts
                </div>

            </summary>

            <div class="explanation-body">

                <div class="explanation-text">
                    Salary, refunds, transfers and income.
                </div>

                <div class="example-title">
                    Example transactions
                </div>

                @foreach (var tx in _transactions
                    .Where(x => x.Amount > 0)
                    .Take(5))
                {
                    <div class="example-row">

                        <div>

                            <div class="example-description">
                                @tx.Description
                            </div>

                            <div class="example-category">
                                @tx.Title
                            </div>

                        </div>

                        <span>
                            @Format(tx.Amount)
                        </span>

                    </div>
                }

            </div>

        </details>

        <details class="explanation-card">

            <summary>

                <div class="explanation-title">
                    💸 All Money Out
                </div>

                <div class="explanation-small">
                    Everything leaving the accounts
                </div>

            </summary>

            <div class="explanation-body">

                <div class="explanation-text">
                    Spending, bills and transfers.
                </div>

                <div class="example-title">
                    Example transactions
                </div>

                @foreach (var tx in _transactions
                    .Where(x => x.Amount < 0)
                    .Take(5))
                {
                    <div class="example-row">

                        <div>

                            <div class="example-description">
                                @tx.Description
                            </div>

                            <div class="example-category">
                                @tx.Title
                            </div>

                        </div>

                        <span>
                            @Format(tx.Amount)
                        </span>

                    </div>
                }

            </div>

        </details>

        <details class="explanation-card">

            <summary>

                <div class="explanation-title">
                    🧾 Fixed Expenses
                </div>

                <div class="explanation-small">
                    Recurring unavoidable costs
                </div>

            </summary>

            <div class="explanation-body">

                <div class="explanation-text">
                    Housing, insurance,
                    subscriptions and taxes.
                </div>

                <div class="example-title">
                    Example transactions
                </div>

                @foreach (var tx in _transactions
                    .Where(x =>
                        x.BudgetGroup ==
                        BudgetGroup.FixedExpense)
                    .Take(8))
                {
                    <div class="example-row">

                        <div>

                            <div class="example-description">
                                @tx.Description
                            </div>

                            <div class="example-category">
                                @tx.Title
                            </div>

                        </div>

                        <span>
                            @Format(tx.Amount)
                        </span>

                    </div>
                }

            </div>

        </details>

        <details class="explanation-card">

            <summary>

                <div class="explanation-title">
                    🛍 Real Spending
                </div>

                <div class="explanation-small">
                    Everyday life and lifestyle
                </div>

            </summary>

            <div class="explanation-body">

                <div class="explanation-text">
                    Food, restaurants,
                    entertainment and shopping.
                </div>

                <div class="example-title">
                    Example transactions
                </div>

                @foreach (var tx in _transactions
                    .Where(x =>
                        x.Amount < 0
                        &&
                        x.BudgetGroup !=
                        BudgetGroup.InternalTransfer)
                    .Take(8))
                {
                    <div class="example-row">

                        <div>

                            <div class="example-description">
                                @tx.Description
                            </div>

                            <div class="example-category">
                                @tx.Title
                            </div>

                        </div>

                        <span>
                            @Format(tx.Amount)
                        </span>

                    </div>
                }

            </div>

        </details>

        <details class="explanation-card">

            <summary>

                <div class="explanation-title">
                    🌟 Free Money
                </div>

                <div class="explanation-small">
                    Flexible family money
                </div>

            </summary>

            <div class="explanation-body">

                <div class="explanation-text">
                    Money left after fixed expenses.
                </div>

                <div class="example-title">
                    Typical spending examples
                </div>

                @foreach (var tx in _transactions
                    .Where(x =>
                        x.Category ==
                        Category.Entertainment)
                    .Take(8))
                {
                    <div class="example-row">

                        <div>

                            <div class="example-description">
                                @tx.Description
                            </div>

                            <div class="example-category">
                                @tx.Title
                            </div>

                        </div>

                        <span>
                            @Format(tx.Amount)
                        </span>

                    </div>
                }

            </div>

        </details>

    </div>

</div>

@code {

    private List<BankTransaction> _transactions =
        [];

    private decimal RealIncome;

    private decimal RealExpenses;

    private decimal FixedExpenses;

    private decimal AllMoneyIn;

    private decimal AllMoneyOut;

    private decimal NetMovement;

    private decimal FreeMoney;

    protected override async Task OnInitializedAsync()
    {
        _transactions =
            await Db.Transactions
                .OrderByDescending(x => x.Date)
                .ToListAsync();

        RealIncome =
            _transactions

                .Where(x =>
                    x.Amount > 0
                    &&
                    x.BudgetGroup !=
                    BudgetGroup.InternalTransfer)

                .Sum(x => x.Amount);

        RealExpenses =
            _transactions

                .Where(x =>
                    x.Amount < 0
                    &&
                    x.BudgetGroup !=
                    BudgetGroup.InternalTransfer)

                .Sum(x => Math.Abs(x.Amount));

        FixedExpenses =
            _transactions

                .Where(x =>
                    x.Amount < 0
                    &&
                    x.BudgetGroup ==
                    BudgetGroup.FixedExpense)

                .Sum(x => Math.Abs(x.Amount));

        AllMoneyIn =
            _transactions

                .Where(x => x.Amount > 0)

                .Sum(x => x.Amount);

        AllMoneyOut =
            _transactions

                .Where(x => x.Amount < 0)

                .Sum(x => Math.Abs(x.Amount));

        NetMovement =
            AllMoneyIn - AllMoneyOut;

        FreeMoney =
            RealIncome - FixedExpenses;
    }

    private void GoToUpload()
    {
        Nav.NavigateTo("/budget/upload");
    }

    private string Format(decimal amount)
    {
        return $"{amount:N2} kr.";
    }
}