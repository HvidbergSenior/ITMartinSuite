@page "/"
@using ITMartinBudget.Application.Extensions
@using ITMartinBudget.Application.Interfaces
@using ITMartinBudget.Application.Models
@using ITMartinBudget.Domain.Entities
@using ITMartinBudget.Domain.Enums

@inject IDashboardService DashboardService

<PageTitle>Familieøkonomi</PageTitle>

<div class="budget-container">
</div>
    <div class="stack">

        <div>

            <h1 class="page-title">
                Familieøkonomi
            </h1>

            <div class="meta">
                Live overblik over familiens økonomi
            </div>

        </div>
        
        <div class="financial-overview-card">

            <div class="financial-item income">

                <div class="financial-label">
                    Indkomst
                </div>

                <div class="financial-value">
                    @Dashboard.TotalIncome.ToString("N0") kr.
                </div>

            </div>
            
            <div class="financial-item expense">

                <div class="financial-label">
                    Udgifter
                </div>

                <div class="financial-value">
                    @Dashboard.TotalExpenses.ToString("N0") kr.
                </div>

            </div>
            
            <div class="financial-item result">

                <div class="financial-label">
                    @(Dashboard.NetAmount >= 0
                        ? "Overskud"
                        : "Underskud")
                </div>

                <div class="financial-value">
                    @Dashboard.NetAmount.ToString("N0") kr.
                </div>

            </div>
            @{
                var expensePercentage =
                    Dashboard.TotalIncome == 0
                        ? 0
                        : Dashboard.TotalExpenses /
                        Dashboard.TotalIncome * 100;
            }

            <div class="financial-progress">

                <div class="financial-progress-bar">

                    <div class="financial-progress-expense"
                         style="width:@expensePercentage%">
                    </div>

                    <div class="financial-progress-income"
                         style="width:@(100-expensePercentage)%">
                    </div>

                </div>

                <div class="financial-progress-labels">

                    <span class="income-label">
                        +@Dashboard.TotalIncome.ToString("N0") kr.
                    </span>

                    <span class="expense-label">
                        -@Dashboard.TotalExpenses.ToString("N0") kr.
                    </span>

                </div>

                <div class="financial-progress-summary">

                    @expensePercentage.ToString("N1")%
                    af indkomsten bruges

                </div>

            </div>
        </div>
        <div class="kpi-grid">

            <div class="kpi-card period-card">
                <div class="kpi-title">
                    Periode
                </div>

                <div class="kpi-subtitle">
                    @Dashboard.MonthsLoaded måneder
                </div>

                <div class="period-value">

                    <div>
                        @Dashboard.FirstTransactionDate?.ToString("dd/MM/yyyy")
                    </div>

                    <div class="period-arrow">
                        →
                    </div>

                    <div>
                        @Dashboard.LastTransactionDate?.ToString("dd/MM/yyyy")
                    </div>

                </div>
            </div>

            <div class="kpi-card clickable-card"
                 @onclick="ToggleInternalTransfers">
                <div class="kpi-title">
                    Interne overførsler
                </div>

                <div class="kpi-value">
                    @Dashboard.InternalTransferNet.ToString("N0") kr.
                </div>

                <div class="kpi-subtitle">
                    Ind:
                    @Dashboard.InternalTransferIncome.ToString("N0") kr.

                    <br/>

                    Ud:
                    @Dashboard.InternalTransferExpenses.ToString("N0") kr.
                </div>
            </div>
            <div class="category-summary-card">

                <div class="category-summary-title">
                    🔥 Største udgifter
                </div>

                @foreach (var item in Dashboard.BudgetGroupSummaries
                              .Where(x => x.DisplayAmount > 0)
                              .OrderByDescending(x => x.DisplayAmount)
                              .Take(5))
                {
                    <div class="category-transaction">

                        <div class="category-transaction-title">
                            @item.BudgetGroup.ToDisplayName()
                        </div>

                        <div class="category-transaction-amount negative">
                            @item.DisplayAmount.ToString("N0") kr.
                        </div>

                    </div>
                }

            </div>

        </div>
      
        
        @if (ExpandedCard == "fixed-expenses")
        {
            <div class="transaction-section">

                <h2 class="transaction-section-title">
                    Faste udgifter
                </h2>

                <div class="transaction-list">

                    @foreach (var tx in FixedExpenseTransactions
                        .OrderByDescending(x => Math.Abs(x.Amount)))
                    {
                        <div class="transaction-row expense">

                            <div class="transaction-date">
                                @tx.Date.ToString("dd/MM/yyyy")
                            </div>

                            <div class="transaction-description">

                                <div class="transaction-title">
                                    @tx.Title
                                </div>

                                <div class="transaction-category">
                                    @tx.Description
                                </div>

                            </div>

                            <div class="transaction-amount negative">
                                @Math.Abs(tx.Amount).ToString("N0") kr.
                            </div>

                        </div>
                    }

                </div>

            </div>
        }

        @if (ExpandedCard == "fixed-income")
        {
            <div class="transaction-section">

                <h2 class="transaction-section-title">
                    Fast indkomst
                </h2>

                <div class="transaction-list">

                    @foreach (var tx in FixedIncomeTransactions
                        .OrderByDescending(x => x.Amount))
                    {
                        <div class="transaction-row income">

                            <div class="transaction-date">
                                @tx.Date.ToString("dd/MM/yyyy")
                            </div>

                            <div class="transaction-description">

                                <div class="transaction-title">
                                    @tx.Title
                                </div>

                                <div class="transaction-category">
                                    @tx.Description
                                </div>

                            </div>

                            <div class="transaction-amount positive">
                                @tx.Amount.ToString("N0") kr.
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
        @if (ExpandedCard == "internal-transfers")
        {
            <div class="transaction-section">

                <h2 class="transaction-section-title">
                    Interne overførsler
                </h2>

                <div class="transaction-list">

                    @foreach (var tx in InternalTransferTransactions
                                  .OrderByDescending(x => Math.Abs(x.Amount)))
                    {
                        <div class="transaction-row">

                            <div class="transaction-date">
                                @tx.Date.ToString("dd/MM/yyyy")
                            </div>

                            <div class="transaction-description">

                                <div class="transaction-title">
                                    @tx.Title
                                </div>

                                <div class="transaction-category">
                                    @tx.Description
                                </div>

                            </div>

                            <div class="transaction-amount @(tx.Amount >= 0 ? "positive" : "negative")">
                                @tx.Amount.ToString("N0") kr.
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
        @if (UncategorizedTransactions.Any())
        {
            <div class="transaction-section">

                <h2 class="transaction-section-title">
                    Ukategoriserede transaktioner
                </h2>

                <div class="transaction-list">

                    @foreach (var tx in UncategorizedTransactions.Take(50))
                    {
                        <div class="transaction-row">

                            <div class="transaction-date">
                                @tx.Date.ToString("dd/MM/yyyy")
                            </div>

                            <div class="transaction-description">

                                <div class="transaction-title">
                                    @tx.Title
                                </div>

                                <div class="transaction-category">
                                    @tx.Description
                                </div>

                            </div>

                            <div class="transaction-amount @(tx.Amount >= 0 ? "positive" : "negative")">

                                @tx.Amount.ToString("N0") kr.

                            </div>

                        </div>
                    }

                </div>

            </div>
        }
      
           <div class="budget-columns">

    <div class="budget-column">

        <div class="budget-column-header income">
            💰 Indkomster
        </div>

        @foreach (var group in Dashboard.BudgetGroupSummaries
                     .Where(x => x.Total > 0)
                     .OrderByDescending(x => x.Total))
        {
            <div class="category-summary-card clickable-card"
                 @onclick="() => ToggleBudgetGroup(group.BudgetGroup)">

                @{
                    var percent =
                        TotalSpending == 0
                            ? 0
                            : group.DisplayAmount /
                            TotalSpending * 100;
                }

                <div class="category-summary-top">

                    <div>

                        <div class="category-summary-title">
                            @group.BudgetGroup.ToDisplayName()
                        </div>

                        <div class="meta">
                            @group.TransactionCount transaktioner
                            •
                            @percent.ToString("N1")%
                        </div>

                    </div>

                    <div class="category-summary-count">
                        @((group.Total / Dashboard.MonthsLoaded).ToString("N0"))
                        kr/md
                    </div>

                </div>

                <div class="category-summary-amount positive">
                    @group.Total.ToString("N0") kr.
                </div>
            </div>
        }

    </div>

    <div class="budget-column">

       
        <div class="budget-column-header expense">
            💸 Udgifter
        </div>

        @foreach (var group in Dashboard.BudgetGroupSummaries
                     .Where(x => x.Total < 0)
                     .OrderByDescending(x => x.DisplayAmount))
        {
            <div class="category-summary-card clickable-card"
                 @onclick="() => ToggleBudgetGroup(group.BudgetGroup)">

                @{
                    var percent =
                        TotalSpending == 0
                            ? 0
                            : group.Expenses /
                            TotalSpending * 100;
                }

                <div class="category-summary-top">

                    <div>

                        <div class="category-summary-title">
                            @group.BudgetGroup.ToDisplayName()
                        </div>

                        <div class="meta">
                            @group.TransactionCount transaktioner
                            •
                            @percent.ToString("N1")%
                        </div>

                    </div>

                    <div class="category-summary-count">
                        @((group.DisplayAmount / Dashboard.MonthsLoaded)
                        .ToString("N0"))
                        kr/md
                    </div>

                </div>

                <div class="category-summary-amount negative">
                    @group.DisplayAmount.ToString("N0") kr.
                </div>
                @if (ExpandedBudgetGroup == group.BudgetGroup)
{
    <div class="expanded-category-transactions">

        @foreach (var titleGroup in Dashboard.Transactions
                      .Where(x => x.BudgetGroup == group.BudgetGroup)
                      .GroupBy(x => x.Title)
                      .OrderByDescending(x =>
                          x.Sum(y => Math.Abs(y.Amount))))
        {
            var titleTotal =
                Math.Abs(
                    titleGroup.Sum(x =>
                        x.Amount));
            <div class="transaction-group">

                <div class="transaction-group-header"
                     @onclick="() => ToggleTransactionTitle(titleGroup.Key)"
                     @onclick:stopPropagation="true">
                    <div>

                        <strong>
                            @titleGroup.Key
                        </strong>

                        <span class="meta">
                            (@titleGroup.Count())
                        </span>

                    </div>

                    <div class="transaction-group-amount">

                        @titleTotal.ToString("N0") kr.

                        @(ExpandedTransactionTitles.Contains(titleGroup.Key)
                        ? "▼"
                        : "▶")

                    </div>

                </div>

                    @if (ExpandedTransactionTitles.Contains(
                             titleGroup.Key))
                {
                    <div class="transaction-group-details"
                         @onclick:stopPropagation="true">

                        @foreach (var tx in titleGroup
                                      .OrderByDescending(x => x.Date))
                        {
                            <div class="transaction-detail-row"
                                 @onclick:stopPropagation="true">

                                <div>
                                    @tx.Date.ToString("dd-MM-yyyy")
                                </div>

                                <div>
                                    @tx.Description
                                </div>

                                <div>
                                    @tx.Amount.ToString("N0")
                                </div>

                            </div>
                        }

                    </div>
                }

            </div>
        }

        @if (group.BudgetGroup == BudgetGroup.Savings)
        {
            <div class="category-summary-extra">

                <div>
                    💰 Indsat:
                    @group.Expenses.ToString("N0") kr.
                </div>

                <div>
                    ↩ Hævet:
                    @group.Income.ToString("N0") kr.
                </div>

                <div>
                    Netto:
                    @group.DisplayAmount.ToString("N0") kr.
                </div>

            </div>
        }

    </div>
}

            </div>
        }

    </div>

</div>

        </div>
@code {
    private DashboardViewModel Dashboard =
        new();
    private string? ExpandedCard;
    private readonly HashSet<string>
        ExpandedTransactionTitles = [];
    private BudgetGroup? ExpandedBudgetGroup;
    private decimal TotalSpending =>
        Dashboard.BudgetGroupSummaries
            .Sum(x => x.Expenses);
    private List<BankTransaction>
        UncategorizedTransactions =>
        Dashboard.Transactions
            .Where(x =>
                x.BudgetGroup ==
                BudgetGroup.Uncategorized)
            .ToList();

    private void ToggleFixedExpensesTransactions()
    {
        ExpandedCard =
            ExpandedCard == "fixed-expenses"
                ? null
                : "fixed-expenses";
    }
    
    private void ToggleFixedIncomeTransactions()
    {
        ExpandedCard =
            ExpandedCard == "fixed-income"
                ? null
                : "fixed-income";
    }
 
    private List<BankTransaction>
        FixedExpenseTransactions =>
        Dashboard.Transactions
            .Where(x =>
                x.BudgetGroup ==
                BudgetGroup.FixedExpense)
            .ToList();

    private List<BankTransaction>
        FixedIncomeTransactions =>
        Dashboard.Transactions
            .Where(x =>
                x.BudgetGroup ==
                BudgetGroup.FixedIncome)
            .ToList();
    private List<BankTransaction>
        InternalTransferTransactions =>
        Dashboard.Transactions
            .Where(x =>
                x.BudgetGroup ==
                BudgetGroup.InternalTransfer)
            .ToList();
    protected override async Task OnInitializedAsync()
    {
        Dashboard =
            await DashboardService
                .BuildDashboardAsync();
    }
    private void ToggleInternalTransfers()
    {
        ExpandedCard =
            ExpandedCard == "internal-transfers"
                ? null
                : "internal-transfers";
    }
    private void ToggleBudgetGroup(
        BudgetGroup budgetGroup)
    {
        ExpandedBudgetGroup =
            ExpandedBudgetGroup == budgetGroup
                ? null
                : budgetGroup;
    }
    private void ToggleTransactionTitle(
        string title)
    {
        if (!ExpandedTransactionTitles.Add(title))
        {
            ExpandedTransactionTitles.Remove(title);
        }
    }
}