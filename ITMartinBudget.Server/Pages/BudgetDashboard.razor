@page "/dashboard"
@* No @rendermode: the expand/collapse below uses native HTML <details>, not
   a Blazor click handler, so this page never needs a live SignalR circuit -
   Blazor Server through the Cloudflare Tunnel domains has previously caused
   a stuck "Forbinder..." reconnect loop; static rendering avoids that
   failure mode entirely for a page that doesn't otherwise need it. *@
@using ITMartinBudget.Application.Extensions
@using ITMartinBudget.Application.Interfaces
@using ITMartinBudget.Application.Models
@using ITMartinBudget.Domain.Entities
@using ITMartinBudget.Domain.Enums

@inject IDashboardService DashboardService

<PageTitle>Familieøkonomi</PageTitle>

@if (_loading)
{
    <div style="padding:48px;color:var(--muted)">Indlæser...</div>
}
else
{
    var months = Math.Max(1, Dashboard.MonthsLoaded);
    var monthlyIncome = Dashboard.TotalIncome / months;
    var monthlyExpenses = Math.Abs(Dashboard.TotalExpenses) / months;
    var monthlyNet = Dashboard.NetAmount / months;

    var now = DateTime.Now;
    var currentMonthTx = Dashboard.Transactions
        .Where(x => x.Date.Month == now.Month && x.Date.Year == now.Year)
        .ToList();

    <div class="stack">

        <ProblemPurposeBanner
            Problem="Bank-transaktioner, især MobilePay, er svære at kategorisere ordentligt — og ingen bank hjælper dig med at se, om du betaler for abonnementer, du ikke bruger længere."
            Formaal="Et hurtigt overblik over jeres økonomi lige nu, og en liste over faste beløb, I måske ikke har brug for mere." />

        <HowToUseBanner Steps='@(new[]
        {
            "Upload en CSV-eksport fra din bank under 'Upload'.",
            "Se med det samme, hvor pengene faktisk går hen — overskud, underskud og hvilke kategorier der fylder mest.",
            "Del '/quick'-linket med resten af familien, så alle kan se økonomien lige nu uden at skulle logge ind.",
            "Tjek listen over faste, tilbagevendende beløb jævnligt, og find ud af om der er noget, I ikke har brug for mere."
        })' />

        <div>
            <h1 class="page-title">Familieøkonomi</h1>
            <div class="meta">
                @now.ToString("MMMM yyyy", new System.Globalization.CultureInfo("da-DK"))
                &nbsp;·&nbsp; snit over @months måneder
            </div>
        </div>

        <div class="financial-overview-card">
            <div class="financial-item income">
                <div class="financial-label">Månedlig indkomst</div>
                <div class="financial-value">@monthlyIncome.ToString("N0") kr.</div>
            </div>
            <div class="financial-item expense">
                <div class="financial-label">Månedlige udgifter</div>
                <div class="financial-value">@monthlyExpenses.ToString("N0") kr.</div>
            </div>
            <div class="financial-item result">
                <div class="financial-label">@(monthlyNet >= 0 ? "Overskud" : "Underskud") /md</div>
                <div class="financial-value">@monthlyNet.ToString("N0") kr.</div>
            </div>
        </div>

        <div>
            <h2 style="font-size:1.4rem;font-weight:800;margin-bottom:4px">Overvåget indkomst</h2>
            <div class="meta" style="margin-bottom:16px">Hver tilbagevendende indkomstpost for sig, ikke bare en samlet sum - klik for at se de enkelte transaktioner.</div>
            <div style="display:flex;flex-direction:column;gap:10px">
                @foreach (var item in _monitoredIncome)
                {
                    <details class="category-summary-card">
                        <summary style="cursor:pointer;list-style:none">
                            <div class="category-summary-top">
                                <div class="category-summary-title">@item.Label</div>
                                <div class="meta" style="white-space:nowrap">@item.Count stk.</div>
                            </div>
                            <div class="category-summary-amount positive">@item.MonthlyAvg.ToString("N0") kr/md</div>
                            <div class="meta" style="margin-top:4px">@item.Total.ToString("N0") kr. i alt over @months md.</div>
                        </summary>

                        <div class="transaction-list" style="margin-top:12px">
                            @foreach (var tx in item.Transactions.OrderByDescending(x => x.Date))
                            {
                                <div class="transaction-row income">
                                    <div class="transaction-date">@tx.Date.ToString("dd/MM/yy")</div>
                                    <div class="transaction-description">
                                        <div class="transaction-title">@tx.Description</div>
                                    </div>
                                    <div class="transaction-amount positive">@tx.Amount.ToString("N0") kr.</div>
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>

        <div>
            <h2 style="font-size:1.4rem;font-weight:800;margin-bottom:4px">Overvågede udgifter</h2>
            <div class="meta" style="margin-bottom:16px">Hver tilbagevendende udgiftspost for sig - fx Husleje og Husleje Hus vises hver for sig, ikke slået sammen. Klik for at se de enkelte transaktioner.</div>
            <div style="display:flex;flex-direction:column;gap:10px">
                @foreach (var item in _monitoredExpenses)
                {
                    <details class="category-summary-card">
                        <summary style="cursor:pointer;list-style:none">
                            <div class="category-summary-top">
                                <div class="category-summary-title">@item.Label</div>
                                <div class="meta" style="white-space:nowrap">@item.Count stk.</div>
                            </div>
                            <div class="category-summary-amount negative">@Math.Abs(item.MonthlyAvg).ToString("N0") kr/md</div>
                            <div class="meta" style="margin-top:4px">@Math.Abs(item.Total).ToString("N0") kr. i alt over @months md.</div>
                        </summary>

                        <div class="transaction-list" style="margin-top:12px">
                            @foreach (var tx in item.Transactions.OrderByDescending(x => x.Date))
                            {
                                <div class="transaction-row expense">
                                    <div class="transaction-date">@tx.Date.ToString("dd/MM/yy")</div>
                                    <div class="transaction-description">
                                        <div class="transaction-title">@tx.Description</div>
                                    </div>
                                    <div class="transaction-amount negative">@tx.Amount.ToString("N0") kr.</div>
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>

    </div>
}

@code {
    private DashboardViewModel Dashboard = new();
    private bool _loading = true;
    private int months = 1;

    private sealed record MonitoredItem(string Label, decimal MonthlyAvg, decimal Total, int Count, List<BankTransaction> Transactions);
    private List<MonitoredItem> _monitoredIncome = new();
    private List<MonitoredItem> _monitoredExpenses = new();

    protected override async Task OnInitializedAsync()
    {
        Dashboard = await DashboardService.BuildDashboardAsync();
        months = Math.Max(1, Dashboard.MonthsLoaded);

        // Grouped by the categorizer-assigned Title (falls back to the raw
        // description for anything Title didn't cover) so distinctly-named
        // recurring items - e.g. "Husleje" vs "Husleje Hus" - stay as separate
        // monitored lines instead of collapsing into one lump category total.
        var grouped = Dashboard.Transactions
            .GroupBy(x => !string.IsNullOrWhiteSpace(x.Title) ? x.Title : x.Description)
            .Select(g => new MonitoredItem(
                g.Key,
                g.Sum(x => x.Amount) / months,
                g.Sum(x => x.Amount),
                g.Count(),
                g.ToList()))
            .ToList();

        _monitoredIncome = grouped.Where(x => x.MonthlyAvg > 0).OrderByDescending(x => x.MonthlyAvg).ToList();
        _monitoredExpenses = grouped.Where(x => x.MonthlyAvg < 0).OrderBy(x => x.MonthlyAvg).ToList();

        _loading = false;
    }
}
