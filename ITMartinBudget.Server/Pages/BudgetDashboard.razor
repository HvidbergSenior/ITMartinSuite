@page "/"
@rendermode InteractiveServer
@using ITMartinBudget.Application.Extensions
@using ITMartinBudget.Application.Interfaces
@using ITMartinBudget.Application.Models
@using ITMartinBudget.Domain.Enums

@inject IDashboardService DashboardService

<PageTitle>Familieøkonomi</PageTitle>

@if (_loading)
{
    <div style="padding:48px;color:var(--muted)">Indlæser...</div>
}
else
{
    var months = Math.Max(1, Dashboard.MonthsLoaded);
    var monthlyIncome = Dashboard.TotalIncome / months;
    var monthlyExpenses = Math.Abs(Dashboard.TotalExpenses) / months;
    var monthlyNet = Dashboard.NetAmount / months;

    var now = DateTime.Now;
    var currentMonthTx = Dashboard.Transactions
        .Where(x => x.Date.Month == now.Month && x.Date.Year == now.Year)
        .ToList();

    <div class="stack">

        <ProblemPurposeBanner
            Problem="Bank-transaktioner, især MobilePay, er svære at kategorisere ordentligt — og ingen bank hjælper dig med at se, om du betaler for abonnementer, du ikke bruger længere."
            Formaal="Et hurtigt overblik over jeres økonomi lige nu, og en liste over faste beløb, I måske ikke har brug for mere." />

        <HowToUseBanner Steps='@(new[]
        {
            "Upload en CSV-eksport fra din bank under 'Upload'.",
            "Se med det samme, hvor pengene faktisk går hen — overskud, underskud og hvilke kategorier der fylder mest.",
            "Del '/quick'-linket med resten af familien, så alle kan se økonomien lige nu uden at skulle logge ind.",
            "Tjek listen over faste, tilbagevendende beløb jævnligt, og find ud af om der er noget, I ikke har brug for mere."
        })' />

        <div>
            <h1 class="page-title">Familieøkonomi</h1>
            <div class="meta">
                @now.ToString("MMMM yyyy", new System.Globalization.CultureInfo("da-DK"))
                &nbsp;·&nbsp; snit over @months måneder
            </div>
        </div>

        <div class="financial-overview-card">
            <div class="financial-item income">
                <div class="financial-label">Månedlig indkomst</div>
                <div class="financial-value">@monthlyIncome.ToString("N0") kr.</div>
            </div>
            <div class="financial-item expense">
                <div class="financial-label">Månedlige udgifter</div>
                <div class="financial-value">@monthlyExpenses.ToString("N0") kr.</div>
            </div>
            <div class="financial-item result">
                <div class="financial-label">@(monthlyNet >= 0 ? "Overskud" : "Underskud") /md</div>
                <div class="financial-value">@monthlyNet.ToString("N0") kr.</div>
            </div>
        </div>

        <div>
            <h2 style="font-size:1.4rem;font-weight:800;margin-bottom:16px">Kategorier denne måned</h2>
            <div style="display:flex;flex-direction:column;gap:16px">
                @foreach (var cat in _categories)
                {
                    var summary = Dashboard.BudgetGroupSummaries
                        .FirstOrDefault(x => x.BudgetGroup == cat.Group);
                    var monthlyAvg = summary != null ? Math.Abs(summary.Total) / months : 0m;

                    var thisMonthSpent = currentMonthTx
                        .Where(x => x.BudgetGroup == cat.Group)
                        .Sum(x => Math.Abs(x.Amount));

                    var pct = monthlyAvg > 0
                        ? (double)(thisMonthSpent / monthlyAvg * 100m)
                        : 0.0;
                    var pctCapped = Math.Min(pct, 100.0);
                    var over = thisMonthSpent > monthlyAvg && monthlyAvg > 0;

                    <div class="category-summary-card">

                        <div class="category-summary-top">
                            <div class="category-summary-title">@cat.Label</div>
                            <div class="meta" style="white-space:nowrap">
                                snit @monthlyAvg.ToString("N0") kr/md
                            </div>
                        </div>

                        <div class="category-summary-amount @(over ? "negative" : "positive")">
                            @thisMonthSpent.ToString("N0") kr.
                        </div>
                        <div class="meta" style="margin-top:4px">denne måned</div>

                        @if (monthlyAvg > 0)
                        {
                            <div style="margin-top:16px">
                                <div style="height:10px;background:rgba(255,255,255,.06);border-radius:999px;overflow:hidden;border:1px solid rgba(255,255,255,.08)">
                                    <div style="height:100%;border-radius:999px;width:@pctCapped.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;background:@(over ? "var(--red)" : "var(--green)");transition:width .3s ease"></div>
                                </div>
                                <div style="display:flex;justify-content:space-between;margin-top:6px;font-size:13px;color:var(--muted)">
                                    <span>@pct.ToString("N0")% af månedlig snit</span>
                                    @if (over)
                                    {
                                        <span style="color:var(--red)">@((thisMonthSpent - monthlyAvg).ToString("N0")) kr. over</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--green)">@((monthlyAvg - thisMonthSpent).ToString("N0")) kr. tilbage</span>
                                    }
                                </div>
                            </div>
                        }

                    </div>
                }
            </div>
        </div>

        <div>
            <h2 style="font-size:1.4rem;font-weight:800;margin-bottom:16px">Seneste transaktioner</h2>
            <div class="transaction-list">
                @foreach (var tx in Dashboard.Transactions
                    .OrderByDescending(x => x.Date)
                    .Take(25))
                {
                    var isIncome = tx.Amount >= 0;
                    <div class="transaction-row @(isIncome ? "income" : "expense")">
                        <div class="transaction-date">@tx.Date.ToString("dd/MM")</div>
                        <div class="transaction-description">
                            <div class="transaction-title">
                                @(!string.IsNullOrWhiteSpace(tx.Title) ? tx.Title : tx.Description)
                            </div>
                            <div class="transaction-category">@tx.BudgetGroup.ToDisplayName()</div>
                        </div>
                        <div class="transaction-amount @(isIncome ? "positive" : "negative")">
                            @tx.Amount.ToString("N0") kr.
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
}

@code {
    private DashboardViewModel Dashboard = new();
    private bool _loading = true;

    private record CategoryDef(BudgetGroup Group, string Label);

    private readonly CategoryDef[] _categories =
    [
        new(BudgetGroup.EverydayGrocery, "Dagligvarer"),
        new(BudgetGroup.RestaurantCafe, "Restaurant & Cafe"),
    ];

    protected override async Task OnInitializedAsync()
    {
        Dashboard = await DashboardService.BuildDashboardAsync();
        _loading = false;
    }
}
