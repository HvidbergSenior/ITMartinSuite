@page "/budget"
@layout BudgetMainLayout
@rendermode InteractiveServer

@using ITMartinBudget.Application.Rules
@using ITMartinBudget.Domain.Entities
@using ITMartinBudget.Domain.Enums
@using ITMartinBudget.Infrastructure
@using ITMartinBudget.Server.Budget
@using Microsoft.EntityFrameworkCore

@inject BudgetDbContext Db
@inject NavigationManager Nav

<div class="budget-container">

    <div class="budget-header">

        <div>

            <h1 class="page-title">
                Familieøkonomi
            </h1>

            <div class="page-subtitle">
                Overblik over økonomien
            </div>

        </div>

        <div class="header-actions">

            <button class="btn"
                    @onclick="GoToUpload">

                Upload CSV

            </button>

        </div>

    </div>

    <!-- KPI -->
    <div class="kpi-grid">

        <KpiCard Title="Indkomst"
                 Value="@Format(TotalIncome)"
                 Type="success" />

        <KpiCard Title="Udgifter"
                 Value="@Format(TotalExpenses)"
                 Type="danger" />

        <KpiCard Title="Netto"
                 Value="@Format(Net)" />

        <KpiCard Title="Faste udgifter"
                 Value="@Format(FixedExpenses)" />

        <KpiCard Title="Fast indkomst"
                 Value="@Format(FixedIncome)" />

        <KpiCard Title="Rådighedsbeløb"
                 Value="@Format(FreeMoney)" />

    </div>

    <!-- DEBUG -->
    <div class="debug-section">

        <div class="debug-card">

            <div class="debug-title">
                ⚠️ Ikke kategoriseret
            </div>

            <div class="debug-number">
                @_uncategorized.Count
            </div>

        </div>

        <div class="debug-card">

            <div class="debug-title">
                ⚠️ Mulige dubletter
            </div>

            <div class="debug-number">
                @_duplicateRules.Count
            </div>

        </div>

    </div>

    <!-- CATEGORY GRID -->
    <div class="category-summary-row">

        @foreach (var category in _categoryCards)
        {
            <BudgetCategoryCard
                Title="@category.Category"
                Subtitle="@($"{Format(category.MonthlyAverage)} / måned")"
                Value="@Format(category.Total)"
                OnClick="() => SelectCategory(category.Category)" />
        }

    </div>

    <!-- CATEGORY DETAILS -->
    @if (_selectedTransactions.Any())
    {
        <div class="transaction-section">

            <div class="transaction-section-title">
                @_selectedCategory
            </div>

            <div class="transaction-list">

                @foreach (var tx in _selectedTransactions)
                {
                    <div class="transaction-row">

                        <div class="transaction-date">
                            @tx.Date.ToShortDateString()
                        </div>

                        <div class="transaction-description">
                            @tx.Description
                        </div>

                        <div class="transaction-amount @(tx.Amount >= 0 ? "positive" : "negative")">
                            @Format(tx.Amount)
                        </div>

                    </div>
                }

            </div>

        </div>
    }

    <!-- UNMATCHED -->
    @if (_uncategorized.Any())
    {
        <div class="transaction-section">

            <div class="transaction-section-title">
                ⚠️ Ikke kategoriserede
            </div>

            <div class="transaction-list">

                @foreach (var tx in _uncategorized)
                {
                    <div class="transaction-row">

                        <div class="transaction-date">
                            @tx.Date.ToShortDateString()
                        </div>

                        <div class="transaction-description">
                            @tx.Description
                        </div>

                        <div class="transaction-amount negative">
                            @Format(tx.Amount)
                        </div>

                    </div>
                }

            </div>

        </div>
    }

    @if (_duplicateRules.Any())
    {
        <div class="transaction-section">

            <div class="transaction-section-title">
                ⚠️ Dublet regler
            </div>

            <div class="transaction-list">

                @foreach (var rule in _duplicateRules)
                {
                    <div class="transaction-row">

                        <div class="transaction-description">
                            @rule
                        </div>

                    </div>
                }

            </div>

        </div>
    }

    @if (_conflictingRules.Any())
    {
        <div class="transaction-section">

            <div class="transaction-section-title">
                ⚠️ Konflikt kategorier
            </div>

            <div class="transaction-list">

                @foreach (var rule in _conflictingRules)
                {
                    <div class="transaction-row">

                        <div class="transaction-description">
                            @rule
                        </div>

                    </div>
                }

            </div>

        </div>
    }
    }

</div>

@code {

    private List<BankTransaction> _transactions = [];

    private List<BankTransaction> _selectedTransactions = [];

    private string _selectedCategory = "";

    private decimal TotalIncome;

    private decimal TotalExpenses;

    private decimal Net;

    private decimal FixedExpenses;

    private decimal FixedIncome;

    private decimal FreeMoney;

    private List<BankTransaction> _uncategorized = [];

    private List<string> _duplicateRules = [];

    private List<CategoryCard> _categoryCards = [];

    protected override async Task OnInitializedAsync()
    {
        _transactions =
            await Db.Transactions
                .OrderByDescending(x => x.Date)
                .ToListAsync();

        TotalIncome =
            _transactions
                .Where(x => x.Amount > 0)
                .Sum(x => x.Amount);

        TotalExpenses =
            _transactions
                .Where(x => x.Amount < 0)
                .Sum(x => Math.Abs(x.Amount));

        Net =
            TotalIncome - TotalExpenses;

        FixedExpenses =
            _transactions
                .Where(x =>
                    x.Amount < 0 &&
                    x.BudgetGroup ==
                    BudgetGroup.FixedExpense)
                .Sum(x => Math.Abs(x.Amount));

        FixedIncome =
            _transactions
                .Where(x =>
                    x.Amount > 0 &&
                    x.BudgetGroup ==
                    BudgetGroup.FixedIncome)
                .Sum(x => x.Amount);

        FreeMoney =
            Net;

        _uncategorized =
            _transactions
                .Where(x =>
                    x.Category ==
                    Category.Andet)
                .ToList();

        _categoryCards =
            _transactions

                .Where(x => x.Amount < 0)

                .GroupBy(x => x.Category)

                .Select(group => new CategoryCard
                {
                    Category =
                        group.Key.ToString(),

                    Total =
                        Math.Abs(group.Sum(x => x.Amount)),

                    MonthlyAverage =
                        Math.Abs(group.Sum(x => x.Amount)) / 12,

                    TransactionCount =
                        group.Count()
                })

                .OrderByDescending(x => x.Total)

                .ToList();

        FindDuplicateRules();
    }

    private void SelectCategory(
        string category)
    {
        _selectedCategory = category;

        _selectedTransactions =
            _transactions

                .Where(x =>
                    x.Category.ToString() ==
                    category)

                .OrderByDescending(x => x.Date)

                .ToList();
    }

    private List<string> _conflictingRules = [];


    private void FindDuplicateRules()
    {
        _duplicateRules =
            TransactionRules.Rules

                .GroupBy(x =>
                    Normalize(x.Pattern))

                .Where(x => x.Count() > 1)

                .Select(x =>
                    $"{x.Key} ({x.Count()})")

                .OrderBy(x => x)

                .ToList();

        _conflictingRules =
            TransactionRules.Rules

                .GroupBy(x =>
                    Normalize(x.Pattern))

                .Where(x =>
                    x.Select(r => r.Category)
                        .Distinct()
                        .Count() > 1)

                .Select(x =>
                    $"{x.Key} => " +
                    string.Join(
                        ", ",
                        x.Select(y => y.Category)
                            .Distinct()))

                .OrderBy(x => x)

                .ToList();
    }
    private void GoToUpload()
    {
        Nav.NavigateTo("/budget/upload");
    }

    private string Format(
        decimal amount)
    {
        return $"{Math.Abs(amount):N0} kr.";
    }

    public class CategoryCard
    {
        public string Category { get; set; } = "";

        public decimal Total { get; set; }

        public decimal MonthlyAverage { get; set; }

        public int TransactionCount { get; set; }
    }
    private string Normalize(
        string input)
    {
        return input
            .Trim()
            .ToLowerInvariant();
    }
}