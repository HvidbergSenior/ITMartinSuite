@page "/budget-upload"
@layout BudgetMainLayout
@using ITMartinBudget.Infrastructure
@using ITMartinBudget.Server.Budget
@using Microsoft.EntityFrameworkCore
@* No @rendermode: plain HTML form + fetch() below instead of Blazor InputFile,
   which needs a live SignalR circuit - has previously gotten stuck reconnecting
   ("Forbinder...") through this app's Cloudflare Tunnel domain. *@

@inject BudgetDbContext Db

<div class="budget-container">

    <ContentCard>

        <div class="stack">

            <div>
                <h2>📁 Upload Budget CSV</h2>
                <div class="meta">Upload your bank export file</div>
            </div>

            <div class="header-actions">
                <a class="btn" href="/">Open Dashboard</a>
            </div>

            @if (_hasExistingData)
            {
                <div class="alert warning">
                    ⚠ Existing data detected
                    <button class="btn btn-danger" id="resetBtn">Delete all data</button>
                </div>
            }

            <div class="upload-box">
                <input type="file" id="csvFile" accept=".csv" />
            </div>

            <div id="status"></div>

        </div>

    </ContentCard>

</div>

<script>
// Deferred one tick: Blazor's DOM-patching (enhanced nav / streaming render)
// can still be inserting this script's own sibling markup when the script
// tag itself runs, so an immediate getElementById('csvFile') can race and
// return null ("Cannot read properties of null") - waiting a tick guarantees
// the surrounding markup has finished landing in the DOM first.
setTimeout(function () {
    const fileInput = document.getElementById('csvFile');
    const status = document.getElementById('status');
    const resetBtn = document.getElementById('resetBtn');
    if (!fileInput) return;

    fileInput.addEventListener('change', async () => {
        const file = fileInput.files[0];
        if (!file) return;
        if (!file.name.toLowerCase().endsWith('.csv')) {
            status.innerHTML = '<div class="alert error">Only CSV files allowed</div>';
            fileInput.value = '';
            return;
        }

        status.innerHTML = '<div class="meta">Uploading CSV...</div>';

        const form = new FormData();
        form.append('file', file);

        try {
            const res = await fetch('/api/budget/upload', { method: 'POST', body: form });
            if (!res.ok) {
                status.innerHTML = `<div class="alert error">${await res.text()}</div>`;
                return;
            }
            const body = await res.json();
            const msg = body.imported > 0
                ? `✔ Imported ${body.imported} transactions`
                : 'No new transactions (duplicates skipped)';
            status.innerHTML = `<div class="alert success">${msg}</div>`;
            setTimeout(() => { location.href = '/shop-categorize/family'; }, 1500);
        } catch (e) {
            status.innerHTML = '<div class="alert error">Upload failed - try again</div>';
        } finally {
            fileInput.value = '';
        }
    });

    if (resetBtn) {
        resetBtn.addEventListener('click', async () => {
            if (!confirm('Delete ALL budget data?')) return;
            const res = await fetch('/api/budget/reset', { method: 'POST' });
            if (res.ok) {
                status.innerHTML = '<div class="alert success">All data deleted</div>';
                resetBtn.closest('.alert').style.display = 'none';
            }
        });
    }
}, 0);
</script>

@code {
    private bool _hasExistingData;

    protected override async Task OnInitializedAsync()
    {
        _hasExistingData = await Db.Transactions.AnyAsync(x => x.LedgerId == "family");
    }
}
