@page "/family"
@using ITMartinBudget.Application.Interfaces
@using ITMartinBudget.Application.Models
@using ITMartinBudget.Application.Extensions

@inject IFamilyPlanningService FamilyPlanningService

<h1 class="page-title">
    Family Planning
</h1>

@if (_model is null)
{
    <div>Loading...</div>
}
else
{
    <div class="family-kpis">

        <div class="family-kpi income">

            <div class="label">
                Current Income
            </div>

            <div class="value">
                @(CurrentMonthlyIncome.ToString("N0")) kr/md
            </div>

        </div>

        <div class="family-kpi future">

            <div class="label">
                Future Income
            </div>

            <InputNumber
                class="future-income-input"
                @bind-Value="_futureIncome" />
            <div class="meta">
                Monthly income after change
            </div>
        </div>
       
        <div class="family-kpi">

            <div class="label">
                Income Reduction
            </div>

            <div class="value">
                @(IncomeReduction.ToString("N0")) kr.
            </div>

        </div>

        <div class="family-kpi @(FutureNetAmount >= 0 ? "income" : "expense")">

            <div class="label">
                Future Result
            </div>

            <div class="value">
                @(FutureNetAmount.ToString("N0")) kr.
            </div>

        </div>

            <div class="family-kpi @(AmountToFind > 0 ? "expense" : "income")">
            <div class="label">
                Need To Find
            </div>

            <div class="value">
                @(AmountToFind.ToString("N0")) kr.
            </div>

        </div>

    </div>

    <h2>
        Where Can We Find The Money?
    </h2>

    @foreach (var group in _model.BudgetGroups
                 .OrderByDescending(x => x.DisplayAmount))
    {
        <div class="category-summary-card clickable-card"
             @onclick="() => ToggleBudgetGroup(group.BudgetGroup.ToString())">

            <div class="category-summary-top">

                <div>

                    <div class="category-summary-title">
                        @group.BudgetGroup.ToDisplayName()
                    </div>

                    <div class="meta">
                        @group.TransactionCount transaktioner
                    </div>

                </div>

                <div class="category-summary-count">

                    @((group.DisplayAmount /
                        _model.MonthsLoaded)
                       .ToString("N0"))
                    kr/md

                </div>

            </div>

            <div class="category-summary-amount negative">

                @((group.DisplayAmount /
                   _model.MonthsLoaded)
                .ToString("N0"))
                kr/md

            </div>

            @if (_expandedBudgetGroup ==
                 group.BudgetGroup.ToString())
            {
                <div class="expanded-category-transactions">

                    @foreach (var tx in _model.Transactions
                                 .Where(x =>
                                     x.BudgetGroup ==
                                     group.BudgetGroup)
                                 .OrderByDescending(x =>
                                     Math.Abs(x.Amount)))
                    {
                        <div class="transaction-detail-row">

                            <div>
                                @tx.Date.ToString("dd-MM-yyyy")
                            </div>

                            <div>
                                @(string.IsNullOrWhiteSpace(tx.Title)
                                    ? tx.Description
                                    : tx.Title)
                            </div>

                            <div>
                                @(Math.Abs(tx.Amount).ToString("N0")) kr.
                            </div>

                        </div>
                    }

                </div>
            }
            <div class="meta">

                Total:
                @(group.DisplayAmount.ToString("N0"))
                kr.

            </div>
        </div>
    }
}

@code {
    public decimal FixedIncome { get; set; }
    private FamilyPlanningViewModel? _model;

    private decimal _futureIncome;

    private string? _expandedBudgetGroup;

    private decimal CurrentMonthlyIncome =>
        _model!.FixedIncome /
        _model.MonthsLoaded;
    
    private decimal CurrentMonthlyNet =>
        _model!.CurrentNetAmount /
        _model.MonthsLoaded;

    private decimal IncomeReduction =>
        CurrentMonthlyIncome -
        _futureIncome;

    private decimal FutureNetAmount =>
        CurrentMonthlyNet -
        IncomeReduction;
    private decimal AmountToFind =>
        FutureNetAmount < 0
            ? Math.Abs(FutureNetAmount)
            : 0;

    protected override async Task OnInitializedAsync()
    {
        _model =
            await FamilyPlanningService
                .BuildAsync();

        _futureIncome =
            _model.FixedIncome /
            _model.MonthsLoaded;
    }

    private void ToggleBudgetGroup(
        string name)
    {
        _expandedBudgetGroup =
            _expandedBudgetGroup == name
                ? null
                : name;
    }
}