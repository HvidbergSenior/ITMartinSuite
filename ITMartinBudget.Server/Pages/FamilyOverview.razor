@page "/family"
@using ITMartinBudget.Application.Interfaces
@using ITMartinBudget.Application.Models

@inject IFamilyPlanningService FamilyPlanningService

<h1 class="page-title">
    👨‍👩‍👧‍👦 Family Planning
</h1>

@if (_model is null)
{
    <div>Loading...</div>
}
else
{
    <div class="family-kpis">

        <div class="family-kpi income">

            <div class="label">
                Current Income
            </div>

            <div class="value">
                @_model.CurrentMonthlyIncome.ToString("N0") kr.
            </div>

        </div>

        <div class="family-kpi future">

            <div class="label">
                Future Income
            </div>

            <InputNumber
                class="future-income-input"
                @bind-Value="_futureIncome" />

        </div>

        <div class="family-kpi gap">

            <div class="label">
                Required Reduction
            </div>

            <div class="value">
                @IncomeGap.ToString("N0") kr.
            </div>

        </div>

        <div class="family-kpi savings">

            <div class="label">
                Potential Savings
            </div>

            <div class="value">
                @_model.PotentialSavings.ToString("N0") kr.
            </div>

        </div>

    </div>

    <h2>
        Income Sources
    </h2>

    @foreach (var income in _model.IncomeCategories)
    {
        <div class="family-card clickable-card"
             @onclick="() => ToggleIncome(income.Name)">

            <div class="family-card-header">

                <span>@income.Name</span>

                <span>
                    @income.MonthlyAmount.ToString("N0") kr/md
                </span>

            </div>

            @if (_expandedIncome == income.Name)
            {
                <div class="transaction-list">

                    @foreach (var tx in income.Transactions)
                    {
                        <div class="transaction-row">

                            <span>
                                @tx.Date.ToString("dd/MM/yyyy")
                            </span>

                            <span>
                                @tx.Title
                            </span>

                            <span>
                                @tx.Amount.ToString("N0")
                            </span>

                        </div>
                    }

                </div>
                
            }

        </div>
    }

    <h2>
        Budget Groups
    </h2>

    @foreach (var group in _model.BudgetGroups
                 .OrderByDescending(x => x.MonthlyAmount))
    {
        <div class="family-card clickable-card"
             @onclick="() => ToggleBudgetGroup(group.Name)">

            <div class="family-card-header">

                <div>

                    <div class="group-name">
                        @group.Name
                    </div>

                    <div class="group-meta">

                        @group.PercentOfIncome.ToString("N1")%
                        of income

                    </div>

                </div>

                <div>
                    @group.MonthlyAmount.ToString("N0")
                    kr/md
                </div>

            </div>

            @if (_expandedBudgetGroup == group.Name)
            {
                <div class="transaction-list">

                    @foreach (var tx in group.Transactions
                                 .OrderByDescending(x =>
                                     Math.Abs(x.Amount)))
                    {
                        <div class="transaction-row">

                            <span>
                                @tx.Date.ToString("dd/MM/yyyy")
                            </span>

                            <span>
                                @tx.Title
                            </span>

                            <span>
                                @Math.Abs(tx.Amount)
                                    .ToString("N0")
                            </span>

                        </div>
                    }

                </div>
            }

        </div>
    }

    <h2>
        Suggested Reductions
    </h2>

    @foreach (var group in _model.BudgetGroups
                 .Where(x =>
                     x.PotentialReduction > 0)
                 .OrderByDescending(x =>
                     x.PotentialReduction))
    {
        <div class="family-card">

            <div class="family-card-header">

                <span>
                    @group.Name
                </span>

                <span>
                    Save
                    @group.PotentialReduction
                        .ToString("N0")
                    kr
                </span>

            </div>

        </div>
    }
}

@code {

    private FamilyPlanningViewModel?
        _model;

    private decimal _futureIncome;

    private string? _expandedIncome;

    private string? _expandedBudgetGroup;

    private decimal IncomeGap =>
        Math.Max(
            0,
            _model!.CurrentMonthlyIncome -
            _futureIncome);

    protected override async Task
        OnInitializedAsync()
    {
        _model =
            await FamilyPlanningService
                .BuildAsync();

        _futureIncome =
            _model.CurrentMonthlyIncome;
    }

    private void ToggleIncome(
        string name)
    {
        _expandedIncome =
            _expandedIncome == name
                ? null
                : name;
    }

    private void ToggleBudgetGroup(
        string name)
    {
        _expandedBudgetGroup =
            _expandedBudgetGroup == name
                ? null
                : name;
    }
}