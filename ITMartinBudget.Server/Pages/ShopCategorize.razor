@page "/"
@page "/shop-categorize/{LedgerId}"
@using ITMartinBudget.Server.Budget
@* No @rendermode: plain REST + vanilla JS below instead of Blazor interactivity -
   Blazor Server needs a persistent SignalR circuit, which has previously gotten
   stuck reconnecting ("Forbinder...") through this app's Cloudflare Tunnel
   domain. Same reasoning ITMartinLive/ITMartinStream use REST+polling instead
   of SignalR. *@

<PageTitle>Kategoriser - @LedgerId</PageTitle>

<div class="budget-container">
    <StepNav LedgerId="@LedgerId" CurrentStep="2" />
    <ContentCard>
        <div class="stack">

            <ProblemPurposeBanner
                Problem="En automatisk klassificering rammer aldrig alt rigtigt, og et bankudtog fra en delt konto har brug for et menneskes ord på, hvad tingene faktisk er."
                Formaal="Hver tilbagevendende post for sig (Føtex, Husleje, ...) - sæt en kategori og om det er forretning eller privat. Gemmes og bruges automatisk næste gang der uploades en ny CSV til samme konto." />

            <div>
                <h1 class="page-title">Kategoriser - @LedgerId</h1>
                <div class="meta" id="clusterCount">Indlæser...</div>
                <div class="meta" id="investigateAllStatus" style="margin-top:6px"></div>
            </div>

            <div id="mergeSuggestionBanner" style="display:none"></div>

            <datalist id="categoryOptions"></datalist>
            <div id="clusters" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(420px, 1fr));gap:10px"></div>

        </div>
    </ContentCard>
</div>

<script>
// Deferred one tick - see the same guard in ShopUpload.razor/BudgetUpload.razor:
// Blazor's DOM-patching can still be inserting this script's own sibling
// markup (#clusterCount, #clusters) when the script tag itself runs.
setTimeout(function () {
    // Read straight from the URL rather than interpolating server-side -
    // this page renders with no live circuit (see the note above), so
    // there's no Blazor state to pull LedgerId from client-side anyway.
    // This page also serves as "/" (the app home page) - pathname there has
    // no segments at all, so .pop() would return undefined instead of
    // falling through to any sensible default.
    const pathSegments = location.pathname.split('/').filter(Boolean);
    const ledgerId = pathSegments.length > 0 ? decodeURIComponent(pathSegments.pop()) : 'family';
    let categories = [];

    function esc(s) {
        if (s == null) return '';
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function fmtDate(iso) {
        const d = new Date(iso);
        return d.toLocaleDateString('da-DK', { year: 'numeric', month: 'short' });
    }

    const scopeLabel = { Unknown: 'Ukendt', Business: 'Forretning', Private: 'Privat' };
    const scopeLabelDa = { Business: 'Forretning', Private: 'Privat', Unsure: 'Usikker' };
    let scopeMode = 'Both';

    // Same idea as GroupHome.razor's MainTaskColors in the Club app: subtle
    // tinted backgrounds cycled by list position (not stored per-category),
    // so a category's color stays stable within one render without needing
    // any data migration when categories are renamed/merged/added.
    const categoryColors = [
        'rgba(99,102,241,.10)',  // indigo
        'rgba(16,185,129,.10)',  // green
        'rgba(245,158,11,.10)',  // amber
        'rgba(236,72,153,.10)',  // pink
        'rgba(56,189,248,.10)',  // sky
        'rgba(248,113,113,.10)', // red
        'rgba(168,85,247,.10)',  // purple
        'rgba(163,163,163,.10)', // gray
    ];
    let categoryColorByName = new Map();
    function colorForCategory(name) {
        if (!name) return '';
        if (!categoryColorByName.has(name)) {
            categoryColorByName.set(name, categoryColors[categoryColorByName.size % categoryColors.length]);
        }
        return categoryColorByName.get(name);
    }

    function investigateResultHtml(result) {
        return `
            <details style="margin-top:8px">
                <summary style="cursor:pointer;list-style:none;color:var(--blue);font-size:13px">🤖 AI-vurdering</summary>
                <div class="alert" style="margin-top:6px;background:rgba(96,165,250,.1);border:1px solid rgba(96,165,250,.3)">
                    <div style="font-size:13px">${esc(result.reasoning)}</div>
                    <div class="meta" style="margin-top:4px">
                        Gæt: <strong>${scopeLabelDa[result.suggestedScope] || result.suggestedScope}</strong> · Sikkerhed: ${result.confidence}
                    </div>
                </div>
            </details>`;
    }

    // Batched, capped - one call handles every remaining uninvestigated,
    // uncategorized pattern at once (see the endpoint's own comment for why
    // this replaced a per-card loop). Defaults each pattern's category name
    // to its own label and applies the AI's Business/Private guess directly,
    // so a freshly-uploaded ledger starts pre-populated instead of blank.
    async function runInvestigateRemaining(statusMessage) {
        const statusEl = document.getElementById('investigateAllStatus');
        if (statusEl && statusMessage) statusEl.textContent = statusMessage;
        try {
            const res = await fetch(`/api/shop/${encodeURIComponent(ledgerId)}/investigate-remaining`, { method: 'POST' });
            if (!res.ok) throw new Error();
            const body = await res.json();
            if (statusEl) {
                statusEl.textContent = body.investigated > 0
                    ? `Færdig - AI kategoriserede ${body.investigated} post(er) automatisk.${body.cappedAt ? ' (loftet for én omgang er nået - kør igen for resten.)' : ''}`
                    : 'Alle poster er allerede undersøgt.';
            }
            return body;
        } catch {
            if (statusEl) statusEl.textContent = 'Kunne ikke undersøge automatisk - prøv igen.';
            return null;
        }
    }

    // After an auto- or manual investigate-remaining pass, every pattern has
    // a category name (its own label, by default) - now worth checking for
    // near-duplicates (e.g. "Bertil" / "Bertil Hvidberg" / "Bertil Hv") that
    // should really be one category. Same /suggest-merges call
    // /shop-categories' own "Foreslå grupperinger" button makes.
    async function runSuggestMerges() {
        const banner = document.getElementById('mergeSuggestionBanner');
        try {
            const categoriesRes = await fetch(`/api/shop/${encodeURIComponent(ledgerId)}/category-summary`);
            const summary = await categoriesRes.json();
            if (summary.length < 2) return;

            // Two sources: a free deterministic pass (same merchant/person
            // spread across bank-export channel prefixes and field-length
            // truncation - "Fie Tandrup" across 4 differently formatted
            // names, "IMUSIC.DK" across 4 order numbers - see
            // CategoryDuplicateFinder's own comment) plus an AI pass for
            // merges that need real judgment (different gas station brands
            // into "Benzin"). The deterministic ones are purely mechanical
            // string matches, not judgment calls, so they're applied
            // automatically here rather than waiting for a Flet review -
            // the AI ones still need a human to look, since "these belong
            // together conceptually" is a genuine judgment call.
            const [dupRes, aiRes] = await Promise.all([
                fetch(`/api/shop/${encodeURIComponent(ledgerId)}/find-duplicate-categories`),
                fetch(`/api/shop/${encodeURIComponent(ledgerId)}/suggest-merges`, { method: 'POST' }),
            ]);
            const dupGroups = dupRes.ok ? await dupRes.json() : [];
            const aiSuggestions = aiRes.ok ? await aiRes.json() : [];

            const dupKey = g => [...g.sourceNames].sort().join(' ');
            const dupKeys = new Set(dupGroups.map(dupKey));
            const aiOnly = aiSuggestions.filter(s => !dupKeys.has(dupKey(s)));

            let mergedCount = 0;
            for (const group of dupGroups) {
                const res = await fetch(`/api/shop/${encodeURIComponent(ledgerId)}/merge-categories`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sourceNames: group.sourceNames, targetName: group.suggestedTargetName }),
                });
                if (res.ok) mergedCount++;
            }

            if (aiOnly.length === 0) {
                banner.style.display = mergedCount > 0 ? '' : 'none';
                if (mergedCount > 0) {
                    banner.innerHTML = `<div class="meta">✔ Sammenlagde automatisk ${mergedCount} gruppe(r) af ens kategorier.</div>`;
                }
                return;
            }

            banner.style.display = '';
            banner.innerHTML = `
                ${mergedCount > 0 ? `<div class="meta" style="margin-bottom:8px">✔ Sammenlagde automatisk ${mergedCount} gruppe(r) af ens kategorier.</div>` : ''}
                <div class="alert" style="background:rgba(96,165,250,.1);border:1px solid rgba(96,165,250,.3)">
                    <strong>💡 AI fandt ${aiOnly.length} mulige sammenlægning(er), der kræver et skøn</strong>
                    <div style="margin-top:6px;display:flex;flex-direction:column;gap:4px">
                        ${aiOnly.map(s => `<div class="meta">${s.sourceNames.map(esc).join(' + ')} → <strong>${esc(s.suggestedTargetName)}</strong></div>`).join('')}
                    </div>
                    <div style="margin-top:10px">
                        <a class="btn btn-primary" href="/shop-categories/${esc(ledgerId)}" data-enhance-nav="false">Gennemgå og flet</a>
                    </div>
                </div>`;
        } catch {
            // Purely a nice-to-have surfaced inline - a failure here shouldn't
            // block the categorize page itself from working.
        }
    }

    // Fires once per page load, unconditionally (no more manual "Gem alle
    // synlige"/"Undersøg alle resterende" buttons - both used to be
    // separate clicks, now both just happen automatically every time this
    // page opens). module-level so the second load() call (after the
    // auto-run finishes) never re-triggers it. See
    // /api/shop/{ledgerId}/investigate-remaining for why this is safe to run
    // automatically (batched + capped, and a no-op fast round-trip when
    // nothing actually needs fixing) where the old per-card loop was not.
    let autoRanOnce = false;

    async function load() {
        const [clustersRes, categoriesRes, scopeModeRes] = await Promise.all([
            fetch(`/api/shop/${encodeURIComponent(ledgerId)}/clusters`),
            fetch(`/api/shop/${encodeURIComponent(ledgerId)}/categories`),
            fetch(`/api/shop/${encodeURIComponent(ledgerId)}/scope-mode`),
        ]);
        const clusters = await clustersRes.json();
        categories = await categoriesRes.json();
        scopeMode = (await scopeModeRes.json()).scopeMode;
        const fixedScope = scopeMode === 'PrivateOnly' ? 'Private' : scopeMode === 'BusinessOnly' ? 'Business' : null;

        document.getElementById('categoryOptions').innerHTML =
            categories.map(name => `<option value="${esc(name)}"></option>`).join('');

        const done = clusters.filter(c => c.currentCategoryName).length;
        document.getElementById('clusterCount').innerHTML =
            `${done} / ${clusters.length} kategoriseret · <a href="/shop-categories/${esc(ledgerId)}" data-enhance-nav="false" style="text-decoration:none">Flet kategorier</a>`;

        if (!autoRanOnce) {
            autoRanOnce = true;
            await runInvestigateRemaining('Sikrer at alt er kategoriseret...');
            // Retroactively cleans any category name the app itself
            // generated before CategoryNameCleaner existed (e.g. "BS CODAN
            // FORSIKRING") - before the dup/merge pass below, so that pass
            // groups on already-clean names instead of noise.
            await fetch(`/api/shop/${encodeURIComponent(ledgerId)}/clean-category-names`, { method: 'POST' }).catch(() => {});
            await runSuggestMerges();
            return load();
        }

        const container = document.getElementById('clusters');

        function dateRangeStr(first, last) {
            if (!first || !last) return '';
            return fmtDate(first) === fmtDate(last) ? fmtDate(first) : `${fmtDate(first)} - ${fmtDate(last)}`;
        }

        // Still-uncategorized patterns render one card each, same as before -
        // each genuinely needs its own look. Already-categorized patterns
        // get grouped into ONE card per category name, however many
        // patterns share it ("They should be shown as One category. For
        // instance Dagligvarer or Fie Tandrup", 2026-09-07) - a merge
        // already made them the same thing, the page should say so.
        const uncategorized = clusters.filter(c => !c.currentCategoryName);
        const categorized = clusters.filter(c => c.currentCategoryName);

        const byCategory = new Map();
        for (const c of categorized) {
            const key = c.currentCategoryName;
            if (!byCategory.has(key)) byCategory.set(key, []);
            byCategory.get(key).push(c);
        }

        const cards = [
            ...uncategorized.map(c => ({
                needsReview: true,
                title: c.label,
                meta: `${dateRangeStr(c.firstDate, c.lastDate)}${c.sampleRawDetails ? ` · fx: ${esc(c.sampleRawDetails.trim().slice(0, 60))}` : ''}`,
                count: c.count,
                sum: c.sum,
                patterns: [c.pattern],
                category: null,
                defaultCategory: c.label,
                scope: c.scope,
                investigateHtml: c.investigationReasoning
                    ? investigateResultHtml({ reasoning: c.investigationReasoning, suggestedScope: c.investigationSuggestedScope, confidence: c.investigationConfidence })
                    : '',
            })),
            ...[...byCategory.entries()].map(([categoryName, items]) => {
                const dates = items.flatMap(c => [c.firstDate, c.lastDate]).filter(Boolean);
                const firstDate = dates.length ? dates.reduce((a, b) => a < b ? a : b) : null;
                const lastDate = dates.length ? dates.reduce((a, b) => a > b ? a : b) : null;
                const sampleRawDetails = items.find(c => c.sampleRawDetails)?.sampleRawDetails || '';
                // Majority scope across the group - every pattern in it was
                // almost always assigned the same way, but a group is still
                // shown/edited as one field, so pick the most common rather
                // than assuming.
                const scopeCounts = {};
                for (const c of items) scopeCounts[c.scope] = (scopeCounts[c.scope] || 0) + 1;
                const scope = Object.entries(scopeCounts).sort((a, b) => b[1] - a[1])[0][0];
                return {
                    needsReview: false,
                    title: categoryName,
                    meta: `${items.length > 1 ? `${items.length} typer · ` : ''}${dateRangeStr(firstDate, lastDate)}${sampleRawDetails ? ` · fx: ${esc(sampleRawDetails.trim().slice(0, 60))}` : ''}`,
                    count: items.reduce((s, c) => s + c.count, 0),
                    sum: items.reduce((s, c) => s + c.sum, 0),
                    patterns: items.map(c => c.pattern),
                    category: categoryName,
                    defaultCategory: categoryName,
                    scope,
                    // A merged group's own investigation guess stops being
                    // meaningful once it's aggregating several patterns -
                    // only show it for a still-single-pattern category.
                    investigateHtml: items.length === 1 && items[0].investigationReasoning
                        ? investigateResultHtml({ reasoning: items[0].investigationReasoning, suggestedScope: items[0].investigationSuggestedScope, confidence: items[0].investigationConfidence })
                        : '',
                };
            }),
        // "order on cards should be in Amount of Transactions and exact
        // money amount" (2026-09-07) - most transactions first, ties broken
        // by total money moved (biggest first either direction).
        ].sort((a, b) => b.count - a.count || Math.abs(b.sum) - Math.abs(a.sum));

        container.innerHTML = cards.map(card => {
            // A single-scope ledger (Hvidberg=private-only, ITMartin=business-only)
            // has nothing to choose - skip the dropdown and needs-review flag,
            // since there's no ambiguity a human has to resolve.
            const scopeField = fixedScope
                ? `<input type="hidden" data-role="scope" value="${fixedScope}" />`
                : `<select class="input" style="width:auto" data-role="scope">
                        <option value="Unknown" ${card.scope === 'Unknown' ? 'selected' : ''}>Ukendt</option>
                        <option value="Business" ${card.scope === 'Business' ? 'selected' : ''}>Forretning</option>
                        <option value="Private" ${card.scope === 'Private' ? 'selected' : ''}>Privat</option>
                    </select>`;
            // Only worth an expand-to-inspect affordance when there's more
            // than one underlying transaction - a single-transaction card
            // already shows everything relevant in the row itself.
            const detail = card.count > 1
                ? `<details data-role="detail">
                        <summary style="cursor:pointer;list-style:none;color:var(--blue);font-size:13px;margin-top:8px">📋 Se ${card.count} transaktioner${card.patterns.length > 1 ? ` (${card.patterns.length} typer)` : ''}</summary>
                        <div data-role="txList" style="margin-top:8px;display:flex;flex-direction:column;gap:4px">
                            <div class="meta">Indlæser...</div>
                        </div>
                    </details>`
                : '';
            // No color for a still-uncategorized card - the orange
            // needs-review border is the signal there, a category tint
            // would just muddy it (there's no real category to color yet).
            const cardColor = card.needsReview ? '' : colorForCategory(card.title);
            return `
            <div class="category-summary-card category-summary-card--compact ${card.needsReview ? 'category-summary-card--unknown' : ''}"
                 ${cardColor ? `style="background:${cardColor}"` : ''}
                 data-patterns="${esc(JSON.stringify(card.patterns))}" ${card.category ? `data-category="${esc(card.category)}"` : ''}
                 data-count="${card.count}" data-sum="${card.sum}">
                <div class="category-summary-top">
                    <div>
                        <div class="category-summary-title">${esc(card.title)}</div>
                        <div class="meta">${card.meta}</div>
                    </div>
                    <div class="meta ${card.sum < 0 ? 'amount-negative' : 'amount-positive'}" style="white-space:nowrap">${card.count} stk. · ${card.sum < 0 ? '−' : '+'}${Math.round(Math.abs(card.sum)).toLocaleString('da-DK')} kr. i alt</div>
                </div>
                ${detail}
                <div data-role="investigateResult">${card.investigateHtml}</div>
                <div style="display:flex;flex-direction:column;gap:10px;margin-top:12px">
                    <div style="display:flex;gap:10px;align-items:flex-end">
                        <label style="display:flex;flex-direction:column;gap:3px;flex-shrink:0">
                            <span class="meta">Type</span>
                            ${scopeField}
                        </label>
                        <label style="display:flex;flex-direction:column;gap:3px;flex:1;min-width:0">
                            <span class="meta">Kategori</span>
                            <input class="input" style="width:100%" data-role="category" list="categoryOptions"
                                   value="${esc(card.defaultCategory)}" placeholder="Skriv ny eller vælg en eksisterende..." />
                        </label>
                    </div>
                </div>
            </div>
        `; }).join('');

        container.querySelectorAll('[data-role="detail"]').forEach(details => {
            let loaded = false;
            details.addEventListener('toggle', async () => {
                if (!details.open || loaded) return;
                loaded = true;
                const cardEl = details.closest('.category-summary-card');
                const category = cardEl.dataset.category;
                const txList = details.querySelector('[data-role="txList"]');
                // A grouped card fetches by category (spans every pattern in
                // it); a still-uncategorized card has no category yet, so
                // it fetches by its one pattern instead.
                const url = category
                    ? `/api/shop/${encodeURIComponent(ledgerId)}/transactions-by-category?category=${encodeURIComponent(category)}`
                    : `/api/shop/${encodeURIComponent(ledgerId)}/transactions?pattern=${encodeURIComponent(JSON.parse(cardEl.dataset.patterns)[0])}`;
                const res = await fetch(url);
                const txs = await res.json();
                txList.innerHTML = txs.map(tx => `
                    <div style="display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:4px 0;border-top:1px solid var(--border)">
                        <span style="color:var(--muted);white-space:nowrap">${fmtDate(tx.date)}</span>
                        <span style="flex:1">${esc(tx.description)}</span>
                        <span class="${tx.amount < 0 ? 'amount-negative' : 'amount-positive'}" style="white-space:nowrap">
                            ${tx.amount < 0 ? '−' : '+'}${Math.round(Math.abs(tx.amount)).toLocaleString('da-DK')} kr.
                        </span>
                    </div>
                `).join('');
            });
        });

        // No more Gem/Undersøg buttons - editing Type or Kategori saves
        // immediately (blur for the text field, so it doesn't fire on every
        // keystroke; change for the dropdown). Auto-categorize on load
        // already gives every cluster a real answer - this is purely for
        // the cases a human wants to correct by hand.
        container.querySelectorAll('[data-role="category"]').forEach(input => {
            input.addEventListener('blur', () => save(input.closest('.category-summary-card')));
        });
        container.querySelectorAll('[data-role="scope"]').forEach(select => {
            select.addEventListener('change', () => save(select.closest('.category-summary-card')));
        });
    }

    async function save(card) {
        const pattern = card.dataset.pattern;
        const scope = card.querySelector('[data-role="scope"]').value;
        const categoryName = card.querySelector('[data-role="category"]').value.trim();

        if (!categoryName) return false;

        const res = await fetch(`/api/shop/${encodeURIComponent(ledgerId)}/assign`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pattern, categoryName, scope }),
        });

        if (res.ok) {
            if (!categories.includes(categoryName)) {
                categories.push(categoryName);
                document.getElementById('categoryOptions').insertAdjacentHTML('beforeend', `<option value="${esc(categoryName)}"></option>`);
            }
            card.classList.remove('category-summary-card--unknown');
            return true;
        }
        return false;
    }

    load();
}, 0);
</script>

@code {
    // Still needed even with no @rendermode - the {LedgerId} route token has
    // to bind to a component parameter for server-side prerendering (used in
    // the PageTitle/link above) regardless of whether the page is interactive.
    // Defaults to "family" so this page also serves as "/" (the app's home
    // page) - the {LedgerId} route token is only present when reached via
    // /shop-categorize/{ledger}, so routing never sets this property when
    // landing on "/" directly.
    [Parameter] public string LedgerId { get; set; } = "family";

    // The property initializer above isn't reliably honored across the two
    // route templates in practice ("/" was rendering an empty LedgerId
    // rather than falling back to "family") - enforce the fallback
    // explicitly instead of trusting routing to leave the C# default alone.
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(LedgerId))
        {
            LedgerId = "family";
        }
    }
}
