@page "/login"
@layout ITMartinBudget.Server.Layout.KolibriLayout

<PageTitle>Log ind – MitBudget</PageTitle>

<div class="mb-narrow">
    <div class="k-card">
        <h1 class="k-card-title">Log ind</h1>
        <p class="k-card-sub">Dine tal er private. Skriv din PIN-kode for at se dem.</p>
        @if (Error == "1")
        {
            <div class="k-alert k-alert-danger" role="alert">Forkert PIN-kode. Prøv igen.</div>
        }
        @* A plain form post, so logging in works without a live connection. *@
        <form method="post" action="/api/auth/login" class="k-stack">
            <label class="k-label" for="pin">PIN-kode</label>
            <input id="pin" type="password" name="pin" class="k-input" autocomplete="current-password" autofocus maxlength="30" />
            <button type="submit" class="k-btn k-btn-primary k-btn-block">Log ind</button>
        </form>
    </div>
    <p class="k-muted mb-center">Har du ikke en PIN-kode? Skriv til Martin på ITMartin@Mensa.dk eller ring 31 19 47 30.</p>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
