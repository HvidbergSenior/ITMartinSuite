@inherits LayoutComponentBase
<KolibriTitle />
@* The same Kolibri frame as MinElpris: KolibriHeader with the few tabs that matter, k-main/k-content, KolibriFooter. *@
<KolibriHeader Wide="true">
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/" Match="NavLinkMatch.All">Kategorier</NavLink>
    <a class="k-btn k-btn-ghost k-btn-sm k-hide-mobile" href="/laeg-ind">Læg ind</a>
    <a class="k-btn k-btn-ghost k-btn-sm k-hide-mobile" href="/kolibri/om">Om</a>
    <button id="themeToggleBtn" data-kolibri="1" class="k-btn k-btn-ghost k-btn-sm" type="button" title="Skift lys/mørk visning">Lys/mørk</button>
</KolibriHeader>
<div class="k-main"><div class="k-content wide">
    @Body
</div></div>
<KolibriFooter />
