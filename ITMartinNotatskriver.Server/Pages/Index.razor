@page "/"
@implements IAsyncDisposable
@inject UsagePlan Plan
@inject WriteDocument Writer
@inject AddAttachment Adder
@inject IWordExporter Word
@inject IJSRuntime JS
@inject IConfiguration Config

@* The page only shows and collects; the rules live in the Domain (NoteDraft, UsagePlan, PersonalData) and the
   steps in the Application (WriteDocument, AddAttachment). data-test names are used by ITMartinTests/Flows. *@
<PageTitle>Notatskriver</PageTitle>

<header class="ns-head">
    <h1>✍️ Notatskriver</h1>
    <p>@(Plan.Dictation ? "Fra stikord, diktat og billeder af håndskrift til færdigt dokument." : "Fra stikord og billeder af tekst til færdigt dokument.")</p>
</header>

@if (_locked)
{
    <section class="k-card ns-card ns-gate">
        <h2>🔑 Testversion</h2>
        <p>Notatskriver er i test. Skriv den adgangskode, du har fået.</p>
        <input class="k-input" type="password" @bind="_code" @bind:event="oninput" @onkeydown="@(e => e.Key == "Enter" ? Unlock() : Task.CompletedTask)" placeholder="Adgangskode" />
        <button class="k-btn ns-go" @onclick="Unlock">Lås op</button>
        @if (_codeWrong) { <p class="ns-err">Forkert kode.</p> }
    </section>
}
else
{
<div class="ns-grid">
    @* ── 1. Notes ── *@
    <section class="k-card ns-card">
        <h2>1. Dine noter</h2>
        @if (Plan == UsagePlan.Free)
        {
            <p class="k-help">Skriv eller indsæt dine stikord herunder – korte linjer er fint. Har du teksten et andet sted, så tag et <b>skærmbillede</b> eller et <b>billede</b> af den. AI'en skriver det hele om til et færdigt dokument.</p>
            <div class="ns-inputs">
                <button data-test="pick-images" class="k-btn k-btn-secondary ns-big" @onclick='() => JS.InvokeVoidAsync("notat.pick", "pics")' disabled="@(_busy || _draft.IsFull)">🖼️ Skærmbillede eller billede af tekst</button>
                <InputFile id="pics" class="ns-hidden" OnChange="OnFiles" accept="image/*" multiple />
            </div>
            <p class="k-help ns-small" data-test="free-note">🆓 Gratis: tekst og op til @Plan.MaxAttachments billeder. Vil du også kunne tale noterne ind eller sende filer (PDF, Word)? Skriv til ITMartin@Mensa.dk.</p>
        }
        else
        {
            <p class="k-help">Skriv stikord, tal dem ind, eller tag billeder af dine håndskrevne noter (flere sider er fint).</p>
            <div class="ns-inputs">
                <button data-test="take-photo" class="k-btn ns-big" @onclick='() => JS.InvokeVoidAsync("notat.pick", "cam")' disabled="@(_busy || _draft.IsFull)">📷 Tag billede</button>
                <InputFile id="cam" class="ns-hidden" OnChange="OnFiles" accept="image/*" capture="environment" multiple />
                <button data-test="pick-files" class="k-btn k-btn-secondary ns-big" @onclick='() => JS.InvokeVoidAsync("notat.pick", "files")' disabled="@(_busy || _draft.IsFull)">📎 Vælg filer</button>
                <InputFile id="files" class="ns-hidden" OnChange="OnFiles" accept="image/*,.pdf,.docx,.txt,text/plain" multiple />
                @if (_canDictate && Plan.Dictation)
                {
                    <button data-test="dictate" class="k-btn @(_dictating ? "ns-rec" : "k-btn-secondary") ns-big" @onclick="ToggleDictate" disabled="@_busy">@(_dictating ? "⏹ Stop" : "🎤 Tal")</button>
                }
            </div>
            @if (!_canDictate)
            {
                <p class="k-help">🎤 Vil du tale? Tryk i tekstfeltet og brug mikrofonen på telefonens tastatur.</p>
            }
            else { <p class="k-help ns-small">🎤 bruger din browsers talegenkendelse – i Chrome/Edge sendes lyden til Google/Microsoft. <a href="/privatliv">Læs mere</a></p> }
            @if (_dictating) { <p class="ns-live">● Lytter … tal tydeligt. Teksten kommer ind i feltet herunder.</p> }
        }

        @if (_draft.Attachments.Count > 0)
        {
            <ul class="ns-bilag" data-test="attachments">
                @foreach (var a in _draft.Attachments)
                {
                    <li>
                        @if (a.Kind == AttachmentKind.Image) { <img src="@Thumb(a)" alt="" /> } else { <span class="ns-fileicon">@(a.Kind == AttachmentKind.Pdf ? "📕" : "📄")</span> }
                        <span class="ns-bname">@a.Name</span>
                        <button class="ns-x" title="Fjern" @onclick="() => Remove(a)" disabled="@_busy">✕</button>
                    </li>
                }
            </ul>
        }

        <textarea data-test="notes" class="ns-notes" @bind="_draft.Notes" @bind:event="oninput" rows="9" placeholder="fx: møde m. Bo og Lis – budget 2027 – ny printer ok, max 3000 – Lis tjekker tilbud til fredag"></textarea>
    </section>

    @* ── 2. What to make ── *@
    <section class="k-card ns-card">
        <h2>2. Hvad skal det blive?</h2>
        <div class="ns-types">
            @foreach (var t in DocumentType.All)
            {
                <button class="ns-type @(t == _draft.Type ? "on" : "")" @onclick="() => _draft.Type = t" disabled="@_busy"><span>@t.Icon</span>@t.Title</button>
            }
        </div>
        <label class="ns-label" for="ekstra">Ekstra ønske (valgfrit)</label>
        <input id="ekstra" class="k-input" @bind="_draft.Extra" placeholder="fx: kort, uformel tone, til min chef" disabled="@_busy" />

        @if (_draft.HasVisuals)
        {
            <label class="ns-confirm">
                <input data-test="confirm-visuals" type="checkbox" checked="@_draft.VisualsConfirmed" @onchange="e => _draft.ConfirmVisuals(e.Value is true)" disabled="@_busy" />
                <span>Mine billeder/PDF'er indeholder ikke CPR-numre eller oplysninger om andres helbred (fx patienter).</span>
            </label>
        }

        @if (_stopped is { } st)
        {
            <div data-test="stopped" class="ns-block @(st.Hard ? "hard" : "")" role="alert">
                <b>@(st.Hard ? "⛔ Det her må du ikke sende" : "✋ Det her må du ikke sende – fjern personoplysningerne først")</b>
                <p>@st.Message</p>
                @if (st.Findings.Count > 0)
                {
                    <ul>@foreach (var f in st.Findings) { <li>@f.What: <code>@f.Example</code></li> }</ul>
                }
                @if (!st.Hard)
                {
                    <button data-test="hide-and-continue" class="k-btn" @onclick="() => WriteAsync(hideNames: true)">🙈 Skjul dem og fortsæt</button>
                    <p class="k-help">CPR, telefon, e-mail og adresser byttes ud med fx [CPR1], før noget sendes til AI'en – og sættes ind igen i dit færdige dokument.</p>
                }
                else
                {
                    <p class="k-help">Til notater om patienter/borgere: brug <b>Notatskriver til Windows</b>, hvor AI'en kører på din egen PC, eller et AI-værktøj din arbejdsplads har godkendt.</p>
                }
            </div>
        }

        <button data-test="write" class="k-btn ns-go" @onclick="() => WriteAsync(hideNames: false)" disabled="@(_busy || !_draft.CanWrite)">@(_busy ? "⏳ Skriver …" : "✨ Skriv dokumentet")</button>
        @if (_busy) { <p class="k-help">Det tager typisk 10-30 sekunder@(_draft.HasVisuals ? " – lidt længere med billeder" : "").</p> }
        @if (_error is not null) { <p data-test="error" class="ns-err">@_error</p> }
    </section>

    @* ── 3. Result ── *@
    @if (_result is not null)
    {
        <section class="k-card ns-card ns-result" id="result" data-test="result">
            <h2>3. @_draft.Type.Icon @_draft.Type.Title</h2>
            <p class="k-help">Læs det igennem og ret direkte i teksten. [?] = AI'en kunne ikke læse det sikkert. [dato] o.l. = mangler i dine noter.</p>
            <textarea class="ns-out" @bind="_result" @bind:event="oninput" rows="16"></textarea>
            <div class="ns-inputs">
                <button class="k-btn ns-big" @onclick="Copy">📋 @(_copied ? "Kopieret!" : "Kopiér")</button>
                <button class="k-btn k-btn-secondary ns-big" @onclick="DownloadWord">💾 Hent som Word</button>
                @if (_canShare) { <button class="k-btn k-btn-secondary ns-big" @onclick="Share">📤 Del</button> }
                <button class="k-btn k-btn-secondary ns-big" @onclick="New">🧹 Nyt dokument</button>
            </div>
        </section>
    }
</div>
}

<p class="k-help ns-privacy" data-test="privacy">🔒 Intet gemmes. Dine noter, billeder og dokumentet forsvinder, når du lukker siden. Teksten sendes til AI'en Claude (Anthropic) for at blive skrevet. Notatskriver må ikke bruges til oplysninger om patienter eller borgere.<br /><a href="/privatliv">Privatlivspolitik</a> · <a href="/vilkaar">Vilkår</a></p>

@code {
    private NoteDraft _draft = null!;
    private string? _result, _error;
    private WriteOutcome.Stopped? _stopped;
    private bool _busy, _copied, _dictating, _canDictate, _canShare;
    private DotNetObjectReference<Index>? _self;

    // Test period: an access code from config (Notatskriver__AdgangsKode). Empty = open to everyone.
    private string AccessCode => Config["Notatskriver:AdgangsKode"] ?? "";
    private bool _locked, _codeWrong;
    private string _code = "";

    protected override void OnInitialized()
    {
        _draft = new NoteDraft(Plan);
        _locked = AccessCode.Length > 0;
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        _locked = AccessCode.Length > 0 && await JS.InvokeAsync<string?>("notat.remembered") != AccessCode;
        _self = DotNetObjectReference.Create(this);
        _canDictate = await JS.InvokeAsync<bool>("notat.canDictate");
        _canShare = await JS.InvokeAsync<bool>("notat.canShare");
        StateHasChanged();
    }

    private async Task Unlock()
    {
        _codeWrong = _code.Trim() != AccessCode;
        if (_codeWrong) return;
        _locked = false;
        await JS.InvokeVoidAsync("notat.remember", _code.Trim());
    }

    private static string Thumb(Attachment a) => "data:image/jpeg;base64," + Convert.ToBase64String(a.Data);

    // ── input ──
    private async Task OnFiles(InputFileChangeEventArgs e)
    {
        _error = null;
        foreach (var f in e.GetMultipleFiles(UsagePlan.Extended.MaxAttachments))
        {
            var why = await Adder.ExecuteAsync(_draft, f.Name, f.ContentType, f.Size,
                () => f.OpenReadStream(maxAllowedSize: AddAttachment.MaxBytes), CancellationToken.None);
            if (why is not null) { _error = why; if (_draft.IsFull) break; }
        }
        _stopped = null;
    }

    private void Remove(Attachment a) { _draft.Remove(a); _stopped = null; }

    private async Task ToggleDictate()
    {
        if (!Plan.Dictation) return;
        if (_dictating) { await JS.InvokeVoidAsync("notat.stopDictate"); _dictating = false; return; }
        _dictating = await JS.InvokeAsync<bool>("notat.startDictate", _self);
    }

    [JSInvokable] public Task OnDictated(string text) => InvokeAsync(() =>
    {
        _draft.Notes = _draft.Notes.Length == 0 ? text : _draft.Notes.TrimEnd() + (_draft.Notes.EndsWith('\n') ? "" : "\n") + text;
        _stopped = null;
        StateHasChanged();
    });

    [JSInvokable] public Task OnDictateEnded() => InvokeAsync(() => { _dictating = false; StateHasChanged(); });

    [JSInvokable] public Task OnDictateError(string err) => InvokeAsync(() =>
    {
        _dictating = false;
        _error = err == "not-allowed" ? "Siden fik ikke lov at bruge mikrofonen. Tillad mikrofon i browseren og prøv igen." : null;
        StateHasChanged();
    });

    // ── write ──
    private async Task WriteAsync(bool hideNames)
    {
        _busy = true; _error = null; _stopped = null; _copied = false;
        try
        {
            switch (await Writer.ExecuteAsync(_draft, hideNames, CancellationToken.None))
            {
                case WriteOutcome.Written w: _result = w.Text; break;
                case WriteOutcome.Stopped s: _stopped = s; break;
                case WriteOutcome.Failed f: _error = f.Message; break;
            }
        }
        catch (Exception) { _error = "Noget gik galt. Prøv igen."; }
        finally { _busy = false; }
    }

    // ── result ──
    private async Task Copy() => _copied = await JS.InvokeAsync<bool>("notat.copy", _result ?? "");

    private async Task DownloadWord() =>
        await JS.InvokeVoidAsync("notat.download", $"{_draft.Type.Title} {DateTime.Now:yyyy-MM-dd}.docx",
            Convert.ToBase64String(Word.Export(_result ?? "")), "application/vnd.openxmlformats-officedocument.wordprocessingml.document");

    private async Task Share() => await JS.InvokeAsync<bool>("notat.share", _draft.Type.Title, _result ?? "");

    private void New()
    {
        _draft.Clear(); _result = null; _stopped = null; _error = null; _copied = false;
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_dictating) await JS.InvokeVoidAsync("notat.stopDictate"); } catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
