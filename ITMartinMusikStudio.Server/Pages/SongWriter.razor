@page "/songwriter"
@rendermode InteractiveServer
@implements IDisposable
@inject StudioDbContext Db
@inject StudioLibraryService Library
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore

<PageTitle>Skriv sang — Studio</PageTitle>

<div class="sw-page">

    <div class="sw-header">
        <a href="/songs" class="topbar-back">← Sange</a>
        <h1 class="sw-title">🎸 Skriv en sang</h1>
        <p class="sw-sub">Fra ingenting til en hjemmelavet sang, klar til at øve videre på</p>
    </div>

    <!-- Title first, low friction - creates the draft song as soon as it's
         given, so the checklist/sketch-recorder/lyrics box below have a real
         song to attach to instead of collecting local-only state until a
         final "Create" click. Avoids ever renaming a Key after sketches or
         skipped-steps are already recorded against it. -->
    <div class="sw-section">
        <div class="sw-step-label">Sangtitel</div>
        <input class="sw-input" type="text" placeholder="Hvad skal sangen hedde?"
               value="@_title" @onchange="OnTitleChanged" />
    </div>

    @if (_song is not null)
    {
        @if (StepPlanner.NextStep(_steps) is { } next)
        {
            <div class="next-step-banner">
                <span>👉 Næste: <strong>@next.Label</strong></span>
                <button class="btn-primary" @onclick="() => NavigateToStep(next)">Gå dertil →</button>
            </div>
        }
        else
        {
            <div class="next-step-banner next-step-banner--ready">
                ✓ Klar — <a href="/studio/@Uri.EscapeDataString(_song.Key)">gå til sangen</a> for at øve videre
            </div>
        }
        <StepChecklist Steps="_steps" OnToggle="ToggleStep" OnNavigate="NavigateToStep" />

        <!-- Chord progression -->
        <div class="sw-section" id="sw-progression">
            <div class="sw-step-label">Akkordrækkefølge</div>
            <div class="sw-cards">
                @foreach (var p in _progressions)
                {
                    var active = _chosenProg == p;
                    <button class="sw-card @(active ? "sw-card--active" : "")"
                            @onclick="() => ChooseProgression(p)">
                        <div class="sw-card-mood">@p.Mood</div>
                        <div class="sw-card-chords">@string.Join(" – ", p.Chords)</div>
                    </button>
                }
            </div>
        </div>

        <!-- Picking pattern -->
        @if (_chosenProg is not null)
        {
            <div class="sw-section" id="sw-pattern">
                <div class="sw-step-label">Spillemønster</div>
                <div class="sw-cards">
                    @foreach (var pat in _patterns)
                    {
                        var active = _chosenPat == pat;
                        <button class="sw-card @(active ? "sw-card--active" : "")"
                                @onclick="() => ChoosePattern(pat)">
                            <div class="sw-card-mood">@pat.Name</div>
                            <div class="sw-card-chords">@pat.Notation</div>
                            <div class="sw-card-desc">@pat.Description</div>
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Tempo -->
        @if (_chosenPat is not null)
        {
            <div class="sw-section" id="sw-tempo">
                <div class="sw-step-label">Tempo</div>
                <div class="sw-bpm-grid">
                    @foreach (var (label, bpm) in _tempos)
                    {
                        var active = _chosenBpm == bpm;
                        <button class="sw-bpm-chip @(active ? "sw-bpm-chip--active" : "")"
                                @onclick="() => ChooseTempo(bpm)">
                            <div class="sw-bpm-num">@bpm</div>
                            <div class="sw-bpm-label">@label</div>
                        </button>
                    }
                </div>
                <div style="display:flex;align-items:center;gap:8px;margin-top:10px">
                    <input class="sw-input" type="number" placeholder="Eget BPM..." min="40" max="240" style="max-width:160px"
                           @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var t)) ChooseTempo(t); }" />
                    @if (_chosenBpm.HasValue)
                    {
                        <span style="font-size:13px;color:var(--muted)">@_chosenBpm BPM valgt</span>
                    }
                </div>
            </div>
        }

        <!-- Idea recording (optional) - hum a snippet, download it, take it to Suno -->
        @if (_chosenBpm.HasValue)
        {
            <div class="sw-section" id="sw-sketch">
                <div class="sw-step-label">🎤 Idé-optagelse (valgfrit)</div>
                <p style="font-size:13px;color:var(--muted);margin:0">Nyn 4 linjer, spil sammen — download og læg ind i Suno for inspiration.</p>
                @if (!_sketchRecording)
                {
                    <button class="btn-primary" style="width:fit-content" @onclick="StartSketch">⏺ Optag idé</button>
                }
                else
                {
                    <button class="btn-primary" style="width:fit-content;background:var(--red)" @onclick="StopSketch">⏹ Stop (@FormatTime(_sketchTimer))</button>
                }
                @foreach (var sk in _sketches)
                {
                    <div class="rec-item">
                        <div class="rec-item-info">
                            <span class="rec-item-name">🎤 @sk.Name</span>
                            <span class="rec-item-date">@sk.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                        </div>
                        <audio controls src="/stream?path=@Uri.EscapeDataString(sk.RelativePath)" class="rec-player" />
                        <div class="rec-item-actions">
                            <a class="btn-ghost-sm" href="/download?path=@Uri.EscapeDataString(sk.RelativePath)">⬇ Download</a>
                            <button class="btn-delete-sm" @onclick="() => DeleteSketch(sk)">🗑</button>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Melody ideas (optional) -->
        @if (_chosenBpm.HasValue)
        {
            <div class="sw-section">
                <div class="sw-step-label">Melodi-idéer (valgfrit)</div>
                <div class="sw-cards">
                    @foreach (var idea in _melodyIdeas)
                    {
                        var active = _chosenMelodyIdeas.Contains(idea);
                        <button class="sw-card @(active ? "sw-card--active" : "")"
                                @onclick="() => ToggleMelodyIdea(idea)">
                            <div class="sw-card-mood">@idea.Title</div>
                            <div class="sw-card-desc">@idea.Description</div>
                        </button>
                    }
                </div>
            </div>

            <!-- Song structure -->
            <div class="sw-section">
                <div class="sw-step-label">Sangstruktur</div>
                <div class="sw-cards">
                    @foreach (var s in _structures)
                    {
                        var active = _chosenStructure == s;
                        <button class="sw-card @(active ? "sw-card--active" : "")"
                                @onclick="() => ChooseStructure(s)">
                            <div class="sw-card-mood">@s.Name</div>
                            <div class="sw-card-chords">@string.Join(" – ", s.Sections)</div>
                        </button>
                    }
                </div>
            </div>
        }

        <!-- Lyric draft (optional) - reuses StudioSong.Lyrics directly, no AI
             extraction/annotation here (nothing to annotate against yet) -
             once the song later gets a source file and graduates to Indøv
             sang, this text is already sitting in Forbered's Tekst card. -->
        <div class="sw-section" id="sw-lyrics">
            <div class="sw-step-label">✍️ Tekstudkast (valgfrit)</div>
            <textarea class="sw-input" style="min-height:140px" placeholder="Skriv løse linjer, et vers, hvad som helst..."
                      value="@_lyricsDraft" @onchange="OnLyricsChanged"></textarea>
        </div>
    }

</div>

<style>
    .sw-page {
        max-width: 640px;
        margin: 0 auto;
        padding: 24px 16px 80px;
        display: flex;
        flex-direction: column;
        gap: 32px;
    }
    .sw-header { display: flex; flex-direction: column; gap: 6px; }
    .sw-title { font-size: 26px; font-weight: 900; margin-top: 12px; }
    .sw-sub { color: var(--muted); font-size: 14px; }
    .sw-section { display: flex; flex-direction: column; gap: 12px; }
    .sw-step-label { font-size: 12px; font-weight: 700; text-transform: uppercase;
                     letter-spacing: .08em; color: var(--muted); }
    .sw-cards { display: flex; flex-direction: column; gap: 10px; }
    .sw-card {
        background: var(--card);
        border: 2px solid var(--border);
        border-radius: var(--radius);
        padding: 16px 18px;
        text-align: left;
        cursor: pointer;
        color: var(--text);
        display: flex;
        flex-direction: column;
        gap: 4px;
        transition: border-color .15s;
    }
    .sw-card:hover { border-color: var(--accent); }
    .sw-card--active { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--card)); }
    .sw-card-mood { font-size: 11px; font-weight: 700; text-transform: uppercase;
                    letter-spacing: .07em; color: var(--muted); }
    .sw-card--active .sw-card-mood { color: var(--accent); }
    .sw-card-chords { font-size: 18px; font-weight: 700; }
    .sw-card-desc { font-size: 13px; color: var(--muted); margin-top: 2px; }
    .sw-input {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px 16px;
        color: var(--text);
        font-size: 16px;
        width: 100%;
        outline: none;
    }
    .sw-input:focus { border-color: var(--accent); }
    .sw-bpm-grid { display: flex; gap: 10px; flex-wrap: wrap; }
    .sw-bpm-chip { background: var(--card); border: 2px solid var(--border); border-radius: 12px;
                   padding: 12px 18px; cursor: pointer; color: var(--text); display: flex;
                   flex-direction: column; align-items: center; gap: 2px; min-width: 80px; transition: border-color .15s; }
    .sw-bpm-chip:hover { border-color: var(--accent); }
    .sw-bpm-chip--active { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--card)); }
    .sw-bpm-num { font-size: 20px; font-weight: 800; }
    .sw-bpm-label { font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
</style>

@code {
    record Progression(string Mood, List<string> Chords);
    record PickStyle(string Name, string Notation, string Description);

    private readonly List<Progression> _progressions =
    [
        new("Melankolsk", ["Em", "C", "G", "D"]),
        new("Glad",       ["G", "D", "Em", "C"]),
        new("Trist",      ["Am", "F", "C", "G"]),
        new("Dramatisk",  ["Dm", "Am", "F", "C"]),
        new("Soul/Blues", ["A", "D", "E", "A"]),
    ];

    private readonly List<PickStyle> _patterns =
    [
        new("Fingerpicking",     "T 3 2 1 2 3",    "Blød og flydende — god til ballader"),
        new("Fingerpicking+",    "T 1 2 3 2 1",    "Mere bevægelse — god til vers med energi"),
        new("Strumming enkel",   "↓ ↓↑ – ↑↓↑",   "Klassisk rytmisk — god til refrænger"),
        new("Strumming kraftig", "↓↓ ↑↓ ↑↓ ↑",   "Stærk og drivende — god til kor"),
    ];

    private readonly List<(string Label, int Bpm)> _tempos =
    [
        ("Langsom",  60),
        ("Rolig",    80),
        ("Moderat", 100),
        ("Frisk",   120),
        ("Hurtig",  140),
    ];

    private StudioSong? _song;
    private string _title = "";

    private Progression? _chosenProg;
    private PickStyle?   _chosenPat;
    private int?         _chosenBpm;
    private string       _lyricsDraft = "";

    private readonly HashSet<MelodyIdea> _chosenMelodyIdeas = [];
    private readonly List<SongStructure> _structures = SongStructures.GetStructures();
    private SongStructure? _chosenStructure;

    private bool _sketchRecording;
    private System.Timers.Timer? _sketchTimer_t;
    private int _sketchTimer;
    private List<SketchFile> _sketches = [];

    private System.Timers.Timer? _saveTimer;
    private bool _disposed;

    // Depends on the chosen chord progression, so computed rather than stored
    // - re-evaluates automatically if the user goes back and picks a
    // different progression before reaching this step.
    private List<MelodyIdea> _melodyIdeas =>
        _chosenProg is null ? [] : ITMartinMusikStudio.Server.Services.MelodyIdeas.GetIdeas(_chosenProg.Chords);

    private List<SongStep> _steps =>
        _song is null ? [] : StepPlanner.GetSteps(_song, _sketches.Count > 0);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        string? ok;
        try { ok = await JS.InvokeAsync<string?>("localStorage.getItem", "studio_auth"); }
        catch { return; }
        if (ok != "1") { Nav.NavigateTo("/", forceLoad: true); }
    }

    private async Task OnTitleChanged(ChangeEventArgs e)
    {
        _title = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(_title)) return;

        if (_song is null)
        {
            var baseKey = Library.SafeKey(_title);
            var existingKeys = await Db.Songs.Select(s => s.Key).ToListAsync();
            var key = existingKeys.Contains(baseKey) ? baseKey + "_" + Guid.NewGuid().ToString("N")[..4] : baseKey;
            _song = new StudioSong { Key = key, Title = _title.Trim() };
            Db.Songs.Add(_song);
            await Db.SaveChangesAsync();
            _sketches = Library.GetSketches(_song.Key);
        }
        else
        {
            _song.Title = _title.Trim();
            AutoSave();
        }
    }

    private void ChooseProgression(Progression p) { _chosenProg = p; SyncChordAndNotes(); }
    private void ChooseStructure(SongStructure s) { _chosenStructure = s; SyncChordAndNotes(); }

    private void ChoosePattern(PickStyle p)
    {
        _chosenPat = p;
        if (_song is null) return;
        _song.FingerpickPattern = p.Notation;
        AutoSave();
    }

    private void ChooseTempo(int bpm)
    {
        _chosenBpm = bpm;
        if (_song is null) return;
        _song.Tempo = bpm;
        AutoSave();
    }

    private void ToggleMelodyIdea(MelodyIdea idea)
    {
        if (!_chosenMelodyIdeas.Remove(idea)) _chosenMelodyIdeas.Add(idea);
        SyncChordAndNotes();
    }

    // Chord chart starts as just the flat progression (e.g. "Em – C – G – D")
    // as soon as a progression is chosen - enough for the checklist's
    // Akkordrække step to go Done early - then gets replaced with the fuller
    // per-section chart once a structure is also picked.
    private void SyncChordAndNotes()
    {
        if (_song is null || _chosenProg is null) return;

        if (_chosenStructure is not null)
        {
            var steps = SongStructures.GeneratePracticeSteps(_chosenProg.Chords, _chosenStructure);
            _song.ChordChart = string.Join("\n", steps.Select(s => $"{s.Section}: {string.Join(" ", s.Chords)}"));

            var notesLines = new List<string> { $"🎵 Sangstruktur: {_chosenStructure.Name}", "" };
            notesLines.AddRange(steps.Where(s => s.Note is not null).Select(s => $"{s.Section}: {s.Note}"));
            if (_chosenMelodyIdeas.Count > 0)
            {
                notesLines.Add("");
                notesLines.Add("💡 Melodi-idéer:");
                notesLines.AddRange(_chosenMelodyIdeas.Select(i => $"- {i.Title}: {i.Description}"));
            }
            _song.Notes = string.Join("\n", notesLines);
        }
        else
        {
            _song.ChordChart = string.Join(" – ", _chosenProg.Chords);
        }
        AutoSave();
    }

    private void OnLyricsChanged(ChangeEventArgs e)
    {
        _lyricsDraft = e.Value?.ToString() ?? "";
        if (_song is null) return;
        _song.Lyrics = _lyricsDraft;
        AutoSave();
    }

    private void ToggleStep(string key)
    {
        if (_song is null) return;
        _song.SkippedSteps = StepPlanner.ToggleNotNecessary(_song, key);
        AutoSave();
    }

    // Single-page wizard, so navigation is just a scroll - no tab concept
    // like Studio.razor's version of this handler.
    private async Task NavigateToStep(SongStep step)
    {
        if (step.TargetAnchor is null) return;
        try { await JS.InvokeVoidAsync("studio.scrollToId", step.TargetAnchor); } catch { }
    }

    // ── Sketch recording ──────────────────────────────────────────────────────

    private static string FormatTime(int seconds) => $"{seconds / 60}:{seconds % 60:D2}";

    private async Task StartSketch()
    {
        if (_song is null) return;
        _sketchRecording = true;
        _sketchTimer = 0;
        _sketchTimer_t = new System.Timers.Timer(1000) { AutoReset = true };
        _sketchTimer_t.Elapsed += async (_, _) =>
        {
            if (_disposed) return;
            _sketchTimer++;
            await InvokeAsync(StateHasChanged);
        };
        _sketchTimer_t.Start();
        try { await JS.InvokeVoidAsync("studio.startSketch", _song.Key); }
        catch
        {
            _sketchRecording = false;
            _sketchTimer_t?.Stop();
            _sketchTimer_t?.Dispose();
            _sketchTimer_t = null;
        }
    }

    private async Task StopSketch()
    {
        _sketchTimer_t?.Stop();
        _sketchTimer_t?.Dispose();
        _sketchTimer_t = null;
        _sketchRecording = false;
        await JS.InvokeVoidAsync("studio.stopSketch");
        await Task.Delay(500);
        if (_song is not null) _sketches = Library.GetSketches(_song.Key);
    }

    private void DeleteSketch(SketchFile sk)
    {
        if (!Library.DeleteRecording(sk.RelativePath) || _song is null) return;
        _sketches = Library.GetSketches(_song.Key);
    }

    // ── Auto-save ──────────────────────────────────────────────────────────────
    // Same debounced-timer pattern as Studio.razor's AutoSave.

    private void AutoSave()
    {
        if (_song is null) return;

        _saveTimer?.Dispose();
        _saveTimer = new System.Timers.Timer(1200) { AutoReset = false };
        _saveTimer.Elapsed += async (_, _) =>
        {
            if (_disposed) return;
            _song.UpdatedAt = DateTime.UtcNow;
            try { await Db.SaveChangesAsync(); } catch { return; }
            if (_disposed) return;
            await InvokeAsync(StateHasChanged);
        };
        _saveTimer.Start();
    }

    public void Dispose()
    {
        _disposed = true;
        _saveTimer?.Stop(); _saveTimer?.Dispose();
        _sketchTimer_t?.Stop(); _sketchTimer_t?.Dispose();
    }
}
