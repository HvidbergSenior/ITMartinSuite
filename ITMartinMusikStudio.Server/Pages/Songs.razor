@page "/songs"
@rendermode InteractiveServer
@inject StudioLibraryService Library
@inject StudioDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore

<PageTitle>Studio — Sange</PageTitle>

<div class="songs-page">

    <div class="songs-header">
        <div>
            <h1 class="songs-title">🎸 Studio</h1>
            <p class="songs-sub">@_songs.Count sange</p>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
            <button class="btn-primary" @onclick='() => Nav.NavigateTo("/songwriter", forceLoad: true)'>🎸 Skriv sang</button>
            <button class="btn-primary" @onclick="ShowNewSong">＋ Ny sang</button>
            <button class="btn-ghost" @onclick="Logout">Log ud</button>
        </div>
    </div>

    <ProblemPurposeBanner
        Problem="Restaurering af gamle indspilninger/cd'er kræver overblik over hvad der mangler at blive gjort."
        Formaal="Hold styr på fremskridt i indspilning, restaurering og karaoke-udgaver." />

    <input class="songs-search" type="search" placeholder="Søg sang eller artist..."
           value="@_query" @oninput="e => _query = e.Value?.ToString() ?? string.Empty" />

    @{
        // Shared card template (Razor template syntax) so the three grouped
        // sections below don't triple the same markup.
        RenderFragment<(StudioSong Song, string BorderClass)> RenderSongCard = ctx =>
        @<div class="song-card @ctx.BorderClass"
              style="cursor:pointer;"
              @onclick="() => Nav.NavigateTo(SongUrl(ctx.Song), forceLoad: true)">
            @if (!string.IsNullOrWhiteSpace(ctx.Song.CoverImagePath) && Library.Exists(ctx.Song.CoverImagePath))
            {
                <img class="song-card-cover" src="/stream?path=@Uri.EscapeDataString(ctx.Song.CoverImagePath)" alt="" />
            }
            else
            {
                <div class="song-card-icon">@SongIcon(ctx.Song)</div>
            }
            <div class="song-card-body">
                <div class="song-card-title">@ctx.Song.Title</div>
                <div class="song-card-meta">
                    <span>@(string.IsNullOrWhiteSpace(ctx.Song.Artist) ? "Eget" : ctx.Song.Artist)</span>
                    @if (!string.IsNullOrWhiteSpace(ctx.Song.MusicKey))
                    {
                        <span class="key-badge">@ctx.Song.MusicKey</span>
                    }
                    @if (ctx.Song.Tempo.HasValue)
                    {
                        <span>@ctx.Song.Tempo BPM</span>
                    }
                    @{ var (done, total) = StepProgress(ctx.Song); }
                    <span class="song-card-progress @(done == total ? "song-card-progress--full" : done > 0 ? "song-card-progress--partial" : "song-card-progress--empty")">
                        @done/@total
                    </span>
                </div>
            </div>
            <button @onclick:stopPropagation @onclick="() => DeleteSong(ctx.Song)"
                    style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:18px;padding:4px 8px;flex-shrink:0;"
                    title="Slet sang">🗑</button>
        </div>;
    }

    <!-- DB songs, grouped by where each song is in its lifecycle - most
         actionable first: fully ready to record, then the two in-progress
         flows. -->
    @if (ReadySongs.Any())
    {
        <div class="section-label">🔓 Klar til indspilning</div>
        <div class="song-cards">
            @foreach (var s in ReadySongs)
            {
                @RenderSongCard((s, "song-card--ready"))
            }
        </div>
    }

    @if (IndoevSongs.Any())
    {
        <div class="section-label" style="margin-top:20px">🎧 Indøv sang</div>
        <div class="song-cards">
            @foreach (var s in IndoevSongs)
            {
                @RenderSongCard((s, "song-card--indoev"))
            }
        </div>
    }

    @if (WritingSongs.Any())
    {
        <div class="section-label" style="margin-top:20px">✍️ Skriv sang</div>
        <div class="song-cards">
            @foreach (var s in WritingSongs)
            {
                @RenderSongCard((s, "song-card--writing"))
            }
        </div>
    }

    <!-- Source files not yet in DB -->
    @if (FilteredFiles.Any())
    {
        <div class="section-label" style="margin-top:28px">🎵 Sange fra NAS — vælg for at lave din version</div>
        <div class="songs-list">
            @foreach (var f in FilteredFiles)
            {
                var href = $"/studio/{Uri.EscapeDataString(Library.SafeKey(f.RelativePath))}?file={Uri.EscapeDataString(f.RelativePath)}";
                <a class="song-row song-row--new" href="@href">
                    <div class="song-row-icon">@(Library.IsVideo(f.RelativePath) ? "🎬" : "🎵")</div>
                    <div class="song-row-info">
                        <div class="song-row-title">@f.Title</div>
                        <div class="song-row-path">@f.RelativePath</div>
                    </div>
                    <div class="song-row-arrow">›</div>
                </a>
            }
        </div>
    }

    @if (!FilteredSongs.Any() && !FilteredFiles.Any())
    {
        <div style="text-align:center;padding:60px 20px;color:var(--muted)">
            Ingen sange fundet
        </div>
    }

</div>

<!-- New song modal -->
@if (_showNewSong)
{
    <div class="modal-overlay" @onclick="HideNewSong">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-title">＋ Ny sang</div>
            <input class="modal-input" type="text" placeholder="Sangtitel *"
                   @bind="_newTitle" @bind:event="oninput"
                   @onkeydown="OnNewSongKey" />
            <input class="modal-input" type="text" placeholder="Artist (blank = din egen sang)"
                   @bind="_newArtist" @bind:event="oninput"
                   @onkeydown="OnNewSongKey" />
            @if (!string.IsNullOrEmpty(_newError))
            {
                <div class="modal-error">@_newError</div>
            }
            <div class="modal-actions">
                <button class="btn-primary" @onclick="CreateSong"
                        disabled="@string.IsNullOrWhiteSpace(_newTitle)">Opret</button>
                <button class="btn-ghost" @onclick="HideNewSong">Annuller</button>
            </div>
        </div>
    </div>
}

@code {
    private List<StudioSong> _songs = [];
    private List<SourceFile> _sourceFiles = [];
    private HashSet<string> _songKeys = [];
    private string _query = "";
    private bool _showNewSong;
    private string _newTitle = "";
    private string _newArtist = "";
    private string _newError = "";

    private IEnumerable<StudioSong> FilteredSongs =>
        string.IsNullOrWhiteSpace(_query)
            ? _songs
            : _songs.Where(s =>
                s.Title.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
                s.Artist.Contains(_query, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<SourceFile> FilteredFiles =>
        _sourceFiles
            .Where(f => !_songKeys.Contains(Library.SafeKey(f.RelativePath)))
            .Where(f => string.IsNullOrWhiteSpace(_query) ||
                        f.Title.Contains(_query, StringComparison.OrdinalIgnoreCase));

    // Grouped by lifecycle stage, most-actionable first. ReadyToRecord takes
    // priority over the flow grouping regardless of origin - a fully-stepped
    // song is "done prepping" whether it started as Skriv sang or Indøv sang.
    private bool ReadyToRecord(StudioSong s) => StepPlanner.IsReadyToRecord(s, Library.GetSketches(s.Key).Count > 0);

    private IEnumerable<StudioSong> ReadySongs   => FilteredSongs.Where(ReadyToRecord);
    private IEnumerable<StudioSong> IndoevSongs  => FilteredSongs.Where(s => !ReadyToRecord(s) && StepPlanner.GetFlow(s) == SongFlow.Recording);
    private IEnumerable<StudioSong> WritingSongs => FilteredSongs.Where(s => !ReadyToRecord(s) && StepPlanner.GetFlow(s) == SongFlow.Writing);

    private (int Done, int Total) StepProgress(StudioSong s)
    {
        var steps = StepPlanner.GetSteps(s, Library.GetSketches(s.Key).Count > 0, Library.HasPublishedVersion(s.Key))
            .Where(x => x.Key != "version") // post-recording outcome, not prep progress
            .ToList();
        return (steps.Count(x => x.Status != StepStatus.NotStarted), steps.Count);
    }

    private static string SongUrl(StudioSong s) => "/studio/" + Uri.EscapeDataString(s.Key);

    private string SongIcon(StudioSong s) =>
        StepPlanner.GetFlow(s) == SongFlow.Writing ? "✍️" : Library.IsVideo(s.SourceFile) ? "🎬" : "🎵";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        string? ok;
        try { ok = await JS.InvokeAsync<string?>("localStorage.getItem", "studio_auth"); }
        catch { return; }
        if (ok != "1") { Nav.NavigateTo("/", forceLoad: true); return; }

        _sourceFiles = Library.GetSourceFiles();
        _songs       = await Db.Songs.OrderBy(s => s.Title).ToListAsync();
        _songKeys    = _songs.Select(s => s.Key).ToHashSet();
        StateHasChanged();
    }

    private void ShowNewSong()
    {
        _newTitle  = "";
        _newArtist = "";
        _newError  = "";
        _showNewSong = true;
    }

    private void HideNewSong() => _showNewSong = false;

    private async Task OnNewSongKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateSong();
        if (e.Key == "Escape") HideNewSong();
    }

    private async Task CreateSong()
    {
        var title = _newTitle.Trim();
        if (string.IsNullOrWhiteSpace(title)) return;

        var baseKey = Library.SafeKey(title);
        var key = baseKey;
        if (_songKeys.Contains(key))
            key = baseKey + "_" + Guid.NewGuid().ToString("N")[..4];

        var song = new StudioSong
        {
            Key    = key,
            Title  = title,
            Artist = _newArtist.Trim(),
        };
        Db.Songs.Add(song);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/studio/{Uri.EscapeDataString(key)}", forceLoad: true);
    }

    private async Task DeleteSong(StudioSong song)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Slet '{song.Title}'?");
        if (!confirmed) return;
        Db.Songs.Remove(song);
        await Db.SaveChangesAsync();
        _songs.Remove(song);
        _songKeys.Remove(song.Key);
        StateHasChanged();
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "studio_auth");
        Nav.NavigateTo("/", forceLoad: true);
    }
}
