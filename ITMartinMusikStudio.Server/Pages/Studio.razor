    // Picking a new key is a shortcut for "transpose to this key" - same
    // chord-shifting AdjustT does, just computed as one jump (new root minus
    // old root) instead of repeated half-tone clicks. Major/minor suffix
    // ("Em" vs "E") doesn't affect the shift; RootIndex only looks at the
    // root letter, matching TransposeNote's own root/suffix split.
    private void OnKeyChanged(ChangeEventArgs e)
    {
        if (_song is null) return;
        var newKey = e.Value?.ToString() ?? _song.MusicKey;
        var semitones = RootIndex(newKey) - RootIndex(_song.MusicKey);
        if (semitones != 0)
        {
            var useFlats = PrefersFlats(_lyricsEdit, _chordEdit);
            _lyricsEdit = TransposeChordsInText(_lyricsEdit, semitones, useFlats); SyncEditorsToDom();
            _chordEdit  = TransposeChordChart(_chordEdit, semitones, useFlats); SyncEditorsToDom();
        }
        _song.MusicKey = newKey;
        AutoSave();
    }

    private void OnTempoChanged(ChangeEventArgs e)
    {
        if (_song is null) return;
        _song.Tempo = int.TryParse(e.Value?.ToString(), out var t) ? t : (int?)null;
        AutoSave();
    }

    // ── Transpose ─────────────────────────────────────────────────────────────

    private void AdjustT(int d)
    {
        if (d == 0 || _song is null) return;
        var useFlats = PrefersFlats(_lyricsEdit, _chordEdit);
        _lyricsEdit    = TransposeChordsInText(_lyricsEdit, d, useFlats); SyncEditorsToDom();
        _chordEdit     = TransposeChordChart(_chordEdit, d, useFlats); SyncEditorsToDom();
        _song.MusicKey = TransposeNote(_song.MusicKey, d, useFlats);
        AutoSave();
    }

    private static readonly string[] Notes = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"];
    private static readonly string[] NotesFlat = ["C","Db","D","Eb","E","F","Gb","G","Ab","A","Bb","B"];

    private static int RootIndex(string key)
    {
        if (string.IsNullOrEmpty(key)) return 0;
        var rootLen = key.Length > 1 && key[1] is '#' or 'b' ? 2 : 1;
        var root = key[..rootLen];
        var idx = Array.IndexOf(Notes, root);
        return idx >= 0 ? idx : Math.Max(0, Array.IndexOf(NotesFlat, root));
    }

    // Which spelling to use for accidentals introduced by a transpose -
    // decided ONCE per transpose call from the song's existing notation, not
    // per chord. Per-chord inference (going by whether THIS chord's root was
    // already flat-spelled) silently loses the preference the moment a
    // chord passes through an unambiguous natural: "Bb" transposed up a
    // half-step becomes "B" (no accidental, no flat/sharp memory left), and
    // transposing back down from bare "B" has nothing left to tell it should
    // land on "Bb" rather than "A#" - a reported regression from exactly
    // that round-trip. Deciding it once at the operation level survives that.
    private static readonly string[] FlatRoots = ["Db", "Eb", "Gb", "Ab", "Bb"];

    private static bool PrefersFlats(string lyrics, string chordChart)
    {
        var lyricChords = System.Text.RegularExpressions.Regex
            .Matches(lyrics ?? "", @"\[([A-G][^\]]*)\]")
            .Select(m => m.Groups[1].Value);
        var chartTokens = (chordChart ?? "").Split(['\n', ' ', ':', '/'], StringSplitOptions.RemoveEmptyEntries);
        return lyricChords.Concat(chartTokens).Any(t => FlatRoots.Any(t.StartsWith));
    }

    private static string TransposeNote(string chord, int semitones, bool useFlats)
    {
        if (semitones == 0 || string.IsNullOrEmpty(chord)) return chord;
        int rootLen = chord.Length > 1 && chord[1] is '#' or 'b' ? 2 : 1;
        var root   = chord[..rootLen];
        var suffix = chord[rootLen..];
        var idx = Array.IndexOf(Notes, root);
        if (idx < 0) idx = Array.IndexOf(NotesFlat, root);
        if (idx < 0) return chord;
        var newIdx = ((idx + semitones) % 12 + 12) % 12;
        return (useFlats ? NotesFlat : Notes)[newIdx] + suffix;
    }

    // A whole line that's nothing but one bracket ("[Bro]", "[Vers 1]") is a
    // structure tag, not an inline chord marker - even though a tag like
    // "Bro"/"Bridge"/"Chorus" starting with a valid chord-root letter would
    // otherwise match the same "\[([A-G]...)\]" shape as a real "[Dm]"
    // marker. Shared by every place that needs to tell the two apart, so the
    // distinction can't quietly drift out of sync between them again - it
    // already had to be fixed twice separately (word-fidelity check, then
    // the transpose buttons) before being pulled out here.
    private static bool IsWholeLineBracketTag(string trimmedLine) =>
        trimmedLine.StartsWith('[') && trimmedLine.EndsWith(']') && trimmedLine.IndexOf(']') == trimmedLine.Length - 1;

    private static string TransposeChordsInText(string text, int semitones, bool useFlats)
    {
        if (string.IsNullOrEmpty(text) || semitones == 0) return text;
        var rx = new System.Text.RegularExpressions.Regex(@"\[([A-G][^\]]*)\]");
        var lines = text.Split('\n');
        for (var i = 0; i < lines.Length; i++)
        {
            if (IsWholeLineBracketTag(lines[i].Trim())) continue;
            lines[i] = rx.Replace(lines[i], m => "[" + TransposeNote(m.Groups[1].Value, semitones, useFlats) + "]");
        }
        return string.Join('\n', lines);
    }

    private static bool IsChord(string token)
    {
        if (string.IsNullOrWhiteSpace(token) || token.EndsWith(':')) return false;
        // A slash chord (e.g. "C/F") must be recognized by its top part alone -
        // trimming straight through the "/" made the whole token ("C/F") get
        // checked against Notes as one string, which never matches, so slash
        // chords were silently falling through as plain text instead of
        // showing up as a real, clickable chord.
        var slashIdx = token.IndexOf('/');
        var check = slashIdx > 0 ? token[..slashIdx] : token;
        // 'b' covers flat-extension chords (Dm7b5, G7b9) - without it a chord
        // like "Dm7b5" trims down to "Dm7b", which matches neither Notes nor
        // NotesFlat and was silently rejected as "not a chord" at all.
        var root = check.TrimEnd('m', '7', '9', 'j', 'a', 's', 'u', '+', 'd', 'i', '2', '4', '5', '6', 'b');
        return Notes.Contains(root) || NotesFlat.Contains(root);
    }

    // Akkorder's chart is plain "Verse: D A/D Bm A G" - no [brackets] like the
    // inline-lyrics format, so TransposeChordsInText's regex never matches it.
    // Transpose each whitespace-separated token instead, leaving section
    // labels ("Verse:") alone and transposing both sides of a slash chord.
    private static string TransposeChordChart(string chart, int semitones, bool useFlats)
    {
        if (string.IsNullOrEmpty(chart) || semitones == 0) return chart;

        var lines = chart.Split('\n');
        for (var i = 0; i < lines.Length; i++)
        {
            var colonIdx = lines[i].IndexOf(':');
            var label = colonIdx >= 0 ? lines[i][..(colonIdx + 1)] : "";
            var rest = colonIdx >= 0 ? lines[i][(colonIdx + 1)..] : lines[i];

            var tokens = rest.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(token => token.Contains('/')
                    ? string.Join("/", token.Split('/').Select(p => IsChord(p) ? TransposeNote(p, semitones, useFlats) : p))
                    : IsChord(token) ? TransposeNote(token, semitones, useFlats) : token);

            lines[i] = label + (label.Length > 0 ? " " : "") + string.Join(" ", tokens);
        }
        return string.Join('\n', lines);
    }

    // ── Mechanical UG tab → inline chords (no AI) ───────────────────────────
    // A standard tab has a chord-only line positioned directly above the lyric
    // line it applies to, chords aligned by column to the syllable they land
    // on. Converting this to [Chord]word format is a pure text-layout problem -
    // doing it as a regex/string transform instead of an AI completion means
    // the lyric text passes through completely untouched (no paraphrasing risk)
    // and every chord's exact column position is preserved (no dropped
    // mid-line changes), which is the AI route's two failure modes.
    private static string MergeTabToInlineChords(string rawTab)
    {
        if (string.IsNullOrWhiteSpace(rawTab)) return "";

        var lines = rawTab.Replace("\r\n", "\n").Split('\n');
        var output = new List<string>();

        for (var i = 0; i < lines.Length; i++)
        {
            var line = lines[i];
            if (IsChordOnlyLine(line) && i + 1 < lines.Length && !string.IsNullOrWhiteSpace(lines[i + 1]) && !IsChordOnlyLine(lines[i + 1]))
            {
                output.Add(MergeChordLineIntoLyricLine(line, lines[i + 1]));
                i++; // the lyric line is now consumed
            }
            else if (IsChordOnlyLine(line))
            {
                // Chord line with nothing to attach to (e.g. an instrumental
                // break) - keep the chords visible as a bracketed list.
                var chords = System.Text.RegularExpressions.Regex.Matches(line, @"\S+").Select(m => "[" + m.Value + "]");
                output.Add(string.Concat(chords));
            }
            else
            {
                output.Add(line);
            }
        }
        return string.Join('\n', output);
    }

    private static bool IsChordOnlyLine(string line)
    {
        var tokens = line.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return tokens.Length > 0 && tokens.All(IsChordToken);
    }

    private static bool IsChordToken(string token) =>
        token.Contains('/') ? token.Split('/').All(IsChord) : IsChord(token);

    private static string MergeChordLineIntoLyricLine(string chordLine, string lyricLine)
    {
        var matches = System.Text.RegularExpressions.Regex.Matches(chordLine, @"\S+");
        var sb = new System.Text.StringBuilder(lyricLine);
        // Insert right-to-left so earlier column positions stay valid as later
        // insertions lengthen the string.
        foreach (var m in matches.Cast<System.Text.RegularExpressions.Match>().OrderByDescending(m => m.Index))
        {
            var col = Math.Min(m.Index, sb.Length);
            sb.Insert(col, "[" + m.Value + "]");
        }
        return sb.ToString();
    }

    // Nudges the user toward bracketing section labels ([Verse] instead of
    // plain "Verse"). For most section names this is just a style suggestion
    // - AiAnnotateChords/PreservesWords tolerate either form. "Headline" is
    // the one case where it actually changes behavior: unbracketed, it's
    // genuinely ambiguous with a real lyric line, so the AI only treats
    // "[Headline] ..." as structural - a bare "Headline" line gets chord
    // markers like any other lyric. Matched separately since it's a prefix
    // ("Headline: Song Title") rather than a standalone short word.
    private static readonly System.Text.RegularExpressions.Regex UnbracketedSectionLabelPattern = new(
        @"^(verse|vers|chorus|omkv[æe]d|refr[æe]n|bridge|bro|intro|outro|pre-?chorus|hook|instrumental|vocal)\s*\d*$",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private static readonly System.Text.RegularExpressions.Regex UnbracketedBracketRequiredPattern = new(
        @"^(headline|comment)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private List<string> UnbracketedSectionLabels =>
        (_lyricsEdit ?? "").Split('\n')
            .Select(l => l.Trim())
            .Where(l => l.Length > 0 && !l.StartsWith('[') &&
                        (UnbracketedSectionLabelPattern.IsMatch(l) || UnbracketedBracketRequiredPattern.IsMatch(l)))
            .Distinct()
            .ToList();

    // ── Word-fidelity check for AI chord placement ──────────────────────────
    // Any AI step that's supposed to only ADD chord markers to existing words
    // must be verified afterward, not trusted - the model can still quietly
    // alter wording. Strip markers back out and compare against the original;
    // whitespace/case differences are tolerated, but any real word change
    // fails the check and the AI's output must be discarded.
    //
    // Bracket stripping runs on BOTH sides, not just the candidate: lyrics
    // can already contain their own bracket tags ([Verse], [Chorus], [Comment:
    // ...]) as structure, separate from the [Chord] markers the AI adds. If
    // only the candidate were stripped, any structure tag already present in
    // the original would never match after stripping and every comparison
    // would fail regardless of whether the actual words changed.
    //
    // A whole-line bracket ("[Bro]", "[Verse]") is left UNSTRIPPED, not
    // blanked out like an inline [Chord] marker - it's structure the AI must
    // reproduce character-for-character, so the comparison needs to actually
    // see it. Stripping it on both sides made corruption invisible: a real
    // bug turned "[Bro]" (Danish for Bridge) into "[C#ro]" and the check
    // passed anyway, because both sides collapsed to nothing at that line.
    private static string StripChordMarkers(string text)
    {
        var lines = (text ?? "").Split('\n');
        for (var i = 0; i < lines.Length; i++)
        {
            if (IsWholeLineBracketTag(lines[i].Trim())) continue; // structure, not a chord marker - keep as-is
            lines[i] = System.Text.RegularExpressions.Regex.Replace(lines[i], @"\[[^\]]*\]", "");
        }
        return string.Join('\n', lines);
    }

    private static string NormalizeForCompare(string text) =>
        System.Text.RegularExpressions.Regex.Replace((text ?? "").ToLowerInvariant(), @"\s+", " ").Trim();

    private static bool PreservesWords(string original, string candidateWithMarkers) =>
        NormalizeForCompare(StripChordMarkers(original)) == NormalizeForCompare(StripChordMarkers(candidateWithMarkers));

