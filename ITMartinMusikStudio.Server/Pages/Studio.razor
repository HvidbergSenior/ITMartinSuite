    // ── Line beats: "which beat does this line start on" ────────────────────
    // Same delimited-string convention as SectionTimings, keyed by the
    // line's raw index in Lyrics.Split('\n') rather than its text (this song
    // repeats short lines like "Jeg kigger på stjerner." within one section).
    private Dictionary<int, int> ParseLineBeats()
    {
        var result = new Dictionary<int, int>();
        if (string.IsNullOrWhiteSpace(_song?.LineBeats)) return result;
        foreach (var pair in _song.LineBeats.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && int.TryParse(parts[0], out var idx) && int.TryParse(parts[1], out var beat))
                result[idx] = beat;
        }
        return result;
    }

    private int? GetLineBeat(int lineIndex) =>
        ParseLineBeats().TryGetValue(lineIndex, out var beat) ? beat : null;

    private void SetLineBeat(int lineIndex, int beat)
    {
        var beats = ParseLineBeats();
        beats[lineIndex] = beat;
        _song!.LineBeats = string.Join(';', beats.Select(kv => $"{kv.Key}={kv.Value}"));
        AutoSave();
    }

    // Tap-to-mark: while the beat timer is running, clicking a line captures
    // wherever the beat count currently is. Works whether armed via the
    // manual toggle or automatically (recording/overdub starts one).
    private void MarkLineBeatNow(int lineIndex)
    {
        if (_beat < 0) return; // no beat running - nothing to capture
        SetLineBeat(lineIndex, _totalBeats);
    }

    // Small "which beat does this line start on" tag shown next to each
    // lyric line in Spilleguide - click to (re)capture wherever the beat
    // counter currently is, no-ops if the beat isn't running.
    // ── Følg med: the sheet leads while the beat runs ─────────────────────
    // Lines carry "starts on beat N" (LineBeats). With the beat counter
    // running, the current line is the last one whose N <= _totalBeats; the
    // next line's badge counts down the beats until it starts.
    // Practice tempo (user: "beats skal være slower, like 100-120"). The beat
    // runs at this; Følg slows the recording to the same ratio, pitch kept.
    private int _practiceBpm = 110;
    private double PracticeBpm => Math.Clamp(_practiceBpm, 40, 240);
    private double PracticeRate => _song?.Tempo is > 0 ? PracticeBpm / _song.Tempo.Value : 1.0;
    private async Task PracticeTempoChanged()
    {
        if (_beat >= 0) { StartBeatTimer(); }   // restart at the new tempo, counter keeps going from 1
        try { await JS.InvokeVoidAsync("studio.setPerformPlayerRate", PracticeRate); } catch { }
    }

    private int _followScrolledTo = -1;
    private int CurrentLineIndex()
    {
        if (_beat < 0) return -1;
        var best = -1; var bestBeat = int.MinValue;
        foreach (var (line, beat) in ParseLineBeats())
            if (beat <= _totalBeats && beat > bestBeat) { best = line; bestBeat = beat; }
        return best;
    }
    private int? BeatsUntil(int lineIndex)
    {
        if (_beat < 0) return null;
        var b = GetLineBeat(lineIndex);
        return b is null ? null : b.Value - _totalBeats;
    }
    private string LineFollowClass(int lineIndex)
    {
        if (_beat < 0) return "";
        var cur = CurrentLineIndex();
        if (cur < 0) return "";
        if (lineIndex == cur) return "line--now";
        var b = GetLineBeat(lineIndex);
        if (b is null) return "";
        return b.Value <= _totalBeats ? "line--done" : "line--later";
    }
    private async Task FollowAlong()
    {
        // Play the recording and start the beat together, so beat 1 = 0:00.
        try { await JS.InvokeVoidAsync("studio.playPerformPlayerFromStart", PracticeRate); } catch { }
        StartBeatTimer(); _beatManual = true;
    }

    private RenderFragment RenderBeatBadge(int lineIndex) => __builder =>
