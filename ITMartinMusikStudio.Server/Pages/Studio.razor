            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PlayMix()
    {
        _mixing = true;
        var urls = _recordings
            .Select(r => $"/stream?path={Uri.EscapeDataString(r.RelativePath)}")
            .ToArray();
        // Passing a string[] directly as the single JS arg gets spread by C#'s
        // params object?[] into separate arguments instead of one array - JS's
        // playMix(urls) then only ever received the first URL as a plain
        // string, and .map() on a string throws "urls.map is not a function".
        // Casting to object forces it through as one value.
        await JS.InvokeVoidAsync("studio.playMix", (object)urls);
    }

