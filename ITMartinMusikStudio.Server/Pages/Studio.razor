    // ── Stems ─────────────────────────────────────────────────────────────────

    private async Task ExtractStems()
    {
        if (_song is null || string.IsNullOrEmpty(_song.SourceFile)) return;
        _stemRunning = true;
        _stemElapsed = 0;
        _stemProgress = null;
        _stems = null;

        _stemTimer_t?.Dispose();
        _stemTimer_t = new System.Timers.Timer(1000) { AutoReset = true };
        _stemTimer_t.Elapsed += async (_, _) => { _stemElapsed++; await InvokeAsync(StateHasChanged); };
        _stemTimer_t.Start();
        StateHasChanged();

        try
        {
            var inputPath = Path.GetFullPath(Path.Combine(Library.Root, _song.SourceFile));
            var outputDir = Path.Combine(Library.Root, "stems", SongKey);
            var progress  = new Progress<string>(msg => { _stemProgress = msg; InvokeAsync(StateHasChanged); });
            _stems = await StemSvc.SeparateAsync(inputPath, outputDir, progress);
        }
        catch (Exception ex)
        {
            _saveStatus = $"Stem fejl: {ex.Message}";
        }
        finally
        {
            _stemTimer_t?.Stop();
            _stemTimer_t?.Dispose();
            _stemRunning = false;
            StateHasChanged();
        }
    }

    // ── UG tab parser ─────────────────────────────────────────────────────────

    private async Task ParseUgTab()
    {
        if (string.IsNullOrWhiteSpace(_ugPasteText)) return;
        _ugParsing = true;
        _saveStatus = null;
        StateHasChanged();
        try
        {
            // Chords only - lyrics stay sourced from lrclib.net (LyricsService),
            // which gives synced timing UG's plain tab text never has. Taking UG's
            // lyrics here would silently overwrite a better, already-synced version.
            var result = await ChordAi.ParseUltimateGuitarTabAsync(_ugPasteText);
            if (string.IsNullOrEmpty(result.Chords))
            {
                _saveStatus = "Ingen akkorder fundet i den indsatte tekst.";
            }
            else
            {
                _chordEdit = result.Chords;

                // Prefer placing chords onto the FIXED lrclib lyrics (correct
                // words, correct version) using the pasted tab only to learn
                // chord positions - AI is genuinely useful for that alignment
                // judgment (line breaks/phrasing won't match exactly, and not
                // every word carries a chord). But it's verified, not trusted:
                // if the output doesn't preserve the target words exactly, it's
                // discarded and we fall back to merging straight from the
                // pasted tab's own text instead, which can never alter wording
                // since it's pure string insertion, not a model completion.
                var target = StripChordMarkers(_lyricsEdit);
                string? placed = null;
                if (!string.IsNullOrWhiteSpace(target))
                {
                    var candidate = await ChordAi.PlaceChordsFromTabAsync(target, _ugPasteText);
                    if (!string.IsNullOrWhiteSpace(candidate) && PreservesWords(target, candidate))
                        placed = candidate;
                }

                _lyricsEdit = placed ?? MergeTabToInlineChords(_ugPasteText);
                if (placed is null && !string.IsNullOrWhiteSpace(target))
                    _saveStatus = "AI-placering afvist (ændrede ord) - brugte akkorderne fra din indsatte tab i stedet.";

                AutoSave();
            }
        }
        catch (Exception ex)
        {
            _saveStatus = $"AI fejl: {ex.Message}";
        }
        _ugParsing   = false;
        _ugPasteOpen = false;
        _ugPasteText = "";
    }

