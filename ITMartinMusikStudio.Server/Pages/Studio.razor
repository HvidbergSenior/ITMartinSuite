    // Where the sung melody sits against the singer's range, and the shift
    // (in semitones) that would put its top note comfortably 3 below his
    // ceiling without pushing the bottom out of reach. 0 = leave it.
    private static (int Shift, string Verdict) FitToVoice(int melLow, int melHigh, VoiceRange v)
    {
        var idealTop = v.HighMidi - 3;
        var shift = idealTop - melHigh;
        // Don't drop the low notes below what he can sing.
        if (melLow + shift < v.LowMidi) shift = v.LowMidi - melLow;
        // Small differences are not worth transposing.
        if (Math.Abs(shift) <= 1) shift = 0;
        var names = new[] { "C","C#","D","D#","E","F","F#","G","G#","A","A#","B" };
        string N(int m) => names[m % 12] + (m / 12 - 1);
        var mel = $"Melodien går {N(melLow)}–{N(melHigh)}";
        if (shift == 0) return (0, $"{mel} – passer til din stemme ({v.Low}–{v.High}). Behold tonearten.");
        var dir = shift < 0 ? "ned" : "op";
        return (shift, $"{mel}. Med din stemme ({v.Low}–{v.High}) er den bedre {Math.Abs(shift)} halvtone{(Math.Abs(shift) == 1 ? "" : "r")} {dir} – så topper du på {N(melHigh + shift)}.");
    }

    private string? _progKeyNote, _progVoiceNote;

    private async Task SuggestProgressions()
    {
        if (_song is null || string.IsNullOrWhiteSpace(_lyricsEdit)) return;
        _progSuggesting = true; _progError = null; _progSuggestions = []; _progKeyNote = null; _progVoiceNote = null;
        try
        {
            // 1) The key: read it off the recording when there is one (librosa),
            //    otherwise leave it to the AI to propose from the lyrics/mood.
            string key = "";
            if (!string.IsNullOrWhiteSpace(_song.SourceFile) && Library.Exists(_song.SourceFile) && ChordDetect.IsAvailable)
            {
                _saveStatus = "🎧 Lytter efter toneart og tempo..."; StateHasChanged();
                var full = Library.Resolve(_song.SourceFile);
                var segments = await ChordDetect.DetectAsync(full);
                var guessed = KeyGuesser.Guess(segments);
                var bpm = await ChordDetect.DetectTempoAsync(full);
                if (guessed is not null)
                {
                    key = guessed;
                    _progKeyNote = $"Toneart {guessed} hørt i optagelsen" + (bpm is > 0 ? $", ca. {Math.Round(bpm.Value)} bpm" : "");
                    _song.MusicKey = guessed;
                    if (bpm is > 0 && (_song.Tempo is null or 0)) _song.Tempo = (int)Math.Round(bpm.Value);

                    // Does that key suit HIS voice? Needs the isolated vocal (stems) and a Stemmetest.
                    var vocals = Library.GetExistingStems(SongKey)?.Vocals;
                    if (_voice is not null && vocals is not null)
                    {
                        _saveStatus = "🎤 Måler melodiens omfang..."; StateHasChanged();
                        if (await ChordDetect.DetectMelodyRangeAsync(vocals) is { } mel)
                        {
                            var (shift, verdict) = FitToVoice(mel.LowMidi, mel.HighMidi, _voice);
                            _progVoiceNote = verdict;
                            if (shift != 0)
                            {
                                var singKey = TransposeNote(guessed, shift, ChordProgressions.KeyPrefersFlats((ChordProgressions.ParseKey(guessed).Root + shift + 12) % 12, ChordProgressions.ParseKey(guessed).Minor));
                                _progVoiceNote += $" Spil den som {CapoPlanner.Describe(singKey)}.";
                                key = singKey;
                            }
                        }
                    }
                }
            }
            _saveStatus = "✨ Finder progressioner..."; StateHasChanged();

            var catalogue = ChordProgressions.All.Select(p => $"{p.Name} – {p.Mood} – {(p.Minor ? "mol" : "dur")}: {p.Degrees} – {p.Note}");
            var voiceHint = _voice is null ? "" : $" (singer's comfortable range {_voice.Low}-{_voice.High})";
            var raw = await ChordAi.SuggestProgressionsAsync(_song.Title + voiceHint, key, _song.Tempo, StripChordMarkers(_lyricsEdit), catalogue);

            // A leading "Toneart|X|why" line is the AI's key proposal (only asked for when we had none).
            var keyLine = raw.FirstOrDefault(r => r.Name.Equals("Toneart", StringComparison.OrdinalIgnoreCase));
            if (keyLine != default)
            {
                var bar = keyLine.Reason.IndexOf('|');
                var k = (bar > 0 ? keyLine.Reason[..bar] : keyLine.Reason).Trim();
                if (string.IsNullOrEmpty(key) && k.Length is >= 1 and <= 3) { key = k; _song.MusicKey = k; _progKeyNote = $"Toneart {k} foreslået til teksten" + (bar > 0 ? $" – {keyLine.Reason[(bar + 1)..].Trim()}" : ""); }
                raw.Remove(keyLine);
            }
            _progSuggestions = raw;
            if (_progSuggestions.Count == 0) _progError = "Fik ikke et brugbart svar - prøv igen.";

            // Show the list as the grips we will actually play: open shapes + capo.
            if (!string.IsNullOrEmpty(key))
            {
                PlanCapo(key);
                _progKeyNote = (_progKeyNote ?? "") + $" → {CapoPlanner.Describe(key)}.";
            }
            AutoSave();
        }
        catch (Exception ex) { _progError = ex.Message; }
        finally { _progSuggesting = false; _saveStatus = null; }
    }

    // "A tail chord at the end of every line": the chord the NEXT line opens
    // on (the anticipation a guitarist plays anyway), and on the last line of a
    // section the dominant 7th of the song key so it pulls back home. Lines
    // that already end in a marker are left as they are.
    private void AddTailChords()
    {
        if (_song is null || string.IsNullOrWhiteSpace(_lyricsEdit)) return;
        var rx = new System.Text.RegularExpressions.Regex(@"\[([A-G][^\]]*)\]");
        var lines = _lyricsEdit.Split('\n');
        var (root, minor) = ChordProgressions.ParseKey(_song.MusicKey);
        var names = new[] { "C","C#","D","D#","E","F","F#","G","G#","A","A#","B" };
        var dominant = names[(root + 7) % 12] + "7";
        // Capo songs: the markers are written in shapes, not in the sounding key.
        var capo = System.Text.RegularExpressions.Regex.Match(_chordEdit + "\n" + _lyricsEdit, @"[Cc]apo\s*(\d+)");
        if (capo.Success && int.TryParse(capo.Groups[1].Value, out var fret)) dominant = names[(root + 7 - fret + 24) % 12] + "7";

        bool IsSung(string l) => !string.IsNullOrWhiteSpace(l) && !IsSectionLabel(l) && !l.TrimStart().StartsWith("[Comment", StringComparison.OrdinalIgnoreCase);
        for (var i = 0; i < lines.Length; i++)
        {
            var l = lines[i];
            if (!IsSung(l)) continue;
            if (System.Text.RegularExpressions.Regex.IsMatch(l, @"\[[A-G][^\]]*\]\s*[.,!?…—-]*\s*$")) continue;   // already has a tail
            string? tail = null;
            for (var j = i + 1; j < lines.Length; j++)
            {
                if (IsSectionLabel(lines[j]) || (string.IsNullOrWhiteSpace(lines[j]) && j + 1 < lines.Length && IsSectionLabel(lines[j + 1]))) break;
                if (!IsSung(lines[j])) continue;
                var m = rx.Match(lines[j]);
                if (m.Success) tail = m.Groups[1].Value;
                break;
            }
            tail ??= dominant;
            lines[i] = l.TrimEnd() + " [" + tail + "]";
        }
        _lyricsEdit = string.Join('\n', lines);
        SyncEditorsToDom();
        AutoSave();
        _saveStatus = "⤵ Halegreb sat på hver linje";
    }

