    private async Task MergeSections()
    {
        var ordered = new List<string>();
        foreach (var sectionName in LyricSectionNames)
        {
            var slug = SlugSection(sectionName);
            var takes = TakesForSection(slug);
            if (takes.Count == 0) return;
            var chosen = _chosenSectionTake.GetValueOrDefault(slug) ?? takes[^1].RelativePath;
            ordered.Add(chosen);
        }

        _mergingRunning = true;
        _saveStatus = "🧩 Fletter afsnit sammen...";
        StateHasChanged();
        try
        {
            var ok = await Library.MergeSectionTakesAsync(SongKey, ordered);
            _saveStatus = ok ? "🧩 Flettet take klar!" : "Kunne ikke flette - se container-log.";
            if (ok) _recordings = Library.GetRecordings(SongKey);
        }
        finally
        {
            _mergingRunning = false;
            StateHasChanged();
        }
    }

    private async Task DeleteRecording(RecordingFile r)
    {
        // Permanent - DeleteRecording does a plain File.Delete with no
        // recycle-bin safety net, so a real confirm here matters (see
        // DeleteSong in Songs.razor for the same pattern).
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Slet '{r.Name}'? Dette kan ikke fortrydes.");
        if (!confirmed) return;

        if (Library.DeleteRecording(r.RelativePath))
        {
            _recordings = Library.GetRecordings(SongKey);
            _saveStatus = null;
        }
        else
        {
            _saveStatus = "Kunne ikke slette - filen er sandsynligvis i brug. Stop evt. afspilning af den og prøv igen.";
        }
    }

