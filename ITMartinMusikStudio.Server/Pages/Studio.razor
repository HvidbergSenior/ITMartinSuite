    // "B2" / "F#4" / "Bb3" -> MIDI number, or null.
    private static int? NoteToMidi(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        s = s.Trim().Replace("♯", "#").Replace("♭", "b");
        var names = new[] { "C","C#","D","D#","E","F","F#","G","G#","A","A#","B" };
        var i = 0; var letter = char.ToUpperInvariant(s[i++]);
        var acc = 0;
        if (i < s.Length && (s[i] == '#' || s[i] == 'b')) { acc = s[i] == '#' ? 1 : -1; i++; }
        if (!int.TryParse(s[i..], out var octave)) return null;
        var idx = Array.IndexOf(names, letter.ToString());
        if (idx < 0) return null;
        return (octave + 1) * 12 + idx + acc;
    }

    private void SaveManualVoice()
    {
        var lo = NoteToMidi(_voiceManualLow); var hi = NoteToMidi(_voiceManualHigh);
        if (lo is null || hi is null || hi <= lo) { _voiceError = "Skriv fx B2 og G4."; return; }
        var names = new[] { "C","C#","D","D#","E","F","F#","G","G#","A","A#","B" };
        string N(int m) => names[m % 12] + (m / 12 - 1);
        _voice = new VoiceRange(N(lo.Value), N(hi.Value), lo.Value, hi.Value, DateTime.Now);
        VoiceRangeStore.Save(Library, _voice);
        _voiceError = null; _voiceManualLow = _voiceManualHigh = "";
        _saveStatus = "🎤 Stemme gemt";
    }

