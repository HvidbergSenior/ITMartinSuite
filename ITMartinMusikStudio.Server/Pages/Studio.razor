    private async Task OpenCamera()
    {
        _cameraOn = true;
        StateHasChanged();
        await Task.Delay(100);
        await JS.InvokeVoidAsync("studio.startCamera", "photo-video");
    }

    private async Task CloseCamera()
    {
        _cameraOn = false;
        await JS.InvokeVoidAsync("studio.stopCamera");
    }

    private async Task CapturePhoto()
    {
        var result = await JS.InvokeAsync<string>("studio.capturePhoto", "photo-video");
        await CloseCamera();
        await AnalyzePhoto(result, "image/jpeg");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(20);
        if (files.Count == 0) return;

        _photoAnalyzing = true;
        _photoResult = "";
        StateHasChanged();

        foreach (var file in files)
        {
            try
            {
                using var ms = new MemoryStream();
                await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                var mime = file.ContentType.StartsWith("image/") ? file.ContentType : "image/jpeg";

                var result = _photoTarget == "chords"
                    ? await ChordAi.ExtractChordsFromImageAsync(base64, mime)
                    : await ChordAi.ExtractTextFromImageAsync(base64, mime);

                _photoResult = _photoTarget == "chords"
                    ? MergeNumberedChords(_photoResult, result)
                    : string.IsNullOrWhiteSpace(_photoResult) ? result : _photoResult + "\n\n" + result;
            }
            catch (Exception ex)
            {
                _photoResult += (string.IsNullOrWhiteSpace(_photoResult) ? "" : "\n\n") + $"Fejl: {ex.Message}";
            }
        }

        _photoAnalyzing = false;
        StateHasChanged();
    }

    private async Task AnalyzePhoto(string base64, string mime)
    {
        _photoAnalyzing = true;
        _photoResult = "";
        StateHasChanged();
        try
        {
            string result;
            if (_photoTarget == "chords")
                result = await ChordAi.ExtractChordsFromImageAsync(base64, mime);
            else
                result = await ChordAi.ExtractTextFromImageAsync(base64, mime);
            _photoResult = result;
        }
        catch (Exception ex)
        {
            _photoResult = $"Fejl: {ex.Message}";
        }
        finally
        {
            _photoAnalyzing = false;
        }
    }

    private void ApplyPhotoResult()
    {
        if (string.IsNullOrEmpty(_photoResult)) return;
        switch (_photoTarget)
        {
            case "lyrics":
                _lyricsEdit = string.IsNullOrWhiteSpace(_lyricsEdit) ? _photoResult : _lyricsEdit + "\n\n" + _photoResult;
                break;
            case "chords":
                _chordEdit = MergeNumberedChords(_chordEdit, _photoResult);
                break;
            case "notes":
                _notesEdit = string.IsNullOrWhiteSpace(_notesEdit) ? _photoResult : _notesEdit + "\n\n" + _photoResult;
                break;
        }
        AutoSave();
        ClosePhoto();
    }

    private void ClearPhotoResult() => _photoResult = string.Empty;

    // Merges a numbered bar/line chord result ("6: F#m") into the existing chord chart by number,
    // so screenshots can be uploaded in any order and overlapping bars just overwrite instead of duplicating.
    // Falls back to a plain append when either side isn't in numbered format.
    private static string MergeNumberedChords(string existing, string incoming)
    {
        var numberedLine = new System.Text.RegularExpressions.Regex(@"^(\d+):\s*(.+)$");
        var incomingNumbered = new SortedDictionary<int, string>();
        foreach (var line in incoming.Split('\n'))
        {
            var m = numberedLine.Match(line.Trim());
            if (m.Success) incomingNumbered[int.Parse(m.Groups[1].Value)] = m.Groups[2].Value;
        }

        if (incomingNumbered.Count == 0)
            return string.IsNullOrWhiteSpace(existing) ? incoming : existing + "\n\n" + incoming;

        var merged = new SortedDictionary<int, string>();
        foreach (var line in existing.Split('\n'))
        {
            var m = numberedLine.Match(line.Trim());
            if (m.Success) merged[int.Parse(m.Groups[1].Value)] = m.Groups[2].Value;
        }
        foreach (var (bar, chord) in incomingNumbered) merged[bar] = chord;

        return string.Join('\n', merged.Select(kv => $"{kv.Key}: {kv.Value}"));
    }

