@page "/studio/{SongKey}"
@rendermode InteractiveServer
@implements IDisposable
@inject StudioDbContext Db
@inject StudioLibraryService Library
@inject CoverArtService CoverArt
@inject ChordDetectionService ChordDetect
@inject ChordAiService ChordAi
@inject StemService StemSvc
@inject PianoTranscriptionService PianoTranscribe
@inject VocalGuideService VocalGuide
@inject SpotifyService Spotify
@inject LyricsService Lyrics
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IConfiguration Configuration
@using Microsoft.EntityFrameworkCore

<PageTitle>@(_song?.Title ?? SongKey) — Studio</PageTitle>

@if (_song is null && !_loading)
{
    <div class="studio-init"><p>Opretter sang...</p></div>
}
else if (_song is not null)
{
<div class="studio-page">

    <!-- Top bar -->
    <div class="studio-topbar">
        <a href="/songs" class="topbar-back">← Sange</a>
        @if (ShowCover)
        {
        <div class="topbar-cover" title="Cover" style="cursor:pointer" @onclick="NavigateToCover">
            @if (!string.IsNullOrWhiteSpace(_song.CoverImagePath) && Library.Exists(_song.CoverImagePath))
            {
                <img src="/stream?path=@Uri.EscapeDataString(_song.CoverImagePath)" alt="Cover" class="topbar-cover-img" />
            }
            else
            {
                <span class="topbar-cover-placeholder">🖼️</span>
            }
        </div>
        }
        <div class="topbar-title-group">
            <input class="topbar-title-input" value="@_song.Title"
                   @onchange="e => { _song.Title = e.Value?.ToString() ?? _song.Title; AutoSave(); }" />
            <input class="topbar-artist-input" value="@_song.Artist" placeholder="Artist / eget"
                   @onchange="e => { _song.Artist = e.Value?.ToString() ?? string.Empty; AutoSave(); }" />
        </div>
        <div class="topbar-meta">
            <select class="meta-select" value="@_song.MusicKey" @onchange="OnKeyChanged">
                <optgroup label="Dur (Major)">
                    @foreach (var k in MajorKeys) { <option value="@k">@k</option> }
                </optgroup>
                <optgroup label="Mol (Minor)">
                    @foreach (var k in MinorKeys) { <option value="@k">@k</option> }
                </optgroup>
            </select>
            <input class="meta-bpm" type="number" placeholder="BPM"
                   value="@_song.Tempo" @onchange="OnTempoChanged" />
        </div>
    </div>
    <!-- Two phases, in order: 1 Trin (get chords/lyrics/pattern in place),
         2 Indspil (record). Phase 2 stays locked until every step in phase 1
         is Done or marked "ikke nødvendig". -->
    @{
        var stepsToDo = _steps.Where(s => s.Key != "version").ToList();
        var stepsDone = stepsToDo.Count(s => s.Status != StepStatus.NotStarted);
    }
    <div class="phase-bar">
        <button class="phase @(_tab == "forbered" ? "phase--active" : "") @(_readyToRecord ? "phase--done" : "")"
                @onclick='() => _tab = "forbered"'>
            <span class="phase-num">@(_readyToRecord ? "✓" : "1")</span>
            <span class="phase-text">
                <span class="phase-title">Trin</span>
                <span class="phase-sub">@stepsDone af @stepsToDo.Count klar</span>
            </span>
        </button>
        <span class="phase-arrow">→</span>
        <button class="phase @(_tab == "optag" ? "phase--active" : "") @(!_readyToRecord ? "phase--locked" : "") @(_recording ? "phase--rec" : "")"
                disabled="@(!_readyToRecord && _tab != "optag")"
                title="@(_readyToRecord ? "" : "Gør trinnene færdige først")"
                @onclick='() => _tab = "optag"'>
            <span class="phase-num">@(_recording ? "●" : _readyToRecord ? "2" : "🔒")</span>
            <span class="phase-text">
                <span class="phase-title">Indspil</span>
                <span class="phase-sub">@(_recording ? "Optager " + FormatRecTime(_recTimer) : _readyToRecord ? "Klar til optagelse" : "Låst")</span>
            </span>
        </button>
    </div>

    @if (_tab == "forbered")
    {
        @if (_readyToRecord)
        {
            <div class="next-step-banner next-step-banner--ready">
                <span>✓ Alle trin klar</span>
                <button class="btn-primary" @onclick='() => _tab = "optag"'>Videre til Indspil →</button>
            </div>
        }
        else if (StepPlanner.NextStep(_steps) is { } _next)
        {
            <div class="next-step-banner">
                <span>👉 Næste: <strong>@_next.Label</strong></span>
                <button class="btn-primary" @onclick="() => NavigateToStep(_next)">Gå dertil →</button>
            </div>
        }
        <StepChecklist Steps="_steps" OnToggle="ToggleStep" OnNavigate="NavigateToStep" />
    }

    <!-- Persistent Spotify mini-control - the full card (search/link UI) lives
         in Trin only, but play/stop needs to work from both phases, since
         Indspil is exactly where you'd want the backing track
         playing. -->
    @if (Spotify.IsConnected && !string.IsNullOrEmpty(_song.SpotifyTrackId))
    {
        <div class="spotify-mini-bar">
            <span class="spotify-mini-label">🎵 @_song.SpotifyTrackLabel</span>
            @if (_spotifyPlaying)
            {
                <button class="btn-ghost-sm" @onclick="StopSpotifyTrack">⏹ Stop</button>
            }
            else
            {
                <button class="btn-ghost-sm" @onclick="PlaySpotifyTrack" disabled="@_spotifyConnecting">
                    @(_spotifyConnecting ? "⏳ Forbinder..." : "▶ Afspil")
                </button>
            }
            <span style="font-size:0.75rem;color:#6b7280;margin-left:8px">🔉</span>
            <input type="range" min="0" max="100" value="50" style="width:90px"
                   title="Spotify-lydstyrke"
                   @oninput='e => JS.InvokeVoidAsync("spotifyPlayer.setVolume", (double.TryParse(e.Value?.ToString(), out var v) ? v : 50) / 100.0)' />
        </div>
    }

    <!-- ════════════════ TAB: FORBERED ════════════════ -->
    @if (_tab == "forbered")
    {
    <div class="studio-body">
        <div class="studio-left">



            <!-- Cover art - decoration, not a step (see StudioSong.CoverImagePath),
                 so it's not part of the checklist, but every song should have
                 something visual. -->
            @if (ShowCover)
            {
            <div class="studio-card" id="card-cover">
                <div class="card-header">
                    <div class="card-label">🖼️ Cover</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_song.CoverImagePath) && Library.Exists(_song.CoverImagePath))
                {
                    <img src="/stream?path=@Uri.EscapeDataString(_song.CoverImagePath)" alt="Cover" class="cover-preview" />
                }
                else
                {
                    <p class="no-file">Intet cover endnu</p>
                }
                @if (CoverArt.IsAvailable)
                {
                    <button class="btn-ghost-sm" style="margin-top:8px" @onclick="GenerateCover" disabled="@_coverGenerating">
                        @(_coverGenerating ? "⏳ Genererer..." : string.IsNullOrWhiteSpace(_song.CoverImagePath) ? "✨ Generér cover" : "🔄 Generér nyt cover")
                    </button>
                    @if (!string.IsNullOrEmpty(_coverError))
                    {
                        <div class="pattern-tip" style="color:#fca5a5;background:rgba(220,38,38,.1);margin-top:8px">⚠️ @_coverError</div>
                    }
                }
                else
                {
                    <p class="no-file">Cover-generering ikke sat op (mangler FalAi:ApiKey)</p>
                }
            </div>
            }

            <!-- Source file -->
            <div class="studio-card" id="card-kilde">
                <div class="card-header">
                    <div class="card-label">🎬 Kilde</div>
                    <div class="card-actions">
                        @{ var kildeSkipped = StepPlanner.Skipped(_song).Contains("kilde"); }
                        <button class="btn-ghost-sm @(kildeSkipped ? "active" : "")" @onclick='() => ToggleStep("kilde")'
                                title="En kildefil er valgfri - fx en kendt sang du selv spiller og synger uden backing">
                            @(kildeSkipped ? "✓ Ikke nødvendig" : "Ikke nødvendig")
                        </button>
                    </div>
                </div>
                @if (kildeSkipped && !Library.Exists(_song.SourceFile))
                {
                    <p class="small" style="color:var(--text-muted)">Sangen har ingen kildefil - du spiller og synger den selv. Tilføj en når som helst.</p>
                }
                @if (Library.Exists(_song.SourceFile))
                {
                    @if (Library.IsVideo(_song.SourceFile))
                    {
                        <video src="/stream?path=@Uri.EscapeDataString(_song.SourceFile)"
                               controls class="player-video" preload="metadata" />
                    }
                    else
                    {
                        <audio src="/stream?path=@Uri.EscapeDataString(_song.SourceFile)"
                               controls class="player-audio" preload="metadata" />
                    }
                }
                else
                {
                    <p class="no-file">Ingen kildefil tilknyttet</p>
                }
                <label class="btn-ghost-sm" style="display:inline-block;margin-top:8px;cursor:pointer">
                    @(_uploadingSource ? "⏳ Uploader..." : Library.Exists(_song.SourceFile) ? "🔄 Skift kildefil (fx fra Suno)" : "⬆ Tilføj kildefil (fx fra Suno)")
                    <InputFile OnChange="UploadSourceFile" accept="audio/*,video/*,.mp3,.wav,.m4a,.aac,.flac,.ogg,.opus,.wma,.mp4,.webm,.mov,.m4v" style="display:none" />
                </label>

                <!-- Or link straight to a track in the big collection on the NAS
                     (MartinBibliotek) - no upload, no Spotify, just a path. -->
                <div style="margin-top:10px">
                    <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted);margin-bottom:4px">📚 Eller find sangen i dit bibliotek på NAS'en (@(StudioLibraryService.IsBibliotek(_song.SourceFile) ? "linket: " + _song.SourceFile[10..] : "kunstner, titel..."))</div>
                    <div style="display:flex;gap:6px">
                        <input class="voice-input" style="flex:1;width:auto" placeholder="fx rem the one i love" @bind="_bibQuery" @bind:event="oninput" @bind:after="SearchBibliotek" />
                        @if (_bibSearching) { <span class="t-label">⏳</span> }
                    </div>
                    @if (_bibResults.Count > 0)
                    {
                        <div class="bib-results">
                            @foreach (var r in _bibResults)
                            {
                                var rel = r;
                                <button class="bib-hit" @onclick="() => LinkBibliotek(rel)" title="@rel">@System.IO.Path.GetFileNameWithoutExtension(rel) <span class="muted">· @System.IO.Path.GetDirectoryName(rel)?.Replace('\\', '/')</span></button>
                            }
                        </div>
                    }
                    else if (!_bibSearching && _bibQuery.Length >= 2 && _bibSearched)
                    {
                        <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted)">Intet fundet.</div>
                    }
                </div>
            </div>

            <!-- Spotify + Find sang: only for KNOWN songs (an artist is set). Own
                 songs (Suno etc.) have nothing to look up - user, 2026-09-17. -->
            @if (IsKnownSong)
            {
            <div class="studio-card">
                <div class="card-header">
                    <div class="card-label">🎵 Spotify</div>
                </div>
                @if (!Spotify.IsConfigured)
                {
                    <p class="no-file">Spotify er ikke sat op endnu.</p>
                }
                else if (!Spotify.IsConnected)
                {
                    <a class="btn-primary" href="/spotify/login" style="display:block;text-align:center;text-decoration:none">
                        🔗 Forbind til Spotify
                    </a>
                }
                else if (!string.IsNullOrEmpty(_song!.SpotifyTrackId) && !_spotifySearchOpen)
                {
                    <p style="font-size:0.85rem;color:#9ca3af;margin-bottom:8px">@_song.SpotifyTrackLabel</p>
                    @if (_spotifyPlaying)
                    {
                        <button class="btn-primary" style="width:100%" @onclick="StopSpotifyTrack">
                            ⏹ Stop
                        </button>
                    }
                    else
                    {
                        <button class="btn-primary" style="width:100%" @onclick="PlaySpotifyTrack" disabled="@_spotifyConnecting">
                            @(_spotifyConnecting ? "⏳ Forbinder til Spotify..." : "▶ Afspil via Spotify (Premium påkrævet)")
                        </button>
                    }
                    <button class="btn-ghost-sm" style="margin-top:6px" @onclick='() => _spotifySearchOpen = true'>
                        🔍 Skift sang
                    </button>
                }
                else
                {
                    <div style="display:flex;gap:6px">
                        <input class="chord-editor" style="height:auto;padding:8px" placeholder="Søg titel + kunstner..."
                               value="@_spotifyQuery" @oninput='e => _spotifyQuery = e.Value?.ToString() ?? ""' />
                        <button class="btn-primary" @onclick="SpotifySearch" disabled="@_spotifySearching">
                            @(_spotifySearching ? "..." : "🔍")
                        </button>
                    </div>
                    @if (_spotifyResults.Count > 0)
                    {
                        <div style="margin-top:8px;display:flex;flex-direction:column;gap:6px;max-height:240px;overflow-y:auto">
                            @foreach (var track in _spotifyResults)
                            {
                                <button class="btn-ghost" style="width:100%;text-align:left;display:flex;align-items:center;gap:8px"
                                        @onclick="() => LinkSpotifyTrack(track)">
                                    @if (!string.IsNullOrEmpty(track.AlbumArtUrl))
                                    {
                                        <img src="@track.AlbumArtUrl" style="width:32px;height:32px;border-radius:4px" />
                                    }
                                    <span>@track.Name — @track.Artist</span>
                                </button>
                            }
                        </div>
                    }
                }
            </div>

            <!-- Find song -->
            <div class="studio-card">
                <div class="card-label">🔍 Find sang</div>
                <div class="find-song-buttons">
                    <button class="btn-primary" @onclick="SearchUltimateGuitar">
                        🎸 Søg på Ultimate Guitar
                    </button>
                    @if (ChordAi.IsAvailable)
                    {
                        <button class="btn-ghost" style="width:100%"
                                @onclick='() => _ugPasteOpen = true'>
                            📋 Indsæt UG-tab → udtræk akkorder + tekst
                        </button>
                    }
                    <button class="btn-ghost" style="width:100%"
                            @onclick="SearchLyrics">
                        🔍 Søg sangtekst på Google
                    </button>
                </div>
            </div>
            }

            <!-- Stemmetest: sing your lowest and highest comfortable note; the
                 range is kept per library and fed to the key suggestion. -->
            <div class="studio-card" id="card-stemme">
                <div class="card-header">
                    <div class="card-label">🎤 Stemmetest</div>
                    <div class="card-actions">
                        @if (_voiceListening)
                        {
                            <button class="btn-primary" @onclick="StopVoiceTest">■ Stop og gem</button>
                        }
                        else
                        {
                            <button class="btn-ghost-sm" @onclick="StartVoiceTest">🎤 Start</button>
                        }
                    </div>
                </div>
                @if (_voiceListening)
                {
                    <div class="voice-live">
                        <div class="voice-note">@(_voiceNow ?? "…")</div>
                        <div class="voice-range">Laveste <b>@(_voiceLow ?? "–")</b> · Højeste <b>@(_voiceHigh ?? "–")</b></div>
                        <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted)">Syng en lang tone og glid ned så dybt du kan uden at knirke – så op så højt du kan uden at presse. Tag den et par gange. Tryk Stop når du er tilfreds.</div>
                    </div>
                }
                else
                {
                    @if (_voice is not null)
                    {
                        <div class="voice-range">Din stemme: <b>@_voice.Low – @_voice.High</b> <span class="muted">(@_voice.Span, @_voice.MeasuredAt.ToString("d/M"))</span></div>
                        <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted)">Bruges når Foreslå vurderer toneart. Kør testen igen, eller ret tallene herunder.</div>
                    }
                    else
                    {
                        <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted)">Ingen måling endnu. Tryk Start, syng din dybeste og højeste behagelige tone – eller skriv dem herunder hvis du kender dem.</div>
                    }
                    <div class="voice-manual">
                        <input class="voice-input" placeholder="dybest, fx B2" @bind="_voiceManualLow" />
                        <span>–</span>
                        <input class="voice-input" placeholder="højest, fx G4" @bind="_voiceManualHigh" />
                        <button class="btn-ghost-sm" @onclick="SaveManualVoice">Gem</button>
                    </div>
                }
                @if (_voiceError is not null) { <div class="pattern-tip" style="color:#fca5a5;background:rgba(220,38,38,.1);margin-top:8px">⚠️ @_voiceError</div> }
            </div>

            <!-- Chord progressions to pick from - rendered in the chosen key,
                 one click puts one into Akkorder (user, 2026-09-17). -->
            <div class="studio-card" id="card-progressioner">
                <div class="card-header">
                    <div class="card-label">🎼 Progressioner</div>
                    <div class="card-actions" style="display:flex;gap:6px;align-items:center">
                        @if (_progCapo > 0) { <span class="t-label" style="color:var(--accent);font-weight:700">Capo @_progCapo · lyder i @_progSoundingKey</span> }
                        <span class="t-label">Toneart</span>
                        <select class="prog-key" @bind="_progKey" @bind:after="() => { _progCapo = 0; _progSoundingKey = _progKey; }">
                            @foreach (var k in ProgKeys) { <option value="@k">@k</option> }
                        </select>
                        @if (ChordAi.IsAvailable)
                        {
                            <button class="btn-ai" @onclick="SuggestProgressions" disabled="@(_progSuggesting || string.IsNullOrWhiteSpace(_lyricsEdit))" title="Lad AI'en rangere de tre progressioner der passer bedst til teksten">
                                @(_progSuggesting ? "⏳" : "✨ Foreslå")
                            </button>
                        }
                    </div>
                </div>
                @if (_progError is not null) { <div class="pattern-tip" style="color:#fca5a5;background:rgba(220,38,38,.1);margin-bottom:8px">⚠️ @_progError</div> }
                @if (_progSuggestions.Count > 0)
                {
                    <div class="prog-suggest">
                        <b>Forslag til teksten:</b>
                        @if (_progKeyNote is not null) { <div>🎼 @_progKeyNote</div> }
                        @if (_progVoiceNote is not null) { <div>🎤 @_progVoiceNote</div> }
                        @foreach (var s in _progSuggestions)
                        {
                            <div>🎯 <b>@s.Name</b> – @s.Reason</div>
                        }
                    </div>
                }
                <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted);margin-bottom:8px">
                    Vælg en toneart, kig, og tryk <b>Brug</b> - så ligger den i Akkorder, og Greb viser fingersætningerne. Transponér bagefter med ½t −/+ på Akkorder, eller vælg en anden toneart her først.
                </div>
                @{ var (progRoot, progMinor) = ChordProgressions.ParseKey(_progKey); }
                <div class="prog-list">
                    @foreach (var p in ChordProgressions.All.Where(x => x.Minor == progMinor).OrderByDescending(x => IsSuggested(x.Name)))
                    {
                        var rendered = ChordProgressions.Render(p, progRoot, progMinor);
                        var easy = EasyChords.SimplifyChart(rendered);
                        var hasEasy = easy != rendered;
                        <div class="prog-item @(IsSuggested(p.Name) ? "prog-item--pick" : "")">
                            <div class="prog-head">
                                <div><b>@p.Name</b> <span class="muted">· @p.Mood</span></div>
                                <button class="btn-ghost-sm" @onclick="() => UseProgression(rendered)">Brug</button>
                                <button class="btn-ghost-sm" @onclick="() => ApplyProgressionToLyrics(rendered)" title="Læg akkorderne ind i teksten, én pr. linje, sektion for sektion" disabled="@string.IsNullOrWhiteSpace(_lyricsEdit)">På teksten</button>
                                @if (hasEasy)
                                {
                                    <button class="btn-ghost-sm" @onclick="() => UseProgression(easy)" title="Samme progression med lette, åbne akkorder">Brug let</button>
                                    <button class="btn-ghost-sm" @onclick="() => ApplyProgressionToLyrics(easy)" disabled="@string.IsNullOrWhiteSpace(_lyricsEdit)">På teksten let</button>
                                }
                            </div>
                            <pre class="prog-chords">@rendered</pre>
                            @if (hasEasy) { <pre class="prog-chords prog-easy"><span class="muted">Let:</span> @easy</pre> }
                            <div class="prog-frets">
                                @foreach (var ch in (rendered + "\n" + easy).Split('\n').SelectMany(l => (l.Contains(':') ? l[(l.IndexOf(':') + 1)..] : l).Split(' ', StringSplitOptions.RemoveEmptyEntries)).Distinct())
                                {
                                    <span title="E A D G B e – x = dæmpet, 0 = løs"><b>@ch</b> @(ChordFrets.Of(ch) ?? "?")</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.Note)) { <div class="prog-note">@p.Note</div> }
                        </div>
                    }
                </div>
            </div>

            <!-- Chord chart -->
            <div class="studio-card" id="card-akkorder">
                <div class="card-header">
                    <div class="card-label">🎸 Akkorder</div>
                    <div class="card-actions">
                        <div class="transpose-row">
                            <span class="t-label">½t</span>
                            <button class="t-btn" @onclick="() => AdjustT(-1)" title="Transponer ned">−</button>
                            <button class="t-btn" @onclick="() => AdjustT(1)"  title="Transponer op">+</button>
                        </div>
                        <button class="btn-ghost-sm" @onclick="SimplifyChords" title="Fjern slash-akkorder">简</button>
                        @if (ChordAi.IsAvailable && _chordChartIsNumbered)
                        {
                            <button class="btn-ai" @onclick="ConvertChordChartToSections" disabled="@_convertingChart"
                                    title="Omdan til sektion-format (Verse: ...) - lettere og mere præcist for AI at bruge end tal-per-takt">
                                @(_convertingChart ? "..." : "🔀 Til sektioner")
                            </button>
                        }
                        <button class="btn-ghost-sm" @onclick='() => _photoTarget = "chords"'>📷</button>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_song.Artist))
                {
                    <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted);margin-bottom:6px">
                        Kendt sang - brug <strong>"📋 Indsæt UG-tab"</strong> under Trin til venstre; det giver
                        menneske-verificerede akkorder, mere pålideligt end at gætte.
                    </div>
                }
                else
                {
                    <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted);margin-bottom:6px">
                        Hjemmelavet sang - lyt selv, eller brug en akkord-lytte-app på telefonen (fx ChordAI, Chordify),
                        og skriv det du hører herned.
                    </div>
                }
                <textarea class="chord-editor" rows="8"
                          value="@_chordDom"
                          @oninput="e => { _chordEdit = e.Value?.ToString() ?? _chordEdit; AutoSave(); }"
                          placeholder="Verse: Am G F E
Chorus: C G Am F
Bridge: Dm Am E Am"></textarea>
            </div>

            <!-- Patterns -->
            <div class="studio-card" id="card-monstre">
                <div class="card-header">
                    <div class="card-label">🎸 Mønstre</div>
                    <div class="card-actions" style="gap:6px">
                        <button class="btn-ghost-sm @(StepPlanner.Skipped(_song).Contains("spillemaade") ? "active" : "")" @onclick='() => ToggleStep("spillemaade")' title="Spillemåde er valgfri">@(StepPlanner.Skipped(_song).Contains("spillemaade") ? "✓ Ikke nødvendig" : "Ikke nødvendig")</button>
                        <div class="pattern-toggle">
                            <button class="@(!_plektrumMode ? "pattern-toggle-btn active" : "pattern-toggle-btn")" @onclick='() => _plektrumMode = false'>🖐 Fingre</button>
                            <button class="@(_plektrumMode ? "pattern-toggle-btn active" : "pattern-toggle-btn")" @onclick='() => _plektrumMode = true'>🎸 Plektor</button>
                        </div>
                        @if (ChordAi.IsAvailable)
                        {
                            <button class="btn-ai" @onclick="AiPatterns" disabled="@_patternsLoading">
                                @(_patternsLoading ? "..." : "🤖 Generer")
                            </button>
                        }
                    </div>
                </div>

                @if (_plektrumMode)
                {
                    <div class="pattern-tip">
                        💡 Med plektor bruges strumming. Fingerpicking kræver bare fingre — brug strumming nedenfor som erstatning.
                    </div>
                    <div class="card-label-sm" style="margin-bottom:4px">Strumming</div>
                    @((MarkupString)PatternRenderer.RenderStrum(_strumEdit))
                    <textarea class="chord-editor pattern-edit" rows="2"
                              value="@_strumDom"
                              @oninput="e => { _strumEdit = e.Value?.ToString() ?? _strumEdit; AutoSave(); }"
                              placeholder="SLAG: ↓ – ↓↑ – ↓ ↑ ↓↑ –
TAK:  1 + 2 + 3 + 4 +"></textarea>
                }
                else
                {
                    <div class="card-label-sm" style="margin-bottom:4px">Fingerpicking</div>
                    @((MarkupString)PatternRenderer.RenderFingerpick(_fingerpickEdit))
                    <textarea class="chord-editor pattern-edit" rows="3"
                              value="@_fingerpickDom"
                              @oninput="e => { _fingerpickEdit = e.Value?.ToString() ?? _fingerpickEdit; AutoSave(); }"
                              placeholder="FINGRE:  T  i  m  a  i  m  a  i
STRENGE: 6  2  3  1  2  3  1  2
TIP: ..."></textarea>
                    <div class="card-label-sm" style="margin:8px 0 4px">Strumming</div>
                    @((MarkupString)PatternRenderer.RenderStrum(_strumEdit))
                    <textarea class="chord-editor pattern-edit" rows="2"
                              value="@_strumDom"
                              @oninput="e => { _strumEdit = e.Value?.ToString() ?? _strumEdit; AutoSave(); }"
                              placeholder="SLAG: ↓ – ↓↑ – ↓ ↑ ↓↑ –
TAK:  1 + 2 + 3 + 4 +"></textarea>
                }
            </div>

        </div>

        <div class="studio-right">
            <!-- Lyrics -->
            <div class="studio-card" id="card-tekst">
                <div class="card-header">
                    <div class="card-label">📝 Tekst / Lyrics</div>
                    <div class="card-actions">
                        @if (HasInlineChords)
                        {
                            <button class="btn-ghost-sm" @onclick="AddTailChords" title="Sæt et halegreb sidst på hver linje: næste linjes akkord, og dominanten sidst i hvert afsnit">⤵ Halegreb</button>
                        }
                        @if (ChordAi.IsAvailable && !string.IsNullOrWhiteSpace(_lyricsEdit))
                        {
                            <button class="btn-ai" @onclick="AiAnnotateChords" disabled="@_annotatingChords"
                                    title="Indsæt [Akkord]-markører automatisk i teksten">
                                @(_annotatingChords ? "..." : "🤖 Sæt akkorder")
                            </button>
                        }
                        <button class="btn-ghost-sm" @onclick='() => _photoTarget = "lyrics"'>📷 Fra foto</button>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_song.Artist))
                {
                    <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted);margin-bottom:6px">
                        Kendt sang med en artist - brug <strong>"📋 Indsæt UG-tab"</strong> under Trin til venstre.
                        Ultimate Guitar giver akkorder og tekst i ét, samme format hver gang.
                    </div>
                }
                else
                {
                    <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted);margin-bottom:6px">
                        Hjemmelavet sang (fx fra Suno) - kopiér teksten direkte herunder, eller brug <strong>"📷 Fra foto"</strong>
                        ovenfor til et skærmbillede eller en PDF af teksten.
                    </div>
                }
                <textarea class="lyrics-editor" rows="14"
                          value="@_lyricsDom"
                          @oninput="e => { _lyricsEdit = e.Value?.ToString() ?? _lyricsEdit; SyncChordsFromLyrics(); AutoSave(); }"
                          placeholder="Skriv sektioner på egne linjer - fx Verse, Chorus, Vers 1, Omkvæd (med eller uden [ ]).
Brug [Am]ord for akkorder i teksten.

Eksempel:
Verse
[Am]I hope you don't mind [F]I put down in words...

Chorus
[C]How wonderful [G]life is..."></textarea>
                <div class="lyrics-hint" style="font-size:.78rem;color:var(--text-muted);margin-top:4px">
                    Sektioner (Verse, Chorus, Bridge, Intro, Outro, Instrumental, Vocal/Vocal 2, Vers 1, Omkvæd, Bro, osv.) skal stå alene på deres egen linje - med eller uden [ ].
                    "[Headline]" og "[Comment: ...]" skal altid have [ ] for at blive genkendt.
                    "🤖 Sæt akkorder" rører aldrig disse linjer, kun selve teksten.
                </div>
                @if (UnbracketedSectionLabels.Count > 0)
                {
                    <div class="lyrics-hint" style="font-size:.78rem;color:var(--warn,#c8860a);margin-top:4px">
                        💡 @string.Join(", ", UnbracketedSectionLabels.Select(l => $"\"{l}\"")) bør stå i klammer - fx "[@UnbracketedSectionLabels[0]]" - så det helt sikkert bliver genkendt som en sektion og ikke tekst.
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_lyricsEdit))
                {
                    <p style="font-size:0.75rem;color:#444;margin-top:2px">
                        Gå til <strong>🎼 Spilleguide</strong> for at se teksten i stort format og klik på akkorder for at se greb
                    </p>
                }
            </div>


            <!-- AI chord-placement preview - "Sæt akkorder" no longer writes
                 straight into the lyrics. Placement (which word a chord lands
                 on) is a judgment call the model can get wrong even when the
                 words themselves are preserved (PreservesWords only catches
                 word changes, not bad positions) - a PDF-sourced chord chart
                 in particular gave a real, confirmed-wrong placement here.
                 Showing the candidate first turns that into something you
                 catch before it's saved, not after. -->
            @if (_annotateCandidate is not null)
            {
                <div class="studio-card" style="border:1px solid var(--accent,#7c5cff)">
                    <div class="card-header">
                        <div class="card-label">🤖 Forslag til akkord-placering - tjek før du bruger det</div>
                    </div>
                    <pre style="white-space:pre-wrap;font-family:inherit;max-height:320px;overflow:auto;font-size:0.85rem;margin:0">@_annotateCandidate</pre>
                    <div style="display:flex;gap:8px;margin-top:10px">
                        <button class="btn-primary" @onclick="AcceptAnnotateCandidate">✓ Brug denne</button>
                        <button class="btn-ghost" @onclick="DiscardAnnotateCandidate">✕ Kassér</button>
                    </div>
                </div>
            }

            <!-- Notes - hidden for now (user, 2026-09-17), same flag as the AI card. -->
            @if (ShowAiHelper)
            {
            <div class="studio-card">
                <div class="card-header">
                    <div class="card-label">📋 Noter</div>
                    <button class="btn-ghost-sm" @onclick='() => _photoTarget = "notes"'>📷 Fra foto</button>
                </div>
                <textarea class="notes-editor" rows="5"
                          value="@_notesDom"
                          @oninput="e => { _notesEdit = e.Value?.ToString() ?? _notesEdit; AutoSave(); }"
                          placeholder="Dine egne noter, idéer, pointer..."></textarea>
            </div>
            }

            <!-- AI Helper - hidden for now (user, 2026-09-17: "maybe use it later"); flip ShowAiHelper to bring it back. -->
            @if (ShowAiHelper && ChordAi.IsAvailable)
            {
            <div class="studio-card">
                <div class="card-label" style="margin-bottom:10px">🧠 AI Hjælp</div>
                <div class="ai-tabs">
                    <button class="ai-tab @(_aiTab == "spil"     ? "ai-tab--active" : "")" @onclick='() => SelectAiTab("spil")'>🎸 Greb</button>
                    <button class="ai-tab @(_aiTab == "sang"     ? "ai-tab--active" : "")" @onclick='() => SelectAiTab("sang")'>🎤 Sang</button>
                    <button class="ai-tab @(_aiTab == "toneart"  ? "ai-tab--active" : "")" @onclick='() => SelectAiTab("toneart")'>🎹 Toneart</button>
                    <button class="ai-tab @(_aiTab == "overgang" ? "ai-tab--active" : "")" @onclick='() => SelectAiTab("overgang")'>🔀 Overgang</button>
                </div>

                @if (_aiTab == "spil")
                {
                    <div class="ai-rim">
                        <input class="ai-rim-input" type="text" placeholder="Akkordnavn, fx A/D, F#m, Bm7..."
                               value="@_chordLookup"
                               @oninput="e => _chordLookup = e.Value?.ToString() ?? string.Empty"
                               @onkeydown="OnChordLookupKey" />
                        <button class="btn-ai-full" @onclick="AiChordLookup" disabled="@(_aiHelperLoading || string.IsNullOrWhiteSpace(_chordLookup))">
                            @(_aiHelperLoading ? "..." : "Vis greb →")
                        </button>
                    </div>
                    <div class="ai-action-row" style="margin-top:8px">
                        <p class="ai-action-desc">Guitar &amp; piano mønstre for alle akkorder i sangen</p>
                        <button class="btn-ai-full" @onclick="AiSpil" disabled="@_aiHelperLoading">
                            @(_aiHelperLoading ? "..." : "Vis alle mønstre →")
                        </button>
                    </div>
                }
                else if (_aiTab == "sang")
                {
                    <div class="ai-action-row">
                        <p class="ai-action-desc">Fraseringer, åndedræt, dynamik og melodi</p>
                        <button class="btn-ai-full" @onclick="AiSang" disabled="@_aiHelperLoading">
                            @(_aiHelperLoading ? "..." : "Vis sangguide →")
                        </button>
                    </div>
                }
                else if (_aiTab == "toneart")
                {
                    <div class="ai-action-row">
                        <p class="ai-action-desc">Bedste toneart for din stemme + capo-position til guitar</p>
                        <button class="btn-ai-full" @onclick="AiToneart" disabled="@_aiHelperLoading">
                            @(_aiHelperLoading ? "..." : "Find toneart →")
                        </button>
                    </div>
                }
                else if (_aiTab == "overgang")
                {
                    <div class="ai-action-row">
                        <p class="ai-action-desc">Passing chords og overgangs-teknik mellem akkorderne i sangen</p>
                        <button class="btn-ai-full" @onclick="AiOvergang" disabled="@_aiHelperLoading">
                            @(_aiHelperLoading ? "..." : "Vis overgange →")
                        </button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_aiHelperResult))
                {
                    <div class="ai-result">
                        <pre class="ai-result-text">@_aiHelperResult</pre>
                        <button class="ai-result-clear" @onclick="ClearAiHelper">✕</button>
                    </div>
                }
            </div>
            }

        </div>
    </div>
    }

    <!-- ════════════════ TAB: OPTAG ════════════════ -->
    @if (_tab == "optag")
    {
    <div class="studio-record-tab">
    <div class="optag-layout">
    <div class="optag-controls">

        <!-- Recording card -->
        <div class="studio-card">
            <div class="card-header">
                <div class="card-label">⭐ Indspil — klar version</div>
                @if (_recordings.Any() && !_recording)
                {
                    <span class="rec-count">@_recordings.Count take(s)</span>
                }
            </div>

            @if (!_recording)
            {
                @if (_recordings.Count >= MaxTakes)
                {
                    <p style="font-size:0.85rem;color:#f59e0b;margin-bottom:10px">
                        ⚠ @MaxTakes optagelser nået. Lyt til dem og slet en i <strong>📼 Optagelser</strong>-listen nedenfor for at optage mere.
                    </p>
                }
                else
                {
                    <p style="font-size:0.8rem;color:#6b7280;margin-bottom:10px">
                        Klar til det rigtige take? Indspil din bedste version her.
                        Take @(_recordings.Count + 1) af @MaxTakes.
                    </p>
                    <div class="rec-mode-toggle" style="margin-bottom:10px">
                        <button class="rec-mode-btn @(_videoMode ? "" : "rec-mode-btn--active")"
                                @onclick='() => _videoMode = false'>🎙 Lyd</button>
                        <button class="rec-mode-btn @(_videoMode ? "rec-mode-btn--active" : "")"
                                @onclick='() => _videoMode = true'>📹 Video</button>
                    </div>

                    <!-- Visible regardless of whether the reference track is a
                         local file or a linked Spotify song - "Sang" targets
                         whichever is actually playing (both calls are no-ops
                         if that source isn't active), "Dig" always applies to
                         the mic since recording is mic-only either way. -->
                    <p style="font-size:0.75rem;color:#6b7280;margin-bottom:4px">
                        Med høretelefoner fanger optagelsen kun mikrofonen - sangen er slet ikke med i filen.
                        Skru sangen ned herunder hvis den fylder for meget i dine ører mens du spiller,
                        og skru dig selv op hvis du/guitaren skal stå tydeligere i optagelsen.
                    </p>
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                        <span style="font-size:0.75rem;color:#6b7280;min-width:70px">🔉 Sang (i øret)</span>
                        <input type="range" min="0" max="100" value="@_mixVolumePct" style="flex:1"
                               @oninput='e => { _mixVolumePct = int.TryParse(e.Value?.ToString(), out var vv) ? vv : 50; var v = _mixVolumePct / 100.0; JS.InvokeVoidAsync("studio.setMixVolume", v); JS.InvokeVoidAsync("spotifyPlayer.setVolume", v); }' />
                        <span style="font-size:0.72rem;color:#6b7280;min-width:34px;text-align:right">@_mixVolumePct %</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
                        <span style="font-size:0.75rem;color:#6b7280;min-width:70px">🎙 Dig (optaget)</span>
                        <input type="range" min="50" max="400" value="@_micGainPct" style="flex:1"
                               @oninput='e => { _micGainPct = int.TryParse(e.Value?.ToString(), out var g) ? g : 150; JS.InvokeVoidAsync("studio.setMicGain", _micGainPct / 100.0); }' />
                        <span style="font-size:0.72rem;color:#6b7280;min-width:34px;text-align:right">@_micGainPct %</span>
                    </div>

                    @if (LyricSectionNames.Count > 0)
                    {
                        <div style="margin-bottom:10px">
                            <p style="font-size:0.75rem;color:#6b7280;margin-bottom:4px">
                                Optag hele sangen, eller øv dig på ét afsnit ad gangen:
                            </p>
                            <div class="rec-mode-toggle" style="flex-wrap:wrap">
                                <button class="rec-mode-btn @(_selectedSection is null ? "rec-mode-btn--active" : "")"
                                        @onclick='() => _selectedSection = null'>Hele sangen</button>
                                @foreach (var sectionName in LyricSectionNames)
                                {
                                    <button class="rec-mode-btn @(_selectedSection == sectionName ? "rec-mode-btn--active" : "")"
                                            @onclick="() => _selectedSection = sectionName">@sectionName</button>
                                }
                            </div>
                        </div>
                        @if (_selectedSection is not null && !string.IsNullOrEmpty(_song!.SourceFile) && Library.Exists(_song.SourceFile))
                        {
                            var slug = SlugSection(_selectedSection);
                            var start = GetSectionStart(slug);
                            <div style="margin-bottom:10px;padding:8px;border:1px solid #2a2a2a;border-radius:6px">
                                <p style="font-size:0.75rem;color:#6b7280;margin-bottom:6px">
                                    Find stedet i sangen hvor "@_selectedSection" starter, og sæt det som starttid - så springer "🎧 Optag med sangen i baggrunden" direkte derhen i stedet for at starte forfra.
                                </p>
                                <audio id="section-preview-audio" src="/stream?path=@Uri.EscapeDataString(_song.SourceFile)"
                                       controls style="width:100%;margin-bottom:6px" />
                                <div style="display:flex;align-items:center;gap:8px">
                                    <button class="btn-ghost-sm" @onclick="() => SetSectionStartFromPlayer(slug)">🎯 Sæt starttid til nu</button>
                                    <span style="font-size:0.75rem;color:#6b7280">
                                        @(start is null ? "Ingen starttid sat endnu (starter fra 0:00)" : $"Starter ved {FormatRecTime((int)start.Value)}")
                                    </span>
                                    @if (start is not null)
                                    {
                                        <button class="btn-ghost-sm" @onclick="() => ClearSectionStart(slug)">↺ Nulstil</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                    @if (!string.IsNullOrEmpty(_song!.SourceFile) && Library.Exists(_song.SourceFile))
                    {
                        <button class="btn-record btn-record--big"
                                style="width:100%;padding:10px;margin-bottom:8px;background:#1d4ed8;border-color:#1d4ed8"
                                @onclick='() => StartOverdubFromUrl($"/stream?path={Uri.EscapeDataString(_song.SourceFile)}", _selectedSection is null ? 0 : (GetSectionStart(SlugSection(_selectedSection)) ?? 0))'
                                title="Afspiller sangen mens du synger - optagelsen fanger kun din mikrofon, ikke sangen selv">
                            🎧 Optag med sangen i baggrunden
                        </button>
                    }
                    else if (!string.IsNullOrEmpty(_song!.SpotifyTrackId) && Spotify.IsConnected)
                    {
                        <button class="btn-record btn-record--big"
                                style="width:100%;padding:10px;margin-bottom:8px;background:#1d4ed8;border-color:#1d4ed8"
                                @onclick="StartRecordingWithSpotify"
                                title="Afspiller sangen via Spotify mens du synger - optagelsen fanger kun din mikrofon, ikke sangen selv">
                            🎧 Optag med Spotify-sangen i baggrunden
                        </button>
                    }
                    <div class="optag-main-buttons">
                        <button class="btn-record" style="width:100%;padding:10px" @onclick="StartRecording">
                            ⏺ Optag@(_selectedSection is null ? "" : $" — {_selectedSection}")
                        </button>
                        @if (_recordings.Any())
                        {
                            <button class="btn-record btn-record--big"
                                    style="background:#1d4ed8;border-color:#1d4ed8"
                                    @onclick="StartOverdubRecording"
                                    title="Afspil seneste optagelse i høretelefoner og optag nyt spor ovenpå">
                                ⏺ Overdub (seneste take)
                            </button>
                        }
                    </div>
                }
                @if (_recordings.Count >= 2)
                {
                    @if (!_mixing)
                    {
                        <button class="btn-ghost-sm" style="margin-top:10px;width:100%;padding:10px"
                                @onclick="PlayMix">▶ Afspil mix alle @_recordings.Count spor</button>
                    }
                    else
                    {
                        <button class="btn-stop" style="margin-top:10px;width:100%"
                                @onclick="StopMix">⏹ Stop mix</button>
                    }
                }
            }
            else
            {
                @if (_videoMode)
                {
                    <video id="rec-preview" muted playsinline autoplay
                           style="width:100%;border-radius:8px;background:#000;margin-bottom:10px"></video>
                }
                <button class="btn-stop @(_recTimer >= 300 ? "btn-stop--warn" : "")"
                        style="width:100%;font-size:1rem;padding:16px"
                        @onclick="StopRecording">
                    ⏹ Stop (@FormatRecTime(_recTimer) / 10:00)
                </button>
                @if (_beat >= 0)
                {
                    <div class="beat-strip" style="justify-content:center;margin-top:14px">
                        @for (int b = 0; b < 4; b++)
                        {
                            <div class="beat-dot @(_beat == b ? "beat-dot--on" : "")">@(b + 1)</div>
                        }
                    </div>
                    <div style="text-align:center">
                        <span class="beat-total" title="Løbende beat-tal siden takten startede - det tal du markerer linjer med">Beat @_totalBeats</span>
                    </div>
                }
            }
        </div>

        <!-- Stems: shown whenever they exist on disk (pre-generated on the NAS),
             not only where demucs itself is installed. -->
        @if (StemSvc.IsAvailable || _stems is not null)
        {
        <div class="studio-card">
            <div class="card-header">
                <div class="card-label">🎛️ Udtræk spor</div>
                @if (_stems is not null && !_stemRunning)
                {
                    <button class="btn-ghost-sm" @onclick="ExtractStems" title="Udtræk igen">↺</button>
                }
            </div>

            @if (string.IsNullOrEmpty(_song!.SourceFile))
            {
                <p style="font-size:0.85rem;color:#555">
                    Vedhæft en kildefil under Trin for at dele sangen op i vokal, trommer, bas og instrumenter.
                </p>
            }
            else if (_stemRunning)
            {
                <div style="display:flex;align-items:center;gap:10px;padding:6px 0">
                    <div class="spinner"></div>
                    <div>
                        <div style="font-size:0.85rem;color:#ccc">Analyserer sang… (@_stemElapsed s)</div>
                        <div style="font-size:0.75rem;color:#444;margin-top:2px">Tager 1–3 minutter</div>
                    </div>
                </div>
            }
            else if (_stems is null && !HeavyFeaturesAllowed)
            {
                <p style="font-size:0.85rem;color:#b45309;margin-bottom:0">
                    ⚠️ Denne funktion bør køres lokalt — den er for CPU-tung til at køre her.
                </p>
            }
            else if (_stems is null)
            {
                <p style="font-size:0.85rem;color:#666;margin-bottom:10px">
                    Del sangen op i separate spor — syng til guitaren uden vokal, eller optag ovenpå bare trommerne.
                </p>
                <button class="btn-record" style="width:100%;background:#1d4ed8;border-color:#1d4ed8;padding:12px"
                        @onclick="ExtractStems">
                    🎛️ Udtræk spor
                </button>
            }
            else
            {
                @foreach (var (icon, label, path) in new[]
                {
                    ("🎤", "Vokal / Sang",    _stems.Vocals),
                    ("🥁", "Trommer",         _stems.Drums),
                    ("🎸", "Bas",             _stems.Bass),
                    ("🎹", "Instrumenter",    _stems.Other),
                })
                {
                    @if (path is not null)
                    {
                        var rel     = Path.GetRelativePath(Library.Root, path).Replace('\\', '/');
                        var playUrl = $"/stream?path={Uri.EscapeDataString(rel)}";
                        <div class="stem-row">
                            <div class="stem-row-header">
                                <span style="font-weight:700">@icon @label</span>
                                @if (!_recording)
                                {
                                    <button class="btn-record"
                                            style="font-size:0.75rem;padding:5px 12px;background:#1d4ed8;border-color:#1d4ed8"
                                            @onclick="() => StartOverdubFromUrl(playUrl)">
                                        ⏺ Syng til
                                    </button>
                                }
                            </div>
                            <audio controls id="stem-@label.GetHashCode()" src="@playUrl" style="width:100%;height:32px" />
                            <div style="display:flex;align-items:center;gap:8px;margin-top:4px">
                                <span style="font-size:0.72rem;color:#6b7280;min-width:52px">Lydstyrke</span>
                                <input type="range" min="0" max="100" value="@StemVol(label)" style="flex:1"
                                       @oninput="e => SetStemVol(label, e.Value?.ToString())" />
                                <span style="font-size:0.72rem;color:#6b7280;min-width:34px;text-align:right">@StemVol(label) %</span>
                            </div>
                        </div>
                    }
                }
            }
        </div>
        }

        <!-- Node-transskription -->
        @if (PianoTranscribe.IsAvailable)
        {
        <div class="studio-card">
            <div class="card-header">
                <div class="card-label">🎼 Node-transskription</div>
                @if (_noteMidPath is not null && !_noteRunning)
                {
                    <button class="btn-ghost-sm" @onclick="TranscribeNotes" title="Transskribér igen">↺</button>
                }
            </div>

            @if (string.IsNullOrEmpty(_song!.SourceFile))
            {
                <p style="font-size:0.85rem;color:#555">
                    Vedhæft en kildefil under Trin for at få de enkelte toner (ikke bare akkorder) som en MIDI-fil.
                </p>
            }
            else if (_noteRunning)
            {
                <div style="display:flex;align-items:center;gap:10px;padding:6px 0">
                    <div class="spinner"></div>
                    <div>
                        <div style="font-size:0.85rem;color:#ccc">Transskriberer… (@_noteElapsed s)</div>
                        <div style="font-size:0.75rem;color:#444;margin-top:2px">Kan tage et par minutter</div>
                    </div>
                </div>
            }
            else if (_noteMidPath is null && !HeavyFeaturesAllowed)
            {
                <p style="font-size:0.85rem;color:#b45309;margin-bottom:0">
                    ⚠️ Denne funktion bør køres lokalt — den er for CPU-tung til at køre her.
                </p>
            }
            else if (_noteMidPath is null)
            {
                <p style="font-size:0.85rem;color:#666;margin-bottom:10px">
                    Hør en akkord er ikke nok? Få hver enkelt tone som en MIDI-fil — åbn i MuseScore for nodebillede,
                    eller i et DAW-piano-roll for at loope og øve linje for linje.
                </p>
                <button class="btn-record" style="width:100%;background:#1d4ed8;border-color:#1d4ed8;padding:12px"
                        @onclick="TranscribeNotes">
                    🎼 Transskribér noder
                </button>
            }
            else
            {
                var relMid = Path.GetRelativePath(Library.Root, _noteMidPath).Replace('\\', '/');
                <p style="font-size:0.85rem;color:#8f8">✓ @_noteCount toner fundet</p>
                <a class="btn-ghost" style="width:100%;text-align:center;display:block"
                   href="/stream?path=@Uri.EscapeDataString(relMid)" download>
                    ⬇ Download MIDI-fil
                </a>
                <p style="font-size:0.75rem;color:#555;margin-top:6px">
                    Bemærk: transskriptionen hører alt tonehøjde-indhold i optagelsen (ikke kun isoleret klaver) —
                    brug den som et godt udgangspunkt, stol på øret hvor de er uenige.
                </p>
            }
        </div>
        }

        <!-- Sammensæt bedste afsnit: record several attempts per section
             (via the section picker above), then comp them into one final
             take - pick which attempt "wins" per section and merge in order. -->
        @if (LyricSectionNames.Count > 1 && _recordings.Any(r => r.Section is not null))
        {
        <div class="studio-card">
            <div class="card-label" style="margin-bottom:10px">🧩 Sammensæt bedste afsnit</div>
            <p style="font-size:0.75rem;color:#6b7280;margin-bottom:10px">
                Vælg den bedste optagelse for hvert afsnit, og flet dem sammen til én samlet optagelse i sangens rækkefølge.
            </p>
            @{ var _allSectionsHaveTakes = true; }
            @foreach (var sectionName in LyricSectionNames)
            {
                var slug = SlugSection(sectionName);
                var takes = TakesForSection(slug);
                @if (takes.Count == 0) { _allSectionsHaveTakes = false; }
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                    <span style="font-size:0.8rem;min-width:80px">@sectionName</span>
                    @if (takes.Count == 0)
                    {
                        <span style="font-size:0.75rem;color:#6b7280">Ingen optagelse endnu</span>
                    }
                    else
                    {
                        <select class="input" style="flex:1"
                                value="@(_chosenSectionTake.GetValueOrDefault(slug) ?? takes[^1].RelativePath)"
                                @onchange="e => _chosenSectionTake[slug] = e.Value?.ToString() ?? takes[^1].RelativePath">
                            @for (var i = 0; i < takes.Count; i++)
                            {
                                var t = takes[i];
                                <option value="@t.RelativePath">Optagelse @(i + 1) — @t.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</option>
                            }
                        </select>
                    }
                </div>
            }
            <button class="btn-record" style="width:100%;padding:10px;margin-top:6px"
                    disabled="@(!_allSectionsHaveTakes || _mergingRunning)"
                    @onclick="MergeSections">
                🧩 Flet sammen
            </button>
            @if (!_allSectionsHaveTakes)
            {
                <p style="font-size:0.75rem;color:#6b7280;margin-top:4px">Optag mindst ét take for hvert afsnit ovenfor, før du kan flette.</p>
            }
        </div>
        }

        <!-- Recordings list -->
        @if (_recordings.Any())
        {
        <div class="studio-card">
            <div class="card-label" style="margin-bottom:10px">📼 Optagelser (@_recordings.Count/@MaxTakes)</div>
            <div class="rec-list">
                @{ var _takeNumber = 0; }
                @foreach (var r in _recordings.OrderBy(x => x.CreatedAt))
                {
                    _takeNumber++;
                    var isMix = r.Name.StartsWith("mixtake");
                    var isMerge = r.Name.StartsWith("mergetake");
                    <div class="rec-item">
                        <div class="rec-item-info">
                            <span class="rec-item-name">
                                @(isMix ? "🎚" : isMerge ? "🧩" : r.IsAi ? "🤖" : r.IsVideo ? "📹" : "🎙") @(isMix ? "Mix" : isMerge ? "Flettet take" : r.IsAi ? "AI-version" : $"Take {_takeNumber}")
                                @if (r.Section is not null)
                                {
                                    <text> (@(char.ToUpper(r.Section[0]) + r.Section[1..])) </text>
                                }
                                — @r.Name
                            </span>
                            <span class="rec-item-date">@r.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                        </div>
                        @if (r.IsVideo)
                        {
                            <video controls src="/stream?path=@Uri.EscapeDataString(r.RelativePath)"
                                   class="rec-player" style="width:100%;border-radius:6px" />
                        }
                        else
                        {
                            <audio controls src="/stream?path=@Uri.EscapeDataString(r.RelativePath)" class="rec-player" />
                        }
                        <div class="rec-item-actions">
                            @if (!isMix && !r.IsVideo && !r.IsAi && _stems?.Other is not null)
                            {
                                <button class="btn-ghost-sm" disabled="@_mixdownRunning" @onclick="() => MixdownTake(r)"
                                        title="Bland denne optagelse sammen med instrumental-sporet fra Udtræk spor">
                                    🎚 Mix med instrumental
                                </button>
                            }
                            <button class="btn-publish" @onclick="() => Publish(r)">🚀 Publicér</button>
                            <button class="btn-publish" style="background:#15803d;border-color:#15803d" @onclick="() => PublishForAudience(r)" title="Gør dette take til sangens publikumsversion - én pr. sang, i galleriet Koncert">🎉 Publikum</button>
                            <button class="btn-delete-sm" @onclick="() => DeleteRecording(r)">🗑</button>
                        </div>
                    </div>
                }
            </div>
        </div>
        }
        else if (!_recording)
        {
            <div style="text-align:center;padding:40px 20px;color:#374151">
                <p style="font-size:2rem;margin-bottom:8px">🎙</p>
                <p>Ingen optagelser endnu</p>
                <p style="font-size:0.85rem;margin-top:4px">Tryk ⏺ Optag for at starte</p>
            </div>
        }

    </div><!-- /optag-controls -->

    <!-- RIGHT: Spilleguide while recording ─────────────── -->
    <div class="optag-lyrics">
    <div class="perform-side"><!-- everything that is not the words: right of the lyrics -->

        <!-- Guide controls: the bits you need mid-song. Transpose, beat and
             the la-la guide used to live on a separate "Øv & Spil" tab;
             folded in here so the flow is just Trin -> Indspil. -->
        <div class="perform-controls" style="margin-bottom:8px">
            <div class="transpose-row">
                <span class="t-label" style="color:#64748b">½t</span>
                <button class="t-btn" @onclick="() => AdjustT(-1)" title="Transponer ned">−</button>
                <button class="t-btn" @onclick="() => AdjustT(1)" title="Transponer op">+</button>
            </div>
            <span class="perform-key-badge">@_song.MusicKey@(_song.Tempo.HasValue ? $" · {_song.Tempo} BPM" : "")</span>
            <span class="t-label" title="Øve-tempo: beatet banker i dette tempo, og optagelsen sættes ned til det (samme toneleje). Sangen selv er @_song.Tempo BPM.">🐢 Øve</span>
            <input type="number" class="prog-key" style="width:64px" min="40" max="240" @bind="_practiceBpm" @bind:after="PracticeTempoChanged" />
            <span class="t-label">BPM</span>
            <button class="btn-ghost-sm @(_beat >= 0 ? "active" : "")"
                    @onclick="ToggleBeat" disabled="@(_song.Tempo is not > 0)"
                    title="@(_song.Tempo is not > 0 ? "Sæt et tempo (BPM) øverst for at bruge beat-markøren" : _beat >= 0 ? "Slå beat-markør fra" : "Slå beat-markør til - banker takten efter sangens tempo")">
                🥁 Beat
            </button>
            <button class="btn-primary" style="padding:6px 12px;font-size:0.85rem" @onclick="FollowAlong" disabled="@(_song.Tempo is not > 0 || !Library.Exists(_song.SourceFile))" title="Spil optagelsen og start beatet sammen - teksten følger med, næste linje tæller ned">▶ Følg</button>
            @if (_beat >= 0)
            {
                <div class="beat-strip">
                    @for (int b = 0; b < 4; b++)
                    {
                        <div class="beat-dot @(_beat == b ? "beat-dot--on" : "")">@(b + 1)</div>
                    }
                </div>
                <span class="beat-total" title="Løbende beat-tal siden takten startede">Beat @_totalBeats</span>
            }
            @if (Library.Exists(_song.SourceFile))
            {
                <audio src="/stream?path=@Uri.EscapeDataString(_song.SourceFile)"
                       controls class="perform-player" preload="metadata" />
            }
            @if (VocalGuide.IsAvailable)
            {
                <button class="btn-ai" style="padding:6px 12px;font-size:0.85rem"
                        @onclick="GenerateVocalGuide" disabled="@_vocalLoading"
                        title="Generer la-la-la sangstemme at synge med">
                    @(_vocalLoading ? "⏳" : "🎤 La-la guide")
                </button>
            }
            <button class="btn-ghost-sm @(_showGrebColumn ? "active" : "")"
                    @onclick="() => _showGrebColumn = !_showGrebColumn"
                    title="Vis/skjul greb-kolonnen til højre">
                🖼️ Greb
            </button>
            <button class="btn-ghost-sm @(_recShowFingerpick ? "active" : "")"
                    @onclick="() => _recShowFingerpick = !_recShowFingerpick"
                    title="Vis/skjul fingerpicking-diagram">
                🎸 Fingerpicking
            </button>
            <button class="btn-ghost-sm @(_showChordLabels ? "active" : "")"
                    style="padding:5px 10px;font-size:0.8rem"
                    @onclick="() => _showChordLabels = !_showChordLabels"
                    title="Vis/skjul akkordnavne over teksten">
                @(_showChordLabels ? "🎵 Akkorder" : "🎵 Kun tekst")
            </button>
            <button class="btn-ghost-sm @(_twoColLyrics ? "active" : "")"
                    style="padding:5px 10px;font-size:0.8rem"
                    @onclick='() => _twoColLyrics = !_twoColLyrics'
                    title="Skift mellem 1 og 2 kolonner">
                @(_twoColLyrics ? "⊞" : "☰")
            </button>
        </div>
    </div><!-- /perform-side -->
    <div class="perform-extras"><!-- la-la guide, chord detail, patterns: under the recording column -->
        @if (_vocalError is not null)
        {
            <div class="pattern-tip" style="color:#fca5a5;background:rgba(220,38,38,.1)">⚠️ @_vocalError</div>
        }
        @if (_vocalUrl is not null)
        {
            <div class="vocal-guide-player">
                <span class="pattern-label">🎤 La-la guide</span>
                <audio controls src="@_vocalUrl" class="perform-player" style="flex:1;min-width:200px" />
                <button class="btn-ghost-sm" @onclick='() => { _vocalUrl = null; _vocalError = null; }'>✕</button>
            </div>
        }

        <!-- Chord detail panel (same shared state as Spilleguide) -->
        @if (_selectedChord is not null)
        {
            var detail = ChordDiagrams.Get(_selectedChord);
            <div class="chord-detail-panel">
                <div class="chord-detail-header">
                    <span class="chord-detail-name">@_selectedChord</span>
                    <button class="chord-detail-close" @onclick="DismissChord">✕</button>
                </div>
                @if (detail is not null && _recShowChordDiagram)
                {
                    <div class="chord-detail-body">
                        <div>@((MarkupString)detail.Svg)</div>
                        @if (!string.IsNullOrEmpty(detail.ShapeLabel))
                        {
                            <div class="chord-shape-label">@detail.ShapeLabel</div>
                        }
                    </div>
                }
                @if (_selectedChordLoading)
                {
                    <p class="chord-detail-text" style="color:#6b7280">Henter tips...</p>
                }
                else if (!string.IsNullOrEmpty(_selectedChordInfo))
                {
                    <pre class="chord-detail-text">@_selectedChordInfo</pre>
                }
                <button class="btn-ghost-sm" style="margin-top:6px" @onclick="ShowChordTransition">
                    🔀 Overgang
                </button>
            </div>
        }

        <!-- Pattern bar -->
        @if ((_recShowFingerpick && !string.IsNullOrWhiteSpace(_fingerpickEdit)) || !string.IsNullOrWhiteSpace(_strumEdit))
        {
            <div class="perform-pattern-bar">
                @if (_recShowFingerpick && !string.IsNullOrWhiteSpace(_fingerpickEdit))
                {
                    <div>
                        <span class="pattern-label">Fingerpicking</span>
                        @((MarkupString)PatternRenderer.RenderFingerpick(_fingerpickEdit))
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_strumEdit))
                {
                    <div>
                        <span class="pattern-label">Strumming</span>
                        @((MarkupString)PatternRenderer.RenderStrum(_strumEdit))
                    </div>
                }
            </div>
        }

        <!-- Chord book: every chord in the song with its diagram, so you
             don't have to tap through them one at a time. Toggled by the
             "Greb" button above. -->
        @if (_recShowChordDiagram && UniqueChordsInOrder.Count > 0)
        {
            <div class="chord-pattern-grid">
                @foreach (var chord in UniqueChordsInOrder)
                {
                    var diagrams = ChordDiagrams.GetAll(chord);
                    <div class="chord-pattern-card">
                        <div class="chord-pattern-name">@chord</div>
                        @if (diagrams.Count > 0)
                        {
                            <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
                                @foreach (var d in diagrams)
                                {
                                    <div class="chord-detail-diagram">
                                        @((MarkupString)d.Svg)
                                        @if (!string.IsNullOrEmpty(d.ShapeLabel))
                                        {
                                            <div style="font-size:0.65rem;color:#64748b;margin-top:2px;text-align:center;max-width:80px">@d.ShapeLabel</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="font-size:0.75rem;color:#64748b">Intet kendt greb</div>
                        }
                    </div>
                }
            </div>
        }

        <!-- Chord overview - superseded by the greb column on the right; kept for the "Greb" button only. -->
        @if (HasAnyChords && _showOldChordBook)
        {
            <div class="perform-chord-overview">
                @foreach (var line in EffectiveChordSource.Split('\n'))
                {
                    @if (!string.IsNullOrWhiteSpace(line))
                    {
                        <div class="perform-chord-row">
                            @foreach (var token in line.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                            {
                                @if (IsChord(token))
                                {
                                    var c = token;
                                    <button class="perform-chord-btn @(_selectedChord == c ? "perform-chord-btn--active" : "")"
                                            @onclick="() => SelectPerformChord(c)"
                                            title="Klik for greb og overgang">@c</button>
                                }
                                else
                                {
                                    <span class="perform-section-chip">@token.TrimEnd(':')</span>
                                }
                            }
                        </div>
                    }
                }
            </div>
        }

    </div><!-- /perform-extras -->
    <div class="perform-center"><!-- the words, centred, the biggest thing on the page -->
        <!-- Lyrics -->
        @if (HasInlineChords)
        {
            var lines = _lyricsEdit.Split('\n');
            <div class="perform-sheet @(_twoColLyrics ? "perform-sheet--two-col" : "")">
                @for (var __i = 0; __i < lines.Length; __i++)
                {
                    var line = lines[__i];
                    var lineIndex = __i;
                    if (!InSelectedSection(lines, lineIndex)) continue;
                    @if (string.IsNullOrWhiteSpace(line))
                    {
                        <div class="perform-spacer"></div>
                    }
                    else if (IsSectionLabel(line))
                    {
                        <div class="perform-section-label">@line.Trim('[', ']', ':', ' ')</div>
                    }
                    else
                    {
                        <div class="perform-lyric-line @LineFollowClass(lineIndex)" id="line-@lineIndex">
                            @RenderBeatBadge(lineIndex)
                            @foreach (var seg in ParseLyricLine(line))
                            {
                                var segChord = seg.Chord;
                                <span class="perform-seg">
                                    @if (segChord is not null && _showChordLabels)
                                    {
                                        var open = _openDiagrams.Contains(segChord);
                                        <button class="perform-chord-inline @(open ? "perform-chord-inline--active" : "")"
                                                @onclick="() => ToggleChordDiagram(segChord)" title="Tryk: vis/skjul greb">@segChord</button>
                                        @if (open && ChordDiagrams.GetSvg(segChord) is { } svg)
                                        {
                                            <span class="perform-diagram" @onclick="() => ToggleChordDiagram(segChord)">@((MarkupString)svg)</span>
                                        }
                                    }
                                    else if (_showChordLabels)
                                    {
                                        <span class="perform-chord-inline" style="visibility:hidden">·</span>
                                    }
                                    <span class="perform-word">@seg.Text</span>
                                </span>
                            }
                        </div>
                    }
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_lyricsEdit))
        {
            var lines = _lyricsEdit.Split('\n');
            <div class="perform-sheet @(_twoColLyrics ? "perform-sheet--two-col" : "")">
                @for (var __i = 0; __i < lines.Length; __i++)
                {
                    var line = lines[__i];
                    var lineIndex = __i;
                    if (!InSelectedSection(lines, lineIndex)) continue;
                    @if (string.IsNullOrWhiteSpace(line))
                    {
                        <div class="perform-spacer"></div>
                    }
                    else if (IsSectionLabel(line))
                    {
                        <div class="perform-section-label">@line.Trim('[', ']', ':', ' ')</div>
                    }
                    else
                    {
                        <div class="perform-plain-line @LineFollowClass(lineIndex)" id="line-@lineIndex">@RenderBeatBadge(lineIndex) @line</div>
                    }
                }
            </div>
        }
        else
        {
            <div class="perform-empty">
                <p>Ingen tekst endnu</p>
                <button class="btn-ghost" @onclick='() => _tab = "forbered"'>← Tilbage til Trin</button>
            </div>
        }
    </div><!-- /perform-center -->

    <!-- Greb column: one guitar diagram per chord in the song, each can be
         switched off, and the one sounding right now lights up while the
         source recording plays (chord timeline from the recording, capo-aware). -->
    <div class="perform-grebs @(_showGrebColumn ? "" : "perform-grebs--hidden")" id="perform-grebs">
        @foreach (var ch in SongChordsInOrder())
        {
            var hidden = _hiddenGrebs.Contains(ch);
            <div class="greb @(hidden ? "greb--off" : "")" data-chord="@ch" @onclick="() => ToggleGreb(ch)" title="@(hidden ? "Vis greb" : "Skjul greb")">
                <div class="greb-name">@ch <span class="greb-frets">@(ChordFrets.Of(ch) ?? "")</span></div>
                @if (!hidden && ChordDiagrams.GetSvg(ch) is { } gsvg) { <div class="greb-svg">@((MarkupString)gsvg)</div> }
            </div>
        }
    </div>

    </div><!-- /optag-lyrics -->

    </div><!-- /optag-layout -->
    </div><!-- /studio-record-tab -->
    }

    @if (_saveStatus is not null)
    {
        <div class="save-toast">@_saveStatus</div>
    }
</div>
}

<!-- ════ MODAL: Paste from Ultimate Guitar ════ -->
@if (_ugPasteOpen)
{
    <div class="photo-overlay">
        <div class="photo-panel">
            <div class="photo-header">
                <span>🎸 Indsæt fra Ultimate Guitar</span>
                <button class="photo-close" @onclick='() => { _ugPasteOpen = false; _ugPasteText = ""; SyncEditorsToDom(); }'>✕</button>
            </div>
            <p style="font-size:0.85rem;color:#aaa;margin:4px 0 8px">
                Kopiér hele tab-teksten fra Ultimate Guitar og indsæt herunder.
                AI udtrækker akkorder og tekst automatisk.
            </p>
            <textarea class="chord-editor" rows="14"
                      style="font-size:0.8rem"
                      placeholder="Indsæt UG-tab her..."
                      value="@_ugPasteDom"
                      @oninput="e => _ugPasteText = e.Value?.ToString() ?? string.Empty"></textarea>
            <div class="photo-result-actions" style="margin-top:8px">
                <button class="btn-primary" @onclick="ParseUgTab"
                        disabled="@(_ugParsing || string.IsNullOrWhiteSpace(_ugPasteText))">
                    @(_ugParsing ? "Analyserer..." : "✓ Udtræk akkorder + tekst")
                </button>
                <button class="btn-ghost-sm" @onclick='() => { _ugPasteOpen = false; _ugPasteText = ""; SyncEditorsToDom(); }'>Annuller</button>
            </div>
        </div>
    </div>
}

<!-- ════ MODAL: Photo capture ════ -->
@if (_photoTarget is not null)
{
    <div class="photo-overlay">
        <div class="photo-panel">
            <div class="photo-header">
                <span>📷 Foto → @PhotoTargetLabel</span>
                <button class="photo-close" @onclick="ClosePhoto">✕</button>
            </div>

            @if (!_cameraOn)
            {
                <div class="photo-choose">
                    <button class="btn-primary" @onclick="OpenCamera">📷 Åbn kamera</button>
                    <label class="btn-ghost-file">
                        🖼 Vælg billede(r) eller PDF
                        <InputFile OnChange="OnFileSelected" accept="image/*,application/pdf" multiple style="display:none" />
                    </label>
                </div>
            }
            else
            {
                <video id="photo-video" autoplay muted playsinline webkit-playsinline class="photo-video"></video>
                <div class="photo-cam-actions">
                    <button class="btn-capture" @onclick="CapturePhoto">🔵 Tag billede</button>
                    <button class="btn-ghost-sm" @onclick="CloseCamera">✕ Luk kamera</button>
                </div>
            }

            @if (_photoAnalyzing)
            {
                <div class="photo-analyzing">
                    <div class="spinner"></div>
                    <span>Claude analyserer...</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(_photoResult))
            {
                <div class="photo-result">
                    <div class="photo-result-label">Resultat (kan redigeres):</div>
                    <textarea class="photo-result-text" rows="8"
                              value="@_photoResultDom"
                              @oninput="e => _photoResult = e.Value?.ToString() ?? string.Empty"></textarea>
                    <div class="photo-result-actions">
                        <button class="btn-primary" @onclick="ApplyPhotoResult">✓ Brug dette</button>
                        <button class="btn-ghost-sm" @onclick="ClearPhotoResult">Ryd</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string SongKey { get; set; } = "";
    [SupplyParameterFromQuery(Name = "file")] public string? FileParam { get; set; }

    // False on the NAS deployment (MusikSettings__HeavyFeaturesAllowed=false)
    // - stem separation/note transcription run real CPU-heavy torch inference,
    // and the NAS is small/memory-constrained shared infra. Default true
    // (local run) since that's where this always ran until 2026-08-26.
    private bool HeavyFeaturesAllowed => Configuration.GetValue("MusikSettings:HeavyFeaturesAllowed", true);

    private StudioSong? _song;
    private bool _loading = true;

    // The Trin editors are rebuilt from the *Dom snapshots whenever the Trin tab is
    // shown again, and those snapshots only follow programmatic changes - so after
    // Trin -> Indspil -> Trin the text boxes showed the text from page load, and
