    private async Task LinkSpotifyTrack(SpotifyTrack track)
    {
        if (_song is null) return;

        // Fire the UG search window.open as the very first thing, before any
        // await - browsers (incognito especially) only allow window.open as a
        // direct result of the click; once an await has yielded back to the
        // event loop, the click's "user activation" is gone and the popup gets
        // silently blocked. The paste box (_ugPasteOpen) has no such
        // restriction since it's just a Blazor state change, not a new window.
        if (string.IsNullOrWhiteSpace(_chordEdit))
        {
            await SearchUltimateGuitar();
            _ugPasteOpen = true;
        }

        _song.SpotifyTrackId = track.Id;
        _song.SpotifyTrackLabel = $"{track.Name} — {track.Artist}";
        _song.UpdatedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();

        // A fresh lyrics lookup for the newly-linked song, if we don't already
        // have one - separate from Spotify (see LyricsService) since Spotify's
        // API has no lyrics endpoint at all.
        if (string.IsNullOrEmpty(_song.SyncedLyrics))
        {
            var (synced, plain) = await Lyrics.FindLyricsAsync(track.Name, track.Artist, track.DurationMs);
            _song.SyncedLyrics = synced;

            // Fill the existing free-text Lyrics field too, but only if it's
            // still empty - never overwrite lyrics the user already typed/edited.
            if (string.IsNullOrWhiteSpace(_song.Lyrics) && !string.IsNullOrWhiteSpace(plain))
            {
                _song.Lyrics = plain;
                _lyricsEdit = plain;
            }

            await Db.SaveChangesAsync();
        }

        _spotifySearchOpen = false;
        _spotifyResults = [];
        _spotifyQuery = "";
    }

