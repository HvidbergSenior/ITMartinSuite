    // Plays the linked Spotify track and starts polling playback position to
    // highlight the matching line in #lyric-sync-container (see spotify.js) -
    // pure client-side after this call, not driven by further Blazor round-trips.
    private async Task ToggleKaraoke()
    {
        if (_song?.SpotifyTrackId is null) return;

        if (_karaokeActive)
        {
            await JS.InvokeVoidAsync("spotifyPlayer.stopLyricSync");
            await JS.InvokeVoidAsync("spotifyPlayer.pause");
            _karaokeActive = false;
            _spotifyPlaying = false;
            return;
        }

        await JS.InvokeVoidAsync("spotifyPlayer.playTrack", _song.SpotifyTrackId);
        if (!string.IsNullOrWhiteSpace(_song.SyncedLyrics))
            await JS.InvokeVoidAsync("spotifyPlayer.startLyricSync", "lyric-sync-container");
        _karaokeActive = true;
        _spotifyPlaying = true;
    }

