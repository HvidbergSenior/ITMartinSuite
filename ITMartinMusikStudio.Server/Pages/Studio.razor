    // Section labels found in the lyrics ("[Vers 1]", "[Omkvæd]", ...), in
    // first-appearance order, deduplicated - reuses IsSectionLabel so this
    // stays consistent with how the same lines are already recognized
    // elsewhere (chord-chart conversion, lyric parsing).
    private List<string> LyricSectionNames
    {
        get
        {
            if (_song is null) return [];
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var result = new List<string>();
            foreach (var raw in _song.Lyrics.Split('\n'))
            {
                var line = raw.Trim();
                if (!IsSectionLabel(line)) continue;
                var label = line.Trim('[', ']', ':').Trim();
                // "[Comment: Capo 3 …]" is a note, not something you sing - as a section it
                // never got a take and kept "Flet sammen" locked forever.
                if (label.StartsWith("Comment", StringComparison.OrdinalIgnoreCase)) continue;
                if (label.Length > 0 && seen.Add(label)) result.Add(label);
            }
            return result;
        }
    }
