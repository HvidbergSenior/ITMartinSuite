            await JS.InvokeVoidAsync("spotifyPlayer.playTrack", _song.SpotifyTrackId);
            _spotifyPlaying = true;
            await JS.InvokeVoidAsync("studio.startRecording", SongKey, _videoMode);
        }
        catch (JSException ex)
        {
            _recTimer_t?.Stop();
            _recTimer_t?.Dispose();
            _recTimer = 0;
            _recording = false;
            _saveStatus = _videoMode
                ? "Ingen kamera fundet — prøv lydoptagelse i stedet"
