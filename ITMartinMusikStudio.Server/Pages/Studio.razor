@page "/studio/{SongKey}"
@rendermode InteractiveServer
@implements IDisposable
@inject StudioDbContext Db
@inject StudioLibraryService Library
@inject ChordAiService ChordAi
@inject StemService StemSvc
@inject ChordDetectionService ChordDetectSvc
@inject VocalGuideService VocalGuide
@inject SpotifyService Spotify
@inject LyricsService Lyrics
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore

<PageTitle>@(_song?.Title ?? SongKey) — Studio</PageTitle>

@if (_song is null && !_loading)
{
    <div class="studio-init"><p>Opretter sang...</p></div>
}
else if (_song is not null)
{
<div class="studio-page">

    <!-- Top bar -->
    <div class="studio-topbar">
        <a href="/songs" class="topbar-back">← Sange</a>
        <div class="topbar-title-group">
            <input class="topbar-title-input" value="@_song.Title"
                   @onchange="e => { _song.Title = e.Value?.ToString() ?? _song.Title; AutoSave(); }" />
            <input class="topbar-artist-input" value="@_song.Artist" placeholder="Artist / eget"
                   @onchange="e => { _song.Artist = e.Value?.ToString() ?? string.Empty; AutoSave(); }" />
        </div>
        <div class="topbar-meta">
            <select class="meta-select" value="@_song.MusicKey" @onchange="OnKeyChanged">
                <optgroup label="Dur (Major)">
                    @foreach (var k in MajorKeys) { <option value="@k">@k</option> }
                </optgroup>
                <optgroup label="Mol (Minor)">
                    @foreach (var k in MinorKeys) { <option value="@k">@k</option> }
                </optgroup>
            </select>
            <input class="meta-bpm" type="number" placeholder="BPM"
                   value="@_song.Tempo" @onchange="OnTempoChanged" />
        </div>
    </div>

    <!-- Tab bar -->
    <div class="studio-tabs">
        <button class="studio-tab @(_tab == "forbered" ? "studio-tab--active" : "")"
                @onclick='() => _tab = "forbered"'>🔍 Forbered</button>
        <button class="studio-tab @(_tab == "spilleguide" ? "studio-tab--active" : "") @(_recording ? "studio-tab--rec" : "")"
                @onclick='() => _tab = "spilleguide"'>🎼 Øv & Spil@(_recording ? " ●" : "")</button>
        <button class="studio-tab @(_tab == "optag" ? "studio-tab--active" : "")"
                @onclick='() => _tab = "optag"'>⭐ Indspil</button>
    </div>

    <!-- Persistent Spotify mini-control - the full card (search/link UI) lives
         in Forbered only, but play/stop needs to work from every tab, since
         Øv & Spil and Indspil are exactly where you'd want the backing track
         playing. -->
    @if (Spotify.IsConnected && !string.IsNullOrEmpty(_song.SpotifyTrackId))
    {
        <div class="spotify-mini-bar">
            <span class="spotify-mini-label">🎵 @_song.SpotifyTrackLabel</span>
            @if (_spotifyPlaying)
            {
                <button class="btn-ghost-sm" @onclick="StopSpotifyTrack">⏹ Stop</button>
            }
            else
            {
                <button class="btn-ghost-sm" @onclick="PlaySpotifyTrack">▶ Afspil</button>
            }
        </div>
    }

    <!-- ════════════════ TAB: FORBERED ════════════════ -->
    @if (_tab == "forbered")
    {
    <div class="studio-body">
        <div class="studio-left">

            <!-- Source file -->
            <div class="studio-card">
                <div class="card-header">
                    <div class="card-label">🎬 Kilde</div>
                </div>
                @if (Library.Exists(_song.SourceFile))
                {
                    @if (Library.IsVideo(_song.SourceFile))
                    {
                        <video src="/stream?path=@Uri.EscapeDataString(_song.SourceFile)"
                               controls class="player-video" preload="metadata" />
                    }
                    else
                    {
                        <audio src="/stream?path=@Uri.EscapeDataString(_song.SourceFile)"
                               controls class="player-audio" preload="metadata" />
                    }
                }
                else
                {
                    <p class="no-file">Ingen kildefil tilknyttet</p>
                }
            </div>

            <!-- Spotify -->
            <div class="studio-card">
                <div class="card-header">
                    <div class="card-label">🎵 Spotify</div>
                </div>
                @if (!Spotify.IsConfigured)
                {
                    <p class="no-file">Spotify er ikke sat op endnu.</p>
                }
                else if (!Spotify.IsConnected)
                {
                    <a class="btn-primary" href="/spotify/login" style="display:block;text-align:center;text-decoration:none">
                        🔗 Forbind til Spotify
                    </a>
                }
                else if (!string.IsNullOrEmpty(_song!.SpotifyTrackId) && !_spotifySearchOpen)
                {
                    <p style="font-size:0.85rem;color:#9ca3af;margin-bottom:8px">@_song.SpotifyTrackLabel</p>
                    @if (_spotifyPlaying)
                    {
                        <button class="btn-primary" style="width:100%" @onclick="StopSpotifyTrack">
                            ⏹ Stop
                        </button>
                    }
                    else
                    {
                        <button class="btn-primary" style="width:100%" @onclick="PlaySpotifyTrack">
                            ▶ Afspil via Spotify (Premium påkrævet)
                        </button>
                    }
                    <button class="btn-ghost-sm" style="margin-top:6px" @onclick='() => _spotifySearchOpen = true'>
                        🔍 Skift sang
                    </button>
                }
                else
                {
                    <div style="display:flex;gap:6px">
                        <input class="chord-editor" style="height:auto;padding:8px" placeholder="Søg titel + kunstner..."
                               value="@_spotifyQuery" @oninput='e => _spotifyQuery = e.Value?.ToString() ?? ""' />
                        <button class="btn-primary" @onclick="SpotifySearch" disabled="@_spotifySearching">
                            @(_spotifySearching ? "..." : "🔍")
                        </button>
                    </div>
                    @if (_spotifyResults.Count > 0)
                    {
                        <div style="margin-top:8px;display:flex;flex-direction:column;gap:6px;max-height:240px;overflow-y:auto">
                            @foreach (var track in _spotifyResults)
                            {
                                <button class="btn-ghost" style="width:100%;text-align:left;display:flex;align-items:center;gap:8px"
                                        @onclick="() => LinkSpotifyTrack(track)">
                                    @if (!string.IsNullOrEmpty(track.AlbumArtUrl))
                                    {
                                        <img src="@track.AlbumArtUrl" style="width:32px;height:32px;border-radius:4px" />
                                    }
                                    <span>@track.Name — @track.Artist</span>
                                </button>
                            }
                        </div>
                    }
                }
            </div>

            <!-- Find song -->
            <div class="studio-card">
                <div class="card-label">🔍 Find sang</div>
                <div class="find-song-buttons">
                    <button class="btn-primary" @onclick="SearchUltimateGuitar">
                        🎸 Søg på Ultimate Guitar
                    </button>
                    @if (ChordAi.IsAvailable)
                    {
                        <button class="btn-ghost" style="width:100%"
                                @onclick='() => _ugPasteOpen = true'>
                            📋 Indsæt UG-tab → udtræk akkorder + tekst
                        </button>
                    }
                    <button class="btn-ghost" style="width:100%"
                            @onclick="SearchLyrics">
                        🔍 Søg sangtekst på Google
                    </button>
                </div>
            </div>

            <!-- Chord chart -->
            <div class="studio-card">
                <div class="card-header">
                    <div class="card-label">🎸 Akkorder</div>
                    <div class="card-actions">
                        <div class="transpose-row">
                            <span class="t-label">½t</span>
                            <button class="t-btn" @onclick="() => AdjustT(-1)" title="Transponer ned">−</button>
                            <button class="t-btn" @onclick="() => AdjustT(1)"  title="Transponer op">+</button>
                        </div>
                        @if (ChordDetectSvc.IsAvailable && _song is not null && !string.IsNullOrEmpty(_song.SourceFile))
                        {
                            <button class="btn-ai" @onclick="DetectChordsFromAudio" disabled="@_chordDetecting"
                                    title="Lyt til kildefilen og gæt akkorderne (eksperimentel, ikke 100% præcis)">
                                @(_chordDetecting ? "🎧 Lytter..." : "🎧 Fra lyd")
                            </button>
                        }
                        <button class="btn-ghost-sm" @onclick="SimplifyChords" title="Fjern slash-akkorder">简</button>
                        <button class="btn-ghost-sm" @onclick='() => _photoTarget = "chords"'>📷</button>
                    </div>
                </div>
                <textarea class="chord-editor" rows="8"
                          value="@_chordEdit"
                          @oninput="e => { _chordEdit = e.Value?.ToString() ?? _chordEdit; AutoSave(); }"
                          placeholder="Verse: Am G F E&#10;Chorus: C G Am F&#10;Bridge: Dm Am E Am"></textarea>
            </div>

            <!-- Patterns -->
            <div class="studio-card">
                <div class="card-header">
                    <div class="card-label">🎸 Mønstre</div>
                    <div class="card-actions" style="gap:6px">
                        <div class="pattern-toggle">
                            <button class="@(!_plektrumMode ? "pattern-toggle-btn active" : "pattern-toggle-btn")" @onclick='() => _plektrumMode = false'>🖐 Fingre</button>
                            <button class="@(_plektrumMode ? "pattern-toggle-btn active" : "pattern-toggle-btn")" @onclick='() => _plektrumMode = true'>🎸 Plektor</button>
                        </div>
                        @if (ChordAi.IsAvailable)
                        {
                            <button class="btn-ai" @onclick="AiPatterns" disabled="@_patternsLoading">
                                @(_patternsLoading ? "..." : "🤖 Generer")
                            </button>
                        }
                    </div>
                </div>

                @if (_plektrumMode)
                {
                    <div class="pattern-tip">
                        💡 Med plektor bruges strumming. Fingerpicking kræver bare fingre — brug strumming nedenfor som erstatning.
                    </div>
                    <div class="card-label-sm" style="margin-bottom:4px">Strumming</div>
                    @((MarkupString)PatternRenderer.RenderStrum(_strumEdit))
                    <textarea class="chord-editor pattern-edit" rows="2"
                              value="@_strumEdit"
                              @oninput="e => { _strumEdit = e.Value?.ToString() ?? _strumEdit; AutoSave(); }"
                              placeholder="SLAG: ↓ – ↓↑ – ↓ ↑ ↓↑ –&#10;TAK:  1 + 2 + 3 + 4 +"></textarea>
                }
                else
                {
                    <div class="card-label-sm" style="margin-bottom:4px">Fingerpicking</div>
                    @((MarkupString)PatternRenderer.RenderFingerpick(_fingerpickEdit))
                    <textarea class="chord-editor pattern-edit" rows="3"
                              value="@_fingerpickEdit"
                              @oninput="e => { _fingerpickEdit = e.Value?.ToString() ?? _fingerpickEdit; AutoSave(); }"
                              placeholder="FINGRE:  T  i  m  a  i  m  a  i&#10;STRENGE: 6  2  3  1  2  3  1  2&#10;TIP: ..."></textarea>
                    <div class="card-label-sm" style="margin:8px 0 4px">Strumming</div>
                    @((MarkupString)PatternRenderer.RenderStrum(_strumEdit))
                    <textarea class="chord-editor pattern-edit" rows="2"
                              value="@_strumEdit"
                              @oninput="e => { _strumEdit = e.Value?.ToString() ?? _strumEdit; AutoSave(); }"
                              placeholder="SLAG: ↓ – ↓↑ – ↓ ↑ ↓↑ –&#10;TAK:  1 + 2 + 3 + 4 +"></textarea>
                }
            </div>

        </div>

        <div class="studio-right">

            <!-- Lyrics -->
            <div class="studio-card">
                <div class="card-header">
                    <div class="card-label">📝 Tekst / Lyrics</div>
                    <div class="card-actions">
                        @if (ChordAi.IsAvailable && !string.IsNullOrWhiteSpace(_lyricsEdit))
                        {
                            <button class="btn-ai" @onclick="AiAnnotateChords" disabled="@_annotatingChords"
                                    title="Indsæt [Akkord]-markører automatisk i teksten">
                                @(_annotatingChords ? "..." : "🤖 Sæt akkorder")
                            </button>
                        }
                        <button class="btn-ghost-sm" @onclick='() => _photoTarget = "lyrics"'>📷 Fra foto</button>
                    </div>
                </div>
                <textarea class="lyrics-editor" rows="14"
                          value="@_lyricsEdit"
                          @oninput="e => { _lyricsEdit = e.Value?.ToString() ?? _lyricsEdit; SyncChordsFromLyrics(); AutoSave(); }"
                          placeholder="Brug [Am]ord for akkorder i teksten&#10;[Am]I hope you don't mind [F]I put down in words..."></textarea>
                @if (!string.IsNullOrWhiteSpace(_lyricsEdit))
                {
                    <p style="font-size:0.75rem;color:#444;margin-top:2px">
                        Gå til <strong>🎼 Spilleguide</strong> for at se teksten i stort format og klik på akkorder for at se greb
                    </p>
                }
            </div>

            <!-- Notes -->
            <div class="studio-card">
                <div class="card-header">
                    <div class="card-label">📋 Noter</div>
                    <button class="btn-ghost-sm" @onclick='() => _photoTarget = "notes"'>📷 Fra foto</button>
                </div>
                <textarea class="notes-editor" rows="5"
                          value="@_notesEdit"
                          @oninput="e => { _notesEdit = e.Value?.ToString() ?? _notesEdit; AutoSave(); }"
                          placeholder="Dine egne noter, idéer, pointer..."></textarea>
            </div>

            <!-- AI Helper -->
            @if (ChordAi.IsAvailable)
            {
            <div class="studio-card">
                <div class="card-label" style="margin-bottom:10px">🧠 AI Hjælp</div>
                <div class="ai-tabs">
                    <button class="ai-tab @(_aiTab == "spil"     ? "ai-tab--active" : "")" @onclick='() => SelectAiTab("spil")'>🎸 Greb</button>
                    <button class="ai-tab @(_aiTab == "sang"     ? "ai-tab--active" : "")" @onclick='() => SelectAiTab("sang")'>🎤 Sang</button>
                    <button class="ai-tab @(_aiTab == "toneart"  ? "ai-tab--active" : "")" @onclick='() => SelectAiTab("toneart")'>🎹 Toneart</button>
                    <button class="ai-tab @(_aiTab == "overgang" ? "ai-tab--active" : "")" @onclick='() => SelectAiTab("overgang")'>🔀 Overgang</button>
                </div>

                @if (_aiTab == "spil")
                {
                    <div class="ai-rim">
                        <input class="ai-rim-input" type="text" placeholder="Akkordnavn, fx A/D, F#m, Bm7..."
                               value="@_chordLookup"
                               @oninput="e => _chordLookup = e.Value?.ToString() ?? string.Empty"
                               @onkeydown="OnChordLookupKey" />
                        <button class="btn-ai-full" @onclick="AiChordLookup" disabled="@(_aiHelperLoading || string.IsNullOrWhiteSpace(_chordLookup))">
                            @(_aiHelperLoading ? "..." : "Vis greb →")
                        </button>
                    </div>
                    <div class="ai-action-row" style="margin-top:8px">
                        <p class="ai-action-desc">Guitar &amp; piano mønstre for alle akkorder i sangen</p>
                        <button class="btn-ai-full" @onclick="AiSpil" disabled="@_aiHelperLoading">
                            @(_aiHelperLoading ? "..." : "Vis alle mønstre →")
                        </button>
                    </div>
                }
                else if (_aiTab == "sang")
                {
                    <div class="ai-action-row">
                        <p class="ai-action-desc">Fraseringer, åndedræt, dynamik og melodi</p>
                        <button class="btn-ai-full" @onclick="AiSang" disabled="@_aiHelperLoading">
                            @(_aiHelperLoading ? "..." : "Vis sangguide →")
                        </button>
                    </div>
                }
                else if (_aiTab == "toneart")
                {
                    <div class="ai-action-row">
                        <p class="ai-action-desc">Bedste toneart for din stemme + capo-position til guitar</p>
                        <button class="btn-ai-full" @onclick="AiToneart" disabled="@_aiHelperLoading">
                            @(_aiHelperLoading ? "..." : "Find toneart →")
                        </button>
                    </div>
                }
                else if (_aiTab == "overgang")
                {
                    <div class="ai-action-row">
                        <p class="ai-action-desc">Passing chords og overgangs-teknik mellem akkorderne i sangen</p>
                        <button class="btn-ai-full" @onclick="AiOvergang" disabled="@_aiHelperLoading">
                            @(_aiHelperLoading ? "..." : "Vis overgange →")
                        </button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_aiHelperResult))
                {
                    <div class="ai-result">
                        <pre class="ai-result-text">@_aiHelperResult</pre>
                        <button class="ai-result-clear" @onclick="ClearAiHelper">✕</button>
                    </div>
                }
            </div>
            }

        </div>
    </div>
    }

    <!-- ════════════════ TAB: SPILLEGUIDE ════════════════ -->
    @if (_tab == "spilleguide")
    {
    <div class="perform-page">

        <!-- Controls strip -->
        <div class="perform-controls">
            <div class="transpose-row">
                <span class="t-label" style="color:#64748b">½t</span>
                <button class="t-btn" @onclick="() => AdjustT(-1)">−</button>
                <button class="t-btn" @onclick="() => AdjustT(1)">+</button>
            </div>
            <span class="perform-key-badge">@_song.MusicKey@(_song.Tempo.HasValue ? $" · {_song.Tempo} BPM" : "")</span>
            @if (Library.Exists(_song.SourceFile))
            {
                <audio src="/stream?path=@Uri.EscapeDataString(_song.SourceFile)"
                       controls class="perform-player" preload="metadata" />
            }
            @if (!_recording)
            {
                @if (_recordings.Count >= MaxTakes)
                {
                    <span style="font-size:0.8rem;color:#f59e0b">⚠ @MaxTakes takes nået</span>
                }
                else
                {
                    <button class="btn-record" style="padding:6px 16px;font-size:0.9rem"
                            @onclick="StartRecording">⏺ Optag (@(_recordings.Count + 1)/@MaxTakes)</button>
                }
            }
            else
            {
                <button class="btn-stop btn-stop--pulse" style="padding:6px 16px;font-size:0.9rem"
                        @onclick="StopRecording">⏹ @FormatRecTime(_recTimer)</button>
                @if (_beat >= 0)
                {
                    <div class="beat-strip">
                        @for (int b = 0; b < 4; b++)
                        {
                            <div class="beat-dot @(_beat == b ? "beat-dot--on" : "")">@(b + 1)</div>
                        }
                    </div>
                }
            }
            @if (VocalGuide.IsAvailable)
            {
                <button class="btn-ai" style="padding:6px 12px;font-size:0.85rem"
                        @onclick="GenerateVocalGuide" disabled="@_vocalLoading"
                        title="Generer la-la-la sangstemme at synge med">
                    @(_vocalLoading ? "⏳" : "🎤 La-la guide")
                </button>
            }
            <button class="btn-ghost-sm @(_twoColLyrics ? "active" : "")"
                    style="padding:5px 10px;font-size:0.8rem"
                    @onclick='() => _twoColLyrics = !_twoColLyrics'
                    title="Skift mellem 1 og 2 kolonner">
                @(_twoColLyrics ? "⊞" : "☰")
            </button>
            @if (!string.IsNullOrEmpty(_song.SpotifyTrackId))
            {
                <button class="btn-ghost-sm @(_karaokeActive ? "active" : "")"
                        style="padding:5px 10px;font-size:0.8rem"
                        @onclick="ToggleKaraoke"
                        title="Afspil på Spotify og følg teksten med">
                    @(_karaokeActive ? "⏹ Stop" : "🎤 Karaoke")
                </button>
            }
        </div>

        @if (_recordings.Any())
        {
            var latestRec = _recordings.OrderByDescending(r => r.CreatedAt).First();
            <div class="practice-playback-bar">
                <span class="pattern-label">📼 Seneste:</span>
                @if (latestRec.IsVideo)
                {
                    <video controls src="/stream?path=@Uri.EscapeDataString(latestRec.RelativePath)"
                           style="height:36px;border-radius:4px" />
                }
                else
                {
                    <audio controls src="/stream?path=@Uri.EscapeDataString(latestRec.RelativePath)"
                           class="perform-player" style="flex:1;min-width:180px" preload="metadata" />
                }
            </div>
        }

        @if (_vocalError is not null)
        {
            <div class="pattern-tip" style="color:#fca5a5;background:rgba(220,38,38,.1)">⚠️ @_vocalError</div>
        }
        @if (_vocalUrl is not null)
        {
            <div class="vocal-guide-player">
                <span class="pattern-label">🎤 La-la guide</span>
                <audio controls src="@_vocalUrl" class="perform-player" style="flex:1;min-width:200px" />
                <button class="btn-ghost-sm" @onclick='() => { _vocalUrl = null; _vocalError = null; }'>✕</button>
            </div>
        }

        <!-- Chord overview (from chord chart or inline lyrics) -->
        @if (HasAnyChords)
        {
            <div class="perform-chord-overview">
                @foreach (var line in EffectiveChordSource.Split('\n'))
                {
                    @if (!string.IsNullOrWhiteSpace(line))
                    {
                        <div class="perform-chord-row">
                            @foreach (var token in line.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                            {
                                @if (IsChord(token))
                                {
                                    var c = token;
                                    <button class="perform-chord-btn @(_selectedChord == c ? "perform-chord-btn--active" : "")"
                                            @onclick="() => SelectPerformChord(c)"
                                            title="Klik for greb og overgang">@c</button>
                                }
                                else
                                {
                                    <span class="perform-section-chip">@token.TrimEnd(':')</span>
                                }
                            }
                        </div>
                    }
                }
            </div>
        }

        <!-- Chord detail panel (appears when chord is tapped) -->
        @if (_selectedChord is not null)
        {
            <div class="chord-detail-panel">
                <div class="chord-detail-header">
                    <span class="chord-detail-name">@_selectedChord</span>
                    <div style="display:flex;gap:8px;align-items:center">
                        <button class="btn-ghost-sm" @onclick="() => _showPiano = !_showPiano"
                                title="Skift mellem guitar og klaver">
                            @(_showPiano ? "🎸 Guitar" : "🎹 Klaver")
                        </button>
                        @if (!_selectedChordLoading && ChordAi.IsAvailable)
                        {
                            <button class="btn-ai" @onclick="ShowChordTransition"
                                    disabled="@_selectedChordLoading"
                                    title="Vis overgangs-teknik til næste akkord">
                                🔀 Overgang
                            </button>
                        }
                        <button class="chord-detail-close" @onclick="DismissChord">✕</button>
                    </div>
                </div>
                <div class="chord-detail-body">
                    @if (_showPiano)
                    {
                        var pianoSvg = PianoDiagrams.GetSvg(_selectedChord);
                        @if (pianoSvg is not null)
                        {
                            <div class="chord-detail-diagram">@((MarkupString)pianoSvg)</div>
                        }
                    }
                    else
                    {
                        var diagrams = ChordDiagrams.GetAll(_selectedChord);
                        @if (diagrams.Count > 0)
                        {
                        <div style="display:flex;gap:10px;flex-wrap:wrap">
                            @foreach (var diagram in diagrams)
                            {
                                <div class="chord-detail-diagram">
                                    @((MarkupString)diagram.Svg)
                                    @if (!string.IsNullOrEmpty(diagram.ShapeLabel))
                                    {
                                        <div style="font-size:0.7rem;color:#64748b;margin-top:4px;text-align:center;max-width:80px">@diagram.ShapeLabel</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    }
                    @if (_selectedChordLoading)
                    {
                        <div style="display:flex;align-items:center;gap:8px;padding:8px 0">
                            <div class="spinner"></div>
                            <span style="font-size:0.85rem;color:#64748b">Henter greb...</span>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_selectedChordInfo))
                    {
                        <pre class="chord-detail-text">@_selectedChordInfo</pre>
                    }
                </div>
            </div>
        }

        <!-- Pattern reference bar -->
        @if (!string.IsNullOrWhiteSpace(_strumEdit) || !string.IsNullOrWhiteSpace(_fingerpickEdit))
        {
            <div class="perform-pattern-bar">
                @if (!string.IsNullOrWhiteSpace(_fingerpickEdit))
                {
                    <div>
                        <span class="pattern-label">Fingerpicking</span>
                        @((MarkupString)PatternRenderer.RenderFingerpick(_fingerpickEdit))
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_strumEdit))
                {
                    <div>
                        <span class="pattern-label">Strumming</span>
                        @((MarkupString)PatternRenderer.RenderStrum(_strumEdit))
                    </div>
                }
            </div>
        }

        <!-- Main: lyrics with chords OR plain text -->
        @if (HasInlineChords)
        {
            <div class="perform-sheet @(_twoColLyrics ? "perform-sheet--two-col" : "")">
                @foreach (var line in _lyricsEdit.Split('\n'))
                {
                    @if (string.IsNullOrWhiteSpace(line))
                    {
                        <div class="perform-spacer"></div>
                    }
                    else if (IsSectionLabel(line))
                    {
                        <div class="perform-section-label">@line.Trim('[', ']', ':', ' ')</div>
                    }
                    else
                    {
                        <div class="perform-lyric-line">
                            @foreach (var seg in ParseLyricLine(line))
                            {
                                var segChord = seg.Chord;
                                <span class="perform-seg">
                                    @if (segChord is not null)
                                    {
                                        <button class="perform-chord-inline @(_selectedChord == segChord ? "perform-chord-inline--active" : "")"
                                                @onclick="() => SelectPerformChord(segChord)">@segChord</button>
                                    }
                                    else
                                    {
                                        <span class="perform-chord-inline" style="visibility:hidden">·</span>
                                    }
                                    <span class="perform-word">@seg.Text</span>
                                </span>
                            }
                        </div>
                    }
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_song?.SyncedLyrics))
        {
            <div id="lyric-sync-container" class="perform-sheet @(_twoColLyrics ? "perform-sheet--two-col" : "")">
                @foreach (var (seconds, text) in LyricsService.ParseLrc(_song.SyncedLyrics))
                {
                    @if (string.IsNullOrWhiteSpace(text))
                    {
                        <div class="perform-spacer"></div>
                    }
                    else
                    {
                        <div class="perform-plain-line" data-time="@seconds.ToString(System.Globalization.CultureInfo.InvariantCulture)">@text</div>
                    }
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_lyricsEdit))
        {
            <div class="perform-sheet @(_twoColLyrics ? "perform-sheet--two-col" : "")">
                @foreach (var line in _lyricsEdit.Split('\n'))
                {
                    @if (string.IsNullOrWhiteSpace(line))
                    {
                        <div class="perform-spacer"></div>
                    }
                    else if (IsSectionLabel(line))
                    {
                        <div class="perform-section-label">@line.Trim('[', ']', ':', ' ')</div>
                    }
                    else
                    {
                        <div class="perform-plain-line">@line</div>
                    }
                }
            </div>
        }
        else
        {
            <div class="perform-empty">
                <p>Ingen tekst endnu</p>
                <button class="btn-ghost" @onclick='() => _tab = "forbered"'>← Gå til Forbered</button>
            </div>
        }

    </div>
    }

    <!-- ════════════════ TAB: OPTAG ════════════════ -->
    @if (_tab == "optag")
    {
    <div class="studio-record-tab">
    <div class="optag-layout">
    <div class="optag-controls">

        <!-- Recording card -->
        <div class="studio-card">
            <div class="card-header">
                <div class="card-label">⭐ Indspil — klar version</div>
                @if (_recordings.Any() && !_recording)
                {
                    <span class="rec-count">@_recordings.Count take(s)</span>
                }
            </div>

            @if (!_recording)
            {
                @if (_recordings.Count >= MaxTakes)
                {
                    <p style="font-size:0.85rem;color:#f59e0b;margin-bottom:10px">
                        ⚠ @MaxTakes optagelser nået. Lyt til dem og slet en i <strong>📼 Optagelser</strong>-listen nedenfor for at optage mere.
                    </p>
                }
                else
                {
                    <p style="font-size:0.8rem;color:#6b7280;margin-bottom:10px">
                        Klar til det rigtige take? Øv i <strong>Øv & Spil</strong> — og indspil din bedste version her.
                        Take @(_recordings.Count + 1) af @MaxTakes.
                    </p>
                    <div class="rec-mode-toggle" style="margin-bottom:10px">
                        <button class="rec-mode-btn @(_videoMode ? "" : "rec-mode-btn--active")"
                                @onclick='() => _videoMode = false'>🎙 Lyd</button>
                        <button class="rec-mode-btn @(_videoMode ? "rec-mode-btn--active" : "")"
                                @onclick='() => _videoMode = true'>📹 Video</button>
                    </div>

                    <!-- Visible regardless of whether the reference track is a
                         local file or a linked Spotify song - "Sang" targets
                         whichever is actually playing (both calls are no-ops
                         if that source isn't active), "Dig" always applies to
                         the mic since recording is mic-only either way. -->
                    <p style="font-size:0.75rem;color:#6b7280;margin-bottom:4px">
                        Med høretelefoner fanger optagelsen kun mikrofonen - sangen er slet ikke med i filen.
                        Skru sangen ned herunder hvis den fylder for meget i dine ører mens du spiller,
                        og skru dig selv op hvis du/guitaren skal stå tydeligere i optagelsen.
                    </p>
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                        <span style="font-size:0.75rem;color:#6b7280;min-width:70px">🔉 Sang (i øret)</span>
                        <input type="range" min="0" max="100" value="50" style="flex:1"
                               @oninput='e => { var v = (double.TryParse(e.Value?.ToString(), out var vv) ? vv : 50) / 100.0; JS.InvokeVoidAsync("studio.setMixVolume", v); JS.InvokeVoidAsync("spotifyPlayer.setVolume", v); }' />
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
                        <span style="font-size:0.75rem;color:#6b7280;min-width:70px">🎙 Dig (optaget)</span>
                        <input type="range" min="50" max="400" value="150" style="flex:1"
                               @oninput='e => JS.InvokeVoidAsync("studio.setMicGain", (double.TryParse(e.Value?.ToString(), out var g) ? g : 150) / 100.0)' />
                    </div>

                    @if (!string.IsNullOrEmpty(_song!.SourceFile) && Library.Exists(_song.SourceFile))
                    {
                        <button class="btn-record btn-record--big"
                                style="width:100%;padding:10px;margin-bottom:8px;background:#1d4ed8;border-color:#1d4ed8"
                                @onclick='() => StartOverdubFromUrl($"/stream?path={Uri.EscapeDataString(_song.SourceFile)}")'
                                title="Afspiller sangen mens du synger - optagelsen fanger kun din mikrofon, ikke sangen selv">
                            🎧 Optag med sangen i baggrunden
                        </button>
                    }
                    else if (!string.IsNullOrEmpty(_song!.SpotifyTrackId) && Spotify.IsConnected)
                    {
                        <button class="btn-record btn-record--big"
                                style="width:100%;padding:10px;margin-bottom:8px;background:#1d4ed8;border-color:#1d4ed8"
                                @onclick="StartRecordingWithSpotify"
                                title="Afspiller sangen via Spotify mens du synger - optagelsen fanger kun din mikrofon, ikke sangen selv">
                            🎧 Optag med Spotify-sangen i baggrunden
                        </button>
                    }
                    <div class="optag-main-buttons">
                        <button class="btn-record" style="width:100%;padding:10px" @onclick='async () => { _tab = "spilleguide"; await StartRecording(); }'>
                            ⏺ Optag i Øv & Spil
                        </button>
                        @if (_recordings.Any())
                        {
                            <button class="btn-record btn-record--big"
                                    style="background:#1d4ed8;border-color:#1d4ed8"
                                    @onclick="StartOverdubRecording"
                                    title="Afspil seneste optagelse i høretelefoner og optag nyt spor ovenpå">
                                ⏺ Overdub (seneste take)
                            </button>
                        }
                    </div>
                }
                @if (_recordings.Count >= 2)
                {
                    @if (!_mixing)
                    {
                        <button class="btn-ghost-sm" style="margin-top:10px;width:100%;padding:10px"
                                @onclick="PlayMix">▶ Afspil mix alle @_recordings.Count spor</button>
                    }
                    else
                    {
                        <button class="btn-stop" style="margin-top:10px;width:100%"
                                @onclick="StopMix">⏹ Stop mix</button>
                    }
                }
            }
            else
            {
                @if (_videoMode)
                {
                    <video id="rec-preview" muted playsinline autoplay
                           style="width:100%;border-radius:8px;background:#000;margin-bottom:10px"></video>
                }
                <button class="btn-stop @(_recTimer >= 300 ? "btn-stop--warn" : "")"
                        style="width:100%;font-size:1rem;padding:16px"
                        @onclick="StopRecording">
                    ⏹ Stop (@FormatRecTime(_recTimer) / 10:00)
                </button>
                @if (_beat >= 0)
                {
                    <div class="beat-strip" style="justify-content:center;margin-top:14px">
                        @for (int b = 0; b < 4; b++)
                        {
                            <div class="beat-dot @(_beat == b ? "beat-dot--on" : "")">@(b + 1)</div>
                        }
                    </div>
                }
            }
        </div>

        <!-- Stems -->
        @if (StemSvc.IsAvailable)
        {
        <div class="studio-card">
            <div class="card-header">
                <div class="card-label">🎛️ Udtræk spor</div>
                @if (_stems is not null && !_stemRunning)
                {
                    <button class="btn-ghost-sm" @onclick="ExtractStems" title="Udtræk igen">↺</button>
                }
            </div>

            @if (string.IsNullOrEmpty(_song!.SourceFile))
            {
                <p style="font-size:0.85rem;color:#555">
                    Vedhæft en kildefil under 🔍 Forbered for at dele sangen op i vokal, trommer, bas og instrumenter.
                </p>
            }
            else if (_stemRunning)
            {
                <div style="display:flex;align-items:center;gap:10px;padding:6px 0">
                    <div class="spinner"></div>
                    <div>
                        <div style="font-size:0.85rem;color:#ccc">Analyserer sang… (@_stemElapsed s)</div>
                        <div style="font-size:0.75rem;color:#444;margin-top:2px">Tager 1–3 minutter</div>
                    </div>
                </div>
            }
            else if (_stems is null)
            {
                <p style="font-size:0.85rem;color:#666;margin-bottom:10px">
                    Del sangen op i separate spor — syng til guitaren uden vokal, eller optag ovenpå bare trommerne.
                </p>
                <button class="btn-record" style="width:100%;background:#1d4ed8;border-color:#1d4ed8;padding:12px"
                        @onclick="ExtractStems">
                    🎛️ Udtræk spor
                </button>
            }
            else
            {
                @foreach (var (icon, label, path) in new[]
                {
                    ("🎤", "Vokal / Sang",    _stems.Vocals),
                    ("🥁", "Trommer",         _stems.Drums),
                    ("🎸", "Bas",             _stems.Bass),
                    ("🎹", "Instrumenter",    _stems.Other),
                })
                {
                    @if (path is not null)
                    {
                        var rel     = Path.GetRelativePath(Library.Root, path).Replace('\\', '/');
                        var playUrl = $"/stream?path={Uri.EscapeDataString(rel)}";
                        <div class="stem-row">
                            <div class="stem-row-header">
                                <span style="font-weight:700">@icon @label</span>
                                @if (!_recording)
                                {
                                    <button class="btn-record"
                                            style="font-size:0.75rem;padding:5px 12px;background:#1d4ed8;border-color:#1d4ed8"
                                            @onclick="() => StartOverdubFromUrl(playUrl)">
                                        ⏺ Syng til
                                    </button>
                                }
                            </div>
                            <audio controls src="@playUrl" style="width:100%;height:32px" />
                        </div>
                    }
                }
            }
        </div>
        }

        <!-- AI take upload - manually downloaded from Suno (no official API, see /songwriter), attached here so it sits alongside the sung takes for this song instead of floating unclaimed on the Songs page -->
        <div class="studio-card">
            <div class="card-label" style="margin-bottom:10px">🤖 Tilføj AI-version (fra Suno)</div>
            <InputFile OnChange="UploadAiTake" accept="audio/*" />
            @if (!string.IsNullOrEmpty(_aiUploadStatus))
            {
                <div style="font-size:0.85rem;color:var(--muted);margin-top:6px">@_aiUploadStatus</div>
            }
        </div>

        <!-- Recordings list -->
        @if (_recordings.Any())
        {
        <div class="studio-card">
            <div class="card-label" style="margin-bottom:10px">📼 Optagelser (@_recordings.Count/@MaxTakes)</div>
            <div class="rec-list">
                @{ var _takeNumber = 0; }
                @foreach (var r in _recordings.OrderBy(x => x.CreatedAt))
                {
                    _takeNumber++;
                    <div class="rec-item">
                        <div class="rec-item-info">
                            <span class="rec-item-name">@(r.IsAi ? "🤖" : r.IsVideo ? "📹" : "🎙") @(r.IsAi ? "AI-version" : $"Take {_takeNumber}") — @r.Name</span>
                            <span class="rec-item-date">@r.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                        </div>
                        @if (r.IsVideo)
                        {
                            <video controls src="/stream?path=@Uri.EscapeDataString(r.RelativePath)"
                                   class="rec-player" style="width:100%;border-radius:6px" />
                        }
                        else
                        {
                            <audio controls src="/stream?path=@Uri.EscapeDataString(r.RelativePath)" class="rec-player" />
                        }
                        <div class="rec-item-actions">
                            <button class="btn-publish" @onclick="() => Publish(r)">🚀 Publicér</button>
                            <button class="btn-delete-sm" @onclick="() => DeleteRecording(r)">🗑</button>
                        </div>
                    </div>
                }
            </div>
        </div>
        }
        else if (!_recording)
        {
            <div style="text-align:center;padding:40px 20px;color:#374151">
                <p style="font-size:2rem;margin-bottom:8px">🎙</p>
                <p>Ingen optagelser endnu</p>
                <p style="font-size:0.85rem;margin-top:4px">Tryk ⏺ Optag for at starte</p>
            </div>
        }

    </div><!-- /optag-controls -->

    <!-- RIGHT: Spilleguide while recording ─────────────── -->
    <div class="optag-lyrics">

        <!-- Chord detail panel (same shared state as Spilleguide) -->
        @if (_selectedChord is not null)
        {
            var detail = ChordDiagrams.Get(_selectedChord);
            <div class="chord-detail-panel">
                <div class="chord-detail-header">
                    <span class="chord-detail-name">@_selectedChord</span>
                    <button class="chord-detail-close" @onclick="DismissChord">✕</button>
                </div>
                @if (detail is not null)
                {
                    <div class="chord-detail-body">
                        <div>@((MarkupString)detail.Svg)</div>
                        @if (!string.IsNullOrEmpty(detail.ShapeLabel))
                        {
                            <div class="chord-shape-label">@detail.ShapeLabel</div>
                        }
                    </div>
                }
                @if (_selectedChordLoading)
                {
                    <p class="chord-detail-text" style="color:#6b7280">Henter tips...</p>
                }
                else if (!string.IsNullOrEmpty(_selectedChordInfo))
                {
                    <pre class="chord-detail-text">@_selectedChordInfo</pre>
                }
                <button class="btn-ghost-sm" style="margin-top:6px" @onclick="ShowChordTransition">
                    🔀 Overgang
                </button>
            </div>
        }

        <!-- Pattern bar -->
        @if (!string.IsNullOrWhiteSpace(_strumEdit) || !string.IsNullOrWhiteSpace(_fingerpickEdit))
        {
            <div class="perform-pattern-bar">
                @if (!string.IsNullOrWhiteSpace(_fingerpickEdit))
                {
                    <div>
                        <span class="pattern-label">Fingerpicking</span>
                        @((MarkupString)PatternRenderer.RenderFingerpick(_fingerpickEdit))
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_strumEdit))
                {
                    <div>
                        <span class="pattern-label">Strumming</span>
                        @((MarkupString)PatternRenderer.RenderStrum(_strumEdit))
                    </div>
                }
            </div>
        }

        <!-- Chord overview -->
        @if (HasAnyChords)
        {
            <div class="perform-chord-overview">
                @foreach (var line in EffectiveChordSource.Split('\n'))
                {
                    @if (!string.IsNullOrWhiteSpace(line))
                    {
                        <div class="perform-chord-row">
                            @foreach (var token in line.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                            {
                                @if (IsChord(token))
                                {
                                    var c = token;
                                    <button class="perform-chord-btn @(_selectedChord == c ? "perform-chord-btn--active" : "")"
                                            @onclick="() => SelectPerformChord(c)"
                                            title="Klik for greb og overgang">@c</button>
                                }
                                else
                                {
                                    <span class="perform-section-chip">@token.TrimEnd(':')</span>
                                }
                            }
                        </div>
                    }
                }
            </div>
        }

        <!-- Lyrics -->
        @if (HasInlineChords)
        {
            <div class="perform-sheet">
                @foreach (var line in _lyricsEdit.Split('\n'))
                {
                    @if (string.IsNullOrWhiteSpace(line))
                    {
                        <div class="perform-spacer"></div>
                    }
                    else if (IsSectionLabel(line))
                    {
                        <div class="perform-section-label">@line.Trim('[', ']', ':', ' ')</div>
                    }
                    else
                    {
                        <div class="perform-lyric-line">
                            @foreach (var seg in ParseLyricLine(line))
                            {
                                var segChord = seg.Chord;
                                <span class="perform-seg">
                                    @if (segChord is not null)
                                    {
                                        <button class="perform-chord-inline @(_selectedChord == segChord ? "perform-chord-inline--active" : "")"
                                                @onclick="() => SelectPerformChord(segChord)">@segChord</button>
                                    }
                                    else
                                    {
                                        <span class="perform-chord-inline" style="visibility:hidden">·</span>
                                    }
                                    <span class="perform-word">@seg.Text</span>
                                </span>
                            }
                        </div>
                    }
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_lyricsEdit))
        {
            <div class="perform-sheet">
                @foreach (var line in _lyricsEdit.Split('\n'))
                {
                    @if (string.IsNullOrWhiteSpace(line))
                    {
                        <div class="perform-spacer"></div>
                    }
                    else if (IsSectionLabel(line))
                    {
                        <div class="perform-section-label">@line.Trim('[', ']', ':', ' ')</div>
                    }
                    else
                    {
                        <div class="perform-plain-line">@line</div>
                    }
                }
            </div>
        }
        else
        {
            <div class="perform-empty">
                <p>Ingen tekst endnu</p>
                <button class="btn-ghost" @onclick='() => _tab = "forbered"'>← Gå til Forbered</button>
            </div>
        }

    </div><!-- /optag-lyrics -->

    </div><!-- /optag-layout -->
    </div><!-- /studio-record-tab -->
    }

    @if (_saveStatus is not null)
    {
        <div class="save-toast">@_saveStatus</div>
    }
</div>
}

<!-- ════ MODAL: Paste from Ultimate Guitar ════ -->
@if (_ugPasteOpen)
{
    <div class="photo-overlay">
        <div class="photo-panel">
            <div class="photo-header">
                <span>🎸 Indsæt fra Ultimate Guitar</span>
                <button class="photo-close" @onclick='() => { _ugPasteOpen = false; _ugPasteText = ""; }'>✕</button>
            </div>
            <p style="font-size:0.85rem;color:#aaa;margin:4px 0 8px">
                Kopiér hele tab-teksten fra Ultimate Guitar og indsæt herunder.
                AI udtrækker akkorder og tekst automatisk.
            </p>
            <textarea class="chord-editor" rows="14"
                      style="font-size:0.8rem"
                      placeholder="Indsæt UG-tab her..."
                      value="@_ugPasteText"
                      @oninput="e => _ugPasteText = e.Value?.ToString() ?? string.Empty"></textarea>
            <div class="photo-result-actions" style="margin-top:8px">
                <button class="btn-primary" @onclick="ParseUgTab"
                        disabled="@(_ugParsing || string.IsNullOrWhiteSpace(_ugPasteText))">
                    @(_ugParsing ? "Analyserer..." : "✓ Udtræk akkorder + tekst")
                </button>
                <button class="btn-ghost-sm" @onclick='() => { _ugPasteOpen = false; _ugPasteText = ""; }'>Annuller</button>
            </div>
        </div>
    </div>
}

<!-- ════ MODAL: Photo capture ════ -->
@if (_photoTarget is not null)
{
    <div class="photo-overlay">
        <div class="photo-panel">
            <div class="photo-header">
                <span>📷 Foto → @PhotoTargetLabel</span>
                <button class="photo-close" @onclick="ClosePhoto">✕</button>
            </div>

            @if (!_cameraOn)
            {
                <div class="photo-choose">
                    <button class="btn-primary" @onclick="OpenCamera">📷 Åbn kamera</button>
                    <label class="btn-ghost-file">
                        🖼 Vælg billede(r)
                        <InputFile OnChange="OnFileSelected" accept="image/*" multiple style="display:none" />
                    </label>
                </div>
            }
            else
            {
                <video id="photo-video" autoplay muted playsinline webkit-playsinline class="photo-video"></video>
                <div class="photo-cam-actions">
                    <button class="btn-capture" @onclick="CapturePhoto">🔵 Tag billede</button>
                    <button class="btn-ghost-sm" @onclick="CloseCamera">✕ Luk kamera</button>
                </div>
            }

            @if (_photoAnalyzing)
            {
                <div class="photo-analyzing">
                    <div class="spinner"></div>
                    <span>Claude analyserer...</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(_photoResult))
            {
                <div class="photo-result">
                    <div class="photo-result-label">Resultat (kan redigeres):</div>
                    <textarea class="photo-result-text" rows="8"
                              value="@_photoResult"
                              @oninput="e => _photoResult = e.Value?.ToString() ?? string.Empty"></textarea>
                    <div class="photo-result-actions">
                        <button class="btn-primary" @onclick="ApplyPhotoResult">✓ Brug dette</button>
                        <button class="btn-ghost-sm" @onclick="ClearPhotoResult">Ryd</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

