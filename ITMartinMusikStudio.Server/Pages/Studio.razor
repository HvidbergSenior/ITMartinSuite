    private void StartBeatTimer()
    {
        _beatTimer?.Stop(); _beatTimer?.Dispose();
        if (_song?.Tempo is not > 0) return;
        _beat = 0;
        _totalBeats = 1; // dot 1 is already "on" the instant the beat starts, before any tick
        var ms = (int)(60000.0 / PracticeBpm);
        _beatTimer = new System.Timers.Timer(ms) { AutoReset = true };
        _beatTimer.Elapsed += async (_, _) =>
        {
            if (_disposed) return;
            _beat = (_beat + 1) % 4;
            _totalBeats++;
            await InvokeAsync(StateHasChanged);
            var cur = CurrentLineIndex();
            if (cur >= 0 && cur != _followScrolledTo)
            {
                _followScrolledTo = cur;
                try { await JS.InvokeVoidAsync("studio.scrollLineIntoView", "line-" + cur); } catch { }
            }
        };
        _beatTimer.Start();
    }

    private void StopBeatTimer()
    {
        _beatTimer?.Stop(); _beatTimer?.Dispose();
        _beatTimer = null;
        _beat = -1;
    }

    // Lets the beat dot be turned on for practice, independent of recording -
    // previously it only ever ran while a take was actively being recorded.
    // _beatManual tracks "the user asked for this, don't auto-stop it" so
    // StopRecording doesn't kill a beat the user deliberately turned on.
    private void ToggleBeat()
    {
        if (_beat >= 0) { StopBeatTimer(); _beatManual = false; }
        else { StartBeatTimer(); _beatManual = true; }
    }

    public void Dispose()
    {
        _disposed = true;
        _voiceRef?.Dispose();
        _saveTimer?.Stop(); _saveTimer?.Dispose();
        _beatTimer?.Stop(); _beatTimer?.Dispose();
    }

    private async Task StartRecording()
    {
        // Enforced here (not just by hiding the button in the Optag tab) so
        // any other entry point (e.g. a future shortcut) can't slip past the take cap.
        // can't be used to slip past the take cap.
        if (_recordings.Count >= MaxTakes)
        {
            _saveStatus = $"{MaxTakes} optagelser nået — slet en for at optage mere.";
            return;
        }

        _recording = true;
        StartRecTimer();
        StartBeatTimer();
        try
        {
            await JS.InvokeVoidAsync("studio.startRecording", SongKey, _videoMode, _selectedSection);
        }
        catch (JSException ex)
        {
            _recTimer_t?.Stop();
            _recTimer_t?.Dispose();
            _recTimer = 0;
            _recording = false;
            _saveStatus = _videoMode
                ? "Ingen kamera fundet — prøv lydoptagelse i stedet"
                : $"Mikrofon fejl: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartRecTimer()
    {
        _recTimer = 0;
        _recTimer_t = new System.Timers.Timer(1000) { AutoReset = true };
        _recTimer_t.Elapsed += async (_, _) =>
        {
            // Runs on a raw ThreadPool thread, outside Blazor's circuit dispatch -
            // an unhandled exception here (e.g. JSDisconnectedException after the
            // browser tab closes mid-recording) crashes the whole server process,
            // not just this circuit. Must not let anything escape this handler.
            try
            {
                _recTimer++;
                await InvokeAsync(StateHasChanged);
                if (_recTimer >= 600)
                    await InvokeAsync(StopRecording);
            }
            catch (Exception)
            {
                _recTimer_t?.Stop();
            }
        };
        _recTimer_t.Start();
    }

    private async Task StartOverdubRecording()
    {
        var latest = _recordings.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
        if (latest is null) { await StartRecording(); return; }
        await StartOverdubFromUrl($"/stream?path={Uri.EscapeDataString(latest.RelativePath)}");
    }

