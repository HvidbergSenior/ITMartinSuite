    protected override async Task OnInitializedAsync()
    {
        var existing = await Db.Songs.FirstOrDefaultAsync(s => s.Key == SongKey);
        if (existing is not null)
        {
            _song = existing;
        }
        else
        {
            var sourceFile = FileParam ?? "";
            _song = new StudioSong
            {
                Key        = SongKey,
                Title      = ToTitle(SongKey),
                SourceFile = sourceFile,
            };
            Db.Songs.Add(_song);
            await Db.SaveChangesAsync();
        }

        _chordEdit       = _song.ChordChart;
        _lyricsEdit      = _song.Lyrics;
        _notesEdit       = _song.Notes;
        _fingerpickEdit  = _song.FingerpickPattern;
        _strumEdit       = _song.StrumPattern;
        _loading         = false;

        // Sync chord chart from inline lyrics chords (catches chords added since last save)
        var prevChords = _chordEdit;
        SyncChordsFromLyrics();
        if (_chordEdit != prevChords)
            AutoSave();

        _recordings = Library.GetRecordings(SongKey);
    }

    private static string FormatRecTime(int seconds) =>
        $"{seconds / 60}:{seconds % 60:D2}";

    private static string ToTitle(string key) =>
        string.Join(" ",
            key.Replace("_", " ").Replace("-", " ")
               .Split(' ', StringSplitOptions.RemoveEmptyEntries)
               .Select(w => w.Length > 0 ? char.ToUpper(w[0]) + w[1..] : w));

    // ── Auto-save ──────────────────────────────────────────────────────────────

    private void AutoSave()
    {
        if (_song is null) return;
        _song.ChordChart        = _chordEdit;
        _song.Lyrics            = _lyricsEdit;
        _song.Notes             = _notesEdit;
        _song.FingerpickPattern = _fingerpickEdit;
        _song.StrumPattern      = _strumEdit;

        _saveTimer?.Dispose();
        _saveTimer = new System.Timers.Timer(1200) { AutoReset = false };
        _saveTimer.Elapsed += async (_, _) =>
        {
            if (_disposed) return;
            _song.UpdatedAt = DateTime.UtcNow;
            try { await Db.SaveChangesAsync(); } catch { return; }
            if (_disposed) return;
            _saveStatus = "Gemt ✓";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1500);
            if (_disposed) return;
            _saveStatus = null;
            await InvokeAsync(StateHasChanged);
        };
        _saveTimer.Start();
    }

