    private async Task TranscribeNotes()
    {
        if (_song is null || string.IsNullOrEmpty(_song.SourceFile)) return;
        _noteRunning = true;
        _noteElapsed = 0;
        _noteMidPath = null;

        _noteTimer_t?.Dispose();
        _noteTimer_t = new System.Timers.Timer(1000) { AutoReset = true };
        _noteTimer_t.Elapsed += async (_, _) => { _noteElapsed++; await InvokeAsync(StateHasChanged); };
        _noteTimer_t.Start();
        StateHasChanged();

        try
        {
            var inputPath = Library.Resolve(_song.SourceFile);
            var outputPath = Path.Combine(Library.Root, "transcriptions", $"{SongKey}.mid");
            var countStr = await PianoTranscribe.TranscribeAsync(inputPath, outputPath);
            _noteCount = int.TryParse(countStr, out var n) ? n : 0;
            _noteMidPath = outputPath;
        }
        catch (Exception ex)
        {
            _saveStatus = $"Node-transskription fejl: {ex.Message}";
        }
        finally
        {
            _noteTimer_t?.Stop();
            _noteTimer_t?.Dispose();
            _noteRunning = false;
            StateHasChanged();
        }
    }

    // ── UG tab parser ─────────────────────────────────────────────────────────

    private async Task ParseUgTab()
    {
        if (string.IsNullOrWhiteSpace(_ugPasteText)) return;
        _ugParsing = true;
        _saveStatus = null;
        StateHasChanged();
        try
        {
            // Chords only - lyrics stay sourced from lrclib.net (LyricsService),
            // which gives synced timing UG's plain tab text never has. Taking UG's
            // lyrics here would silently overwrite a better, already-synced version.
            var result = await ChordAi.ParseUltimateGuitarTabAsync(_ugPasteText);
            if (string.IsNullOrEmpty(result.Chords))
            {
                _saveStatus = "Ingen akkorder fundet i den indsatte tekst.";
            }
            else
            {
                _chordEdit = result.Chords; SyncEditorsToDom();

                // Prefer placing chords onto the FIXED lrclib lyrics (correct
                // words, correct version) using the pasted tab only to learn
                // chord positions - AI is genuinely useful for that alignment
                // judgment (line breaks/phrasing won't match exactly, and not
                // every word carries a chord). But word-fidelity alone doesn't
                // prove the POSITION is right (same gap AiAnnotateChords had -
                // see its review-candidate flow), so a passing candidate goes
                // through that same review step instead of committing directly.
                // Only the purely mechanical fallback (no AI judgment call,
                // can't misplace anything) applies immediately.
                var target = StripChordMarkers(_lyricsEdit);
                var aiSkipped = false;
                string? candidate = null;
                if (!string.IsNullOrWhiteSpace(target))
                {
                    try
                    {
                        var raw = await ChordAi.PlaceChordsFromTabAsync(target, _ugPasteText);
                        if (!string.IsNullOrWhiteSpace(raw) && PreservesWords(target, raw))
                            candidate = raw;
                    }
                    catch (Exception)
                    {
                        // Anthropic's own API can legitimately refuse this call
                        // outright (400 content-filtering) for a well-known
                        // copyrighted song's lyrics, separate from the
                        // word-preservation check above ever running at all.
                        // Either way the mechanical merge below is the correct
                        // fallback - it never sends lyrics to any AI, so it
                        // can't be blocked the same way.
                        aiSkipped = true;
                    }
                }

                if (candidate is not null)
                {
                    _annotateCandidate = candidate;
                }
                else
                {
                    _lyricsEdit = MergeTabToInlineChords(_ugPasteText); SyncEditorsToDom();
                    if (!string.IsNullOrWhiteSpace(target))
                    {
                        _saveStatus = aiSkipped
                            ? "AI kunne ikke behandle teksten (sandsynligvis en kendt sang) - brugte akkorderne fra din indsatte tab i stedet."
                            : "AI-placering afvist (ændrede ord) - brugte akkorderne fra din indsatte tab i stedet.";
                    }
                }

                AutoSave();
            }
        }
        catch (Exception ex)
        {
            _saveStatus = $"AI fejl: {ex.Message}";
        }
        _ugParsing   = false;
        _ugPasteOpen = false;
        _ugPasteText = ""; SyncEditorsToDom();
    }

    // ── Toneart / Key finder ──────────────────────────────────────────────────

    private async Task AiToneart()
    {
        if (_song is null) return;
        _aiHelperLoading = true;
        _aiHelperResult = "";
        _aiHelperResult = await ChordAi.GetKeyForVoiceAsync(_song.Title, _song.MusicKey, _lyricsEdit);
        _aiHelperLoading = false;
    }

    // ── Chord transitions ─────────────────────────────────────────────────────

    private async Task AiOvergang()
    {
        if (_song is null) return;
        _aiHelperLoading = true;
        _aiHelperResult = "";
        var chart = string.IsNullOrWhiteSpace(_chordEdit) ? ExtractChordsFromLyrics() : _chordEdit;
        _aiHelperResult = await ChordAi.GetChordTransitionsAsync(chart, _song.MusicKey);
        _aiHelperLoading = false;
    }

    // True when the chord chart looks like a raw bar/line dump from photo
    // extraction ("6: F#m") rather than a section chart ("Verse: Am G F") -
    // that numbered shape is what ConvertChordChartToSections offers to clean up.
    private bool _chordChartIsNumbered =>
        System.Text.RegularExpressions.Regex.IsMatch(
            (_chordEdit ?? "").TrimStart(), @"^\d+\s*:");

    private bool _convertingChart;

    private async Task ConvertChordChartToSections()
    {
        if (_song is null || string.IsNullOrWhiteSpace(_chordEdit) || _convertingChart) return;
        _convertingChart = true;
        StateHasChanged();
        try
        {
            var result = await ChordAi.ConvertNumberedChartToSectionsAsync(_chordEdit, _lyricsEdit, _song.MusicKey);
            if (!string.IsNullOrWhiteSpace(result))
            {
                _chordEdit = result; SyncEditorsToDom();
                AutoSave();
            }
        }
        catch (Exception ex)
        {
            _saveStatus = $"AI fejl: {ex.Message}";
        }
        finally
        {
            _convertingChart = false;
        }
    }

    // Same whole-line-bracket-tag gap as everywhere else that scans for
    // [Chord] markers: without excluding structure lines, a bracketed tag
    // starting with a chord-root letter ("[Bro]") gets pulled in as a fake
    // "Bro" chord - visible here in the AI helper prompts and the
    // UniqueChordsInOrder "book view" whenever Akkorder is still empty.
    private string ExtractChordsFromLyrics() =>
        string.Join(" ", (_lyricsEdit ?? "").Split('\n')
            .Where(line => !IsWholeLineBracketTag(line.Trim()))
            .SelectMany(line => System.Text.RegularExpressions.Regex
                .Matches(line, @"\[([A-G][^\]]*)\]")
                .Select(m => m.Groups[1].Value))
            .Distinct());

    private void SyncChordsFromLyrics()
    {
        if (!HasInlineChords) return;
        // Once Akkorder has ANY content - typed by hand, pasted, or
        // auto-generated earlier - it's the user's field from then on. This
        // used to regenerate unconditionally on every lyrics keystroke AND on
        // every page load (see OnInitializedAsync), which silently reverted
        // manual corrections back to the auto-derived chart - a real, reported
        // bug: hand-fixing a bad PDF-sourced chord chart kept reappearing
        // wrong. Only auto-fill while the field is still genuinely empty (a
        // brand new song); clearing it out is the escape hatch to force a
        // fresh regenerate.
        if (!string.IsNullOrWhiteSpace(_chordEdit)) return;
        var rx = new System.Text.RegularExpressions.Regex(@"\[([A-G][^\]]*)\]");
        var lines = new List<string>();
        string? currentSection = null;
        var sectionChords = new List<string>();

        foreach (var rawLine in _lyricsEdit.Split('\n'))
        {
            if (IsSectionLabel(rawLine))
            {
                if (sectionChords.Count > 0)
                    lines.Add((currentSection is not null ? currentSection + ": " : "") + string.Join(" ", sectionChords));
                currentSection = rawLine.Trim('[', ']', ':', ' ');
                sectionChords = [];
            }
            else
            {
                foreach (System.Text.RegularExpressions.Match m in rx.Matches(rawLine))
                {
                    var chord = m.Groups[1].Value;
                    if (!sectionChords.Contains(chord))
                        sectionChords.Add(chord);
                }
            }
        }
        if (sectionChords.Count > 0)
            lines.Add((currentSection is not null ? currentSection + ": " : "") + string.Join(" ", sectionChords));

        var synced = string.Join("\n", lines);
        if (!string.IsNullOrWhiteSpace(synced))
            _chordEdit = synced; _chordDom = synced; // only the chord box - the lyrics box is being typed in right now
    }

    // ── Chord annotation ──────────────────────────────────────────────────────

    private string? _annotateCandidate;

    private async Task AiAnnotateChords()
    {
        if (_song is null || string.IsNullOrWhiteSpace(_lyricsEdit)) return;
        _annotatingChords = true;
        _annotateCandidate = null;
        StateHasChanged();
        try
        {
            var original = _lyricsEdit;
            var result = await ChordAi.AnnotateLyricsWithChordsAsync(
                _lyricsEdit, _chordEdit, _song.MusicKey, _song.Title, _song.Artist);
            if (string.IsNullOrWhiteSpace(result))
            {
                // no-op
            }
            else if (!PreservesWords(original, result))
            {
                _saveStatus = "AI ændrede ordene i teksten - ignoreret for at undgå forkert tekst.";
            }
            else
            {
                // Word-fidelity passing only proves the AI kept the right
                // words - it says nothing about whether it put the [Chord]
                // markers on the right ONES. Placement is a judgment call the
                // model can get wrong (confirmed: a PDF-sourced chord chart
                // produced a bad placement that kept reappearing until this
                // review step existed), so the candidate waits for an
                // explicit accept instead of overwriting the lyrics directly.
                _annotateCandidate = result;
            }
        }
        catch (Exception ex)
        {
            _saveStatus = $"AI fejl: {ex.Message}";
        }
        finally
        {
            _annotatingChords = false;
        }
    }

    private void AcceptAnnotateCandidate()
    {
        if (_annotateCandidate is null) return;
        _lyricsEdit = _annotateCandidate; SyncEditorsToDom();
        _annotateCandidate = null;
        AutoSave();
    }

    private void DiscardAnnotateCandidate() => _annotateCandidate = null;

    // ── Simplify chords ───────────────────────────────────────────────────────

    private static readonly System.Text.RegularExpressions.Regex SlashChordRegex = new(
        @"([A-G][#b]?(?:maj|min|m|dim|aug|sus\d?|add\d|M|\d)*)/[A-G][#b]?");

    private void SimplifyChords()
    {
        _chordEdit = SlashChordRegex.Replace(_chordEdit, m => m.Groups[1].Value); SyncEditorsToDom();

        // Akkorder and Tekst/Lyrics store chords in two different formats
        // (plain "Am G F" vs inline "[Am]word") - the plain-text regex above
        // never matches inside [brackets], so slash chords in the lyrics view
        // were silently left untouched. Same fix shape as the transpose bug.
        // Whole-line bracket tags ("[Bro]") are skipped, same as everywhere
        // else that scans this pattern - harmless today since no section tag
        // contains a literal "/", but skipping keeps that guaranteed rather
        // than incidental.
        var chordRx = new System.Text.RegularExpressions.Regex(@"\[([A-G][^\]]*)\]");
        var lyricLines = _lyricsEdit.Split('\n');
        for (var i = 0; i < lyricLines.Length; i++)
        {
            if (IsWholeLineBracketTag(lyricLines[i].Trim())) continue;
            lyricLines[i] = chordRx.Replace(lyricLines[i],
                m => "[" + SlashChordRegex.Replace(m.Groups[1].Value, mm => mm.Groups[1].Value) + "]");
        }
        _lyricsEdit = string.Join('\n', lyricLines); SyncEditorsToDom();

        AutoSave();
        StateHasChanged();
    }

    // ── Perform chord tap ─────────────────────────────────────────────────────

    private void DismissChord() { _selectedChord = null; _selectedChordInfo = ""; }

    private async Task SelectPerformChord(string chord)
    {
        if (_selectedChord == chord)
        {
            _selectedChord = null;
            _selectedChordInfo = "";
            return;
        }
        _selectedChord = chord;
        _selectedChordInfo = "";
        _selectedChordLoading = true;
        StateHasChanged();
        _selectedChordInfo = await ChordAi.GetChordFingeringAsync(chord);
        _selectedChordLoading = false;
        StateHasChanged();
    }

    private async Task ShowChordTransition()
    {
        if (_selectedChord is null) return;
        _selectedChordLoading = true;
        StateHasChanged();
        var chart = string.IsNullOrWhiteSpace(_chordEdit) ? ExtractChordsFromLyrics() : _chordEdit;
        _selectedChordInfo = await ChordAi.GetChordTransitionsAsync(chart, _song?.MusicKey ?? "C");
        _selectedChordLoading = false;
        StateHasChanged();
    }

    // ── Chord+lyrics renderer ─────────────────────────────────────────────────

    private bool HasInlineChords =>
        !string.IsNullOrWhiteSpace(_lyricsEdit) &&
        System.Text.RegularExpressions.Regex.IsMatch(_lyricsEdit, @"\[[A-G][^\]]*\]");

    private string EffectiveChordSource =>
        string.IsNullOrWhiteSpace(_chordEdit) ? ExtractChordsFromLyrics() : _chordEdit;

    private bool HasAnyChords =>
        !string.IsNullOrWhiteSpace(_chordEdit) || HasInlineChords;

    // Every distinct chord in the song's progression, first-appearance order -
    // the "book" view: all the different ways to play the whole pattern at a
    // glance, instead of tapping through chords one at a time.
    private List<string> UniqueChordsInOrder =>
        EffectiveChordSource.Split('\n')
            .SelectMany(line => line.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            .Where(IsChord)
            .Distinct()
            .ToList();

    // A bracketed single word ("[Bro]", "[Chorus]") is genuinely ambiguous
    // with an inline chord marker ("[Am]") whenever its first letter happens
    // to be a valid chord root - which "Bro" (Danish for Bridge), "Chorus"
    // and "Bridge" itself all are. Resolve the ambiguity against the app's
    // own documented section vocabulary before falling back to the
    // first-letter guess, so a correctly-typed "[Bro]" isn't swallowed into
    // the chord list as a fake chord named "Bro".
    private static readonly HashSet<string> KnownSectionWords = new(StringComparer.OrdinalIgnoreCase)
    {
        "verse", "vers", "chorus", "omkvæd", "refræn", "bridge", "bro",
        "intro", "outro", "instrumental", "vocal", "hook", "headline", "comment"
    };

    // Recording one section ("Vers 2"): the sheet shows just that section, so the
    // words start where the take starts instead of at Vers 1. "Hele sangen" shows all.
    private bool InSelectedSection(string[] lines, int lineIndex)
    {
        if (_selectedSection is null) return true;
        string? current = null;
        for (var i = 0; i <= lineIndex && i < lines.Length; i++)
            if (IsSectionLabel(lines[i])) current = lines[i].Trim().Trim('[', ']', ':').Trim();
        return string.Equals(current, _selectedSection, StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsSectionLabel(string line)
    {
        var t = line.Trim();
        if (t.EndsWith(':') && !System.Text.RegularExpressions.Regex.IsMatch(t, @"\[[A-G]")) return true;
        if (!t.StartsWith('[')) return false;
        var inner = t.TrimStart('[').Split(']')[0];
        if (inner.Contains(' ') || inner.Length == 0) return true;
        var word = System.Text.RegularExpressions.Regex.Match(inner, @"^[A-Za-zÆØÅæøå-]+").Value;
        if (KnownSectionWords.Contains(word)) return true;
        return inner[0] is < 'A' or > 'G';
    }

    private IEnumerable<(string? Chord, string Text)> ParseLyricLine(string line)
    {
        var result = new List<(string?, string)>();
        var rx = new System.Text.RegularExpressions.Regex(@"\[([A-G][^\]]*)\]([^\[]*)");
        int last = 0;
        foreach (System.Text.RegularExpressions.Match m in rx.Matches(line))
        {
            if (m.Index > last) result.Add((null, line[last..m.Index]));
            result.Add((m.Groups[1].Value, m.Groups[2].Value));
            last = m.Index + m.Length;
        }
        if (last < line.Length) result.Add((null, line[last..]));
        if (!result.Any()) result.Add((null, line));
        return result;
    }
}
