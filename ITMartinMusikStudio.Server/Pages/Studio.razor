    // ── Transpose ─────────────────────────────────────────────────────────────

    private void AdjustT(int d)
    {
        if (d == 0 || _song is null) return;
        _lyricsEdit    = TransposeChordsInText(_lyricsEdit, d);
        _chordEdit     = TransposeChordChart(_chordEdit, d);
        _song.MusicKey = TransposeNote(_song.MusicKey, d);
        AutoSave();
    }

    private static readonly string[] Notes = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"];
    private static readonly string[] NotesFlat = ["C","Db","D","Eb","E","F","Gb","G","Ab","A","Bb","B"];

    private static string TransposeNote(string chord, int semitones)
    {
        if (semitones == 0 || string.IsNullOrEmpty(chord)) return chord;
        int rootLen = chord.Length > 1 && chord[1] is '#' or 'b' ? 2 : 1;
        var root   = chord[..rootLen];
        var suffix = chord[rootLen..];
        var idx = Array.IndexOf(Notes, root);
        if (idx < 0) idx = Array.IndexOf(NotesFlat, root);
        if (idx < 0) return chord;
        var newIdx = ((idx + semitones) % 12 + 12) % 12;
        return Notes[newIdx] + suffix;
    }

    private static string TransposeChordsInText(string text, int semitones)
    {
        if (string.IsNullOrEmpty(text) || semitones == 0) return text;
        return System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\[([A-G][^\]]*)\]",
            m => "[" + TransposeNote(m.Groups[1].Value, semitones) + "]");
    }

    private static bool IsChord(string token)
    {
        if (string.IsNullOrWhiteSpace(token) || token.EndsWith(':')) return false;
        var root = token.TrimEnd('m', '7', '9', 'j', 'a', 's', 'u', '+', 'd', 'i', '/', '2', '4', '5', '6');
        return Notes.Contains(root) || NotesFlat.Contains(root);
    }

    // Akkorder's chart is plain "Verse: D A/D Bm A G" - no [brackets] like the
    // inline-lyrics format, so TransposeChordsInText's regex never matches it.
    // Transpose each whitespace-separated token instead, leaving section
    // labels ("Verse:") alone and transposing both sides of a slash chord.
    private static string TransposeChordChart(string chart, int semitones)
    {
        if (string.IsNullOrEmpty(chart) || semitones == 0) return chart;

        var lines = chart.Split('\n');
        for (var i = 0; i < lines.Length; i++)
        {
            var colonIdx = lines[i].IndexOf(':');
            var label = colonIdx >= 0 ? lines[i][..(colonIdx + 1)] : "";
            var rest = colonIdx >= 0 ? lines[i][(colonIdx + 1)..] : lines[i];

            var tokens = rest.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(token => token.Contains('/')
                    ? string.Join("/", token.Split('/').Select(p => IsChord(p) ? TransposeNote(p, semitones) : p))
                    : IsChord(token) ? TransposeNote(token, semitones) : token);

            lines[i] = label + (label.Length > 0 ? " " : "") + string.Join(" ", tokens);
        }
        return string.Join('\n', lines);
    }

    // ── Mechanical UG tab → inline chords (no AI) ───────────────────────────
    // A standard tab has a chord-only line positioned directly above the lyric
    // line it applies to, chords aligned by column to the syllable they land
    // on. Converting this to [Chord]word format is a pure text-layout problem -
    // doing it as a regex/string transform instead of an AI completion means
    // the lyric text passes through completely untouched (no paraphrasing risk)
    // and every chord's exact column position is preserved (no dropped
    // mid-line changes), which is the AI route's two failure modes.
    private static string MergeTabToInlineChords(string rawTab)
    {
        if (string.IsNullOrWhiteSpace(rawTab)) return "";

        var lines = rawTab.Replace("\r\n", "\n").Split('\n');
        var output = new List<string>();

        for (var i = 0; i < lines.Length; i++)
        {
            var line = lines[i];
            if (IsChordOnlyLine(line) && i + 1 < lines.Length && !string.IsNullOrWhiteSpace(lines[i + 1]) && !IsChordOnlyLine(lines[i + 1]))
            {
                output.Add(MergeChordLineIntoLyricLine(line, lines[i + 1]));
                i++; // the lyric line is now consumed
            }
            else if (IsChordOnlyLine(line))
            {
                // Chord line with nothing to attach to (e.g. an instrumental
                // break) - keep the chords visible as a bracketed list.
                var chords = System.Text.RegularExpressions.Regex.Matches(line, @"\S+").Select(m => "[" + m.Value + "]");
                output.Add(string.Concat(chords));
            }
            else
            {
                output.Add(line);
            }
        }
        return string.Join('\n', output);
    }

    private static bool IsChordOnlyLine(string line)
    {
        var tokens = line.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return tokens.Length > 0 && tokens.All(IsChordToken);
    }

    private static bool IsChordToken(string token) =>
        token.Contains('/') ? token.Split('/').All(IsChord) : IsChord(token);

    private static string MergeChordLineIntoLyricLine(string chordLine, string lyricLine)
    {
        var matches = System.Text.RegularExpressions.Regex.Matches(chordLine, @"\S+");
        var sb = new System.Text.StringBuilder(lyricLine);
        // Insert right-to-left so earlier column positions stay valid as later
        // insertions lengthen the string.
        foreach (var m in matches.Cast<System.Text.RegularExpressions.Match>().OrderByDescending(m => m.Index))
        {
            var col = Math.Min(m.Index, sb.Length);
            sb.Insert(col, "[" + m.Value + "]");
        }
        return sb.ToString();
    }

    // ── Word-fidelity check for AI chord placement ──────────────────────────
    // Any AI step that's supposed to only ADD chord markers to existing words
    // must be verified afterward, not trusted - the model can still quietly
    // alter wording. Strip markers back out and compare against the original;
    // whitespace/case differences are tolerated, but any real word change
    // fails the check and the AI's output must be discarded.

    private static string StripChordMarkers(string text) =>
        System.Text.RegularExpressions.Regex.Replace(text ?? "", @"\[[^\]]*\]", "");

    private static string NormalizeForCompare(string text) =>
        System.Text.RegularExpressions.Regex.Replace((text ?? "").ToLowerInvariant(), @"\s+", " ").Trim();

    private static bool PreservesWords(string original, string candidateWithMarkers) =>
        NormalizeForCompare(original) == NormalizeForCompare(StripChordMarkers(candidateWithMarkers));

    // Unlike the removed pure-guess AI chords button (Claude recalling a known
    // song by name/lyrics with nothing to check it against - always a risk of
    // being wrong, so it was dropped entirely), this
    // actually listens to the source file - the only option for a private
    // Suno original Claude has never heard. Template-matching, not a trained
    // model, so treat the result as a starting guess to correct by ear, same
    // spirit as the AI chord suggestion.
    private async Task DetectChordsFromAudio()
    {
        if (_song is null || string.IsNullOrEmpty(_song.SourceFile)) return;
        _chordDetecting = true;
        StateHasChanged();
        try
        {
            var inputPath = Path.GetFullPath(Path.Combine(Library.Root, _song.SourceFile));
            var segments = await ChordDetectSvc.DetectAsync(inputPath);
            if (segments.Count > 0)
            {
                _chordEdit = "# Automatisk fundet fra lyd - tjek/ret efter øre\n" + ChordDetectionService.FormatAsChordChart(segments);
                AutoSave();
            }
            else
            {
                _saveStatus = "Kunne ikke finde tydelige akkorder i lydfilen.";
            }
        }
        catch (Exception ex)
        {
            _saveStatus = $"Akkordgenkendelse fejl: {ex.Message}";
        }
        finally
        {
            _chordDetecting = false;
            StateHasChanged();
        }
    }

    // ── Recording ─────────────────────────────────────────────────────────────

    private void StartBeatTimer()
    {
        _beatTimer?.Stop(); _beatTimer?.Dispose();
        if (_song?.Tempo is not > 0) return;
        _beat = 0;
        var ms = (int)(60000.0 / _song.Tempo.Value);
        _beatTimer = new System.Timers.Timer(ms) { AutoReset = true };
        _beatTimer.Elapsed += async (_, _) =>
        {
            if (_disposed) return;
            _beat = (_beat + 1) % 4;
            await InvokeAsync(StateHasChanged);
        };
        _beatTimer.Start();
    }

    private void StopBeatTimer()
    {
        _beatTimer?.Stop(); _beatTimer?.Dispose();
        _beatTimer = null;
        _beat = -1;
    }

    public void Dispose()
    {
        _disposed = true;
        _saveTimer?.Stop(); _saveTimer?.Dispose();
        _beatTimer?.Stop(); _beatTimer?.Dispose();
    }

    private async Task StartRecording()
    {
        // Enforced here (not just by hiding the button in the Optag tab) so
        // the "Øv & Spil" tab's own record button - a separate entry point -
        // can't be used to slip past the take cap.
        if (_recordings.Count >= MaxTakes)
        {
            _saveStatus = $"{MaxTakes} optagelser nået — slet en for at optage mere.";
            return;
        }

        _recording = true;
        StartRecTimer();
        StartBeatTimer();
        try
        {
            await JS.InvokeVoidAsync("studio.startRecording", SongKey, _videoMode);
        }
        catch (JSException ex)
        {
            _recTimer_t?.Stop();
            _recTimer_t?.Dispose();
            _recTimer = 0;
            _recording = false;
            _saveStatus = _videoMode
                ? "Ingen kamera fundet — prøv lydoptagelse i stedet"
                : $"Mikrofon fejl: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartRecTimer()
    {
        _recTimer = 0;
        _recTimer_t = new System.Timers.Timer(1000) { AutoReset = true };
        _recTimer_t.Elapsed += async (_, _) =>
        {
            _recTimer++;
            await InvokeAsync(StateHasChanged);
            if (_recTimer >= 600)
                await InvokeAsync(StopRecording);
        };
        _recTimer_t.Start();
    }

    private async Task StartOverdubRecording()
    {
        var latest = _recordings.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
        if (latest is null) { await StartRecording(); return; }
        await StartOverdubFromUrl($"/stream?path={Uri.EscapeDataString(latest.RelativePath)}");
    }

    private async Task StartOverdubFromUrl(string playUrl)
    {
        if (_recordings.Count >= MaxTakes)
        {
            _saveStatus = $"{MaxTakes} optagelser nået — slet en for at optage mere.";
            return;
        }

        _recording = true;
        StartRecTimer();
        StartBeatTimer();
        try
        {
            await JS.InvokeVoidAsync("studio.startOverdub", SongKey, playUrl, _videoMode);
        }
        catch (JSException ex)
        {
            _recTimer_t?.Stop();
            _recTimer_t?.Dispose();
            _recTimer = 0;
            _recording = false;
            _saveStatus = $"Mikrofon fejl: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    // Spotify equivalent of StartOverdubFromUrl - Spotify plays through its own
    // Web Playback SDK (spotifyPlayer.js), a completely separate audio path
    // from studio.js's local-file mix/overdub, so it needs its own trigger
    // that starts Spotify playback and the mic recording together.
    private async Task StartRecordingWithSpotify()
    {
        if (_song?.SpotifyTrackId is null) return;
        if (_recordings.Count >= MaxTakes)
        {
            _saveStatus = $"{MaxTakes} optagelser nået — slet en for at optage mere.";
