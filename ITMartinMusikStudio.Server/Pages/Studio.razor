    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(20);
        if (files.Count == 0) return;

        _photoAnalyzing = true;
        _photoResult = ""; SyncEditorsToDom();
        StateHasChanged();

        foreach (var file in files)
        {
            try
            {
                using var ms = new MemoryStream();
                await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                // Some browsers/pickers report an empty or generic ContentType
                // (e.g. "application/octet-stream") for a perfectly normal
                // PNG - forcing that case to "image/jpeg" mislabels the bytes
                // and Claude's API rejects the mismatch with "Could not
                // process image", so fall back to the file extension instead.
                var mime = file.ContentType.StartsWith("image/") || file.ContentType == "application/pdf"
                    ? file.ContentType
                    : GuessImageMime(file.Name);

                var result = _photoTarget == "chords"
                    ? await ChordAi.ExtractChordsFromImageAsync(base64, mime)
                    : await ChordAi.ExtractTextFromImageAsync(base64, mime, lyricsOnly: _photoTarget == "lyrics");

                _photoResult = _photoTarget == "chords"
                    ? MergeNumberedChords(_photoResult, result)
                    : string.IsNullOrWhiteSpace(_photoResult) ? result : _photoResult + "\n\n" + result;
            }
            catch (Exception ex)
            {
                _photoResult += (string.IsNullOrWhiteSpace(_photoResult) ? "" : "\n\n") + $"Fejl: {ex.Message}";
            }
        }

        _photoAnalyzing = false;
        StateHasChanged();
    }

    private static string GuessImageMime(string fileName) => System.IO.Path.GetExtension(fileName).ToLowerInvariant() switch
    {
        ".png" => "image/png",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        ".heic" or ".heif" => "image/heic",
        ".pdf" => "application/pdf",
        _ => "image/jpeg"
    };

    private async Task AnalyzePhoto(string base64, string mime)
    {
        _photoAnalyzing = true;
        _photoResult = ""; SyncEditorsToDom();
        StateHasChanged();
        try
        {
            string result;
            if (_photoTarget == "chords")
                result = await ChordAi.ExtractChordsFromImageAsync(base64, mime);
            else
                result = await ChordAi.ExtractTextFromImageAsync(base64, mime, lyricsOnly: _photoTarget == "lyrics");
            _photoResult = result; SyncEditorsToDom();
        }
        catch (Exception ex)
        {
            _photoResult = $"Fejl: {ex.Message}"; SyncEditorsToDom();
        }
        finally
        {
            _photoAnalyzing = false;
        }
    }

    private void ApplyPhotoResult()
    {
        if (string.IsNullOrEmpty(_photoResult)) return;
        switch (_photoTarget)
        {
            case "lyrics":
                _lyricsEdit = string.IsNullOrWhiteSpace(_lyricsEdit) ? _photoResult : _lyricsEdit + "\n\n" + _photoResult; SyncEditorsToDom();
                break;
            case "chords":
                _chordEdit = MergeNumberedChords(_chordEdit, _photoResult); SyncEditorsToDom();
                break;
            case "notes":
                _notesEdit = string.IsNullOrWhiteSpace(_notesEdit) ? _photoResult : _notesEdit + "\n\n" + _photoResult; SyncEditorsToDom();
                break;
        }
        AutoSave();
        ClosePhoto();
    }

    private void ClearPhotoResult() { _photoResult = string.Empty; SyncEditorsToDom(); }

    // Merges a numbered bar/line chord result ("6: F#m") into the existing chord chart by number,
    // so screenshots can be uploaded in any order and overlapping bars just overwrite instead of duplicating.
    // Falls back to a plain append when either side isn't in numbered format.
    private static string MergeNumberedChords(string existing, string incoming)
    {
        var numberedLine = new System.Text.RegularExpressions.Regex(@"^(\d+):\s*(.+)$");
        var incomingNumbered = new SortedDictionary<int, string>();
        foreach (var line in incoming.Split('\n'))
        {
            var m = numberedLine.Match(line.Trim());
            if (m.Success) incomingNumbered[int.Parse(m.Groups[1].Value)] = m.Groups[2].Value;
        }

        if (incomingNumbered.Count == 0)
            return string.IsNullOrWhiteSpace(existing) ? incoming : existing + "\n\n" + incoming;

        var merged = new SortedDictionary<int, string>();
        var existingHasNumbered = false;
        foreach (var line in existing.Split('\n'))
        {
            var m = numberedLine.Match(line.Trim());
            if (m.Success) { merged[int.Parse(m.Groups[1].Value)] = m.Groups[2].Value; existingHasNumbered = true; }
        }

        // Existing content isn't itself in numbered-bar format (empty, or a
        // section-based chart like "Verse: Am G F C") - a bar-number merge
        // only makes sense against other bar numbers. Without this check,
        // photographing one more page of a numbered chart after the chart had
        // already been cleaned up into sections would silently DISCARD the
        // entire existing chart, keeping only the new photo's bars - a real,
        // confirmed data-loss bug, not hypothetical.
        if (!existingHasNumbered)
            return string.IsNullOrWhiteSpace(existing) ? incoming : existing + "\n\n" + incoming;

        foreach (var (bar, chord) in incomingNumbered) merged[bar] = chord;

        return string.Join('\n', merged.Select(kv => $"{kv.Key}: {kv.Value}"));
    }

