    // Plain "slug=seconds;slug=seconds" pairs on _song.SectionTimings - see
    // the field's own doc comment for why this isn't JSON.
    private Dictionary<string, double> ParseSectionTimings()
    {
        var result = new Dictionary<string, double>();
        if (string.IsNullOrWhiteSpace(_song?.SectionTimings)) return result;
        foreach (var pair in _song.SectionTimings.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && double.TryParse(parts[1], System.Globalization.CultureInfo.InvariantCulture, out var seconds))
                result[parts[0]] = seconds;
        }
        return result;
    }

    private double? GetSectionStart(string slug) =>
        ParseSectionTimings().TryGetValue(slug, out var seconds) ? seconds : null;

    private void SetSectionStart(string slug, double seconds)
    {
        var timings = ParseSectionTimings();
        timings[slug] = seconds;
        _song!.SectionTimings = string.Join(';', timings.Select(kv => $"{kv.Key}={kv.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}"));
        AutoSave();
    }

    private void ClearSectionStart(string slug)
    {
        var timings = ParseSectionTimings();
        timings.Remove(slug);
        _song!.SectionTimings = string.Join(';', timings.Select(kv => $"{kv.Key}={kv.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}"));
        AutoSave();
    }

