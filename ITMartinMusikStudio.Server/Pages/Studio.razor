}

@code {
    [Parameter] public string SongKey { get; set; } = "";
    [SupplyParameterFromQuery(Name = "file")] public string? FileParam { get; set; }

    private StudioSong? _song;
    private bool _loading = true;

    private string _tab = "forbered";

    private string _chordEdit = "";
    private string _lyricsEdit = "";
    private string _notesEdit = "";
    private string _fingerpickEdit = "";
    private string _strumEdit = "";
    private bool _plektrumMode;

    private bool _vocalLoading;
    private string? _vocalUrl;
    private string? _vocalError;

    private bool _patternsLoading;
    private bool _aiLoading;
    private string? _saveStatus;
    private System.Timers.Timer? _saveTimer;
    private System.Timers.Timer? _recTimer_t;
    private int _recTimer;

    private bool _recording;
    private bool _videoMode;
    private List<RecordingFile> _recordings = [];

    private string? _photoTarget;
    private bool _cameraOn;
    private bool _photoAnalyzing;
    private string _photoResult = "";

    private string _aiTab = "spil";
    private string _chordLookup = "";
    private bool _aiHelperLoading;
    private string _aiHelperResult = "";
    private bool _annotatingChords;

    private bool _ugPasteOpen;
    private string _ugPasteText = "";
    private bool _ugParsing;

    private bool _mixing;

    private bool _stemRunning;
    private string? _stemProgress;
    private StemResult? _stems;
    private int _stemElapsed;
    private System.Timers.Timer? _stemTimer_t;

    private string? _selectedChord;
    private string _selectedChordInfo = "";
    private bool _selectedChordLoading;

    private static readonly string[] MajorKeys = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"];
    private static readonly string[] MinorKeys = ["Cm","C#m","Dm","D#m","Em","Fm","F#m","Gm","G#m","Am","A#m","Bm"];

    private string PhotoTargetLabel => _photoTarget switch
    {
        "lyrics" => "Tekst",
        "chords" => "Akkorder",
        "notes"  => "Noter",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        var existing = await Db.Songs.FirstOrDefaultAsync(s => s.Key == SongKey);
        if (existing is not null)
        {
            _song = existing;
        }
        else
        {
            var sourceFile = FileParam ?? "";
            _song = new StudioSong
            {
                Key        = SongKey,
                Title      = ToTitle(SongKey),
                SourceFile = sourceFile,
            };
            Db.Songs.Add(_song);
            await Db.SaveChangesAsync();
        }

        _chordEdit       = _song.ChordChart;
        _lyricsEdit      = _song.Lyrics;
        _notesEdit       = _song.Notes;
        _fingerpickEdit  = _song.FingerpickPattern;
        _strumEdit       = _song.StrumPattern;
        _loading         = false;

        _recordings = Library.GetRecordings(SongKey);
    }

    private static string FormatRecTime(int seconds) =>
        $"{seconds / 60}:{seconds % 60:D2}";

    private static string ToTitle(string key) =>
        string.Join(" ",
            key.Replace("_", " ").Replace("-", " ")
               .Split(' ', StringSplitOptions.RemoveEmptyEntries)
               .Select(w => w.Length > 0 ? char.ToUpper(w[0]) + w[1..] : w));

    // ── Auto-save ──────────────────────────────────────────────────────────────

    private void AutoSave()
    {
        if (_song is null) return;
        _song.ChordChart        = _chordEdit;
        _song.Lyrics            = _lyricsEdit;
        _song.Notes             = _notesEdit;
        _song.FingerpickPattern = _fingerpickEdit;
        _song.StrumPattern      = _strumEdit;

        _saveTimer?.Dispose();
        _saveTimer = new System.Timers.Timer(1200) { AutoReset = false };
        _saveTimer.Elapsed += async (_, _) =>
        {
            _song.UpdatedAt = DateTime.UtcNow;
            await Db.SaveChangesAsync();
            _saveStatus = "Gemt ✓";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1500);
            _saveStatus = null;
            await InvokeAsync(StateHasChanged);
        };
        _saveTimer.Start();
    }

    private void OnKeyChanged(ChangeEventArgs e)
    {
        if (_song is null) return;
        _song.MusicKey = e.Value?.ToString() ?? _song.MusicKey;
        AutoSave();
    }

    private void OnTempoChanged(ChangeEventArgs e)
    {
        if (_song is null) return;
        _song.Tempo = int.TryParse(e.Value?.ToString(), out var t) ? t : (int?)null;
        AutoSave();
    }

    // ── Transpose ─────────────────────────────────────────────────────────────

    private void AdjustT(int d)
    {
        if (d == 0 || _song is null) return;
        _lyricsEdit    = TransposeChordsInText(_lyricsEdit, d);
        _chordEdit     = TransposeChordsInText(_chordEdit, d);
        _song.MusicKey = TransposeNote(_song.MusicKey, d);
        AutoSave();
    }

    private static readonly string[] Notes = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"];
    private static readonly string[] NotesFlat = ["C","Db","D","Eb","E","F","Gb","G","Ab","A","Bb","B"];

    private static string TransposeNote(string chord, int semitones)
    {
        if (semitones == 0 || string.IsNullOrEmpty(chord)) return chord;
        int rootLen = chord.Length > 1 && chord[1] is '#' or 'b' ? 2 : 1;
        var root   = chord[..rootLen];
        var suffix = chord[rootLen..];
        var idx = Array.IndexOf(Notes, root);
        if (idx < 0) idx = Array.IndexOf(NotesFlat, root);
        if (idx < 0) return chord;
        var newIdx = ((idx + semitones) % 12 + 12) % 12;
        return Notes[newIdx] + suffix;
    }

    private static string TransposeChordsInText(string text, int semitones)
    {
        if (string.IsNullOrEmpty(text) || semitones == 0) return text;
        return System.Text.RegularExpressions.Regex.Replace(
            text,
            @"\[([A-G][^\]]*)\]",
            m => "[" + TransposeNote(m.Groups[1].Value, semitones) + "]");
    }

    private static bool IsChord(string token)
    {
        if (string.IsNullOrWhiteSpace(token) || token.EndsWith(':')) return false;
        var root = token.TrimEnd('m', '7', '9', 'j', 'a', 's', 'u', '+', 'd', 'i', '/', '2', '4', '5', '6');
        return Notes.Contains(root) || NotesFlat.Contains(root);
    }

    // ── AI chords ─────────────────────────────────────────────────────────────

    private async Task AiChords()
    {
        if (_song is null) return;
        _aiLoading = true;
        var result = await ChordAi.SuggestChordsAsync(_song.Title, _song.MusicKey, _song.Tempo, _lyricsEdit);
        if (!string.IsNullOrEmpty(result))
        {
            _chordEdit = result;
            AutoSave();
        }
        _aiLoading = false;
    }

    // ── Recording ─────────────────────────────────────────────────────────────

    private async Task StartRecording()
    {
        _recording = true;
        StartRecTimer();
        try
        {
            await JS.InvokeVoidAsync("studio.startRecording", SongKey, _videoMode);
        }
        catch (JSException ex)
        {
            _recTimer_t?.Stop();
            _recTimer_t?.Dispose();
            _recTimer = 0;
            _recording = false;
            _saveStatus = _videoMode
                ? "Ingen kamera fundet — prøv lydoptagelse i stedet"
                : $"Mikrofon fejl: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartRecTimer()
    {
        _recTimer = 0;
        _recTimer_t = new System.Timers.Timer(1000) { AutoReset = true };
        _recTimer_t.Elapsed += async (_, _) =>
        {
            _recTimer++;
            await InvokeAsync(StateHasChanged);
            if (_recTimer >= 600)
                await InvokeAsync(StopRecording);
        };
        _recTimer_t.Start();
    }

    private async Task StartOverdubRecording()
    {
        var latest = _recordings.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
        if (latest is null) { await StartRecording(); return; }
        await StartOverdubFromUrl($"/stream?path={Uri.EscapeDataString(latest.RelativePath)}");
    }

    private async Task StartOverdubFromUrl(string playUrl)
    {
        _recording = true;
        StartRecTimer();
        try
        {
            await JS.InvokeVoidAsync("studio.startOverdub", SongKey, playUrl, _videoMode);
        }
        catch (JSException ex)
        {
            _recTimer_t?.Stop();
            _recTimer_t?.Dispose();
            _recTimer = 0;
            _recording = false;
            _saveStatus = $"Mikrofon fejl: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PlayMix()
    {
        _mixing = true;
        var urls = _recordings
            .Select(r => $"/stream?path={Uri.EscapeDataString(r.RelativePath)}")
            .ToArray();
        await JS.InvokeVoidAsync("studio.playMix", urls);
    }

    private async Task StopMix()
    {
        _mixing = false;
        await JS.InvokeVoidAsync("studio.stopMix");
    }

    private async Task StopRecording()
    {
        _recTimer_t?.Stop();
        _recTimer_t?.Dispose();
        _recording = false;
        _recTimer = 0;
        await JS.InvokeVoidAsync("studio.stopRecording");
        await Task.Delay(800);
        _recordings = Library.GetRecordings(SongKey);
    }

    private async Task Publish(RecordingFile r)
    {
        using var http = new HttpClient();
        var baseUrl = Nav.BaseUri.TrimEnd('/');
        await http.PostAsJsonAsync($"{baseUrl}/api/publish/{SongKey}",
            new { relativePath = r.RelativePath });
        _saveStatus = "🚀 Publiceret!";
        await Task.Delay(2000);
        _saveStatus = null;
    }

    private async Task DeleteRecording(RecordingFile r)
    {
        using var http = new HttpClient();
        var baseUrl = Nav.BaseUri.TrimEnd('/');
        await http.DeleteAsync($"{baseUrl}/api/recording?path={Uri.EscapeDataString(r.RelativePath)}");
        _recordings = Library.GetRecordings(SongKey);
    }

    // ── Photo capture ─────────────────────────────────────────────────────────

    private async Task OpenCamera()
    {
        _cameraOn = true;
        StateHasChanged();
        await Task.Delay(100);
        await JS.InvokeVoidAsync("studio.startCamera", "photo-video");
    }

    private async Task CloseCamera()
    {
        _cameraOn = false;
        await JS.InvokeVoidAsync("studio.stopCamera");
    }

    private async Task CapturePhoto()
    {
        var result = await JS.InvokeAsync<string>("studio.capturePhoto", "photo-video");
        await CloseCamera();
        await AnalyzePhoto(result, "image/jpeg");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        using var ms = new MemoryStream();
        await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        await stream.CopyToAsync(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        var mime = file.ContentType.StartsWith("image/") ? file.ContentType : "image/jpeg";
        await AnalyzePhoto(base64, mime);
    }

    private async Task AnalyzePhoto(string base64, string mime)
    {
        _photoAnalyzing = true;
        _photoResult = "";
        StateHasChanged();
        try
        {
            string result;
            if (_photoTarget == "chords")
                result = await ChordAi.ExtractChordsFromImageAsync(base64, mime);
            else
                result = await ChordAi.ExtractTextFromImageAsync(base64, mime);
            _photoResult = result;
        }
        catch (Exception ex)
        {
            _photoResult = $"Fejl: {ex.Message}";
        }
        finally
        {
            _photoAnalyzing = false;
        }
    }

    private void ApplyPhotoResult()
    {
        if (string.IsNullOrEmpty(_photoResult)) return;
        switch (_photoTarget)
        {
            case "lyrics":
                _lyricsEdit = string.IsNullOrWhiteSpace(_lyricsEdit) ? _photoResult : _lyricsEdit + "\n\n" + _photoResult;
                break;
            case "chords":
                _chordEdit = string.IsNullOrWhiteSpace(_chordEdit) ? _photoResult : _chordEdit + "\n\n" + _photoResult;
                break;
            case "notes":
                _notesEdit = string.IsNullOrWhiteSpace(_notesEdit) ? _photoResult : _notesEdit + "\n\n" + _photoResult;
                break;
        }
        AutoSave();
        ClosePhoto();
    }

    private void ClearPhotoResult() => _photoResult = string.Empty;

    // ── AI Helper ─────────────────────────────────────────────────────────────

    private void SelectAiTab(string tab) { _aiTab = tab; _aiHelperResult = ""; }
    private void ClearAiHelper() => _aiHelperResult = "";

    private async Task OnChordLookupKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AiChordLookup();
    }

    private async Task AiChordLookup()
    {
        if (string.IsNullOrWhiteSpace(_chordLookup)) return;
        _aiHelperLoading = true;
        _aiHelperResult = "";
        _aiHelperResult = await ChordAi.GetChordFingeringAsync(_chordLookup.Trim());
        _aiHelperLoading = false;
    }

    private async Task AiSpil()
    {
        if (_song is null) return;
        _aiHelperLoading = true;
        _aiHelperResult = "";
        _aiHelperResult = await ChordAi.GetInstrumentTipsAsync(_chordEdit, _song.Tempo, _song.MusicKey);
        _aiHelperLoading = false;
    }

    private async Task AiSang()
    {
        if (_song is null) return;
        _aiHelperLoading = true;
        _aiHelperResult = "";
        _aiHelperResult = await ChordAi.GetSingingTipsAsync(_song.Title, _lyricsEdit, _chordEdit, _song.Tempo, _song.MusicKey);
        _aiHelperLoading = false;
    }

    private void ClosePhoto()
    {
        if (_cameraOn) _ = CloseCamera();
        _photoTarget = null;
        _photoResult = "";
        _cameraOn = false;
        _photoAnalyzing = false;
    }

    // ── Guitar patterns ───────────────────────────────────────────────────────

    private async Task AiPatterns()
    {
        if (_song is null) return;
        _patternsLoading = true;
        var (pick, strum) = await Task.WhenAll(
            ChordAi.GetFingerpickPatternAsync(_song.Title, _chordEdit, _song.Tempo, _song.MusicKey),
            ChordAi.GetStrumPatternAsync(_song.Title, _chordEdit, _song.Tempo, _song.MusicKey)
        ).ContinueWith(t => (t.Result[0], t.Result[1]));
        if (!string.IsNullOrEmpty(pick))  { _fingerpickEdit = pick; }
        if (!string.IsNullOrEmpty(strum)) { _strumEdit      = strum; }
        AutoSave();
        _patternsLoading = false;
    }

    // ── Vocal guide ───────────────────────────────────────────────────────────

    private async Task GenerateVocalGuide()
    {
        if (_song is null) return;
        _vocalLoading = true;
        _vocalError   = null;
        _vocalUrl     = null;
        try
        {
            _vocalUrl = await VocalGuide.GenerateAsync(
                _song.MusicKey, _song.Tempo, _chordEdit, durationSeconds: 30);
        }
        catch (Exception ex)
        {
            _vocalError = ex.Message.Split('\n')[0];
        }
        finally { _vocalLoading = false; }
    }

    // ── Search ────────────────────────────────────────────────────────────────

    private async Task SearchLyrics()
    {
        if (_song is null) return;
        var q = Uri.EscapeDataString(_song.Title + (string.IsNullOrWhiteSpace(_song.Artist) ? "" : " " + _song.Artist) + " lyrics");
        await JS.InvokeVoidAsync("open", $"https://www.google.com/search?q={q}", "_blank");
    }

    private async Task SearchUltimateGuitar()
    {
        if (_song is null) return;
        var q = Uri.EscapeDataString(_song.Title + (string.IsNullOrWhiteSpace(_song.Artist) ? "" : " " + _song.Artist));
        await JS.InvokeVoidAsync("open", $"https://www.ultimate-guitar.com/search.php?search_type=title&value={q}", "_blank");
    }

    // ── Stems ─────────────────────────────────────────────────────────────────

    private async Task ExtractStems()
    {
        if (_song is null || string.IsNullOrEmpty(_song.SourceFile)) return;
        _stemRunning = true;
        _stemElapsed = 0;
        _stemProgress = null;
        _stems = null;

        _stemTimer_t?.Dispose();
        _stemTimer_t = new System.Timers.Timer(1000) { AutoReset = true };
        _stemTimer_t.Elapsed += async (_, _) => { _stemElapsed++; await InvokeAsync(StateHasChanged); };
        _stemTimer_t.Start();
        StateHasChanged();

        try
        {
            var inputPath = Path.GetFullPath(Path.Combine(Library.Root, _song.SourceFile));
            var outputDir = Path.Combine(Library.Root, "stems", SongKey);
            var progress  = new Progress<string>(msg => { _stemProgress = msg; InvokeAsync(StateHasChanged); });
            _stems = await StemSvc.SeparateAsync(inputPath, outputDir, progress);
        }
        catch (Exception ex)
        {
            _saveStatus = $"Stem fejl: {ex.Message}";
        }
        finally
        {
            _stemTimer_t?.Stop();
            _stemTimer_t?.Dispose();
            _stemRunning = false;
            StateHasChanged();
        }
    }

    // ── UG tab parser ─────────────────────────────────────────────────────────

    private async Task ParseUgTab()
    {
        if (string.IsNullOrWhiteSpace(_ugPasteText)) return;
        _ugParsing = true;
        StateHasChanged();
        var result = await ChordAi.ParseUltimateGuitarTabAsync(_ugPasteText);
        if (!string.IsNullOrEmpty(result.Chords)) { _chordEdit  = result.Chords; }
        if (!string.IsNullOrEmpty(result.Lyrics)) { _lyricsEdit = result.Lyrics; }
        AutoSave();
        _ugParsing   = false;
        _ugPasteOpen = false;
        _ugPasteText = "";
    }

    // ── Toneart / Key finder ──────────────────────────────────────────────────

    private async Task AiToneart()
    {
        if (_song is null) return;
        _aiHelperLoading = true;
        _aiHelperResult = "";
        _aiHelperResult = await ChordAi.GetKeyForVoiceAsync(_song.Title, _song.MusicKey, _lyricsEdit);
        _aiHelperLoading = false;
    }

    // ── Chord transitions ─────────────────────────────────────────────────────

    private async Task AiOvergang()
    {
        if (_song is null) return;
        _aiHelperLoading = true;
        _aiHelperResult = "";
        var chart = string.IsNullOrWhiteSpace(_chordEdit) ? ExtractChordsFromLyrics() : _chordEdit;
        _aiHelperResult = await ChordAi.GetChordTransitionsAsync(chart, _song.MusicKey);
        _aiHelperLoading = false;
    }

    private string ExtractChordsFromLyrics() =>
        string.Join(" ", System.Text.RegularExpressions.Regex
            .Matches(_lyricsEdit, @"\[([A-G][^\]]*)\]")
            .Select(m => m.Groups[1].Value)
            .Distinct());

    // ── Chord annotation ──────────────────────────────────────────────────────

    private async Task AiAnnotateChords()
    {
        if (_song is null || string.IsNullOrWhiteSpace(_lyricsEdit)) return;
        _annotatingChords = true;
        StateHasChanged();
        try
        {
            var result = await ChordAi.AnnotateLyricsWithChordsAsync(
                _lyricsEdit, _chordEdit, _song.MusicKey, _song.Title, _song.Artist);
            if (!string.IsNullOrWhiteSpace(result))
            {
                _lyricsEdit = result;
                AutoSave();
            }
        }
        catch (Exception ex)
        {
            _saveStatus = $"AI fejl: {ex.Message}";
        }
        finally
        {
            _annotatingChords = false;
        }
    }

    // ── Simplify chords ───────────────────────────────────────────────────────

    private void SimplifyChords()
    {
        _chordEdit = System.Text.RegularExpressions.Regex.Replace(
            _chordEdit,
            @"([A-G][#b]?(?:maj|min|m|dim|aug|sus\d?|add\d|M|\d)*)/[A-G][#b]?",
            m => m.Groups[1].Value);
        AutoSave();
        StateHasChanged();
    }

    // ── Perform chord tap ─────────────────────────────────────────────────────

    private void DismissChord() { _selectedChord = null; _selectedChordInfo = ""; }

    private async Task SelectPerformChord(string chord)
    {
        if (_selectedChord == chord)
        {
            _selectedChord = null;
            _selectedChordInfo = "";
            return;
        }
        _selectedChord = chord;
        _selectedChordInfo = "";
        _selectedChordLoading = true;
        StateHasChanged();
        _selectedChordInfo = await ChordAi.GetChordFingeringAsync(chord);
        _selectedChordLoading = false;
        StateHasChanged();
    }

    private async Task ShowChordTransition()
    {
        if (_selectedChord is null) return;
        _selectedChordLoading = true;
        StateHasChanged();
        var chart = string.IsNullOrWhiteSpace(_chordEdit) ? ExtractChordsFromLyrics() : _chordEdit;
        _selectedChordInfo = await ChordAi.GetChordTransitionsAsync(chart, _song?.MusicKey ?? "C");
        _selectedChordLoading = false;
        StateHasChanged();
    }

    // ── Chord+lyrics renderer ─────────────────────────────────────────────────

    private bool HasInlineChords =>
        !string.IsNullOrWhiteSpace(_lyricsEdit) &&
        System.Text.RegularExpressions.Regex.IsMatch(_lyricsEdit, @"\[[A-G][^\]]*\]");

    private static bool IsSectionLabel(string line)
    {
        var t = line.Trim();
        if (t.EndsWith(':') && !System.Text.RegularExpressions.Regex.IsMatch(t, @"\[[A-G]")) return true;
        if (!t.StartsWith('[')) return false;
        var inner = t.TrimStart('[').Split(']')[0];
        return inner.Contains(' ') || inner.Length == 0 || inner[0] is < 'A' or > 'G';
    }

    private IEnumerable<(string? Chord, string Text)> ParseLyricLine(string line)
    {
        var result = new List<(string?, string)>();
        var rx = new System.Text.RegularExpressions.Regex(@"\[([A-G][^\]]*)\]([^\[]*)");
        int last = 0;
        foreach (System.Text.RegularExpressions.Match m in rx.Matches(line))
        {
            if (m.Index > last) result.Add((null, line[last..m.Index]));
            result.Add((m.Groups[1].Value, m.Groups[2].Value));
            last = m.Index + m.Length;
        }
        if (last < line.Length) result.Add((null, line[last..]));
        if (!result.Any()) result.Add((null, line));
        return result;
    }
