@page "/login"
@layout EmptyLayout

<PageTitle>Log ind – Kolibri Læs</PageTitle>

<div class="ls-login">
    <section class="k-card">
        <h1 class="k-card-title">📚 Kolibri Læs</h1>
        <p>Dine PDF-bøger som en bog – med et resumé på dansk. Skriv din kode for at komme ind.</p>
        @if (Fejl == "1") { <p class="ls-warn">Forkert kode – prøv igen.</p> }
        <form method="post" action="/api/login">
            <input type="password" name="pin" class="k-input ls-pin" placeholder="Kode" autofocus />
            <button class="k-btn k-btn-primary ls-big" type="submit">Log ind</button>
        </form>
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? Fejl { get; set; }
}
