    private string _dayText = "", _dayNote = "";

    private DayNote _today = new();
    private string _todayNote = "";

    private async Task LoadTodayAsync()
    {
        _today = await Owner.TodayAsync();
        Approve(_today.Plan, _today.Done, _s.NowText, _s.Intro);
    }

    private async Task SaveTodayAsync()
    {
        _today.Plan = await ReviewAsync(_today.Plan, TextKind.Liste);
        _today.Done = await ReviewAsync(_today.Done, TextKind.Liste);
        if (await Owner.SaveTodayAsync(_today) is not { } saved)   // Svar left open past midnight: yesterday's text stays on yesterday
        {
            await LoadTodayAsync();
            _todayNote = "🌅 Det var gårsdagens tekst – nu er det en ny dag. Skriv dagens plan.";
            return;
        }
        _today = saved;
        _todayNote = "Gemt ✓";
    }

    // ── AI proofreading: one check per save; the owner picks the suggestion or keeps his own text.
    private bool _checking;
    private TextReview? _review;
    private string _reviewOriginal = "";
    private TaskCompletionSource<string>? _reviewTcs;
    private readonly HashSet<string> _approved = [];   // text already checked or already on the site - not sent to AI again

    private void Approve(params string?[] texts)
    {
        foreach (var t in texts) if (!string.IsNullOrWhiteSpace(t)) _approved.Add(t.Trim());
    }

    // "Gem" under the fixed Lige nu text and intro (SaveSettingsAsync itself is also used by picture saves - no check there).
    private async Task SaveNowTextAsync()
    {
        _s.NowText = await ReviewAsync(_s.NowText, TextKind.Opslag);
        _s.Intro = await ReviewAsync(_s.Intro, TextKind.Linje);
        await SaveSettingsAsync();
    }

    private async Task<string> ReviewAsync(string text, TextKind kind)
    {
        if (string.IsNullOrWhiteSpace(text) || _approved.Contains(text.Trim())) return text;
        _checking = true;
        StateHasChanged();
        var r = await Owner.CheckTextAsync(text, kind);
        _checking = false;
        if (r is null || (!r.Changed && r.Notes.Count == 0)) { StateHasChanged(); Approve(text); return text.Trim(); }
        _review = r;
        _reviewOriginal = text.Trim();
        _reviewTcs = new TaskCompletionSource<string>();
        StateHasChanged();
        var chosen = await _reviewTcs.Task;
        Approve(chosen);
        _review = null;
        _reviewTcs = null;
        StateHasChanged();
        return chosen;
    }

    private static DateTime DkNow() => Dk.Now;

    // Pictures for "Min dag": saved at once (no "Gem"), the typed line goes with the first picture.
    private async Task OnDayPhotosAsync(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(30);
        var entries = _s.Entries();
        var text = await ReviewAsync(_dayText, TextKind.Linje);
        var added = 0;
        foreach (var f in files)
        {
            _dayNote = $"Lægger billede {added + 1} af {files.Count} op…";
            StateHasChanged();
            try
            {
                await using var stream = f.OpenReadStream(OwnerUseCases.MaxUploadBytes);
                var saved = await Owner.UploadAsync(stream, f.Name, f.ContentType);
                if (saved.Media.ThumbName is null) { Owner.DeleteFile(saved.Media); continue; }   // not a picture
                // A picture taken earlier today keeps its own time (EXIF is already local time); otherwise now.
                var at = saved.TakenAt is { } t && t.Date == DkNow().Date ? t : DkNow();
                entries.Add(new Settings.DayEntry(saved.Media.StoredName, saved.Media.ThumbName, at, added == 0 ? text : ""));
                added++;
            }
            catch (Exception ex) { _dayNote = $"Det lykkedes ikke: {ex.Message}"; StateHasChanged(); }
        }
        if (added == 0) return;
        await SaveEntriesAsync(entries);
        _dayText = "";
        _dayNote = added == 1 ? "Lagt på din dag ✓" : $"{added} billeder lagt på din dag ✓";
    }

    private async Task AddDayTextAsync()
    {
        var entries = _s.Entries();
        var text = await ReviewAsync(_dayText, TextKind.Linje);
        entries.Add(new Settings.DayEntry("", "", DkNow(), text));
        await SaveEntriesAsync(entries);
        _dayText = "";
        _dayNote = "Lagt på din dag ✓";
    }

