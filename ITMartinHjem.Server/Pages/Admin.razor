@page "/admin"
@implements IDisposable
@inject OwnerUseCases Owner
@inject ChatUseCases Chat
@inject PublicQuestions Questions
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (!_owner)
{
    <div class="k-card k-pin" data-nofold>
        <div class="k-card-title">Kun for Martin</div>
        <p class="k-card-sub">Her skriver du opslag og svarer på beskeder.</p>
        <a class="k-btn k-btn-primary k-btn-block" href="/login?who=ejer">Log ind med PIN</a>
        <p class="k-help"><a href="/">← Forsiden</a></p>
    </div>
    return;
}

<header class="hj-head">
    <h1>Din side</h1>
    <p class="k-help">Her svarer du på beskeder, skriver hvad du laver lige nu, og lægger billeder, videoer, lyd og dokumenter på tidslinjen. <a href="/">Se forsiden</a> · <a href="/admin/tal">📊 Tal</a> · <a href="/logout">Log ud</a></p>
</header>

@* One answer first: am I available, and is anybody waiting? *@
<section class="k-card hj-avail" data-nofold>
    <label class="hj-switch">
        <input type="checkbox" checked="@_s.Available" @onchange="ToggleAvailableAsync" />
        <span><b>@(_s.Available ? "🟢 Jeg er her nu" : "⚪ Jeg er ikke ved skærmen")</b><br />
        <span class="k-help">@(_s.Available ? "Besøgende ser, at du svarer med det samme." : "Besøgende kan stadig skrive – du får en besked på telefonen.")</span></span>
    </label>
    @if (_unread > 0)
    {
        @* Tapping it opens the newest waiting conversation (user 2026-09-29: "kan ikke åbne de ventende beskeder"). *@
        <button class="hj-unread k-btn k-btn-primary" @onclick="OpenNewestUnreadAsync">💬 @_unread @(_unread == 1 ? "samtale venter" : "samtaler venter") på svar – tryk for at læse</button>
    }
</section>

<section class="k-card">
    <div class="k-card-title">💬 Beskeder</div>
    @if (_threads.Count == 0)
    {
        <p class="k-help">Ingen beskeder endnu. Når nogen skriver på forsiden, dukker det op her – og på telefonen, hvis du har slået beskeder til nederst.</p>
    }
    else
    {
        <div class="hj-threads">
            @foreach (var t in _threads)
            {
                <button class="hj-thread @(t.Id == _openId ? "sel" : "") @(t.UnreadForOwner ? "new" : "")" @onclick="() => OpenAsync(t.Id)">
                    <b>@(t.Name.Length > 0 ? t.Name : "Besøgende #" + t.Id)</b>
                    <span class="k-help">@Dk.Local(t.LastAt).ToString("d/M HH:mm") · @(t.Messages.OrderBy(m => m.At).LastOrDefault()?.Text is { } last ? (last.Length > 50 ? last[..50] + "…" : last) : "")</span>
                </button>
            }
        </div>
        @if (_open is not null)
        {
            <div class="hj-msgs" id="hj-msgs">
                @foreach (var m in _open.Messages)
                {
                    <div class="hj-msg @(m.FromOwner ? "me" : "owner")">
                        <div>@m.Text</div>
                        <div class="hj-msg-at">@(m.FromOwner ? "Dig" : (_open.Name.Length > 0 ? _open.Name : "Besøgende")) · @Dk.Local(m.At).ToString("d/M HH:mm")</div>
                    </div>
                }
            </div>
            <textarea class="k-input k-textarea k-mt" @bind="_reply" @bind:event="oninput" placeholder="Dit svar…" aria-label="Dit svar"></textarea>
            <div class="k-row k-mt">
                <button class="k-btn k-btn-primary" disabled="@string.IsNullOrWhiteSpace(_reply)" @onclick="ReplyAsync">Send svar</button>
                @if (_confirmDeleteThread) { <button class="k-btn k-btn-danger" @onclick="DeleteThreadAsync">Ja, slet samtalen</button> }
                else { <button class="k-btn k-btn-ghost" @onclick="() => _confirmDeleteThread = true">Slet samtale</button> }
            </div>
            <p class="k-help">Svaret vises straks hos den besøgende, hvis siden er åben – ellers næste gang de kommer tilbage på samme telefon/PC.</p>
            @if (_qaAll.Any(q => q.SourceThreadId == _openId)) { <p class="k-help">✓ Denne samtale ligger på siden <a href="/spoergsmaal" target="_blank">Det spørger folk om</a>.</p> }
            else if (_open.Messages.Any(m => m.FromOwner)) { <button class="k-btn k-mt" @onclick="StartQaFromChatAsync">👁 Vis på "Det spørger folk om" (uden navn)</button> }
        }
    }
</section>

@* Public Q&A from the chat, no names (user 2026-10-12). Nothing is public until Martin presses Læg op. *@
<section class="k-card" id="spoergsmaal">
    <div class="k-card-title">💬 Det spørger folk om (offentligt)</div>
    <p class="k-help">Spørgsmål fra chatten, som alle kan se på <a href="/spoergsmaal" target="_blank">itmartin.dk/spoergsmaal</a> og på forsiden – <b>uden navne</b>.
        Tryk "Vis på Det spørger folk om" under en samtale, og vælg om det hører til ITMartin.dk eller Bogshoppen.dk. Navn, e-mail og telefonnummer fjernes af sig selv – læs teksten igennem og ret resten, før du lægger den op.
        Giv den et <b>emne</b> (fx Budget, Billeder), så folk kan finde de andre spørgsmål om det samme.</p>
    @if (_qaOpen)
    {
        <label class="k-label">❓ Spørgsmålet (som de besøgende ser det)</label>
        <textarea class="k-input k-textarea" @bind="_qaQ" rows="3" maxlength="1000"></textarea>
        <label class="k-label">💬 Dit svar</label>
        <textarea class="k-input k-textarea" @bind="_qaA" rows="5" maxlength="3000"></textarea>
        <label class="k-label">🌐 Hvor skal det vises?</label>
        <div class="k-row">
            <label><input type="radio" name="qa-site" checked="@(_qaSite == QuestionRules.ITMartin)" @onchange="() => _qaSite = QuestionRules.ITMartin" /> ITMartin.dk</label>
            <label><input type="radio" name="qa-site" checked="@(_qaSite == QuestionRules.Bogshoppen)" @onchange="() => _qaSite = QuestionRules.Bogshoppen" /> Bogshoppen.dk</label>
        </div>
        <label class="k-label">🏷️ Emne</label>
        <input class="k-input" @bind="_qaTopic" list="qa-topics" maxlength="40" placeholder="fx Budget, Billeder, ElPriser, Apps" />
        <datalist id="qa-topics">@foreach (var t in _qaTopics) { <option value="@t" /> }</datalist>
        <div class="k-row k-mt">
            <button class="k-btn k-btn-primary" @onclick="SaveQaAsync">@(_qaEditId is null ? "👁 Læg op – uden navn" : "Gem ændringer")</button>
            <button class="k-btn k-btn-ghost" @onclick="() => _qaOpen = false">Annuller</button>
        </div>
    }
    @if (_qaNote.Length > 0) { <p class="k-help">@_qaNote</p> }
    @if (_qaAll.Count == 0) { <p class="k-help">Ingen spørgsmål lagt op endnu.</p> }
    else
    {
        <ul class="hj-qa-admin">
            @foreach (var q in _qaAll.OrderByDescending(q => q.PublishedAt))
            {
                <li>
                    <span><span class="k-tag">@(q.Site == QuestionRules.Bogshoppen ? "📚 " : "")@q.Topic</span> @(q.Question.Length > 90 ? q.Question[..90] + "…" : q.Question)</span>
                    <button class="k-btn k-btn-sm" @onclick="() => EditQa(q)">Ret</button>
                    @if (_qaConfirmRemove == q.Id) { <button class="k-btn k-btn-sm k-btn-danger" @onclick="() => RemoveQaAsync(q.Id)">Ja, fjern</button> }
                    else { <button class="k-btn k-btn-sm k-btn-ghost" @onclick="() => _qaConfirmRemove = q.Id">Fjern</button> }
                </li>
            }
        </ul>
    }
</section>

@if (_checking)
{
    <div class="hj-review"><b>✨ AI læser din tekst igennem…</b></div>
}
else if (_review is { } rv)
{
    <div class="hj-review">
        <b>✨ AI's forslag</b>
        @if (rv.Changed)
        {
            <div class="hj-review-text">@rv.Suggested</div>
        }
        else
        {
            <p class="k-help">Ingen stavefejl – men læg mærke til:</p>
        }
        @if (rv.Notes.Count > 0)
        {
            <ul class="hj-review-notes">@foreach (var n in rv.Notes) { <li>⚠️ @n</li> }</ul>
        }
        <div class="k-row k-mt">
            @if (rv.Changed) { <button class="k-btn k-btn-primary" @onclick="() => _reviewTcs?.TrySetResult(rv.Suggested)">✅ Brug forslaget</button> }
            <button class="k-btn" @onclick="() => _reviewTcs?.TrySetResult(_reviewOriginal)">@(rv.Changed ? "Behold min tekst" : "OK, læg det op")</button>
        </div>
    </div>
}

<section class="k-card" id="lige-nu">
    <div class="k-card-title">📌 Min dag</div>
    <p class="k-help">✨ Al tekst, du gemmer eller sender i Svar, bliver læst igennem af AI: stavefejl, opgaver i punktform og ting der kan misforstås. Du vælger selv, om du vil bruge forslaget. Tekst du ikke har ændret, bliver ikke tjekket igen.</p>
    <p class="k-help"><b>Saml din dag:</b> skriv om morgenen, hvad du regner med at lave. I løbet af dagen tager du billeder eller skriver en linje, hver gang der sker noget.
        Om aftenen skriver du, hvad det egentlig blev til. Hvert billede eller hver linje bliver et punkt med klokkeslæt på siden "Hvad laver ITKolibrien lige nu?". I morgen starter en ny dag af sig selv – de tidligere dage kan stadig ses længere nede.</p>
    <label class="k-label">🌅 I morges: hvad regner du med at lave i dag? <span class="k-help">(én opgave pr. linje)</span></label>
    <textarea class="k-input k-textarea" @bind="_today.Plan" maxlength="2000" rows="4" placeholder="@PlanHint"></textarea>
    <label class="k-label">🌙 I aften: hvad fik du lavet? <span class="k-help">(én ting pr. linje)</span></label>
    <textarea class="k-input k-textarea" @bind="_today.Done" maxlength="2000" rows="4" placeholder="Skriv det i aften – det må gerne være noget helt andet 🙂"></textarea>
    <button class="k-btn k-btn-primary k-mt" @onclick="SaveTodayAsync">Gem planen</button>
    @if (_todayNote.Length > 0) { <span class="k-help"> @_todayNote</span> }
    <label class="k-label k-mt">📍 I løbet af dagen: skriv en linje og/eller tag et billede</label>
    <textarea class="k-input k-textarea" @bind="_dayText" @bind:event="oninput" maxlength="600" rows="2" placeholder="Hvad laver du nu? (kan springes over)" aria-label="Hvad laver du nu?"></textarea>
    <div class="k-row k-mt">
        <label class="k-btn k-btn-primary">📷 Tag billede<InputFile OnChange="OnDayPhotosAsync" accept="image/*" capture="environment" style="display:none" /></label>
        <label class="k-btn">🖼️ Vælg billeder<InputFile OnChange="OnDayPhotosAsync" multiple accept="image/*" style="display:none" /></label>
        <button class="k-btn" disabled="@string.IsNullOrWhiteSpace(_dayText)" @onclick="AddDayTextAsync">✍️ Kun tekst</button>
    </div>
    @if (_dayNote.Length > 0) { <p class="k-help">@_dayNote</p> }
    @{ var today = DkNow().Date; var todays = _s.Entries().Where(e => e.At.Date == today).ToList(); }
    @if (todays.Count > 0)
    {
        <div class="k-label">I dag (@todays.Count)</div>
        <div class="hj-day-admin">
            @foreach (var e in todays)
            {
                <div class="hj-day-row">
                    @if (e.Thumb.Length > 0) { <img src="/nu/@e.Thumb" alt="" /> }
                    <span><b>@e.At.ToString("HH.mm")</b> @e.Text</span>
                    <button class="k-btn-ghost" title="Fjern" @onclick="() => RemoveDayEntryAsync(e)">✕</button>
                </div>
            }
        </div>
    }
    <details class="k-mt" data-remember="adm-now-fixed">
        <summary>Fast tekst, film eller livestream (valgfrit)</summary>
    <p class="k-help">Vises under din dag. Skriv kort, hvad du arbejder med – opdatér det, når det skifter. Start en linje med <b>*</b> for en punktliste, og skriv <b>**sådan**</b> for fed skrift.</p>
    <textarea class="k-input k-textarea" @bind="_s.NowText" maxlength="3000" rows="12" aria-label="Lige nu"></textarea>
    <label class="k-label">Billede eller film (vises over teksten)</label>
    @if (_s.NowMediaName.Length > 0)
    {
        <p class="k-help">@(_s.NowMediaType.StartsWith("video/") ? "🎬 Film" : "🖼️ Billede") lagt ind. <button class="k-btn k-btn-sm k-btn-ghost" @onclick="RemoveNowMedia">Fjern</button></p>
    }
    <InputFile OnChange="OnNowFileAsync" accept="image/*,video/*" />
    @if (_nowNote.Length > 0) { <p class="k-help">@_nowNote</p> }
    <label class="k-label">…eller et link til en video eller livestream</label>
    <input class="k-input" @bind="_s.NowLink" maxlength="500" placeholder="https://youtube.com/live/… eller https://twitch.tv/…" />
    <p class="k-help">YouTube-, Twitch- og Vimeo-links (også direkte udsendelser) afspilles på siden. Andre links bliver en "▶ Se med"-knap. Et link vises i stedet for billedet/filmen.
        <b>Sådan streamer du fra telefonen:</b> åbn YouTube-appen → <b>+</b> → <b>Gå live</b> (Go live), og kopiér linket til udsendelsen herind.</p>
    </details>
    <details class="k-mt" data-remember="adm-intro">
        <summary>Navn og introtekst</summary>
        <label class="k-label">Navn</label><input class="k-input" @bind="_s.Name" maxlength="80" />
        <label class="k-label">Intro (under navnet)</label><textarea class="k-input k-textarea" @bind="_s.Intro" maxlength="400"></textarea>
    </details>
    <button class="k-btn k-btn-primary k-mt" @onclick="SaveNowTextAsync">Gem</button>
    @if (_savedNote.Length > 0) { <span class="k-help"> @_savedNote</span> }
</section>

<section class="k-card" id="opslag">
    <div class="k-card-title">@(_edit.Id == 0 ? "➕ Nyt opslag" : "✏️ Ret opslag")</div>
    <p class="k-help">Vælg billeder, videoer, lyd eller dokumenter fra telefonen eller PC'en. Datoen bliver sat fra det første billede, hvis det har en – ellers i dag. Du kan rette den.</p>
    <label class="k-label">Overskrift (valgfri)</label>
    <input class="k-input" @bind="_edit.Title" maxlength="140" />
    <label class="k-label">Tekst</label>
    <textarea class="k-input k-textarea" @bind="_edit.Body" maxlength="8000"></textarea>
    <label class="k-label">Dato</label>
    <input class="k-input" type="date" value="@_edit.At.ToString("yyyy-MM-dd")" @onchange="OnDate" />
    <label class="k-label">Hvem må se det?</label>
    <div class="k-row">
        <label><input type="radio" name="vis" checked="@(_edit.Visibility == Visibility.Offentlig)" @onchange="() => _edit.Visibility = Visibility.Offentlig" /> 🌍 Alle</label>
        <label><input type="radio" name="vis" checked="@(_edit.Visibility == Visibility.Familie)" @onchange="() => _edit.Visibility = Visibility.Familie" /> 🔒 Kun familien</label>
    </div>
    @if (_edit.Media.Count > 0)
    {
        <div class="hj-edit-media">
            @foreach (var m in _edit.Media)
            {
                <span class="hj-chip">@(m.Kind switch { MediaKind.Billede => "🖼️", MediaKind.Video => "🎬", MediaKind.Lyd => "🎵", _ => "📄" }) @m.FileName
                    <button class="k-btn-ghost" title="Fjern" @onclick="() => RemoveMedia(m)">✕</button></span>
            }
        </div>
    }
    <label class="k-label">Tilføj filer</label>
    <InputFile OnChange="OnFilesAsync" multiple accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.txt" />
    @if (_uploadNote.Length > 0) { <p class="k-help">@_uploadNote</p> }
    <div class="k-row k-mt">
        <button class="k-btn k-btn-primary" disabled="@(_uploading || (_edit.Title.Trim().Length == 0 && _edit.Body.Trim().Length == 0 && _edit.Media.Count == 0))" @onclick="SavePostAsync">@(_edit.Id == 0 ? "Læg på siden" : "Gem ændringer")</button>
        @if (_edit.Id != 0 || _edit.Media.Count > 0) { <button class="k-btn k-btn-ghost" @onclick="NewPost">Annullér</button> }
    </div>
</section>

<section class="k-card">
    <div class="k-card-title">📚 Opslag (@_posts.Count)</div>
    @if (_posts.Count == 0) { <p class="k-help">Ingen opslag endnu – lav det første ovenfor.</p> }
    @foreach (var p in _posts)
    {
        <div class="appl-row hj-admin-post">
            <span>@p.At.ToString("d/M yyyy") @(p.Visibility == Visibility.Familie ? "🔒" : "🌍") <b>@(p.Title.Length > 0 ? p.Title : Short(p.Body))</b> <span class="k-help">@p.Media.Count filer</span></span>
            <span class="k-row">
                <button class="k-btn k-btn-sm" @onclick="() => EditAsync(p.Id)">Ret</button>
                @if (_confirmDeletePost == p.Id) { <button class="k-btn k-btn-sm k-btn-danger" @onclick="() => DeletePostAsync(p.Id)">Ja, slet</button> }
                else { <button class="k-btn k-btn-sm k-btn-ghost" @onclick="() => _confirmDeletePost = p.Id">Slet</button> }
            </span>
        </div>
    }
</section>

<section class="k-card" id="sider">
    <div class="k-card-title">📄 Sider (@_pages.Count)</div>
    <p class="k-help">Dine faste sider – Om mig, Kontakt, Ydelser, Priser … Adressen er fx <b>om-mig</b> eller <b>ydelser/cloud</b>; en side med "/" bliver vist under sin forælder. Skriv <b>## </b> for en overskrift, <b>*</b> for en punktliste, <b>**fed**</b> og <b>[tekst](/kontakt)</b> for et link.</p>
    @foreach (var p in _pages)
    {
        <div class="appl-row hj-admin-post">
            <span>@(p.InMenu ? "📌" : "")<b>@p.Title</b> <span class="k-help">/@p.Slug</span></span>
            <span class="k-row">
                <a class="k-btn k-btn-sm k-btn-ghost" href="/@p.Slug" target="_blank">Se</a>
                <button class="k-btn k-btn-sm" @onclick="() => EditPage(p)">Ret</button>
            </span>
        </div>
    }
    <button class="k-btn k-mt" @onclick="NewPage">➕ Ny side</button>

    @if (_pageEdit is not null)
    {
        <div class="hj-page-edit k-mt">
            <label class="k-label">Titel</label><input class="k-input" @bind="_pageEdit.Title" maxlength="120" />
            <label class="k-label">Adresse (efter itmartin.dk/)</label><input class="k-input" @bind="_pageEdit.Slug" maxlength="120" placeholder="fx ydelser/cloud" />
            <label class="k-label">Tekst</label>
            <textarea class="k-input k-textarea" @bind="_pageEdit.Body" rows="16"></textarea>
            <label class="k-label">Billede (sættes ind nederst i teksten)</label>
            <InputFile OnChange="OnPageImageAsync" accept="image/*" />
            <div class="k-row k-mt">
                <label><input type="checkbox" @bind="_pageEdit.InMenu" /> Vis i menuen</label>
                <label>Rækkefølge <input class="k-input" style="width:80px" type="number" @bind="_pageEdit.Sort" /></label>
            </div>
            @if (_pageNote.Length > 0) { <p class="k-help">@_pageNote</p> }
            <div class="k-row k-mt">
                <button class="k-btn k-btn-primary" @onclick="SavePageAsync">Gem siden</button>
                <button class="k-btn k-btn-ghost" @onclick="() => _pageEdit = null">Luk</button>
                @if (_pageEdit.Id != 0)
                {
                    @if (_confirmDeletePage) { <button class="k-btn k-btn-danger" @onclick="DeletePageAsync">Ja, slet siden</button> }
                    else { <button class="k-btn k-btn-ghost" @onclick="() => _confirmDeletePage = true">Slet</button> }
                }
            </div>
        </div>
    }
</section>

<section class="k-card" id="apps">
    <div class="k-card-title">🧩 Mine apps på siden</div>
    <p class="k-help">Siden <a href="/mine-apps" target="_blank">/mine-apps</a> viser de apps, der har flueben i "Vis". En app, der er slukket, vises som "sover lige nu" i stedet for en fejl. Ret tekst eller rækkefølge, og tryk Gem.</p>
    @foreach (var a in _appLinks)
    {
        <div class="hj-admin-app">
            <label><input type="checkbox" @bind="a.Show" /> Vis</label>
            <label title="Vågen = kan bruges fra siden"><input type="checkbox" @bind="a.Awake" /> Vågen</label>
            <input class="k-input hj-in-icon" @bind="a.Icon" maxlength="4" aria-label="Ikon" />
            <input class="k-input" @bind="a.Name" maxlength="60" aria-label="Navn" />
            <input class="k-input hj-in-sort" type="number" @bind="a.Sort" aria-label="Rækkefølge" />
            <input class="k-input hj-in-wide" @bind="a.Url" maxlength="200" aria-label="Adresse" />
            <input class="k-input hj-in-wide" @bind="a.Description" maxlength="200" aria-label="Beskrivelse" />
            <input class="k-input hj-in-wide" @bind="a.FreeText" maxlength="200" placeholder="Gratis: hvad kan man bruge den til uden at betale?" aria-label="Gratis" />
            <input class="k-input hj-in-wide" @bind="a.PaidText" maxlength="200" placeholder="Udvidet: hvad får man ekstra, hvis man spørger?" aria-label="Udvidet" />
        </div>
    }
    <div class="k-row k-mt">
        <button class="k-btn k-btn-primary" @onclick="SaveAppsAsync">Gem</button>
        <button class="k-btn" @onclick="AddApp">➕ Ny app</button>
        @if (_appsNote.Length > 0) { <span class="k-help">@_appsNote</span> }
    </div>
</section>

<section class="k-card">
    <div class="k-card-title">📱 Besked på telefonen</div>
    <p class="k-help">Slå det til på den telefon, du vil have besked på, når nogen skriver. <b>iPhone:</b> læg først siden på hjemskærmen (Del → Føj til hjemmeskærm), og åbn den derfra. <b>Android/PC:</b> tryk bare på knappen.</p>
    <p>Status: <b>@PushLabel</b></p>
    <div class="k-row">
        @if (_push is "off" or "error") { <button class="k-btn k-btn-primary" @onclick="SubscribeAsync">Slå beskeder til</button> }
        @if (_push == "on") { <button class="k-btn" @onclick="TestAsync">Send en prøve</button> }
    </div>
</section>

@code {
    // Razor encodes "&#10;" in an attribute literally - real line breaks come from a C# string.
    private const string PlanHint = "Skrive på MinElpris\nRinge til Bogshoppen\nØve guitar";

    [CascadingParameter] private Task<AuthenticationState>? AuthTask { get; set; }
    [SupplyParameterFromQuery(Name = "chat")] public int? ChatId { get; set; }

    private bool _owner, _uploading, _confirmDeleteThread;
    private Settings _s = new();
    private List<ChatThread> _threads = [];
    private ChatThread? _open;
    private int _openId, _unread, _confirmDeletePost;
    private string _reply = "", _savedNote = "", _uploadNote = "", _push = "…";
