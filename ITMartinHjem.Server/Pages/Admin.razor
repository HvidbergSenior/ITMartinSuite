    private List<Page> _pages = [];
    private Page? _pageEdit;
    private string _pageNote = "";
    private bool _confirmDeletePage;

    private async Task LoadPagesAsync()
    {
        _pages = await Owner.PagesAsync();
    }

    private void NewPage() { _pageEdit = new Page { Sort = 50 }; _pageNote = ""; _confirmDeletePage = false; }

    private void EditPage(Page p)
    {
        _pageEdit = new Page { Id = p.Id, Slug = p.Slug, Title = p.Title, Body = p.Body, InMenu = p.InMenu, Sort = p.Sort };
        Approve(p.Title, p.Body);
        _pageNote = ""; _confirmDeletePage = false;
    }

    private async Task OnPageImageAsync(InputFileChangeEventArgs e)
    {
        if (_pageEdit is null) return;
        try
        {
            await using var s = e.File.OpenReadStream(OwnerUseCases.MaxUploadBytes);
            var saved = await Owner.UploadAsync(s, e.File.Name, e.File.ContentType);
            // Always a date under the picture (user's wish): from the photo itself, else today.
            var caption = "📅 " + (saved.TakenAt ?? Dk.Today).ToString("d. MMMM yyyy", new System.Globalization.CultureInfo("da-DK"));
            _pageEdit.Body = _pageEdit.Body.TrimEnd() + $"\n\n![{caption}](/f/{saved.Media.StoredName})\n";
            _pageNote = "Billedet er sat ind nederst i teksten – flyt linjen, hvis det skal stå et andet sted. Husk Gem.";
        }
        catch (Exception ex) { _pageNote = $"Det lykkedes ikke: {ex.Message}"; }
    }

    private async Task SavePageAsync()
    {
        if (_pageEdit is null) return;
        _pageEdit.Title = await ReviewAsync(_pageEdit.Title, TextKind.Linje);
        _pageEdit.Body = await ReviewAsync(_pageEdit.Body, TextKind.Opslag);
        if (await Owner.SavePageAsync(_pageEdit) is { } error) { _pageNote = error; return; }
        _pageNote = "Gemt ✓";
        await LoadPagesAsync();
    }

    private async Task DeletePageAsync()
    {
        if (_pageEdit is null) return;
        await Owner.DeletePageAsync(_pageEdit.Id);
        _pageEdit = null;
        await LoadPagesAsync();
    }

    // ── apps ──
    private List<AppLink> _appLinks = [];
    private string _appsNote = "";

    private async Task LoadAppsAsync()
    {
        _appLinks = await Owner.AppsAsync();
        Approve(_appLinks.SelectMany(a => new[] { a.Description, a.FreeText, a.PaidText }).ToArray());
    }

    private void AddApp() => _appLinks.Add(new AppLink { Icon = "📱", Url = "https://", Sort = (_appLinks.Count + 1) * 10, Show = true });

    private async Task SaveAppsAsync()
    {
        foreach (var a in _appLinks)
        {
            a.Description = await ReviewAsync(a.Description, TextKind.Linje);
            a.FreeText = await ReviewAsync(a.FreeText, TextKind.Linje);
            a.PaidText = await ReviewAsync(a.PaidText, TextKind.Linje);
        }
        await Owner.SaveAppsAsync(_appLinks);
        await LoadAppsAsync();
        _appsNote = "Gemt ✓ (en ny app får sin status inden for 2 minutter)";
    }

