    // ── chat ──
    private async Task LoadThreadsAsync()
    {
        _threads = await Chat.ThreadsAsync();
        _unread = _threads.Count(t => t.UnreadForOwner);
    }

    private async Task OpenNewestUnreadAsync()
    {
        if (_threads.FirstOrDefault(t => t.UnreadForOwner) is { } t)
        {
            await OpenAsync(t.Id);
            StateHasChanged();
            await Task.Delay(80);   // let the messages render before scrolling to them
            await JS.InvokeVoidAsync("eval", "document.getElementById('hj-msgs')?.scrollIntoView({behavior:'smooth',block:'center'})");
        }
    }

    private async Task OpenAsync(int id)
    {
        _openId = id;
        _confirmDeleteThread = false;
        _open = await Chat.GetAsync(id);
        if (_open?.UnreadForOwner == true) { await Chat.MarkReadAsync(id); await LoadThreadsAsync(); }
    }

    private async Task ReplyAsync()
    {
        _reply = await ReviewAsync(_reply, TextKind.Chat);
        if (_reply.Trim().Length == 0) return;
        await Chat.OwnerWritesAsync(_openId, _reply);
        _reply = "";
    }

    // ── "Det spørger folk om": public, nameless Q&A (Application: PublicQuestions) ──
    private List<PublicQuestion> _qaAll = [];
    private List<string> _qaTopics = [];
    private bool _qaOpen;
    private int? _qaEditId;
    private int _qaConfirmRemove;
    private string _qaQ = "", _qaA = "", _qaTopic = "", _qaNote = "", _qaSite = QuestionRules.ITMartin;

    private async Task LoadQaAsync()
    {
        var f = await Questions.SearchAsync(null, null);
        _qaAll = f.Questions;
        _qaTopics = f.Topics.Select(t => t.Topic).ToList();
    }

    private async Task StartQaFromChatAsync()
    {
        if (_open is null) return;
        var d = Questions.DraftFromChat(_open.Messages.OrderBy(m => m.At).Select(m => (m.FromOwner, m.Text)), _open.Name);
        (_qaQ, _qaA, _qaTopic, _qaEditId, _qaOpen, _qaSite) = (d.Question, d.Answer, "", null, true, QuestionRules.ITMartin);
        _qaNote = "Læs teksten igennem, giv den et emne og tryk Læg op.";
        await JS.InvokeVoidAsync("eval", "document.getElementById('spoergsmaal')?.scrollIntoView({behavior:'smooth',block:'start'})");
    }

    private void EditQa(PublicQuestion q)
    {
        (_qaQ, _qaA, _qaTopic, _qaEditId, _qaOpen, _qaSite) = (q.Question, q.Answer, q.Topic, q.Id, true, q.Site);
        _qaNote = "";
    }

    private async Task SaveQaAsync()
    {
        try
        {
            var d = new PublicQuestions.Draft(_qaQ, _qaA, _qaTopic, _qaSite);
            if (_qaEditId is { } id) await Questions.UpdateAsync(id, d);
            else await Questions.PublishAsync(d, _openId == 0 ? null : _openId);
            _qaNote = _qaEditId is null ? "👁 Lagt op – uden navn ✓" : "Gemt ✓";
            _qaOpen = false;
            await LoadQaAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException) { _qaNote = "⚠️ " + ex.Message; }
    }

    private async Task RemoveQaAsync(int id)
    {
        await Questions.RemoveAsync(id);
        _qaConfirmRemove = 0;
        _qaNote = "Fjernet fra siden.";
        await LoadQaAsync();
    }

    private async Task DeleteThreadAsync()
    {
        await Chat.DeleteAsync(_openId);
        _open = null; _openId = 0; _confirmDeleteThread = false;
    }

    private void OnChatChanged(int id) => InvokeAsync(async () =>
    {
        await LoadThreadsAsync();
        if (id == _openId)
        {
            _open = await Chat.GetAsync(id);
            if (_open?.UnreadForOwner == true) { await Chat.MarkReadAsync(id); await LoadThreadsAsync(); }
        }
        StateHasChanged();
    });

    // ── posts ──
    private async Task LoadPostsAsync()
    {
        _posts = await Owner.PostsAsync();
    }

    private void OnDate(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d)) { _edit.At = d; _dateTouched = true; }
    }

    private async Task OnFilesAsync(InputFileChangeEventArgs e)
    {
        _uploading = true;
        var files = e.GetMultipleFiles(50);
        var i = 0;
        foreach (var f in files)
        {
            i++;
            _uploadNote = $"Lægger op {i}/{files.Count}: {f.Name}…";
            StateHasChanged();
            try
            {
                await using var s = f.OpenReadStream(OwnerUseCases.MaxUploadBytes);
                var saved = await Owner.UploadAsync(s, f.Name, f.ContentType);
                saved.Media.Sort = _edit.Media.Count;
                _edit.Media.Add(saved.Media);
                if (!_dateTouched && _edit.Id == 0 && saved.TakenAt is { } t) { _edit.At = t.Date; _dateTouched = true; }
            }
            catch (Exception ex) { _uploadNote = $"{f.Name} kunne ikke lægges op: {ex.Message}"; _uploading = false; return; }
        }
        _uploadNote = $"{files.Count} {(files.Count == 1 ? "fil" : "filer")} klar – tryk \"{(_edit.Id == 0 ? "Læg på siden" : "Gem ændringer")}\".";
        _uploading = false;
    }

    private void RemoveMedia(Media m)
    {
        _edit.Media.Remove(m);
        _removed.Add(m);
    }

    private async Task SavePostAsync()
    {
        _edit.Title = await ReviewAsync(_edit.Title, TextKind.Linje);
        _edit.Body = await ReviewAsync(_edit.Body, TextKind.Opslag);
        await Owner.SavePostAsync(_edit, _removed);
        _edit = NewDraft(); _removed.Clear();   // saved: its files stay
        NewPost();
        await LoadPostsAsync();
        _uploadNote = "Lagt på siden ✓";
    }

    private void NewPost()
    {
        // Files uploaded to a draft that was never saved: throw them away again.
        Owner.DropDraft(_edit);
        _edit = NewDraft(); _removed.Clear(); _dateTouched = false; _uploadNote = "";
    }

    private async Task EditAsync(int id)
    {
        NewPost();
        if (await Owner.PostAsync(id) is not { } post) return;
        _edit = post;
        Approve(_edit.Title, _edit.Body);
        _dateTouched = true;
        Nav.NavigateTo("/admin#opslag");
    }

    private async Task DeletePostAsync(int id)
    {
        await Owner.DeletePostAsync(id);
        _confirmDeletePost = 0;
        await LoadPostsAsync();
    }

    private static string Short(string s) => s.Length > 50 ? s[..50] + "…" : s.Length > 0 ? s : "(kun filer)";

