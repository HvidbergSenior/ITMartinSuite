    // ── chat ──
    private async Task LoadThreadsAsync()
    {
        _threads = await Chat.ThreadsAsync();
        _unread = _threads.Count(t => t.UnreadForOwner);
    }

    private async Task OpenNewestUnreadAsync()
    {
        if (_threads.FirstOrDefault(t => t.UnreadForOwner) is { } t)
        {
            await OpenAsync(t.Id);
            StateHasChanged();
            await Task.Delay(80);   // let the messages render before scrolling to them
            await JS.InvokeVoidAsync("eval", "document.getElementById('hj-msgs')?.scrollIntoView({behavior:'smooth',block:'center'})");
        }
    }

    private async Task OpenAsync(int id)
    {
        _openId = id;
        _confirmDeleteThread = false;
        _open = await Chat.GetAsync(id);
        if (_open?.UnreadForOwner == true) { await Chat.MarkReadAsync(id); await LoadThreadsAsync(); }
    }

    private async Task ReplyAsync()
    {
        _reply = await ReviewAsync(_reply, TextCheck.Kind.Chat);
        if (_reply.Trim().Length == 0) return;
        await Chat.OwnerWritesAsync(_openId, _reply);
        _reply = "";
    }

    private async Task DeleteThreadAsync()
    {
        await Chat.DeleteAsync(_openId);
        _open = null; _openId = 0; _confirmDeleteThread = false;
    }

    private void OnChatChanged(int id) => InvokeAsync(async () =>
    {
        await LoadThreadsAsync();
        if (id == _openId)
        {
            _open = await Chat.GetAsync(id);
            if (_open?.UnreadForOwner == true) { await Chat.MarkReadAsync(id); await LoadThreadsAsync(); }
        }
        StateHasChanged();
    });

    // ── posts ──
    private async Task LoadPostsAsync()
    {
        await using var db = await Dbf.CreateDbContextAsync();
        _posts = await db.Posts.Include(p => p.Media).AsNoTracking().OrderByDescending(p => p.At).ToListAsync();
    }

    private void OnDate(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d)) { _edit.At = d; _dateTouched = true; }
    }

    private async Task OnFilesAsync(InputFileChangeEventArgs e)
    {
        _uploading = true;
        var files = e.GetMultipleFiles(50);
        var i = 0;
        foreach (var f in files)
        {
            i++;
            _uploadNote = $"Lægger op {i}/{files.Count}: {f.Name}…";
            StateHasChanged();
            try
            {
                await using var s = f.OpenReadStream(MediaStore.MaxBytes);
                var saved = await Store.SaveAsync(s, f.Name, f.ContentType);
                saved.Media.Sort = _edit.Media.Count;
                _edit.Media.Add(saved.Media);
                if (!_dateTouched && _edit.Id == 0 && saved.TakenAt is { } t) { _edit.At = t.Date; _dateTouched = true; }
            }
            catch (Exception ex) { _uploadNote = $"{f.Name} kunne ikke lægges op: {ex.Message}"; _uploading = false; return; }
        }
        _uploadNote = $"{files.Count} {(files.Count == 1 ? "fil" : "filer")} klar – tryk \"{(_edit.Id == 0 ? "Læg på siden" : "Gem ændringer")}\".";
        _uploading = false;
    }

    private void RemoveMedia(Media m)
    {
        _edit.Media.Remove(m);
        _removed.Add(m);
    }

    private async Task SavePostAsync()
    {
        _edit.Title = await ReviewAsync(_edit.Title, TextCheck.Kind.Linje);
        _edit.Body = await ReviewAsync(_edit.Body, TextCheck.Kind.Opslag);
        await using var db = await Dbf.CreateDbContextAsync();
        if (_edit.Id == 0)
        {
            db.Posts.Add(_edit);
        }
        else
        {
            var p = await db.Posts.Include(x => x.Media).FirstAsync(x => x.Id == _edit.Id);
            p.Title = _edit.Title; p.Body = _edit.Body; p.At = _edit.At; p.Visibility = _edit.Visibility;
            foreach (var gone in p.Media.Where(m => _removed.Any(r => r.Id == m.Id)).ToList()) { p.Media.Remove(gone); db.Media.Remove(gone); }
            foreach (var added in _edit.Media.Where(m => m.Id == 0)) p.Media.Add(added);
        }
        await db.SaveChangesAsync();
        foreach (var r in _removed) Store.Delete(r);
        NewPost();
        await LoadPostsAsync();
        _uploadNote = "Lagt på siden ✓";
    }

    private void NewPost()
    {
        // Files uploaded to a draft that was never saved: throw them away again.
        foreach (var m in _edit.Media.Where(m => m.Id == 0)) Store.Delete(m);
        _edit = NewDraft(); _removed.Clear(); _dateTouched = false; _uploadNote = "";
    }

    private async Task EditAsync(int id)
    {
        NewPost();
        await using var db = await Dbf.CreateDbContextAsync();
        _edit = await db.Posts.Include(p => p.Media.OrderBy(m => m.Sort)).AsNoTracking().FirstAsync(p => p.Id == id);
        Approve(_edit.Title, _edit.Body);
        _dateTouched = true;
        Nav.NavigateTo("/admin#opslag");
    }

    private async Task DeletePostAsync(int id)
    {
        await using var db = await Dbf.CreateDbContextAsync();
        var p = await db.Posts.Include(x => x.Media).FirstAsync(x => x.Id == id);
        foreach (var m in p.Media) Store.Delete(m);
        db.Posts.Remove(p);
        await db.SaveChangesAsync();
        _confirmDeletePost = 0;
        await LoadPostsAsync();
    }

    private static string Short(string s) => s.Length > 50 ? s[..50] + "…" : s.Length > 0 ? s : "(kun filer)";

    // ── pages ──
    private List<Page> _pages = [];
    private Page? _pageEdit;
    private string _pageNote = "";
    private bool _confirmDeletePage;

    private async Task LoadPagesAsync()
    {
        await using var db = await Dbf.CreateDbContextAsync();
        _pages = await db.Pages.AsNoTracking().OrderBy(p => p.Slug).ToListAsync();
    }

    private void NewPage() { _pageEdit = new Page { Sort = 50 }; _pageNote = ""; _confirmDeletePage = false; }

    private void EditPage(Page p)
    {
        _pageEdit = new Page { Id = p.Id, Slug = p.Slug, Title = p.Title, Body = p.Body, InMenu = p.InMenu, Sort = p.Sort };
        Approve(p.Title, p.Body);
        _pageNote = ""; _confirmDeletePage = false;
    }

    private async Task OnPageImageAsync(InputFileChangeEventArgs e)
    {
        if (_pageEdit is null) return;
        try
        {
            await using var s = e.File.OpenReadStream(MediaStore.MaxBytes);
            var saved = await Store.SaveAsync(s, e.File.Name, e.File.ContentType);
            // Always a date under the picture (user's wish): from the photo itself, else today.
            var caption = "📅 " + (saved.TakenAt ?? DateTime.Today).ToString("d. MMMM yyyy", new System.Globalization.CultureInfo("da-DK"));
            _pageEdit.Body = _pageEdit.Body.TrimEnd() + $"\n\n![{caption}](/f/{saved.Media.StoredName})\n";
            _pageNote = "Billedet er sat ind nederst i teksten – flyt linjen, hvis det skal stå et andet sted. Husk Gem.";
        }
        catch (Exception ex) { _pageNote = $"Det lykkedes ikke: {ex.Message}"; }
    }

    private async Task SavePageAsync()
    {
        if (_pageEdit is null) return;
        _pageEdit.Title = await ReviewAsync(_pageEdit.Title, TextCheck.Kind.Linje);
        _pageEdit.Body = await ReviewAsync(_pageEdit.Body, TextCheck.Kind.Opslag);
        var slug = System.Text.RegularExpressions.Regex.Replace(_pageEdit.Slug.Trim().Trim('/').ToLowerInvariant(), @"[^a-z0-9æøå/\-]", "-");
        if (slug.Length == 0 || _pageEdit.Title.Trim().Length == 0) { _pageNote = "Siden skal have en titel og en adresse."; return; }
        if (slug is "admin" or "chat" or "login" or "logout" or "api" or "m" or "f" or "nu" || slug.StartsWith("api/") || slug.StartsWith("kolibri"))
        { _pageNote = $"Adressen \"{slug}\" bruges af appen selv – vælg en anden."; return; }
        await using var db = await Dbf.CreateDbContextAsync();
        if (await db.Pages.AnyAsync(p => p.Slug == slug && p.Id != _pageEdit.Id)) { _pageNote = "Der findes allerede en side med den adresse."; return; }
        var page = _pageEdit.Id == 0 ? db.Pages.Add(new Page()).Entity : await db.Pages.FirstAsync(p => p.Id == _pageEdit.Id);
        page.Slug = slug; page.Title = _pageEdit.Title.Trim(); page.Body = _pageEdit.Body; page.InMenu = _pageEdit.InMenu; page.Sort = _pageEdit.Sort;
        page.UpdatedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();
        _pageEdit.Id = page.Id; _pageEdit.Slug = slug;
        _pageNote = "Gemt ✓";
        await LoadPagesAsync();
    }

    private async Task DeletePageAsync()
    {
        if (_pageEdit is null) return;
        await using var db = await Dbf.CreateDbContextAsync();
        await db.Pages.Where(p => p.Id == _pageEdit.Id).ExecuteDeleteAsync();
        _pageEdit = null;
        await LoadPagesAsync();
    }

    // ── apps ──
    private List<AppLink> _appLinks = [];
    private string _appsNote = "";

    private async Task LoadAppsAsync()
    {
        await using var db = await Dbf.CreateDbContextAsync();
        _appLinks = await db.AppLinks.AsNoTracking().OrderBy(a => a.Sort).ToListAsync();
        Approve(_appLinks.SelectMany(a => new[] { a.Description, a.FreeText, a.PaidText }).ToArray());
    }

    private void AddApp() => _appLinks.Add(new AppLink { Icon = "📱", Url = "https://", Sort = (_appLinks.Count + 1) * 10, Show = true });

    private async Task SaveAppsAsync()
    {
        foreach (var a in _appLinks)
        {
            a.Description = await ReviewAsync(a.Description, TextCheck.Kind.Linje);
            a.FreeText = await ReviewAsync(a.FreeText, TextCheck.Kind.Linje);
            a.PaidText = await ReviewAsync(a.PaidText, TextCheck.Kind.Linje);
        }
        await using var db = await Dbf.CreateDbContextAsync();
        foreach (var a in _appLinks.Where(a => a.Name.Trim().Length > 0 && a.Url.StartsWith("http")))
        {
            if (a.Id == 0) db.AppLinks.Add(a); else db.AppLinks.Update(a);
        }
        await db.SaveChangesAsync();
        await LoadAppsAsync();
        _appsNote = "Gemt ✓ (en ny app får sin status inden for 2 minutter)";
    }

