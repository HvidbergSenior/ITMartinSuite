@page "/mine-apps"
@inject IDbContextFactory<HjemDb> Dbf
@inject AppStatus Status

<PageTitle>Mine apps · Martin Hvidberg</PageTitle>

@* Principle (user 2026-09-28): every app is useful for free; a paid version is something you ask for. *@
<article class="k-card hj-page">
    <h1>Mine apps</h1>
    <p>Alle mine apps er <b>gratis at bruge</b> – og den gratis udgave kan noget i sig selv. Vil du have mere, findes der en <b>udvidet udgave</b>, som du kan spørge mig om.</p>
    <p class="k-help"><span class="k-dot on hj-dot"></span> kører nu · <span class="k-dot hj-dot"></span> sover lige nu – jeg gør dem klar, så de er nemme at bruge. Nysgerrig? <a href="/#chat">Chat med mig</a>.</p>
</article>

<div class="hj-apps">
    @foreach (var a in _apps)
    {
        // Asleep unless Martin has woken it (Kontrol / Svar) AND the container answers.
        // No address = a showcase only (Polstrer, user 2026-10-08: "close polstrer for other users"): shown, never opened.
        var showcase = a.Url.Length == 0;
        var up = a.Awake && (showcase || Status.IsUp(a.Url) != false);   // a showcase sleeps too when Martin says so
        @* Every app is a show/hide box: closed shows only icon + name (user 2026-10-05: "way too much text in one go"). *@
        <div class="k-card hj-app @(up ? "" : "off")" data-fold-closed="1">
            <h3 class="hj-app-head"><span class="hj-app-icon">@a.Icon</span> @a.Name <span class="k-dot hj-dot @(up ? "on" : "")" title="@(up ? "Kører nu" : "Sover")"></span></h3>
            <div class="hj-app-body">
                <div class="k-help">@a.Description</div>
                <div class="hj-app-tier"><span class="k-tag">Gratis</span> @(a.FreeText.Length > 0 ? a.FreeText : "Kom i gang med det samme – ingen betaling.")</div>
                <div class="hj-app-tier"><span class="k-tag hj-tag-plus">Udvidet</span> @(a.PaidText.Length > 0 ? a.PaidText : "Har du brug for mere, laver vi en udvidet udgave til dig.")</div>
                <div class="k-row k-mt">
                    @if (showcase && up) { <span class="k-help"><i>🔒 Eksempel – appen bruges kun af den, den er lavet til.</i></span> }
                    else if (up && !showcase) { <a class="k-btn k-btn-sm k-btn-primary" href="@a.Url" target="_blank" rel="noopener">Brug gratis</a> }
                    else { <span class="k-help"><i>😴 Sover lige nu – kommer snart</i></span> }
                    <a class="k-btn k-btn-sm" href="/#chat">@(showcase ? "Spørg om din egen app" : "Spørg om udvidet")</a>
                </div>
            </div>
        </div>
    }
</div>

<p class="k-center k-mt"><a class="k-btn k-btn-primary" href="/bliv-pilot/">🐦 Vil du være pilot og prøve en app sammen med mig?</a></p>

@code {
    private List<AppLink> _apps = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbf.CreateDbContextAsync();
        _apps = await db.AppLinks.AsNoTracking().Where(a => a.Show).OrderBy(a => a.Sort).ToListAsync();
    }
}
