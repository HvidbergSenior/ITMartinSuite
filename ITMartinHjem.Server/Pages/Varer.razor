@page "/varer"
@inject ShopUseCases Shop
@inject NavigationManager Nav
@inject IJSRuntime JS

@* bogshoppen.dk "Varer" = the marketplace (2026-10-20, user: "a place where they easily can see products in different
   categories - look autoproff.com") on top of the real stock from Bogshoppen Lager (2026-10-15, user: "people be able to search
   products and make offer -> here the links and so on can be seen. So sales should be instant buy or bet").
   Køb nu here; Byd (pre-bid for the Saturday live auction) comes next. *@
<PageTitle>Varer · Bogshoppen</PageTitle>

@if (!_show)
{
    @* Not shown yet (user 2026-10-15: "dont show varer yet") - the teaser from 2026-10-12 until Hjem__ShowFound=true. *@
    <header class="bs-head bs-head-varer">
        <span class="bs-tag">Liveauktioner – snart</span>
        <h1>Varer</h1>
        <p>Varerne bliver vist her snart – med billede, pris og links til andre butikker.</p>
    </header>

    <section class="k-card bs-card">
        <h2>Det kommer der på</h2>
        <div>
        <ul class="bs-products">
            @foreach (var (title, example) in BogshoppenRules.Products)
            {
                <li><b>@title</b> <span>– fx @example</span></li>
            }
        </ul>
        <p class="k-help">Leder du efter noget bestemt? Skriv det i chatten – så kigger vi efter det, mens vi registrerer.</p>
        <a class="k-btn k-btn-sm" href="/#chat">Skriv i chatten</a>
        </div>
    </section>

    <section class="k-card bs-card">
        <h2>Vores prisløfte – og du kan se det selv</h2>
        <ul class="bs-promise">
            <li><b>Ved hver vare viser vi links</b> til andre sider, der sælger den samme vare – og <b>vores pris er 10 % lavere</b>.</li>
            <li><b>Har du fundet den billigere et andet sted?</b> Send os linket – så tager vi udgangspunkt i den pris og sælger <b>10 % under</b>.</li>
            <li><b>Jo flere varer du køber, jo større rabat.</b></li>
        </ul>
    </section>

    <p class="k-center"><a class="k-btn k-btn-primary bs-btn" href="/#foelg">Skriv dig op – og få et login til liveauktionerne</a></p>
    return;
}

<header class="bs-head bs-head-varer">
    <span class="bs-tag">Markedet</span>
    <h1>Varer</h1>
    <p>Alt det, vi har registreret – sorteret efter slags. Ved hver vare kan du se, hvad den koster andre steder, og vores pris er 10 % lavere.</p>
</header>

@if (_market is { Today.Count: > 0 })
{
    @* Today's offers (user 2026-10-20: "books monday -> 50 pct ... Monday 10 for 800 ... 31. in every month 10 for 300"). *@
    <section class="bs-offers" aria-label="Dagens tilbud">
        <h2>Dagens tilbud</h2>
        <ul>@foreach (var o in _market.Today) { <li><b>@o.Text</b> – @o.When.ToLowerInvariant()</li> }</ul>
        <p class="k-help">Bundter regnes ud i kurven: læg tingene i, så ser du prisen. De dyreste ting kommer i bundtet først.</p>
    </section>
}

<section class="k-card bs-card">
    <h2>Vælg en slags</h2>
    <div>
        <p class="k-help">Tryk på en slags for kun at se den. Tryk Alt for at se det hele igen.</p>
        <div class="bs-types">
            <button class="bs-type" aria-pressed="@(_type == "" ? "true" : "false")" @onclick='() => Go("", _q, _sort)'><b>Alt</b><span>@(_market?.Types.Sum(t => t.Count) ?? 0) varer</span></button>
            @foreach (var t in _market?.Types ?? [])
            {
                <button class="bs-type" aria-pressed="@(_type == t.Type ? "true" : "false")" @onclick="() => Go(t.Type, _q, _sort)"><b>@t.Type</b><span>@t.Count varer</span></button>
            }
        </div>
    </div>
</section>

<section class="k-card bs-card">
    <h2>Søg og sortér</h2>
    <div>
        <p class="k-help">Skriv en titel, et nummer, en forfatter eller et år – fx <i>Anders And 1972</i> eller <i>Pratchett</i> – og tryk Søg.</p>
        <form class="bs-tools" method="get" action="/varer" @onsubmit="() => Go(_type, _q, _sort)" @onsubmit:preventDefault>
            <input class="k-input" name="q" @bind="_q" placeholder="Hvad leder du efter?" aria-label="Søg i varerne" />
            <select class="k-input" @bind="_sort" @bind:after="() => Go(_type, _q, _sort)" aria-label="Sortér">
                <option value="@ShopSorts.Newest">Nyeste først</option>
                <option value="@ShopSorts.Cheapest">Billigste først</option>
                <option value="@ShopSorts.Dearest">Dyreste først</option>
                <option value="@ShopSorts.Title">Titel A-Å</option>
            </select>
            <button class="k-btn k-btn-primary" type="submit">Søg</button>
        </form>
        @* New or used (user 2026-10-20: "there should be a used and new field"). *@
        <div class="bs-tools" role="group" aria-label="Ny eller brugt">
            @foreach (var (label, value) in new[] { ("Både nyt og brugt", ""), ("Kun brugt", Usages.Used), ("Kun nyt", Usages.New) })
            {
                <button class="k-btn k-btn-sm @(_usage == value ? "k-btn-primary" : "")" aria-pressed="@(_usage == value ? "true" : "false")" @onclick="() => Go(_type, _q, _sort, value)">@label</button>
            }
        </div>
    </div>
</section>

@if (_error is not null)
{
    <p class="k-center k-help" role="alert">@_error</p>
}
else if (_market is null)
{
    <p class="k-center k-help">Henter varerne …</p>
}
else
{
    <section class="k-card bs-card">
        <h2>@(_market.Total == 0 ? "Ingen varer fundet" : $"{_market.Total} varer{(_type != "" ? " – " + _type.ToLowerInvariant() : "")}")</h2>
        <div>
            @if (_market.Total == 0)
            {
                <p>Vi har ikke fundet noget, der passer. Prøv med færre ord eller en anden slags – eller skriv i chatten, hvad du leder efter.</p>
                <a class="k-btn k-btn-sm" href="/#chat">Skriv i chatten</a>
            }
            else
            {
                <p class="k-help">Tryk på en vare for at se priserne andre steder. Tryk <b>Læg i kurven</b> for at købe flere ting på én gang@(_basket > 0 ? $" – du har {_basket} i kurven" : "").</p>
                <ul class="bs-cards">
                    @foreach (var i in _items) { <ShopCard Item="i" CanBuy="_market.CanPay" Added="n => _basket = n" /> }
                </ul>
                @if (_items.Count < _market.Total)
                {
                    <p class="k-center"><button class="k-btn bs-btn" @onclick="More" disabled="@_busy">@(_busy ? "Henter …" : $"Vis flere ({_market.Total - _items.Count} mere)")</button></p>
                }
                @if (_basket > 0) { <p class="k-center"><a class="k-btn k-btn-primary bs-btn" href="/kurv">Gå til kurven (@_basket)</a></p> }
            }
        </div>
    </section>
}

<section class="k-card bs-card">
    <h2>Vores prisløfte – og du kan se det selv</h2>
    <ul class="bs-promise">
        <li><b>Ved hver vare viser vi links</b> til andre sider, der sælger den samme vare – og <b>vores pris er 10 % lavere</b>.</li>
        <li><b>Har du fundet den billigere et andet sted?</b> Send os linket – så tager vi udgangspunkt i den pris og sælger <b>10 % under</b>.</li>
        <li><b>Køb nu</b> betaler du med kort eller MobilePay – én ting eller en hel kurv. <b>Snart kan du også byde</b> på lørdagens liveauktion.</li>
    </ul>
</section>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "brugt")] public string? Brugt { get; set; }

    private string _q = "", _type = "", _sort = ShopSorts.Newest, _usage = "";
    private ShopMarket? _market;
    private List<ShopItem> _items = [];
    private int _page, _basket;
    private bool _show, _busy;
    private string? _error;

    [CascadingParameter(Name = "ShopVisible")] private bool ShopVisible { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _show = ShopVisible;
        if (!_show) return;
        (_q, _type, _sort, _page) = (Q ?? "", Type ?? "", ShopSorts.All.Contains(Sort) ? Sort! : ShopSorts.Newest, 0);
        _usage = Usages.All.Contains(Brugt) ? Brugt! : "";
        (_market, _error) = await Shop.MarketAsync(_type, null, _usage, _q, _sort, 0);
        _items = _market?.Items ?? [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_show) return;
        try { _basket = await JS.InvokeAsync<int>("bsKurv.count"); StateHasChanged(); } catch (JSException) { }
    }

    private void Go(string type, string q, string sort) => Go(type, q, sort, _usage);

    private void Go(string type, string q, string sort, string usage)
    {
        var parts = new List<string>();
        if (type != "") parts.Add("type=" + Uri.EscapeDataString(type));
        if (usage != "") parts.Add("brugt=" + Uri.EscapeDataString(usage));
        if (q.Trim() != "") parts.Add("q=" + Uri.EscapeDataString(q.Trim()));
        if (sort != ShopSorts.Newest) parts.Add("sort=" + sort);
        Nav.NavigateTo("/varer" + (parts.Count > 0 ? "?" + string.Join("&", parts) : ""));
    }

    private async Task More()
    {
        _busy = true;
        var (next, error) = await Shop.MarketAsync(_type, null, _usage, _q, _sort, _page + 1);
        if (next is not null) { _page++; _items.AddRange(next.Items); }
        _error = error;
        _busy = false;
    }
}
