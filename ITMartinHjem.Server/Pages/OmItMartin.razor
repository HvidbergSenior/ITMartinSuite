@page "/om-itmartin"
@inject SiteUseCases Site

@* The "Om mig" tab (user 2026-10-27: "should there be more tabs and fewer boxes?" -> "do it"): who Martin is ("Hvem er ITMartin?"
   tabs from the forside page in Svar), the tiles about his work and other sites, and his posts. The front page keeps only the
   head box, Vidste du and the sign-up. *@
<PageTitle>Om mig · Martin Hvidberg</PageTitle>
<PageHead Title="Om mig" Tag="Hvem er ITMartin?" Line="Hvem jeg er, hvad jeg laver – og hvad jeg har lavet." />

<CascadingValue Name="Plain" Value="true">
@* How to reach Martin first (2026-10-27: the old "Om mig og kontakt" page is part of this tab now, /om-mig redirects here). *@
<section class="k-card" id="kontakt" data-nofold>
    <h2 class="k-card-title">Kontakt mig</h2>
    <p class="k-help">Skriv, ring eller send en mail – første snak er altid gratis.</p>
    <div class="k-row k-mt">
        <a class="k-btn k-btn-primary" href="/chat-med-martin">Chat med mig</a>
        <a class="k-btn" href="mailto:ITMartin@Mensa.dk">ITMartin@Mensa.dk</a>
        <a class="k-btn" href="tel:+4531194730">31 19 47 30</a>
    </div>
</section>

@if (_hero is not null)
{
    @* Tabs instead of one long text (user 2026-10-27: "hvem er ITMartin as tabs maybe?") - show/hide like every box, one tab at a time. *@
    <section class="k-card hj-page hj-sec hj-hero">
        <h2>Hvem er ITMartin?</h2>
        <HeroTabs Body="@_hero.Body" />
    </section>
}

@* Martin's own "Om mig og kontakt" text (Svar -> Sider -> om-mig), each "## " part a show/hide box. *@
@if (_about is not null)
{
    var (intro, parts) = Sections.Split(_about.Body);
    @if (intro.Length > 0) { <section class="k-card hj-page">@TinyMarkdown.Render(intro)</section> }
    <SectionBoxes Parts="parts" FirstOpen="false" />
}

<WorkTiles />
</CascadingValue>

@if (_posts.Count > 0)
{
    <h2 class="hj-h2">Seneste</h2>
    @foreach (var p in _posts.Take(3)) { <PostCard Post="p" /> }

    @if (_posts.Count > 3)
    {
        <h2 class="hj-h2">Tidslinje</h2>
        <p class="k-help">Tryk på et år for at se, hvad der skete.</p>
        @foreach (var year in _posts.Skip(3).GroupBy(p => p.At.Year))
        {
            <details class="hj-year" data-remember="year-@year.Key">
                <summary><b>@year.Key</b> <span class="k-muted">· @year.Count() opslag</span></summary>
                @foreach (var p in year) { <PostCard Post="p" /> }
            </details>
        }
    }
}

@if (!_family && _hiddenFamily > 0)
{
    <div class="k-card hj-lock" data-nofold>
        <p><b>@_hiddenFamily familieopslag</b> er kun for familien.</p>
        <a class="k-btn k-btn-sm" href="/login">Skriv familiens kodeord</a>
    </div>
}
else if (_family && !_owner)
{
    <p class="k-help k-center">Du ser familiens billeder. <a class="k-btn k-btn-sm" href="/logout">Log ud</a></p>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthTask { get; set; }

    private Page? _hero;   // Svar -> Sider -> "forside"
    private Page? _about;  // Svar -> Sider -> "om-mig"
    private List<Post> _posts = [];
    private int _hiddenFamily;
    private bool _family, _owner;

    protected override async Task OnInitializedAsync()
    {
        var user = AuthTask is null ? null : (await AuthTask).User;
        _family = user.IsFamily();
        _owner = user.IsOwner();
        var front = await Site.FrontAsync(_family);
        (_hero, _posts, _hiddenFamily) = (front.Hero, front.Posts, front.HiddenFamily);
        _about = await Site.PageBySlugAsync("om-mig");
    }
}
