@page "/"
@implements IDisposable
@inject IDbContextFactory<HjemDb> Dbf
@inject ChatService Chat
@inject NavigationManager Nav

@* First screen = one answer: who I am and what I am doing now. The timeline and the
   chat come after it; old years are folded and the phone remembers what was open. *@

@if (BogshoppenHome.IsHost(new Uri(Nav.Uri).Host)) { <BogshoppenHome /> return; }

@* Temporary birthday front - switches itself off after Hjem:FestUntil (default 2026-09-30 23:59). *@
<Fest />

<header class="hj-head">
    @* Theme "idag" (user 2026-10-05): "Det er mandag, hvad skal jeg mon lave i dag og hvad skal jeg lave i denne uge? Spændende" *@
    <span class="hj-tagline">Det er @Today.ToString("dddd", Da)</span>
    @* The heading is the "Forside" page's title in Svar -> Sider (user: "ITMartin - Den digitale kolibri"). *@
    <h1>@(_hero?.Title is { Length: > 0 } t && t != "Forside" ? t : _s.Name)</h1>
    @if (_s.Intro.Length > 0) { <p class="hj-intro">@_s.Intro</p> }
    @if (_owner) { <a class="k-btn k-btn-sm" href="/admin">Skriv opslag / svar beskeder</a> }
</header>

@* Bogshoppen teaser + "Ingen reklamer" headline box removed 2026-10-07 (user: "way too many tabs and info");
   both pages still exist (/foelg-samarbejdet, /ingen-reklamer). *@


@* "Denne uge" is on the ITKolibrien tab, not here (user 2026-10-05). *@



@* "Martin er her nu" right under the name, so every visitor sees it (user 2026-09-28). *@
@* The front page = three questions (user 2026-10-12): "Vil du chatte? Skal jeg streame? Skal jeg hjælpe dig remote?" *@
<CascadingValue Name="Plain" Value="true">
@* Storage request for the Bogshoppen boxes, right under the head box on both sites (user 2026-10-14). *@
<StorageHelp />

@* Things from the Bogshoppen boxes Martin chose in Lager - same box as on bogshoppen.dk (user 2026-10-15). *@
<FoundInBoxes />

@* Who Martin is - at the top under the head box since 2026-10-12 (user: "Top Hvem er ITMartin"); folded, so the first screen is just today + this week (user 2026-10-05). *@
@if (_hero is not null)
{
    @* Same kind of box as the rest (user 2026-10-08): a card with a heading that kolibri.js folds, starting closed. *@
    <section class="k-card hj-page hj-sec hj-hero" data-fold-closed="1">
        <h2>Hvem er ITMartin?</h2>
        <div>@TinyMarkdown.Render(_hero.Body)</div>
    </section>
}

@* Today's plan moved to the "📅 I dag" tab (/hvad-laver-itkolibrien) 2026-10-12 (user). *@

@* Chat, stream and remote help in ONE box (user 2026-10-12), the three questions as sub-headings. *@
<section class="k-card hj-trio">
    <h2 class="k-card-title">Chat, stream eller hjælp på din skærm</h2>
    <div class="hj-trio-parts">
        <ChatBox Available="_s.Available" OwnerName="@FirstName" Prominent="true" Embedded="true" Title="Vil du chatte?" Photo="/f/1992b2f17f9cca20.jpg">
            @* The app challenge lives in the chat (user 2026-10-14: "Udfordringen kan være i chatten"); also on Mine apps. *@
            <p class="hj-chat-challenge"><b>Udfordring:</b> Find en mobilapp, send mig navnet her i chatten – og lad mig lave en version af den, som du vil have den :-)</p>
        </ChatBox>
        <div class="hj-part hj-stream">
            <h3 class="hj-part-title">Skal jeg streame?</h3>
            <LiveCard />
            <p class="k-help">Vil du se mig arbejde på en app – eller have mig til at vise noget bestemt? Skriv det i chatten, så går jeg live.</p>
            <a class="k-btn k-btn-sm" href="#chat">Skriv det i chatten</a>
        </div>
        <SeMedTip Embedded="true" />
    </div>
</section>

@* Public Q&A from the chat, no names (user 2026-10-12): shown once Martin has put the first one up. *@
<QuestionsBox ShowEmpty="true" AllSites="true" />


@* Apps are only on the Mine apps tab (user 2026-10-04: "Forsiden skal heller ikke have mine apps"). *@



@* Small boxes instead of menu tabs (user 2026-10-07: "i want small boxes"): Om mig, Bliv pilot and the pages
   that lost their tab. Titles/lines are fixed here; the pages themselves are edited in Svar -> Sider. *@
@* Tiles in three groups, each saying where it leads (user 2026-10-12: "the links go to other pages and apps... needs to be structured"). *@
@* Each group is a show/hide box (user 2026-10-12). *@
<section class="k-card hj-tilegroup">
<h2 class="k-card-title">Mine apps – se eksemplerne</h2>
<nav class="hj-tiles" aria-label="Mine apps">
    @foreach (var tile in Tiles.Where(t => t.Group == TileGroup.App)) { @TileLink(tile) }
    <ElTip />
    <BudgetTip />
</nav>
</section>
<section class="k-card hj-tilegroup">
<h2 class="k-card-title">Om mig og mit arbejde</h2>
<nav class="hj-tiles" aria-label="Om mig og mit arbejde">
    @foreach (var tile in Tiles.Where(t => t.Group == TileGroup.Page)) { @TileLink(tile) }
    <StartTip />
    <AdhdTip />
</nav>
</section>
<section class="k-card hj-tilegroup">
<h2 class="k-card-title">Mine andre sider</h2>
<nav class="hj-tiles" aria-label="Mine andre sider">
    @foreach (var tile in Tiles.Where(t => t.Group == TileGroup.Site)) { @TileLink(tile) }
</nav>
</section>

@* "Lige nu" lives on the "Hvad laver ITKolibrien lige nu?" tab since 2026-09-28 (Components/NowCard). *@


</CascadingValue>

@if (_posts.Count > 0)
{
    <h2 class="hj-h2">Seneste</h2>
    @foreach (var p in _posts.Take(3)) { <PostCard Post="p" /> }

    @if (_posts.Count > 3)
    {
        <h2 class="hj-h2">Tidslinje</h2>
        <p class="k-help">Tryk på et år for at se, hvad der skete.</p>
        @foreach (var year in _posts.Skip(3).GroupBy(p => p.At.Year))
        {
            <details class="hj-year" data-remember="year-@year.Key">
                <summary><b>@year.Key</b> <span class="k-muted">· @year.Count() @(year.Count() == 1 ? "opslag" : "opslag")</span></summary>
                @foreach (var p in year) { <PostCard Post="p" /> }
            </details>
        }
    }
}

@if (!_family && _hiddenFamily > 0)
{
    <div class="k-card hj-lock" data-nofold>
        <p><b>@_hiddenFamily familieopslag</b> er kun for familien.</p>
        <a class="k-btn k-btn-sm" href="/login">Skriv familiens kodeord</a>
    </div>
}
else if (_family && !_owner)
{
    <p class="k-help k-center">Du ser familiens billeder. <a class="k-btn k-btn-sm" href="/logout">Log ud</a></p>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthTask { get; set; }

    private static readonly CultureInfo Da = new("da-DK");
    private Settings _s = new();
    private List<Post> _posts = [];
    private int _hiddenFamily;
    private Page? _hero;   // Svar -> Sider -> "forside": pictures of Martin + the business
    public const string CollabSlug = "foelg-samarbejdet";
    private static DateTime Today => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "Europe/Copenhagen").Date;
    private bool _family, _owner;

    // Every box has a "Vidste du …" (user 2026-10-08) that matches where the box leads (checked 2026-10-12). App tiles open the example on Mine apps, not the app itself (user 2026-10-12). Facts are the user's own numbers or sourced (source in the comment).
    private static readonly (TileGroup Group, string Icon, string Title, string Line, string Href, string Fact)[] Tiles =
    [
        // the user's own family library (ToshibaTest run, 2026-09): 87,009 files in, 34,079 out
        (TileGroup.App, "", "Tjek dine billeder", "Hvor mange billeder har du – og hvor mange er dubletter?", "/mine-apps?app=Tjek%20dine%20billeder", "… at en familie havde 87.009 filer, men kun 34.079 rigtige billeder?"),
        (TileGroup.Page, "", "Om mig og kontakt", "Hvem jeg er, og hvordan du fanger mig", "/om-mig", "… at jeg har arbejdet som systemudvikler i 20 år – og som socialpædagog i 5 år med mennesker med udviklingshandicap?"),
        (TileGroup.Page, "", "Bliv pilot", "Prøv mine apps gratis og sig din mening", "/bliv-pilot", "… at piloterne er med til at bestemme, hvad appen skal kunne?"),
        (TileGroup.App, "", "Hjælp på din skærm", "Del skærmen med mig – så hjælper jeg med det samme", "/mine-apps?app=Se%20med", "… at jeg kan være på din skærm på 2 minutter – uden at du skal installere noget?"),
        (TileGroup.App, "", "Kig med live", "Se med, når jeg sender live", "/mine-apps?app=Kig%20med", "… at du kan stille spørgsmål og stemme, mens jeg sender?"),
        // Statista, Feb 2025: average daily social media use of internet users worldwide = 141 min (141*365/1440 = 35.7 days)
        // Global E-waste Monitor 2024 / Dell + HP LCAs: 68-81 % of a laptop's CO2 is from making it (user 2026-10-12: green, both sites)
        (TileGroup.Page, "", "Grønt og bæredygtigt", "Giv gamle ting nyt liv – i stedet for at købe nyt", "/baeredygtighed", "… at 68–81 % af en bærbar computers CO₂ bliver udledt, før du tænder den – når den bliver lavet?"),
        (TileGroup.Page, "", "Ingen reklamer", "Hvorfor mine apps aldrig har reklamer", "/ingen-reklamer", "… at vi i snit bruger 141 minutter om dagen på sociale medier? Det er 36 døgn om året."),
        (TileGroup.Page, "", "Hvad laver jeg nu?", "I dag og denne uge", "/hvad-laver-itkolibrien", "… at jeg skriver min plan for dagen her hver morgen – og om aftenen, hvad det blev til?"),
        (TileGroup.Site, "", "Bogshoppen", "Liveauktioner – snart", "https://bogshoppen.dk", "… at Bogshoppen har over 100.000 bøger, blade og tegneserier, der skal finde nye ejere?"),
        (TileGroup.Page, "", "Særlige behov", "ADHD, autisme og IT", "/ydelser/adhd-og-autisme", "… at der findes meget få gode apps til folk med særlige udfordringer? De skal have en app, der passer til Søren – ikke til kassen »autisme«."),
        (TileGroup.Page, "", "Priser", "Hvad koster det?", "/apps", "… at alle mine apps har en gratis udgave, der kan noget i sig selv?"),
    ];

    public enum TileGroup { App, Page, Site }

    // Real pictures instead of emoji icons (user 2026-10-12): the app examples, and a photo of Martin for "Om mig".
    private static readonly Dictionary<string, string> Pictures = new()
    {
        ["Tjek dine billeder"] = "/apps/billeder.jpg",
        ["Hjælp på din skærm"] = "/apps/semed.jpg",
        ["Kig med live"] = "/apps/kigmed.jpg",
        ["Om mig og kontakt"] = "/f/1992b2f17f9cca20.jpg",
    };

    // Every tile says where it leads: an app example on Mine apps, a page here, or another site.
    private static RenderFragment TileLink((TileGroup Group, string Icon, string Title, string Line, string Href, string Fact) t) => __builder =>
    {
        var external = t.Href.StartsWith("http");
        <a class="hj-tile" href="@t.Href" target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)">
            @if (Pictures.TryGetValue(t.Title, out var pic)) { <img class="hj-tile-pic" src="@pic" alt="" loading="lazy" /> }<b>@t.Title</b><span class="hj-tile-line">@t.Line</span>
            <span class="hj-tile-fact">Vidste du @t.Fact</span>
            <span class="hj-tile-go">@(t.Group switch { TileGroup.App => "Se eksemplet →", TileGroup.Site => new Uri(t.Href).Host + " →", _ => "Læs mere →" })</span>
        </a>
    };

    private string FirstName => _s.Name.Split(' ')[0];

    protected override async Task OnInitializedAsync()
    {
        var user = AuthTask is null ? null : (await AuthTask).User;
        _family = user.IsFamily();
        _owner = user.IsOwner();
        await LoadAsync();
        Chat.AvailabilityChanged += OnAvailability;
    }

    private async Task LoadAsync()
    {
        await using var db = await Dbf.CreateDbContextAsync();
        _s = await db.Settings.AsNoTracking().FirstAsync();
        _hero = await db.Pages.AsNoTracking().FirstOrDefaultAsync(p => p.Slug == "forside");
        var q = db.Posts.Include(p => p.Media.OrderBy(m => m.Sort)).AsNoTracking();
        if (!_family) q = q.Where(p => p.Visibility == Visibility.Offentlig);
        _posts = await q.OrderByDescending(p => p.At).ToListAsync();
        _hiddenFamily = _family ? 0 : await db.Posts.CountAsync(p => p.Visibility == Visibility.Familie);
    }

    private void OnAvailability() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => Chat.AvailabilityChanged -= OnAvailability;
}
