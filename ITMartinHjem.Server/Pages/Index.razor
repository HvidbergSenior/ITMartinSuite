@page "/"
@implements IDisposable
@inject SiteUseCases Site
@inject ChatUseCases Chat
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Customers Kartotek

@* The front page = three things (user 2026-10-27: "more tabs and fewer boxes" -> "do it"): the head box (who, and the two next
   steps), one "Vidste du …" and the sign-up. Who Martin is, the tiles and his posts are on the Om mig tab (/om-itmartin);
   "Fundet i kasserne" is on bogshoppen.dk only. *@

@if (BogshoppenHome.IsHost(new Uri(Nav.Uri).Host)) { <BogshoppenHome /> return; }

<PageTitle>ITMartin – apps og hjælp · Martin Hvidberg</PageTitle>

@* Temporary birthday front - switches itself off after Hjem:FestUntil (default 2026-09-30 23:59). *@
<Fest />

@* Martin's own face in the head box instead of the sun (user 2026-10-27: "i should have a picture of me on the frontpage");
   his own picks, changing every minute (Services/MartinPhotos). *@
<header class="hj-head hj-head-me">
    <span class="hj-head-photo"><img src="@_photo.Src" alt="Martin Hvidberg@(_photo.Place.Length > 0 ? " – " + _photo.Place : "")" width="150" height="150" />@if (_photo.Place.Length > 0) { <span class="hj-head-place">@_photo.Place</span> }</span>
    @* Theme "idag" (user 2026-10-05) + the date and the day's ONE thing from I dag (user 2026-10-27: "Det er tirsdag den...
       og jeg skal.... Kode en App", "Only ONE thing each day"). *@
    <span class="hj-tagline">Det er @Today.ToString("dddd 'den' d. MMMM", Da)@(_oneThing.Length > 0 ? ", og jeg skal " + char.ToLower(_oneThing[0], Da) + _oneThing[1..] : "")</span>
    @* The heading is the "Forside" page's title in Svar -> Sider (user: "ITMartin - Den digitale kolibri"). *@
    <h1>@(_hero?.Title is { Length: > 0 } t && t != "Forside" ? t : _s.Name)</h1>
    @if (_s.Intro.Length > 0) { <p class="hj-intro">@_s.Intro</p> }
    @* "En del af ITMartin" as one line here instead of its own box (2026-10-27 "Snart ét firma", 2026-10-29 merged); the full box stays on bogshoppen.dk. *@
    <p class="hj-head-note"><b>Bogshoppen er en del af ITMartin.</b> Dit kundenummer virker begge steder.</p>
    @* Clear next steps in the first screen (2026-10-27, /admin/tal: 52 on the front page, only 10 went on to Mine apps).
       "Skriv mig op – gratis" like on bogshoppen.dk (user 2026-10-27: "easier to sign up ... on both sites"). *@
    <div class="hj-head-btns">
        <a class="k-btn k-btn-primary" href="#bliv-kunde">Skriv mig op – gratis</a>
        <a class="k-btn" href="/mine-apps">Se mine gratis apps</a>
    </div>
    @if (_owner) { <a class="k-btn k-btn-sm" href="/admin">Skriv opslag / svar beskeder</a> }
</header>

<CascadingValue Name="Plain" Value="true">
@* One open "Vidste du …" right under the head box (user 2026-10-19: "there used to be a lot of vidste du"). Shared box
   (Components/VidsteDu) - it starts on one of the concrete ones (SiteFacts.ItMartin). *@
<VidsteDu Facts="Facts" StartAmong="SiteFacts.ItMartin.Count" />

@* Sign up as a customer right on the front page (user 2026-10-22) - the same one yes as Mine apps and bogshoppen.dk:
   a kundenummer for all the free apps + the live-auction login. Starts open and can be closed like every box (user
   2026-10-27: "not clickable show/hide"); the head box's "Skriv mig op – gratis" opens it again (kolibri.js). *@
<section class="k-card hj-signup" id="bliv-kunde">
    <h2 class="k-card-title">Skriv dig op – gratis</h2>
    <p>Ingen reklamer, ingen nyhedsbreve – og du kan altid afmelde dig.</p>
    <TrialForm App="@ITMartinHjem.Domain.TrialRules.FrontPage" FreeApps="_freeWithCode" Button="Skriv mig op som kunde" Open="true" Topics="true" />
</section>

@* More about Martin is one press away (the Om mig tab). *@
<a class="k-btn k-btn-block hj-more" href="@SiteMenu.About">Læs mere om mig og mit arbejde →</a>
</CascadingValue>

@code {
    // Old "Chat med Martin" buttons point at /#chat (the box that was here until 2026-10-21) - send them to the chat page.
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        try { await JS.InvokeVoidAsync("eval", "if (location.hash === '#chat') location.replace('/chat-med-martin')"); }
        catch (JSException) { }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthTask { get; set; }

    private static readonly CultureInfo Da = new("da-DK");
    private Settings _s = new();
    private IReadOnlyList<string> _freeWithCode = [];
    private Page? _hero;   // Svar -> Sider -> "forside": its title is the heading
    private string _oneThing = "";
    public const string CollabSlug = PageRules.Collab;
    private static DateTime Today => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "Europe/Copenhagen").Date;
    private bool _family, _owner;
    private readonly MartinPhotos.Photo _photo = MartinPhotos.Now;

    // Facts for the open "Vidste du …" box. The small, concrete everyday help comes FIRST and the box always starts on one of
    // those (user 2026-10-27: "Facebook bæredygtighed etc should not be dominant... The concrete examples should"); the
    // Facebook/green/other facts follow after Næste and stay in their own tiles (Om mig tab).
    private static readonly IReadOnlyList<SiteFacts.Fact> Facts =
    [
        .. SiteFacts.ItMartin,
        new("Det de store ikke fortæller", "/dine-data", "… at Facebook fjerner datoen fra dine billeder, når du henter dem ud? Jeg havde 10.211 billeder og videoer – alle uden dato."),
        new("Om mig", "/om-itmartin", "… at jeg har arbejdet som systemudvikler i 20 år – og som socialpædagog i 5 år med mennesker med udviklingshandicap?"),
        new("Se mine Facebook-billeder", "https://gallery.itmartin.dk/facebook-demo", "… at jeg har fået alle mine billeder hjem fra Facebook og sat den rigtige dato på igen? Se et udpluk – ingen kode."),
        // A tile without a fact is left out (user 2026-10-27 removed "jeg skriver min plan for dagen her hver morgen").
        .. WorkTiles.Tiles.Where(t => t.Fact.Length > 0 && SiteFacts.ItMartin.All(f => f.Text != t.Fact)).Select(t => new SiteFacts.Fact(t.Title, t.Href, t.Fact)),
    ];

    protected override async Task OnInitializedAsync()
    {
        var user = AuthTask is null ? null : (await AuthTask).User;
        _family = user.IsFamily();
        _owner = user.IsOwner();
        await LoadAsync();
        // Kunder down must never take the front page with it - the form then just names no apps.
        try { _freeWithCode = (await Kartotek.FreeAppsAsync()).Where(f => f.NeedsCode).Select(f => f.Name).ToList(); }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { }
        Chat.AvailabilityChanged += OnAvailability;
    }

    private async Task LoadAsync()
    {
        var front = await Site.FrontAsync(_family);
        (_s, _hero) = (front.Settings, front.Hero);
        _oneThing = await Site.OneThingAsync(Today);
    }

    private void OnAvailability() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => Chat.AvailabilityChanged -= OnAvailability;
}
