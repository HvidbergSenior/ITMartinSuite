@page "/"
@implements IDisposable
@inject SiteUseCases Site
@inject ChatUseCases Chat
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Customers Kartotek
@inject FeedbackUseCases Feedbacks

@* The front page = three things (user 2026-10-27: "more tabs and fewer boxes" -> "do it"): the head box (who, and the two next
   steps), one "Vidste du …" and the sign-up. Who Martin is, the tiles and his posts are on the Om mig tab (/om-itmartin);
   "Fundet i kasserne" is on bogshoppen.dk only. *@

@if (BogshoppenHome.IsHost(new Uri(Nav.Uri).Host)) { <BogshoppenHome /> return; }

<PageTitle>ITMartin – apps og hjælp · Martin Hvidberg</PageTitle>

@* Temporary birthday front - switches itself off after Hjem:FestUntil (default 2026-09-30 23:59). *@
<Fest />

@* SUPER SIMPLE front page (user 2026-11-12: "I need to make my itmartin.dk super simple ... What do I sell -> prices"):
   who I am, what I sell with the price, how to reach me. The prices live in the Domain (ITMartinHjem.Domain/PriceList).
   "Nyt", "Vidste du ..." and the market notice are gone from here - they are on the Om mig / topic tabs. *@
<header class="hj-head hj-head-me hj-wide">
    <span class="hj-head-photo"><img src="@_photo.Src" alt="Martin Hvidberg@(_photo.Place.Length > 0 ? " – " + _photo.Place : "")" width="150" height="150" />@if (_photo.Place.Length > 0) { <span class="hj-head-place">@_photo.Place</span> }</span>
    <h1>ITMartin – Martin Hvidberg</h1>
    <p class="hj-intro">Jeg hjælper dig med IT – enkelt, ærligt og uden reklamer.</p>
    <div class="hj-head-btns">
        <a class="k-btn k-btn-primary" href="/chat-med-martin">Skriv til mig</a>
        <a class="k-btn" href="tel:+4531194730">Ring 31 19 47 30</a>
    </div>
    @if (_owner) { <a class="k-btn k-btn-sm @(_waiting > 0 ? "k-btn-primary" : "")" href="/admin">Min side@(_waiting > 0 ? $" ({_waiting} venter)" : "")</a> }
</header>

<CascadingValue Name="Plain" Value="true">
@* The LOF evenings are under "Mere ⋯" (Pages/LofAftener, user 2026-11-12 "also as dots"). *@
@* WOW + columns (user 2026-11-12: "this should be more Wauv... more obvious for customers... more columns"): wide on a pc,
   3 paid offers side by side with a big price, the free snebolde as small cards; stacks on a phone. *@
<div class="hj-wide hj-prices">
    @* Show/hide (user 2026-11-12 "remember show/hide boxes ... also on homepage"): every section folds, open by default,
       and kolibri.js remembers open/closed per device (data-remember). *@
    <details class="hj-sec" open data-remember="hj-saelger">
    <summary><h2 class="hj-sec-title">Det sælger jeg</h2>
    <p class="hj-sec-sub">Alle priser er inkl. moms – og intet abonnement.</p></summary>
    <div class="hj-grid hj-grid-3">
        @foreach (var o in PriceList.Offers.Where(o => o.Href.StartsWith("/")))
        {
            <a class="hj-tile" href="@o.Href">
                <span class="hj-tile-price">@o.Price</span>
                <b class="hj-tile-title">@o.Title</b>
                <span class="hj-tile-text">@o.Text</span>
                @if (o.Saving.Length > 0) { <span class="hj-tile-save">@o.Saving</span> }
                <span class="k-btn k-btn-primary hj-tile-btn">@o.Button</span>
            </a>
        }
    </div>
    </details>

    <details class="hj-sec" open data-remember="hj-snebolde">
    <summary><h2 class="hj-sec-title">Gratis snebolde</h2>
    <p class="hj-sec-sub">Små hjælpere i din browser – uden reklamer. Tryk og læs, hvad de kan.</p></summary>
    <div class="hj-grid hj-grid-4">
        @foreach (var sb in PriceList.FreeSnebolde)
        {
            <a class="hj-tile hj-tile-free" href="@sb.Href">
                <span class="hj-tile-price">0 kr.@(sb.HasPaid ? "" : " – helt gratis")</span>
                <b class="hj-tile-title">@sb.Name</b>
                <span class="hj-tile-text">@sb.Text</span>
                <span class="hj-sb-part"><b>Gratis:</b> @sb.Free</span>
                @if (sb.HasPaid)
                {
                    <span class="hj-sb-part hj-sb-paid"><b>@sb.PaidName – @PriceList.PaidPrice:</b> @sb.Paid</span>
                }
            </a>
        }
    </div>
    </details>

    <details class="hj-sec" open data-remember="hj-bogshoppen">
    <summary><h2 class="hj-sec-title">Bogshoppen</h2></summary>
    @foreach (var o in PriceList.Offers.Where(o => !o.Href.StartsWith("/")))
    {
        <a class="hj-tile hj-tile-wide" href="@o.Href">
            <span><b class="hj-tile-title">@o.Title</b><span class="hj-tile-text">@o.Text</span></span>
            <span class="k-btn hj-tile-btn">@o.Button</span>
        </a>
    }
    </details>
</div>

@* Sign-up stays (other pages link to /#bliv-kunde - soft sign-up rule), but closed: one quiet line. *@
<section class="k-card hj-signup hj-wide" id="bliv-kunde">
    <h2 class="k-card-title">Skriv mig op – hvis du har lyst</h2>
    <p>Ingen reklamer, ingen nyhedsbreve – og du kan altid afmelde dig.</p>
    <TrialForm App="@ITMartinHjem.Domain.TrialRules.FrontPage" FreeApps="_freeWithCode" Button="Skriv mig op som interesseret" Topics="true" />
</section>

@* Om mig, AI og tænkning, Spørgsmål, Kritik, Familien: in the menu under "Mere ⋯" (2026-11-12). *@
</CascadingValue>

@code {
    // Old "Chat med Martin" buttons point at /#chat (the box that was here until 2026-10-21) - send them to the chat page.
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        try { await JS.InvokeVoidAsync("eval", "if (location.hash === '#chat') location.replace('/chat-med-martin')"); }
        catch (JSException) { }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthTask { get; set; }

    private static readonly CultureInfo Da = new("da-DK");
    private Settings _s = new();
    private IReadOnlyList<string> _freeWithCode = [];
    private Page? _hero;   // Svar -> Sider -> "forside": its title is the heading
    private Page? _topic;  // the "Nyt" box (current topic tab)
    private string _oneThing = "";
    public const string CollabSlug = PageRules.Collab;
    private static DateTime Today => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "Europe/Copenhagen").Date;
    private bool _family, _owner;
    private int _waiting;   // Martin only: chats without an answer + Kritik not answered or shown
    private readonly MartinPhotos.Photo _photo = MartinPhotos.Now;

    // Facts for the open "Vidste du …" box. The small, concrete everyday help comes FIRST and the box always starts on one of
    // those (user 2026-10-27: "Facebook bæredygtighed etc should not be dominant... The concrete examples should"); the
    // Facebook/green/other facts follow after Næste and stay in their own tiles (Om mig tab).
    private static readonly IReadOnlyList<SiteFacts.Fact> Facts =
    [
        .. SiteFacts.ItMartin,
        new("Det de store ikke fortæller", "/dine-data", "… at Facebook fjerner datoen fra dine billeder, når du henter dem ud? Jeg havde 10.211 billeder og videoer – alle uden dato."),
        new("Om mig", "/om-itmartin", "… at jeg har arbejdet som systemudvikler i 20 år – og som socialpædagog i 5 år med mennesker med udviklingshandicap?"),
        new("Se mine Facebook-billeder", "https://gallery.itmartin.dk/facebook-demo", "… at jeg har fået alle mine billeder hjem fra Facebook og sat den rigtige dato på igen? Se et udpluk – ingen kode."),
        // A tile without a fact is left out (user 2026-10-27 removed "jeg skriver min plan for dagen her hver morgen").
        .. WorkTiles.Tiles.Where(t => t.Fact.Length > 0 && SiteFacts.ItMartin.All(f => f.Text != t.Fact)).Select(t => new SiteFacts.Fact(t.Title, t.Href, t.Fact)),
    ];

    protected override async Task OnInitializedAsync()
    {
        var user = AuthTask is null ? null : (await AuthTask).User;
        _family = user.IsFamily();
        _owner = user.IsOwner();
        if (_owner) _waiting = (await Chat.ThreadsAsync()).Count(t => t.UnreadForOwner) + (await Feedbacks.WaitingAsync()).Count;
        await LoadAsync();
        // Kunder down must never take the front page with it - the form then just names no apps.
        try { _freeWithCode = (await Kartotek.FreeAppsAsync()).Where(f => f.NeedsCode).Select(f => f.Name).ToList(); }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { }
        Chat.AvailabilityChanged += OnAvailability;
    }

    private async Task LoadAsync()
    {
        var front = await Site.FrontAsync(_family);
        (_s, _hero) = (front.Settings, front.Hero);
        _oneThing = await Site.OneThingAsync(Today);
        _topic = await Site.TopicAsync();
    }

    private void OnAvailability() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => Chat.AvailabilityChanged -= OnAvailability;
}
