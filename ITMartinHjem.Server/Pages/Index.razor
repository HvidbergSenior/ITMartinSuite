@page "/"
@implements IDisposable
@inject IDbContextFactory<HjemDb> Dbf
@inject ChatService Chat
@inject NavigationManager Nav

@* First screen = one answer: who I am and what I am doing now. The timeline and the
   chat come after it; old years are folded and the phone remembers what was open. *@

@if (BogshoppenHome.IsHost(new Uri(Nav.Uri).Host)) { <BogshoppenHome /> return; }

@* Temporary birthday front - switches itself off after Hjem:FestUntil (default 2026-09-30 23:59). *@
<Fest />

<header class="hj-head">
    @* Theme "idag" (user 2026-10-05): "Det er mandag, hvad skal jeg mon lave i dag og hvad skal jeg lave i denne uge? Spændende" *@
    <span class="hj-tagline">🌅 Det er @Today.ToString("dddd", Da)</span>
    @* The heading is the "Forside" page's title in Svar -> Sider (user: "ITMartin - Den digitale kolibri"). *@
    <h1>@(_hero?.Title is { Length: > 0 } t && t != "Forside" ? t : _s.Name)</h1>
    @if (_s.Intro.Length > 0) { <p class="hj-intro">@_s.Intro</p> }
    @if (_owner) { <a class="k-btn k-btn-sm" href="/admin">✏️ Skriv opslag / svar beskeder</a> }
</header>

@* ITMartin + Bogshoppen stays on the front page until the collaboration is done, right under the heading:
   the most important thing for the user (2026-10-05). All info lives on the tab, here only a teaser.
   Text = Svar -> Sider -> "bogshoppen"; the full story + news is on the "Følg samarbejdet" tab. *@
@if (_news is { Body.Length: > 0 })
{
    <section class="k-card hj-page hj-news" data-nofold>
        @* Front = only the first section (user 2026-10-05: "a bit too much info"); the whole story is on the tab. *@
        @TinyMarkdown.Render(FirstSection(_news.Body))
        <a class="k-btn k-btn-primary k-mt" href="/@CollabSlug">📚 Følg samarbejdet med Bogshoppen</a>
    </section>
}

@* Today: Martin's day log (plan in the morning, pictures through the day) - Svar -> 📌 Lige nu. *@
<NowCard Compact="true" />

@* "Denne uge" is on the ITKolibrien tab, not here (user 2026-10-05). *@


@* Kig med: big red box while Martin streams, a small line otherwise (user 2026-09-30). *@
<LiveCard />

@* "Martin er her nu" right under the name, so every visitor sees it (user 2026-09-28). *@
<ChatBox Available="_s.Available" OwnerName="@FirstName" Prominent="true" />

@* Apps are only on the Mine apps tab (user 2026-10-04: "Forsiden skal heller ikke have mine apps"). *@

@* Who Martin is: folded, so the first screen is just today + this week (user 2026-10-05). *@
@if (_hero is not null)
{
    <details class="k-card hj-page hj-hero" data-remember="hero">
        <summary><b>👋 Hvem er ITMartin?</b></summary>
        @TinyMarkdown.Render(_hero.Body)
    </details>
}

@* "Lige nu" lives on the "Hvad laver ITKolibrien lige nu?" tab since 2026-09-28 (Components/NowCard). *@


@if (_posts.Count > 0)
{
    <h2 class="hj-h2">Seneste</h2>
    @foreach (var p in _posts.Take(3)) { <PostCard Post="p" /> }

    @if (_posts.Count > 3)
    {
        <h2 class="hj-h2">Tidslinje</h2>
        <p class="k-help">Tryk på et år for at se, hvad der skete.</p>
        @foreach (var year in _posts.Skip(3).GroupBy(p => p.At.Year))
        {
            <details class="hj-year" data-remember="year-@year.Key">
                <summary><b>@year.Key</b> <span class="k-muted">· @year.Count() @(year.Count() == 1 ? "opslag" : "opslag")</span></summary>
                @foreach (var p in year) { <PostCard Post="p" /> }
            </details>
        }
    }
}

@if (!_family && _hiddenFamily > 0)
{
    <div class="k-card hj-lock" data-nofold>
        <p>🔒 <b>@_hiddenFamily familieopslag</b> er kun for familien.</p>
        <a class="k-btn k-btn-sm" href="/login">Skriv familiens kodeord</a>
    </div>
}
else if (_family && !_owner)
{
    <p class="k-help k-center">Du ser familiens billeder. <a href="/logout">Log ud</a></p>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthTask { get; set; }

    private static readonly CultureInfo Da = new("da-DK");
    private Settings _s = new();
    private List<Post> _posts = [];
    private int _hiddenFamily;
    private Page? _hero;   // Svar -> Sider -> "forside": pictures of Martin + the business
    private Page? _news;   // Svar -> Sider -> "bogshoppen": highlighted box, stays until the collaboration is done
    public const string CollabSlug = "foelg-samarbejdet";
    private static DateTime Today => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "Europe/Copenhagen").Date;
    private bool _family, _owner;

    private string FirstName => _s.Name.Split(' ')[0];

    protected override async Task OnInitializedAsync()
    {
        var user = AuthTask is null ? null : (await AuthTask).User;
        _family = user.IsFamily();
        _owner = user.IsOwner();
        await LoadAsync();
        Chat.AvailabilityChanged += OnAvailability;
    }

    private async Task LoadAsync()
    {
        await using var db = await Dbf.CreateDbContextAsync();
        _s = await db.Settings.AsNoTracking().FirstAsync();
        _hero = await db.Pages.AsNoTracking().FirstOrDefaultAsync(p => p.Slug == "forside");
        _news = await db.Pages.AsNoTracking().FirstOrDefaultAsync(p => p.Slug == "bogshoppen");
        var q = db.Posts.Include(p => p.Media.OrderBy(m => m.Sort)).AsNoTracking();
        if (!_family) q = q.Where(p => p.Visibility == Visibility.Offentlig);
        _posts = await q.OrderByDescending(p => p.At).ToListAsync();
        _hiddenFamily = _family ? 0 : await db.Posts.CountAsync(p => p.Visibility == Visibility.Familie);
    }

    // Text up to the second "## " heading.
    private static string FirstSection(string body)
    {
        var i = body.IndexOf("\n## ", body.StartsWith("## ") ? 3 : 0, StringComparison.Ordinal);
        return i > 0 ? body[..i] : body;
    }

    private void OnAvailability() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => Chat.AvailabilityChanged -= OnAvailability;
}
