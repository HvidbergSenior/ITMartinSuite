@page "/chat-med-martin"
@implements IDisposable
@inject SiteUseCases Site
@inject ChatUseCases Chat

@* The chat on its own page with the menu (user 2026-10-21: the chat box is no longer on the front page). Every old
   "/#chat" button on the sites, ElPriser and Stem lands here (the front page sends #chat on). *@
<PageTitle>Chat med Martin</PageTitle>

@* The same head as the other tabs - gradient, Martin's photo, tag (user 2026-10-28: "need to have the feel"). *@
<PageHead Title="Chat med Martin" Tag="Første snak er altid gratis" Line="Skriv dit navn og dit spørgsmål. Så får du dit eget rum, hvor vi skriver sammen – ét sted, så intet bliver væk.">
    <p class="hj-head-note">Vil du hellere ringe eller skrive en mail?</p>
    <div class="hj-head-btns">
        <a class="k-btn" href="tel:+4531194730">31 19 47 30</a>
        <a class="k-btn" href="mailto:ITMartin@Mensa.dk">ITMartin@Mensa.dk</a>
    </div>
</PageHead>
<SnakStart Available="_available" OwnerName="@_first" />

@code {
    private bool _available;
    private string _first = "Martin";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Chat.AvailabilityChanged += OnAvailability;
    }

    private async Task LoadAsync()
    {
        var s = await Site.SettingsAsync();
        _available = s.Available;
        _first = s.Name.Split(' ')[0];
    }

    private void OnAvailability() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => Chat.AvailabilityChanged -= OnAvailability;
}
