@page "/varer/{Id:int}"
@inject ShopUseCases Shop
@inject MarketUseCases Market
@inject NavigationManager Nav
@inject IJSRuntime JS

@* One product on bogshoppen.dk: what it is, the price promise with the proof links, and Køb nu (Stripe). *@
<PageTitle>@(_item?.Line ?? "Vare") · Bogshoppen</PageTitle>

@if (_loading)
{
    <p class="k-center k-help">Henter varen …</p>
}
else if (_item is null)
{
    <section class="k-card bs-card">
        <h2>Varen er ikke til salg</h2>
        <div>
            <p>Den er solgt, kommet på auktion – eller lageret svarer ikke lige nu. Prøv at søge efter noget lignende.</p>
            <a class="k-btn k-btn-primary bs-btn" href="/varer">Tilbage til varerne</a>
        </div>
    </section>
}
else
{
    <header class="bs-head bs-head-varer">
        <span class="bs-tag">@_item.Kind</span>
        <h1>@_item.Line</h1>
        <p>@(_item.Usage == Usages.New ? "Ny" : "Brugt") · Stand: <b>@_item.Condition</b>@(_item.Available > 1 ? " · Vi har flere" : "")</p>
    </header>

    @if (_item.HasPhoto)
    {
        <p class="k-center"><img class="bs-photo" src="/varer/foto/@_item.Id" alt="Billede af @_item.Title" /></p>
    }

    <section class="k-card bs-card">
        <h2>Pris</h2>
        <div>
            @if (_item.ForShow)
            {
                <p><b>Kun til visning.</b> Den her vare er et eksempel og kan ikke købes.</p>
            }
            else if (_item.Available == 0)
            {
                <p><b>En anden er ved at betale for den lige nu.</b> Bliver købet ikke gennemført, er den til salg igen om en halv time.</p>
            }
            else if (_item.BuyNowKr is { } kr)
            {
                @if (_item.DayKr is { } day)
                {
                    <p class="bs-price"><b>@day kr i dag</b> <span class="k-help">+ fragt, eller hent den</span></p>
                    <p>@_item.DayOffer – ellers @kr kr.</p>
                }
                else
                {
                    <p class="bs-price"><b>@kr kr</b> <span class="k-help">+ fragt, eller hent den</span></p>
                }
                @if (_canBuy && ShopVisible)
                {
                    <p class="k-help">Tryk Køb nu. Så kommer du til betalingen (kort eller MobilePay) og vælger, om den skal sendes eller hentes. Varen er holdt til dig i 30 minutter. Vil du købe flere ting på én gang, så tryk Læg i kurven – bundt-tilbud regnes ud i kurven.</p>
                    <button class="k-btn k-btn-primary bs-btn" @onclick="Buy" disabled="@_busy">@(_busy ? "Et øjeblik …" : $"Køb nu – {_item.DayKr ?? kr} kr")</button>
                    <button class="k-btn bs-btn" @onclick="AddToBasket">@(_inBasket > 0 ? $"Lagt i kurven ({_inBasket})" : "Læg i kurven")</button>
                    @if (_inBasket > 0) { <a class="k-btn k-btn-sm" href="/kurv">Gå til kurven</a> }
                    <p class="k-help">Du har 14 dages fortrydelsesret.</p>
                    <a class="k-btn k-btn-sm" href="/handelsbetingelser">Læs handelsbetingelserne</a>
                }
                else if (ShopVisible)
                {
                    <p>Betaling på siden åbner snart. Vil du have den nu? Skriv i chatten, så holder vi den til dig.</p>
                    <a class="k-btn k-btn-sm" href="@BogshoppenHome.AskUrl">Spørg på itmartin.dk</a>
                }
            }
            else
            {
                <p>Den har ikke en fast pris endnu@(_item.ExpectKr is { } ex ? $" – andre steder koster den omkring {ex} kr" : "").</p>
                @if (ShopVisible)
                {
                    <p>Snart kan du <b>byde</b> på den, så kommer den med på lørdagens liveauktion. Indtil da: skriv i chatten, hvad du vil give.</p>
                    <a class="k-btn k-btn-sm" href="@BogshoppenHome.AskUrl">Spørg på itmartin.dk</a>
                }
            }
            @if (!ShopVisible && !_item.ForShow)
            {
                @* The marketplace for customers (2026-10-26): no buying yet - mark it for the live auctions. *@
                <p>Kunne du tænke dig den? Tryk <b>Interessant</b>. Liveauktionerne starter med de ting, flest har markeret. Tryk igen, hvis du fortryder.</p>
                <button class="k-btn bs-btn @(_marked ? "k-btn-primary" : "")" aria-pressed="@(_marked ? "true" : "false")" @onclick="ToggleInterest" disabled="@_busy">@(_marked ? "Interessant – markeret" : "Interessant")</button>
                @if (_count > 0) { <p class="k-help">@_count synes den er interessant.</p> }
            }
            @if (_error is not null) { <p class="bs-warn" role="alert">@_error</p> }
        </div>
    </section>

    <section class="k-card bs-card">
        <h2>Det koster den andre steder</h2>
        <div>
            @if (_proof.Count == 0)
            {
                <p>Vi har ikke fundet den til salg andre steder endnu. Har du set den et sted? Send os linket i chatten.</p>
            }
            else
            {
                <p class="k-help">Det billigste eksemplar, vi har fundet på hver side. Tryk for at se annoncen selv.</p>
                <div class="bs-proof">
                    @foreach (var p in _proof)
                    {
                        <a class="k-btn k-btn-sm" href="@p.Url" target="_blank" rel="noopener nofollow">@p.Source@(p.IsNew ? " (ny)" : ""): @p.Kr kr@(p.Original != "" ? $" ({p.Original})" : "")</a>
                    }
                </div>
                <p class="k-help">Fundet den billigere? Send linket i chatten – så sælger vi den 10 % under.</p>
            }
        </div>
    </section>

    @if (_item.Interest != "")
    {
        <section class="k-card bs-card">
            <h2>Det interessante ved den</h2>
            <div><p>@_item.Interest</p></div>
        </section>
    }

    <p class="k-center"><a class="k-btn k-btn-sm" href="/varer">Tilbage til varerne</a></p>
}

@code {
    [Parameter] public int Id { get; set; }

    private ShopItem? _item;
    private List<ShopProof> _proof = [];
    private bool _canBuy, _loading = true, _busy;
    private string? _error;

    [CascadingParameter(Name = "ShopVisible")] private bool ShopVisible { get; set; }
    [CascadingParameter(Name = "ShopCustomer")] private string ShopCustomer { get; set; } = "";
    private bool _marked;
    private int _count;

    protected override async Task OnParametersSetAsync()
    {
        // Shop off for visitors (user 2026-10-22): also when reached by an in-app link, which skips the server redirect.
        // A customer logged into the marketplace (2026-10-26) sees it too - without Køb nu.
        if (!ShopVisible && ShopCustomer == "") { Nav.NavigateTo("/", replace: true); return; }
        _loading = true;
        if (await Shop.ItemAsync(Id) is { } x) (_canBuy, _item, _proof) = (x.CanBuy, x.Item, x.Proof);
        else _item = null;
        if (_item is not null && !ShopVisible)
            (_marked, _count) = ((await Market.MineAsync(ShopCustomer)).Contains(Id), _item.Interested);
        _loading = false;
    }

    private async Task ToggleInterest()
    {
        _busy = true; _error = null;
        var r = await Market.ToggleAsync(ShopCustomer, Id);
        if (r.Error is null) (_marked, _count) = (r.Marked, r.Count);
        else _error = r.Error;
        _busy = false;
    }

    private int _inBasket;

    private async Task AddToBasket() => _inBasket = await JS.InvokeAsync<int>("bsKurv.add", Id);

    private async Task Buy()
    {
        _busy = true; _error = null;
        var site = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
        var (url, error) = await Shop.BuyAsync(Id, site);
        if (url is not null) { Nav.NavigateTo(url, forceLoad: true); return; }
        _error = error;
        _busy = false;
    }
}
