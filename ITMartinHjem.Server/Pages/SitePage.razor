@page "/{*Slug}"
@inject SiteUseCases Site
@inject IWebHostEnvironment Env
@inject NavigationManager Nav

@* Any address that is not an app page: one of Martin's own pages (Om mig, Ydelser …).
   A page with sub-pages (ydelser -> ydelser/cloud …) lists them under its own text. *@

@if (_loaded && _page is null)
{
    <div class="k-card" data-nofold>
        <div class="k-card-title">Siden findes ikke</div>
        <p class="k-muted">Måske er den flyttet. <a href="/">Gå til forsiden</a>, eller chat med mig øverst på forsiden.</p>
    </div>
}
else if (_page is not null)
{
    <PageTitle>@NoEmoji.Strip(_page.Title) · Martin Hvidberg</PageTitle>
    @* Same head box on every tab as on the front page and bogshoppen.dk (user 2026-10-12). *@
    <PageHead Title="@_page.Title" Tag="@(_parent?.Title ?? (_page.Slug == NowCard.PageSlug ? "I dag" : "ITMartin"))" />
    @if (_parent is not null || _page.Slug == NowCard.PageSlug || !string.IsNullOrWhiteSpace(_intro))
    {
    <article class="k-card hj-page">
        @if (_parent is not null) { <p class="k-help"><a href="/@_parent.Slug">← @_parent.Title</a></p> }
        @if (_page.Slug == NowCard.PageSlug)
        {
            <NowCard />
            @* This week, under the day log (user 2026-10-05: not on the front page). Text = Svar -> Sider -> "denne-uge". *@
            @if (_week is { Body.Length: > 0 }) { <section class="hj-week">@TinyMarkdown.Render(_week.Body)</section> }
        }
        @TinyMarkdown.Render(_intro)
    </article>
    }
    @* "Følg samarbejdet": the Bogshoppen story (same text as the front box) first, then the page's own news.
       Every "## " part is its own show/hide box (user 2026-10-05). *@
    <SectionBoxes Parts="_parts" />
    @if (_children.Count > 0)
    {
        <div class="hj-subpages">
            @foreach (var c in _children)
            {
                <a class="k-card hj-subpage" href="/@c.Slug" data-nofold><b>@NoEmoji.Strip(c.Title)</b><span>@NoEmoji.Strip(Teaser(c.Body))</span></a>
            }
        </div>
    }
    <p class="k-center k-mt"><a class="k-btn k-btn-primary" href="/#chat">Chat med mig om det</a></p>
}

@code {
    [Parameter] public string? Slug { get; set; }

    private Page? _page, _parent, _news, _week;
    private string _intro = "";
    private List<Sections.Part> _parts = [];
    private List<Page> _children = [];
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        var slug = (Slug ?? "").Trim('/').ToLowerInvariant();
        // A hand-made page in wwwroot (pilot, rejsedemo): the in-app link lands here - load the real file.
        if (slug.Length > 0 && Env.WebRootFileProvider.GetFileInfo($"{slug}/index.html").Exists)
        {
            Nav.NavigateTo($"/{slug}/", forceLoad: true);
            return;
        }
        var view = await Site.PageAsync(slug);
        (_page, _news, _week, _children, _parent) = (view.Page, view.News, view.Week, view.Children, view.Parent);
        var story = Sections.Split(_news?.Body);
        var own = Sections.Split(_page?.Body);
        _intro = string.Join(Environment.NewLine + Environment.NewLine, new[] { story.Intro, own.Intro }.Where(t => t.Length > 0));
        _parts = [.. story.Parts, .. own.Parts];
        _loaded = true;
    }

    // First plain sentence of the page, for the sub-page cards.
    private static string Teaser(string body)
    {
        var line = body.Replace("\r", "").Split('\n')
            .Select(l => l.Trim()).FirstOrDefault(l => l.Length > 20 && !l.StartsWith("#") && !l.StartsWith("!") && !l.StartsWith("*")) ?? "";
        line = line.Replace("**", "");
        return line.Length > 140 ? line[..140] + "…" : line;
    }
}
