@page "/spoergsmaal"
@implements IDisposable
@inject PublicQuestions Questions
@inject NavigationManager Nav
@inject SiteUseCases SiteSettings
@inject ChatUseCases Chat

<PageTitle>Det spørger folk om · @(Site == QuestionRules.Bogshoppen ? "Bogshoppen" : "ITMartin")</PageTitle>

@* Public Q&A from the chat, without names (user 2026-10-12: "they ask the same questions and also i want transparency",
   "people should be able to find other questions regarding the same"). Martin chooses what goes up, in Svar. *@
<PageHead Title="Det spørger folk om" Tag="Spørgsmål og svar" Line="Uden navne." />
<article class="k-card hj-page" data-nofold>
    <p>Her er spørgsmål, folk har stillet mig i chatten – og mine svar. <b>Uden navne.</b> Måske er dit spørgsmål allerede besvaret.</p>
    @* Order and air (user 2026-10-12: "space on /spoergsmaal"): search first, then topics, then "not found? ask in the chat". *@
    <p class="k-help"><b>Sådan gør du:</b> skriv et ord i søgefeltet (fx <i>budget</i> eller <i>billeder</i>), eller tryk på et emne.
        Under hvert svar står de andre spørgsmål om det samme.</p>
    <input class="k-input hj-qa-search" type="search" @bind="_q" @bind:event="oninput" @bind:after="SearchAsync" placeholder="Søg, fx budget, billeder, strøm…" aria-label="Søg i spørgsmål" />
    @if (_found is { Topics.Count: > 0 } f)
    {
        <div class="hj-qa-topics">
            <button class="hj-chip @(_topic is null ? "on" : "")" @onclick="() => PickAsync(null)">Alle (@f.Total)</button>
            @foreach (var (t, n) in f.Topics)
            {
                <button class="hj-chip @(string.Equals(_topic, t, StringComparison.OrdinalIgnoreCase) ? "on" : "")" @onclick="() => PickAsync(t)">@t (@n)</button>
            }
        </div>
    }
    <div class="hj-qa-ask">
        <p class="k-help">Fandt du ikke svaret? Stil dit spørgsmål lige herunder.</p>
        <a class="k-btn k-btn-sm" href="#chat">Stil et spørgsmål</a>
    </div>
</article>

@* "Stil et spørgsmål" right on the page (user 2026-10-24: questions like "do you take books?" belong in spørgsmål/svar,
   not in mails). It is the ordinary chat: the answer comes in the chat, and Martin puts good ones up from Svar. *@
<ChatBox Available="_available" OwnerName="@_first" Title="Stil et spørgsmål">
    <p class="k-help">Spørg om hvad som helst – fx om vi tager imod bøger, blade eller film, eller om en af appsene.
        Svaret kommer her i chatten. Er det noget, andre også kan bruge, kommer spørgsmålet og svaret op på siden – <b>uden dit navn</b>.</p>
</ChatBox>

@if (_found is null) { <p class="k-help k-center">Henter…</p> }
else if (_found.Total == 0) { <p class="k-help k-center">Der er ingen spørgsmål her endnu.</p><p class="k-center"><a class="k-btn k-btn-sm" href="#chat">Stil det første i chatten</a></p> }
else if (_found.Questions.Count == 0) { <p class="k-help k-center">Ingen spørgsmål passer. Prøv et andet ord – eller spørg mig i chatten.</p><p class="k-center"><a class="k-btn k-btn-sm" href="#chat">Spørg mig i chatten</a></p> }
else
{
    @foreach (var q in _found.Questions)
    {
        <section class="k-card hj-qa" id="q@(q.Id)" data-nofold>
            <button class="k-tag hj-qa-topic" @onclick="() => PickAsync(q.Topic)">@(q.Site == QuestionRules.Bogshoppen && Site != QuestionRules.Bogshoppen ? "Bogshoppen · " : "")@q.Topic</button>
            <h2 class="hj-qa-q">@NoEmoji.Strip(q.Question)</h2>
            <div class="hj-qa-a"><b>Martin svarer:</b> @NoEmoji.Strip(q.Answer)</div>
            <div class="k-help">@Dk.Local(q.PublishedAt).ToString("d. MMMM yyyy", Da)</div>
            @if (_related.TryGetValue(q.Id, out var rel) && rel.Count > 0)
            {
                <div class="hj-qa-related">
                    <b>Flere spørgsmål om det samme</b>
                    <div class="hj-qa-boxes">@foreach (var r in rel) { <a class="hj-qa-boxlink" href="/spoergsmaal#q@(r.Id)" @onclick="() => ShowAsync(r)" @onclick:preventDefault>@NoEmoji.Strip(r.Question)</a> }</div>
                </div>
            }
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? InitialQ { get; set; }
    [SupplyParameterFromQuery(Name = "emne")] public string? InitialTopic { get; set; }

    private static readonly CultureInfo Da = new("da-DK");
    // bogshoppen.dk shows Bogshoppen's questions, itmartin.dk its own (user 2026-10-12).
    private string Site => BogshoppenHome.IsHost(new Uri(Nav.Uri).Host) ? QuestionRules.Bogshoppen : QuestionRules.ITMartin;
    private string _q = "";
    private string? _topic;
    private PublicQuestions.Found? _found;
    private Dictionary<int, List<PublicQuestion>> _related = [];

    private bool _available;
    private string _first = "Martin";

    protected override async Task OnInitializedAsync()
    {
        await LoadChatAsync();
        Chat.AvailabilityChanged += OnAvailability;
        _q = InitialQ ?? "";
        _topic = string.IsNullOrWhiteSpace(InitialTopic) ? null : InitialTopic;
        await SearchAsync();
    }

    private async Task PickAsync(string? topic)
    {
        _topic = topic;
        await SearchAsync();
    }

    // A related question: show just that one (its own "flere om det samme" leads on from there).
    private async Task ShowAsync(PublicQuestion r)
    {
        _q = ""; _topic = null;
        _found = _found! with { Questions = [r] };
        _related = await Questions.RelatedForAsync([r], 5);
    }

    private async Task SearchAsync()
    {
        _found = await Questions.SearchAsync(_q, _topic, Site == QuestionRules.Bogshoppen ? Site : null);   // itmartin.dk: both sites
        _related = await Questions.RelatedForAsync(_found.Questions.Take(30));
    }

    private async Task LoadChatAsync()
    {
        var s = await SiteSettings.SettingsAsync();
        _available = s.Available;
        _first = s.Name.Split(' ')[0];
    }

    private void OnAvailability() => InvokeAsync(async () => { await LoadChatAsync(); StateHasChanged(); });

    public void Dispose() => Chat.AvailabilityChanged -= OnAvailability;
}
