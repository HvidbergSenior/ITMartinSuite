@page "/om-bogshoppen"
@inject SiteUseCases Site

@* bogshoppen.dk third tab (user 2026-10-12: "Bogshoppen stod for hygge, snak og fællesskab ... og videre skal være i en anden tab").
   The manifest is the user's own text - keep it word for word. *@
<PageTitle>Om Bogshoppen</PageTitle>

<header class="bs-head bs-head-om bs-head-me">
    <BogshoppenPhoto />
    <span class="bs-tag">Idéen bag</span>
    <h1>Om Bogshoppen</h1>
    @* On itmartin.dk since 2026-11-03 (user: "i want all Om bogshoppen/ITMartin on ITMartin.dk. Bogs is only products"). *@
    <p class="hj-head-note"><b>Bogshoppen er en del af ITMartin.</b> Produkterne står på bogshoppen.dk – alt om os står her.</p>
    <div class="hj-head-btns">
        <a class="k-btn k-btn-primary bs-btn bs-head-btn" href="https://bogshoppen.dk/produkter">Se produkterne på bogshoppen.dk</a>
    </div>
</header>

<VidsteDu Facts="SiteFacts.ForBogshoppen()" StartAmong="SiteFacts.Bogshoppen.Count" />

@* Who Rico and Martin are (Svar -> Sider -> "bogshoppen-dk") - was on the bogshoppen.dk front page until 2026-11-03. *@
@{ var (intro, parts) = Sections.Split(_page?.Body); }
@if (intro.Length > 0) { <section class="k-card hj-page bs-card">@TinyMarkdown.Render(intro)</section> }
<div class="bs-card"><SectionBoxes Parts="parts" FirstOpen="true" /></div>

@* User's own text 2026-10-11 - keep it word for word. The "Snart kan du købe på mange måder" heading and the list of
   ways were removed 2026-10-12 (user). *@
<section class="k-card bs-card">
    <h2>Hygge, snak og fællesskab</h2>
    <div class="bs-manifest">
            <p>Bogshoppen stod for <b>hygge, snak og fællesskab</b>. En webshop kan aldrig helt erstatte det personlige møde, og derfor skal Bogshoppen heller ikke være en traditionel webshop.</p>
            <p>Det er ingen hemmelighed, at huslejen blev for høj. Butikken skulle betale 30.000 kr. om måneden, og det var ganske enkelt ikke holdbart.</p>
            <p>Men idéen bag Bogshoppen lever videre.</p>
            <p>Det handler ikke om at sælge mest muligt til flest mulige. Det handler om at samle mennesker med en fælles interesse. Samlere, nørder og andre, der virkelig interesserer sig for det, de leder efter.</p>
            <p><b>Én interesseret kunde er bedre end 1.000, der ikke er interesserede.</b></p>
            <p>Bogshoppen skal være for dem, der ved, hvad de leder efter – og for dem, der elsker at gå på opdagelse. </p>
        </div>
    <p class="bs-soon-how">Leder du efter noget bestemt? Skriv det på itmartin.dk – så kigger vi efter det, mens vi registrerer.</p>
    <a class="k-btn k-btn-sm" href="@BogshoppenHome.AskUrl">Skriv det på itmartin.dk</a>
</section>

@* "Den digitale kolibri tænker …" (300 boxes opened live) removed 2026-10-29 (user). *@

@* The green vision is on both sites (user 2026-10-12: "The vision should be both places") - page "baeredygtighed" in Svar -> Sider. *@
<section class="k-card bs-card">
    <h2>Grønt og bæredygtigt</h2>
    <div>
        <p>Hver bog, cd og film, der finder en ny ejer, er én, der ikke skal produceres igen. Det samme gælder gamle computere og telefoner, der får nyt liv.</p>
        <a class="k-btn k-btn-primary bs-btn" href="/baeredygtighed">Læs om vores grønne tanker</a>
    </div>
</section>

@code {
    private Page? _page;
    protected override async Task OnInitializedAsync() => _page = await Site.PageBySlugAsync(BogshoppenHome.PageSlug);
}
