@page "/afmeld"
@inject Customers Kartotek
@inject NavigationManager Nav

@* One-step unsubscribe from the Kundekartotek, on itmartin.dk and bogshoppen.dk (user 2026-10-12: "make easy way to unsubscribe").
   Same answer whether or not the e-mail was on the list, so nobody can use the page to test who is a customer. *@
<PageTitle>Afmeld · @(Bogshoppen ? "Bogshoppen" : "ITMartin")</PageTitle>

<PageHead Title="🚪 Afmeld dig" Tag="Kundekartotek" Line="Ingen reklamer, ingen nyhedsbreve – og du er ude med det samme." />
<article class="k-card hj-page" data-nofold>
    @if (_done)
    {
        <p><b>Du er afmeldt ✓</b> Vi skriver ikke til @_email mere.</p>
        <p class="k-help">Vil du have dine oplysninger slettet helt, så skriv til ITMartin@Mensa.dk – så sletter vi dem.</p>
        <a class="k-btn k-btn-sm" href="mailto:ITMartin@Mensa.dk?subject=Slet%20mine%20oplysninger">📧 Skriv til ITMartin</a>
    }
    else
    {
        <p>Skriv den e-mail, du skrev dig op med, og tryk <b>Afmeld</b>. Så er du ude af kundekartoteket med det samme – du skal ikke bekræfte noget.</p>
        <p class="k-help">Vi sender aldrig reklamer eller nyhedsbreve. Du kan altid skrive dig op igen.</p>
        <form class="k-row" @onsubmit="UnsubscribeAsync">
            <input class="k-input" type="email" inputmode="email" autocomplete="email" @bind="_email" maxlength="120" placeholder="Din e-mail" aria-label="Din e-mail" />
            <button class="k-btn k-btn-primary" type="submit" disabled="@_busy">Afmeld</button>
        </form>
        @if (_error.Length > 0) { <p class="form-error">⚠️ @_error</p> }
    }
</article>

@code {
    private string _email = "", _error = "";
    private bool _done, _busy;
    private bool Bogshoppen => BogshoppenHome.IsHost(new Uri(Nav.Uri).Host);

    private async Task UnsubscribeAsync()
    {
        _busy = true; _error = "";
        try
        {
            var error = await Kartotek.UnsubscribeAsync(_email);
            if (error is null) { _email = _email.Trim().ToLowerInvariant(); _done = true; } else _error = error;
        }
        finally { _busy = false; }
    }
}
