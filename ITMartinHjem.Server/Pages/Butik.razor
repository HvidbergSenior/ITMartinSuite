@page "/boeger"
@page "/tegneserier"
@page "/film"
@page "/musik"
@page "/spil"
@page "/kort"
@page "/fantasy"
@page "/strik"
@page "/ting"
@page "/sjaeldne"
@inject NavigationManager Nav
@inject PricesShown Prices

@* One shop on bogshoppen.dk (user 2026-11-03: "User can choose BogShoppen, Filmshoppen, Gameshoppen, Musikshoppen etc... and on
   each there are only products from them", "and cards - magic"). Which shop = the path; ShopFamilies says what is in it. *@
<PageTitle>@_family.Name · Bogshoppen</PageTitle>

<header class="bs-head bs-head-varer bs-head-me">
    <BogshoppenPhoto />
    <h1>@_family.Name</h1>
    <p>@_family.About</p>
    @* "Sådan gør du" removed from all shops 2026-11-23 (user). *@
</header>

<MarketNotice />

<ProductList Family="_family" />

<AuctionTeaser />

@code {
    private ShopFamily _family = ShopFamilies.Boeger;

    protected override void OnInitialized() =>
        // A hidden shop (kort, fantasy, strik, ting - 2026-11-19) opens Bogshoppen; old links keep working.
        _family = ShopFamilies.BySlug(new Uri(Nav.Uri).AbsolutePath) is { } f && (ShopFamilies.Shown.Contains(f) || f == ShopFamilies.Rare) ? f : ShopFamilies.Boeger;
}
