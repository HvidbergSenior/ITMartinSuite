@inject NavigationManager Nav

@* Bogshoppen is part of ITMartin now (user 2026-10-29: "bogshoppen -> En del af ITMartin"; was "Snart ét firma" since 2026-10-27).
   Same box on both front pages, in each site's look. *@
<section class="k-card @(Bogshoppen ? "bs-card" : "") hj-onecompany">
    <h2 class="k-card-title">En del af ITMartin</h2>
    <p><b>Bogshoppen</b> er en del af <b>ITMartin</b>. Det er de samme mennesker – Martin og Rico – og det er stadig gratis at være kunde.</p>
    <p>Du skal ikke gøre noget: dit kundenummer virker begge steder, både til de gratis apps på itmartin.dk og til liveauktionerne på bogshoppen.dk.</p>
</section>

@code {
    private bool Bogshoppen => BogshoppenHome.IsHost(new Uri(Nav.Uri).Host);
}
