@inject IJSRuntime JS

@* One thing in the marketplace (2026-10-20): photo, what it is, the gold/silver/bronze mark (a word, never colour alone -
   no emojis on the sites), today's price when an offer covers it, and "Læg i kurven". *@
<li class="bs-card-item">
    <a href="/varer/@Item.Id">
        @if (Item.HasPhoto) { <img src="/varer/foto/@Item.Id" alt="" loading="lazy" /> }
        else { <span class="bs-card-noimg">@Item.Type</span> }
        @if (Mark != "") { <span class="bs-badge bs-badge-@Mark.ToLowerInvariant()">@Mark</span> }
        <b>@Item.Line</b>
        <span class="k-help">@(Item.Usage == Usages.New ? "Ny" : "Brugt") · @Item.Kind · @Item.Condition stand</span>
        @if (Item.Available == 0) { <span>Reserveret lige nu</span> }
        else if (Item.DayKr is { } day && Item.BuyNowKr is { } normal)
        {
            <span class="bs-card-price">@day kr <span class="bs-card-day">i dag</span></span>
            <span class="k-help">@Item.DayOffer – ellers @normal kr</span>
        }
        else if (Item.BuyNowKr is { } kr) { <span class="bs-card-price">@kr kr</span> }
        else if (Item.ExpectKr is { } ex) { <span>ca. @ex kr – pris kommer</span> }
        else { <span>Pris kommer</span> }
    </a>
    @if (CanBuy && Item.Available > 0 && Item.BuyNowKr is not null)
    {
        <div class="bs-card-actions">
            <button class="k-btn k-btn-sm k-btn-primary" @onclick="Add">@(_added ? "Lagt i kurven" : "Læg i kurven")</button>
        </div>
    }
</li>

@code {
    [Parameter, EditorRequired] public ShopItem Item { get; set; } = default!;
    [Parameter] public bool CanBuy { get; set; }
    [Parameter] public EventCallback<int> Added { get; set; }

    private bool _added;

    // "🏆 GULD" -> "GULD" (no emojis on the sites).
    private string Mark => Item.Badge.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? "";

    private async Task Add()
    {
        var count = await JS.InvokeAsync<int>("bsKurv.add", Item.Id);
        _added = true;
        await Added.InvokeAsync(count);
    }
}
