@implements IDisposable
@inject IHttpClientFactory Http
@inject IConfiguration Config
@inject SiteUseCases Site

@* Kig med on the front page: a big red box while Martin streams (topic = the studio's "Hvad laver du?"),
   a small line otherwise. Status from kigmed-web over the LAN (Hjem:KigMedStatus), checked every 30 s. *@
@* Strip = the slim line under the menu on EVERY itmartin.dk page (user 2026-11-13: "put it on ITMartin somewhere where it shows
   all the time") - weekly live where Martin presents his ideas and who he is. Shown even when Kig med cannot be reached. *@
@if (Strip)
{
    @if (_s is { Live: true } ls)
    {
        <a class="hj-livestrip on" href="@Url" target="_blank" rel="noopener">
            <span class="hj-live-dot" aria-hidden="true"></span>
            <b>Jeg er live nu</b> <span>@(ls.Title.Trim().Length > 0 ? ls.Title : "Mine idéer – og hvem jeg er")</span>
            <span class="hj-livestrip-btn">Kig med</span>
        </a>
    }
    else
    {
        @* Not live: the chat hours planned on /admin every Sunday decide what the strip says (user 2026-11-13). *@
        @* More POW (user 2026-11-13): LIVE badge + the time/topic big, one strong button; chat time as a small second line. *@
        <div class="hj-livestrip pow">
            <a class="hj-ls-live" href="@Url" target="_blank" rel="noopener">
                <span class="hj-ls-badge">LIVE</span>
                <span class="hj-ls-text">
                    <b>@(_s is not null && _s.Next.Trim().Length > 0 ? _s.Next : "Live med Martin – hver uge, samme tid")</b>
                    <span>Mød mig, hør mine idéer – og du kan selv være med og tale.</span>
                </span>
                <span class="hj-livestrip-btn hj-ls-go">Kig med</span>
            </a>
            @if (_chat.Text.Length > 0)
            {
                <a class="hj-ls-chat @(_chat.Open ? "open" : "")" href="/chat-med-martin">@_chat.Text · <u>Skriv til mig</u></a>
            }
        </div>
    }
}
else if (_s is { Live: true } s)
{
    <a class="k-card hj-live on" href="@Url" target="_blank" rel="noopener" data-nofold>
        <span class="hj-live-dot" aria-hidden="true"></span>
        <span class="hj-live-text">
            <b>@E("")Jeg streamer nu</b>
            <span>@(s.Title.Trim().Length > 0 ? s.Title : "Jeg mangler input til en ny app – har du idéer?")</span>
            <span class="k-help">Kig med på video, stil spørgsmål og send dine idéer – direkte fra telefonen, ingen app eller login.@(s.Viewers > 0 ? $"  {s.Viewers} ser med." : "")</span>
        </span>
        <span class="k-btn k-btn-primary">@E("")Kig med og giv dit bud</span>
    </a>
}
else if (_s is not null)
{
    <p class="hj-live off">@E("")Jeg streamer ikke lige nu.@(_s.Next.Trim().Length > 0 ? $" Næste gang: {_s.Next}." : "") Kig med, når jeg er på – så kan du se mig arbejde og give dine idéer.</p>
    <a class="k-btn k-btn-sm" href="@Url" target="_blank" rel="noopener">@E("")Kig med</a>
}

@code {
    // itmartin.dk front page: no emojis - they look AI-made; it should feel personal (user 2026-10-12). Set by Index.
    [Parameter] public bool Strip { get; set; }
    [CascadingParameter(Name = "Plain")] public bool Plain { get; set; }
    private string E(string emoji) => Plain ? "" : emoji + " ";
    private const string Url = "https://kigmed.itmartin.dk";
    private sealed record Status(bool Live, string Title, string Next, int Viewers);
    private Status? _s;
    private (bool Open, string Text) _chat = (false, "");
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _timer = new Timer(_ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadAsync()
    {
        try { _chat = ITMartinHjem.Domain.ChatHours.Parse((await Site.SettingsAsync()).ChatHours).Describe(ITMartinHjem.Domain.Dk.Now); }
        catch { _chat = (false, ""); }
        try
        {
            using var c = Http.CreateClient();
            c.Timeout = TimeSpan.FromSeconds(2);
            _s = await c.GetFromJsonAsync<Status>(Config["Hjem:KigMedStatus"] ?? "http://10.0.0.200:9144/api/status");
        }
        catch { _s = null; }   // photoserver asleep or Kig med down: show nothing
    }

    public void Dispose() => _timer?.Dispose();
}
