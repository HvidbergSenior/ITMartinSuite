@using System.Globalization
@inject NavigationManager Nav

@* The head box on every tab (user 2026-10-12: "make the same head boxes on itmartin on tabs as in bogshoppen"):
   emoji on top, pill tag, heading, optional line. A title that starts with an emoji ("Hvad laver …") gives the top emoji.
   On bogshoppen.dk it takes Bogshoppen's colours. *@
@* Martin's photo on every itmartin.dk tab, like the front page (user 2026-10-27: "the picture should be on all tabs"). *@
<header class="@(Bogshoppen ? "bs-head bs-head-page bs-head-me" : "hj-head hj-head-page hj-head-me" + (Calm ? " hj-head-calm" : ""))" data-emoji="@Emoji">
    @if (Bogshoppen) { <BogshoppenPhoto /> }
    @if (!Bogshoppen) { <span class="hj-head-photo"><img src="@_photo.Src" alt="Martin Hvidberg@(_photo.Place.Length > 0 ? " – " + _photo.Place : "")" width="150" height="150" />@if (_photo.Place.Length > 0) { <span class="hj-head-place">@_photo.Place</span> }</span> }
    @if (Tag.Length > 0) { <span class="@(Bogshoppen ? "bs-tag" : "hj-tagline")">@NoEmoji.Strip(Tag)</span> }
    <h1>@Text</h1>
    @if (Line.Length > 0) { <p class="@(Bogshoppen ? "" : "hj-intro")">@Line</p> }
    @ChildContent
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Tag { get; set; } = "";
    [Parameter] public string Line { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>A quiet head: plain card, no gradient (the Om mig tab, user 2026-10-27 "prettier and more calm").</summary>
    [Parameter] public bool Calm { get; set; }

    private bool Bogshoppen => BogshoppenHome.IsHost(new Uri(Nav.Uri).Host);

    // "🚀 Hvad laver ITKolibrien lige nu?" -> emoji "🚀" on top, heading "Hvad laver ITKolibrien lige nu?"
    private (string Emoji, string Text) Split()
    {
        var t = Title.Trim();
        if (t.Length == 0) return (Icon ?? "", "");
        var first = StringInfo.GetNextTextElement(t);
        var isEmoji = first.Any(c => char.IsSurrogate(c) || CharUnicodeInfo.GetUnicodeCategory(c) == UnicodeCategory.OtherSymbol);
        return isEmoji ? (Icon ?? first, t[first.Length..].Trim()) : (Icon ?? "", t);
    }

    // No emojis on the sites (2026-10-12): nothing on top, and none in the title or tag.
    private string Emoji => "";
    private string Text => NoEmoji.Strip(Split().Text);
    private readonly MartinPhotos.Photo _photo = MartinPhotos.Now;
}
