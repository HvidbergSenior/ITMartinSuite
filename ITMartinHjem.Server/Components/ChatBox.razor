@implements IDisposable
@inject ChatService Chat
@inject IJSRuntime JS

@* The visitor's side of the live chat. The visitor is remembered on this phone/PC only
   (a random key in the browser), so a reply shows up here when they come back. *@

<section class="k-card hj-chat @(Prominent ? "hj-chat-top" : "") @(Available ? "is-on" : "")" id="chat" data-nofold>
    <div class="hj-chat-status">
        <span class="k-dot @(Available ? "on" : "")"></span>
        @if (Available) { <b>@OwnerName er her nu</b> <span class="k-muted">– chat med ham direkte, han svarer med det samme.</span> }
        else { <b>@OwnerName er ikke ved skærmen</b> <span class="k-muted">– start en chat alligevel. Han får besked på telefonen, og svaret kommer her i chatten.</span> }
    </div>

    @if (!_open)
    {
        <button class="k-btn k-btn-primary k-btn-block k-mt" @onclick="() => _open = true">💬 Chat med @OwnerName</button>
    }
    else
    {
        @if (_thread is { Messages.Count: > 0 })
        {
            <div class="hj-msgs" id="hj-msgs">
                @foreach (var m in _thread.Messages)
                {
                    <div class="hj-msg @(m.FromOwner ? "owner" : "me")">
                        <div>@m.Text</div>
                        <div class="hj-msg-at">@(m.FromOwner ? OwnerName : "Dig") · @Dk.Local(m.At).ToString("d/M HH:mm")</div>
                    </div>
                }
            </div>
        }
        @if (_thread is null)
        {
            <input class="k-input k-mt" @bind="_name" maxlength="60" placeholder="Dit navn (valgfrit)" aria-label="Dit navn" />
        }
        @if (_thread is null || _thread.VisitorEmail.Length == 0)
        {
            <input class="k-input k-mt" type="email" @bind="_email" maxlength="200" placeholder="Din e-mail – hvis du vil have besked, når Martin svarer (valgfri)" aria-label="Din e-mail" autocomplete="email" />
        }
        <textarea class="k-input k-textarea k-mt" @bind="_text" @bind:event="oninput" maxlength="2000" placeholder="Skriv i chatten…" aria-label="Din besked"></textarea>
        <button class="k-btn k-btn-primary k-btn-block k-mt" disabled="@(_busy || string.IsNullOrWhiteSpace(_text))" @onclick="SendAsync">Send</button>
        @if (_note.Length > 0) { <p class="k-help">@_note</p> }
        @if (_thread is not null)
        {
            @if (_thread.VisitorEmail.Length > 0)
            {
                <p class="k-help">📧 Du får en mail på @_thread.VisitorEmail, når Martin svarer.</p>
            }
            @if (_thread.VisitorPush.Length == 0)
            {
                @* plain onclick: the browser must see the visitor's own tap when it asks for permission *@
                <button type="button" class="k-btn k-btn-block k-mt" onclick="hjem.visitorPush(this)">🔔 Giv mig besked i browseren, når Martin svarer</button>
            }
            <p class="k-help">Din e-mail bruges kun til at give dig besked om svaret.</p>
        }
    }
</section>

@code {
    [Parameter] public bool Available { get; set; }
    [Parameter] public string OwnerName { get; set; } = "Martin";
    [Parameter] public bool StartOpen { get; set; }
    [Parameter] public bool Prominent { get; set; }

    private string _key = "", _name = "", _text = "", _note = "", _email = "";
    private bool _open, _busy;
    private ChatThread? _thread;
    private DateTime _lastSend = DateTime.MinValue;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            _key = await JS.InvokeAsync<string>("hjem.visitorKey");
            _thread = await Chat.GetAsync(_key);
            if (_thread is not null || StartOpen) _open = true;
            Chat.Changed += OnChanged;
            Chat.VisitorOnline(_key);
            StateHasChanged();
        }
        if (_open && _thread is not null) await JS.InvokeVoidAsync("hjem.scrollEnd", "hj-msgs");
    }

    private async Task SendAsync()
    {
        if ((DateTime.UtcNow - _lastSend).TotalSeconds < 3) { _note = "Vent et øjeblik…"; return; }
        _busy = true;
        _lastSend = DateTime.UtcNow;
        var hadEmail = _email.Trim().Length > 0 && !MailService.LooksLikeEmail(_email.Trim());
        if (_thread is not null && MailService.LooksLikeEmail(_email.Trim())) await Chat.SetVisitorEmailAsync(_key, _email);
        await Chat.VisitorWritesAsync(_key, _name, _text, _email);
        _text = "";
        _thread = await Chat.GetAsync(_key);
        _note = hadEmail ? "Sendt. Din e-mail så forkert ud – ret den, så du kan få besked." :
            _thread?.VisitorEmail.Length > 0 ? "Sendt – du får en mail, når Martin har svaret." :
            Available ? "Sendt – svaret kommer lige her i chatten." :
            "Sendt. Svaret kommer her i chatten. Vil du have besked, så skriv din e-mail herover eller tryk på 🔔.";
        _busy = false;
    }

    private void OnChanged(int threadId)
    {
        if (_thread is null || threadId != _thread.Id) return;
        InvokeAsync(async () => { _thread = await Chat.GetAsync(_key); StateHasChanged(); });
    }

    public void Dispose()
    {
        Chat.Changed -= OnChanged;
        if (_key.Length > 0) Chat.VisitorOffline(_key);
    }
}
