@inject ShopUseCases Shop
@inject PricesShown Prices
@inject MarketUseCases Market
@inject BundleDrafts Drafts
@inject ShopVisibility Visibility
@inject IJSRuntime JS
@inject PersistentComponentState State
@inject NavigationManager Nav
@implements IDisposable

@* The products from Lager on bogshoppen.dk (not a webshop: no basket, no buy button). The shops since 2026-11-03 (user: "User
   can choose BogShoppen, Filmshoppen, Gameshoppen, Musikshoppen etc... and on each there are only products from them... And i
   need subcategories", "and cards - magic"): /produkter = one search field + a box per shop; a shop (bogshoppen.dk/film) =
   its subcategories as buttons + all its things A-Z. ShopFamilies (ITMartinVarer.Contracts) says which shop has what. *@
<section class="k-card bs-card bs-shop" id="alle">
    @* User 2026-11-05: "all prices need to be invisible... Say something like 10000 produkter - still 99999 to go. Prices will come". *@
    @* Markedsplads (2026-11-05): log in with the number -> Interessant, Byd (hidden max) and Mit bundt. Only when Hjem__MarketForCustomers=true. *@
    @if (Visibility.Customers)
    {
        <div class="bs-market" id="marked">
            @if (Customer == "")
            {
                <form method="post" action="/marked/ind" class="bs-market-login">
                    <b>Vil du byde eller lave et bundt?</b> Log ind med dit nummer fra mailen.
                    <input type="hidden" name="tilbage" value="@BackPath" />
                    <span class="bs-market-row"><input class="k-input" name="kode" inputmode="numeric" placeholder="Dit nummer (8 cifre)" aria-label="Dit nummer" required />
                    <button class="k-btn k-btn-primary" type="submit">Log ind</button></span>
                    @if (!string.IsNullOrEmpty(MarkedFejl)) { <span class="bs-market-err" role="alert">@MarkedFejl</span> }
                    <span class="k-help">Har du ikke et nummer? <a href="https://itmartin.dk/#bliv-kunde">Skriv dig op som interesseret</a> – det er gratis.</span>
                </form>
            }
            else
            {
                <div class="bs-market-in">
                    <span>Logget ind med @ShowCode(Customer)</span>
                    <button type="button" class="k-btn k-btn-primary" @onclick="() => _bundleOpen = !_bundleOpen">Mit bundt (@Drafts.Of(Customer).Count)</button>
                    <form method="post" action="/marked/ud" style="display:inline"><input type="hidden" name="tilbage" value="@BackPath" /><button class="k-btn k-btn-ghost k-btn-sm" type="submit">Log ud</button></form>
                </div>
                @if (_bundleOpen) { @BundlePanel }
            }
        </div>
    }
    @if (!Prices.On && _overview is not null)
    {
        var shown = _overview.Shelves.Sum(sh => sh.Count);
        <div class="bs-progress" role="status">
            <b>Vi har lagt @shown.ToString("N0", Da) produkter ind – der mangler @Math.Max(0, PricesShown.Goal - shown).ToString("N0", Da).</b>
            <span>Priserne kommer, når vi er nået længere. Kig dig bare omkring.</span>
        </div>
    }
    @if (Family is not null)
    {
        <a class="k-btn k-btn-sm bs-back" href="/produkter">← Alle butikker</a>
        <h2 class="bs-family-name">@Family.Name</h2>
        <p class="k-help">@Family.About Tryk på et billede for at se det stort. Under <b>Mere om den</b> står @(Prices.On ? "stand og hvad lignende koster andre steder" : "mere om standen").</p>
        @* The free helpers for this shop (2026-11-03): a button when it is public, else the same button disabled with "Kommer snart" (user: "Let the be diabled but visible now"). *@
        @if (Family.Helpers is { Length: > 0 } helpers)
        {
            <div class="bs-helpers">
                <h3>Gratis hjælper</h3>
                @foreach (var h in helpers)
                {
                    <div class="bs-helper">
                        @if (h.Url is { } url) { <a class="k-btn k-btn-primary bs-btn" href="@url" target="_blank" rel="noopener">@h.Name</a> }
                        else { <button class="k-btn bs-btn bs-helper-soon" disabled aria-disabled="true">@h.Name · Kommer snart</button> }
                        <span class="k-help">@h.Text</span>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p class="k-help">Vælg en butik – eller søg i dem alle.</p>
    }

    <form class="bs-search" @onsubmit="Search" @onsubmit:preventDefault>
        <input class="k-input" type="search" aria-label="Søg efter en titel" placeholder="@(Family is null ? "Søg i alle butikker, fx Barnaby" : $"Søg i {Family.Name}")" @bind="_text" />
        <button class="k-btn k-btn-primary" type="submit">Søg</button>
    </form>

    @if (_error is not null)
    {
        <p class="k-alert k-alert-warn">@_error</p>
    }
    else if (Family is null && _query == "")
    {
        @if (_overview is null)
        {
            <p class="k-help">Henter butikkerne ...</p>
        }
        else
        {
            @* A box per shop with how much it has and a few of its pictures - the whole box is pressed. *@
            <ul class="bs-families">
                @foreach (var f in ShopFamilies.All)
                {
                    var count = Count(f);
                    <li>
                        <a class="bs-family @(count == 0 ? "bs-family-empty" : "")" href="@f.Path">
                            <span class="bs-family-pics">
                                @foreach (var i in Pictures(f)) { <img src="/varer/foto/@i.Id" alt="" loading="lazy" /> }
                            </span>
                            <b class="bs-family-title">@f.Name</b>
                            <span class="k-help">@f.About</span>
                            <span class="bs-family-go">@(count == 0 ? "Ingen varer endnu" : $"Se {count} {(count == 1 ? "vare" : "varer")} →")</span>
                        </a>
                    </li>
                }
            </ul>
            <a class="bs-family bs-family-rare" href="@ShopFamilies.Rare.Path">
                <b class="bs-family-title">@ShopFamilies.Rare.Name</b>
                <span class="k-help">@ShopFamilies.Rare.About</span>
                <span class="bs-family-go">Se dem →</span>
            </a>
        }
    }
    else
    {
        @if (Family is not null && _query == "" && _overview is not null && VisibleSubs.Count > 1)
        {
            <div class="bs-filter bs-tabs" role="group" aria-label="Underkategorier">
                <button class="k-btn @(_sub is null ? "is-on" : "")" aria-pressed="@(_sub is null)" @onclick="() => Choose(null)">Alle (@Count(Family))</button>
                @foreach (var (sub, n) in VisibleSubs)
                {
                    <button class="k-btn @(_sub == sub ? "is-on" : "")" aria-pressed="@(_sub == sub)" @onclick="() => Choose(sub)">@sub.Name (@n)</button>
                }
            </div>
        }
        @if (_batch is not null)
        {
            <button class="k-btn k-btn-sm bs-back" @onclick="CloseBatch">← Hele @(_sub?.Name ?? Family?.Name)</button>
        }
        else if (_query != "")
        {
            <button class="k-btn k-btn-sm bs-back" @onclick="ClearSearch">← @(Family is null ? "Alle butikker" : $"Hele {Family.Name}")</button>
        }
        @if (_market is null)
        {
            <p class="k-help">Henter produkterne ...</p>
        }
        else
        {
            <h3 class="bs-shelf">@Heading</h3>
            @* Sort order (user 2026-11-03: "there should be some kind of order", chose sort buttons): A-Å first, filled when chosen. *@
            <div class="bs-filter bs-sort" role="group" aria-label="Sorter">
                <span class="bs-filter-label">Sorter</span>
                @foreach (var (key, name) in SortNames.Where(x => Prices.On || (x.Key != ShopSorts.Cheapest && x.Key != ShopSorts.Dearest)))
                {
                    <button class="k-btn k-btn-sm @(_sort == key ? "is-on" : "")" aria-pressed="@(_sort == key)" @onclick="() => Sort(key)">@name</button>
                }
            </div>
            @if (ShowPacks) { @Packs(_market.Packs) }
            <p class="bs-count" role="status">@ResultText</p>
            <ul class="bs-shop-grid">
                @* Batches (user 2026-11-03: "there is one for each product. there should be batches for instance same type of Anders
                   And should be in one"): a series/artist with 2+ things is ONE card; pressing it shows only that series. *@
                @* A batch stands where its first thing would stand in the chosen order (user 2026-11-03: "batches sorted by price like
                   everything else"): Dyrest = its dearest, Billigst = its cheapest, A-Å = its first title. *@
                @foreach (var row in Rows) { if (row.Batch is { } b) { @BatchCard(b) } else { @Card(row.Item!) } }
            </ul>
            @if (_items.Count < _market.Total)
            {
                <button class="k-btn k-mt" @onclick="More" disabled="@_loading">@(_loading ? "Henter ..." : $"Vis flere ({_market.Total - _items.Count} til)")</button>
            }
        }
    }
</section>

@code {
    // ── Markedsplads (2026-11-05) ─────────────────────────────────────────────────
    [CascadingParameter(Name = "ShopCustomer")] public string Customer { get; set; } = "";
    [SupplyParameterFromQuery(Name = "markedfejl")] public string? MarkedFejl { get; set; }
    private HashSet<int> _marked = [];
    private Dictionary<int, int> _myBids = [];
    private int? _bidOpen;
    private string _bidText = "", _bundleKr = "";
    private readonly Dictionary<int, string> _note = [];
    private bool _bundleOpen;
    private string? _bundleMsg;
    private string BackPath => new Uri(Nav.Uri).PathAndQuery.Split("markedfejl=")[0].TrimEnd('?', '&');
    private static string ShowCode(string c) => c.Length == 8 ? c[..4] + " " + c[4..] : c;

    private async Task LoadMarket()
    {
        if (!Visibility.Customers || Customer == "") return;
        _marked = await Market.MineAsync(Customer);
        _myBids = await Market.MyBidsAsync(Customer);
    }

    private async Task Mark(int id)
    {
        var r = await Market.ToggleAsync(Customer, id);
        if (r.Error is { } e) _note[id] = e; else { if (r.Marked) _marked.Add(id); else _marked.Remove(id); _note.Remove(id); }
    }

    private void OpenBid(int id)
    {
        _bidOpen = _bidOpen == id ? null : id;
        _bidText = _myBids.TryGetValue(id, out var b) ? b.ToString() : "";
    }

    private void ToggleBundle(int id) { Drafts.Toggle(Customer, id); _bundleMsg = null; }

    private async Task SendBid(int id)
    {
        var digits = new string(_bidText.Where(char.IsDigit).ToArray());
        int? kr = int.TryParse(digits, out var k) ? k : null;
        var r = await Market.BidAsync(Customer, id, kr);
        if (r.Ok && kr is { } got) { _myBids[id] = got; _bidOpen = null; _bidText = ""; _note[id] = $"Dit bud er gemt: højst {got} kr. Ingen kan se det – auktionen byder for dig."; }
        else _note[id] = r.Error ?? "Det virkede ikke.";
    }

    private async Task SendBundle(bool ask)
    {
        int? kr = null;
        if (!ask)
        {
            if (!int.TryParse(new string(_bundleKr.Where(char.IsDigit).ToArray()), out var k)) { _bundleMsg = "Skriv, hvad du vil give for det hele – eller tryk Spørg om en pris."; return; }
            kr = k;
        }
        var r = await Market.BundleAsync(Customer, Drafts.Of(Customer), kr);
        if (r.Ok) { Drafts.Clear(Customer); _bundleKr = ""; _bundleMsg = ask ? "Sendt. Vi skriver til dig med en pris." : "Sendt. Vi skriver til dig, om det er en handel."; }
        else _bundleMsg = r.Error ?? "Det virkede ikke.";
    }

    private RenderFragment MarketButtons(ShopItem i) => __builder =>
    {
        var inBundle = Drafts.Has(Customer, i.Id);
        var marked = _marked.Contains(i.Id);
        var hasBid = _myBids.TryGetValue(i.Id, out var mine);
        <div class="bs-market-btns">
            <button type="button" class="k-btn k-btn-sm @(marked ? "is-on" : "")" aria-pressed="@marked" @onclick="() => Mark(i.Id)">@(marked ? "Interessant ✓" : "Interessant")</button>
            <button type="button" class="k-btn k-btn-sm @(inBundle ? "is-on" : "")" aria-pressed="@inBundle" @onclick="() => ToggleBundle(i.Id)">@(inBundle ? "I bundtet ✓" : "Læg i bundt")</button>
            <button type="button" class="k-btn k-btn-sm" @onclick="() => OpenBid(i.Id)">@(hasBid ? $"Dit bud: {mine} kr" : "Byd")</button>
        </div>
        @if (_bidOpen == i.Id)
        {
            <div class="bs-market-bid">
                <label class="k-help" for="bud-@i.Id">Det højeste, du vil give (kr) – ingen kan se det:</label>
                <span class="bs-market-row"><input class="k-input" id="bud-@i.Id" inputmode="numeric" @bind="_bidText" placeholder="fx 80" />
                <button type="button" class="k-btn k-btn-primary" @onclick="() => SendBid(i.Id)">Gem bud</button></span>
            </div>
        }
        @if (_note.TryGetValue(i.Id, out var n)) { <p class="k-help bs-market-note" role="status">@n</p> }
    };

    private RenderFragment BundlePanel => __builder =>
    {
        var ids = Drafts.Of(Customer);
        var known = ids.Select(id => _items.FirstOrDefault(x => x.Id == id)).Where(x => x is not null).ToList();
        <div class="bs-bundle">
            <h3>Mit bundt</h3>
            @if (ids.Count == 0) { <p>Tryk <b>Læg i bundt</b> ved de ting, du vil have sammen.</p> }
            else
            {
                <p><b>@ids.Count ting.</b> Giv ét bud på det hele – eller spørg, hvad vi vil have for det.</p>
                @if (known.Count > 0) { <ul>@foreach (var k in known) { <li>@k!.Line</li> }</ul> }
                <span class="bs-market-row"><input class="k-input" inputmode="numeric" @bind="_bundleKr" placeholder="Dit bud for det hele (kr)" aria-label="Dit bud for det hele" />
                <button type="button" class="k-btn k-btn-primary" @onclick="() => SendBundle(false)">Giv bud</button></span>
                <button type="button" class="k-btn" @onclick="() => SendBundle(true)">Spørg om en pris</button>
            }
            @if (_bundleMsg is { } m) { <p class="bs-market-note" role="status">@m</p> }
        </div>
    };

    private static readonly System.Globalization.CultureInfo Da = new("da-DK");
    /// <summary>The shop this list is (bogshoppen.dk/film); null = /produkter, the boxes for all shops.</summary>
    [Parameter] public ShopFamily? Family { get; set; }

    private ShopOverview? _overview;
    private ShopMarket? _market;
    private readonly List<ShopItem> _items = [];
    private string? _error;
    private string _text = "", _query = "";
    private ShopSub? _sub;
    private int _page;      // Salg counts pages from 0
    private bool _loading;

    /// <summary>?under=DVD opens one subcategory of the shop (a link can be shared).</summary>
    [SupplyParameterFromQuery(Name = "under")] public string? Under { get; set; }
    /// <summary>Old links: /produkter?vis=Film goes to the shop that has it.</summary>
    [SupplyParameterFromQuery(Name = "vis")] public string? Vis { get; set; }

    // No flicker (2026-11-03): the page is drawn twice (server, then live) - the first drawing's data is handed over.
    private sealed record Snapshot(ShopOverview? Overview, ShopMarket? Market, List<ShopItem> Items);
    private PersistingComponentStateSubscription _persist;
    private string SnapshotKey => "bs-produkter-" + (Family?.Slug ?? "alle");

    protected override async Task OnInitializedAsync()
    {
        if (Family is null && Vis is { Length: > 0 } && OldLink(Vis) is { } to) { Nav.NavigateTo(to, replace: true); return; }
        _sub = Family?.Sub(Under);
        _sort = ShopSorts.All.Contains(SortParam) ? SortParam! : ShopSorts.Title;
        if (!Prices.On && (_sort == ShopSorts.Cheapest || _sort == ShopSorts.Dearest)) _sort = ShopSorts.Title;   // no prices = no price order
        _batch = Family is not null && Serie is { Length: > 0 } ? Serie : null;
        await LoadMarket();   // the customer's own marks and bids (markedsplads)
        _persist = State.RegisterOnPersisting(() =>
        {
            State.PersistAsJson(SnapshotKey, new Snapshot(_overview, _market, _items));
            return Task.CompletedTask;
        });
        if (State.TryTakeFromJson<Snapshot>(SnapshotKey, out var snap) && snap?.Overview is not null)
        {
            (_overview, _market) = (snap.Overview, snap.Market);
            _items.AddRange(snap.Items);
            return;
        }
        await LoadOverview();
        if (Family is not null && _error is null) await Load(reset: true);
    }

    public void Dispose() => _persist.Dispose();

    /// <summary>Where an old ?vis= link goes now: its shop, with the subcategory when it is one.</summary>
    private static string? OldLink(string vis)
    {
        if (ShopFamilies.For(vis) is { } f)
            return f.Sub(vis) is not null ? $"{f.Path}?under={Uri.EscapeDataString(vis)}" : f.Path;
        return ShopShelves.All.FirstOrDefault(s => s.Name == vis).Types is [var first, ..] && ShopFamilies.For(first) is { } g ? g.Path : null;
    }

    private async Task LoadOverview()
    {
        var (overview, error) = await Shop.OverviewAsync(3);
        (_overview, _error) = (overview, error);
    }

    /// <summary>How many priced things a shop has (its categories' shelves).</summary>
    private int Count(ShopFamily f) => _overview?.Shelves.Where(s => f.Types.Contains(s.Type)).Sum(s => s.Count) ?? 0;

    /// <summary>How many a subcategory has: a category's shelf, a kind's count, or a language within the shop's categories.</summary>
    private int Count(ShopFamily f, ShopSub sub) => sub switch
    {
        { Category: { } c } => _overview?.Shelves.FirstOrDefault(s => s.Type == c)?.Count ?? 0,
        { Kind: { } k } => _overview?.KindCounts?.GetValueOrDefault(k) ?? 0,
        { Language: { } l } => _overview?.LanguageCounts?.GetValueOrDefault(l) is { } per ? f.Types.Sum(t => per.GetValueOrDefault(t)) : 0,
        _ => 0,
    };

    /// <summary>The subcategories that have something (and the chosen one, even when empty).</summary>
    private List<(ShopSub Sub, int Count)> VisibleSubs => Family is null ? []
        : Family.Subs.Select(s => (Sub: s, Count: Count(Family, s))).Where(x => x.Count > 0 || x.Sub == _sub).ToList();

    /// <summary>Up to three pictures for a shop's box, the dearest first.</summary>
    private List<ShopItem> Pictures(ShopFamily f) => (_overview?.Shelves ?? []).Where(s => f.Types.Contains(s.Type))
        .SelectMany(s => s.Items).Where(i => i.HasPhoto).OrderByDescending(i => i.BuyNowKr ?? i.ExpectKr ?? 0).Take(3).ToList();

    private string Heading => _batch is not null ? $"{_batch} ({_market?.Total})" : _query != "" ? $"Søgning: {_query}" : _sub is not null ? $"{_sub.Name} ({_market?.Total})" : $"Alt i {Family?.Name} ({_market?.Total})";

    // The 3 kr packs go with the blade: the whole Tegneserieshoppen or its Serieblade.
    private bool ShowPacks => _query == "" && _batch is null && Family == ShopFamilies.Tegneserier && (_sub is null || _sub.Category == ProductTypes.Serieblade);

    private static readonly (string Key, string Name)[] SortNames =
        [(ShopSorts.Title, "A–Å"), (ShopSorts.Cheapest, "Billigst"), (ShopSorts.Dearest, "Dyrest"), (ShopSorts.Newest, "Nyeste")];

    /// <summary>?sort=billigst (a link can be shared); A-Å when missing.</summary>
    [SupplyParameterFromQuery(Name = "sort")] public string? SortParam { get; set; }
    /// <summary>?serie=Jonah Hex opens one batch.</summary>
    [SupplyParameterFromQuery(Name = "serie")] public string? Serie { get; set; }
    private string _sort = ShopSorts.Title;

    /// <summary>The address for what is shown now: the shop, its subcategory and the sort order (A-Å is left out).</summary>
    private string Here()
    {
        var q = new List<string>();
        if (_sub is not null) q.Add("under=" + Uri.EscapeDataString(_sub.Name));
        if (_batch is not null) q.Add("serie=" + Uri.EscapeDataString(_batch));
        if (_sort != ShopSorts.Title) q.Add("sort=" + _sort);
        return (Family?.Path ?? "/produkter") + (q.Count > 0 ? "?" + string.Join("&", q) : "");
    }

    // Batches: the series/artists Salg names for one category (ShopMarket.Groups), 2+ things each. A thing is in a batch when one
    // part of its line ("Krigsret! · Jonah Hex · nr. 15") is the series' name.
    private string? _batch;
    private const int BatchFrom = 2;
    /// <summary>Not a series: compilations by many artists (live 2026-11-03: "Various", "Diverse kunstnere" became batches).</summary>
    private static readonly HashSet<string> NotABatch = new(StringComparer.OrdinalIgnoreCase)
        { "Various", "Various Artists", "Diverse", "Diverse kunstnere", "Div. kunstnere", "Blandede kunstnere", "Ukendt" };

    private List<ShopGroup> Batches => _batch is not null || _query != "" || Family is null ? []
        : (_market?.Groups ?? []).Where(g => g.Count >= BatchFrom && g.Name.Trim() != "" && !NotABatch.Contains(g.Name.Trim())).ToList();

    private string? BatchOf(ShopItem i)
    {
        var batches = Batches;
        if (batches.Count == 0) return null;
        var parts = i.Line.Split(" · ", StringSplitOptions.TrimEntries);
        // "Supermule og Bjørnebanden" is a Supermule too (seen live 2026-11-03): the part is the name or starts with it and a space.
        return batches.FirstOrDefault(b => parts.Any(p => p.Equals(b.Name.Trim(), StringComparison.OrdinalIgnoreCase)
            || p.StartsWith(b.Name.Trim() + " ", StringComparison.OrdinalIgnoreCase)))?.Name;
    }

    /// <summary>The search words for a series: letters and digits only ("Anders And & Co." -> "Anders And Co").</summary>
    private static string BatchWords(string name) => string.Join(' ', name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(w => new string(w.Where(char.IsLetterOrDigit).ToArray())).Where(w => w != ""));

    private async Task OpenBatch(string name)
    {
        _batch = name;
        await Address(Here());
        await Load(reset: true);
    }

    private async Task CloseBatch()
    {
        _batch = null;
        await Address(Here());
        await Load(reset: true);
    }

    /// <summary>The cards in the order of the list: a thing alone, or its batch the first time one of its things comes. A batch
    /// none of whose things is loaded yet comes when they are (further down = later in the order).</summary>
    private List<(ShopGroup? Batch, ShopItem? Item)> Rows
    {
        get
        {
            var batches = Batches.ToDictionary(b => b.Name, StringComparer.OrdinalIgnoreCase);
            var shown = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var rows = new List<(ShopGroup?, ShopItem?)>();
            foreach (var i in _items)
            {
                if (BatchOf(i) is not { } name) rows.Add((null, i));
                else if (shown.Add(name)) rows.Add((batches[name], null));
            }
            // A-Å: a batch is read by its own name ("Jonah Hex" under J), so the cards are put in name order - a thing by what
            // its card starts with (the first part of its line), in Danish order like Lager (NameOrder).
            if (_sort == ShopSorts.Title)
                rows = rows.OrderBy(r => r.Item1?.Name ?? r.Item2!.Line.Split(" · ")[0], DanishOrder).ToList();
            return rows;
        }
    }

    private static readonly StringComparer DanishOrder =
        StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("da-DK"), System.Globalization.CompareOptions.IgnoreCase);

    /// <summary>The lowest price among the loaded things of a batch, or null.</summary>
    private int? FromKr(string batch) => _items.Where(i => BatchOf(i) == batch && !i.ForShow)
        .Select(i => i.DayKr ?? i.BuyNowKr ?? i.ExpectKr).Where(k => k is not null).Min();

    private RenderFragment BatchCard(ShopGroup b) => __builder =>
    {
        var pic = _items.FirstOrDefault(i => i.HasPhoto && BatchOf(i) == b.Name);
        <li class="bs-shop-card bs-batch">
            <button class="bs-batch-open" @onclick="() => OpenBatch(b.Name)">
                <span class="bs-shop-pic">
                    @if (pic is not null) { <img src="/varer/foto/@pic.Id" alt="" loading="lazy" /> }
                    else { <span class="bs-shop-nopic">@b.Name</span> }
                    <span class="bs-batch-count">@b.Count stk.</span>
                </span>
                <span class="bs-shop-body">
                    <b class="bs-batch-name">@b.Name</b>
                    @if (Prices.On && FromKr(b.Name) is { } kr) { <span class="bs-shop-price"><b>fra @kr kr</b></span> }
                    <span class="bs-family-go">Se alle @b.Count →</span>
                </span>
            </button>
        </li>
    };

    private async Task Sort(string key)
    {
        _sort = key;
        await Address(Here());
        await Load(reset: true);
    }

    private async Task Choose(ShopSub? sub)
    {
        (_sub, _query, _text, _batch) = (sub, "", "", null);
        await Address(Here());
        await Load(reset: true);
    }

    private async Task Search()
    {
        _query = _text.Trim();
        if (_query == "") { await ClearSearch(); return; }
        (_sub, _batch) = (null, null);
        await Address(Here());
        await Load(reset: true);
    }

    private async Task ClearSearch()
    {
        (_query, _text) = ("", "");
        if (Family is null) { (_market, _sub) = (null, null); _items.Clear(); await Address("/produkter"); return; }
        await Choose(null);
    }

    private Task More() { _page++; return Load(reset: false); }

    // The address follows (a shared link opens the same), without a navigation - that redrew the page. Back at the top of the list.
    private async Task Address(string url)
    {
        try
        {
            await JS.InvokeVoidAsync("hjem.setAddress", url);
            await JS.InvokeVoidAsync("hjem.scrollToId", "alle");
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private async Task Load(bool reset)
    {
        _loading = true;
        if (reset) { _page = 0; _market = null; _items.Clear(); }
        // A-Z (user 2026-10-31: "all products need to have alphateci order"); only the shop's categories, or the subcategory's.
        var rare = Family == ShopFamilies.Rare;
        IReadOnlyCollection<string>? cats = Family is null || rare ? null : _sub?.Category is { } c ? [c] : Family.Types;
        var (market, error) = await Shop.MarketAsync(rare ? ShopDeals.RareName : null, _sub?.Kind, null, _batch is not null ? BatchWords(_batch) : _query, _sort, _page,
            price: cats is null && !rare ? ShopDeals.WithPrice : null, language: _sub?.Language, categories: cats);
        _loading = false;
        _error = error;
        if (market is null) return;
        _items.AddRange(market.Items);
        _market = market;
    }

    private string ResultText => _market?.Total switch
    {
        null => "",
        0 => "Ingen produkter passer.",
        1 => "1 produkt.",
        var n => $"{n} produkter.",
    };

    /// <summary>The things Lager knows about it, in one line: kind, condition, new/used, year, how many.</summary>
    private static string Facts(ShopItem i) => string.Join(" · ", new[]
    {
        Kinds.Label(i.Kind),
        i.Condition == "" ? "" : $"{i.Condition} stand",
        i.Usage,
        i.Year is { } y ? y.ToString() : "",
        i.Available > 1 ? $"vi har {i.Available}" : "",
    }.Where(s => s != ""));

    // "user should be able to see prices on other sites" (2026-10-29): the listings Lager found, fetched when pressed.
    // No eBay (user same day: "Dont use ebay at all"). Danish first.
    private static readonly HashSet<string> Danish = new(StringComparer.OrdinalIgnoreCase) { "DBA", "GulogGratis", "Nemos", "Faraos", "findbogen" };
    private readonly Dictionary<int, List<ShopProof>> _proof = [];
    private int? _proofLoading;

    private async Task OtherSites(int id)
    {
        _proofLoading = id;
        var page = await Shop.ItemAsync(id);
        _proofLoading = null;
        _proof[id] = (page?.Proof ?? [])
            .Where(p => !p.Source.Equals("eBay", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => Danish.Contains(p.Source)).ThenBy(p => p.IsNew).ThenBy(p => p.Kr)
            .Take(6).ToList();
    }

    // The 3 kr bin online as packs (user 2026-11-02, fixed packs) - with the blade. Not a webshop: you write to us for a pack.
    private RenderFragment Packs(List<ShopPack>? packs) => __builder =>
    {
        if (packs is not { Count: > 0 }) return;
        <div class="bs-packs">
            @foreach (var p in packs)
            {
                <div class="bs-pack">
                    <h3>@p.Name</h3>
                    @if (Prices.On) { <p class="bs-shop-price"><b>@p.Kr kr</b></p> }
                    <p class="k-help">Blandet fra vores kasse – vi har til @p.Left @(p.Left == 1 ? "pakke" : "pakker").</p>
                </div>
            }
            <div class="bs-packs-ask"><a class="k-btn k-btn-primary bs-btn" href="@BogshoppenHome.AskUrl">Vil du have en pakke? Skriv til os</a></div>
        </div>
    };

    // One thing (picture grid, user 2026-11-01): picture, title, price; the rest in ONE fold per card with its own memory.
    private RenderFragment Card(ShopItem i) => __builder =>
    {
        <li class="bs-shop-card">
            <div class="bs-shop-pic">
                @if (i.HasPhoto) { <a class="bs-shop-zoom" href="/varer/foto/@i.Id" target="_blank" rel="noopener" title="Se billedet stort"><img src="/varer/foto/@i.Id" alt="@i.Title" loading="lazy" /></a> }
                else { <span class="bs-shop-nopic">@Kinds.Label(i.Kind)</span> }
                @if (i.Badge != "") { <span class="bs-shop-badge">@ITMartinHjem.Server.Services.NoEmoji.Strip(i.Badge)</span> }
            </div>
            <div class="bs-shop-body">
                <h3>@i.Line</h3>
                @if (i.ForShow) { <p class="bs-forshow">Kun til visning</p> }
                else if (i.Assess) { <p class="bs-shop-noprice bs-assess">@ShopDeals.AssessText</p> }
                else if (!Prices.On) { <p class="bs-shop-noprice">Prisen kommer</p> }
                else if (ShopDeals.Named(i.Deal) is { } deal)
                {
                    @if (deal.Steps is [{ Count: 1 } one]) { <p class="bs-shop-price"><b>@one.Kr kr</b></p> }
                    else { <p class="bs-shop-price">@foreach (var s in deal.Steps) { <b>@s.Count for @s.Kr kr</b> }</p> }
                }
                else if ((i.DayKr ?? i.BuyNowKr ?? i.ExpectKr) is { } kr)
                {
                    <p class="bs-shop-price"><b>@kr kr</b>@if (i.DayKr is not null && i.BuyNowKr is { } was) { <s>@was kr</s> }</p>
                    @if (MarketNotice.On) { <p class="bs-shop-market">På loppemarkedet: <b>@MarketNotice.MarketKr(kr) kr</b></p> }
                }
                else
                {
                    <p class="bs-shop-noprice">@ShopDeals.NoPriceName</p>
                }
                @if (Visibility.Customers && Customer != "" && !i.ForShow) { @MarketButtons(i) }
                <details class="bs-shop-more" data-remember="produkt-@i.Id">
                    <summary>Mere om den</summary>
                    <p class="k-help">@Facts(i)</p>
                    @if (ShopDeals.Named(i.Deal) is { } d2 && d2.Steps.Count > 1) { <p class="k-help">Bland frit mellem alle @d2.Group.ToLowerInvariant() i tilbuddet.</p> }
                    @if (i.Assess) { <p class="k-help">Den er sjælden eller dyr, så vi kigger på den selv og sætter prisen.</p> }
                    else if (Prices.On && !i.ForShow && ShopDeals.Named(i.Deal) is null && (i.DayKr ?? i.BuyNowKr ?? i.ExpectKr) is null)
                    {
                        <p class="k-help">Vi undersøger prisen. Den kan ikke købes endnu.</p>
                    }
                    @* Links only on things with their own price (user 2026-11-02: "only if rare blad there should be links"). *@
                    @if (Prices.On && i.Deal == "" && i.Reference is { } r)
                    {
                        <a class="k-btn k-btn-sm bs-shop-ref" href="@r.Url" target="_blank" rel="noopener nofollow">Lignende koster @r.Kr kr på @r.Source@(r.IsNew ? " (ny)" : "")</a>
                    }
                    @if (i.Interest != "") { <p class="bs-shop-interest">@i.Interest</p> }
                    @if (i.Interested > 0) { <p class="k-help">@i.Interested er interesseret</p> }
                    @* A "vurderes" thing shows no other sites until a person has set the price (2026-11-03). *@
                    @if (i.Deal != "" || i.Assess || !Prices.On) { }
                    else if (_proof.TryGetValue(i.Id, out var proof))
                    {
                        @if (proof.Count == 0)
                        {
                            <p class="k-help">Vi har ikke fundet den til salg andre steder lige nu.</p>
                        }
                        else
                        {
                            <p class="k-help">Kan også købes her:</p>
                            <div class="bs-proof">
                                @foreach (var p in proof)
                                {
                                    <a class="k-btn k-btn-sm" href="@p.Url" target="_blank" rel="noopener nofollow">@p.Source@(p.IsNew ? " (ny)" : ""): @p.Kr kr</a>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <button class="k-btn k-btn-sm" @onclick="() => OtherSites(i.Id)" disabled="@(_proofLoading == i.Id)">@(_proofLoading == i.Id ? "Henter ..." : "Se flere priser")</button>
                    }
                </details>
            </div>
        </li>
    };
}
