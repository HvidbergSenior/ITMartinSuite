@inject ShopUseCases Shop
@inject IJSRuntime JS
@inject PersistentComponentState State
@implements IDisposable

@* The products from Lager on bogshoppen.dk (not a webshop: no basket, no buy button). Simple since 2026-11-03 (user: "the
   search engine is too complex", "i need all in bogshoppen but not as buttons... Should be more simple"): one search field,
   then a section per category with its first few things and one "Se alle" box - no filter buttons. *@
<section class="k-card bs-card bs-shop" id="alle">
    <p class="k-help">Tryk på et billede for at se det stort. Under <b>Mere om den</b> står stand og hvad lignende koster andre steder.</p>

    <form class="bs-search" @onsubmit="Search" @onsubmit:preventDefault>
        <input class="k-input" type="search" aria-label="Søg efter en titel" placeholder="Søg, fx Barnaby eller Storm P" @bind="_text" />
        <button class="k-btn k-btn-primary" type="submit">Søg</button>
    </form>

    @if (_error is not null)
    {
        <p class="k-alert k-alert-warn">@_error</p>
    }
    else if (_query != "" || _cat is not null)
    {
        @* One category, or what the search found. *@
        <button class="k-btn k-btn-sm bs-back" @onclick="Overview">← Alle kategorier</button>
        @if (_market is null)
        {
            <p class="k-help">Henter produkterne ...</p>
        }
        else
        {
            <h3 class="bs-shelf">@(_cat is not null ? $"{_cat} ({_market.Total})" : $"Søgning: {_query}")</h3>
            @if (_cat is not null && _cat != ProductTypes.GamleBlade && ProductTypes.KindsOf(_cat).Contains(Kinds.AndersAnd)) { @Packs(_market.Packs) }
            <p class="bs-count" role="status">@ResultText</p>
            <ul class="bs-shop-grid">
                @foreach (var i in _items) { @Card(i) }
            </ul>
            @if (_items.Count < _market.Total)
            {
                <button class="k-btn k-mt" @onclick="More" disabled="@_loading">@(_loading ? "Henter ..." : $"Vis flere ({_market.Total - _items.Count} til)")</button>
            }
        }
    }
    else if (_overview is null)
    {
        <p class="k-help">Henter produkterne ...</p>
    }
    else
    {
        @* A section per category, the dearest first (the interesting ones), and one box to see all of it. *@
        @foreach (var shelf in _overview.Shelves)
        {
            <h3 class="bs-shelf">@shelf.Type (@shelf.Count)</h3>
            @if (shelf.Type == ProductTypes.Serieblade) { @Packs(_overview.Packs) }
            <ul class="bs-shop-grid">
                @foreach (var i in shelf.Items) { @Card(i) }
            </ul>
            @if (shelf.Count > shelf.Items.Count)
            {
                <button class="k-btn bs-see-all" @onclick="() => Open(shelf.Type)">Se alle @shelf.Count – @shelf.Type</button>
            }
        }
    }
</section>

@code {
    private ShopOverview? _overview;
    private ShopMarket? _market;
    private readonly List<ShopItem> _items = [];
    private string? _error;
    private string _text = "", _query = "";
    private string? _cat;
    private int _page;      // Salg counts pages from 0
    private bool _loading;

    /// <summary>?vis=Bøger opens one category (a link can be shared); anything else is the overview.</summary>
    [SupplyParameterFromQuery(Name = "vis")] public string? Vis { get; set; }

    // No flicker (2026-11-03): the page is drawn twice (server, then live) - the first drawing's data is handed over.
    private sealed record Snapshot(ShopOverview? Overview, ShopMarket? Market, List<ShopItem> Items);
    private PersistingComponentStateSubscription _persist;
    private const string SnapshotKey = "bs-produkter";

    protected override async Task OnInitializedAsync()
    {
        _cat = ProductTypes.All.Contains(Vis) ? Vis : null;
        _persist = State.RegisterOnPersisting(() =>
        {
            State.PersistAsJson(SnapshotKey, new Snapshot(_overview, _market, _items));
            return Task.CompletedTask;
        });
        if (State.TryTakeFromJson<Snapshot>(SnapshotKey, out var snap) && snap is not null && (snap.Overview ?? (object?)snap.Market) is not null)
        {
            (_overview, _market) = (snap.Overview, snap.Market);
            _items.AddRange(snap.Items);
            return;
        }
        if (_cat is null) await LoadOverview(); else await Load(reset: true);
    }

    public void Dispose() => _persist.Dispose();

    private async Task LoadOverview()
    {
        var (overview, error) = await Shop.OverviewAsync();
        (_overview, _error) = (overview, error);
    }

    private async Task Open(string cat)
    {
        (_cat, _query, _text) = (cat, "", "");
        await Address("/produkter?vis=" + Uri.EscapeDataString(cat));
        await Load(reset: true);
    }

    private async Task Overview()
    {
        (_cat, _query, _text, _market) = (null, "", "", null);
        _items.Clear();
        await Address("/produkter");
        if (_overview is null) await LoadOverview();
    }

    private async Task Search()
    {
        _query = _text.Trim();
        if (_query == "") { await Overview(); return; }
        _cat = null;
        await Address("/produkter");
        await Load(reset: true);
    }

    private Task More() { _page++; return Load(reset: false); }

    // The address follows (a shared link opens the same), without a navigation - that redrew the page. Back at the top of the list.
    private async Task Address(string url)
    {
        try
        {
            await JS.InvokeVoidAsync("hjem.rememberCategories", "");   // no remembered choice any more - the overview is the start
            await JS.InvokeVoidAsync("hjem.setAddress", url);
            await JS.InvokeVoidAsync("hjem.scrollToId", "alle");
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private async Task Load(bool reset)
    {
        _loading = true;
        if (reset) { _page = 0; _market = null; _items.Clear(); }
        // A-Z (user 2026-10-31: "all products need to have alphateci order"); a search covers the things with a price.
        var (market, error) = await Shop.MarketAsync(null, null, null, _query, ShopSorts.Title, _page,
            price: _cat is null ? ShopDeals.WithPrice : null, categories: _cat is null ? null : [_cat]);
        _loading = false;
        _error = error;
        if (market is null) return;
        _items.AddRange(market.Items);
        _market = market;
    }

    private string ResultText => _market?.Total switch
    {
        null => "",
        0 => "Ingen produkter passer.",
        1 => "1 produkt.",
        var n => $"{n} produkter.",
    };

    /// <summary>The things Lager knows about it, in one line: kind, condition, new/used, year, how many.</summary>
    private static string Facts(ShopItem i) => string.Join(" · ", new[]
    {
        Kinds.Label(i.Kind),
        i.Condition == "" ? "" : $"{i.Condition} stand",
        i.Usage,
        i.Year is { } y ? y.ToString() : "",
        i.Available > 1 ? $"vi har {i.Available}" : "",
    }.Where(s => s != ""));

    // "user should be able to see prices on other sites" (2026-10-29): the listings Lager found, fetched when pressed.
    // No eBay (user same day: "Dont use ebay at all"). Danish first.
    private static readonly HashSet<string> Danish = new(StringComparer.OrdinalIgnoreCase) { "DBA", "GulogGratis", "Nemos", "Faraos", "findbogen" };
    private readonly Dictionary<int, List<ShopProof>> _proof = [];
    private int? _proofLoading;

    private async Task OtherSites(int id)
    {
        _proofLoading = id;
        var page = await Shop.ItemAsync(id);
        _proofLoading = null;
        _proof[id] = (page?.Proof ?? [])
            .Where(p => !p.Source.Equals("eBay", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => Danish.Contains(p.Source)).ThenBy(p => p.IsNew).ThenBy(p => p.Kr)
            .Take(6).ToList();
    }

    // The 3 kr bin online as packs (user 2026-11-02, fixed packs) - with the blade. Not a webshop: you write to us for a pack.
    private RenderFragment Packs(List<ShopPack>? packs) => __builder =>
    {
        if (packs is not { Count: > 0 }) return;
        <div class="bs-packs">
            @foreach (var p in packs)
            {
                <div class="bs-pack">
                    <h3>@p.Name</h3>
                    <p class="bs-shop-price"><b>@p.Kr kr</b></p>
                    <p class="k-help">Blandet fra vores kasse – vi har til @p.Left @(p.Left == 1 ? "pakke" : "pakker").</p>
                </div>
            }
            <div class="bs-packs-ask"><a class="k-btn k-btn-primary bs-btn" href="@BogshoppenHome.AskUrl">Vil du have en pakke? Skriv til os</a></div>
        </div>
    };

    // One thing (picture grid, user 2026-11-01): picture, title, price; the rest in ONE fold per card with its own memory.
    private RenderFragment Card(ShopItem i) => __builder =>
    {
        <li class="bs-shop-card">
            <div class="bs-shop-pic">
                @if (i.HasPhoto) { <a class="bs-shop-zoom" href="/varer/foto/@i.Id" target="_blank" rel="noopener" title="Se billedet stort"><img src="/varer/foto/@i.Id" alt="@i.Title" loading="lazy" /></a> }
                else { <span class="bs-shop-nopic">@Kinds.Label(i.Kind)</span> }
                @if (i.Badge != "") { <span class="bs-shop-badge">@ITMartinHjem.Server.Services.NoEmoji.Strip(i.Badge)</span> }
            </div>
            <div class="bs-shop-body">
                <h3>@i.Line</h3>
                @if (i.ForShow) { <p class="bs-forshow">Kun til visning</p> }
                else if (ShopDeals.Named(i.Deal) is { } deal)
                {
                    @if (deal.Steps is [{ Count: 1 } one]) { <p class="bs-shop-price"><b>@one.Kr kr</b></p> }
                    else { <p class="bs-shop-price">@foreach (var s in deal.Steps) { <b>@s.Count for @s.Kr kr</b> }</p> }
                }
                else if ((i.DayKr ?? i.BuyNowKr ?? i.ExpectKr) is { } kr)
                {
                    <p class="bs-shop-price"><b>@kr kr</b>@if (i.DayKr is not null && i.BuyNowKr is { } was) { <s>@was kr</s> }</p>
                    @if (MarketNotice.On) { <p class="bs-shop-market">På loppemarkedet: <b>@MarketNotice.MarketKr(kr) kr</b></p> }
                }
                else
                {
                    <p class="bs-shop-noprice">@ShopDeals.NoPriceName</p>
                }
                <details class="bs-shop-more" data-remember="produkt-@i.Id">
                    <summary>Mere om den</summary>
                    <p class="k-help">@Facts(i)</p>
                    @if (ShopDeals.Named(i.Deal) is { } d2 && d2.Steps.Count > 1) { <p class="k-help">Bland frit mellem alle @d2.Group.ToLowerInvariant() i tilbuddet.</p> }
                    @if (!i.ForShow && ShopDeals.Named(i.Deal) is null && (i.DayKr ?? i.BuyNowKr ?? i.ExpectKr) is null)
                    {
                        <p class="k-help">Vi undersøger prisen. Den kan ikke købes endnu.</p>
                    }
                    @* Links only on things with their own price (user 2026-11-02: "only if rare blad there should be links"). *@
                    @if (i.Deal == "" && i.Reference is { } r)
                    {
                        <a class="k-btn k-btn-sm bs-shop-ref" href="@r.Url" target="_blank" rel="noopener nofollow">Lignende koster @r.Kr kr på @r.Source@(r.IsNew ? " (ny)" : "")</a>
                    }
                    @if (i.Interest != "") { <p class="bs-shop-interest">@i.Interest</p> }
                    @if (i.Interested > 0) { <p class="k-help">@i.Interested er interesseret</p> }
                    @if (i.Deal != "") { }
                    else if (_proof.TryGetValue(i.Id, out var proof))
                    {
                        @if (proof.Count == 0)
                        {
                            <p class="k-help">Vi har ikke fundet den til salg andre steder lige nu.</p>
                        }
                        else
                        {
                            <p class="k-help">Kan også købes her:</p>
                            <div class="bs-proof">
                                @foreach (var p in proof)
                                {
                                    <a class="k-btn k-btn-sm" href="@p.Url" target="_blank" rel="noopener nofollow">@p.Source@(p.IsNew ? " (ny)" : ""): @p.Kr kr</a>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <button class="k-btn k-btn-sm" @onclick="() => OtherSites(i.Id)" disabled="@(_proofLoading == i.Id)">@(_proofLoading == i.Id ? "Henter ..." : "Se flere priser")</button>
                    }
                </details>
            </div>
        </li>
    };
}
