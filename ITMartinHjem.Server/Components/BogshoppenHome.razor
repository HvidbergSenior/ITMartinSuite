@inject IDbContextFactory<HjemDb> Dbf

@* bogshoppen.dk (user 2026-10-05): a small home page like ITMartin's - just the setup and a short text about the
   collaboration. Text = Svar -> Sider -> "bogshoppen-dk"; all news about the collaboration lives on the itmartin.dk tab. *@
<PageTitle>Bogshoppen</PageTitle>

<header class="bs-head">
    <span class="bs-tag">🤝 Bogshoppen + ITMartin</span>
    <h1>📚 Bogshoppen</h1>
    <p>Rico og Martin – venner i over 30 år</p>
</header>

@* Teaser (user 2026-10-10): every way Bogshoppen will sell, shown as "coming". Only "Efterlys" works today (the chat below). *@
<section class="k-card hj-sec bs-card bs-soon">
    <h2>⏳ Snart kan du købe på mange måder</h2>
    <div>
        <p class="bs-manifest">Bogshoppen stod for <b>hygge og snak</b> – og en webshop er for upersonlig. Det er ingen hemmelighed, at huslejen blev for høj:
            butikken skulle betale 30.000 kr. om måneden. Derfor bliver Bogshoppen <b>ikke</b> en traditionel webshop – det er ikke meningen. Den er for samlere, nørder og interesserede.
            <b>Én interesseret kunde er bedre end 1.000, der ikke er interesserede.</b></p>
        <p>Over 100.000 bøger, blade, tegneserier, film og spil er ved at blive registreret. Her er alle de måder, du snart kan købe dem på:</p>
        <ul class="bs-ways">
            @foreach (var w in Ways)
            {
                <li class="bs-way">
                    <span class="bs-way-icon" aria-hidden="true">@w.Icon</span>
                    <b>@w.Name</b>
                    <span class="bs-way-line">@w.Line</span>
                    <span class="bs-way-state @(w.Now ? "bs-now" : "")">@(w.Now ? "✅ Virker nu" : "⏳ Kommer snart")</span>
                </li>
            }
        </ul>
        <a class="k-btn k-btn-primary bs-btn" href="https://stem.itmartin.dk/poll/7">🗳 Stem: Hvad vil du gerne kunne købe? – og få et login til liveauktionerne (ingen nyhedsbreve)</a>
        <p class="bs-soon-how">Leder du efter noget bestemt? Skriv det i chatten nederst – så kigger vi efter det, mens vi registrerer.</p>
    </div>
</section>

@* User 2026-10-10: ~300 boxes, opened one at a time like the TV shows about containers. *@
<section class="k-card hj-sec bs-card bs-think">
    <h2>🐦 Den digitale kolibri tænker …</h2>
    <div>
        <p><b>Kan man bringe stemningen fra butikken frem på en anden måde?</b> Hyggen og snakken over disken var det,
            Bogshoppen stod for. ITMartin tænker, at den kan komme igen – bare ikke bag en kasse i en dyr butik:</p>
        <p class="bs-think-quote">"Vi åbner en kasse – lad os se, hvad der er i den."</p>
        <ul>
            <li><b>Omkring 300 kasser</b> står og venter. Ingen ved helt, hvad der er i dem alle sammen.</li>
            <li>Vi <b>åbner én kasse ad gangen – live</b>, ligesom i tv-programmerne om containere. Du kigger med fra mobilen.</li>
            <li>Ser du noget, du vil have, <b>byder du med det samme</b> – eller skriver, at du gerne vil høre mere om det.</li>
            <li>Alt i kassen bliver fotograferet og registreret, så du kan finde det igen bagefter.</li>
            <li>Fortæl os, hvad du samler – så siger vi til, når vi åbner en kasse med det i.</li>
            <li><b>Snakken</b> foregår i chatten under live-videoen – og ved boden, når vi står på et marked.</li>
        </ul>
    </div>
</section>

@{ var (intro, parts) = Sections.Split(_page?.Body); }
@if (intro.Length > 0) { <section class="k-card hj-page bs-card">@TinyMarkdown.Render(intro)</section> }
<div class="bs-card"><SectionBoxes Parts="parts" /></div>

<a class="k-btn k-btn-primary bs-btn" href="https://itmartin.dk/@ITMartinHjem.Server.Pages.Index.CollabSlug">📚 Følg samarbejdet på ITMartin.dk</a>

<ChatBox Available="_available" OwnerName="Martin" />

@code {
    public const string PageSlug = "bogshoppen-dk";
    private Page? _page;
    private bool _available;

    private static readonly (string Icon, string Name, string Line, bool Now)[] Ways =
    [
        ("💬", "Efterlys", "Skriv hvad du leder efter i chatten herunder.", true),
        ("🛎️", "Butikken – som i gamle dage", "Kig på hylderne, spørg os om råd – vi finder det frem og lægger det til side til dig.", false),
        ("📹", "Se lageret live", "Online streaming fra lageret: skriv, hvad du vil se – så finder vi det og viser det i kameraet.", false),
        ("🔨", "Liveauktioner", "Se varerne i kameraet og byd live fra mobilen.", false),
        ("🏪", "Markedsplads", "Bud og byttehandel – giv et bud på det, du gerne vil have.", false),
        ("🔎", "Søg i hele lageret", "Søg på titel, nummer eller år i alle 100.000+ varer.", false),
        ("📦", "Samlinger og årgange", "Køb en hel årgang Anders And eller en hel serie på én gang.", false),
        ("🌍", "eBay og Tradera", "Samlere i udlandet kan også købe – samme vare, sælges kun én gang.", false),
        ("🎪", "Marked med bod", "Mød os med en bod på loppe- og samlermarkeder – kig, snak og køb på stedet.", false),
        ("🤝", "Afhent eller få det sendt", "Hent selv efter aftale, eller få det sendt med posten.", false),
    ];

    // bogshoppen.dk and www.bogshoppen.dk are served by this app too (Cloudflare tunnel -> hjem-web).
    public static bool IsHost(string host) =>
        host.Equals("bogshoppen.dk", StringComparison.OrdinalIgnoreCase) || host.Equals("www.bogshoppen.dk", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbf.CreateDbContextAsync();
        _page = await db.Pages.AsNoTracking().FirstOrDefaultAsync(p => p.Slug == PageSlug);
        _available = (await db.Settings.AsNoTracking().FirstAsync()).Available;
    }
}
