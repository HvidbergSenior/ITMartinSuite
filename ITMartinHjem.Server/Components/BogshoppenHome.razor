@inject IDbContextFactory<HjemDb> Dbf

@* bogshoppen.dk (user 2026-10-05): a small home page like ITMartin's - just the setup and a short text about the
   collaboration. Text = Svar -> Sider -> "bogshoppen-dk"; all news about the collaboration lives on the itmartin.dk tab. *@
<PageTitle>Bogshoppen</PageTitle>

@* Order (user 2026-10-12): Bogshoppen at the top, then Rico/Martin (Svar -> Sider -> "bogshoppen-dk"), then the vote.
   "Sådan følger du med", the "Følg samarbejdet på ITMartin.dk" button, "Snart kan du købe" and the old
   "Hvad vil du gerne kunne købe?" poll (7, still in Stem) were removed the same day; the live-auction vote (poll 8)
   became a teaser + sign-up. *@
<header class="bs-head">
    <span class="bs-tag">🤝 Bogshoppen + ITMartin</span>
    <h1>Bogshoppen</h1>
</header>

@{ var (intro, parts) = Sections.Split(_page?.Body); }
@if (intro.Length > 0) { <section class="k-card hj-page bs-card">@TinyMarkdown.Render(intro)</section> }
<div class="bs-card"><SectionBoxes Parts="parts" /></div>

@* Live-auction teaser right after Rico/Martin (user 2026-10-12: no votes - "start with live-auctions and the product will be
   shown soon", "make teaser"): what is coming, how to buy, how to follow along (sign up as customer, NO newsletters). *@
<AuctionTeaser />

@* User's own text 2026-10-11 - keep it word for word. The "Snart kan du købe på mange måder" heading and the list of
   ways were removed 2026-10-12 (user). *@
<section class="k-card bs-card">
    <div class="bs-manifest">
            <p>Bogshoppen stod for <b>hygge, snak og fællesskab</b>. En webshop kan aldrig helt erstatte det personlige møde, og derfor skal Bogshoppen heller ikke være en traditionel webshop.</p>
            <p>Det er ingen hemmelighed, at huslejen blev for høj. Butikken skulle betale 30.000 kr. om måneden, og det var ganske enkelt ikke holdbart.</p>
            <p>Men idéen bag Bogshoppen lever videre.</p>
            <p>Det handler ikke om at sælge mest muligt til flest mulige. Det handler om at samle mennesker med en fælles interesse. Samlere, nørder og andre, der virkelig interesserer sig for det, de leder efter.</p>
            <p><b>Én interesseret kunde er bedre end 1.000, der ikke er interesserede.</b></p>
            <p>Bogshoppen skal være for dem, der ved, hvad de leder efter – og for dem, der elsker at gå på opdagelse. ❤️</p>
        </div>
    <p class="bs-soon-how">Leder du efter noget bestemt? Skriv det i chatten nederst – så kigger vi efter det, mens vi registrerer.</p>
</section>

@* User 2026-10-10: ~300 boxes, opened one at a time like the TV shows about containers. *@
<section class="k-card hj-sec bs-card bs-think">
    <h2>🐦 Den digitale kolibri tænker …</h2>
    <div>
        <p><b>Kan man bringe stemningen fra butikken frem på en anden måde?</b> Hyggen og snakken over disken var det,
            Bogshoppen stod for. ITMartin tænker, at den kan komme igen – bare ikke bag en kasse i en dyr butik:</p>
        <p class="bs-think-quote">"Vi åbner en kasse – lad os se, hvad der er i den."</p>
        <ul>
            <li><b>Omkring 300 kasser</b> står og venter. Ingen ved helt, hvad der er i dem alle sammen.</li>
            <li>Vi <b>åbner én kasse ad gangen – live</b>, ligesom i tv-programmerne om containere. Du kigger med fra mobilen.</li>
            <li>Ser du noget, du vil have, <b>byder du med det samme</b> – eller skriver, at du gerne vil høre mere om det.</li>
            <li>Alt i kassen bliver fotograferet og registreret, så du kan finde det igen bagefter.</li>
            <li>Fortæl os, hvad du samler – så siger vi til, når vi åbner en kasse med det i.</li>
            <li><b>Snakken</b> foregår i chatten under live-videoen – og ved boden, når vi står på et marked.</li>
        </ul>
    </div>
</section>

@* Bogshoppen's own "Det spørger folk om" - questions from the chat, no names (user 2026-10-12). *@
<QuestionsBox Site="@QuestionRules.Bogshoppen" />

<ChatBox Available="_available" OwnerName="Martin" />

@code {
    public const string PageSlug = "bogshoppen-dk";
    private Page? _page;
    private bool _available;

    // bogshoppen.dk and www.bogshoppen.dk are served by this app too (Cloudflare tunnel -> hjem-web).
    public static bool IsHost(string host) =>
        host.Equals("bogshoppen.dk", StringComparison.OrdinalIgnoreCase) || host.Equals("www.bogshoppen.dk", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbf.CreateDbContextAsync();
        _page = await db.Pages.AsNoTracking().FirstOrDefaultAsync(p => p.Slug == PageSlug);
        _available = (await db.Settings.AsNoTracking().FirstAsync()).Available;
    }
}
