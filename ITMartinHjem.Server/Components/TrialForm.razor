@inject Customers Kartotek

@* "Prøv gratis" on the free apps on Mine apps (user 2026-10-12/21): e-mail -> customer in the Kundekartotek (Kunder) ->
   Martin sends access. ONE sign-up = ALL the free apps (FreeApps). Never pre-ticked; the list says exactly what it means. *@
<div class="tf">
    @if (_sent)
    {
        @if (_code != "")
        {
            <p><b>Tak – du er skrevet op!</b> Dit kundenummer er</p>
            <p class="tf-code">@ITMartinHjem.Domain.SignUpRules.Show(_code)</p>
            <p>Skriv det, når @string.Join(" eller ", FreeApps) beder om det. Vi har også sendt det til <b>@_email</b> (kig i spam-mappen, hvis det ikke kommer).</p>
        }
        else
        {
            <p><b>Tak – du er skrevet op!</b> Martin sender dit kundenummer til <b>@_email</b> – som regel samme dag. Kig også i spam-mappen.</p>
        }
    }
    else if (!_open)
    {
        <button class="k-btn k-btn-sm k-btn-primary" @onclick="() => _open = true">Prøv gratis</button>
    }
    else
    {
        <p class="k-help">Skriv dig op én gang, så får du et kundenummer til alle de gratis apps: <b>@string.Join(", ", FreeApps)</b> –
            og et login til liveauktionerne på bogshoppen.dk, når de åbner.</p>
        <input class="k-input" @bind="_name" maxlength="60" placeholder="Dit navn (valgfrit)" aria-label="Dit navn" autocomplete="name" />
        <input class="k-input k-mt" type="email" inputmode="email" autocomplete="email" @bind="_email" maxlength="120" placeholder="Din e-mail" aria-label="Din e-mail" />
        <SignUpMeans />
        <label class="sp-optin"><input type="checkbox" @bind="_consent" /> <span>@ITMartinHjem.Domain.TrialRules.ConsentText</span></label>
        @if (_error.Length > 0) { <p class="form-error">@_error</p> }
        <button class="k-btn k-btn-primary k-mt" disabled="@_busy" @onclick="SendAsync">Send mig adgang</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string App { get; set; } = "";
    /// <summary>The free apps whose extras need the kundenummer (ElPriser, Stem).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> FreeApps { get; set; } = [];

    private bool _open, _sent, _consent, _busy;
    private string _name = "", _email = "", _error = "", _code = "";

    private async Task SendAsync()
    {
        _busy = true; _error = "";
        try
        {
            var r = await Kartotek.RequestTrialAsync(App, _name, _email, _consent);
            if (r.Error is null) { _email = _email.Trim().ToLowerInvariant(); _code = r.Code; _sent = true; } else _error = r.Error;
        }
        finally { _busy = false; }
    }
}
