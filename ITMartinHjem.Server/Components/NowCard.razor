@inject IDbContextFactory<HjemDb> Dbf

@* Martin's "Lige nu" (text + picture/film/stream, edited in Svar -> 📌 Lige nu). Shown at the top of the
   "Hvad laver ITKolibrien lige nu?" tab - SitePage puts it there for slug NowCard.PageSlug. *@
@if (_s is not null)
{
<section class="k-card hj-now">
    <h2 class="k-card-title">@(Compact ? "📅 I dag" : "📌 Lige nu")</h2>
    @if (Compact) { }
    else if (Embed.PlayerUrl(_s.NowLink) is { } player)
    {
        <div class="hj-embed"><iframe src="@player" title="Video" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen loading="lazy"></iframe></div>
    }
    else if (_s.NowMediaName.Length > 0 && _s.NowMediaType.StartsWith("video/"))
    {
        <video class="hj-video" src="/nu/@_s.NowMediaName" controls preload="metadata" playsinline></video>
    }
    else if (_s.NowMediaName.Length > 0)
    {
        <a href="/nu/@_s.NowMediaName" target="_blank" rel="noopener"><img class="hj-now-img" src="/nu/@(_s.NowMediaThumb.Length > 0 ? _s.NowMediaThumb : _s.NowMediaName)" alt="Lige nu" /></a>
    }
    @if (!Compact && _s.NowLink.Length > 0 && Embed.PlayerUrl(_s.NowLink) is null)
    {
        <a class="k-btn k-btn-primary k-mt" href="@_s.NowLink" target="_blank" rel="noopener">▶ Se med</a>
    }
    @{
        // Today is always on top (also when empty); every earlier day goes under "Tidligere dage".
        var today = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "Europe/Copenhagen").Date;
        var days = _s.Entries().Select(e => e.At.Date).Concat(_notes.Keys).Distinct().OrderByDescending(d => d).ToList();
        var earlier = days.Where(d => d < today).ToList();
    }
    @if (days.Contains(today))
    {
        @DayBlock(today)
    }
    else
    {
        <div class="hj-day">
            <div class="hj-day-head">I dag · @today.ToString("dddd d. MMMM", Da)</div>
            <p class="k-help">Martin har ikke skrevet noget i dag endnu – kig forbi senere, eller skriv til ham i chatten.</p>
        </div>
    }
    @if (earlier.Count > 0 && !Compact)
    {
        <details class="hj-day-earlier">
            <summary>Tidligere dage (@earlier.Count)</summary>
            @foreach (var d in earlier) { @DayBlock(d) }
        </details>
    }
    @if (!Compact && (_s.NowText.Length > 0 || _s.NowMediaName.Length > 0 || _s.NowLink.Length > 0))
    {
        @if (_s.NowText.Length > 0) { <div class="hj-now-text">@TinyMarkdown.Render(_s.NowText)</div> }
        <p class="k-help">📅 Opdateret @Dk.Local(_s.NowUpdated).ToString("d. MMMM yyyy", Da)</p>
    }
</section>
}

@code {
    public const string PageSlug = "hvad-laver-itkolibrien";
    // Front page (user 2026-10-05 "a bit too much info"): only today - no fixed Lige nu text/media, no earlier days.
    [Parameter] public bool Compact { get; set; }
    private static readonly CultureInfo Da = new("da-DK");
    private Settings? _s;
    private Dictionary<DateTime, DayNote> _notes = [];

    // Plan / "what it became": one task per line, shown as bullet points (a typed "*", "-" or "•" is dropped).
    private static RenderFragment Bullets(string text) => __builder =>
    {
        <ul class="hj-day-tasks">
            @foreach (var line in text.Split('\n').Select(l => l.Trim().TrimStart('*', '-', '•').Trim()).Where(l => l.Length > 0))
            {
                <li>@line</li>
            }
        </ul>
    };

    // One day of "Min dag": heading with the date, then the entries newest first, date + time under every picture.
    private RenderFragment DayBlock(DateTime day) => __builder =>
    {
        var today = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "Europe/Copenhagen").Date;
        <div class="hj-day">
            <div class="hj-day-head">@(day == today ? "I dag · " : day == today.AddDays(-1) ? "I går · " : "")@day.ToString("dddd d. MMMM", Da)</div>
            @{ _notes.TryGetValue(day, out var note); }
            @if (note is { Plan.Length: > 0 })
            {
                <div class="hj-day-plan"><b>🌅 @(day == today ? "Det regner jeg med at lave" : "Det regnede jeg med at lave")</b>@Bullets(note.Plan)</div>
            }
            @if (note is { Done.Length: > 0 })
            {
                <div class="hj-day-done"><b>🌙 Det fik jeg lavet</b>@Bullets(note.Done)</div>
            }
            @foreach (var e in _s!.Entries().Where(x => x.At.Date == day))
            {
                <div class="hj-day-entry">
                    <div class="hj-day-time">kl. @e.At.ToString("HH.mm")</div>
                    @if (e.Text.Length > 0) { <div class="hj-day-text">@TinyMarkdown.Render(e.Text)</div> }
                    @if (e.Stored.Length > 0)
                    {
                        <figure class="tm-fig">
                            <a href="/nu/@e.Stored" target="_blank" rel="noopener"><img class="hj-day-img" loading="lazy" src="/nu/@e.Stored" alt="@e.Text.Replace("* ", "")" /></a>
                            <figcaption>📅 @e.At.ToString("d. MMMM yyyy 'kl.' HH.mm", Da)</figcaption>
                        </figure>
                    }
                </div>
            }
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbf.CreateDbContextAsync();
        _s = await db.Settings.AsNoTracking().FirstAsync();
        _notes = (await db.DayNotes.AsNoTracking().ToListAsync())
            .Where(n => (n.Plan.Length > 0 || n.Done.Length > 0) && DateTime.TryParse(n.Day, out _))
            .ToDictionary(n => DateTime.Parse(n.Day), n => n);
    }
}
