@inject Customers Kartotek

@* bogshoppen.dk teaser (user 2026-10-12): "I want to start with live-auctions and the product will be shown soon", "make teaser",
   product-oriented - easy to see what is coming, how to follow along and how to buy. No votes. *@
@* Sign-up box first and open (user 2026-10-22: "coming soon and sign up"). *@
<section class="k-card bs-card bs-signup" id="foelg" data-nofold>
    <h2>Skriv dig op – gratis</h2>
    <div>
        @if (_sent)
        {
            <p class="bs-done"><b>Tak – du er skrevet op</b>@(_code != "" ? $" Dit kundenummer er {ITMartinHjem.Domain.SignUpRules.Show(_code)}." : "")
                Det er dit login til liveauktionerne, når den første er klar, og det giver dig adgang til de gratis apps på itmartin.dk.
                Vi har sendt det til <b>@_email</b>. Du kan altid afmelde dig.</p>
            <a class="k-btn k-btn-sm" href="/afmeld">Afmeld</a>
        }
        else
        {
            <p>Bogshoppen åbner snart igen – med liveauktioner. Skriv dig op, så får du besked og et login, når den første auktion starter. Sæt gerne kryds ved det, du samler.</p>
            <div class="sp-options">
                @foreach (var (title, _) in BogshoppenRules.Products)
                {
                    <button type="button" class="sp-option @(_collects.Contains(title) ? "on" : "")" aria-pressed="@(_collects.Contains(title) ? "true" : "false")"
                            @onclick="() => Toggle(title)">@(_collects.Contains(title) ? "" : "") @title</button>
                }
            </div>
            <input class="k-input k-mt" @bind="_name" maxlength="60" placeholder="Dit navn" aria-label="Dit navn" autocomplete="name" />
            <input class="k-input k-mt" type="email" inputmode="email" autocomplete="email" @bind="_email" maxlength="120" placeholder="Din e-mail" aria-label="Din e-mail" />
            <textarea class="k-input k-textarea k-mt" @bind="_note" maxlength="280" rows="2" placeholder="Leder du efter noget bestemt? (valgfrit)" aria-label="Leder du efter noget bestemt?"></textarea>
            <SignUpMeans />
            <label class="sp-optin"><input type="checkbox" @bind="_consent" /> <span>@BogshoppenRules.ConsentText</span></label>
            @if (_error.Length > 0) { <p class="form-error">@_error</p> }
            <button class="k-btn k-btn-primary bs-btn k-mt" disabled="@_busy" @onclick="SendAsync">Skriv mig op</button>
        }
    </div>
</section>

<section class="k-card bs-card bs-auction">
    <h2>Liveauktioner – snart</h2>
    <div>
        <p><b>Vi starter med liveauktioner.</b> Vi viser varerne i kameraet, og du byder fra mobilen. Varerne bliver vist her snart.</p>

        @* "Se hvilke varer der kommer" button removed 2026-10-22: Varer is off for visitors until the shop opens (user). *@

    </div>
</section>

@* Each part is its own show/hide box (user 2026-10-12: "hide/show boxes on bogshoppen where appropriate"). *@
@* Big boxes like "Chat med Martin" (user 2026-10-12), one per step. *@
<section class="k-card bs-card" data-fold-closed="1">
    <h2>Sådan køber du</h2>
    <div>
        <div class="bs-bigsteps">
            <div class="bs-bigstep">
                <h4>1. Skriv dig op</h4>
                <p>Det tager et minut – navn og e-mail. Ingen reklamer, ingen nyhedsbreve.</p>
                <a class="k-btn k-btn-primary k-btn-block bs-btn" href="#foelg">Skriv mig op</a>
            </div>
            <div class="bs-bigstep">
                <h4>2. Få dit login</h4>
                <p>Vi sender dig et login til liveauktionerne på mail, når den første auktion er klar.</p>
            </div>
            <div class="bs-bigstep">
                <h4>3. Kig med og byd live</h4>
                <p>Vi viser varerne i kameraet. Du ser med på mobilen, stiller spørgsmål i chatten og byder med ét tryk.</p>
                <a class="k-btn k-btn-primary k-btn-block bs-btn" href="https://kigmed.itmartin.dk" target="_blank" rel="noopener">Kig med live</a>
            </div>
            <div class="bs-bigstep">
                <h4>4. Hent eller få det sendt</h4>
                <p>Hent varen efter aftale, eller få den sendt med posten.</p>
                <a class="k-btn k-btn-primary k-btn-block bs-btn" href="@BogshoppenHome.AskUrl">Spørg Martin på itmartin.dk</a>
            </div>
        </div>

    </div>
</section>

@code {
    private readonly HashSet<string> _collects = [];
    private string _name = "", _email = "", _note = "", _error = "", _code = "";
    private bool _consent, _busy, _sent;

    private void Toggle(string title) { if (!_collects.Remove(title)) _collects.Add(title); }

    private async Task SendAsync()
    {
        _busy = true; _error = "";
        try
        {
            var r = await Kartotek.FollowBogshoppenAsync(_name, _email, _collects, _note, _consent);
            if (r.Error is null) { _email = _email.Trim().ToLowerInvariant(); _code = r.Code; _sent = true; } else _error = r.Error;
        }
        finally { _busy = false; }
    }
}
