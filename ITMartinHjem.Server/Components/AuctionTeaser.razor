@inject Customers Kartotek

@* bogshoppen.dk teaser (user 2026-10-12): "I want to start with live-auctions and the product will be shown soon", "make teaser",
   product-oriented - easy to see what is coming, how to follow along and how to buy. No votes. *@
@* Sign-up box first and open (user 2026-10-22: "coming soon and sign up"); can be closed like itmartin.dk's (2026-10-29),
   the head's "Skriv mig op – gratis" opens it again (kolibri.js). *@
<section class="k-card bs-card bs-signup" id="foelg">
    <h2>Skriv dig op – gratis</h2>
    <div>
        @if (_sent)
        {
            <p class="bs-done"><b>Tak – du er skrevet op</b>@(_code != "" ? $" Dit nummer er {ITMartinHjem.Domain.SignUpRules.Show(_code)}." : "")
                Med det kan du senere trykke på de produkter, du er interesseret i, og det giver dig adgang til de gratis apps på itmartin.dk.
                Vi har sendt det til <b>@_email</b>. Du kan altid afmelde dig.</p>
            <a class="k-btn k-btn-sm" href="/afmeld">Afmeld</a>
        }
        else
        {
            @* No auction text and no product ticks any more (user 2026-10-29: "this not needed anymore ... They just push products later
               to show interest. But sign up of course"). *@
            <p>Skriv dig op gratis, så får du dit nummer med det samme. Senere kan du trykke på de produkter, du er interesseret i.</p>
            <input class="k-input k-mt" @bind="_name" maxlength="60" placeholder="Dit navn" aria-label="Dit navn" autocomplete="name" />
            <input class="k-input k-mt" type="email" inputmode="email" autocomplete="email" @bind="_email" maxlength="120" placeholder="Din e-mail" aria-label="Din e-mail" />
            <textarea class="k-input k-textarea k-mt" @bind="_note" maxlength="280" rows="2" placeholder="Leder du efter noget bestemt? (valgfrit)" aria-label="Leder du efter noget bestemt?"></textarea>
            <SignUpMeans />
            <label class="sp-optin"><input type="checkbox" @bind="_consent" /> <span>@BogshoppenRules.ConsentText</span></label>
            @if (_error.Length > 0) { <p class="form-error">@_error</p> }
            @if (_suggestion.Length > 0) { <button type="button" class="k-btn k-btn-primary k-mt" disabled="@_busy" @onclick="UseSuggestionAsync">Ja, brug @_suggestion</button> }
        @if (_suggestion.Length > 0) { <button type="button" class="k-btn k-btn-primary k-mt" disabled="@_busy" @onclick="UseSuggestionAsync">Ja, brug @_suggestion</button> }
            <button class="k-btn k-btn-primary bs-btn k-mt" disabled="@_busy" @onclick="SendAsync">Skriv mig op</button>
        }
    </div>
</section>

@* "Liveauktioner – snart" and "Sådan køber du" removed 2026-10-24 (user: "remove liveauktioner and Sådan køber du from bogshoppen"). *@

@code {
    private readonly HashSet<string> _collects = [];   // nothing to tick any more (2026-10-29) - sent empty
    private string _name = "", _email = "", _note = "", _error = "", _code = "", _suggestion = "";

    // "Mente du …?" (2026-10-29): one press fixes the address and sends again.
    private async Task UseSuggestionAsync() { _email = _suggestion; await SendAsync(); }
    private bool _consent, _busy, _sent;

    private async Task SendAsync()
    {
        _busy = true; _error = ""; _suggestion = "";
        try
        {
            var r = await Kartotek.FollowBogshoppenAsync(_name, _email, _collects, _note, _consent);
            if (r.Error is null) { _email = _email.Trim().ToLowerInvariant(); _code = r.Code; _sent = true; } else (_error, _suggestion) = (r.Error, r.Suggestion);
        }
        finally { _busy = false; }
    }
}
