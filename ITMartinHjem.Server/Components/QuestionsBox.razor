@inject PublicQuestions Questions
@inject NavigationManager Nav

@* Front page: the newest public Q&As from the chat (no names) + a search that opens /spoergsmaal (user 2026-10-12). *@
@if (_total == 0 && ShowEmpty)
{
    @* bogshoppen.dk shows the box before the first question is up (user 2026-10-12: "what about the Q/A on bogshoppen?"). *@
    <section class="k-card hj-qa-box">
        <h2 class="k-card-title">@E("💬")Det spørger folk om</h2>
        <p>Her kommer spørgsmål fra chatten og vores svar – <b>uden navne</b>. Så kan du se, om dit spørgsmål allerede er besvaret.</p>
        <p class="k-help">Der er ingen spørgsmål her endnu.</p>
        <a class="k-btn k-btn-sm" href="#chat">@E("💬")Stil det første i chatten</a>
    </section>
}
else if (_total > 0)
{
    <section class="k-card hj-qa-box">
        <h2 class="k-card-title">@E("💬")Det spørger folk om</h2>
        <p class="k-help">Spørgsmål fra chatten og mine svar – uden navne. Søg, eller tryk på et emne.</p>
        <form class="k-row" @onsubmit="Search">
            <input class="k-input" type="search" @bind="_q" placeholder="Søg, fx budget, billeder…" aria-label="Søg i spørgsmål" />
            <button class="k-btn k-btn-primary" type="submit">@E("🔍")Søg</button>
        </form>
        <div class="hj-qa-topics">
            @foreach (var (t, n) in _topics.Take(8))
            {
                <a class="hj-chip" href="/spoergsmaal?emne=@Uri.EscapeDataString(t)">@t (@n)</a>
            }
        </div>
        <div class="hj-qa-boxes">
            @foreach (var q in _latest)
            {
                <a class="hj-qa-boxlink" href="/spoergsmaal#q@(q.Id)">@(q.Site == QuestionRules.Bogshoppen && AllSites ? (Plain ? "Bogshoppen: " : "📚 ") : E("❓"))@Short(q.Question, 110)</a>
            }
        </div>
        <a class="k-btn k-btn-sm" href="/spoergsmaal">Se alle @_total spørgsmål</a>
    </section>
}

@code {
    private string _q = "";
    private List<PublicQuestion> _latest = [];
    private List<(string Topic, int Count)> _topics = [];
    private int _total;

    [Parameter] public string Site { get; set; } = QuestionRules.ITMartin;
    // itmartin.dk shows the questions from both sites (user 2026-10-12); bogshoppen.dk only its own.
    [Parameter] public bool AllSites { get; set; }
    // itmartin.dk front page: no emojis - they look AI-made; it should feel personal (user 2026-10-12). Set by Index.
    [CascadingParameter(Name = "Plain")] public bool Plain { get; set; }
    private string E(string emoji) => Plain ? "" : emoji + " ";
    // Show the box with an "ingen spørgsmål endnu" line instead of hiding it.
    [Parameter] public bool ShowEmpty { get; set; }

    protected override async Task OnInitializedAsync() => (_latest, _topics, _total) = await Questions.LatestAsync(3, AllSites ? null : Site);

    private void Search() => Nav.NavigateTo("/spoergsmaal?q=" + Uri.EscapeDataString(_q.Trim()));

    private static string Short(string s, int max)
    {
        var line = s.Replace('\n', ' ');
        return line.Length <= max ? line : line[..max].TrimEnd() + "…";
    }
}
