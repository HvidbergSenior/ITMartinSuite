<!DOCTYPE html>
<html lang="da" data-family="rede">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Martin Hvidberg – hvad jeg laver, hvad jeg tænker, og min familie. Skriv til mig direkte på siden." />
    <title>Martin Hvidberg</title>
    <base href="/" />
    <link rel="stylesheet" href="_content/ITMartin.Shared.UI/css/kolibri.css?v=@CacheBuster" />
    <script src="_content/ITMartin.Shared.UI/kolibri.js?v=@CacheBuster" defer></script>
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    @* /admin gets its own manifest so "Føj til hjemmeskærm" there opens /admin, not the front page. *@
    <link rel="manifest" href="@(IsAdmin ? "/admin.webmanifest" : "/manifest.webmanifest")" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@(IsAdmin ? "Svar" : "Martin")" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <script src="hjem.js?v=@CacheBuster"></script>
    <script src="fest.js?v=@CacheBuster" defer></script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.server.js"></script>
    @* sw.js = the Kolibri installability worker plus push handling for the owner's chat alerts. *@
    <script>if("serviceWorker" in navigator){navigator.serviceWorker.register("/sw.js").catch(function(){});}</script>
    <div id="components-reconnect-modal">
        <span class="reconnect-msg">Forbinder igen…</span>
        <span class="reconnect-failed-msg">Forbindelsen er tabt — <button onclick="location.reload()">Genindlæs</button></span>
    </div>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private bool IsAdmin => HttpContext?.Request.Path.StartsWithSegments("/admin") == true;
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
