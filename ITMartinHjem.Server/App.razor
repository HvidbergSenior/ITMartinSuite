<!DOCTYPE html>
@* The shared Kolibri look like the apps (user 2026-10-21: the homepage in the apps' orange-red too); the old "idag" theme
   is no longer used. bogshoppen.dk keeps its own shop look (.bs-site) and stays light. *@
<html lang="da" data-family="puls">
<head>
    <script>
        // Dark or light like the apps: what the visitor chose with Lys/Mørk, else the phone's setting - before the first paint.
        (function () {
            if (/bogshoppen\.dk$/.test(location.hostname)) return;
            var t = localStorage.getItem('itmartin_theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    @* bogshoppen.dk is served by this app too: its own tab title and description, so a shared link
       and the browser tab say Bogshoppen, not Martin Hvidberg (browsers show the FIRST <title>). *@
    @if (IsBogshoppen)
    {
        <meta name="description" content="Bogshoppen – følg hvordan Bogshoppen og ITMartin arbejder sammen." />
        <title>Bogshoppen</title>
    }
    else
    {
        <meta name="description" content="Martin Hvidberg – hvad jeg laver, hvad jeg tænker, og min familie. Skriv til mig direkte på siden." />
        <title>Martin Hvidberg</title>
    }
    <base href="/" />
    <link rel="stylesheet" href="_content/ITMartin.Shared.UI/css/kolibri.css?v=@CacheBuster" />
    <script src="_content/ITMartin.Shared.UI/kolibri.js?v=@CacheBuster" defer></script>
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    @* /admin gets its own manifest so "Føj til hjemmeskærm" there opens /admin, not the front page. *@
    <link rel="manifest" href="@(IsAdmin ? "/admin.webmanifest" : "/manifest.webmanifest")" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@(IsAdmin ? "Svar" : "Martin")" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <script src="hjem.js?v=@CacheBuster"></script>
    <script src="kurv.js?v=@CacheBuster"></script>
    <script src="fest.js?v=@CacheBuster" defer></script>
    <script src="t.js?v=@CacheBuster" defer></script>
    @* Budget + Tjek dine billeder: rules (domain) first, then the page part - all in the browser, nothing is sent. *@
    <script src="budget/budget-domain.js?v=@CacheBuster" defer></script>
    <script src="budget/budget-ui.js?v=@CacheBuster" defer></script>
    <script src="billeder/billeder-domain.js?v=@CacheBuster" defer></script>
    <script src="billeder/billeder-ui.js?v=@CacheBuster" defer></script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" ShopVisible="@ShopVisible" ShopCustomer="@ShopCustomer" />
    <script src="_framework/blazor.server.js"></script>
    @* sw.js = the Kolibri installability worker plus push handling for the owner's chat alerts. *@
    <script>if("serviceWorker" in navigator){navigator.serviceWorker.register("/sw.js").catch(function(){});}</script>
    <script>
    // The Lys/Mørk button in the menu (Blazor renders it again, so the click is caught on the document).
    (function () {
        function sync() {
            var btn = document.getElementById('themeToggleBtn');
            var label = (document.documentElement.getAttribute('data-theme') || 'light') === 'light' ? 'Mørk' : 'Lys';
            if (btn && btn.textContent !== label) btn.textContent = label;
        }
        document.addEventListener('click', function (e) {
            if (!e.target.closest || !e.target.closest('#themeToggleBtn')) return;
            var next = (document.documentElement.getAttribute('data-theme') || 'light') === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('itmartin_theme', next);
            sync();
        });
        new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
        sync();
    })();
    </script>
    <div id="components-reconnect-modal">
        <span class="reconnect-msg">Forbinder igen…</span>
        <span class="reconnect-failed-msg">Forbindelsen er tabt — <button onclick="location.reload()">Genindlæs</button></span>
    </div>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private bool IsAdmin => HttpContext?.Request.Path.StartsWithSegments("/admin") == true;
    private bool IsBogshoppen => HttpContext is not null && Components.BogshoppenHome.IsHost(HttpContext.Request.Host.Host);
    // Read here, where the request is - the pages run in the circuit and get it as a parameter (data-protected).
    [Inject] private ShopVisibility Visibility { get; set; } = null!;
    private bool ShopVisible => Visibility.Visible(HttpContext?.Request.Cookies[ShopVisibility.Cookie]);
    // The kundenummer of a customer logged into the marketplace ("" = none) - read here for the same reason.
    [Inject] private MarketCookie Market { get; set; } = null!;
    private string ShopCustomer => Market.Read(HttpContext);
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
