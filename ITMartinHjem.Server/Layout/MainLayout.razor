@inherits LayoutComponentBase
@inject IDbContextFactory<HjemDb> Dbf

@* The site menu - order and contents come from SiteMenu (pages marked "Vis i menuen" in Svar). *@
<nav class="hj-nav">
    @foreach (var i in _menu) { <a class="@(i.Pilot ? "hj-nav-pilot" : "")" href="@i.Href">@i.Title</a> }
</nav>
<div class="k-main"><div class="k-content">
    @Body
</div></div>
<KolibriFooter />

@code {
    private List<SiteMenu.Item> _menu = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbf.CreateDbContextAsync();
        _menu = await SiteMenu.BuildAsync(db);
    }
}
