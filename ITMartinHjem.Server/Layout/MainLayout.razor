@inherits LayoutComponentBase
@inject SiteUseCases Site
@inject IConfiguration Config
@inject NavigationManager Nav

@* Birthday day (Components/Fest): rose/gold colours + a strip under the menu on every page, not in Svar. *@
<div class="@(_fest ? "fest-site" : "") @(_bs ? "bs-site" : "")">
@if (!_bs)
{
@* The site menu - order and contents come from SiteMenu (pages marked "Vis i menuen" in Svar). *@
<nav class="hj-nav">
    @foreach (var i in _menu) { <a class="@(i.Pilot ? "hj-nav-pilot" : "")" href="@i.Href">@i.Title</a> }
</nav>
}
else
{
@* bogshoppen.dk has its own two tabs (user 2026-10-12: "a tab on bogshoppen. Forside and one more" -> Varer). *@
<nav class="hj-nav bs-nav">
    <a href="/">Forside</a>
    <a href="/varer">Varer</a>
    @if (ShopVisible) { <a href="/kurv">Kurv<span data-kurv-count></span></a> }
    <a href="/om-bogshoppen">Om Bogshoppen</a>
    <a href="/spoergsmaal">Spørgsmål</a>
</nav>
}
@if (_fest && !_bs)
{
    <a class="fest-strip" href="/vibeke">
        <span class="fest-strip-flags" aria-hidden="true">@foreach (var i in Enumerable.Range(0, 14)) { <i style="--i:@i"></i> }</span>
        <b>Vibeke har fødselsdag i dag!</b> <span>Se hvorfor hun er den bedste →</span>
    </a>
}
<div class="k-main"><div class="k-content">
    @* No emojis anywhere on the sites (user 2026-10-12) - shared components read this. *@
    <CascadingValue Name="Plain" Value="true">@Body</CascadingValue>
</div></div>
<KolibriFooter />
</div>

@code {
    private List<SiteMenu.Item> _menu = [];
    [CascadingParameter(Name = "ShopVisible")] private bool ShopVisible { get; set; }
    private bool _fest, _bs;   // _bs = visitor came via bogshoppen.dk: no ITMartin menu

    protected override async Task OnInitializedAsync()
    {
        _menu = await Site.MenuAsync();
        _bs = BogshoppenHome.IsHost(new Uri(Nav.Uri).Host);
        _fest = Fest.IsOn(Config) && !Nav.ToBaseRelativePath(Nav.Uri).StartsWith("admin", StringComparison.OrdinalIgnoreCase);
    }
}
