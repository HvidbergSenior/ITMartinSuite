@inherits LayoutComponentBase
@inject SiteUseCases Site
@inject IConfiguration Config
@inject NavigationManager Nav

@* Fallback tab title - a page's own <PageTitle> renders later and wins. *@
<PageTitle>@(_bs ? "Bogshoppen" : "Martin Hvidberg")</PageTitle>

@* Birthday day (Components/Fest): rose/gold colours + a strip under the menu on every page, not in Svar. *@
<div class="@(_fest ? "fest-site" : "") @(_bs ? "bs-site" : "")">
@if (!_bs)
{
@* The site menu - order and contents come from SiteMenu (pages marked "Vis i menuen" in Svar). *@
<nav class="hj-nav">
    @* The same ITMartin Kolibri logo as top-left in every app (user 2026-10-27: "and the ITMartin Kolibri which are on the apps"). *@
    <a class="hj-nav-logo" href="/" aria-label="ITMartin – forsiden"><img class="k-logo-brand" src="/_content/ITMartin.Shared.UI/itmartin-logo.png" alt="ITMartin" /></a>
    @foreach (var i in _menu) { <a class="@(i.Pilot ? "hj-nav-pilot" : "")" href="@i.Href">@i.Title</a> }
    @* Light/dark like the apps (App.razor's script listens for clicks on it). *@
    <button id="themeToggleBtn" class="hj-nav-theme" type="button" title="Skift lys/mørk visning">Lys/mørk</button>
</nav>
}
else
{
@* bogshoppen.dk = products (user 2026-10-29: "bogshoppen should only have Om bogshoppen og forside (where you can sign up)",
   "And also the products", "Bogshoppen is Products. ItMartin is processes"). No Varer/Kurv, no Spørgsmål tab. *@
<nav class="hj-nav bs-nav">
    @* The ITMartin brand on bogshoppen.dk too - Bogshoppen is a part of ITMartin (user 2026-10-29: "Also the ITMartin brand"). *@
    <a class="hj-nav-logo" href="https://itmartin.dk/" aria-label="ITMartin – Bogshoppen er en del af ITMartin"><img class="k-logo-brand" src="/_content/ITMartin.Shared.UI/itmartin-logo.png" alt="ITMartin" /></a>
    @* Only two tabs (user 2026-11-03: "I only want to make users see sign up and produkter"). Forside and Om Bogshoppen
       still exist (the sign-up is on the front page) - they are just not in the menu. *@
    <a href="/#foelg">Skriv dig op</a>
    <a href="/produkter">Produkter</a>
    @* No Ros/ris on bogshoppen.dk (user 2026-10-29 "Remove from bogshoppen"): it lives on itmartin.dk/kritik only; old
       bogshoppen.dk/kritik links still go there (Program.cs). Light/dark is at the bottom of the page, not a tab
       (user 2026-11-03: "the theme should be elsewhere not as tab"). *@
</nav>
}
@if (_fest && !_bs)
{
    <a class="fest-strip" href="/vibeke">
        <span class="fest-strip-flags" aria-hidden="true">@foreach (var i in Enumerable.Range(0, 14)) { <i style="--i:@i"></i> }</span>
        <b>Vibeke har fødselsdag i dag!</b> <span>Se hvorfor hun er den bedste →</span>
    </a>
}
<div class="k-main"><div class="k-content">
    @* No emojis anywhere on the sites (user 2026-10-12) - shared components read this. *@
    <CascadingValue Name="Plain" Value="true">@Body</CascadingValue>
    @if (_bs)
    {
        <p class="bs-theme"><button id="themeToggleBtn" class="k-btn k-btn-sm" type="button" data-long="1" title="Skift lys/mørk visning">Lys/mørk visning</button></p>
    }
</div></div>
<KolibriFooter />
</div>

@code {
    private List<SiteMenu.Item> _menu = [];
    [CascadingParameter(Name = "ShopVisible")] private bool ShopVisible { get; set; }
    [CascadingParameter(Name = "ShopCustomer")] private string ShopCustomer { get; set; } = "";
    private bool _fest, _bs;   // _bs = visitor came via bogshoppen.dk: no ITMartin menu

    protected override async Task OnInitializedAsync()
    {
        _menu = await Site.MenuAsync();
        _bs = BogshoppenHome.IsHost(new Uri(Nav.Uri).Host);
        _fest = Fest.IsOn(Config) && !Nav.ToBaseRelativePath(Nav.Uri).StartsWith("admin", StringComparison.OrdinalIgnoreCase);
    }
}
