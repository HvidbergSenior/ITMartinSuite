<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kunder client - what every app's Infrastructure uses to talk to Kunder: HTTP + a small outbox on the app's own disk,
       so a sign-up is never lost when Kunder is down (2026-10-21: Stem was stopped and every sign-up on itmartin.dk failed). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITMartinKunder.Contracts\ITMartinKunder.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ITMartinKunder.Tests" />
  </ItemGroup>

</Project>
