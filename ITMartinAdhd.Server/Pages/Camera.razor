@page "/camera"
@using ITMartinAdhd.Application.Interfaces
@using ITMartinAdhd.Application.Models
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject IAdhdClaudeService ClaudeService
@inject IStoredItemService StoredItemService
@inject NavigationManager Navigation

@implements IAsyncDisposable

<PageTitle>Camera — FindIt</PageTitle>

<div class="camera-page">

    @if (_state == CameraState.Viewfinder)
    {
        <div class="camera-viewfinder" @onclick="Capture">

            @if (!_cameraStarted)
            {
                <div class="camera-start-panel">
                    <div class="camera-start-icon">📷</div>
                    <div class="camera-start-text">Starter kamera...</div>
                </div>
            }
            else
            {
                <video id="video"
                       autoplay
                       muted
                       playsinline
                       webkit-playsinline
                       class="camera-video">
                </video>

                <div class="camera-guide-overlay">
                    <div class="camera-guide-top">
                        Vis <strong>genstanden</strong> og <strong>hvor den er</strong>
                    </div>
                    <div class="camera-guide-frame"></div>
                    <div class="camera-guide-bottom">
                        @if (_isProcessing)
                        {
                            <span>Optager...</span>
                        }
                        else
                        {
                            <span>Tryk hvor som helst for at optage</span>
                        }
                    </div>
                </div>
            }

        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="camera-error">
                @_errorMessage
                <button class="btn-secondary" style="margin-top:12px" @onclick="StartCamera" @onclick:stopPropagation>
                    Prøv igen
                </button>
            </div>
        }
    }

    @if (_state == CameraState.Analyzing)
    {
        <div class="camera-analyzing">
            @if (!string.IsNullOrWhiteSpace(_previewImage))
            {
                <img class="camera-preview" src="@_previewImage" alt="Captured" />
            }
            <div class="analyzing-overlay">
                <div class="analyzing-spinner"></div>
                <div class="analyzing-text">Identificerer genstand...</div>
            </div>
        </div>
    }

    @if (_state == CameraState.Result)
    {
        <div class="camera-result">

            @if (!string.IsNullOrWhiteSpace(_previewImage))
            {
                <img class="camera-preview-thumb" src="@_previewImage" alt="Captured" />
            }

            @if (_parsed is { Success: true })
            {
                <div class="result-card">
                    <div class="result-label">Genstand</div>
                    <input class="log-input" type="text" @bind="_editName" />

                    <div class="result-label" style="margin-top:12px">Placering</div>
                    <input class="log-input" type="text" @bind="_editLocation" />

                    <div class="result-actions">
                        <button class="btn-secondary" @onclick="Retake">Tag igen</button>
                        <button class="btn-primary"
                                @onclick="Save"
                                disabled="@(_isSaving || string.IsNullOrWhiteSpace(_editName) || string.IsNullOrWhiteSpace(_editLocation))">
                            @(_isSaving ? "Gemmer..." : "Gem")
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="result-card result-failed">
                    <div class="result-failed-text">Kunne ikke identificere genstand eller placering</div>
                    <div class="result-failed-sub">Prøv igen – træd tilbage så genstanden og dens omgivelser er synlige</div>
                    <div class="result-actions">
                        <button class="btn-secondary" @onclick="Retake">Tag igen</button>
                        <button class="btn-secondary" @onclick="GoHome">Manuel</button>
                    </div>
                </div>
            }

        </div>
    }

</div>

@code {
    private enum CameraState { Viewfinder, Analyzing, Result }

    private CameraState _state = CameraState.Viewfinder;
    private bool _cameraStarted;
    private bool _isProcessing;
    private bool _isSaving;
    private string? _previewImage;
    private byte[]? _capturedBytes;
    private string? _errorMessage;
    private ParsedItemModel? _parsed;
    private string _editName = "";
    private string _editLocation = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await StartCamera();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("finditCamera.stop"); } catch { }
    }

    private async Task StartCamera()
    {
        _errorMessage = null;
        _cameraStarted = false;
        StateHasChanged();
        await Task.Delay(50);

        _cameraStarted = true;
        StateHasChanged();
        await Task.Delay(50);

        try
        {
            await JS.InvokeVoidAsync("finditCamera.start");
        }
        catch
        {
            _cameraStarted = false;
            _errorMessage = "Kameraadgang nægtet – tillad kameratilladelser og tryk Prøv igen.";
        }

        StateHasChanged();
    }

    private async Task Capture()
    {
        if (_isProcessing || !_cameraStarted || _state != CameraState.Viewfinder) return;

        _isProcessing = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var capture = await JS.InvokeAsync<CameraCaptureResult>("finditCamera.capture");

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            _capturedBytes = Convert.FromBase64String(clean);

            _previewImage = capture.Image;
            _state = CameraState.Analyzing;
            StateHasChanged();

            await JS.InvokeVoidAsync("finditCamera.stop");

            _parsed = await ClaudeService.AnalyzeItemPhotoAsync(_capturedBytes, "image/jpeg");

            _editName = _parsed.ItemName;
            _editLocation = _parsed.Location;
            _state = CameraState.Result;
        }
        catch
        {
            _errorMessage = "Optagelse mislykkedes – tryk Prøv igen.";
            _state = CameraState.Viewfinder;
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_editName) || string.IsNullOrWhiteSpace(_editLocation)) return;

        _isSaving = true;
        StateHasChanged();

        await StoredItemService.SaveAsync(_editName.Trim(), _editLocation.Trim(), photo: _capturedBytes);
        Navigation.NavigateTo("/");
    }

    private async Task Retake()
    {
        _state = CameraState.Viewfinder;
        _previewImage = null;
        _capturedBytes = null;
        _parsed = null;
        StateHasChanged();
        await StartCamera();
    }

    private void GoHome() => Navigation.NavigateTo("/");

    private sealed class CameraCaptureResult
    {
        public string Image { get; set; } = "";
    }
}
