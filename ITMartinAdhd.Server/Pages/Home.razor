@page "/"
@using ITMartinAdhd.Application.Interfaces
@using ITMartinAdhd.Application.Models

@inject IStoredItemService StoredItemService
@inject IAdhdClaudeService ClaudeService

<PageTitle>FindIt</PageTitle>

<div class="findit-page">

    <ProblemPurposeBanner
        Problem="Man glemmer hvor man har lagt sine ting"
        Formaal="Husk hvor tingene er, uden at lede" />

    <HowToUseBanner Steps='@(new[]
    {
        "Tag et billede af, hvor du lægger en ting fra dig.",
        "Skriv et par søgeord på billedet, så du kan finde det igen.",
        "Søg på ordet senere, og få billedet frem med det samme.",
    })' />

    <div class="search-section">
        <input class="search-input"
               type="search"
               placeholder="Hvor er min/mit...?"
               value="@_searchQuery"
               @oninput="OnSearchChanged"
               autocomplete="off"
               autofocus />
    </div>

    @if (_isSearching)
    {
        <div class="results-section">
            @if (_searchResults.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">?</div>
                    <div class="empty-text">Intet fundet for "@_searchQuery"</div>
                    <div class="empty-sub">Registrer det herunder, hvis du lige har lagt det et sted</div>
                </div>
            }
            else
            {
                @foreach (var item in _searchResults)
                {
                    <div class="item-card" @key="item.Id">
                        @if (item.PhotoPath != null)
                        {
                            <img class="item-thumb" src="/photos/@item.Id" alt="@item.Name" />
                        }
                        <div class="item-main">
                            <div class="item-name">@item.Name</div>
                            <div class="item-location">@item.Location</div>
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <div class="item-notes">@item.Notes</div>
                            }
                        </div>
                        <div class="item-meta">
                            <span class="item-time">@item.TimeAgo</span>
                            @if (_deleteConfirmId == item.Id)
                            {
                                <button class="btn-icon btn-delete-confirm" title="Confirm delete" @onclick="() => ConfirmDelete(item.Id)">✓</button>
                                <button class="btn-icon btn-delete-cancel"  title="Cancel"         @onclick="CancelDelete">✕</button>
                            }
                            else
                            {
                                <button class="btn-icon btn-delete" title="Delete" @onclick="() => AskDelete(item.Id)">×</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="camera-shortcut">
            <a href="/camera" class="btn-camera-shortcut">
                <span class="camera-shortcut-icon">📷</span>
                <span>Tag et foto for at registrere genstand</span>
            </a>
        </div>

        <div class="log-section">
            <div class="log-card">
                <div class="log-title">Registrer manuelt</div>

                @if (_showAiInput)
                {
                    <div class="ai-mode">
                        <textarea class="ai-textarea"
                                  placeholder='Beskriv det: "mine nøgler ligger på køkkenbordet"'
                                  @bind="_aiInput"
                                  rows="2"></textarea>
                        <div class="log-actions">
                            <button class="btn-secondary" @onclick="() => _showAiInput = false">
                                Manuel
                            </button>
                            <button class="btn-primary"
                                    @onclick="ParseAndLog"
                                    disabled="@(_isSaving || string.IsNullOrWhiteSpace(_aiInput))">
                                @(_isSaving ? "Gemmer..." : "Gem")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="manual-mode">
                        <input class="log-input"
                               type="text"
                               placeholder="Hvad? (nøgler, briller, pas...)"
                               @bind="_itemName"
                               @onkeydown="OnLogKeyDown" />
                        <input class="log-input"
                               type="text"
                               placeholder="Hvor? (køkkenbord, bil, skrivebord...)"
                               @bind="_itemLocation"
                               @onkeydown="OnLogKeyDown" />
                        <input class="log-input log-input-notes"
                               type="text"
                               placeholder="Noter (valgfrit)"
                               @bind="_itemNotes" />
                        <div class="log-actions">
                            <button class="btn-secondary" @onclick="() => _showAiInput = true">
                                AI-input
                            </button>
                            <button class="btn-primary"
                                    @onclick="SaveManual"
                                    disabled="@(_isSaving || string.IsNullOrWhiteSpace(_itemName) || string.IsNullOrWhiteSpace(_itemLocation))">
                                @(_isSaving ? "Gemmer..." : "Gem")
                            </button>
                        </div>
                    </div>
                }

                @if (_savedFlash)
                {
                    <div class="save-flash">Gemt!</div>
                }

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="error-flash">@_errorMessage</div>
                }
            </div>
        </div>

        <div class="recent-section">
            <div class="recent-title">Seneste</div>

            @if (_recentItems.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-text">Intet registreret endnu</div>
                    <div class="empty-sub">Registrer din første genstand herover</div>
                </div>
            }
            else
            {
                @foreach (var item in _recentItems)
                {
                    <div class="item-card" @key="item.Id">
                        @if (item.PhotoPath != null)
                        {
                            <img class="item-thumb" src="/photos/@item.Id" alt="@item.Name" />
                        }
                        <div class="item-main">
                            <div class="item-name">@item.Name</div>
                            <div class="item-location">@item.Location</div>
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <div class="item-notes">@item.Notes</div>
                            }
                        </div>
                        <div class="item-meta">
                            <span class="item-time">@item.TimeAgo</span>
                            @if (_deleteConfirmId == item.Id)
                            {
                                <button class="btn-icon btn-delete-confirm" title="Confirm delete" @onclick="() => ConfirmDelete(item.Id)">✓</button>
                                <button class="btn-icon btn-delete-cancel"  title="Cancel"         @onclick="CancelDelete">✕</button>
                            }
                            else
                            {
                                <button class="btn-icon btn-delete" title="Delete" @onclick="() => AskDelete(item.Id)">×</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }

</div>

@code {
    private string _searchQuery = "";
    private bool _isSearching => !string.IsNullOrWhiteSpace(_searchQuery);

    private List<StoredItemModel> _recentItems = [];
    private List<StoredItemModel> _searchResults = [];

    private bool _showAiInput;
    private string _aiInput = "";
    private string _itemName = "";
    private string _itemLocation = "";
    private string _itemNotes = "";

    private bool _isSaving;
    private bool _savedFlash;
    private string _errorMessage = "";
    private int? _deleteConfirmId;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        _recentItems = await StoredItemService.GetRecentAsync(20);
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchResults = [];
            return;
        }

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            _searchResults = await StoredItemService.SearchAsync(_searchQuery);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    private async Task OnLogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveManual();
    }

    private async Task SaveManual()
    {
        if (string.IsNullOrWhiteSpace(_itemName) || string.IsNullOrWhiteSpace(_itemLocation)) return;

        await DoSave(_itemName.Trim(), _itemLocation.Trim(), _itemNotes.Trim().NullIfEmpty());
        _itemName = "";
        _itemLocation = "";
        _itemNotes = "";
    }

    private async Task ParseAndLog()
    {
        if (string.IsNullOrWhiteSpace(_aiInput)) return;

        _isSaving = true;
        _errorMessage = "";
        StateHasChanged();

        var parsed = await ClaudeService.ParseNaturalLanguageAsync(_aiInput);

        if (!parsed.Success || string.IsNullOrWhiteSpace(parsed.ItemName) || string.IsNullOrWhiteSpace(parsed.Location))
        {
            _errorMessage = "Kunne ikke forstå det. Prøv: \"mine nøgler er på køkkenbordet\"";
            _isSaving = false;
            return;
        }

        await DoSave(parsed.ItemName, parsed.Location, null);
        _aiInput = "";
        _showAiInput = false;
    }

    private async Task DoSave(string name, string location, string? notes)
    {
        _isSaving = true;
        _errorMessage = "";

        try
        {
            var saved = await StoredItemService.SaveAsync(name, location, notes);

            var existing = _recentItems.FirstOrDefault(x => x.Id == saved.Id);
            if (existing is not null) _recentItems.Remove(existing);
            _recentItems.Insert(0, saved);
            if (_recentItems.Count > 20) _recentItems.RemoveAt(20);

            _savedFlash = true;
            StateHasChanged();
            await Task.Delay(1500);
            _savedFlash = false;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void AskDelete(int id) => _deleteConfirmId = id;
    private void CancelDelete() => _deleteConfirmId = null;

    private async Task ConfirmDelete(int id)
    {
        _deleteConfirmId = null;
        await StoredItemService.DeleteAsync(id);
        _recentItems.RemoveAll(x => x.Id == id);
        _searchResults.RemoveAll(x => x.Id == id);
    }
}
