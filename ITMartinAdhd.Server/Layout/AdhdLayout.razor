@inherits LayoutComponentBase

<div class="adhd-shell">

    <header class="adhd-header">
        <span class="adhd-logo">FindIt</span>
        <nav class="adhd-nav">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/camera">Camera</NavLink>
            <NavLink href="/history">History</NavLink>
        </nav>
    </header>

    <main class="adhd-main">
        @Body
    </main>
    <ToastContainer />
    <footer style="text-align:center;padding:.6rem 1rem;font-size:.72rem;color:#64748b;border-top:1px solid rgba(255,255,255,.06)"><a href="https://all-apps.itmartin.dk/vilkaar" target="_blank" style="color:#64748b;text-decoration:underline">Vilkår &amp; Privatlivspolitik</a> · &copy; @DateTime.Now.Year ITMartin</footer>

</div>
