@page "/"
@inject Kundekartotek Kartotek

@* The one Kundekartotek (2026-10-21). Afmeld keeps the row as proof they said stop; Slet = GDPR erasure. Every customer
   is a fold box: name first, details when opened (user: every box show/hide). *@
<PageTitle>Kunder</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">Kundekartotek</h1>
    <p>Her er alle kunder fra alle apps: dem der selv har sat flueben for at blive skrevet op, og dem der har købt på bogshoppen.dk.
        <b>Ingen reklamer og ingen nyhedsbreve.</b> Skriv til én ad gangen eller med Bcc – aldrig flere i Til eller Cc.</p>
    <p>Sådan gør du: søg på navn eller e-mail, tryk på en kunde for at se mere. Hent listen som CSV til Bcc-linjen.
        Beder nogen om deres data, så tryk <b>Hent data</b> på kunden og send filen.
        Tryk <b>Gør til hjælper</b>, så kan kunden logge ind på Vareinfo og Lager med sit kundenummer. Afmeldte slettes af sig selv efter 30 dage, køb gemmes i 5 år.</p>
    <div class="ku-row">
        <a class="k-btn k-btn-primary" href="/kunder.csv?firma=ITMartin" download>Hent ITMartin-kunder (@Active(Companies.ITMartin))</a>
        <a class="k-btn" href="/kunder.csv?firma=Bogshoppen" download>Hent Bogshoppen-kunder (@Active(Companies.Bogshoppen))</a>
    </div>
    <input class="k-input ku-search" placeholder="Søg navn, e-mail, app eller interesse" @bind="_q" @bind:event="oninput" />
    <div class="ku-chips">
        @foreach (var f in Filters)
        {
            <button class="k-btn k-btn-sm @(_filter == f ? "k-btn-primary" : "")" @onclick="() => _filter = f">@f</button>
        }
    </div>
</section>

@if (_error is not null) { <p class="ku-warn">@_error</p> }

@if (_rows.Count == 0)
{
    <section class="k-card"><p>Ingen kunder endnu. Når nogen skriver sig op på itmartin.dk eller bogshoppen.dk, kommer de her.</p></section>
}
<p class="k-help">@Shown.Count() af @_rows.Count kunder</p>
@foreach (var c in Shown)
{
    <section class="k-card ku-cust @(c.Active ? "" : "is-off")" data-fold-closed="1">
        <h3 class="k-card-title">@(c.Name == "" ? c.Email : c.Name) @if (!c.Active) { <span class="ku-tag">AFMELDT</span> } @if (c.IsHelper) { <span class="ku-tag">HJÆLPER</span> } @if (c.IsAdmin) { <span class="ku-tag">ADMIN</span> }</h3>
        <div>@c.Email @if (c.Phone != "") { <span> · @c.Phone</span> }</div>
        @if (c.Code != "") { <div>Kundenummer: <b class="ku-code">@KundeWords.ShowCode(c.Code)</b></div> }
        @if (c.Interests != "") { <div>Interesser: @c.Interests</div> }
        <ul class="ku-list">
            @foreach (var s in c.Consents)
            {
                <li><b>Ja til @s.Company</b> @Dk(s.At) · @s.Source @if (s.WithdrawnAt is { } w) { <b> · trukket tilbage @Dk(w)</b> }</li>
            }
            @foreach (var e in c.Events.OrderByDescending(e => e.At))
            {
                <li>@e.Kind · @e.App · @Dk(e.At) @if (e.What != "") { <span>· @e.What</span> } @if (e.Kr > 0) { <span>· @e.Kr kr.</span> }</li>
            }
        </ul>
        @if (_edit == c.Id)
        {
            <div class="ku-form">
                <label>Navn <input class="k-input" @bind="_name" /></label>
                <label>E-mail <input class="k-input" @bind="_email" /></label>
                <label>Telefon <input class="k-input" @bind="_phone" /></label>
                <label>Note <input class="k-input" @bind="_note" /></label>
            </div>
            <div class="ku-row">
                <button class="k-btn k-btn-primary" @onclick="() => Save(c)">Gem</button>
                <button class="k-btn" @onclick="() => _edit = 0">Fortryd</button>
            </div>
        }
        else
        {
            @if (c.Note != "") { <div>Note: @c.Note</div> }
            <div class="ku-row">
                <button class="k-btn k-btn-sm" @onclick="() => Edit(c)">Ret</button>
                <a class="k-btn k-btn-sm" href="/kunder/@(c.Id).json" download>Hent data</a>
                <button class="k-btn k-btn-sm" @onclick="() => Helper(c, !c.IsHelper)">@(c.IsHelper ? "Fjern som hjælper" : "Gør til hjælper")</button>
                <button class="k-btn k-btn-sm" @onclick="() => Admin(c, !c.IsAdmin)">@(c.IsAdmin ? "Fjern som admin" : "Gør til admin")</button>
                @if (c.Active) { <button class="k-btn k-btn-sm" @onclick="() => Unsubscribe(c)">Afmeld</button> }
                @if (_confirm == c.Id)
                {
                    <button class="k-btn k-btn-sm k-btn-danger" @onclick="() => Delete(c)">Ja, slet helt</button>
                    <button class="k-btn k-btn-sm" @onclick="() => _confirm = 0">Fortryd</button>
                }
                else { <button class="k-btn k-btn-sm" @onclick="() => _confirm = c.Id">Slet</button> }
            </div>
        }
    </section>
}

@code {
    private List<Customer> _rows = [];
    private string _q = "", _filter = "Alle";
    private int _confirm, _edit;
    private string _name = "", _email = "", _phone = "", _note = "";
    private string? _error;

    private IEnumerable<string> Filters => new[] { "Alle", "Afmeldt" }.Concat(_rows.SelectMany(c => c.Apps).Distinct().Order());

    private IEnumerable<Customer> Shown => _rows
        .Where(c => _filter == "Alle" || (_filter == "Afmeldt" ? !c.Active : c.Apps.Contains(_filter)))
        .Where(c => string.IsNullOrWhiteSpace(_q) || new[] { c.Name, c.Email, c.Interests, string.Join(" ", c.Apps) }
            .Any(s => s.Contains(_q.Trim(), StringComparison.OrdinalIgnoreCase)));

    private int Active(string company) => _rows.Count(c => c.SaidYesTo(company));

    private static string Dk(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById("Europe/Copenhagen"))
            .ToString("d. MMM yyyy HH:mm", new System.Globalization.CultureInfo("da-DK"));

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() => _rows = await Kartotek.ListAsync();

    private void Edit(Customer c) { (_edit, _name, _email, _phone, _note, _error) = (c.Id, c.Name, c.Email, c.Phone, c.Note, null); }

    private async Task Save(Customer c)
    {
        try { await Kartotek.SaveDetailsAsync(c.Id, _name, _email, _phone, _note); _edit = 0; _error = null; await LoadAsync(); }
        catch (KunderException ex) { _error = ex.Message; }
    }

    // Hjælper (2026-10-24): the kundenummer then logs into Vareinfo and Lager - takes up to 10 minutes to stop again.
    private async Task Helper(Customer c, bool on) { await Kartotek.SetHelperAsync(c.Id, on); await LoadAsync(); }

    private async Task Admin(Customer c, bool on) { await Kartotek.SetAdminAsync(c.Id, on); await LoadAsync(); }

    private async Task Unsubscribe(Customer c) { await Kartotek.AdminUnsubscribeAsync(c.Id); await LoadAsync(); }

    private async Task Delete(Customer c) { await Kartotek.DeleteAsync(c.Id); _confirm = 0; await LoadAsync(); }
}
