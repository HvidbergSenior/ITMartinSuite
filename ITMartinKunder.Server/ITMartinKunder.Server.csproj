<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- Kunder (2026-10-21, user: "kundekartotek should be for all apps"): the one Kundekartotek. The apps send sign-ups,
         purchases and afmeld to /api/kunder/* (X-Kunder-Key); Martin keeps the list and the free apps here.
         This is the thin web layer: pages, login, the API endpoints. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ITMartinKunder.Server</RootNamespace>
        <AssemblyName>ITMartinKunder.Server</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ITMartin.Shared.UI\ITMartin.Shared.UI.csproj" />
      <ProjectReference Include="..\ITMartinKunder.Application\ITMartinKunder.Application.csproj" />
      <ProjectReference Include="..\ITMartinKunder.Infrastructure\ITMartinKunder.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Using Include="ITMartinKunder.Contracts" />
      <Using Include="ITMartinKunder.Domain" />
      <Using Include="ITMartinKunder.Application" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="ITMartinKunder.Tests" />
    </ItemGroup>

</Project>
