<!DOCTYPE html>
<html lang="da">
<head>
    <script>
        (function () {
            var theme = localStorage.getItem('player_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);

            // Lightweight guest identity, same idea as Karaoke's join flow -
            // no password/account, just a name, so it's obvious who's using
            // the shared player. Full feature access either way; this is
            // about identity, not restricting anything.
            var path = window.location.pathname;
            if (path !== '/guest' && !localStorage.getItem('player_guest_name')) {
                window.location.replace('/guest?return=' + encodeURIComponent(path + window.location.search));
            }
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#0a0d14" />
    <title>Musik</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    <link rel="stylesheet" href="ITMartinPlayer.Server.styles.css?v=@CacheBuster" />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.server.js"></script>
    <script src="js/spotify.js?v=@CacheBuster"></script>
    <script src="js/karaoke.js?v=@CacheBuster"></script>
    <script src="js/player.js?v=@CacheBuster"></script>
    <div id="components-reconnect-modal">
        <span class="reconnect-msg">Forbinder igen...</span>
        <span class="reconnect-failed-msg">Forbindelsen mistet — <button onclick="location.reload()">Genindlæs</button></span>
    </div>

    <button id="themeToggleBtn" title="Skift lys/mørk visning"
            style="position:fixed;bottom:90px;right:20px;z-index:9999;width:52px;height:52px;border-radius:50%;border:2px solid #fff;background:linear-gradient(135deg,#f472b6,#a855f7);color:#fff;font-size:22px;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center">
        🌓
    </button>
    <script>
    (function () {
        var btn = document.getElementById('themeToggleBtn');
        function sync() {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            btn.textContent = current === 'light' ? '🌙' : '☀️';
        }
        btn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('player_theme', next);
            sync();
        });
        sync();
    })();
    </script>
</body>
</html>

@code {
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
