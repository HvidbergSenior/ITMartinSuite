<Window x:Class="ITMartinNotat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notatskriver – fra stikord til journaltekst" Width="1400" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontFamily="Segoe UI" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="20,14" Margin="8,8,8,0" CornerRadius="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFE58A" Offset="0"/><GradientStop Color="#FFC98F" Offset="0.55"/><GradientStop Color="#FFAD97" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Content="⚙ Indstillinger" Click="Settings_Click" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Plain}" Content="❓ Sådan gør du" Click="Help_Click" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="📝 Notatskriver" FontSize="26" FontWeight="Bold"/>
                    <TextBlock FontSize="15" TextWrapping="Wrap" Text="Lav dine stikord om til læsbar journaltekst. Navne, CPR, datoer og adresser fjernes på din PC, før noget sendes – og sættes ind igen bagefter."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status line -->
        <Border DockPanel.Dock="Bottom" Margin="8,0,8,8" Padding="12,6" CornerRadius="10" Background="{StaticResource AccentSoft}">
            <TextBlock x:Name="Status" FontSize="14" TextWrapping="Wrap" Text="Klar. Træk en fil ind i vinduet, eller skriv/indsæt dine stikord i felt 1."/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Keywords -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Step}" Text="1. Dine stikord"/>
                        <TextBlock Style="{StaticResource Help}" Text="Træk en Word-fil, tekstfil eller et billede af dine noter ind i vinduet – eller skriv/indsæt direkte her."/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Style="{StaticResource Plain}" Content="📂 Åbn fil" Click="Open_Click"/>
                            <Button Style="{StaticResource Plain}" Content="🧪 Prøv med eksempel" Click="Example_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Navne der skal skjules (patient, pårørende, kolleger)"/>
                        <TextBlock Style="{StaticResource Help}" Text="Skriv hele navne adskilt med komma, fx: Anna Jensen, Peter Jensen"/>
                        <TextBox x:Name="Names" TextWrapping="NoWrap" TextChanged="Input_Changed"/>
                    </StackPanel>
                    <TextBox x:Name="Keywords" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="Input_Changed"/>
                </DockPanel>
            </Border>

            <!-- 2. Check what is sent -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Step}" Text="2. Tjek hvad der sendes"/>
                        <TextBlock Style="{StaticResource Help}" Text="Kun teksten herunder sendes til AI'en. Kig efter navne eller andet, der kan pege på patienten."/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock x:Name="MaybeHeader" FontWeight="SemiBold" FontSize="15" Text="Kan det her være navne? Klik for at skjule:" Visibility="Collapsed"/>
                        <WrapPanel x:Name="MaybeNames" Margin="0,4,0,8"/>
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Form på notatet"/>
                        <ComboBox x:Name="NoteStyle" FontSize="15" Margin="0,4,0,8" Padding="8,6"/>
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Ekstra ønske (valgfrit)"/>
                        <TextBox x:Name="Extra" TextWrapping="NoWrap" Margin="0,4,0,8"/>
                        <CheckBox x:Name="Checked" FontSize="15" Margin="0,0,0,10" Checked="Checked_Changed" Unchecked="Checked_Changed">
                            <TextBlock TextWrapping="Wrap" Text="Jeg har tjekket teksten ovenfor – der står ingen navne, CPR-numre eller andet, der kan pege på patienten."/>
                        </CheckBox>
                        <Button x:Name="WriteBtn" Style="{StaticResource Big}" Content="✨ Lav notat" IsEnabled="False" Click="Write_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBox x:Name="Outgoing" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#FFFDF7"/>
                </DockPanel>
            </Border>

            <!-- 3. Result -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Step}" Text="3. Færdigt notat"/>
                        <TextBlock Style="{StaticResource Help}" Text="Læs det altid igennem – du har ansvaret for journalen. [?] betyder at AI'en var i tvivl. Du kan rette direkte i teksten."/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="CopyBtn" Style="{StaticResource Big}" Content="📋 Kopiér" IsEnabled="False" Click="Copy_Click"/>
                        <Button x:Name="SaveBtn" Style="{StaticResource Plain}" Content="💾 Gem som Word" IsEnabled="False" Click="Save_Click"/>
                        <Button Style="{StaticResource Plain}" Content="🧹 Ryd alt" Click="Clear_Click"/>
                    </WrapPanel>
                    <TextBox x:Name="Result" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="17"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
