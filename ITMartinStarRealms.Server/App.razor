<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Star Realms Score</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    <link rel="stylesheet" href="ITMartinStarRealms.Server.styles.css?v=@CacheBuster" />
</head>
<body>
    <Routes />
    <script src="js/starrealms.js?v=@CacheBuster"></script>
    <script>
    (function(){
        var vid = localStorage.getItem('_mid');
        if (!vid) { vid = Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2); localStorage.setItem('_mid', vid); }
        function track(path, title, referrer) {
            fetch('https://stats.itmartin.dk/api/hit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: path, title: title, referrer: referrer, visitorId: vid, host: location.hostname }),
                keepalive: true
            }).catch(function(){});
        }
        track(location.pathname + location.search, document.title, document.referrer);
        document.addEventListener('click', function(e) {
            var a = e.target.closest('a');
            if (!a || !a.href || a.href.startsWith('javascript')) return;
            var href = a.getAttribute('href') || a.href;
            track('click:' + href, a.textContent.trim().slice(0, 80), location.pathname);
        }, true);
    })();
    </script>
</body>
</html>

@code {
    // Per-process value appended to static asset URLs so the browser/Cloudflare
    // edge cache fetches fresh files after every deploy instead of potentially
    // serving a stale cached copy for up to Cache-Control's max-age.
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
