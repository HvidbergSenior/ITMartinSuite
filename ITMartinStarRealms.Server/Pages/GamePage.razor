@page "/game/{Code}"

<div id="page-data" data-page="game" data-code="@Code" style="display:none"></div>

<div id="g-loading" class="loading">Indlæser…</div>

<div id="g-needs-name" class="home-page" style="display:none">
    <div class="home-card">
        <div class="home-logo">🚀</div>
        <h1 class="home-title">Deltag i spil</h1>
        <p class="home-sub">Kode: <strong>@Code</strong> · <span id="n-ruleset-name"></span></p>
        <div class="home-section">
            <label class="home-label">Dit navn</label>
            <input id="n-name" class="home-input" placeholder="Martin" maxlength="20" oninput="onJoinNameInput()" />
            <label class="home-label mt-2">Dit avatar</label>
            <div id="n-avatar-grid" class="avatar-grid"></div>
            <label class="home-label mt-2">Din farve</label>
            <div id="n-color-grid" class="color-grid"></div>
            <button class="btn-primary mt-2" id="n-btn-join" onclick="joinAsPlayer()" disabled>Deltag i spillet</button>
        </div>
    </div>
</div>

<div id="g-invite" class="home-page" style="display:none">
    <div class="home-card">
        <div class="home-logo">📨</div>
        <h1 class="home-title">Invitér andre</h1>
        <p class="home-sub"><span id="i-ruleset-name"></span> · <span id="i-count"></span> tilmeldt</p>

        <div class="invite-code-box">@Code</div>
        <button class="btn-secondary" onclick="copyInviteLink()">🔗 Kopiér invitationslink</button>

        <div id="i-players-list" class="invite-players-list mt-3"></div>

        <button class="btn-primary mt-3" onclick="hideInvite()">▶️ Start spillet</button>
    </div>
</div>

<div id="g-main" class="game-page" style="display:none">
    <div class="game-header">
        <span class="code-badge">@Code</span>
        <div class="tab-row">
            <button class="tab-btn" id="tab-btn-score" onclick="showTab('score')">🎯 Score</button>
            <button class="tab-btn" id="tab-btn-log" onclick="showTab('log')">📜 Log</button>
            <button class="tab-btn" id="tab-btn-ai" onclick="showTab('ai')">🤖 AI</button>
        </div>
        <button class="btn-reset" onclick="resetGame()" title="Nulstil spil">🔄</button>
    </div>

    <div id="tab-score">
        <div id="g-turn-banner" class="turn-banner"></div>
        <div id="g-hero-card"></div>

        <div class="rules-toggle-row">
            <button class="btn-link" id="g-rules-toggle" onclick="toggleRules()">📜 Se regler for dette spil</button>
        </div>
        <div id="g-rules-panel" class="rules-panel" style="display:none">
            <div class="rules-title" id="g-rules-title"></div>
            <div class="rules-desc" id="g-rules-desc"></div>
        </div>

        <div class="opp-label">Modstandere</div>
        <div id="g-opp-grid" class="opp-grid"></div>
    </div>

    <div id="tab-log" style="display:none">
        <div id="g-log-panel" class="log-panel"></div>
    </div>

    <div id="tab-ai" style="display:none">
        <div class="ai-panel">
            <div class="ai-section">
                <div class="card-label">🛰️ Skibs-tips</div>
                <input id="ai-ship-search" class="home-input" placeholder="Søg skib…" oninput="filterShips()" />
                <select id="ai-ship-select" class="home-input"></select>
                <button class="btn-primary" id="ai-hint-btn" onclick="getShipHint()">💡 Få combo-tip</button>
                <div id="ai-hint-result" class="ai-result" style="display:none"></div>
            </div>

            <div class="ai-section">
                <div class="card-label">📷 Scan trade row</div>
                <label class="btn-ghost-file">
                    🖼 Vælg billede af trade row
                    <input type="file" id="ai-traderow-file" accept="image/*" style="display:none" onchange="onTradeRowSelected()" />
                </label>
                <div id="ai-traderow-loading" class="photo-analyzing" style="display:none">
                    <div class="spinner"></div><span>Claude analyserer trade row...</span>
                </div>
                <div id="ai-traderow-result" class="ai-result" style="display:none"></div>
            </div>
        </div>
    </div>
</div>

<div id="g-winner" class="winner-overlay" style="display:none" onclick="hideWinner()">
    <div class="winner-card" id="g-winner-card">
        <div class="winner-trophy">🏆</div>
        <div class="winner-name" id="g-winner-name"></div>
    </div>
</div>

@code {
    [Parameter] public string Code { get; set; } = "";
}
