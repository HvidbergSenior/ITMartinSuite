@page "/game/{Code}"

<div id="page-data" data-page="game" data-code="@Code" style="display:none"></div>

<div id="g-loading" class="loading">Indlæser…</div>

<div id="g-needs-name" class="home-page" style="display:none">
    <div class="home-card">
        <div class="home-logo">🚀</div>
        <h1 class="home-title">Deltag i spil</h1>
        <p class="home-sub">Kode: <strong>@Code</strong> · <span id="n-ruleset-name"></span></p>
        <div class="home-section">
            <label class="home-label">Dit navn</label>
            <input id="n-name" class="home-input" placeholder="Martin" maxlength="20" oninput="onJoinNameInput()" />
            <div class="avatar-preview-row">
                <div class="avatar-preview" id="n-avatar-preview">?</div>
                <span class="avatar-preview-label">Dit ikon (dine initialer)</span>
            </div>
            <label class="home-label mt-2">Din farve</label>
            <div id="n-color-grid" class="color-grid"></div>
            <button class="btn-primary mt-2" id="n-btn-join" onclick="joinAsPlayer()" disabled>Deltag i spillet</button>
            <button class="btn-link mt-2" onclick="location.href='/'">← Annuller</button>
        </div>
    </div>
</div>

<div id="g-invite" class="home-page" style="display:none">
    <div class="home-card">
        <div class="home-logo">📨</div>
        <h1 class="home-title">Invitér andre</h1>
        <p class="home-sub"><span id="i-ruleset-name"></span> · <span id="i-count"></span> tilmeldt</p>

        <div class="invite-code-box">@Code</div>
        <button class="btn-secondary" onclick="copyInviteLink()">🔗 Kopiér invitationslink</button>

        <div id="i-players-list" class="invite-players-list mt-3"></div>

        <div id="i-teams-section" style="display:none">
            <div class="home-section-inner-label">Hold</div>
            <p class="home-sub">Tryk på en spiller for at flytte dem mellem holdene.</p>
            <div id="i-teams-list" class="mt-2"></div>
        </div>

        <button class="btn-primary mt-3" id="g-invite-start-btn" onclick="hideInvite()">▶️ Start spillet</button>
        <button class="btn-link mt-2" onclick="location.href='/'">← Annuller</button>
    </div>
</div>

<div id="g-turn-toast" class="turn-toast"></div>

<div id="g-main" class="game-page" style="display:none">
    <div class="game-header">
        <button class="btn-reset" onclick="location.href='/'" title="Til forsiden">🏠</button>
        <span class="code-badge">@Code</span>
        <button class="btn-reset" onclick="resetGame()" title="Nulstil spil">🔄</button>
    </div>

    <div id="g-hero-card"></div>

    <div class="rules-toggle-row">
        <button class="btn-link" id="g-rules-toggle" onclick="toggleRules()">📜 Se regler for dette spil</button>
    </div>
    <div id="g-rules-panel" class="rules-panel" style="display:none">
        <div class="rules-title" id="g-rules-title"></div>
        <div class="rules-desc" id="g-rules-desc"></div>

        <div class="rules-qa">
            <label class="home-label mt-2">🤖 Spørg om reglerne</label>
            <textarea id="g-rules-question" class="home-input" rows="2" placeholder="F.eks. 'Må man angribe en base direkte?'" maxlength="300"></textarea>
            <button type="button" class="btn-secondary mt-1" id="g-rules-ask-btn" onclick="askRulesQuestion()">🤖 Spørg</button>
            <div id="g-rules-answer" class="rules-answer" style="display:none"></div>
        </div>
    </div>

    <div class="opp-label">Modstandere</div>
    <div id="g-opp-grid" class="opp-grid"></div>
</div>

<div id="g-winner" class="winner-overlay" style="display:none" onclick="hideWinner()">
    <div class="winner-card" id="g-winner-card" onclick="event.stopPropagation()">
        <div class="winner-trophy">🏆</div>
        <div class="winner-name" id="g-winner-name"></div>
        <img id="g-winner-preview" class="winner-preview" style="display:none" alt="Resultat" />
        <a id="g-winner-download" class="btn-primary mt-2" download="star-realms-resultat.png">⬇ Download billede</a>

        <div class="winner-photo-row mt-2">
            <button type="button" class="btn-ghost" onclick="document.getElementById('g-photo-winner').click()">📸 Billede af vinderne</button>
            <button type="button" class="btn-ghost" onclick="document.getElementById('g-photo-loser').click()">📸 Billede af taberne</button>
        </div>
        <input id="g-photo-winner" type="file" accept="image/*" capture="environment" style="display:none" />
        <input id="g-photo-loser" type="file" accept="image/*" capture="environment" style="display:none" />
        <div id="g-photo-previews"></div>

        <button class="btn-secondary mt-2" onclick="location.href='/'">🚀 Nyt spil</button>
        <button class="btn-ghost mt-2" onclick="hideWinner()">Luk</button>
    </div>
</div>

@code {
    [Parameter] public string Code { get; set; } = "";
}
