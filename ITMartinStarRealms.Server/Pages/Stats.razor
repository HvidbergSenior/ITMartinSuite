@page "/stats"

<div id="page-data" data-page="stats" style="display:none"></div>

<div class="home-page">
    <div class="home-card" style="max-width:520px">
        <div class="home-logo">📊</div>
        <h1 class="home-title">Mine statistikker</h1>

        <div id="s-loading" class="home-sub">Indlæser…</div>
        <div id="s-empty" class="home-sub" style="display:none">Du har ikke spillet nogen spil på denne enhed endnu.</div>

        <div id="s-content" style="display:none">
            <p class="home-sub" id="s-who"></p>

            <div class="home-section" style="flex-direction: row; gap:.4rem;">
                <button class="btn-ghost" id="s-filter-all" onclick="filterStats(null)">Altid</button>
                <button class="btn-ghost" id="s-filter-1" onclick="filterStats(1)">1 mdr</button>
                <button class="btn-ghost" id="s-filter-6" onclick="filterStats(6)">6 mdr</button>
                <button class="btn-ghost" id="s-filter-12" onclick="filterStats(12)">12 mdr</button>
            </div>

            <div id="s-rows"></div>
        </div>

        <button class="btn-ghost mt-3" onclick="location.href='/'">← Tilbage</button>
    </div>
</div>
