@page "/stats"

<div id="page-data" data-page="stats" style="display:none"></div>

<div class="home-page">
    <div class="home-card" style="max-width:520px">
        <div class="home-logo">📊</div>
        <h1 class="home-title">Mine statistikker</h1>

        <div id="s-loading" class="home-sub">Indlæser…</div>
        <div id="s-empty" class="home-sub" style="display:none">Du har ikke spillet nogen spil på denne enhed endnu.</div>

        <div id="s-content" style="display:none">
            <div id="s-hero" class="profile-hero"></div>
            <p class="home-sub" id="s-who"></p>

            <button class="btn-ghost" id="s-edit-toggle" onclick="toggleEditProfile()" style="display:none">✏️ Rediger profil</button>

            <div id="s-edit-panel" style="display:none">
                <label class="home-label mt-2">Navn</label>
                <input id="s-edit-name" class="home-input" maxlength="20" />

                <label class="home-label mt-2">Ikon</label>
                <div id="s-emoji-grid" class="emoji-grid"></div>
                <button type="button" class="btn-ghost mt-1" id="s-emoji-more" onclick="requestMoreEmojiStats()">✨ Flere ikoner (AI)</button>

                <label class="home-label mt-2">Eller et AI-genereret profilbillede</label>
                <div class="ai-picture-row">
                    <input id="s-ai-prompt" class="home-input" placeholder="F.eks. 'en rumpirat med solbriller'" maxlength="120" />
                    <button type="button" class="btn-ghost" id="s-ai-generate" onclick="generateProfilePictureStats()">🪄 Generér</button>
                </div>
                <div id="s-ai-picture-preview" class="ai-picture-preview" style="display:none"></div>

                <button class="btn-primary mt-2" onclick="saveProfileEdit()">Gem</button>
            </div>

            <div class="home-section" style="flex-direction: row; gap:.4rem;">
                <button class="btn-ghost" id="s-filter-all" onclick="filterStats(null)">Altid</button>
                <button class="btn-ghost" id="s-filter-1" onclick="filterStats(1)">1 mdr</button>
                <button class="btn-ghost" id="s-filter-6" onclick="filterStats(6)">6 mdr</button>
                <button class="btn-ghost" id="s-filter-12" onclick="filterStats(12)">12 mdr</button>
            </div>

            <label class="home-label mt-2">Spiltype</label>
            <select id="s-ruleset-filter" class="home-input" onchange="filterStatsRuleset(this.value)">
                <option value="">Alle spiltyper</option>
            </select>

            <div id="s-rows" class="mt-3"></div>

            <div id="s-teams-section" class="mt-3" style="display:none">
                <div class="home-section-inner-label">Mine hold</div>
                <div id="s-teams-rows"></div>
            </div>
        </div>

        <button class="btn-ghost mt-3" onclick="location.href='/'">← Tilbage</button>
    </div>
</div>
