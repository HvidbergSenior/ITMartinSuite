@page "/"

<div id="page-data" data-page="home" style="display:none"></div>

<div class="home-page">
    <div class="home-card">
        <div class="home-logo">🚀</div>
        <h1 class="home-title">Star Realms Score</h1>
        <p class="home-sub">Live pointtæller til 1-6 spillere</p>

        <ProblemPurposeBanner
            Problem="Man mister overblikket over point midt i et Star Realms-parti, og bagefter er det umuligt at huske, hvem der egentlig vinder oftest."
            Formaal="Ét sted at holde styr på point live fra hver sin telefon, og en historik der viser, hvem der faktisk vinder over tid." />

        <HowToUseBanner Steps='@(new[]
        {
            "Vælg dit navn, avatar og farve, og opret et nyt spil eller deltag med en kode.",
            "Del koden med de andre — I følger alle med og opdaterer selv jeres egne point fra hver jeres telefon.",
            "Se jeres win/loss-historik under 'Se mine statistikker' efter et par spil, så I endelig kan se sort på hvidt, hvem der faktisk vinder oftest."
        })' />

        <div id="step-0" class="wizard-step">
            <div class="home-section">
                <label class="home-label">Dit navn</label>
                <input id="h-name" class="home-input" placeholder="Martin" maxlength="20" oninput="onNameInput()" />
                <label class="home-label mt-2">Dit avatar</label>
                <div id="h-avatar-grid" class="avatar-grid"></div>
                <label class="home-label mt-2">Din farve</label>
                <div id="h-color-grid" class="color-grid"></div>
                <button class="btn-primary mt-2" id="h-btn-ruleset" onclick="goToRuleset()" disabled>Videre →</button>
            </div>

            <div class="home-divider">eller</div>
            <div class="home-section">
                <label class="home-label">Spilkode (deltag i eksisterende spil)</label>
                <input id="h-join-code" class="home-input home-code" placeholder="ABC123" maxlength="6" oninput="onJoinCodeInput()" />
                <button class="btn-secondary" id="h-btn-join" onclick="joinSession()" disabled>Deltag</button>
            </div>

            <button class="btn-link mt-3" onclick="location.href='/stats'">📊 Se mine statistikker</button>
        </div>

        <div id="step-1" class="wizard-step" style="display:none">
            <div class="home-section">
                <label class="home-label">Vælg spiltype</label>
                <div id="h-ruleset-list"></div>

                <button class="btn-ghost mt-2" onclick="toggleCustomForm()">✏️ Opret dit eget regelsæt</button>

                <div id="h-custom-form" class="custom-ruleset-form" style="display:none">
                    <label class="home-label">Navn</label>
                    <input id="c-name" class="home-input" placeholder="F.eks. 'Fars husregler'" />
                    <label class="home-label">Beskrivelse af reglerne</label>
                    <textarea id="c-desc" class="home-input" rows="3" placeholder="Beskriv reglerne, så andre kan forstå dem"></textarea>
                    <label class="home-label">Min / Max spillere</label>
                    <div class="d-flex gap-2">
                        <input id="c-min" class="home-input" type="number" min="1" max="6" value="2" />
                        <input id="c-max" class="home-input" type="number" min="1" max="6" value="6" />
                    </div>
                    <label class="home-label">Startpoint</label>
                    <input id="c-points" class="home-input" type="number" value="50" />
                    <div class="form-check mt-1">
                        <input id="c-team" type="checkbox" onchange="onCustomTeamToggle()" />
                        <label for="c-team">Holdspil</label>
                    </div>
                    <div id="c-team-fields" style="display:none">
                        <label class="home-label">Spillere pr. hold</label>
                        <input id="c-per-team" class="home-input" type="number" min="1" max="3" value="2" />
                        <div class="form-check mt-1">
                            <input id="c-shared" type="checkbox" />
                            <label for="c-shared">Hold deler ét samlet pointtal (som Hydra)</label>
                        </div>
                    </div>
                    <button class="btn-primary mt-2" onclick="createCustomRuleset()">Gem regelsæt</button>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn-ghost" onclick="showStep(0)">← Tilbage</button>
                    <button class="btn-primary" id="h-btn-points" onclick="goToPoints()" disabled>Videre →</button>
                </div>
            </div>
        </div>

        <div id="step-2" class="wizard-step" style="display:none">
            <div class="home-section">
                <label class="home-label">Startpoint</label>
                <div class="points-row" id="h-points-row"></div>
                <button class="btn-primary" id="h-btn-create" onclick="createSession()">🚀 Start nyt spil</button>
                <button class="btn-ghost mt-2" onclick="showStep(1)">← Tilbage</button>
            </div>
        </div>

        <p id="h-error" class="home-error" style="display:none"></p>
    </div>
</div>
