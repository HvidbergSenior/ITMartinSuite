@* ITMartin's own reactions: one Kolibri in eight BIG feelings (user 2026-11-13: "ITMartin emojis like VERY ADHD feelings.
   Not just happy but very happy" + "could it be a kolibri all the emojis"). No stock emojis - they look AI-made.
   Put once on a page (hidden sprite); draw a feeling with <svg viewBox="0 0 64 64"><use href="#feel-<id>"/></svg>.
   The same bird every time: tail, body, flapping wing, head, long beak - only colour, eye and extras change. *@
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
        <g id="kolibri-body">
            <path d="M18 39 L3 50 L9 39 L3 30 Z" fill="currentColor" opacity=".85" />
            <ellipse cx="29" cy="37" rx="14" ry="10" fill="currentColor" />
            <circle cx="41" cy="27" r="9" fill="currentColor" />
            <path d="M49 26 L63 22.5 L49 29 Z" fill="#2b1d12" />
            <path class="kig-wing" d="M30 31 C22 10 10 9 6 14 C13 19 19 26 26 35 Z" fill="#fff" opacity=".55" />
        </g>
    </defs>
    @* MEGA glad - smiling eye + sparkles *@
    <symbol id="feel-glad" viewBox="0 0 64 64"><g color="#ff8a00"><use href="#kolibri-body" /></g>
        <path d="M40 27 q3.5 -5 7 0" stroke="#2b1d12" stroke-width="2.4" fill="none" stroke-linecap="round" />
        <path d="M52 6 l1.5 4 4 1.5 -4 1.5 -1.5 4 -1.5 -4 -4 -1.5 4 -1.5z M58 36 l1 2.5 2.5 1 -2.5 1 -1 2.5 -1 -2.5 -2.5 -1 2.5 -1z" fill="#ffc531" /></symbol>
    @* ELSKER det - heart eye + hearts *@
    <symbol id="feel-elsker" viewBox="0 0 64 64"><g color="#e8336d"><use href="#kolibri-body" /></g>
        <path d="M43.5 29 l-3.5 -3.5 a2 2 0 0 1 3.5 -2.5 a2 2 0 0 1 3.5 2.5 z" fill="#fff" />
        <path d="M54 14 l-4 -4 a2.4 2.4 0 0 1 4 -3 a2.4 2.4 0 0 1 4 3 z M58 8 l-2.5 -2.5 a1.5 1.5 0 0 1 2.5 -2 a1.5 1.5 0 0 1 2.5 2 z" fill="#e8336d" /></symbol>
    @* GRINER så jeg græder - squeezed eye + tears *@
    <symbol id="feel-griner" viewBox="0 0 64 64"><g color="#ffb000"><use href="#kolibri-body" /></g>
        <path d="M39 25 l4 2.5 -4 2.5 M47 25" stroke="#2b1d12" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M44 31 q-2 5 0 7 q2 -2 0 -7z M38 33 q-2 4 0 6 q2 -2 0 -6z" fill="#3aa0ff" /></symbol>
    @* VILDT irriteret - angry brow + steam *@
    <symbol id="feel-irriteret" viewBox="0 0 64 64"><g color="#d62828"><use href="#kolibri-body" /></g>
        <path d="M38 21 L47 24.5" stroke="#2b1d12" stroke-width="3" stroke-linecap="round" />
        <circle cx="43" cy="27.5" r="2.2" fill="#2b1d12" />
        <path d="M36 15 q-3 -3 0 -6 q3 -3 0 -6 M44 16 q-3 -3 0 -6 q3 -3 0 -6" stroke="#8c8c8c" stroke-width="2.2" fill="none" stroke-linecap="round" /></symbol>
    @* TOTALT forvirret - spiral eye + question marks *@
    <symbol id="feel-forvirret" viewBox="0 0 64 64"><g color="#8a5cd6"><use href="#kolibri-body" /></g>
        <path d="M43 27 a1 1 0 0 1 1.5 0 a2.4 2.4 0 0 1 -3 2.2 a3.6 3.6 0 0 1 1 -6.4 a4.6 4.6 0 0 1 5 4" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" />
        <text x="50" y="13" font-size="13" font-weight="900" fill="#8a5cd6" font-family="system-ui,sans-serif">?</text>
        <text x="57" y="8" font-size="9" font-weight="900" fill="#8a5cd6" font-family="system-ui,sans-serif">?</text></symbol>
    @* Hjernen KOGER - wide eye + lightning *@
    <symbol id="feel-koger" viewBox="0 0 64 64"><g color="#ff5a1f"><use href="#kolibri-body" /></g>
        <circle cx="43" cy="26.5" r="4" fill="#fff" /><circle cx="43.5" cy="26.5" r="1.6" fill="#2b1d12" />
        <path d="M40 1 L34 11 H39 L35 19 L45 8 H40 L44 1 Z" fill="#ffc531" stroke="#2b1d12" stroke-width=".8" /></symbol>
    @* Keder mig VILDT - heavy eyelid + zzz *@
    <symbol id="feel-keder" viewBox="0 0 64 64"><g color="#8c8c8c"><use href="#kolibri-body" /></g>
        <path d="M39 26.5 h8" stroke="#2b1d12" stroke-width="2.6" stroke-linecap="round" /><path d="M40 27.5 q3 3 6 0" fill="#2b1d12" />
        <text x="49" y="16" font-size="10" font-weight="900" fill="#6e5a48" font-family="system-ui,sans-serif">z</text>
        <text x="55" y="9" font-size="13" font-weight="900" fill="#6e5a48" font-family="system-ui,sans-serif">Z</text></symbol>
    @* HYPERFOKUS - target eye + speed lines *@
    <symbol id="feel-hyperfokus" viewBox="0 0 64 64"><g color="#2bb39a"><use href="#kolibri-body" /></g>
        <circle cx="43" cy="26.5" r="4" fill="#fff" /><circle cx="43" cy="26.5" r="2.4" fill="none" stroke="#d62828" stroke-width="1.2" /><circle cx="43" cy="26.5" r=".9" fill="#d62828" />
        <path d="M2 22 h9 M0 28 h7 M3 34 h6" stroke="#2bb39a" stroke-width="2" stroke-linecap="round" /></symbol>
</svg>
