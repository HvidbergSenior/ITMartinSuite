@inherits LayoutComponentBase
@inject ShopUseCases Shop

@* Salg = the selling side (2026-10-21 split): the orders and the day offers. The stock itself is in Lager. *@
<KolibriHeader>
    @* Like ElPriser (2026-10-31 "fix css / template"): NavLink = the open tab is filled, words only (no AI emojis). *@
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/" Match="NavLinkMatch.All">Ordrer</NavLink>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/tilbud">Tilbud</NavLink>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/interesse">Interesse</NavLink>
    <a class="k-btn k-btn-ghost k-btn-sm" href="@Shop.LagerBase">Lager</a>
