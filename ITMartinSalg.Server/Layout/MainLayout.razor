@inherits LayoutComponentBase
@inject ShopUseCases Shop

@* Salg = the selling side (2026-10-21 split): the orders and the day offers. The stock itself is in Lager. *@
<KolibriHeader>
    @* Like ElPriser (2026-10-31 "fix css / template"): NavLink = the open tab is filled, words only (no AI emojis). *@
    @* Sælg first (user 2026-10-31 "on salg I ONLY need a way to make a sale"); Tilbud and Interesse are off the menu (deals
       are made at the stand - "only regular prices"), their pages still answer. *@
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/" Match="NavLinkMatch.All">Sælg</NavLink>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/ordrer">Ordrer</NavLink>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/bud">Bud</NavLink>
    <button id="themeToggleBtn" class="k-btn k-btn-ghost k-btn-sm" type="button" title="Skift lys/mørk visning">Lys/mørk</button>
</KolibriHeader>
<KolibriSteps Steps="Flow" Current="BogshoppenFlow.Salg" Label="Bogshoppen – sådan gør du" />
<div class="k-main"><div class="k-content">
    @Body
</div></div>
<KolibriFooter />

@code {
    // Bogshoppen's five steps (2026-11-05) - names + addresses only, so the helpers stay separate.
    private static readonly IReadOnlyList<KolibriSteps.KolibriStep> Flow =
        BogshoppenFlow.Steps.Select(s => new KolibriSteps.KolibriStep(s.Name, s.Url)).ToList();
}
