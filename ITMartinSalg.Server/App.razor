<!DOCTYPE html>
<html lang="da" data-family="rede">
<head>
    <script>
        (function () {
            // Like ElPriser (the reference): what was chosen with Lys/Mørk, else what the phone is set to.
            var theme = localStorage.getItem('salg_theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Bogshoppen Salg – ordrer og dagens tilbud i butikken på bogshoppen.dk." />
    <base href="/" />
    <link rel="stylesheet" href="_content/ITMartin.Shared.UI/css/kolibri.css?v=@CacheBuster" />
    <script src="_content/ITMartin.Shared.UI/kolibri.js?v=@CacheBuster" defer></script>
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/_content/ITMartin.Shared.UI/kolibri-icon.svg" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.server.js"></script>
    <script>
    // The Lys/Mørk button is in the Kolibri header, which Blazor renders again - the click is caught on the document.
    (function () {
        function sync() {
            var current = document.documentElement.getAttribute('data-theme') || 'light';
            var btn = document.getElementById('themeToggleBtn');
            var label = current === 'light' ? 'Mørk' : 'Lys';
            if (btn && btn.textContent !== label) btn.textContent = label;
            var meta = document.querySelector('meta[name=theme-color]');
            if (meta) meta.setAttribute('content', current === 'light' ? '#f5f5f7' : '#0b1220');
        }
        document.addEventListener('click', function (e) {
            if (!e.target.closest || !e.target.closest('#themeToggleBtn')) return;
            var next = (document.documentElement.getAttribute('data-theme') || 'light') === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('salg_theme', next); } catch (_) { }
            sync();
        });
        new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
        sync();
    })();
    </script>
    <script>if("serviceWorker" in navigator){navigator.serviceWorker.register("/kolibri-sw.js").catch(function(){});}</script>
</body>
</html>

@code {
    public static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
