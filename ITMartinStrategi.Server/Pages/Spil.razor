@page "/game/{Slug}"
@page "/spil/{Slug}"
@inject IDbContextFactory<StrategiDbContext> DbFactory
@inject StrategiAi Ai
@inject SteamService Steam
@inject NavigationManager Nav

<PageTitle>@(_game?.Name ?? "Game") – Strategy</PageTitle>

@if (_game is null)
{
    <p class="muted">Game not found. <a href="/">Back</a></p>
    return;
}

<div class="game-head">
    @if (_game.SteamAppId is int headAppId)
    {
        <img class="game-art big" src="@SteamService.HeaderImage(headAppId)" alt="" />
    }
    else
    {
        <span class="game-icon big">@_game.Icon</span>
    }
    <div>
        <h1>@_game.Name</h1>
        @if (_editVersion)
        {
            <div class="form-row">
                <input class="k-input" @bind="_game.Version" placeholder="Version / expansions" />
                <button class="k-btn k-btn-sm k-btn-primary" @onclick="SaveVersionAsync">Save</button>
            </div>
        }
        else
        {
            <div class="muted small">@_game.Platform · @_game.Version <button class="linkish" @onclick="() => _editVersion = true">edit</button></div>
            @if (_mySteam is not null)
            {
                <div class="small">@_mySteam.Hours.ToString("0", En) hours total@(_mySteam.Hours2Weeks > 0 ? $" · {_mySteam.Hours2Weeks.ToString("0.#", En)} in the last 2 weeks" : "")</div>
            }
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(_game.Wiki))
{
    <form class="lib-jump" action="/game/@_game.Slug/library" method="get">
        <input class="k-input" name="q" placeholder="📚 Look up anything in the library …" />
        <a class="k-btn k-btn-ghost" href="/game/@_game.Slug/library">Library</a>
        <a class="k-btn k-btn-ghost" href="/game/@_game.Slug/micro">🔧 Micromanagement</a>
    </form>
}

<nav class="tabs" aria-label="Sections">
    @foreach (var s in Sections.All)
    {
        var n = _guides.Count(g => g.Section == s);
        <button class="tab @(s == _section ? "on" : "")" @onclick="() => Pick(s)">@Sections.Label(s)@(n > 0 ? $" ({n})" : "")</button>
    }
</nav>

<p class="muted small">@Sections.Hint(_section)</p>

@if (_busy is not null)
{
    <div class="k-alert k-alert-info">The AI is writing about “@_busy” – it takes up to a minute …</div>
}
@if (_error is not null)
{
    <div class="k-alert k-alert-danger">@_error</div>
}

@{
    var inSection = _guides.Where(g => g.Section == _section).OrderByDescending(g => g.Checked).ThenBy(g => g.Title).ToList();
}
@if (inSection.Count == 0)
{
    <p class="muted">No guides here yet.</p>
}
<div class="guides">
    @foreach (var g in inSection)
    {
        <a class="guide-card" href="/guide/@g.Id">
            <div class="guide-top">
                <b>@g.Title</b>
                @if (g.Trigger.Length > 0) { <span class="k-tag">Choice: @g.Trigger</span> }
                <span class="k-tag @(g.Source == "Martin" ? "tag-mine" : "")">@g.Source</span>
                @if (g.Checked) { <span class="k-tag tag-ok">✓ Checked</span> } else { <span class="k-tag tag-draft">Draft</span> }
                @if (_latestDevNews is { } ln && ln.Date > g.UpdatedAt && g.Section != Sections.Mine)
                {
                    <span class="k-tag tag-warn" title="@ln.Title">⚠ Written before “@Short(ln.Title)”</span>
                }
            </div>
            <div class="guide-preview"><GuideText Text="@Preview(g.Body)" /></div>
        </a>
    }
</div>

@if (!Ai.Enabled && _section != Sections.Mine)
{
    var missing = _game.TopicList().Where(t => t.Section == _section && !Covered(t.Topic)).Select(t => t.Topic).ToList();
    @if (missing.Count > 0)
    {
        <div class="k-card">
            <div class="k-card-title">Topics without a guide yet</div>
            <div class="chips">
                @foreach (var t in missing)
                {
                    <a class="chip" href="/game/@_game.Slug/new/@_section?topic=@Uri.EscapeDataString(t)">+ @t</a>
                }
            </div>
            <div class="muted small">Write it yourself – or ask Claude in Claude Code to write guides for @_game.Name. It costs nothing in the app.</div>
        </div>
    }
}
@if (Ai.Enabled && _section != Sections.Mine)
{
    var open = _game.TopicList().Where(t => t.Section == _section && !Covered(t.Topic)).Select(t => t.Topic).ToList();
    <div class="k-card">
        <div class="k-card-title">Make an AI draft</div>
        @if (open.Count > 0)
        {
            <div class="chips">
                @foreach (var t in open)
                {
                    <button class="chip" disabled="@(_busy is not null)" @onclick="() => DraftAsync(t)">+ @t</button>
                }
            </div>
        }
        <div class="form-row">
            <input class="k-input" @bind="_topic" @bind:event="oninput" placeholder="@TopicPlaceholder" />
            <button class="k-btn k-btn-primary" disabled="@(_busy is not null || string.IsNullOrWhiteSpace(_topic))" @onclick="() => DraftAsync(_topic)">Make draft</button>
        </div>
        <div class="muted small">The AI searches the web for the current version and builds on your own strategies. A draft takes up to a minute and costs about 2–3 DKK.</div>
    </div>
}
<div class="btn-row">
    <a class="k-btn k-btn-ghost" href="/game/@_game.Slug/new/@_section">✎ Write it yourself</a>
</div>

@if (_news.Count > 0)
{
    <div class="k-card">
        <div class="k-card-title">What's new in the game</div>
        <ul class="news">
            @foreach (var n in _news.Take(5))
            {
                <li>
                    <span class="muted small">@n.Date.ToLocalTime().ToString("d MMM yyyy", En)@(n.FromDevelopers ? " · the developers" : "")</span><br />
                    <a href="@n.Url" target="_blank" rel="noopener">@n.Title</a>
                </li>
            }
        </ul>
    </div>
}

@if (_achievements.Count > 0)
{
    var got = _achievements.Count(a => a.Achieved);
    var next = _achievements.Where(a => !a.Achieved).OrderByDescending(a => a.GlobalPercent).Take(8).ToList();
    <div class="k-card">
        <div class="k-card-title">Next challenges</div>
        <div class="muted small">You have @got of @_achievements.Count achievements. These are the ones you're missing that most other players have.</div>
        <ul class="achievements">
            @foreach (var a in next)
            {
                <li>
                    <b>@a.Name</b> <span class="muted small">· @a.GlobalPercent.ToString("0.#", En) % have it</span>
                    @if (a.Description.Length > 0) { <br /><span class="small">@a.Description</span> }
                </li>
            }
        </ul>
    </div>
}

@if (_game.LinkList().Any())
{
    <div class="k-card">
        <div class="k-card-title">Read more – free sources</div>
        <ul class="links">
            @foreach (var (label, url) in _game.LinkList())
            {
                <li><a href="@url" target="_blank" rel="noopener">@label</a></li>
            }
        </ul>
    </div>
}

@if (Ai.Enabled)
{
<div class="k-card ask">
    <div class="k-card-title">Ask</div>
    <textarea class="k-textarea" rows="2" @bind="_question" @bind:event="oninput" placeholder="@AskPlaceholder"></textarea>
    <div class="btn-row">
        <button class="k-btn k-btn-primary" disabled="@(_asking || string.IsNullOrWhiteSpace(_question))" @onclick="AskAsync">@(_asking ? "Thinking …" : "Ask")</button>
    </div>
    @if (_answer is not null)
    {
        <div class="answer"><GuideText Text="@_answer" /></div>
        <div class="btn-row">
            <select class="k-input" style="max-width:14rem" @bind="_saveSection">
                @foreach (var s in Sections.All) { <option value="@s">@Sections.Label(s)</option> }
            </select>
            <button class="k-btn k-btn-sm" @onclick="SaveAnswerAsync">Save as guide</button>
        </div>
    }
    <div class="muted small">Answers from your guides and the AI's knowledge of the game. An answer costs under 0.50 DKK.</div>
</div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "section")] public string? Afsnit { get; set; }

    private Game? _game;
    private List<Guide> _guides = [];
    private string _section = Sections.Mekanik;
    private string _topic = "";
    private string? _busy;
    private string? _error;
    private bool _editVersion;
    private string _question = "";
    private bool _asking;
    private string? _answer;
    private string _saveSection = Sections.Mekanik;
    private static readonly System.Globalization.CultureInfo En = new("en-GB");
    private SteamGame? _mySteam;
    private IReadOnlyList<SteamNews> _news = [];
    private SteamNews? _latestDevNews;
    private IReadOnlyList<SteamAchievement> _achievements = [];

    private static string Short(string s) => s.Length <= 40 ? s : s[..40] + "…";

    private string TopicPlaceholder => _section switch
    {
        Sections.Valg => "What did you choose? e.g. Oligarchy",
        Sections.Start => "e.g. The first 20 turns",
        _ => "Which mechanic? e.g. Influence",
    };

    private string AskPlaceholder => _game?.Slug switch
    {
        "galciv4" => "e.g. I chose oligarchy – what should I research now?",
        "wingspan" => "e.g. When should I switch from gathering food to laying eggs?",
        _ => "Ask about something specific in the game",
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Afsnit is { } a && Sections.All.Contains(a)) _section = a;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _game = await db.Games.FirstOrDefaultAsync(g => g.Slug == Slug);
        _guides = _game is null ? [] : await db.Guides.Where(g => g.GameId == _game.Id).ToListAsync();
        if (_game?.SteamAppId is int appId)
        {
            var owned = Steam.OwnedGamesAsync();
            var news = Steam.NewsAsync(appId);
            var ach = Steam.AchievementsAsync(appId);
            _mySteam = (await owned).FirstOrDefault(s => s.AppId == appId);
            _news = await news;
            _latestDevNews = _news.FirstOrDefault(n => n.FromDevelopers);
            _achievements = await ach;
        }
    }

    private void Pick(string s) { _section = s; _error = null; }

    private bool Covered(string topic) =>
        _guides.Any(g => g.Section == _section &&
            (string.Equals(g.Trigger, topic, StringComparison.OrdinalIgnoreCase) ||
             g.Title.Contains(topic, StringComparison.OrdinalIgnoreCase)));

    private static string Preview(string body)
    {
        var lines = body.Replace("\r", "").Split('\n').Where(l => l.Trim().Length > 0).Take(4);
        return string.Join('\n', lines);
    }

    private async Task DraftAsync(string topic)
    {
        if (_game is null || string.IsNullOrWhiteSpace(topic)) return;
        _busy = topic.Trim();
        _error = null;
        StateHasChanged();
        try
        {
            var d = await Ai.DraftAsync(_game, _section, _busy, _guides);
            await using var db = await DbFactory.CreateDbContextAsync();
            var guide = new Guide
            {
                GameId = _game.Id, Section = _section, Title = d.Title, Trigger = d.Trigger, Body = d.Body,
                Source = "AI", SourceUrls = string.Join('\n', d.Sources),
            };
            db.Guides.Add(guide);
            await db.SaveChangesAsync();
            Nav.NavigateTo($"/guide/{guide.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = null; _topic = ""; }
    }

    private async Task AskAsync()
    {
        if (_game is null) return;
        _asking = true;
        _answer = null;
        _error = null;
        try { _answer = await Ai.AskAsync(_game, _question.Trim(), _guides); _saveSection = _section; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _asking = false; }
    }

    private async Task SaveAnswerAsync()
    {
        if (_game is null || _answer is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = _question.Trim();
        var guide = new Guide
        {
            GameId = _game.Id, Section = _saveSection, Title = q.Length > 80 ? q[..80] + "…" : q,
            Body = _answer, Source = "AI",
        };
        db.Guides.Add(guide);
        await db.SaveChangesAsync();
        Nav.NavigateTo($"/guide/{guide.Id}");
    }

    private async Task SaveVersionAsync()
    {
        if (_game is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var g = await db.Games.FirstAsync(x => x.Id == _game.Id);
        g.Version = _game.Version.Trim();
        await db.SaveChangesAsync();
        _editVersion = false;
    }
}
