@page "/g/{slug}/users"
@rendermode InteractiveServer
@inject TeamMembers People
@inject TaskBoard Tasks
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ClubAuthService ClubAuth

@if (!_loaded) { <div class="club-loading">Indlæser...</div> }
else if (_member == null) { <div class="club-loading">Omdirigerer...</div> }
else
{
    <div class="club-page">
        <ClubNav Slug="@Slug" GroupName="@_group!.Name" MemberLabel="@_member.Name" Active="users" />

        <div class="task-body">
            <h2 class="task-title" style="margin-bottom:16px">Medlemmer (@_members.Count)</h2>

            @if (IsAdmin)
            {
                <section class="invite-box">
                    <h3 class="invite-title">Inviter en ny person</h3>
                    <p class="invite-help">Skriv navn, mail og rolle. Personen får en mail med et link og kommer ind uden adgangskode.</p>
                    <div class="invite-grid">
                        <label for="inv-name">Navn<input id="inv-name" class="invite-input" @bind="_newName" maxlength="60" placeholder="Fornavn Efternavn" /></label>
                        <label for="inv-mail">Mail<input id="inv-mail" class="invite-input" @bind="_newEmail" type="email" maxlength="120" placeholder="navn@mail.dk" /></label>
                        <label for="inv-role">Rolle<input id="inv-role" class="invite-input" @bind="_newRole" list="roller" maxlength="40" placeholder="Medlem" /></label>
                    </div>
                    <datalist id="roller">@foreach (var r in ForeningRoller.Forslag) { <option value="@r"></option> }</datalist>
                    <button class="msg-btn invite-send" @onclick="AddAndInvite" disabled="@_adding">@(_adding ? "Sender..." : "Tilføj og send invitation")</button>
                    @if (!People.MailConfigured) { <p class="invite-help">Mail er ikke sat op endnu - personen bliver tilføjet, men får ingen mail.</p> }
                    @if (_addResult is not null) { <p class="invite-result">@_addResult</p> }
                </section>
            }

            @foreach (var m in _members)
            {
                <div class="task-row-item">
                    <div class="task-info">
                        <div class="task-item-title">
                            @m.Name
                            @if (!string.IsNullOrWhiteSpace(m.Role))
                            {
                                <span class="role-badge">@m.Role</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(m.ContactInfo))
                        {
                            <div class="task-item-desc">@m.ContactInfo</div>
                        }
                        @if (IsAdmin && m.Id != _member.Id)
                        {
                            <div class="task-meta">
                                <label for="role-@m.Id">Rolle</label>
                                <input id="role-@m.Id" class="invite-input role-input" value="@m.Role" list="roller" maxlength="40"
                                       @onchange="e => SetRole(m, e.Value?.ToString() ?? string.Empty)" />
                            </div>
                        }
                        @if (IsAdmin && People.MailConfigured && m.Id != _member.Id)
                        {
                            <div class="task-meta">
                                @if (EmailAddress.LooksLike(m.Email))
                                {
                                    <button class="msg-btn" @onclick="() => Invite(m)" disabled="@(_inviting == m.Id)">@(m.LoginToken is null ? "Inviter" : "Send invitation igen")</button>
                                }
                                else { <span>Ingen mail – kan ikke inviteres</span> }
                                @if (_invited.TryGetValue(m.Id, out var res)) { <span>@res</span> }
                            </div>
                        }
                        <div class="task-meta">
                            <span>Tilmeldt @m.JoinedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                            @if (_openCountByName.TryGetValue(m.Name, out var count) && count > 0)
                            {
                                <span>@count åbne opgave@(count == 1 ? "" : "r")</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .task-body { padding: 16px; }
    .task-title { font-size: 18px; font-weight: 800; margin: 0; color: var(--text); }
    .task-row-item { display: flex; align-items: flex-start; gap: 12px; padding: 12px 10px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 8px; background: var(--card); }
    .task-info { flex: 1; }
    .task-item-title { font-size: 15px; font-weight: 600; margin-bottom: 4px; color: var(--text); }
    .task-item-desc { font-size: 13px; color: var(--muted); margin-bottom: 4px; }
    .role-badge { display: inline-block; margin-left: 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--accent); background: color-mix(in srgb, var(--k-accent) 12%, transparent); border-radius: 999px; padding: 2px 9px; vertical-align: middle; }
    .invite-box { border: 1px solid var(--border); background: var(--card); border-radius: 12px; padding: 14px; margin-bottom: 16px; display: grid; gap: 10px; }
    .invite-title { margin: 0; font-size: 16px; color: var(--text); }
    .invite-help, .invite-result { margin: 0; font-size: 13px; color: var(--muted); }
    .invite-result { color: var(--text); font-weight: 600; }
    .invite-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
    .invite-grid label { display: grid; gap: 4px; font-size: 14px; font-weight: 700; color: var(--k-text); }
    .invite-input { background: var(--k-card); border: 1px solid var(--k-muted-2); border-radius: 10px; padding: 11px 12px; color: var(--k-text); font-size: 16px; min-width: 0; }
    .role-input { padding: 4px 8px; font-size: 13px; max-width: 180px; }
    .invite-send { justify-self: start; }
    .task-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--muted); }
</style>

@code {
    [Parameter] public string Slug { get; set; } = "";
    private Member? _member;
    private Group? _group;
    private bool _loaded;
    private List<Member> _members = [];
    private Dictionary<string, int> _openCountByName = [];
    private Guid? _inviting;
    private readonly Dictionary<Guid, string> _invited = [];

    // Admin = role containing "Admin" (set in the database / Admin page). Only they see "Inviter".
    private bool IsAdmin => _member?.IsAdmin == true;

    private string _newName = "", _newEmail = "", _newRole = "Medlem";
    private string? _addResult;
    private bool _adding;

    private async Task AddAndInvite()
    {
        _adding = true; _addResult = null; StateHasChanged();
        var (error, mailed) = await People.AddAndInviteAsync(_group!, _newName, _newEmail, _newRole, _member!, Nav.BaseUri);
        if (error is not null) _addResult = error;
        else
        {
            _addResult = mailed ? $"{_newName.Trim()} er tilføjet, og invitationen er sendt." : $"{_newName.Trim()} er tilføjet, men mailen kunne ikke sendes.";
            _newName = ""; _newEmail = ""; _newRole = "Medlem";
            _members = await People.ListAsync(_group!.Id);
        }
        _adding = false;
    }

    private async Task SetRole(Member m, string role)
    {
        await People.SetRoleAsync(_group!.Id, m.Id, role);
        m.Role = string.IsNullOrWhiteSpace(role) ? null : role.Trim();
    }

    private async Task Invite(Member m)
    {
        _inviting = m.Id; StateHasChanged();
        var ok = await People.InviteAsync(_group!, m, _member!, Nav.BaseUri);
        _invited[m.Id] = ok ? "Invitation sendt" : "Kunne ikke sende – tjek mailen";
        _inviting = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var session = await ClubAuth.ResolveSessionAsync(JS, Slug);
        if (session is null) { Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true); return; }
        _member = session.Member;
        _group = session.Member.Group;

        _members = await People.ListAsync(_group!.Id);
        _openCountByName = await Tasks.OpenCountByNameAsync(_group!.Id);

        _loaded = true;
        StateHasChanged();
    }
}
