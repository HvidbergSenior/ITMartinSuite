@page "/g/{slug}/join"
@rendermode InteractiveServer
@inject TeamAccess Access
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="join-wrap">
    <div class="join-card">
        <h1 class="join-title">@(_group?.Name ?? "Foreningsmakker")</h1>
        <p class="join-sub">@(_group?.Description ?? "")</p>

        @if (_error != null)
        {
            <div class="join-error">@_error</div>
        }

        @if (!_loaded)
        {
            <div class="join-loading">Indlæser...</div>
        }
        else if (_group == null)
        {
            <div class="join-error">Gruppen findes ikke.</div>
        }
        else if (!_hasMembers)
        {
            <p class="join-hint">Der er ingen i foreningen endnu. Du er den første - så bliver du admin.</p>
            <FoundForm Slug="@Slug" ButtonText="Bliv foreningens admin" />
        }
        else
        {
            <section class="join-mail">
                <h2 class="join-mail-title">Log ind med din mail</h2>
                <p class="join-hint">Skriv den mail, foreningen har på dig. Du får et link - ingen adgangskode.</p>
                <div class="join-field">
                    <label for="login-mail">Mail</label>
                    <input id="login-mail" @bind="_mail" type="email" placeholder="navn@mail.dk" class="join-input" maxlength="120" @onkeydown="OnMailKey" />
                </div>
                <button class="join-btn" @onclick="SendLinkAsync" disabled="@_sending">@(_sending ? "Sender..." : "Send mig et link")</button>
                @if (_mailResult is not null) { <p class="join-mail-result">@_mailResult</p> }
            </section>

            <details class="join-pin">
                <summary>Log ind med navn og PIN i stedet</summary>
            <div class="join-field">
                <label>Dit navn</label>
                <input @bind="_name" placeholder="Fornavn Efternavn" class="join-input" maxlength="60" />
            </div>
            <div class="join-field">
                <label>Invitationskode</label>
                <input @bind="_code" placeholder="Kun nødvendig første gang" class="join-input" type="password" />
                <div class="join-hint">Kendte navne med korrekt PIN behøver den ikke igen.</div>
            </div>
            <div class="join-field">
                <label>Din PIN</label>
                <input @bind="_pin" placeholder="min. 4 cifre" class="join-input" type="password" maxlength="20" @onkeydown="OnPinKey" />
                <div class="join-hint">Første gang: vælg selv en PIN. Kendte navne: brug din tidligere PIN - det er hvad der forhindrer andre i at logge ind som dig.</div>
            </div>
            <div class="join-field">
                <label>Kontaktinfo (telefon/email, valgfrit)</label>
                <input @bind="_contactInfo" placeholder="fx 12345678 eller navn@mail.dk" class="join-input" maxlength="100" />
                <div class="join-hint">Vises for de andre medlemmer under Medlemmer. Skriv igen her for at opdatere.</div>
            </div>
            <button class="join-btn" @onclick="JoinAsync" disabled="@_joining">
                @(_joining ? "Tilmelder..." : "Tilmeld")
            </button>
            </details>
        }
    </div>
</div>

<style>
    .join-wrap { display: flex; justify-content: center; padding: 24px 16px 40px; }
    .join-card { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 40px 32px; width: 100%; max-width: 420px; text-align: center; color: var(--text); }
    .join-logo { font-size: 48px; margin-bottom: 12px; }
    .join-title { font-size: 26px; font-weight: 900; margin: 0 0 8px; }
    .join-sub { font-size: 14px; color: var(--muted); margin: 0 0 28px; }
    .join-field { text-align: left; margin-bottom: 16px; }
    .join-field label { display: block; font-size: 14px; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
    .join-input { width: 100%; background: var(--k-card); border: 1px solid var(--k-muted-2); border-radius: 10px; padding: 12px 14px; color: var(--k-text); font-size: 16px; }
    .join-input:focus { border-color: var(--accent); }
    .join-btn { width: 100%; min-height: 52px; padding: 13px; border-radius: 12px; border: 2px solid var(--k-text); background: var(--k-accent-soft); color: var(--k-text); font-size: 17px; font-weight: 700; cursor: pointer; margin-top: 8px; }
    .join-btn:hover:not(:disabled) { border-color: var(--k-accent-dark); }
    .join-btn:disabled { opacity: .5; cursor: default; }
    .join-error { background: rgba(248,113,113,.15); border: 1px solid rgba(248,113,113,.3); border-radius: 10px; padding: 10px 14px; font-size: 13px; color: var(--red); margin-bottom: 16px; }
    .join-loading { color: var(--muted); padding: 20px 0; }
    .join-mail { text-align: left; display: grid; gap: 8px; margin-bottom: 20px; }
    .join-mail-title { font-size: 18px; margin: 0; }
    .join-mail-result { font-size: 14px; margin: 0; color: var(--text); }
    .join-pin { text-align: left; border-top: 1px solid var(--border); padding-top: 14px; }
    .join-pin summary { cursor: pointer; color: var(--muted); font-size: 14px; margin-bottom: 12px; }
    .join-hint { font-size: 13px; color: var(--muted); margin-top: 5px; line-height: 1.4; }
</style>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Inject] private ClubAuthService ClubAuth { get; set; } = null!;

    private Group? _group;
    private string _name = "";
    private string _code = "";
    private string _pin = "";
    private string _contactInfo = "";
    private string? _error;
    private bool _joining;
    private bool _loaded;
    private bool _hasMembers = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (await ClubAuth.ResolveSessionAsync(JS, Slug) is not null)
        {
            Nav.NavigateTo($"/g/{Slug}", forceLoad: true);
            return;
        }

        _group = await Access.GroupAsync(Slug);
        _hasMembers = _group is null || await Access.HasMembersAsync(_group);
        _loaded = true;
        StateHasChanged();
    }

    private string _mail = "";
    private string? _mailResult;
    private bool _sending;

    private async Task OnMailKey(KeyboardEventArgs e) { if (e.Key == "Enter") await SendLinkAsync(); }

    private async Task SendLinkAsync()
    {
        if (_group is null) return;
        _sending = true; _mailResult = null; StateHasChanged();
        _mailResult = Access.MailConfigured
            ? await Access.SendLoginLinkAsync(_group, _mail, Nav.BaseUri)
            : "Mail er ikke sat op endnu. Brug navn og PIN herunder, eller bed en fra bestyrelsen om dit personlige link.";
        _sending = false;
    }

    private async Task OnPinKey(KeyboardEventArgs e) { if (e.Key == "Enter") await JoinAsync(); }

    private async Task JoinAsync()
    {
        _error = null;
        if (_group == null) return;

        _joining = true;
        StateHasChanged();

        try
        {
            var result = await Access.JoinAsync(_group, _name, _pin, _code, _contactInfo);
            if (result.Session is not { } session)
            {
                _error = result.Error;
                _joining = false;
                return;
            }

            await JS.InvokeVoidAsync("clubJs.setSession", session.Id.ToString());
            Nav.NavigateTo($"/g/{Slug}", forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = $"Noget gik galt: {ex.Message}";
            _joining = false;
        }
    }
}
