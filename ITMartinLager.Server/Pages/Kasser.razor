@page "/kasser"
@inject BoxUseCases Boxes
@inject IntakeUseCases Intake
@inject NavigationManager Nav

<PageTitle>Kasser – Bogshoppen Lager</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">📦 Kasser</h1>
    <p>Hver kasse, reol eller sæk har et nummer og en label med QR-kode. Scan labelen med telefonen, så ser du hvad der er i.</p>
    <p>Hjælperne skriver selv nummeret på kassen og tager billederne i <a href="@Intake.VareinfoBase">📷 Vareinfo</a>. Kassen kommer herind af sig selv med det første billede.</p>
    <div class="lg-row">
        <input class="k-input" @bind="_place" placeholder="Hvor står den? (fx Garagen, reol 2)" />
        <button class="k-btn k-btn-primary" @onclick="New">➕ Ny kasse</button>
    </div>
    <p class="k-small"><a href="/api/eksport.csv">⬇️ Hent hele lageret som regneark (CSV)</a></p>
    <p class="k-small"><a href="/api/varefotos.zip" download>⬇️ Hent alle varefotos (zip)</a> – en mappe pr. kasse, hvert billede hedder som varen. Kun varer, der har fået et billede med 'Tag billede af varen'.</p>
</section>

@if (_intake.Count > 0)
{
    <section class="k-card">
        <h2 class="k-card-title">📷 Billeder fra Vareinfo</h2>
        <p>Tryk <b>Læs</b>, når det passer dig. Billederne læses af AI'en og stregkoderne slås op – i baggrunden, ca. 5 billeder i minuttet. Tingene lægges i kassen. Du kan godt lukke siden imens.</p>
        @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
        @if (_msg is not null) { <p class="lg-ok" role="status">✓ @_msg</p> }
        <ul class="lg-list">
            @foreach (var b in _intake)
            {
                <li>
                    <a href="/kasse/@b.BoxCode"><span class="lg-box">@b.BoxCode</span>
                        <span class="lg-main"><b>Kasse @b.Number</b>
                            <span class="k-small k-muted">
                                @if (b.Waiting + b.Scans > 0) { <span>@b.Waiting billeder og @b.Scans stregkoder venter@(b.Wanted + b.ScansWanted > 0 ? " (bliver læst nu)" : "")</span> }
                                @if (b.Read > 0) { <span>@(b.Waiting + b.Scans > 0 ? " · " : "")@b.Read læst, @b.Found ting fundet</span> }
                                @if (b.Helpers != "") { <span> · taget af @b.Helpers</span> }
                            </span></span></a>
                    @if (b.HasUnread) { <button class="k-btn k-btn-sm k-btn-secondary" @onclick="() => WantRead(b.BoxCode)">Læs kasse @b.Number</button> }
                </li>
            }
        </ul>
        @if (_intake.Count(b => b.HasUnread) > 1)
        {
            <button class="k-btn k-btn-primary" @onclick="() => WantRead(null)">Læs alle</button>
        }
        <button class="k-btn k-btn-ghost k-btn-sm" @onclick="Load">↻ Opdatér</button>
        <p class="k-small k-muted">AI-kald i dag: @_callsToday af @Intake.MaxCallsPerDay (ét pr. billede – stregkoder er gratis).</p>
    </section>
}

<section class="k-card">
    <h2 class="k-card-title">Alle kasser (@_rows.Count)</h2>
    <ul class="lg-list">
        @foreach (var r in _rows)
        {
            <li><a href="/kasse/@r.Code"><span class="lg-box">@r.Code</span><span class="lg-main"><b>@(r.Place == "" ? "(ingen placering)" : r.Place)</b><span class="k-small k-muted">@r.Units ting · @r.Lines linjer</span></span></a></li>
        }
    </ul>
</section>

@code {
    private List<BoxSummary> _rows = [];
    private List<BoxIntake> _intake = [];
    private string _place = "";
    private string? _msg, _error;
    private int _callsToday;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _rows = await Boxes.AllAsync();
        _intake = await Intake.BoxesAsync();
        _callsToday = await Intake.CallsTodayAsync();
    }

    private async Task WantRead(string? code)
    {
        _error = null;
        try
        {
            var n = await Intake.WantReadAsync(code);
            _msg = $"{n} billeder og stregkoder bliver læst i baggrunden. Tryk ↻ Opdatér for at se hvor langt den er.";
        }
        catch (Exception ex) { _error = ex.Message; }
        await Load();
    }

    private async Task New()
    {
        var box = await Boxes.NewAsync(_place);
        Nav.NavigateTo($"/kasse/{box.Code}");
    }
}
