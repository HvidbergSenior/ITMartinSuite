@page "/kasser/labels"
@layout EmptyLayout
@inject BoxUseCases Boxes
@inject NavigationManager Nav

<PageTitle>Labels – Bogshoppen Lager</PageTitle>

@* Many box labels on one sheet (user 2026-10-21): print once, cut, tape on the boxes before they are filled.
   Same label as /kasse/{Code}/label; the boxes are made in Lager when missing, so every QR opens a box page. *@
<div class="lg-noprint lg-sheet-form">
    <h1>Print labels til mange kasser</h1>
    <p>Vælg fra og til kassenummer (højst @BoxCodes.MaxSheet ad gangen) og tryk <b>Vis labels</b>. Tryk så <b>Print</b>, klip dem ud og sæt én på hver kasse.
       Hjælperne scanner QR-koden i Vareinfo, og du kan scanne den med telefonens kamera for at se, hvad der er i kassen.</p>
    <form method="get" action="/kasser/labels" class="lg-row">
        <label>Fra nr. <input class="k-input" type="number" inputmode="numeric" min="1" name="fra" value="@(Fra ?? 1)" /></label>
        <label>Til nr. <input class="k-input" type="number" inputmode="numeric" min="1" name="til" value="@(Til ?? (Fra ?? 1) + 11)" /></label>
        <button class="k-btn k-btn-primary" type="submit">Vis labels</button>
    </form>
    @if (_labels.Count > 0)
    {
        <p><button class="k-btn k-btn-primary" onclick="window.print()">🖨️ Print @_labels.Count labels</button> <a href="/kasser">← Tilbage til kasser</a></p>
    }
    else
    {
        <p><a href="/kasser">← Tilbage til kasser</a></p>
    }
</div>

<div class="lg-sheet">
    @foreach (var l in _labels)
    {
        <div class="lg-label">
            <div class="lg-label-code">@l.Code</div>
            <div class="lg-label-qr">@((MarkupString)l.Qr)</div>
            <div class="lg-label-place">@l.Place</div>
            <div class="lg-label-brand">Bogshoppen</div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "fra")] public int? Fra { get; set; }
    [SupplyParameterFromQuery(Name = "til")] public int? Til { get; set; }

    private sealed record Label(string Code, string Qr, string Place);
    private List<Label> _labels = [];

    protected override async Task OnParametersSetAsync()
    {
        _labels = [];
        if (Fra is not { } from) return;
        foreach (var box in await Boxes.LabelSheetAsync(from, Til ?? from))
        {
            var url = Nav.ToAbsoluteUri($"/kasse/{box.Code}").ToString();
            var qr = new QRCoder.SvgQRCode(new QRCoder.QRCodeGenerator().CreateQrCode(url, QRCoder.QRCodeGenerator.ECCLevel.M))
                .GetGraphic(8, "#000000", "#ffffff", drawQuietZones: true);
            _labels.Add(new Label(box.Code, qr, box.Place));
        }
    }
}
