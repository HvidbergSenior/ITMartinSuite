@page "/"
@inject BoxUseCases Boxes
@inject ItemUseCases Items
@inject IVareinfoGateway Vareinfo
@inject GoldUseCases Gold

<PageTitle>Søg – Bogshoppen Lager</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">🔎 Find en vare</h1>
    <p class="lg-answer">@_units.ToString("N0") ting i @_boxes kasser</p>
    <input class="k-input lg-search" @bind="_q" @bind:event="oninput" @bind:after="Find" placeholder="Søg: titel, kunstner, serie, nummer, år …" autofocus />
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_kind is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetKind(null)">Alle</button>
        @foreach (var k in Kinds.All)
        {
            <button class="k-btn k-btn-sm @(_kind == k ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetKind(k)">@Kinds.Icon(k) @k</button>
        }
    </div>
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_valuation is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetValuation(null)">Alle priser</button>
        @foreach (var v in Valuations.All)
        {
            <button class="k-btn k-btn-sm @(_valuation == v ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetValuation(v)">@ValIcon(v) @v</button>
        }
    </div>
</section>

@if (_hits is not null)
{
    <section class="k-card">
        <h2 class="k-card-title">@(_hits.Count >= Max ? $"De første {Max} fund" : $"{_hits.Count} fund")</h2>
        @if (_hits.Count == 0)
        {
            <p>Intet fundet. Prøv færre ord – eller registrér det i <a href="@Vareinfo.PublicBase">📷 Vareinfo</a>.</p>
        }
        <ul class="lg-list">
            @foreach (var i in _hits)
            {
                <li>
                    <a href="/vare/@i.Id">
                        <span class="lg-icon">@Kinds.Icon(i.Kind)</span>
                        <span class="lg-main"><b>@(GoldOf(i) is { } g ? g.Badge + " · " : "")@i.Line()</b>@if (i.Interest != "") { <span class="lg-int">✨ @i.Interest</span> }<span class="k-small k-muted">@i.Kind · @i.Condition@(i.Quantity > 1 ? $" · {i.Quantity} stk." : "")</span><span class="k-small"><b>@ValIcon(i.Valuation) @(i.Price is { } p ? $"{p:0} kr (sat af dig)" : i.PriceHint is { } h ? $"Vores pris {h:0} kr" : i.SimilarHint is { } s ? $"{i.Valuation} – magen til ca. {s:0} kr" : i.Valuation)</b></span>@if (_high.TryGetValue(i.Id, out var top)) { <span class="k-small"><b>⚠ @top.Source: @top.Kr kr</b> – @Pricing.Flag(top.Kr, (int?)i.PriceHint)</span> }</span>
                        <span class="lg-box">@(i.Box?.Code ?? "–")</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@code {
    private const int Max = ItemUseCases.MaxHits;
    private string _q = "";
    private string? _kind;
    private List<Item>? _hits;
    private int _units, _boxes;
    private Dictionary<int, PriceFind> _high = [];

    protected override async Task OnInitializedAsync()
    {
        (_units, _boxes) = await Boxes.StockAsync();
        _gold = await Gold.AllAsync();
    }

    private string? _valuation;

    private async Task SetKind(string? k) { _kind = k; await Find(); }
    private async Task SetValuation(string? v) { _valuation = v; await Find(); }

    private List<GoldEntry> _gold = [];
    private GoldEntry? GoldOf(Item i) => ITMartinLager.Domain.Gold.Match(_gold, i.Kind, i.Title, i.Series, i.Number, i.Year);

    // Said in words and with a sign, not only in colour.
    private static string ValIcon(string v) => v switch { Valuations.Valued => "✓", Valuations.Waiting => "⏳", _ => "?" };

    private async Task Find()
    {
        var found = await Items.SearchAsync(_q, _kind, _valuation);
        _hits = found?.Hits;
        _high = found?.FarAbove ?? [];
    }
}
