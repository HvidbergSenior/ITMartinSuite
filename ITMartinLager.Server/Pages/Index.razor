@page "/"
@inject IDbContextFactory<LagerDb> DbFactory

<PageTitle>Søg – Bogshoppen Lager</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">🔎 Find en vare</h1>
    <p class="lg-answer">@_units.ToString("N0") ting i @_boxes kasser</p>
    <input class="k-input lg-search" @bind="_q" @bind:event="oninput" @bind:after="Find" placeholder="Søg: titel, kunstner, serie, nummer, år …" autofocus />
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_kind is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetKind(null)">Alle</button>
        @foreach (var k in Kinds.All)
        {
            <button class="k-btn k-btn-sm @(_kind == k ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetKind(k)">@Kinds.Icon(k) @k</button>
        }
    </div>
</section>

@if (_hits is not null)
{
    <section class="k-card">
        <h2 class="k-card-title">@(_hits.Count >= Max ? $"De første {Max} fund" : $"{_hits.Count} fund")</h2>
        @if (_hits.Count == 0)
        {
            <p>Intet fundet. Prøv færre ord – eller registrér det under <a href="/registrer">📷 Registrér</a>.</p>
        }
        <ul class="lg-list">
            @foreach (var i in _hits)
            {
                <li>
                    <a href="/vare/@i.Id">
                        <span class="lg-icon">@Kinds.Icon(i.Kind)</span>
                        <span class="lg-main"><b>@Line(i)</b>@if (i.Interest != "") { <span class="lg-int">✨ @i.Interest</span> }<span class="k-small k-muted">@i.Kind · @i.Condition@(i.Quantity > 1 ? $" · {i.Quantity} stk." : "")@(i.Price is { } p ? $" · {p:0} kr" : i.PriceHint is { } h ? $" · ca. {h:0} kr" : "")</span>@if (_high.TryGetValue(i.Id, out var top)) { <span class="k-small"><b>⚠ @top.Source: @top.Kr kr</b> – @PriceHunt.Summary.Flag(top.Kr, (int?)i.PriceHint)</span> }</span>
                        <span class="lg-box">@(i.Box?.Code ?? "–")</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@code {
    private const int Max = 200;
    private string _q = "";
    private string? _kind;
    private List<Item>? _hits;
    private int _units, _boxes;
    private Dictionary<int, PriceFind> _high = [];

    public static string Line(Item i) => string.Join(" · ", new[]
    {
        i.Artist, i.Title,
        i.Series != "" && !i.Title.Contains(i.Series, StringComparison.OrdinalIgnoreCase) ? i.Series : "",
        i.Number != "" ? "nr. " + i.Number : "", i.Year?.ToString() ?? "", i.Platform,
    }.Where(s => !string.IsNullOrWhiteSpace(s)));

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _units = await db.Items.SumAsync(i => (int?)i.Quantity) ?? 0;
        _boxes = await db.Boxes.CountAsync();
    }

    private async Task SetKind(string? k) { _kind = k; await Find(); }

    private async Task Find()
    {
        if (_q.Trim().Length < 2 && _kind is null) { _hits = null; return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        _hits = await Store.Search(db.Items.Include(i => i.Box), _q, _kind)
            .OrderBy(i => i.Series).ThenBy(i => i.Year).ThenBy(i => i.Number).ThenBy(i => i.Title).Take(Max).ToListAsync();
        // The dearest find per item, shown when it is 3x the normal price or more (user: "if the normal price is 5 kr
        // but on amazon.de it costs 50 kr i want to know that").
        var ids = _hits.Where(i => i.PriceHint is > 0).Select(i => i.Id).ToList();
        var tops = await db.PriceFinds.Where(f => ids.Contains(f.ItemId)).GroupBy(f => f.ItemId)
            .Select(g => g.OrderByDescending(f => f.Kr).First()).ToListAsync();
        _high = tops.Where(f => _hits.First(i => i.Id == f.ItemId).PriceHint is { } h && f.Kr >= h * 3).ToDictionary(f => f.ItemId);
    }
}
