@page "/"
@inject BoxUseCases Boxes
@inject ItemUseCases Items
@inject IntakeUseCases Intake
@inject VareinfoLinks Vareinfo
@inject GoldUseCases Gold

<PageTitle>Søg – Bogshoppen Lager</PageTitle>

@* Lager's job (2026-11-15): fix the difficult ones - first on the page. *@
<section class="k-card">
    <h1 class="k-card-title">Ret de svære</h1>
    @if (_waiting.NotSent + _waiting.Sent > 0)
    {
        @* The Batch API (2026-11-15): half price, read in the evening. *@
        <p class="k-small" role="status">@(_waiting.NotSent > 0 ? $"{_waiting.NotSent} billeder venter på aftenens læsning (kl. {ITMartinLager.Domain.AiBatching.SendHour} – til halv pris). " : "")@(_waiting.Sent > 0 ? $"{_waiting.Sent} er sendt og bliver læst nu – de kommer her af sig selv." : "")</p>
    }
    @if (_unsure.Count == 0)
    {
        <p class="lg-ok" role="status">Færdig – AI'en var sikker på alt. Der er intet at rette.</p>
    }
    else
    {
        <p>@_unsure.Count ting, hvor AI'en var usikker. Se på billedet, ret det, der er forkert, og tryk <b>Gem og næste</b>.</p>
        <a class="k-btn k-btn-primary lg-big" href="/vare/@_unsure[0]?ret=1">Ret de svære (@_unsure.Count)</a>
    }
    @* "if picture is too bad and nothing can be read... It should not fill it out" (2026-11-15): nothing made, shown here. *@
    @if (_unreadable.Count > 0)
    {
        <details class="kr-more">
            <summary>Tag igen: @_unreadable.Count @(_unreadable.Count == 1 ? "billede" : "billeder") den sidste uge</summary>
            <p class="k-small">Der er ikke lavet noget af dem. Tag dem igen – lige, skarpt, tæt på og med forsiden op.</p>
            <div class="lg-unreadable">
                @foreach (var u in _unreadable)
                {
                    <a href="@Vareinfo.Photo(u.VareinfoId)" target="_blank" rel="noopener" title="@u.TakenAt.ToLocalTime().ToString("d/M HH:mm")"><img src="@Vareinfo.Photo(u.VareinfoId)" alt="Billede der skal tages igen" loading="lazy" /><span class="k-small">@(u.Retake != "" ? u.Retake : "kunne ikke læses")</span></a>
                }
            </div>
        </details>
    }
</section>

<section class="k-card">
    @* Simple first (user 2026-11-10: "It should be simple for me"): the search field, and every filter folded under "Flere valg". *@
    <h2 class="k-card-title">Find en vare</h2>
    <p class="lg-answer">@_units.ToString("N0") ting i @_boxes kasser</p>
    <input class="k-input lg-search" @bind="_q" @bind:event="oninput" @bind:after="Find" placeholder="Søg: titel, kunstner, serie, nummer, år …" autofocus />
    <details class="kr-more" open="@FiltersOn">
    <summary>Flere valg – kasse, kategori, sprog og pris</summary>
    <p class="kr-label">Hvilke varer</p>
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_scopeKey == "alle" ? "k-btn-primary" : "k-btn-secondary")" @onclick='() => SetScope("alle")'>Hele lageret</button>
        <button class="k-btn k-btn-sm @(_scopeKey == "idag" ? "k-btn-primary" : "k-btn-secondary")" @onclick='() => SetScope("idag")'>Nye i dag (@_today)</button>
        <button class="k-btn k-btn-sm @(_scopeKey == "uge" ? "k-btn-primary" : "k-btn-secondary")" @onclick='() => SetScope("uge")'>Sidste 7 dage (@_week)</button>
        @foreach (var (b, n) in _newBoxes)
        {
            var key = $"kasse-{b.Id}";
            <button class="k-btn k-btn-sm @(_scopeKey == key ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetScope(key)">@b.Label (@n nye)</button>
        }
    </div>
    @* Main categories (user 2026-11-03: "split up in the main categories"); the kinds inside one show under it. *@
    <p class="kr-label">Kategori</p>
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_category is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetCategory(null)">Alle kategorier</button>
        @foreach (var c in ProductTypes.All)
        {
            <button class="k-btn k-btn-sm @(_category == c ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetCategory(c)">@c</button>
        }
    </div>
    @if (_category is not null && ProductTypes.KindsOf(_category) is { Length: > 1 } kinds)
    {
        <div class="lg-chips">
            <button class="k-btn k-btn-sm @(_kind is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetKind(null)">Alle i @_category</button>
            @foreach (var k in kinds)
            {
                <button class="k-btn k-btn-sm @(_kind == k ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetKind(k)">@Kinds.Icon(k) @k</button>
            }
        </div>
    }
    <p class="kr-label">Sprog</p>
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_language is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetLanguage(null)">Alle sprog</button>
        @foreach (var l in Languages.All)
        {
            <button class="k-btn k-btn-sm @(_language == l ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetLanguage(l)">@l</button>
        }
    </div>
    <p class="kr-label">Pris</p>
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_valuation is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetValuation(null)">Alle priser</button>
        @foreach (var v in Valuations.All)
        {
            <button class="k-btn k-btn-sm @(_valuation == v ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetValuation(v)">@ValIcon(v) @v</button>
        }
    </div>
    </details>
    <div class="lg-row k-mt">
        <button class="k-btn @(_scopeKey == "idag" ? "k-btn-primary" : "k-btn-secondary")" @onclick='() => SetScope("idag")'>Nye i dag (@_today)</button>
        <button class="k-btn k-btn-secondary" @onclick="ShowInteresting">Vis de interessante – guld, sølv, bronze og måske</button>
    </div>
</section>

@if (_interesting is not null)
{
    <section class="k-card">
        <h2 class="k-card-title">@_interesting.Count interessante @ScopeWords</h2>
        <div class="lg-chips">
            <button class="k-btn k-btn-sm @(_rank is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => _rank = null">Alle (@_interesting.Count)</button>
            @for (var r = 0; r < ITMartinLager.Domain.Gold.InterestingKinds.Length; r++)
            {
                var rank = r;
                <button class="k-btn k-btn-sm @(_rank == rank ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => _rank = rank">
                    @ITMartinLager.Domain.Gold.InterestingKinds[rank] (@_interesting.Count(x => ITMartinLager.Domain.Gold.Rank(x.Item2) == rank))
                </button>
            }
        </div>
        <p class="k-small k-muted">Guld først, så sølv, bronze og måske. Kassen står til højre, så du kan finde den og tage den fra. Tryk på en for at se priserne og annoncerne.</p>
        @if (_interesting.Count == 0) { <p>Ingen endnu. Mærkerne kommer, når prisjægeren har vurderet tingene, og fra guldlisten.</p> }
        <ul class="lg-list">
            @foreach (var (i, note) in _interesting.Where(x => _rank is null || ITMartinLager.Domain.Gold.Rank(x.Item2) == _rank))
            {
                <li>
                    <a href="/vare/@i.Id">
                        <span class="lg-icon">@Kinds.Icon(i.Kind)</span>
                        <span class="lg-main"><b>@i.Line()</b><span class="k-small"><b>@note</b></span><span class="k-small k-muted">@i.Condition@(i.Quantity > 1 ? $" · {i.Quantity} stk." : "")</span></span>
                        <span class="lg-box">@(i.Box?.Label ?? "–")</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@if (_hits is not null)
{
    <section class="k-card">
        @* The real total, also past Max (user 2026-10-31: "says 200 and 196 later"). *@
        <h2 class="k-card-title">@(_total > _hits.Count ? $"{_total} fund – de første {_hits.Count} vises" : $"{_total} fund")</h2>
        @if (_hits.Count == 0)
        {
            <p>Intet fundet. Prøv færre ord.</p>
        }
        <ul class="lg-list">
            @foreach (var i in _hits)
            {
                <li class="@(_removed.ContainsKey(i.Id) ? "lg-removed" : "")">
                    <a href="/vare/@i.Id">
                        <span class="lg-icon">@Kinds.Icon(i.Kind)</span>
                        <span class="lg-main"><b>@i.Line()</b>@if (NoteOf(i) is { } note) { <span class="k-small"><b>@note</b></span> }@if (i.Interest != "") { <span class="lg-int">✨ @i.Interest</span> }<span class="k-small k-muted">@i.Kind · @i.Condition@(i.Quantity > 1 ? $" · {i.Quantity} stk." : "")</span>@if (Admin) { <span class="k-small"><b>@ValIcon(i.Valuation) @(i.Deal != "" ? $"{Valuations.InDeal}: {i.Deal}" : i.Price is { } p ? $"{p:0} kr (sat af dig)" : i.PriceHint is { } h ? $"Vores pris {h:0} kr" : i.SimilarHint is { } s ? $"{i.Valuation} – magen til ca. {s:0} kr" : i.Valuation)</b></span>@if (_high.TryGetValue(i.Id, out var top)) { <span class="k-small"><b>⚠ @top.Source: @top.Kr kr</b> – @Pricing.Flag(top.Kr, (int?)i.PriceHint)</span> } }</span>
                        <span class="lg-box">@(i.Box?.Label ?? "–")</span>
                    </a>
                    @if (Admin)
                    {
                        @if (_removed.ContainsKey(i.Id))
                        {
                            <button class="k-btn k-btn-sm k-btn-primary lg-fjern" @onclick="() => UndoRemove(i)">Fortryd</button>
                        }
                        else
                        {
                            <button class="k-btn k-btn-sm k-btn-secondary lg-fjern" title="Fjern fra lageret – den gemmes som Ikke købt" @onclick="() => Remove(i)">Fjern</button>
                        }
                    }
                </li>
            }
        </ul>
    </section>
}

@if (Admin)
{
    @* Until Guld, Bøger, Kiosk, Tilbud, Strik, Ting and Magic have moved (2026-11-15): small, at the bottom. Kasser stays reachable too. *@
    <p class="k-small k-muted lg-bottom-links"><a href="/kasser">Alle kasser</a> · <a href="/mere">Værktøjer, der flytter snart</a></p>
}

@code {
    // "Flere valg" stays open while a filter is chosen, so it is clear why the list is shorter.
    private bool FiltersOn => _scopeKey != "alle" || _category is not null || _language is not null || _valuation is not null;

    [CascadingParameter] public LagerUser? Me { get; set; }
    private bool Admin => Me is { IsAdmin: true };
    private const int Max = ItemUseCases.MaxHits;
    private string _q = "";
    private string? _kind;
    private List<Item>? _hits;
    private int _total;
    private int _units, _boxes;
    private Dictionary<int, PriceFind> _high = [];
    private readonly Dictionary<int, string> _removed = [];   // Fjern pressed: id -> the status it had (for Fortryd)

    private async Task Remove(Item i) => _removed[i.Id] = await Items.RemoveAsync(i.Id);

    private async Task UndoRemove(Item i)
    {
        if (!_removed.Remove(i.Id, out var status)) return;
        await Items.UndoRemoveAsync(i.Id, status);
    }
    private List<int> _unsure = [];
    private (int NotSent, int Sent) _waiting;
    private List<ITMartinLager.Domain.BoxShot> _unreadable = [];

    protected override async Task OnInitializedAsync()
    {
        (_units, _boxes) = await Boxes.StockAsync();
        _unsure = await Items.UnsureAsync();
        _waiting = await Intake.WaitingAsync();
        _unreadable = await Intake.UnreadableAsync();
        _gold = await Gold.AllAsync();
        var now = DateTime.UtcNow;
        _todayUtc = ItemScope.DanishMidnightUtc(now);
        _weekUtc = ItemScope.DanishMidnightUtc(now, 6);
        _newBoxes = await Items.NewPerBoxAsync(_weekUtc);
        _today = (await Items.NewPerBoxAsync(_todayUtc)).Sum(x => x.Count);
        _week = _newBoxes.Sum(x => x.Count);
    }

    // "Hvilke varer" (user 2026-11-03: "I could not search for only the new products").
    private DateTime _todayUtc, _weekUtc;
    private int _today, _week;
    private List<(Box Box, int Count)> _newBoxes = [];
    private string _scopeKey = "alle";
    private ItemScope Scope => (_scopeKey switch
    {
        "idag" => new ItemScope(SinceUtc: _todayUtc),
        "uge" => new ItemScope(SinceUtc: _weekUtc),
        var k when k.StartsWith("kasse-") && int.TryParse(k[6..], out var id) => new ItemScope(SinceUtc: _weekUtc, BoxId: id),
        _ => ItemScope.All,
    }) with { Category = _category, Language = _language };
    private string ScopeWords => _scopeKey switch
    {
        "idag" => "blandt dagens nye",
        "uge" => "blandt de sidste 7 dages nye",
        var k when k.StartsWith("kasse-") => "blandt de nye i " + (_newBoxes.FirstOrDefault(x => $"kasse-{x.Box.Id}" == k).Box?.Code ?? "kassen"),
        _ => "på lager",
    };
    private async Task SetScope(string key) { _scopeKey = key; await Refresh(); }

    private string? _valuation;

    private async Task SetKind(string? k) { _kind = k; await Refresh(); }
    private string? _category, _language;
    private async Task SetCategory(string? c) { _category = c; _kind = null; await Refresh(); }
    private async Task SetLanguage(string? l) { _language = l; await Refresh(); }
    private async Task Refresh() { if (_interesting is not null) await ShowInteresting(); else await Find(); }
    private async Task SetValuation(string? v) { _valuation = v; await Refresh(); }

    private List<(Item, string)>? _interesting;
    private int? _rank;
    private async Task ShowInteresting()
    {
        _hits = null;
        _interesting = (await Items.InterestingAsync(_gold, scope: Scope)).Where(x => _kind is null || x.Item1.Kind == _kind).ToList();
    }

    private List<GoldEntry> _gold = [];
    private string? NoteOf(Item i) => ITMartinLager.Domain.Gold.Interesting(_gold, i.Kind, i.Title, i.Series, i.Number, i.Year, i.Price ?? i.PriceHint, i.Want, i.Have);

    // Said in words and with a sign, not only in colour.
    private static string ValIcon(string v) => v switch { Valuations.Valued => "✓", Valuations.InDeal => "%", Valuations.Waiting => "⏳", _ => "?" };

    private async Task Find()
    {
        _interesting = null;
        var found = await Items.SearchAsync(_q, _kind, _valuation, scope: Scope);
        _hits = found?.Hits;
        _total = found?.Total ?? 0;
        _high = found?.FarAbove ?? [];
    }
}
