@page "/"
@inject BoxUseCases Boxes
@inject ItemUseCases Items
@inject VareinfoLinks Vareinfo
@inject GoldUseCases Gold

<PageTitle>Søg – Bogshoppen Lager</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">🔎 Find en vare</h1>
    <p class="lg-answer">@_units.ToString("N0") ting i @_boxes kasser</p>
    <p class="k-small k-muted">Hvilke varer: hele lageret, kun dem der er registreret i dag eller de sidste 7 dage, eller én kasse. Valget gælder både søgningen og ⭐ interessante.</p>
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_scopeKey == "alle" ? "k-btn-primary" : "k-btn-secondary")" @onclick='() => SetScope("alle")'>Hele lageret</button>
        <button class="k-btn k-btn-sm @(_scopeKey == "idag" ? "k-btn-primary" : "k-btn-secondary")" @onclick='() => SetScope("idag")'>Nye i dag (@_today)</button>
        <button class="k-btn k-btn-sm @(_scopeKey == "uge" ? "k-btn-primary" : "k-btn-secondary")" @onclick='() => SetScope("uge")'>Sidste 7 dage (@_week)</button>
        @foreach (var (b, n) in _newBoxes)
        {
            var key = $"kasse-{b.Id}";
            <button class="k-btn k-btn-sm @(_scopeKey == key ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetScope(key)">@b.Code@(b.Note != "" ? $" – {b.Note}" : "") (@n nye)</button>
        }
    </div>
    <input class="k-input lg-search" @bind="_q" @bind:event="oninput" @bind:after="Find" placeholder="Søg: titel, kunstner, serie, nummer, år …" autofocus />
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_kind is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetKind(null)">Alle</button>
        @foreach (var k in Kinds.All)
        {
            <button class="k-btn k-btn-sm @(_kind == k ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetKind(k)">@Kinds.Icon(k) @k</button>
        }
    </div>
    <button class="k-btn k-btn-primary" @onclick="ShowInteresting">⭐ Alle interessante – guld, sølv, bronze og måske</button>
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_valuation is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetValuation(null)">Alle priser</button>
        @foreach (var v in Valuations.All)
        {
            <button class="k-btn k-btn-sm @(_valuation == v ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetValuation(v)">@ValIcon(v) @v</button>
        }
    </div>
</section>

@if (_interesting is not null)
{
    <section class="k-card">
        <h2 class="k-card-title">⭐ @_interesting.Count interessante @ScopeWords</h2>
        <div class="lg-chips">
            <button class="k-btn k-btn-sm @(_rank is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => _rank = null">Alle (@_interesting.Count)</button>
            @for (var r = 0; r < ITMartinLager.Domain.Gold.InterestingKinds.Length; r++)
            {
                var rank = r;
                <button class="k-btn k-btn-sm @(_rank == rank ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => _rank = rank">
                    @ITMartinLager.Domain.Gold.InterestingKinds[rank] (@_interesting.Count(x => ITMartinLager.Domain.Gold.Rank(x.Item2) == rank))
                </button>
            }
        </div>
        <p class="k-small k-muted">Guld først, så sølv, bronze og måske. Kassen står til højre, så du kan finde den og tage den fra. Tryk på en for at se priserne og annoncerne.</p>
        @if (_interesting.Count == 0) { <p>Ingen endnu. Mærkerne kommer, når prisjægeren har vurderet tingene, og fra guldlisten.</p> }
        <ul class="lg-list">
            @foreach (var (i, note) in _interesting.Where(x => _rank is null || ITMartinLager.Domain.Gold.Rank(x.Item2) == _rank))
            {
                <li>
                    <a href="/vare/@i.Id">
                        <span class="lg-icon">@Kinds.Icon(i.Kind)</span>
                        <span class="lg-main"><b>@i.Line()</b><span class="k-small"><b>@note</b></span><span class="k-small k-muted">@i.Condition@(i.Quantity > 1 ? $" · {i.Quantity} stk." : "")</span></span>
                        <span class="lg-box">@(i.Box?.Code ?? "–")</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@if (_hits is not null)
{
    <section class="k-card">
        @* The real total, also past Max (user 2026-10-31: "says 200 and 196 later"). *@
        <h2 class="k-card-title">@(_total > _hits.Count ? $"{_total} fund – de første {_hits.Count} vises" : $"{_total} fund")</h2>
        @if (_hits.Count == 0)
        {
            <p>Intet fundet. Prøv færre ord – eller registrér det i <a href="@Vareinfo.Base">📷 Vareinfo</a>.</p>
        }
        <ul class="lg-list">
            @foreach (var i in _hits)
            {
                <li>
                    <a href="/vare/@i.Id">
                        <span class="lg-icon">@Kinds.Icon(i.Kind)</span>
                        <span class="lg-main"><b>@i.Line()</b>@if (NoteOf(i) is { } note) { <span class="k-small"><b>@note</b></span> }@if (i.Interest != "") { <span class="lg-int">✨ @i.Interest</span> }<span class="k-small k-muted">@i.Kind · @i.Condition@(i.Quantity > 1 ? $" · {i.Quantity} stk." : "")</span>@if (Admin) { <span class="k-small"><b>@ValIcon(i.Valuation) @(i.Deal != "" ? $"{Valuations.InDeal}: {i.Deal}" : i.Price is { } p ? $"{p:0} kr (sat af dig)" : i.PriceHint is { } h ? $"Vores pris {h:0} kr" : i.SimilarHint is { } s ? $"{i.Valuation} – magen til ca. {s:0} kr" : i.Valuation)</b></span>@if (_high.TryGetValue(i.Id, out var top)) { <span class="k-small"><b>⚠ @top.Source: @top.Kr kr</b> – @Pricing.Flag(top.Kr, (int?)i.PriceHint)</span> } }</span>
                        <span class="lg-box">@(i.Box?.Code ?? "–")</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@code {
    [CascadingParameter] public LagerUser? Me { get; set; }
    private bool Admin => Me is { IsAdmin: true };
    private const int Max = ItemUseCases.MaxHits;
    private string _q = "";
    private string? _kind;
    private List<Item>? _hits;
    private int _total;
    private int _units, _boxes;
    private Dictionary<int, PriceFind> _high = [];

    protected override async Task OnInitializedAsync()
    {
        (_units, _boxes) = await Boxes.StockAsync();
        _gold = await Gold.AllAsync();
        var now = DateTime.UtcNow;
        _todayUtc = ItemScope.DanishMidnightUtc(now);
        _weekUtc = ItemScope.DanishMidnightUtc(now, 6);
        _newBoxes = await Items.NewPerBoxAsync(_weekUtc);
        _today = (await Items.NewPerBoxAsync(_todayUtc)).Sum(x => x.Count);
        _week = _newBoxes.Sum(x => x.Count);
    }

    // "Hvilke varer" (user 2026-11-03: "I could not search for only the new products").
    private DateTime _todayUtc, _weekUtc;
    private int _today, _week;
    private List<(Box Box, int Count)> _newBoxes = [];
    private string _scopeKey = "alle";
    private ItemScope Scope => _scopeKey switch
    {
        "idag" => new ItemScope(SinceUtc: _todayUtc),
        "uge" => new ItemScope(SinceUtc: _weekUtc),
        var k when k.StartsWith("kasse-") && int.TryParse(k[6..], out var id) => new ItemScope(SinceUtc: _weekUtc, BoxId: id),
        _ => ItemScope.All,
    };
    private string ScopeWords => _scopeKey switch
    {
        "idag" => "blandt dagens nye",
        "uge" => "blandt de sidste 7 dages nye",
        var k when k.StartsWith("kasse-") => "blandt de nye i " + (_newBoxes.FirstOrDefault(x => $"kasse-{x.Box.Id}" == k).Box?.Code ?? "kassen"),
        _ => "på lager",
    };
    private async Task SetScope(string key)
    {
        _scopeKey = key;
        if (_interesting is not null) await ShowInteresting(); else await Find();
    }

    private string? _valuation;

    private async Task SetKind(string? k) { _kind = k; await Find(); }
    private async Task SetValuation(string? v) { _valuation = v; await Find(); }

    private List<(Item, string)>? _interesting;
    private int? _rank;
    private async Task ShowInteresting()
    {
        _hits = null;
        _interesting = await Items.InterestingAsync(_gold, scope: Scope);
    }

    private List<GoldEntry> _gold = [];
    private string? NoteOf(Item i) => ITMartinLager.Domain.Gold.Interesting(_gold, i.Kind, i.Title, i.Series, i.Number, i.Year, i.Price ?? i.PriceHint, i.Want, i.Have);

    // Said in words and with a sign, not only in colour.
    private static string ValIcon(string v) => v switch { Valuations.Valued => "✓", Valuations.InDeal => "%", Valuations.Waiting => "⏳", _ => "?" };

    private async Task Find()
    {
        _interesting = null;
        var found = await Items.SearchAsync(_q, _kind, _valuation, scope: Scope);
        _hits = found?.Hits;
        _total = found?.Total ?? 0;
        _high = found?.FarAbove ?? [];
    }
}
