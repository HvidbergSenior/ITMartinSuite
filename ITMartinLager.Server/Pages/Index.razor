@page "/"
@inject BoxUseCases Boxes
@inject ItemUseCases Items
@inject VareinfoLinks Vareinfo
@inject GoldUseCases Gold

<PageTitle>Søg – Bogshoppen Lager</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">🔎 Find en vare</h1>
    <p class="lg-answer">@_units.ToString("N0") ting i @_boxes kasser</p>
    <input class="k-input lg-search" @bind="_q" @bind:event="oninput" @bind:after="Find" placeholder="Søg: titel, kunstner, serie, nummer, år …" autofocus />
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_kind is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetKind(null)">Alle</button>
        @foreach (var k in Kinds.All)
        {
            <button class="k-btn k-btn-sm @(_kind == k ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetKind(k)">@Kinds.Icon(k) @k</button>
        }
    </div>
    <button class="k-btn k-btn-primary" @onclick="ShowInteresting">⭐ Alle interessante – guld, sølv, bronze og måske</button>
    <div class="lg-chips">
        <button class="k-btn k-btn-sm @(_valuation is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetValuation(null)">Alle priser</button>
        @foreach (var v in Valuations.All)
        {
            <button class="k-btn k-btn-sm @(_valuation == v ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => SetValuation(v)">@ValIcon(v) @v</button>
        }
    </div>
</section>

@if (_interesting is not null)
{
    <section class="k-card">
        <h2 class="k-card-title">⭐ @_interesting.Count interessante på lager</h2>
        <div class="lg-chips">
            <button class="k-btn k-btn-sm @(_rank is null ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => _rank = null">Alle (@_interesting.Count)</button>
            @for (var r = 0; r < ITMartinLager.Domain.Gold.InterestingKinds.Length; r++)
            {
                var rank = r;
                <button class="k-btn k-btn-sm @(_rank == rank ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => _rank = rank">
                    @ITMartinLager.Domain.Gold.InterestingKinds[rank] (@_interesting.Count(x => ITMartinLager.Domain.Gold.Rank(x.Item2) == rank))
                </button>
            }
        </div>
        <p class="k-small k-muted">Guld først, så sølv, bronze og måske. Tryk på en for at se priserne og annoncerne.</p>
        @if (_interesting.Count == 0) { <p>Ingen endnu. Mærkerne kommer, når prisjægeren har vurderet tingene, og fra guldlisten.</p> }
        <ul class="lg-list">
            @foreach (var (i, note) in _interesting.Where(x => _rank is null || ITMartinLager.Domain.Gold.Rank(x.Item2) == _rank))
            {
                <li>
                    <a href="/vare/@i.Id">
                        <span class="lg-icon">@Kinds.Icon(i.Kind)</span>
                        <span class="lg-main"><b>@i.Line()</b><span class="k-small"><b>@note</b></span><span class="k-small k-muted">@i.Condition@(i.Quantity > 1 ? $" · {i.Quantity} stk." : "")</span></span>
                        <span class="lg-box">@(i.Box?.Code ?? "–")</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@if (_hits is not null)
{
    <section class="k-card">
        <h2 class="k-card-title">@(_hits.Count >= Max ? $"De første {Max} fund" : $"{_hits.Count} fund")</h2>
        @if (_hits.Count == 0)
        {
            <p>Intet fundet. Prøv færre ord – eller registrér det i <a href="@Vareinfo.Base">📷 Vareinfo</a>.</p>
        }
        <ul class="lg-list">
            @foreach (var i in _hits)
            {
                <li>
                    <a href="/vare/@i.Id">
                        <span class="lg-icon">@Kinds.Icon(i.Kind)</span>
                        <span class="lg-main"><b>@i.Line()</b>@if (NoteOf(i) is { } note) { <span class="k-small"><b>@note</b></span> }@if (i.Interest != "") { <span class="lg-int">✨ @i.Interest</span> }<span class="k-small k-muted">@i.Kind · @i.Condition@(i.Quantity > 1 ? $" · {i.Quantity} stk." : "")</span><span class="k-small"><b>@ValIcon(i.Valuation) @(i.Price is { } p ? $"{p:0} kr (sat af dig)" : i.PriceHint is { } h ? $"Vores pris {h:0} kr" : i.SimilarHint is { } s ? $"{i.Valuation} – magen til ca. {s:0} kr" : i.Valuation)</b></span>@if (_high.TryGetValue(i.Id, out var top)) { <span class="k-small"><b>⚠ @top.Source: @top.Kr kr</b> – @Pricing.Flag(top.Kr, (int?)i.PriceHint)</span> }</span>
                        <span class="lg-box">@(i.Box?.Code ?? "–")</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@code {
    private const int Max = ItemUseCases.MaxHits;
    private string _q = "";
    private string? _kind;
    private List<Item>? _hits;
    private int _units, _boxes;
    private Dictionary<int, PriceFind> _high = [];

    protected override async Task OnInitializedAsync()
    {
        (_units, _boxes) = await Boxes.StockAsync();
        _gold = await Gold.AllAsync();
    }

    private string? _valuation;

    private async Task SetKind(string? k) { _kind = k; await Find(); }
    private async Task SetValuation(string? v) { _valuation = v; await Find(); }

    private List<(Item, string)>? _interesting;
    private int? _rank;
    private async Task ShowInteresting()
    {
        _hits = null;
        _interesting = await Items.InterestingAsync(_gold);
    }

    private List<GoldEntry> _gold = [];
    private string? NoteOf(Item i) => ITMartinLager.Domain.Gold.Interesting(_gold, i.Kind, i.Title, i.Series, i.Number, i.Year, i.Price ?? i.PriceHint);

    // Said in words and with a sign, not only in colour.
    private static string ValIcon(string v) => v switch { Valuations.Valued => "✓", Valuations.Waiting => "⏳", _ => "?" };

    private async Task Find()
    {
        _interesting = null;
        var found = await Items.SearchAsync(_q, _kind, _valuation);
        _hits = found?.Hits;
        _high = found?.FarAbove ?? [];
    }
}
