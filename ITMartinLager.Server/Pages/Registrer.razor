@page "/registrer"
@inject IDbContextFactory<LagerDb> DbFactory
@inject PileReader Reader
@inject IConfiguration Config
@inject NavigationManager Nav
@inject BarcodeLookup Barcodes
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Registrér – Bogshoppen Lager</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">📷 Registrér en bunke</h1>

    @if (_box is null)
    {
        <p class="lg-answer">1. Hvilken kasse lægger du tingene i?</p>
        @if (_recent.Count > 0)
        {
            <div class="lg-chips">
                @foreach (var b in _recent)
                {
                    <button class="k-btn k-btn-secondary" @onclick="() => UseBox(b)">📦 @b.Code @(b.Place != "" ? "· " + b.Place : "")</button>
                }
            </div>
        }
        <div class="lg-row">
            <input class="k-input" @bind="_newPlace" placeholder="Hvor står den nye kasse? (fx Garagen, reol 2)" />
            <button class="k-btn k-btn-primary" @onclick="NewBox">➕ Ny kasse</button>
        </div>
    }
    else
    {
        <p class="lg-answer">Kasse <b>@_box.Code</b>@(_box.Place != "" ? " · " + _box.Place : "") <button class="k-btn k-btn-ghost k-btn-sm" @onclick="() => _box = null">Skift</button></p>
        <p>2. Læg 10-20 ting ud side om side med forsiden op – så alle titler kan ses. Tag billedet lige ovenfra.</p>
        <input class="k-input" @bind="_hint" placeholder="Valgfrit: hvad er det mest? (fx Anders And 1970'erne)" />
        <label class="k-btn k-btn-primary lg-big lg-camera @(_busy ? "is-busy" : "")">
            @(_busy ? "⏳ Læser billedet …" : "📷 Tag billede")
            <InputFile OnChange="Upload" accept="image/*" capture="environment" multiple disabled="@_busy" class="lg-hidden-file" />
        </label>
        <p class="k-small k-muted">Du kan også vælge flere billeder fra telefonen på én gang. AI-kald i dag: @_callsToday af @Reader.MaxCallsPerDay (2 pr. billede: læsning + teksten).</p>

        <p><b>Eller scan stregkoden</b> – bedst til DVD, Blu-ray, CD, spil og bøger. Scan den ene efter den anden; det bipper for hver.</p>
        @if (!_scanning)
        {
            <button class="k-btn k-btn-secondary lg-big" @onclick="StartScan">▮▯▮ Scan stregkoder</button>
        }
        else
        {
            <div class="lg-scan">
                <video id="scan-video" muted playsinline></video>
                <p class="lg-answer" role="status">@(_scanStatus)</p>
                <button class="k-btn k-btn-primary" @onclick="StopScan">✓ Færdig med at scanne</button>
            </div>
        }
    }
    @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
    @if (_saved is not null) { <p class="lg-ok" role="status">✓ @_saved</p> }
</section>

@if (_review.Count > 0)
{
    <section class="k-card">
        <h2 class="k-card-title">3. Tjek og gem (@_review.Count(r => r.Keep) af @_review.Count)</h2>
        @if (_review.Any(r => r.Keep && r.Interest.Trim() == ""))
        {
            <button class="k-btn k-btn-secondary" @onclick="WriteInterest" disabled="@_busy">✨ Skriv det interessante for de @_review.Count(r => r.Keep && r.Interest.Trim() == "") uden</button>
        }
        <p class="k-small">Ret det, der er læst forkert. <b>⚠ Tjek</b> = AI'en var usikker. Fjern fluebenet for ting, der ikke skal med.</p>
        <div class="lg-review">
            @foreach (var r in _review)
            {
                <div class="lg-ritem @(r.Keep ? "" : "is-off")">
                    <div class="lg-rhead">
                        <label><input type="checkbox" @bind="r.Keep" /> @Kinds.Icon(r.Kind)</label>
                        <select class="k-input lg-kind" @bind="r.Kind">
                            @foreach (var k in Kinds.All) { <option value="@k">@k</option> }
                        </select>
                        @if (r.Confidence < 0.6) { <span class="lg-check">⚠ Tjek</span> }
                    </div>
                    <input class="k-input" @bind="r.Title" placeholder="Titel" />
                    <div class="lg-rgrid">
                        @if (r.Kind is Kinds.Cd or Kinds.Bog) { <input class="k-input" @bind="r.Artist" placeholder="@(r.Kind == Kinds.Cd ? "Kunstner" : "Forfatter")" /> }
                        @if (r.Kind == Kinds.Konsolspil) { <input class="k-input" @bind="r.Platform" placeholder="Konsol" /> }
                        <input class="k-input" @bind="r.Series" placeholder="Serie / blad" />
                        <input class="k-input lg-short" @bind="r.Number" placeholder="Nr." />
                        <input class="k-input lg-short" @bind="r.Year" placeholder="År" type="number" />
                        <select class="k-input" @bind="r.Condition">
                            @foreach (var c in Conditions.All) { <option value="@c">@c</option> }
                        </select>
                        <input class="k-input lg-short" @bind="r.Quantity" type="number" min="1" title="Antal" />
                    </div>
                    <textarea class="k-input lg-interest" @bind="r.Interest" rows="2" placeholder="Det interessante ved den …"></textarea>
                    @if (r.Note != "") { <p class="k-small k-muted">@r.Note</p> }
                </div>
            }
        </div>
        <div class="lg-row">
            <button class="k-btn k-btn-primary lg-big" @onclick="Save" disabled="@_busy">✓ Gem i kasse @_box?.Code</button>
            <button class="k-btn k-btn-ghost" @onclick="() => _review.Clear()">Kassér</button>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "kasse")] public string? BoxCode { get; set; }

    private sealed class Row
    {
        public bool Keep = true;
        public string Kind = Kinds.Andet, Title = "", Artist = "", Series = "", Number = "", Platform = "", Condition = "God", Note = "", Interest = "";
        public int? Year;
        public int Quantity = 1;
        public double Confidence = 1;
        public int PhotoId;
        public string Barcode = "";
    }

    private Box? _box;
    private List<Box> _recent = [];
    private string _newPlace = "", _hint = "";
    private string? _error, _saved;
    private bool _busy;
    private int _callsToday;
    private readonly List<Row> _review = [];
    private bool _scanning;
    private string _scanStatus = "";
    private string _lastCode = "";
    private DateTime _lastAt;
    private DotNetObjectReference<Registrer>? _ref;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _recent = await db.Boxes.OrderByDescending(b => b.Id).Take(8).ToListAsync();
        if (!string.IsNullOrEmpty(BoxCode)) _box = await db.Boxes.FirstOrDefaultAsync(b => b.Code == BoxCode);
        _callsToday = await Reader.CallsTodayAsync();
    }

    private void UseBox(Box b) { _box = b; _saved = null; }

    private async Task NewBox()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _box = await Store.NewBoxAsync(db, _newPlace);
        _newPlace = "";
        _saved = $"Kasse {_box.Code} er oprettet. Print dens label under Kasser.";
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        if (_box is null) return;
        _busy = true; _error = null; _saved = null;
        StateHasChanged();
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                byte[] jpeg;
                await using (var s = file.OpenReadStream(30 * 1024 * 1024))
                    jpeg = await PileReader.ShrinkAsync(s, CancellationToken.None);

                var rel = Path.Combine("photos", DateTime.Now.ToString("yyyy-MM"), $"{DateTime.Now:ddHHmmssfff}-{_box.Code}.jpg");
                var full = Path.Combine(Program.DataDir(Config), rel);
                Directory.CreateDirectory(Path.GetDirectoryName(full)!);
                await File.WriteAllBytesAsync(full, jpeg);

                var found = await Reader.ReadAsync(jpeg, _hint, CancellationToken.None);
                await using var db = await DbFactory.CreateDbContextAsync();
                var photo = new Photo { Path = rel, BoxId = _box.Id, Found = found.Count };
                db.Photos.Add(photo);
                await db.SaveChangesAsync();

                _review.AddRange(found.Select(f => new Row
                {
                    Kind = f.Kind, Title = f.Title, Artist = f.Artist, Series = f.Series, Number = f.Number, Year = f.Year,
                    Platform = f.Platform, Condition = f.Condition, Quantity = f.Quantity, Confidence = f.Confidence,
                    Note = f.Note, Interest = f.Interest, PhotoId = photo.Id,
                }));
                if (found.Count == 0) _error = "AI'en fandt ingen ting på billedet. Tag det lidt tættere på, i godt lys.";
                else
                {
                    StateHasChanged();
                    await FillInterestAsync(_review.Where(x => x.PhotoId == photo.Id).ToList());
                }
                StateHasChanged();
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _busy = false;
            _callsToday = await Reader.CallsTodayAsync();
        }
    }

    private async Task Save()
    {
        if (_box is null) return;
        _busy = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        int added = 0, merged = 0;
        foreach (var g in _review.Where(r => r.Keep && r.Title.Trim() != "").GroupBy(r => r.PhotoId))
        {
            var (a, m) = await Store.SaveAsync(db, _box.Id, g.Key == 0 ? null : g.Key, g.Select(r => new Found(
                Kinds.Normalise(r.Kind), r.Title.Trim(), r.Artist.Trim(), r.Series.Trim(), r.Number.Trim(), r.Year,
                r.Platform.Trim(), Conditions.Normalise(r.Condition), Math.Max(1, r.Quantity), r.Confidence, r.Note, r.Interest.Trim(), r.Barcode)));
            added += a; merged += m;
        }
        _review.Clear();
        _busy = false;
        _saved = $"Gemt i {_box.Code}: {added} nye" + (merged > 0 ? $", {merged} lagt sammen med nogen, der allerede var der" : "") + ". Tag næste billede.";
    }

    private async Task StartScan()
    {
        _error = null; _saved = null;
        _scanning = true;
        _scanStatus = "Hold stregkoden foran kameraet …";
        StateHasChanged();
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("scanner.start", _ref); }
        catch (Exception ex) { _scanning = false; _error = "Kameraet kunne ikke startes: " + ex.Message; }
    }

    private async Task StopScan()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
    }

    // Called by scanner.js for each code. The same code twice within 4 s = the camera saw it again, not a second copy;
    // scanning it again later = one more copy (quantity + 1).
    [JSInvokable]
    public async Task OnBarcode(string raw)
    {
        var code = BarcodeLookup.Clean(raw);
        var again = code == _lastCode && (DateTime.Now - _lastAt).TotalSeconds < 4;
        _lastCode = code; _lastAt = DateTime.Now;
        if (!again && code.Length >= 8)
        {
            _ = JS.InvokeVoidAsync("scanner.beep");
            var same = _review.FirstOrDefault(r => r.Barcode == code);
            if (same is not null)
            {
                same.Quantity++;
                _scanStatus = $"✓ {same.Title}: nu {same.Quantity} stk.";
            }
            else
            {
                _scanStatus = $"Slår {code} op …";
                StateHasChanged();
                var f = await Barcodes.LookupAsync(code);
                _review.Insert(0, f is null
                    ? new Row { Barcode = code, Kind = BarcodeLookup.IsIsbn(code) ? Kinds.Bog : Kinds.Andet, Title = "", Confidence = 0, Note = $"Stregkode {code} – ikke fundet, skriv titlen" }
                    : new Row { Barcode = code, Kind = f.Kind, Title = f.Title, Artist = f.Artist, Year = f.Year, Platform = f.Platform, Confidence = f.Confidence, Note = f.Note });
                _scanStatus = f is null ? $"⚠ {code} ikke fundet – skriv titlen i listen" : $"✓ {f.Title}";
            }
        }
        StateHasChanged();
        if (_scanning)
        {
            await Task.Delay(1200);
            try { if (_scanning) await JS.InvokeVoidAsync("scanner.start", _ref); } catch { }
        }
    }

    private async Task WriteInterest()
    {
        var rows = _review.Where(r => r.Keep && r.Interest.Trim() == "" && r.Title.Trim() != "").Take(40).ToList();
        if (rows.Count == 0) return;
        _busy = true; _error = null;
        StateHasChanged();
        try { await FillInterestAsync(rows); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task FillInterestAsync(List<Row> rows)
    {
        rows = rows.Where(r => r.Title.Trim() != "").Take(40).ToList();
        if (rows.Count == 0) return;
        var lines = rows.Select(r => string.Join(" · ", new[] { r.Kind, r.Artist, r.Title, r.Series, r.Number, r.Year?.ToString() ?? "", r.Platform }
            .Where(x => !string.IsNullOrWhiteSpace(x)))).ToList();
        var texts = await Reader.WriteInterestAsync(lines, CancellationToken.None);
        foreach (var (idx, text) in texts) rows[idx].Interest = text;
        _callsToday = await Reader.CallsTodayAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        _ref?.Dispose();
    }
}
