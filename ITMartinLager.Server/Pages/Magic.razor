@page "/magic"
@inject MagicImportUseCases Mtg
@inject BoxUseCases Boxes

<PageTitle>Magic-kort – Bogshoppen Lager</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">🃏 Magic-kort fra MTG Scanner</h1>
    <p>Magic-kort scannes i <b>MTG Scanner</b> (magicpriser) – den finder den præcise udgave og prisen. Her henter du kortene ind på lageret med pris-forslag i kroner.</p>
    <ol class="lg-steps">
        <li>Scan kortene i MTG Scanner, og skriv <b>Bogshoppen</b> som ejer.</li>
        <li>Vælg ejeren og kassen/mappen herunder, og tryk <b>Hent til lageret</b>.</li>
        <li>Henter du igen, opdateres antal og pris – der kommer ingen dobbelte.</li>
    </ol>
    @if (!Mtg.Enabled) { <p class="lg-warn">Forbindelsen til MTG Scanner er ikke sat op (Lager__MagicKey).</p> }
    @if (_err is not null) { <p class="lg-warn" role="alert">⚠ @_err</p> }
    @if (_msg is not null) { <p class="lg-ok" role="status">✓ @_msg</p> }
</section>

@if (_owners is not null)
{
    <section class="k-card">
        <h2 class="k-card-title">Hent kort</h2>
        <div class="lg-form">
            <label>Ejer i MTG Scanner
                <select class="k-input" @bind="_owner">
                    @foreach (var o in _owners)
                    {
                        <option value="@o.Owner">@(o.Owner == "" ? "(ingen ejer)" : o.Owner) – @o.Copies kort, ca. @(MagicCards.Kr(o.Eur) ?? 0) kr</option>
                    }
                </select>
            </label>
            <label>Kasse / mappe
                <select class="k-input" @bind="_boxId">
                    <option value="0">➕ Ny kasse til Magic-kort</option>
                    @foreach (var b in _boxes) { <option value="@b.Id">@b.Code @(b.Place != "" ? "· " + b.Place : "")</option> }
                </select>
            </label>
        </div>
        <button class="k-btn k-btn-primary lg-big" @onclick="Import" disabled="@_busy">@(_busy ? "⏳ Henter …" : "⬇️ Hent til lageret")</button>
    </section>
}

@code {
    private List<MagicOwner>? _owners;
    private List<Box> _boxes = [];
    private string _owner = "";
    private int _boxId;
    private bool _busy;
    private string? _err, _msg;

    protected override async Task OnInitializedAsync()
    {
        _boxes = await Boxes.RecentAsync(30);
        if (!Mtg.Enabled) return;
        try
        {
            _owners = await Mtg.OwnersAsync();
            _owner = _owners.FirstOrDefault(o => o.Owner.Equals("Bogshoppen", StringComparison.OrdinalIgnoreCase))?.Owner ?? _owners.FirstOrDefault()?.Owner ?? "";
        }
        catch (Exception ex) { _err = ex.Message; }
    }

    private async Task Import()
    {
        _busy = true; _err = null; _msg = null;
        try
        {
            var (added, updated, box) = await Mtg.ImportAsync(_owner, _boxId);
            _boxId = box.Id;
            _boxes = await Boxes.RecentAsync(30);
            _msg = $"{added} nye og {updated} opdaterede kort i {box.Code}.";
        }
        catch (Exception ex) { _err = ex.Message; }
        finally { _busy = false; }
    }
}
