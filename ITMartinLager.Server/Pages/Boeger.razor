@page "/boeger"
@inject IDbContextFactory<LagerDb> DbFactory
@inject PileReader Reader
@inject IConfiguration Config
@inject BarcodeLookup Barcodes
@inject DbaListings Dba
@inject AbeBooksListings Abe
@inject AmazonDeListings Amazon
@inject NemosListings Nemos
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Bøger – Bogshoppen Lager</PageTitle>

@* Sorting books fast (user 2026-10-07): "take a picture of books ... and see which books are interesting - price and
   efterspørgsel". One photo of a pile -> every book gets DBA listings (supply + asking prices) and ONE AI call for the
   whole pile (price, demand, verdict). Only the good ones need to go in a box. *@
<section class="k-card">
    <h1 class="k-card-title">📚 Hvilke bøger er værd at sælge?</h1>
    <p>Læg 10-20 bøger ud med forsiden (eller ryggen) op, så titlerne kan læses, og tag ét billede lige ovenfra.
       Hver bog får en pris, efterspørgsel og en dom: <b>💰 Sælg</b> enkeltvis, <b>📦 Kasse</b> (sælges i bunke), <b>♻ Genbrug</b> – eller <b>❓ Tjek selv</b>, når AI'en ikke er sikker (så får den ingen pris).</p>
    <label class="k-btn k-btn-primary lg-big lg-camera @(_busy ? "is-busy" : "")">
        @(_busy ? "⏳ " + _status : "📷 Tag billede af bøgerne")
        <InputFile OnChange="Upload" accept="image/*" capture="environment" multiple disabled="@_busy" class="lg-hidden-file" />
    </label>
    <p class="k-small k-muted">Du kan også vælge flere billeder fra telefonen på én gang. AI-kald i dag: @_callsToday af @Reader.MaxCallsPerDay.</p>

    <p><b>Eller scan ISBN-stregkoden</b> bag på bogen – mest præcist for bøger efter ca. 1975. Bøgerne vurderes 10 ad gangen og når du trykker Færdig.</p>
    <div class="lg-row">
        <input class="k-input" @bind="_isbn" @bind:event="oninput" @onkeydown="IsbnKey" inputmode="numeric" placeholder="Eller skriv ISBN (13 cifre bag på bogen)" />
        <button class="k-btn k-btn-secondary" @onclick="AddIsbn" disabled="@(BarcodeLookup.ToIsbn13(_isbn).Length < 10)">➕ Tilføj</button>
    </div>
    @if (!_scanning)
    {
        <button class="k-btn k-btn-secondary" @onclick="StartScan">▮▯▮ Scan ISBN med kameraet (kun på https)</button>
    }
    else
    {
        <div class="lg-scan">
            <video id="scan-video" muted playsinline></video>
            <p class="lg-answer" role="status">@_scanStatus</p>
            <button class="k-btn k-btn-primary" @onclick="StopScan">✓ Færdig med at scanne</button>
        </div>
    }
    @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
    @if (_saved is not null) { <p class="lg-ok" role="status">✓ @_saved</p> }
</section>

@if (_books.Count > 0)
{
    <section class="k-card">
        <h2 class="k-card-title">@(_photoBatch ? "Billedet" : "Listen"): @_books.Count bøger · 💰 @_books.Count(b => b.Value?.Verdict == "Sælg") værd at sælge</h2>
        <p class="k-small k-muted">Bedste først. Prisen er AI'ens vurdering ud fra <b>DBA</b> (Danmark), <b>AbeBooks</b> (internationalt), <b>Amazon.de</b> og <b>Nemos Bibliotek</b> (brugte tegneserier og samlerbøger). Ingen pris uden bevis: under prisen står de annoncer, den bygger på – hvad bogen udbydes til lige nu, ikke hvad den er solgt for. Urimelige internetpriser (over 3 gange midten) vises for sig. <b>eBay solgte</b> viser hvad den faktisk er solgt for.</p>
        @if (_books.Any(b => b.Value is null && b.Title.Trim() != "") && !_busy)
        {
            <button class="k-btn k-btn-secondary" @onclick="ValuePending">💰 Vurdér de @_books.Count(b => b.Value is null && b.Title.Trim() != "") uden pris</button>
        }
        <div class="lg-review">
            @foreach (var b in Sorted())
            {
                <div class="lg-ritem lg-book is-@Css(b) @(b.Keep ? "" : "is-off")">
                    <div class="lg-rhead">
                        <label><input type="checkbox" @bind="b.Keep" /></label>
                        <span class="lg-verdict">@Badge(b)</span>
                        @if (b.Value is { Low: { } lo, High: { } hi } v)
                        {
                            <b class="lg-price">@(lo == hi ? $"{lo} kr" : $"{lo}-{hi} kr")</b>
                        }
                        @if (b.Value is { } d) { <span class="k-tag">Efterspørgsel: @d.Demand</span> }
                        @if (b.Value is { Where: not "" } w) { <span class="k-tag lg-where">Sælg på: @w.Where</span> }
                        @if (b.Confidence < 0.6) { <span class="lg-check">⚠ Tjek titlen</span> }
                    </div>
                    <div class="lg-rgrid">
                        <input class="k-input" @bind="b.Title" placeholder="Titel" />
                        <input class="k-input" @bind="b.Author" placeholder="Forfatter" />
                        <input class="k-input lg-short" @bind="b.Year" placeholder="År" type="number" />
                        <select class="k-input lg-short" @bind="b.Condition">
                            @foreach (var c in Conditions.All) { <option value="@c">@c</option> }
                        </select>
                    </div>
                    @if (b.Value is { Reason: not "" } r) { <p class="lg-int">@r.Reason</p> }
                    @if (b.Value is { Low: not null } && b.Proof().Any())
                    {
                        <div class="lg-proof">
                            <b>Bevis:</b>
                            <ul>
                                @foreach (var (src, o) in b.Proof())
                                {
                                    <li><a href="@o.Url" target="_blank" rel="noopener">@src: @o.Name – @(o.Price is { } kr ? $"{kr:0} kr" : "ingen pris")</a></li>
                                }
                            </ul>
                        </div>
                    }
                    <p class="k-small">
                        DBA: @(b.Listings?.Text ?? (b.Looking ? "slår op …" : "ukendt"))
                        <br />AbeBooks: @(b.Abe?.Text ?? (b.Looking ? "slår op …" : "ukendt"))
                        <br />Amazon.de: @(b.Amz?.Text ?? (b.Looking ? "slår op …" : "ukendt"))
                        <br />Nemos Bibliotek: @(b.Nemos?.Text ?? (b.Looking ? "slår op …" : "ukendt"))
                        @if (b.Note != "") { <br /><span class="k-muted">@b.Note</span> }
                    </p>
                    <p class="k-small lg-links">
                        Tjek:
                        <a href="@DbaListings.SearchUrl(Query(b))" target="_blank" rel="noopener">DBA</a>
                        · <a href="@AbeBooksListings.SearchUrl(Query(b))" target="_blank" rel="noopener">AbeBooks</a>
                        · <a href="@NemosListings.SearchUrl(b.Title)" target="_blank" rel="noopener">Nemos</a>
                        · <a href="@($"https://www.ebay.com/sch/i.html?_nkw={Uri.EscapeDataString(Query(b))}&LH_Sold=1&LH_Complete=1")" target="_blank" rel="noopener">eBay solgte</a>
                        · <a href="@AmazonDeListings.SearchUrl(b.Barcode != "" ? b.Barcode : Query(b))" target="_blank" rel="noopener">Amazon.de</a>
                        · <a href="@($"https://www.antikvariat.net/da/actions/biblio-search/default/search?author={Uri.EscapeDataString(b.Author)}&title={Uri.EscapeDataString(b.Title)}&currency=DKK")" target="_blank" rel="noopener">antikvariat.net</a>
                        · <a href="@($"https://bogbasen.dk/search?forfatter={Uri.EscapeDataString(b.Author)}&titel={Uri.EscapeDataString(b.Title)}")" target="_blank" rel="noopener">Bogbasen</a>
                    </p>
                </div>
            }
        </div>

        <h3>Gem de afkrydsede (@_books.Count(b => b.Keep)) i en kasse</h3>
        <p class="k-small k-muted">Genbrug er ikke afkrydset fra start. Pris og grund gemmes på varen.</p>
        <div class="lg-chips">
            @foreach (var x in _recent)
            {
                <button class="k-btn @(_box?.Id == x.Id ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => _box = x">📦 @x.Code @(x.Place != "" ? "· " + x.Place : "")</button>
            }
        </div>
        <div class="lg-row">
            <input class="k-input" @bind="_newPlace" placeholder="Ny kasse – hvor står den? (fx Butikken, reol 2)" />
            <button class="k-btn k-btn-secondary" @onclick="NewBox">➕ Ny kasse</button>
        </div>
        <div class="lg-row">
            <button class="k-btn k-btn-primary lg-big" @onclick="Save" disabled="@(_busy || _box is null || !_books.Any(b => b.Keep))">✓ Gem i @(_box?.Code ?? "kasse")</button>
            <button class="k-btn k-btn-ghost" @onclick="Clear">Ryd listen (de er gemt nedenfor)</button>
        </div>
    </section>
}

<section class="k-card">
    <h2 class="k-card-title">📒 Alle tjekkede bøger (@_historyTotal)</h2>
    <p class="k-small k-muted">Hver bog, der får en vurdering, gemmes her automatisk – også dem, du ikke lægger i en kasse.
       <a href="/api/boeger.csv">⬇ Hent som regneark (CSV)</a></p>
    <input class="k-input" @bind="_hq" @bind:event="oninput" @bind:after="LoadHistory" placeholder="Søg: titel, forfatter, ISBN, Sælg, AbeBooks …" />
    <ul class="lg-list lg-history">
        @foreach (var h in _history)
        {
            <li>
                <span class="lg-verdict">@(h.Verdict switch { "Sælg" => "💰", "Kasse" => "📦", "Genbrug" => "♻", _ => "❓" })</span>
                <span class="lg-main">
                    <b>@h.Title</b>
                    <span class="k-small">@(h.Author != "" ? h.Author + " · " : "")@h.Verdict@(h.Low is { } lo ? $" · {lo}-{h.High} kr" : "")@(h.SellAt != "" ? " · sælg på " + h.SellAt : "")@(h.BoxCode != "" ? " · kasse " + h.BoxCode : "")</span>
                    @if (h.Reason != "") { <span class="k-small k-muted">@h.Reason</span> }
                </span>
                <span class="k-small k-muted">@h.CheckedAt.ToLocalTime().ToString("d/M HH:mm")</span>
            </li>
        }
    </ul>
    @if (_history.Count == 0) { <p class="k-muted">Ingen endnu.</p> }
</section>

@code {
    private sealed class Book
    {
        public bool Keep = true, Looking;
        public string Title = "", Author = "", Condition = "God", Note = "", Barcode = "";
        public int? Year;
        public int Quantity = 1, PhotoId;
        public double Confidence = 1;
        public Listings? Listings, Abe, Amz, Nemos;

        public Listings? Source(string name) => name switch
        {
            "DBA" => Listings, "AbeBooks" => Abe, "Amazon.de" => Amz, "Nemos Bibliotek" => Nemos, _ => null,
        };

        // The listings behind the price, from the sources the AI based it on.
        public IEnumerable<(string Source, Offer Offer)> Proof() =>
            (Value?.Basis ?? []).SelectMany(s => (Source(s)?.Proof ?? []).Select(o => (s, o)));
        public BookValue? Value;
        public int CheckId;
    }

    private readonly List<Book> _books = [];
    private List<Box> _recent = [];
    private Box? _box;
    private string _newPlace = "", _status = "", _scanStatus = "", _lastCode = "", _isbn = "";
    private string? _error, _saved;
    private bool _busy, _scanning, _photoBatch;
    private int _callsToday;
    private DateTime _lastAt;
    private DotNetObjectReference<Boeger>? _ref;
    private List<BookCheck> _history = [];
    private int _historyTotal;
    private string _hq = "";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _recent = await db.Boxes.OrderByDescending(b => b.Id).Take(8).ToListAsync();
        _callsToday = await Reader.CallsTodayAsync();
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _historyTotal = await db.BookChecks.CountAsync();
        var q = db.BookChecks.AsQueryable();
        foreach (var w in _hq.ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(6))
        {
            var word = w;
            q = q.Where(b => b.Search.Contains(word));
        }
        _history = await q.OrderByDescending(b => b.CheckedAt).Take(50).ToListAsync();
    }

    // Saved the moment a book has its value - a reload or a closed phone never loses a checked book.
    private async Task RememberAsync(IEnumerable<Book> books)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var saved = new List<(Book, BookCheck)>();
        foreach (var b in books.Where(b => b.Value is not null))
        {
            var c = b.CheckId != 0 ? await db.BookChecks.FindAsync(b.CheckId) : null;
            if (c is null) db.BookChecks.Add(c = new BookCheck());
            Fill(c, b);
            saved.Add((b, c));
        }
        await db.SaveChangesAsync();
        foreach (var (b, c) in saved) b.CheckId = c.Id;
        await LoadHistory();
    }

    private static void Fill(BookCheck c, Book b)
    {
        c.Title = b.Title.Trim(); c.Author = b.Author.Trim(); c.Year = b.Year; c.Condition = b.Condition; c.Isbn = b.Barcode;
        c.Quantity = b.Quantity; c.PhotoId = b.PhotoId == 0 ? null : b.PhotoId;
        c.Verdict = b.Value!.Verdict; c.Low = b.Value.Low; c.High = b.Value.High; c.Demand = b.Value.Demand;
        c.SellAt = b.Value.Where; c.Reason = b.Value.Reason;
        c.Dba = b.Listings?.Text ?? ""; c.AbeBooks = b.Abe?.Text ?? ""; c.AmazonDe = b.Amz?.Text ?? ""; c.Nemos = b.Nemos?.Text ?? "";
        c.Proof = string.Join("\n", b.Proof().Select(p => $"{p.Source}: {p.Offer.Name} – {p.Offer.Price:0} kr – {p.Offer.Url}"));
        c.CheckedAt = DateTime.UtcNow;
        c.Touch();
    }

    private static int Rank(Book b) => b.Value?.Verdict switch { "Sælg" => 0, BookValue.Unsure => 1, "Kasse" => 2, "Genbrug" => 3, _ => 4 };
    private static string Query(Book b) => DbaListings.QueryFor(b.Title, b.Author);
    private IEnumerable<Book> Sorted() => _books.OrderBy(Rank).ThenByDescending(b => b.Value?.High ?? 0);
    private static string Css(Book b) => b.Value?.Verdict switch { "Sælg" => "sell", "Kasse" => "box", "Genbrug" => "recycle", BookValue.Unsure => "unsure", _ => "new" };
    private static string Badge(Book b) => b.Value?.Verdict switch
    {
        "Sælg" => "💰 Sælg", "Kasse" => "📦 Kasse", "Genbrug" => "♻ Genbrug", BookValue.Unsure => "❓ Tjek selv",
        _ => b.Title.Trim() == "" ? "✏ Skriv titlen" : "⏳ Vurderes …",
    };

    private async Task Upload(InputFileChangeEventArgs e)
    {
        _busy = true; _error = null; _saved = null;
        // A new photo = a new pile: only the books just pictured are shown (user 2026-10-07). The earlier ones are
        // already in "Alle tjekkede bøger".
        NewBatch(fromPhoto: true);
        try
        {
            var files = e.GetMultipleFiles(20);
            for (var n = 0; n < files.Count; n++)
            {
                _status = files.Count > 1 ? $"Læser billede {n + 1} af {files.Count} …" : "Læser titlerne …";
                StateHasChanged();
                byte[] jpeg;
                await using (var s = files[n].OpenReadStream(30 * 1024 * 1024))
                    jpeg = await PileReader.ShrinkAsync(s, CancellationToken.None);

                var rel = Path.Combine("photos", DateTime.Now.ToString("yyyy-MM"), $"{DateTime.Now:ddHHmmssfff}-boeger.jpg");
                var full = Path.Combine(Program.DataDir(Config), rel);
                Directory.CreateDirectory(Path.GetDirectoryName(full)!);
                await File.WriteAllBytesAsync(full, jpeg);

                var found = await Reader.ReadAsync(jpeg, "bøger", CancellationToken.None);
                await using var db = await DbFactory.CreateDbContextAsync();
                var photo = new Photo { Path = rel, Found = found.Count };
                db.Photos.Add(photo);
                await db.SaveChangesAsync();
                if (found.Count == 0) { _error = "AI'en fandt ingen bøger på billedet. Tag det lidt tættere på, i godt lys."; continue; }

                var fresh = found.Select(f => new Book
                {
                    Title = f.Title, Author = f.Artist, Year = f.Year, Condition = f.Condition, Quantity = f.Quantity,
                    Confidence = f.Confidence, Note = f.Note, PhotoId = photo.Id,
                }).ToList();
                _books.AddRange(fresh);
                await AssessAsync(fresh);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _busy = false;
            _callsToday = await Reader.CallsTodayAsync();
        }
    }

    // DBA for every book (two at a time, cached), then ONE AI call for the lot with the DBA numbers in it.
    private async Task AssessAsync(List<Book> books)
    {
        books = books.Where(b => b.Title.Trim() != "").ToList();
        _status = $"Slår {books.Count} bøger op på DBA, AbeBooks, Amazon.de og Nemos …";
        StateHasChanged();
        await Task.WhenAll(books.Where(b => b.Listings is null).Select(LookUpAsync));

        foreach (var chunk in books.Where(b => b.Value is null).Chunk(40))
        {
            _status = $"Vurderer {chunk.Length} bøger …";
            StateHasChanged();
            var values = await Reader.ValueBooksAsync(chunk.Select(Line).ToList(), CancellationToken.None);
            for (var i = 0; i < chunk.Length; i++)
                if (values.TryGetValue(i, out var raw))
                {
                    var b = chunk[i];
                    var v = raw.Proven(s => b.Source(s)?.HasPrices == true);
                    chunk[i].Value = v;
                    if (v.Verdict == "Genbrug") chunk[i].Keep = false;
                }
            await RememberAsync(chunk);
        }
        _callsToday = await Reader.CallsTodayAsync();
        StateHasChanged();
    }

    private async Task LookUpAsync(Book b)
    {
        b.Looking = true;
        var dba = Dba.LookupAsync(b.Title, b.Author);
        var abe = Abe.LookupAsync(b.Title, b.Author);
        var amz = Amazon.LookupAsync(b.Title, b.Author, b.Barcode);
        var nemos = Nemos.LookupAsync(b.Title, b.Author);
        b.Listings = await dba;
        b.Abe = await abe;
        b.Amz = await amz;
        b.Nemos = await nemos;
        b.Looking = false;
        await InvokeAsync(StateHasChanged);
    }

    private static string Line(Book b)
    {
        var parts = new List<string> { b.Author, b.Title, b.Year?.ToString() ?? "", "stand: " + b.Condition }.Where(x => x.Trim() != "").ToList();
        if (b.Barcode != "") parts.Add("ISBN " + b.Barcode);
        parts.Add("DBA: " + (b.Listings?.Text ?? "ukendt"));
        parts.Add("AbeBooks: " + (b.Abe?.Text ?? "ukendt"));
        parts.Add("Amazon.de: " + (b.Amz?.Text ?? "ukendt"));
        parts.Add("Nemos Bibliotek: " + (b.Nemos?.Text ?? "ukendt"));
        return string.Join(" · ", parts);
    }

    private async Task ValuePending()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try { await AssessAsync(_books.Where(b => b.Value is null).ToList()); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task StartScan()
    {
        _error = null; _saved = null;
        _scanning = true;
        _scanStatus = "Hold ISBN-stregkoden foran kameraet …";
        StateHasChanged();
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("scanner.start", _ref); }
        catch (Exception ex) { _scanning = false; _error = "Kameraet kunne ikke startes: " + ex.Message; }
    }

    private async Task StopScan()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        await ValuePending();
    }

    // Called by scanner.js for each code. The same code twice within 4 s = the camera saw it again, not a second copy.
    [JSInvokable]
    public async Task OnBarcode(string raw)
    {
        var code = BarcodeLookup.Clean(raw);
        var again = code == _lastCode && (DateTime.Now - _lastAt).TotalSeconds < 4;
        _lastCode = code; _lastAt = DateTime.Now;
        if (!again && code.Length >= 8)
        {
            _ = JS.InvokeVoidAsync("scanner.beep");
            if (_photoBatch) NewBatch(fromPhoto: false);
            var same = _books.FirstOrDefault(b => b.Barcode == code);
            if (same is not null)
            {
                same.Quantity++;
                _scanStatus = $"✓ {same.Title}: nu {same.Quantity} stk.";
            }
            else
            {
                _scanStatus = $"Slår {code} op …";
                StateHasChanged();
                var f = await Barcodes.LookupAsync(code);
                var b = f is null
                    ? new Book { Barcode = code, Confidence = 0, Note = $"ISBN {code} ikke fundet – skriv titlen" }
                    : new Book { Barcode = code, Title = f.Title, Author = f.Artist, Year = f.Year, Confidence = f.Confidence, Note = f.Note };
                _books.Insert(0, b);
                _scanStatus = f is null ? $"⚠ {code} ikke fundet – skriv titlen i listen" : $"✓ {f.Title}";
                if (f is not null) _ = LookUpAsync(b);
                // Value scanned books ten at a time - one AI call per ten, never one per book.
                if (_books.Count(x => x.Value is null && x.Title.Trim() != "") >= 10)
                    _ = InvokeAsync(ValuePending);
            }
        }
        StateHasChanged();
        if (_scanning)
        {
            await Task.Delay(1200);
            try { if (_scanning) await JS.InvokeVoidAsync("scanner.start", _ref); } catch { }
        }
    }

    private async Task NewBox()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _box = await Store.NewBoxAsync(db, _newPlace);
        _recent.Insert(0, _box);
        _newPlace = "";
    }

    private async Task Save()
    {
        if (_box is null) return;
        _busy = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        int added = 0, merged = 0;
        foreach (var g in _books.Where(b => b.Keep && b.Title.Trim() != "").GroupBy(b => b.PhotoId))
        {
            var (a, m) = await Store.SaveAsync(db, _box.Id, g.Key == 0 ? null : g.Key, g.Select(b => new Found(
                Kinds.Bog, b.Title.Trim(), b.Author.Trim(), "", "", b.Year, "", Conditions.Normalise(b.Condition),
                Math.Max(1, b.Quantity), b.Confidence, SaveNote(b), "", b.Barcode,
                b.Value is { Low: { } lo, High: { } hi } ? (lo + hi) / 2m : null)));
            added += a; merged += m;
        }
        await RememberAsync(_books);   // corrections made after the valuation go into the record too
        var kept = _books.Where(b => b.Keep && b.CheckId != 0).Select(b => b.CheckId).ToList();
        if (kept.Count > 0)
            await db.BookChecks.Where(c => kept.Contains(c.Id)).ExecuteUpdateAsync(u => u.SetProperty(c => c.BoxCode, _box.Code));
        var left = _books.Count(b => !b.Keep);
        _books.Clear();
        _busy = false;
        await LoadHistory();
        _saved = $"Gemt i {_box.Code}: {added} nye" + (merged > 0 ? $", {merged} lagt sammen med nogen, der allerede var der" : "")
            + (left > 0 ? $". {left} ikke gemt." : ".") + " Tag næste billede.";
    }

    private static string SaveNote(Book b)
    {
        var parts = new List<string>();
        if (b.Value is { Where: not "" } wh) parts.Add($"Sælg på {wh.Where}");
        if (b.Value is { } v) parts.Add($"{v.Verdict}" + (v.Low is { } lo ? $" · {lo}-{v.High} kr" : "") + $" · efterspørgsel {v.Demand} · {v.Reason}");
        if (b.Listings is { Count: > 0 } l) parts.Add($"DBA {DateTime.Now:d/M}: {l.Text}");
        if (b.Abe is { Count: > 0 } a) parts.Add($"AbeBooks {DateTime.Now:d/M}: {a.Text}");
        if (b.Amz is { Count: > 0 } z) parts.Add($"Amazon.de {DateTime.Now:d/M}: {z.Text}");
        if (b.Note != "") parts.Add(b.Note);
        return string.Join(" | ", parts);
    }

    private async Task IsbnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await AddIsbn(); }

    private async Task AddIsbn()
    {
        var code = BarcodeLookup.ToIsbn13(_isbn);
        if (code.Length < 10) return;
        _isbn = "";
        _lastCode = "";
        await OnBarcode(code);
        await ValuePending();   // typed one at a time = answer now, not after ten
    }

    // Valued books are saved already; books still without a value (no title yet) are kept, so nothing typed is lost.
    // ISBNs typed or scanned one after another build up one list - the first one after a photo starts a new one.
    private void NewBatch(bool fromPhoto)
    {
        if (fromPhoto || _photoBatch) _books.RemoveAll(b => b.Value is not null);
        _photoBatch = fromPhoto;
    }

    // Clearing the list never deletes the record - it is already in "Alle tjekkede bøger".
    private void Clear() { _books.Clear(); _saved = null; _error = null; }

    public async ValueTask DisposeAsync()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        _ref?.Dispose();
    }
}
