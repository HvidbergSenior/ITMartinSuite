@page "/boeger"
@inject BookCheckUseCases Checks
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Bøger – Bogshoppen Lager</PageTitle>

@* Sorting books fast (user 2026-10-07): "take a picture of books ... and see which books are interesting - price and
   efterspørgsel". One photo of a pile -> every book gets DBA listings (supply + asking prices) and ONE AI call for the
   whole pile (price, demand, verdict). Only the good ones need to go in a box. *@
<section class="k-card">
    <h1 class="k-card-title">📚 Hvilke bøger er værd at sælge?</h1>
    <p>Læg 10-20 bøger ud med forsiden (eller ryggen) op, så titlerne kan læses, og tag ét billede lige ovenfra.
       Hver bog får en pris, efterspørgsel og en dom: <b>💰 Sælg</b> enkeltvis, <b>📦 Kasse</b> (sælges i bunke), <b>♻ Genbrug</b> – eller <b>❓ Tjek selv</b>, når AI'en ikke er sikker (så får den ingen pris).</p>
    <label class="k-btn k-btn-primary lg-big lg-camera @(_busy ? "is-busy" : "")">
        @(_busy ? "⏳ " + _status : "📷 Tag billede af bøgerne")
        <InputFile OnChange="Upload" accept="image/*" capture="environment" multiple disabled="@_busy" class="lg-hidden-file" />
    </label>
    <p class="k-small k-muted">Du kan også vælge flere billeder fra telefonen på én gang. AI-kald til vurdering i dag: @_callsToday af @Checks.MaxCallsPerDay. Titlerne læses af Vareinfo.</p>

    <p><b>Eller scan ISBN-stregkoden</b> bag på bogen – mest præcist for bøger efter ca. 1975. Bøgerne vurderes 10 ad gangen og når du trykker Færdig.</p>
    <div class="lg-row">
        <input class="k-input" @bind="_isbn" @bind:event="oninput" @onkeydown="IsbnKey" inputmode="numeric" placeholder="Eller skriv ISBN (13 cifre bag på bogen)" />
        <button class="k-btn k-btn-secondary" @onclick="AddIsbn" disabled="@(Barcodes.ToIsbn13(_isbn).Length < 10)">➕ Tilføj</button>
    </div>
    @if (!_scanning)
    {
        <button class="k-btn k-btn-secondary" @onclick="StartScan">▮▯▮ Scan ISBN med kameraet (kun på https)</button>
    }
    else
    {
        <div class="lg-scan">
            <video id="scan-video" muted playsinline></video>
            <p class="lg-answer" role="status">@_scanStatus</p>
            <button class="k-btn k-btn-primary" @onclick="StopScan">✓ Færdig med at scanne</button>
        </div>
    }
    @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
    @if (_saved is not null) { <p class="lg-ok" role="status">✓ @_saved</p> }
</section>

@if (_books.Count > 0)
{
    <section class="k-card">
        <h2 class="k-card-title">@(_photoBatch ? "Billedet" : "Listen"): @_books.Count bøger · 💰 @_books.Count(b => b.Value?.Verdict == "Sælg") værd at sælge</h2>
        <p class="k-small k-muted">Bedste først. Prisen er AI'ens vurdering ud fra <b>DBA</b> (Danmark), <b>AbeBooks</b> (internationalt), <b>Bokbörsen</b> (Sverige/Norden), <b>Nemos Bibliotek</b> og <b>Faraos</b> (brugte tegneserier og samlerbøger). Ingen pris uden bevis: under prisen står de annoncer, den bygger på – hvad bogen udbydes til lige nu, ikke hvad den er solgt for. Urimelige internetpriser (over 3 gange midten) vises for sig. <b>eBay solgte</b> viser hvad den faktisk er solgt for.</p>
        @if (_books.Any(b => b.Value is null && b.Title.Trim() != "") && !_busy)
        {
            <button class="k-btn k-btn-secondary" @onclick="ValuePending">💰 Vurdér de @_books.Count(b => b.Value is null && b.Title.Trim() != "") uden pris</button>
        }
        <div class="lg-review">
            @foreach (var b in Sorted())
            {
                <div class="lg-ritem lg-book is-@Css(b) @(b.Keep ? "" : "is-off")">
                    <div class="lg-rhead">
                        <label><input type="checkbox" @bind="b.Keep" /></label>
                        <span class="lg-verdict">@Badge(b)</span>
                        @if (b.Value is { Low: { } lo, High: { } hi } v)
                        {
                            <b class="lg-price">@(lo == hi ? $"{lo} kr" : $"{lo}-{hi} kr")</b>
                        }
                        @if (b.Value is { } d) { <span class="k-tag">Efterspørgsel: @d.Demand</span> }
                        @if (b.ShopPrice() is { } sp) { <span class="k-tag lg-where">Vores pris: @sp kr</span> }
                        @if (b.Confidence < 0.6) { <span class="lg-check">⚠ Tjek titlen</span> }
                    </div>
                    <div class="lg-rgrid">
                        <input class="k-input" @bind="b.Title" placeholder="Titel" />
                        <input class="k-input" @bind="b.Author" placeholder="Forfatter" />
                        <input class="k-input lg-short" @bind="b.Year" placeholder="År" type="number" />
                        <select class="k-input lg-short" @bind="b.Condition">
                            @foreach (var c in Conditions.All) { <option value="@c">@c</option> }
                        </select>
                    </div>
                    @if (b.Value is { Reason: not "" } r) { <p class="lg-int">@r.Reason</p> }
                    @if (b.Value is { Low: not null } && b.Proof().Any())
                    {
                        <div class="lg-proof">
                            <b>Bevis:</b>
                            <ul>
                                @foreach (var (src, o) in b.Proof())
                                {
                                    <li><a href="@o.Url" target="_blank" rel="noopener">@src: @o.Name – @(o.Price is { } kr ? $"{kr:0} kr" : "ingen pris")</a></li>
                                }
                            </ul>
                        </div>
                    }
                    <p class="k-small">
                        @foreach (var site in BookCheckUseCases.Sites)
                        {
                            @site@(": ")@(b.Site(site)?.Text ?? (b.Looking ? "slår op …" : "ukendt"))<br />
                        }
                        @if (b.Note != "") { <br /><span class="k-muted">@b.Note</span> }
                    </p>
                    <p class="k-small lg-links">
                        Tjek:
                        @foreach (var (name, url) in Checks.Links(b))
                        {
                            <a href="@url" target="_blank" rel="noopener">@name</a>@(" ")
                        }
                    </p>
                </div>
            }
        </div>

        <h3>Gem de afkrydsede (@_books.Count(b => b.Keep)) på lager</h3>
        <p class="k-small k-muted">Genbrug er ikke afkrydset fra start. Pris og grund gemmes på varen. Ingen kasse at vælge – den kan sættes på varen senere, hvis du vil.</p>
        <div class="lg-row">
            <button class="k-btn k-btn-primary lg-big" @onclick="Save" disabled="@(_busy || !_books.Any(b => b.Keep))">✓ Gem på lager</button>
            <button class="k-btn k-btn-ghost" @onclick="Clear">Ryd listen (de er gemt nedenfor)</button>
        </div>
    </section>
}

<section class="k-card">
    <h2 class="k-card-title">📒 Alle tjekkede bøger (@_historyTotal)</h2>
    <p class="k-small k-muted">Hver bog, der får en vurdering, gemmes her automatisk – også dem, du ikke lægger i en kasse.
       <a href="/api/boeger.csv">⬇ Hent som regneark (CSV)</a></p>
    <input class="k-input" @bind="_hq" @bind:event="oninput" @bind:after="LoadHistory" placeholder="Søg: titel, forfatter, ISBN, Sælg, AbeBooks …" />
    <ul class="lg-list lg-history">
        @foreach (var h in _history)
        {
            <li>
                <span class="lg-verdict">@(h.Verdict switch { "Sælg" => "💰", "Kasse" => "📦", "Genbrug" => "♻", _ => "❓" })</span>
                <span class="lg-main">
                    <b>@h.Title</b>
                    <span class="k-small">@(h.Author != "" ? h.Author + " · " : "")@h.Verdict@(h.Low is { } lo ? $" · {lo}-{h.High} kr" : "")@(h.SellAt != "" ? " · sælg på " + h.SellAt : "")@(h.BoxCode == "på lager" ? " · gemt på lager" : h.BoxCode != "" ? " · kasse " + h.BoxCode : "")</span>
                    @if (h.Reason != "") { <span class="k-small k-muted">@h.Reason</span> }
                </span>
                <span class="k-small k-muted">@h.CheckedAt.ToLocalTime().ToString("d/M HH:mm")</span>
            </li>
        }
    </ul>
    @if (_history.Count == 0) { <p class="k-muted">Ingen endnu.</p> }
</section>

@code {
    private readonly List<CheckedBook> _books = [];
    private string _status = "", _scanStatus = "", _lastCode = "", _isbn = "";
    private string? _error, _saved;
    private bool _busy, _scanning, _photoBatch;
    private int _callsToday;
    private DateTime _lastAt;
    private DotNetObjectReference<Boeger>? _ref;
    private List<BookCheck> _history = [];
    private int _historyTotal;
    private string _hq = "";

    protected override async Task OnInitializedAsync()
    {
        _callsToday = await Checks.CallsTodayAsync();
        await LoadHistory();
    }

    private async Task LoadHistory() => (_history, _historyTotal) = await Checks.HistoryAsync(_hq);

    private IEnumerable<CheckedBook> Sorted() => _books.OrderBy(b => b.Rank).ThenByDescending(b => b.Value?.High ?? 0);
    private static string Css(CheckedBook b) => b.Value?.Verdict switch { "Sælg" => "sell", "Kasse" => "box", "Genbrug" => "recycle", BookValue.Unsure => "unsure", _ => "new" };
    private static string Badge(CheckedBook b) => b.Value?.Verdict switch
    {
        "Sælg" => "💰 Sælg", "Kasse" => "📦 Kasse", "Genbrug" => "♻ Genbrug", BookValue.Unsure => "❓ Tjek selv",
        _ => b.Title.Trim() == "" ? "✏ Skriv titlen" : "⏳ Vurderes …",
    };

    private async Task Upload(InputFileChangeEventArgs e)
    {
        _busy = true; _error = null; _saved = null;
        // A new photo = a new pile: only the books just pictured are shown (user 2026-10-07). The earlier ones are
        // already in "Alle tjekkede bøger".
        NewBatch(fromPhoto: true);
        try
        {
            var files = e.GetMultipleFiles(20);
            for (var n = 0; n < files.Count; n++)
            {
                _status = files.Count > 1 ? $"Læser billede {n + 1} af {files.Count} …" : "Læser titlerne …";
                StateHasChanged();
                List<Found> found;
                await using (var s = files[n].OpenReadStream(30 * 1024 * 1024))
                    found = await Checks.ReadPileAsync(s);
                if (found.Count == 0) { _error = "AI'en fandt ingen bøger på billedet. Tag det lidt tættere på, i godt lys."; continue; }

                var fresh = found.Select(f => CheckedBook.From(f)).ToList();
                _books.AddRange(fresh);
                await AssessAsync(fresh);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _busy = false;
            _callsToday = await Checks.CallsTodayAsync();
        }
    }

    // The sites for every book, then ONE AI call per 40 books with the sites' numbers in it.
    private async Task AssessAsync(List<CheckedBook> books)
    {
        books = books.Where(b => b.Title.Trim() != "").ToList();
        _status = $"Slår {books.Count} bøger op på {string.Join(", ", BookCheckUseCases.Sites)} (højst {BookCheckUseCases.LookUpLimit.TotalSeconds:0} sek.) …";
        StateHasChanged();
        using (var deadline = new CancellationTokenSource(BookCheckUseCases.LookUpLimit))
            await Task.WhenAll(books.Where(b => !b.Asked).Select(b => LookUpAsync(b, deadline.Token)));
        _status = $"Vurderer {books.Count(b => b.Value is null)} bøger …";
        StateHasChanged();
        await Checks.ValueAsync(books);
        await LoadHistory();
        _callsToday = await Checks.CallsTodayAsync();
        StateHasChanged();
    }

    private async Task LookUpAsync(CheckedBook b, CancellationToken ct)
    {
        await Checks.LookUpAsync(b, ct);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ValuePending()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try { await AssessAsync(_books.Where(b => b.Value is null).ToList()); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task StartScan()
    {
        _error = null; _saved = null;
        _scanning = true;
        _scanStatus = "Hold ISBN-stregkoden foran kameraet …";
        StateHasChanged();
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("scanner.start", _ref); }
        catch (Exception ex) { _scanning = false; _error = "Kameraet kunne ikke startes: " + ex.Message; }
    }

    private async Task StopScan()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        await ValuePending();
    }

    // Called by scanner.js for each code. The same code twice within 4 s = the camera saw it again, not a second copy.
    [JSInvokable]
    public async Task OnBarcode(string raw)
    {
        var code = Barcodes.Clean(raw);
        var again = code == _lastCode && (DateTime.Now - _lastAt).TotalSeconds < 4;
        _lastCode = code; _lastAt = DateTime.Now;
        if (!again && code.Length >= 8)
        {
            _ = JS.InvokeVoidAsync("scanner.beep");
            if (_photoBatch) NewBatch(fromPhoto: false);
            var same = _books.FirstOrDefault(b => b.Barcode == code);
            if (same is not null)
            {
                same.Quantity++;
                _scanStatus = $"✓ {same.Title}: nu {same.Quantity} stk.";
            }
            else
            {
                _scanStatus = $"Slår {code} op …";
                StateHasChanged();
                var f = await Checks.LookupBarcodeAsync(code);
                var b = f is null
                    ? new CheckedBook { Barcode = code, Confidence = 0, Note = $"ISBN {code} ikke fundet – skriv titlen" }
                    : new CheckedBook { Barcode = code, Title = f.Title, Author = f.Artist, Year = f.Year, Confidence = f.Confidence, Note = f.Note };
                _books.Insert(0, b);
                _scanStatus = f is null ? $"⚠ {code} ikke fundet – skriv titlen i listen" : $"✓ {f.Title}";
                if (f is not null) _ = LookUpAsync(b, new CancellationTokenSource(BookCheckUseCases.LookUpLimit).Token);
                // Value scanned books ten at a time - one AI call per ten, never one per book.
                if (_books.Count(x => x.Value is null && x.Title.Trim() != "") >= 10)
                    _ = InvokeAsync(ValuePending);
            }
        }
        StateHasChanged();
        if (_scanning)
        {
            await Task.Delay(1200);
            try { if (_scanning) await JS.InvokeVoidAsync("scanner.start", _ref); } catch { }
        }
    }

    private async Task Save()
    {
        _busy = true;
        try
        {
            var (added, merged) = await Checks.SaveInBoxAsync(null, _books);
            var left = _books.Count(b => !b.Keep);
            _books.Clear();
            await LoadHistory();
            _saved = $"Gemt på lager: {added} nye" + (merged > 0 ? $", {merged} lagt sammen med nogen, der allerede var der" : "")
                + (left > 0 ? $". {left} ikke gemt." : ".") + " Tag næste billede.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task IsbnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await AddIsbn(); }

    private async Task AddIsbn()
    {
        var code = Barcodes.ToIsbn13(_isbn);
        if (code.Length < 10) return;
        _isbn = "";
        _lastCode = "";
        await OnBarcode(code);
        await ValuePending();   // typed one at a time = answer now, not after ten
    }

    // Valued books are saved already; books still without a value (no title yet) are kept, so nothing typed is lost.
    // ISBNs typed or scanned one after another build up one list - the first one after a photo starts a new one.
    private void NewBatch(bool fromPhoto)
    {
        if (fromPhoto || _photoBatch) _books.RemoveAll(b => b.Value is not null);
        _photoBatch = fromPhoto;
    }

    // Clearing the list never deletes the record - it is already in "Alle tjekkede bøger".
    private void Clear() { _books.Clear(); _saved = null; _error = null; }

    public async ValueTask DisposeAsync()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        _ref?.Dispose();
    }
}
