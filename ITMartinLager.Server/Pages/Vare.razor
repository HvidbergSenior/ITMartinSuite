@page "/vare/{Id:int}"
@inject ItemUseCases Items
@inject NavigationManager Nav
@inject AuctionUseCases Auction
@inject VareinfoLinks Vareinfo

<PageTitle>Vare – Bogshoppen Lager</PageTitle>

@if (_item is null)
{
    <section class="k-card"><h1 class="k-card-title">Varen findes ikke</h1><p><a href="/">← Søg</a></p></section>
}
else
{
    @* User 2026-11-15 "only relevant stuff": the picture, what it is, the fields that fit its kind, Gem. Prices and selling are
       folded at the bottom until Vurdering and Salg have them. *@
    <section class="k-card">
        <h1 class="k-card-title">@Kinds.Icon(_item.Kind) @_item.Line()</h1>
        @if (_item.ItemPhoto != "") { <a href="/varefoto/@_item.Id?v=@_photoVer" target="_blank" rel="noopener" title="Se billedet i fuld størrelse"><img class="lg-photo" src="/varefoto/@_item.Id?v=@_photoVer" alt="Billede af varen" /></a> }
        <label class="k-btn k-btn-secondary lg-camera">
            @(_busy ? "⏳ Gemmer …" : _item.ItemPhoto == "" ? "📷 Tag billede af varen" : "📷 Tag nyt billede")
            <InputFile OnChange="SavePhoto" accept="image/*" capture="environment" disabled="@_busy" class="lg-hidden-file" />
        </label>

        <p>Ligger i <a href="/kasse/@_box"><b>@(_boxLabel ?? "ingen kasse")</b></a> · @(_item.Quantity > 1 ? "flere stk." : "1 stk.") · <b>@_item.Status</b>@(_item.SoldPrice is { } sp ? $" for {sp:0} kr" : "")@(_item.SoldTo != "" ? $" til {_item.SoldTo}" : "")</p>
        @if (_others.Count > 0)
        {
            <p class="lg-ok" role="status"><b>Vi har flere:</b>
                @foreach (var o in _others)
                {
                    <a class="k-btn k-btn-sm k-btn-secondary" href="/vare/@o.Id">@(o.Box is { } ob ? ob.Label : "Uden kasse")@(o.Condition != _item.Condition ? $" · {o.Condition}" : "")</a>
                }
            </p>
        }
        @if (_item.Confidence < 0.6) { <p class="lg-check">⚠ AI'en var usikker på denne – tjek den mod billedet.</p> }
        @if (Fixing) { <p class="k-small"><a href="/">Stop – tilbage til Søg</a></p> }

        <label class="lg-interest-label">✨ Det interessante <textarea class="k-input lg-interest" rows="3" @bind="_item.Interest" placeholder="Hvad gør netop den her spændende for en samler?"></textarea></label>
        <div class="lg-form">
            <label>Type <select class="k-input" @bind="_item.Kind">@foreach (var k in Kinds.All) { <option value="@k">@k</option> }</select></label>
            @if (Has(ItemFields.Title)) { <label>Titel <input class="k-input" @bind="_item.Title" /></label> }
            @if (Has(ItemFields.Artist)) { <label>@ItemFields.ArtistLabel(_item.Kind) <input class="k-input" @bind="_item.Artist" /></label> }
            @if (Has(ItemFields.Series)) { <label>@(_item.Kind == Kinds.Magic ? "Sæt" : "Serie / blad") <input class="k-input" @bind="_item.Series" /></label> }
            @if (Has(ItemFields.Number)) { <label>Nummer <input class="k-input" @bind="_item.Number" /></label> }
            @if (Has(ItemFields.Year)) { <label>År <input class="k-input" type="number" @bind="_item.Year" /></label> }
            @if (Has(ItemFields.Barcode)) { <label>@(_item.Kind == Kinds.Bog ? "ISBN" : "Stregkode") <input class="k-input" inputmode="numeric" @bind="_item.Barcode" placeholder="@(_item.Kind == Kinds.Bog ? "978…" : "")" /></label> }
            @if (Has(ItemFields.EditionHint)) { <label>Omslaget siger <select class="k-input" @bind="_item.EditionHint">@foreach (var h in EditionHints.All) { <option value="@h">@(h == "" ? "(intet)" : h)</option> }</select></label> }
            @if (Has(ItemFields.Edition)) { <label>Udgave / oplag <input class="k-input" @bind="_item.Edition" placeholder="1. udgave, 1. oplag" /></label> }
            @if (Has(ItemFields.Publisher)) { <label>Forlag <input class="k-input" @bind="_item.Publisher" /></label> }
            @if (Has(ItemFields.Platform)) { <label>Konsol <input class="k-input" @bind="_item.Platform" /></label> }
            <label>Ny eller brugt <select class="k-input" @bind="_item.Usage">@foreach (var u in Usages.All) { <option value="@u">@u</option> }</select></label>
            <label>Stand <select class="k-input" @bind="_item.Condition">@foreach (var c in Conditions.All) { <option value="@c">@c</option> }</select></label>
            <label>Antal <input class="k-input" type="number" min="0" @bind="_item.Quantity" /></label>
            @if (Admin)
            {
                <label>Status <select class="k-input" @bind="_item.Status">@foreach (var s in Statuses.All) { <option value="@s">@s</option> }</select></label>
            }
            <label>Note <input class="k-input" @bind="_item.Note" /></label>
        </div>
        <div class="lg-row">
            @if (Fixing)
            {
                <button class="k-btn k-btn-primary" @onclick="SaveAndNext">Gem og næste</button>
                <button class="k-btn k-btn-secondary" @onclick="Skip">Spring over</button>
            }
            else
            {
                <button class="k-btn k-btn-primary" @onclick="Save">Gem</button>
            }
            @if (Admin) { <button class="k-btn k-btn-ghost" @onclick="Delete">🗑️ Slet</button> }
        </div>
        @if (_msg is not null) { <p class="lg-ok" role="status">✓ @_msg</p> }
        @if (_err is not null) { <p class="lg-warn" role="alert">⚠ @_err</p> }
    </section>

    @* Prices live in Vurdering (user 2026-11-15: "pricing should be in pricing"). *@
    @if (Admin && Pricing.HuntedKinds.Contains(_item.Kind))
    {
        <p class="k-small k-muted">Prisen sættes i <a href="@VurderingUrl">Vurdering</a>@(_item.Price is { } kr ? $" – nu {kr:0} kr" : _item.PriceHint is { } h ? $" – forslag {h:0} kr" : "").</p>
    }


    @if (Admin)
    {
    <section class="k-card" data-fold-closed>
        <h2 class="k-card-title">Sælg – flytter til Salg</h2>
        <div class="lg-row">
            @if (_item.FeaturedAt is null)
            {
                <button class="k-btn k-btn-sm k-btn-secondary" @onclick="() => Feature(true)" disabled="@(_item.Status is Statuses.Solgt or Statuses.PaaAuktion)">⭐ Vis på forsiden</button>
                <span class="k-small k-muted">Så kommer den med under "Fundet i kasserne" på bogshoppen.dk og itmartin.dk – med billede, det interessante og links til andre sider.</span>
            }
            else
            {
                <span class="lg-ok">⭐ Vises på forsiden</span>
                <button class="k-btn k-btn-sm k-btn-ghost" @onclick="() => Feature(false)">Tag den af forsiden</button>
            }
        </div>
        <h3>Sæt på auktion</h3>
        @if (_item.Status == Statuses.PaaAuktion && _item.AuctionCode != "")
        {
            <p class="lg-answer">På auktion <b>@_item.AuctionCode</b>.</p>
            <p>Når hammeren falder, opdateres varen her af sig selv (inden for 2 minutter): solgt med pris og køber – eller tilbage på lager.</p>
            <a class="k-btn k-btn-secondary" href="@Auction.PublicBase/auction/@_item.AuctionCode" target="_blank" rel="noopener">Åbn auktionen</a>
        }
        else if (_item.Status == Statuses.Solgt)
        {
            <p>Varen er solgt.</p>
        }
        else if (!Auction.Enabled)
        {
            <p>Forbindelsen til Live Auktion er ikke sat op endnu (Lager__AuctionKey).</p>
        }
        else
        {
            @if (_auctionOff is not null) { <p class="k-muted">⏸ @_auctionOff</p> }
            else if (_sessions is null) { <p class="k-muted">Henter auktioner …</p> }
            else if (_sessions.Count == 0)
            {
                <p>Der er ingen åben auktion. Opret en i <a href="@Auction.PublicBase" target="_blank" rel="noopener">Live Auktion</a>, og kom tilbage hertil.</p>
            }
            else
            {
                <div class="lg-form">
                    <label>Auktion
                        <select class="k-input" @bind="_code">
                            @foreach (var s in _sessions)
                            {
                                <option value="@s.Code">@s.Name (@s.Code)@(s.AuctionDate is { } d ? $" – {d:d/M}" : "") · @s.Items varer</option>
                            }
                        </select>
                    </label>
                    <label>Startpris (kr) <input class="k-input" type="number" min="0" step="5" @bind="_start" /></label>
                    <label>Antal i loddet <input class="k-input" type="number" min="1" max="@_item.Quantity" @bind="_lot" /></label>
                </div>
                @if (_item.ItemPhoto == "") { <p class="k-small">Tip: tag et billede af varen ovenfor først – auktioner uden billede sælger dårligere.</p> }
                <button class="k-btn k-btn-primary lg-big" @onclick="SendToAuction" disabled="@_busy">🔨 Sæt på auktion</button>
            }
        }
    </section>

    }

    @if (_item.PhotoId is { } pid)
    {
        <section class="k-card" data-fold-closed>
            <h2 class="k-card-title">🗂️ Billedet af bunken den blev registreret fra</h2>
            <img class="lg-photo" src="@Vareinfo.Photo(pid)" alt="Registreringsbillede" loading="lazy" />
        </section>
    }
}

@code {
    [CascadingParameter] public LagerUser? Me { get; set; }
    private bool Admin => Me is { IsAdmin: true };
    private static string VurderingUrl => BogshoppenFlow.Steps[BogshoppenFlow.Priser - 1].Url;
    private bool Has(string field) => _item is { } i && ItemFields.Shows(i, field);
    [Parameter] public int Id { get; set; }
    // ?ret=1 = going through "Ret de svære" one at a time (2026-11-15).
    [SupplyParameterFromQuery(Name = "ret")] public int? Ret { get; set; }
    private bool Fixing => Ret == 1;
    private Item? _item;
    private string? _box, _boxLabel, _msg, _err;
    private List<AuctionSessionInfo>? _sessions;
    private string? _auctionOff;
    private string _code = "";
    private decimal _start;
    private int _lot = 1;
    private bool _busy;
    private long _photoVer = DateTime.UtcNow.Ticks;

    protected override async Task OnParametersSetAsync()
    {
        await Load();
        if (_item is null) return;
        _start = _item.Price ?? _item.PriceHint ?? 0;
        _lot = Math.Max(1, _item.Quantity);
        if (Auction.Enabled && _item.Status != Statuses.Solgt && _item.Status != Statuses.PaaAuktion)
        {
            try
            {
                _sessions = await Auction.SessionsAsync();
                _code = _sessions.FirstOrDefault()?.Code ?? "";
            }
            catch (LagerException ex) { _auctionOff = ex.Message; }
            catch (Exception ex) { _sessions = []; _err = "Kunne ikke hente auktioner: " + ex.Message; }
        }
    }

    private List<Item> _others = [];
    private static int BoxNo(string code) => int.TryParse(code.TrimStart('K'), out var n) ? n : 0;

    private async Task Feature(bool on)
    {
        if (_item is null || !Admin) return;
        _item.FeaturedAt = (await Items.FeatureAsync(_item.Id, on)).FeaturedAt;
    }

    private async Task Load()
    {
        var view = await Items.GetAsync(Id);
        _item = view?.Item;
        _box = _item?.Box?.Code;
        _boxLabel = _item?.Box?.Label;
        _others = _item is null ? [] : await Items.OthersLikeAsync(_item);
    }

    private async Task Save()
    {
        try
        {
            await Items.SaveAsync(_item!);
            _msg = "Gemt."; _err = null;
        }
        catch (Exception ex) { _err = ex.Message; }
    }

    // Gem sets the confidence to 1 (ItemUseCases.SaveAsync), so it leaves the list; then the next difficult one, or Søg when done.
    private async Task SaveAndNext()
    {
        await Save();
        if (_err is null) await GoNext();
    }

    private Task Skip() => GoNext();

    private async Task GoNext()
    {
        var next = await Items.NextUnsureAsync(Id);
        Nav.NavigateTo(next is { } n && n != Id ? $"/vare/{n}?ret=1" : "/");
    }

    private async Task SavePhoto(InputFileChangeEventArgs e)
    {
        _busy = true; _err = null;
        try
        {
            await Save();
            await using (var s = e.File.OpenReadStream(30 * 1024 * 1024)) _item!.ItemPhoto = await Items.SavePhotoAsync(Id, s);
            _photoVer = DateTime.UtcNow.Ticks;
            _msg = "Billedet er gemt.";
        }
        catch (Exception ex) { _err = ex.Message; }
        finally { _busy = false; }
    }


    private async Task SendToAuction()
    {
        if (_item is null || _code == "") return;
        _busy = true; _err = null; _msg = null;
        try
        {
            await Save();
            var sent = await Auction.SendAsync(Id, _code, _start, _lot);
            _item.AuctionItemId = sent.AuctionItemId;
            _item.AuctionCode = sent.AuctionCode;
            _item.Status = sent.Status;
            _msg = $"Sat på auktion {_code}.";
        }
        catch (Exception ex) { _err = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Delete()
    {
        if (!Admin) return;   // helpers cannot delete (2026-10-24)
        await Items.DeleteAsync(Id);
        Nav.NavigateTo(_box is null ? "/" : $"/kasse/{_box}");
    }
}
