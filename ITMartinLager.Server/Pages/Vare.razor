@page "/vare/{Id:int}"
@inject IJSRuntime JS
@inject ItemUseCases Items
@inject ItemPhotoUseCases ItemPhotos
@inject NavigationManager Nav
@inject AuctionUseCases Auction
@inject VareinfoLinks Vareinfo

<PageTitle>Vare – Bogshoppen Lager</PageTitle>

@if (_item is null)
{
    <section class="k-card"><h1 class="k-card-title">Varen findes ikke</h1><p><a href="/">← Søg</a></p></section>
}
else
{
    @* User 2026-11-15 "only relevant stuff": the picture, what it is, the fields that fit its kind, Gem. Prices and selling are
       folded at the bottom until Vurdering and Salg have them. *@
    @* Back to the list it came from (user 2026-11-15: "I can not go back") - the list keeps its search in the address. *@
    @* One way back (user 2026-11-16: "look at all the buttons and links ... Are they all relevant"): while fixing the difficult
       ones there is no list - Stop goes to the front page; else back to the list it came from. *@
    @if (Fixing) { <p class="lg-back"><a href="/">← Stop – tilbage til forsiden</a></p> }
    else { <p class="lg-back"><a href="/" onclick="if (history.length > 1) { history.back(); return false; }">← Tilbage til listen</a></p> }
    <section class="k-card">
        @* Calm (user 2026-11-16: "i mean there are a lot of info.."): name, one line, the picture, the fields that decide what it is
           and its price - everything else under "Flere oplysninger", closed. *@
        <h1 class="k-card-title">@_item.Line()</h1>
        <p class="k-small">nr. @_item.Id · @(_boxLabel ?? "ingen kasse") · @(_item.Quantity > 1 ? $"{_item.Quantity} stk." : "1 stk.") · @_item.Status@(_item.SoldPrice is { } sp ? $" for {sp:0} kr" : "")@(_item.SoldTo != "" ? $" til {_item.SoldTo}" : "")</p>
        @if (_item.ItemPhoto != "")
        {
            @* While marking, the photo is not a link - a drag draws the box over the price sticker (maerke.js). *@
            <div class="lg-photo-wrap">
                @if (_marking || _skaev) { <img id="lg-photo" class="lg-photo" src="/varefoto/@_item.Id?v=@_photoVer" alt="Billede af varen" draggable="false" style="@(_skaev ? $"transform: rotate({_skaevDeg}deg)" : null)" /> }
                else { <a href="/varefoto/@_item.Id?v=@_photoVer" target="_blank" rel="noopener" title="Se billedet i fuld størrelse"><img class="lg-photo" src="/varefoto/@_item.Id?v=@_photoVer" alt="Billede af varen" /></a> }
                <div id="lg-mark-box" class="lg-mark-box" hidden></div>
            </div>
        }
        <label class="k-btn k-btn-sm k-btn-secondary lg-camera">
            @(_busy ? "Gemmer …" : _item.ItemPhoto == "" ? "Tag billede af varen" : "Tag nyt billede")
            <InputFile OnChange="SavePhoto" accept="image/*" capture="environment" disabled="@_busy" class="lg-hidden-file" />
        </label>
        @* Drej (user 2026-11-16: "rotation?" - it was only in Priser): a quarter clockwise each press; Fortryd in Priser. *@
        @if (_item.ItemPhoto != "")
        {
            <button class="k-btn k-btn-sm k-btn-secondary" disabled="@_busy" @onclick="Rotate" title="Drej billedet en kvart omgang med uret">Drej ↻</button>
            @* "and the farvening" (2026-11-16): Fjern prismærket here too - drag a box, Lager paints over it in the thing's own colour. *@
            @if (!_marking)
            {
                <button class="k-btn k-btn-sm k-btn-secondary" disabled="@_busy" @onclick="() => StartMark(false)">Fjern prismærket</button>
                @* "also some way to cut things off pictures" (2026-11-16): keep the part inside the box. *@
                <button class="k-btn k-btn-sm k-btn-secondary" disabled="@_busy" @onclick="() => StartMark(true)">Beskær</button>
                @if (!_skaev) { <button class="k-btn k-btn-sm k-btn-secondary" disabled="@_busy" @onclick="() => _skaev = true">Ret skævheden</button> }
                else
                {
                    @* Ret skævheden (2026-11-16): the photo turns live while sliding; Gem saves it. *@
                    <span class="lg-skaev"><span class="k-small">Skæv: <b>@_skaevDeg</b>°</span>
                        <input type="range" min="-15" max="15" step="1" @bind="_skaevDeg" @bind:event="oninput" />
                        <button class="k-btn k-btn-sm k-btn-primary" disabled="@_busy" @onclick="SaveSkaev">Gem</button>
                        <button class="k-btn k-btn-sm k-btn-ghost" @onclick="() => { _skaev = false; _skaevDeg = 0; }">Annuller</button></span>
                }
            }
            else
            {
                <span class="k-small">@(_cropping ? "Træk en firkant rundt om det, der skal blive – resten skæres væk." : "Træk en firkant hen over mærket på billedet.")</span>
                @if (_markArea is not null) { <button class="k-btn k-btn-sm k-btn-primary" disabled="@_busy" @onclick="SaveMark">@(_cropping ? "Beskær" : "Mal over mærket")</button> }
                <button class="k-btn k-btn-sm k-btn-ghost" @onclick="StopMark">Annuller</button>
            }
        }
        @if (_item.Confidence < 0.6) { <p class="lg-check">AI'en var usikker – ret det, der er forkert. Er det ikke en rigtig ting, så tryk <b>Slet</b>.</p> }

        <div class="lg-form">
            <label>Type <select class="k-input" @bind="_item.Kind">@foreach (var k in Kinds.All) { <option value="@k">@k</option> }</select></label>
            @if (Has(ItemFields.Title)) { <label>Titel <input class="k-input" @bind="_item.Title" /></label> }
            @if (Has(ItemFields.Artist)) { <label>@ItemFields.ArtistLabel(_item.Kind) <input class="k-input" @bind="_item.Artist" /></label> }
            @if (Has(ItemFields.Series)) { <label>@(_item.Kind == Kinds.Magic ? "Sæt" : "Serie / blad") <input class="k-input" @bind="_item.Series" /></label> }
            @if (Has(ItemFields.Number)) { <label>Nummer <input class="k-input" @bind="_item.Number" /></label> }
            @if (Has(ItemFields.Year)) { <label>År <input class="k-input" type="number" @bind="_item.Year" /></label> }
        </div>

        <details class="kr-more">
            <summary>Flere oplysninger</summary>
            @if (_others.Count > 0)
            {
                <p class="k-small"><b>Vi har flere:</b>
                    @foreach (var o in _others)
                    {
                        <a class="k-btn k-btn-sm k-btn-secondary" href="/vare/@o.Id">@(o.Box is { } ob ? ob.Label : "Uden kasse")@(o.Condition != _item.Condition ? $" · {o.Condition}" : "")</a>
                    }
                </p>
            }
            <div class="lg-form">
                @if (Has(ItemFields.Barcode)) { <label>@(_item.Kind == Kinds.Bog ? "ISBN" : "Stregkode") <input class="k-input" inputmode="numeric" @bind="_item.Barcode" placeholder="@(_item.Kind == Kinds.Bog ? "978…" : "")" /></label> }
                @if (Has(ItemFields.EditionHint)) { <label>Omslaget siger <select class="k-input" @bind="_item.EditionHint">@foreach (var h in EditionHints.All) { <option value="@h">@(h == "" ? "(intet)" : h)</option> }</select></label> }
                @if (Has(ItemFields.Edition)) { <label>Udgave / oplag <input class="k-input" @bind="_item.Edition" placeholder="1. udgave, 1. oplag" /></label> }
                @if (Has(ItemFields.Publisher)) { <label>Forlag <input class="k-input" @bind="_item.Publisher" /></label> }
                @if (Has(ItemFields.Platform)) { <label>Konsol <input class="k-input" @bind="_item.Platform" /></label> }
                <label>Ny eller brugt <select class="k-input" @bind="_item.Usage">@foreach (var u in Usages.All) { <option value="@u">@u</option> }</select></label>
                <label>Stand <select class="k-input" @bind="_item.Condition">@foreach (var c in Conditions.All) { <option value="@c">@c</option> }</select></label>
                <label>Antal <input class="k-input" type="number" min="0" @bind="_item.Quantity" /></label>
                @if (Admin)
                {
                    <label>Status <select class="k-input" @bind="_item.Status">@foreach (var st in Statuses.All) { <option value="@st">@st</option> }</select></label>
                }
                <label>Note <input class="k-input" @bind="_item.Note" /></label>
            </div>
            <label class="lg-interest-label">Det interessante (vises i butikken – kun hvis den er speciel for en samler) <textarea class="k-input lg-interest" rows="2" @bind="_item.Interest" placeholder="fx 1. udgave, signeret, med plakat"></textarea></label>
            <label class="lg-check"><input type="checkbox" @bind="_item.Rare" /> Sjælden – vurderes manuelt (ud af 3 kr-kassen, pris sættes i Priser)</label>
        </details>
        <div class="lg-row">
            @if (Fixing)
            {
                <button class="k-btn k-btn-primary" @onclick="SaveAndNext">Gem og næste</button>
                <button class="k-btn k-btn-secondary" @onclick="Skip">Spring over</button>
            }
            else
            {
                <button class="k-btn k-btn-primary" @onclick="Save">Gem</button>
            }
            @if (Admin) { <button class="k-btn k-btn-ghost" @onclick="Delete" title="Ud af lageret – gemmes som Ikke købt, slettes ikke">Slet</button> }
        </div>
        @if (_msg is not null) { <p class="lg-ok" role="status">✓ @_msg</p> }
        @if (_err is not null) { <p class="lg-warn" role="alert">⚠ @_err</p> }
    </section>

    @* Calm (2026-11-16): prices live in Priser, so no price line here; the auction box only for a thing marked rare - the only
       ones that go to auction (Priser's "Til auktion (i Lager)" leads here). *@
    @if (Admin && _item.Rare)
    {
    <section class="k-card" data-fold-closed>
        <h2 class="k-card-title">Til auktion</h2>
        <div class="lg-row">
            @if (_item.FeaturedAt is null)
            {
                <button class="k-btn k-btn-sm k-btn-secondary" @onclick="() => Feature(true)" disabled="@(_item.Status is Statuses.Solgt or Statuses.PaaAuktion)">⭐ Vis på forsiden</button>
                <span class="k-small k-muted">Så kommer den med under "Fundet i kasserne" på bogshoppen.dk og itmartin.dk – med billede, det interessante og links til andre sider.</span>
            }
            else
            {
                <span class="lg-ok">⭐ Vises på forsiden</span>
                <button class="k-btn k-btn-sm k-btn-ghost" @onclick="() => Feature(false)">Tag den af forsiden</button>
            }
        </div>
        <h3>Sæt på auktion</h3>
        @if (_item.Status == Statuses.PaaAuktion && _item.AuctionCode != "")
        {
            <p class="lg-answer">På auktion <b>@_item.AuctionCode</b>.</p>
            <p>Når hammeren falder, opdateres varen her af sig selv (inden for 2 minutter): solgt med pris og køber – eller tilbage på lager.</p>
            <a class="k-btn k-btn-secondary" href="@Auction.PublicBase/auction/@_item.AuctionCode" target="_blank" rel="noopener">Åbn auktionen</a>
        }
        else if (_item.Status == Statuses.Solgt)
        {
            <p>Varen er solgt.</p>
        }
        else if (!Auction.Enabled)
        {
            <p>Forbindelsen til Live Auktion er ikke sat op endnu (Lager__AuctionKey).</p>
        }
        else
        {
            @if (_auctionOff is not null) { <p class="k-muted">⏸ @_auctionOff</p> }
            else if (_sessions is null) { <p class="k-muted">Henter auktioner …</p> }
            else if (_sessions.Count == 0)
            {
                <p>Der er ingen åben auktion. Opret en i <a href="@Auction.PublicBase" target="_blank" rel="noopener">Live Auktion</a>, og kom tilbage hertil.</p>
            }
            else
            {
                <div class="lg-form">
                    <label>Auktion
                        <select class="k-input" @bind="_code">
                            @foreach (var s in _sessions)
                            {
                                <option value="@s.Code">@s.Name (@s.Code)@(s.AuctionDate is { } d ? $" – {d:d/M}" : "") · @s.Items varer</option>
                            }
                        </select>
                    </label>
                    <label>Startpris (kr) <input class="k-input" type="number" min="0" step="5" @bind="_start" /></label>
                    <label>Antal i loddet <input class="k-input" type="number" min="1" max="@_item.Quantity" @bind="_lot" /></label>
                </div>
                @if (_item.ItemPhoto == "") { <p class="k-small">Tip: tag et billede af varen ovenfor først – auktioner uden billede sælger dårligere.</p> }
                <button class="k-btn k-btn-primary lg-big" @onclick="SendToAuction" disabled="@_busy">🔨 Sæt på auktion</button>
            }
        }
    </section>

    }

    @if (_item.PhotoId is { } pid)
    {
        <section class="k-card" data-fold-closed>
            <h2 class="k-card-title">Billedet af bunken den blev læst fra</h2>
            @* Full card width + tap = full size (user 2026-11-19 "i cannot see the picture from the bottom? It is not large enough") *@
            <a href="@Vareinfo.Photo(pid)" target="_blank" rel="noopener" title="Åbn billedet i fuld størrelse">
                <img class="lg-photo lg-pile" src="@Vareinfo.Photo(pid)" alt="Registreringsbillede" loading="lazy" />
            </a>
            <a class="k-btn k-btn-sm" href="@Vareinfo.Photo(pid)" target="_blank" rel="noopener">Åbn i fuld størrelse</a>
        </section>
    }
}

@code {
    [CascadingParameter] public LagerUser? Me { get; set; }
    private bool Admin => Me is { IsAdmin: true };
    private static string VurderingUrl => BogshoppenFlow.Steps[BogshoppenFlow.Priser - 1].Url;
    private bool Has(string field) => _item is { } i && ItemFields.Shows(i, field);
    [Parameter] public int Id { get; set; }
    // ?ret=1 = going through "Ret de svære" one at a time (2026-11-15).
    [SupplyParameterFromQuery(Name = "ret")] public int? Ret { get; set; }
    private bool Fixing => Ret == 1;
    private Item? _item;
    private string? _box, _boxLabel, _msg, _err;
    private List<AuctionSessionInfo>? _sessions;
    private string? _auctionOff;
    private string _code = "";
    private decimal _start;
    private int _lot = 1;
    private bool _busy;
    private long _photoVer = DateTime.UtcNow.Ticks;

    protected override async Task OnParametersSetAsync()
    {
        await Load();
        if (_item is null) return;
        _start = _item.Price ?? _item.PriceHint ?? 0;
        _lot = Math.Max(1, _item.Quantity);
        if (Auction.Enabled && _item.Status != Statuses.Solgt && _item.Status != Statuses.PaaAuktion)
        {
            try
            {
                _sessions = await Auction.SessionsAsync();
                _code = _sessions.FirstOrDefault()?.Code ?? "";
            }
            catch (LagerException ex) { _auctionOff = ex.Message; }
            catch (Exception ex) { _sessions = []; _err = "Kunne ikke hente auktioner: " + ex.Message; }
        }
    }

    private List<Item> _others = [];
    private static int BoxNo(string code) => int.TryParse(code.TrimStart('K'), out var n) ? n : 0;

    private async Task Feature(bool on)
    {
        if (_item is null || !Admin) return;
        _item.FeaturedAt = (await Items.FeatureAsync(_item.Id, on)).FeaturedAt;
    }

    private async Task Load()
    {
        var view = await Items.GetAsync(Id);
        _item = view?.Item;
        _box = _item?.Box?.Code;
        _boxLabel = _item?.Box?.Label;
        _others = _item is null ? [] : await Items.OthersLikeAsync(_item);
    }

    private async Task Save()
    {
        try
        {
            await Items.SaveAsync(_item!);
            _msg = "Gemt."; _err = null;
        }
        catch (Exception ex) { _err = ex.Message; }
    }

    // Gem sets the confidence to 1 (ItemUseCases.SaveAsync), so it leaves the list; then the next difficult one, or Søg when done.
    private async Task SaveAndNext()
    {
        await Save();
        if (_err is null) await GoNext();
    }

    private Task Skip() => GoNext();

    private async Task GoNext()
    {
        var next = await Items.NextUnsureAsync(Id);
        Nav.NavigateTo(next is { } n && n != Id ? $"/vare/{n}?ret=1" : "/");
    }

    private async Task SavePhoto(InputFileChangeEventArgs e)
    {
        _busy = true; _err = null;
        try
        {
            await Save();
            await using (var s = e.File.OpenReadStream(30 * 1024 * 1024)) _item!.ItemPhoto = await Items.SavePhotoAsync(Id, s);
            _photoVer = DateTime.UtcNow.Ticks;
            _msg = "Billedet er gemt.";
        }
        catch (Exception ex) { _err = ex.Message; }
        finally { _busy = false; }
    }


    private async Task SendToAuction()
    {
        if (_item is null || _code == "") return;
        _busy = true; _err = null; _msg = null;
        try
        {
            await Save();
            var sent = await Auction.SendAsync(Id, _code, _start, _lot);
            _item.AuctionItemId = sent.AuctionItemId;
            _item.AuctionCode = sent.AuctionCode;
            _item.Status = sent.Status;
            _msg = $"Sat på auktion {_code}.";
        }
        catch (Exception ex) { _err = ex.Message; }
        finally { _busy = false; }
    }

    private bool _marking;
    private PhotoArea? _markArea;
    private DotNetObjectReference<Vare>? _self;

    private bool _hookMark;

    private bool _cropping, _skaev;
    private int _skaevDeg;

    private async Task SaveSkaev()
    {
        if (_skaevDeg == 0) { _skaev = false; return; }
        _busy = true; _err = null;
        try
        {
            if (await ItemPhotos.StraightenAsync(Id, _skaevDeg) is { } error) _err = error;
            else { _photoVer++; _msg = "Billedet er rettet op. Fortryd ligger i Priser."; }
        }
        finally { _busy = false; _skaev = false; _skaevDeg = 0; }
    }
    private void StartMark(bool crop) { _marking = true; _cropping = crop; _markArea = null; _hookMark = true; }

    // The photo without its link is drawn first - then the drag is hooked onto it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_hookMark) return;
        _hookMark = false;
        _self ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("lagerMaerke.start", "lg-photo", "lg-mark-box", _self);
    }

    [JSInvokable]
    public Task MarkDrawn(double l, double t, double r, double b)
    {
        _markArea = PhotoArea.From([l, t, r, b], 0.005);
        return InvokeAsync(StateHasChanged);
    }

    private async Task StopMark()
    {
        await JS.InvokeVoidAsync("lagerMaerke.stop", "lg-photo", "lg-mark-box");
        _marking = false; _markArea = null;
    }

    private async Task SaveMark()
    {
        if (_markArea is not { } area) return;
        _busy = true; _err = null;
        try
        {
            var error = _cropping ? await ItemPhotos.CropOwnAsync(Id, area) : await Items.CoverMarkAsync(Id, area);
            if (error is not null) _err = error;
            else { _photoVer++; _msg = _cropping ? "Billedet er beskåret. Fortryd ligger i Priser." : "Mærket er malet over. Fortryd ligger i Priser."; }
        }
        finally { _busy = false; await StopMark(); }
    }

    private async Task Rotate()
    {
        _busy = true; _err = null;
        try
        {
            if (await ItemPhotos.RotateAsync(Id, 90) is { } error) _err = error;
            else _photoVer++;
        }
        finally { _busy = false; }
    }

    private async Task Delete()
    {
        if (!Admin) return;   // helpers cannot delete (2026-10-24)
        // Never deleted (2026-11-16, user: "push slet ... bad navigation" - it deleted for good and jumped to the whole box of
        // ~2,300 things): out of the stock as Ikke købt like Fjern/Kassér, then back where the person came from.
        await Items.RemoveAsync(Id);
        if (Ret is not null) { await GoNext(); return; }
        await JS.InvokeVoidAsync("eval", "history.length > 1 ? history.back() : location.assign('/')");
    }
}
