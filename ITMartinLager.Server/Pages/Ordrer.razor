@page "/ordrer"
@inject ShopUseCases Shop

@* The sales after payment (user 2026-10-20: "sold, packed, in storage or something"): Betalt -> Pakket -> Sendt / Afhentet.
   The rules for what may come next are on the Order (Domain); this page only shows and asks. *@
<PageTitle>Ordrer – Bogshoppen Lager</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">🧾 Ordrer</h1>
    <p>Her står alt, der er købt med <b>Køb nu</b> på bogshoppen.dk – én ting eller en hel kurv. Når en ordre er betalt, er tingene trukket fra lageret (den sidste af en slags = Solgt).</p>
    <p>Pak ordren og tryk <b>📦 Pakket</b>. Når den er afleveret til posten, så skriv pakkens nummer og tryk <b>Sendt</b> – eller tryk <b>Afhentet</b>, når køberen har hentet den. Trykker du forkert, så tryk <b>Fortryd</b>.</p>
    @if (!Shop.CanPay)
    {
        <p class="lg-warn" role="status">⚠ Køb nu er slået fra: Stripe-nøglen (Lager__StripeSecretKey) eller fragt/afhentning (Lager__ShopShippingKr / Lager__ShopPickup) mangler i magic.env.</p>
    }
    @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
</section>

@foreach (var (title, list) in Groups())
{
    @if (list.Count > 0)
    {
        <section class="k-card" data-fold-closed="@(title.StartsWith("Ikke") || title.StartsWith("Klaret") ? "true" : null)">
            <h2 class="k-card-title">@title (@list.Count)</h2>
            <ul class="lg-list">
                @foreach (var o in list)
                {
                    <li class="lg-order">
                        <span class="lg-main">
                            <b>Ordre @o.Id · @o.Kr kr@(o.PaidKr > o.Kr ? $" + fragt = {o.PaidKr} kr" : "")</b>
                            <span class="k-small">@o.Status · @o.CreatedAt.ToLocalTime().ToString("d. MMM HH:mm")@(o.Tracking != "" ? $" · pakke {o.Tracking}" : "")</span>
                            @foreach (var l in o.Lines)
                            {
                                <span class="k-small">· <a href="/vare/@l.ItemId">@l.Line</a> – @l.Kr kr@(l.Offer != "" ? $" ({l.Offer}, normalt {l.ListKr} kr)" : "")</span>
                            }
                            @if (o.Paid)
                            {
                                <span class="k-small"><b>@o.Delivery</b> · @o.Name · @o.Email · @o.Phone</span>
                                @if (o.Address != "") { <span class="k-small">@o.Address</span> }
                            }
                        </span>
                        @if (o.Status == OrderStatuses.Paid)
                        {
                            <button class="k-btn k-btn-sm k-btn-primary" @onclick="() => Step(() => Shop.PackAsync(o.Id))">📦 Pakket</button>
                        }
                        @if (o.Status is OrderStatuses.Paid or OrderStatuses.Packed)
                        {
                            @if (o.Delivery.StartsWith("Afhent"))
                            {
                                <button class="k-btn k-btn-sm k-btn-secondary" @onclick="() => Step(() => Shop.PickedUpAsync(o.Id))">✓ Afhentet</button>
                            }
                            else
                            {
                                <input class="k-input" placeholder="Pakkens nummer" @bind="_tracking[o.Id]" aria-label="Pakkens nummer for ordre @o.Id" />
                                <button class="k-btn k-btn-sm k-btn-secondary" @onclick="() => Send(o.Id)">✓ Sendt</button>
                            }
                        }
                        @if (o.Status is OrderStatuses.Packed or OrderStatuses.Sent or OrderStatuses.PickedUp)
                        {
                            <button class="k-btn k-btn-sm k-btn-ghost" @onclick="() => Step(() => Shop.UndoAsync(o.Id))">Fortryd</button>
                        }
                    </li>
                }
            </ul>
        </section>
    }
}
@if (_orders.Count == 0)
{
    <section class="k-card"><p>Ingen ordrer endnu.</p></section>
}

@code {
    private List<Order> _orders = [];
    private readonly Dictionary<int, string?> _tracking = [];
    private string? _error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _orders = await Shop.RecentOrdersAsync();
        foreach (var o in _orders) _tracking.TryAdd(o.Id, "");
    }

    private IEnumerable<(string, List<Order>)> Groups() =>
    [
        ("Skal pakkes", _orders.Where(o => o.Status == OrderStatuses.Paid).ToList()),
        ("Pakket – skal sendes eller afhentes", _orders.Where(o => o.Status == OrderStatuses.Packed).ToList()),
        ("Venter på betaling", _orders.Where(o => o.Status == OrderStatuses.Pending).ToList()),
        ("Klaret – sendt eller afhentet", _orders.Where(o => o.Status is OrderStatuses.Sent or OrderStatuses.PickedUp).ToList()),
        ("Ikke betalt (udløbet)", _orders.Where(o => o.Status is OrderStatuses.Expired or OrderStatuses.Cancelled).Take(20).ToList()),
    ];

    private Task Send(int id) => Step(() => Shop.SendAsync(id, _tracking.GetValueOrDefault(id) ?? string.Empty));

    private async Task Step(Func<Task> step)
    {
        _error = null;
        try { await step(); }
        catch (LagerException ex) { _error = ex.Message; }
        await Load();
    }
}
