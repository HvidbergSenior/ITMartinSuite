@page "/stikproeve"
@inject SpotCheckUseCases Spot
@inject NavigationManager Nav
@inject ItemPhotoUseCases ItemPhotos

@* Stikprøve (user 2026-11-24: "if the listings are not precise or the rules are bad... How?" -> "yes" to spot checks): 20 random things
   with the used listings behind their price. Rigtig / Forkert on each listing. Forkert = never counts again for that thing, and its
   price is worked out again at once. The table on top shows how good each source is. *@
<PageTitle>Stikprøve – Lager</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">Stikprøve af priserne</h1>
    <p><b>Gør dette:</b> se på hver annonce – er det <b>præcis den samme ting</b> (samme titel, nummer, år og udgave)? Tryk <b>Rigtig</b> eller <b>Forkert</b> – eller <b>Kan ikke se</b>, hvis billedet ikke viser det. Almindelige cd'er er ikke med, de har fast pris.
       <b>Du får:</b> forkerte annoncer tæller aldrig mere, prisen regnes om med det samme, og du kan se, hvor gode kilderne er.</p>
    @if (_stats is { Count: > 0 })
    {
        <table class="lg-stats">
            <thead><tr><th>Kilde</th><th>Rigtig</th><th>Forkert</th><th>Rigtig i %</th></tr></thead>
            <tbody>
                @foreach (var (src, r, w) in _stats)
                {
                    <tr><td>@src</td><td>@r</td><td>@w</td><td>@(r + w == 0 ? "–" : $"{100 * r / (r + w)} %")</td></tr>
                }
            </tbody>
        </table>
    }
    <div class="lg-spot-fix">
        <button class="k-btn k-btn-secondary k-mt" disabled="@_busy" @onclick="NewSample">Nye @Count</button>
        @* 2026-11-25 (user: "I need to look at all my prices before the new batch"): exactly the things Martin prices himself. *@
        <button class="k-btn @(_onlyAssess ? "k-btn-primary" : "k-btn-secondary") k-mt" disabled="@_busy" @onclick="OnlyAssess">Kun skal vurderes</button>
    </div>
    @if (_onlyAssess && _rows is not null)
    {
        <p class="k-small k-muted">Viser de @_rows.Count ting, du selv skal give en pris – dyreste forslag først (@(_rows.Count - _doneAtLoad.Count) mangler et svar, @_doneAtLoad.Count er gennemgået). Tryk Forkert på de annoncer, der ikke er præcis den samme ting; prisen regnes om med det samme.</p>
    }
</section>

@if (_rows is null) { <section class="k-card"><p>Henter …</p></section> }
else
{
    @foreach (var row in _rows.Where(r => !_doneAtLoad.Contains(r.Item.Id)))
    {
        @Card(row)
    }
    @* 2026-11-25 (user: "put them in a category so I can check if I want"): things whose every listing already has a mark when the list is
       loaded wait here, closed. A card finished during this visit stays where it is (no jumps). *@
    @if (_doneAtLoad.Count > 0)
    {
        <details class="k-card lg-spot-done">
            <summary><b>Gennemgået (@_doneAtLoad.Count)</b> – alle annoncer har et svar. Åbn for at tjekke eller ændre.</summary>
            @foreach (var row in _rows.Where(r => _doneAtLoad.Contains(r.Item.Id)))
            {
                @Card(row)
            }
        </details>
    }
}

@code {
    private RenderFragment Card(SpotCheckUseCases.Row row) => @<text>
        <section class="k-card lg-spot">
            <div class="lg-spot-head">
                @* 2026-11-24 (user: "Will Young · Keep On no picture"): no own photo yet -> the pile photo it was read from, so you can see what it is. *@
                @if (row.Item.ItemPhoto == "" && row.Item.PhotoId is { } pile)
                {
                    <a class="lg-spot-pile" href="/bunkefoto/@pile" target="_blank" rel="noopener" title="Billedet af bunken, varen er læst fra – åbner stort i en ny fane">
                        <img class="lg-spot-photo" src="/bunkefoto/@pile" alt="" loading="lazy" /><span>bunkefoto</span>
                    </a>
                }
                else
                {
                    <img class="lg-spot-photo @(IsMagazine(row.Item) ? "lg-spot-photo-mag" : "")" src="/varefoto/@row.Item.Id?v=@Ver(row.Item)" alt="" loading="lazy" />
                }
                <div>
                    @* 2026-11-25 (user: "only necessary here is the number, årgang and the front page picture"): a magazine shows the number and
                       årgang BIG (the title is what the AI read off the cover - "Bjørn" from a bear), and a zoomed strip of the cover's top edge,
                       where the issue line is printed too small to read. *@
                    @if (IsMagazine(row.Item))
                    {
                        <div class="lg-spot-issue @(MagazineIssue(row.Item) is null ? "lg-spot-issue-missing" : "")">
                            <a href="/vare/@row.Item.Id" target="_blank" rel="noopener" title="Åbner i en ny fane – listen her bliver stående">@(MagazineIssue(row.Item) ?? "nr. mangler")</a>
                        </div>
                        @if (HintOf(row) is { Kind: not IssueHintKind.None } hint)
                        {
                            <div class="lg-spot-hint lg-spot-hint-@hint.Kind.ToString().ToLowerInvariant()" role="status">
                                @hint.Text
                                @if (hint.SuggestedNumber is { } sn)
                                {
                                    <button class="k-btn k-btn-sm k-btn-primary" disabled="@_busy" @onclick="() => SetNumber(row, sn)">Ret nummer til @sn</button>
                                }
                            </div>
                        }
                        @if (row.Item.ItemPhoto != "")
                        {
                            @* 2026-11-25: the strip is cut on the server from the cover without its plain margin; blank = 404 = no strip. *@
                            <a class="lg-spot-strip" href="/varefoto/@row.Item.Id?v=@Ver(row.Item)" target="_blank" rel="noopener" title="Toppen af forsiden, forstørret – åbner billedet stort">
                                <img src="/varestrimmel/@row.Item.Id?v=@Ver(row.Item)" alt="" loading="lazy" onerror="this.parentElement.style.display='none'" />
                            </a>
                        }
                        @* The cover often lies sideways (2026-11-25 first look): Drej, then the strip shows the issue line. Type the number you read. *@
                        <div class="lg-spot-fix">
                            @if (row.Item.ItemPhoto != "") { <button class="k-btn k-btn-sm k-btn-secondary" disabled="@_busy" @onclick="() => Rotate(row)" title="Drej en kvart omgang med uret">Drej ↻</button> }
                            <input class="k-input lg-spot-nr" inputmode="numeric" placeholder="nr." aria-label="Nummer på @row.Item.Id"
                                   value="@_typed.GetValueOrDefault(row.Item.Id, "")" @onchange="e => Typed(row.Item.Id, e)" />
                            <button class="k-btn k-btn-sm k-btn-primary" disabled="@_busy" @onclick="() => SaveTyped(row)">Gem nummer</button>
                        </div>
                        @if (_err is not null) { <p class="lg-warn" role="alert">⚠ @_err</p> }
                        <div class="k-small k-muted">@row.Item.Kind · @(row.Item.Box?.Code ?? "ingen kasse") · standard @(row.Standard is { } sm ? $"{sm} kr" : "–") · @PriceNow(row.Item)</div>
                    }
                    else
                    {
                    <b><a href="/vare/@row.Item.Id" target="_blank" rel="noopener" title="Åbner i en ny fane – listen her bliver stående">@row.Item.Line()</a></b>
                    <div class="k-small k-muted">@row.Item.Kind · @(row.Item.Box?.Code ?? "ingen kasse") · standard @(row.Standard is { } s ? $"{s} kr" : "–") · @PriceNow(row.Item)</div>
                    }
                </div>
            </div>
            <ul class="lg-spot-list @(IsMagazine(row.Item) ? "lg-spot-list-mag" : "")">
                @foreach (var f in row.Finds)
                {
                    var key = ITMartinLager.Domain.ListingVerdict.KeyOf(f);
                    var mark = row.Marks.TryGetValue(key, out var m) ? m : "";
                    // 2026-11-25: a listing the rules already throw out (another year, season, issue ...) never counted - no answer needed.
                    var excluded = mark == "" && !ITMartinLager.Domain.FixedPrice.Counts(row.Item, f);
                    <li class="@(excluded ? "lg-spot-excluded" : mark == SpotCheckUseCases.Forkert ? "lg-spot-wrong" : mark == SpotCheckUseCases.Rigtig ? "lg-spot-right" : mark == SpotCheckUseCases.KanIkkeSe ? "lg-spot-unsure" : "")">
                        @* 2026-11-24 (user: "look at the pictures from front cover"): the listing's own picture, so another edition's cover shows at a glance. *@
                        @if (f.Image.StartsWith("http"))
                        {
                            <a class="lg-spot-thumb" href="@f.Image" target="_blank" rel="noopener noreferrer" title="Annoncens billede – åbner stort"><img src="@f.Image" alt="" loading="lazy" referrerpolicy="no-referrer" /></a>
                        }
                        else
                        {
                            <span class="lg-spot-thumb lg-spot-nothumb">intet billede</span>
                        }
                        <span class="lg-spot-kr">@f.Kr kr</span>
                        <span class="lg-spot-src">@f.Source</span>
                        @if (f.Url.StartsWith("http")) { <a href="@f.Url" target="_blank" rel="noopener">@f.Name</a> } else { <span>@f.Name</span> }
                        @if (excluded)
                        {
                            <span class="k-small k-muted">udelukket af reglerne – intet svar nødvendigt</span>
                        }
                        else
                        {
                        <span class="lg-spot-btns">
                            <button class="k-btn k-btn-sm @(mark == SpotCheckUseCases.Rigtig ? "k-btn-primary" : "k-btn-secondary")" disabled="@_busy" @onclick="() => Mark(row, f, SpotCheckUseCases.Rigtig)">Rigtig</button>
                            <button class="k-btn k-btn-sm @(mark == SpotCheckUseCases.Forkert ? "k-btn-primary" : "k-btn-ghost")" disabled="@_busy" @onclick="() => Mark(row, f, SpotCheckUseCases.Forkert)">Forkert</button>
                            <button class="k-btn k-btn-sm @(mark == SpotCheckUseCases.KanIkkeSe ? "k-btn-primary" : "k-btn-ghost")" disabled="@_busy" @onclick="() => Mark(row, f, SpotCheckUseCases.KanIkkeSe)" title="Du kan ikke se, om det er den samme – tæller hverken som rigtig eller forkert">Kan ikke se</button>
                        </span>
                        }
                    </li>
                }
            </ul>
        </section>
    </text>;

    public const int Count = 20;
    private List<SpotCheckUseCases.Row>? _rows;
    private List<(string Source, int Right, int Wrong)>? _stats;
    private bool _busy;

    // The 20 live in the address (?ids=1,2,3), so Back from a product - or a reload - shows the same list (user 2026-11-24).
    [SupplyParameterFromQuery(Name = "ids")] public string? Ids { get; set; }
    [SupplyParameterFromQuery(Name = "skal")] public string? Skal { get; set; }

    private bool _onlyAssess;
    private HashSet<int> _doneAtLoad = [];
    public const int AssessMax = 60;

    protected override async Task OnInitializedAsync() { _onlyAssess = Skal == "1"; await Load(ParseIds(Ids)); }

    private static List<int> ParseIds(string? s) =>
        (s ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(x => int.TryParse(x, out var n) ? n : 0).Where(n => n > 0).ToList();

    private Task NewSample() { _onlyAssess = false; return Load([]); }
    private Task OnlyAssess() { _onlyAssess = true; return Load([]); }

    private async Task Load(List<int> same)
    {
        _busy = true; _rows = null;
        try
        {
            _rows = await Spot.SampleAsync(_onlyAssess ? AssessMax : Count, same, _onlyAssess);
            _doneAtLoad = _onlyAssess ? _rows.Where(SpotCheckUseCases.Reviewed).Select(r => r.Item.Id).ToHashSet() : [];
            _stats = await Spot.StatsAsync();
            var ids = string.Join(",", _rows.Select(r => r.Item.Id));
            if (ids != (Ids ?? "") || (Skal == "1") != _onlyAssess) Nav.NavigateTo($"/stikproeve?{(_onlyAssess ? "skal=1&" : "")}ids={ids}", replace: true);
        }
        finally { _busy = false; }
    }

    private async Task Mark(SpotCheckUseCases.Row row, PriceFind f, string mark)
    {
        _busy = true;
        try
        {
            row.Item.PriceHint = await Spot.MarkAsync(row.Item.Id, f, mark);
            row.Marks[ITMartinLager.Domain.ListingVerdict.KeyOf(f)] = mark;
            _stats = await Spot.StatsAsync();
        }
        finally { _busy = false; }
    }

    private static bool IsMagazine(Item i) => FixedPrice.Magazines.Contains(i.Kind);

    private readonly Dictionary<int, string> _typed = [];
    private readonly Dictionary<int, int> _photoVer = [];
    private string? _err;

    private int Ver(Item i) => _photoVer.GetValueOrDefault(i.Id);
    private void Typed(int id, ChangeEventArgs e) => _typed[id] = e.Value?.ToString() ?? "";

    private async Task Rotate(SpotCheckUseCases.Row row)
    {
        _err = await ItemPhotos.RotateAsync(row.Item.Id, 90);
        if (_err is null) _photoVer[row.Item.Id] = Ver(row.Item) + 1;
    }

    private async Task SaveTyped(SpotCheckUseCases.Row row)
    {
        var n = _typed.GetValueOrDefault(row.Item.Id, "").Trim();
        if (n == "" || !n.All(char.IsDigit)) { _err = "Skriv kun cifre – nummeret på bladet."; return; }
        _err = null;
        await SetNumber(row, n);
        _typed.Remove(row.Item.Id);
    }

    private static IssueHint HintOf(SpotCheckUseCases.Row row) => IssueHints.For(row.Item, row.Finds);

    private async Task SetNumber(SpotCheckUseCases.Row row, string number)
    {
        _busy = true;
        try
        {
            row.Item.PriceHint = await Spot.SetNumberAsync(row.Item.Id, number);
            row.Item.Number = number;
            _stats = await Spot.StatsAsync();
        }
        finally { _busy = false; }
    }

    // "Nr. 12 · årgang 1998" - null when the number is missing (the page then shows a red "nr. mangler").
    private static string? MagazineIssue(Item i) =>
        i.Number == "" ? null : i.Year is { } y ? $"Nr. {i.Number} · årgang {y}" : $"Nr. {i.Number} · årgang mangler";

    private static string PriceNow(Item i) =>
        i.Price is > 0 ? $"din pris {i.Price:0} kr" : i.PriceHint is > 0 ? $"forslag {i.PriceHint:0} kr" : "standardprisen";
}
