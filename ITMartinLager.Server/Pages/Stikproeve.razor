@page "/stikproeve"
@inject SpotCheckUseCases Spot
@inject NavigationManager Nav

@* Stikprøve (user 2026-11-24: "if the listings are not precise or the rules are bad... How?" -> "yes" to spot checks): 20 random things
   with the used listings behind their price. Rigtig / Forkert on each listing. Forkert = never counts again for that thing, and its
   price is worked out again at once. The table on top shows how good each source is. *@
<PageTitle>Stikprøve – Lager</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">Stikprøve af priserne</h1>
    <p><b>Gør dette:</b> se på hver annonce – er det <b>præcis den samme ting</b> (samme titel, nummer, år og udgave)? Tryk <b>Rigtig</b> eller <b>Forkert</b> – eller <b>Kan ikke se</b>, hvis billedet ikke viser det. Almindelige cd'er er ikke med, de har fast pris.
       <b>Du får:</b> forkerte annoncer tæller aldrig mere, prisen regnes om med det samme, og du kan se, hvor gode kilderne er.</p>
    @if (_stats is { Count: > 0 })
    {
        <table class="lg-stats">
            <thead><tr><th>Kilde</th><th>Rigtig</th><th>Forkert</th><th>Rigtig i %</th></tr></thead>
            <tbody>
                @foreach (var (src, r, w) in _stats)
                {
                    <tr><td>@src</td><td>@r</td><td>@w</td><td>@(r + w == 0 ? "–" : $"{100 * r / (r + w)} %")</td></tr>
                }
            </tbody>
        </table>
    }
    <button class="k-btn k-btn-secondary k-mt" disabled="@_busy" @onclick="NewSample">Nye @Count</button>
</section>

@if (_rows is null) { <section class="k-card"><p>Henter …</p></section> }
else
{
    @foreach (var row in _rows)
    {
        <section class="k-card lg-spot">
            <div class="lg-spot-head">
                @* 2026-11-24 (user: "Will Young · Keep On no picture"): no own photo yet -> the pile photo it was read from, so you can see what it is. *@
                @if (row.Item.ItemPhoto == "" && row.Item.PhotoId is { } pile)
                {
                    <a class="lg-spot-pile" href="/bunkefoto/@pile" target="_blank" rel="noopener" title="Billedet af bunken, varen er læst fra – åbner stort i en ny fane">
                        <img class="lg-spot-photo" src="/bunkefoto/@pile" alt="" loading="lazy" /><span>bunkefoto</span>
                    </a>
                }
                else
                {
                    <img class="lg-spot-photo" src="/varefoto/@row.Item.Id" alt="" loading="lazy" />
                }
                <div>
                    <b><a href="/vare/@row.Item.Id" target="_blank" rel="noopener" title="Åbner i en ny fane – listen her bliver stående">@row.Item.Line()</a></b>
                    <div class="k-small k-muted">@row.Item.Kind · @(row.Item.Box?.Code ?? "ingen kasse") · standard @(row.Standard is { } s ? $"{s} kr" : "–") · @PriceNow(row.Item)</div>
                </div>
            </div>
            <ul class="lg-spot-list">
                @foreach (var f in row.Finds)
                {
                    var key = ITMartinLager.Domain.ListingVerdict.KeyOf(f);
                    var mark = row.Marks.TryGetValue(key, out var m) ? m : "";
                    <li class="@(mark == SpotCheckUseCases.Forkert ? "lg-spot-wrong" : mark == SpotCheckUseCases.Rigtig ? "lg-spot-right" : mark == SpotCheckUseCases.KanIkkeSe ? "lg-spot-unsure" : "")">
                        @* 2026-11-24 (user: "look at the pictures from front cover"): the listing's own picture, so another edition's cover shows at a glance. *@
                        @if (f.Image.StartsWith("http"))
                        {
                            <a class="lg-spot-thumb" href="@f.Image" target="_blank" rel="noopener noreferrer" title="Annoncens billede – åbner stort"><img src="@f.Image" alt="" loading="lazy" referrerpolicy="no-referrer" /></a>
                        }
                        else
                        {
                            <span class="lg-spot-thumb lg-spot-nothumb">intet billede</span>
                        }
                        <span class="lg-spot-kr">@f.Kr kr</span>
                        <span class="lg-spot-src">@f.Source</span>
                        @if (f.Url.StartsWith("http")) { <a href="@f.Url" target="_blank" rel="noopener">@f.Name</a> } else { <span>@f.Name</span> }
                        <span class="lg-spot-btns">
                            <button class="k-btn k-btn-sm @(mark == SpotCheckUseCases.Rigtig ? "k-btn-primary" : "k-btn-secondary")" disabled="@_busy" @onclick="() => Mark(row, f, SpotCheckUseCases.Rigtig)">Rigtig</button>
                            <button class="k-btn k-btn-sm @(mark == SpotCheckUseCases.Forkert ? "k-btn-primary" : "k-btn-ghost")" disabled="@_busy" @onclick="() => Mark(row, f, SpotCheckUseCases.Forkert)">Forkert</button>
                            <button class="k-btn k-btn-sm @(mark == SpotCheckUseCases.KanIkkeSe ? "k-btn-primary" : "k-btn-ghost")" disabled="@_busy" @onclick="() => Mark(row, f, SpotCheckUseCases.KanIkkeSe)" title="Du kan ikke se, om det er den samme – tæller hverken som rigtig eller forkert">Kan ikke se</button>
                        </span>
                    </li>
                }
            </ul>
        </section>
    }
}

@code {
    public const int Count = 20;
    private List<SpotCheckUseCases.Row>? _rows;
    private List<(string Source, int Right, int Wrong)>? _stats;
    private bool _busy;

    // The 20 live in the address (?ids=1,2,3), so Back from a product - or a reload - shows the same list (user 2026-11-24).
    [SupplyParameterFromQuery(Name = "ids")] public string? Ids { get; set; }

    protected override async Task OnInitializedAsync() => await Load(ParseIds(Ids));

    private static List<int> ParseIds(string? s) =>
        (s ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(x => int.TryParse(x, out var n) ? n : 0).Where(n => n > 0).ToList();

    private Task NewSample() => Load([]);

    private async Task Load(List<int> same)
    {
        _busy = true; _rows = null;
        try
        {
            _rows = await Spot.SampleAsync(Count, same);
            _stats = await Spot.StatsAsync();
            var ids = string.Join(",", _rows.Select(r => r.Item.Id));
            if (ids != (Ids ?? "")) Nav.NavigateTo($"/stikproeve?ids={ids}", replace: true);
        }
        finally { _busy = false; }
    }

    private async Task Mark(SpotCheckUseCases.Row row, PriceFind f, string mark)
    {
        _busy = true;
        try
        {
            row.Item.PriceHint = await Spot.MarkAsync(row.Item.Id, f, mark);
            row.Marks[ITMartinLager.Domain.ListingVerdict.KeyOf(f)] = mark;
            _stats = await Spot.StatsAsync();
        }
        finally { _busy = false; }
    }

    private static string PriceNow(Item i) =>
        i.Price is > 0 ? $"din pris {i.Price:0} kr" : i.PriceHint is > 0 ? $"forslag {i.PriceHint:0} kr" : "standardprisen";
}
