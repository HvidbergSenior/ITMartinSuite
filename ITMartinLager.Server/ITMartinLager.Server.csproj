<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- Bogshoppen Lager (2026-10-05): the register for 100,000+ books, magazines, Anders And, comics, DVD/Blu-ray,
         console games and Magic cards that ITMartin sells through bogshoppen.dk. Photo of a pile -> one AI call reads
         every cover -> items in a box with a QR label -> search. Shop, auctions and marketplaces come later on top. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ITMartinLager.Server</RootNamespace>
        <AssemblyName>ITMartinLager.Server</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ITMartin.Shared.UI\ITMartin.Shared.UI.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Anthropic" Version="12.29.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.25" />
      <PackageReference Include="QRCoder" Version="1.8.0" />
      <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="ITMartinLager.Tests" />
    </ItemGroup>

</Project>
