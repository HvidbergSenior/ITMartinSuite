<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- Bogshoppen Lager (2026-10-05): the register for 100,000+ books, magazines, Anders And, comics, DVD/Blu-ray,
         console games and Magic cards that ITMartin sells through bogshoppen.dk. Photo of a pile -> one AI call reads
         every cover -> items in a box with a QR label -> search. Shop, auctions and marketplaces come later on top.
         This is the thin web layer: pages, login, background jobs. The rules are in .Domain, the use cases in
         .Application, SQLite/Claude/price sites in .Infrastructure. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ITMartinLager.Server</RootNamespace>
        <AssemblyName>ITMartinLager.Server</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ITMartin.Shared.UI\ITMartin.Shared.UI.csproj" />
      <ProjectReference Include="..\ITMartinLager.Application\ITMartinLager.Application.csproj" />
      <ProjectReference Include="..\ITMartinLager.Infrastructure\ITMartinLager.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="QRCoder" Version="1.8.0" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="ITMartinLager.Tests" />
    </ItemGroup>

</Project>
