@inherits LayoutComponentBase
@inject SalgLinks Salg
@inject NavigationManager Nav

@* Menu = Søg + Log ud (user 2026-11-15: "also all that kasser, mere?" -> yes). Kasser is found by typing the day's name in
   Søg; Mere is a small link at the bottom of the front page until its tools have moved to their own apps. *@
<KolibriTitle />   @* tab title fallback - here, not in KolibriHeader, so the page's own <PageTitle> wins *@
@* The same header in all four Bogshoppen apps (2026-11-15): the tab's name, then Lys/mørk + Log ud. "Søg" is gone from
   the menu - the front page IS the search, and the name top-left goes there. *@
<KolibriHeader Title="@BogshoppenFlow.Title(BogshoppenFlow.Lager)">
    <button id="themeToggleBtn" class="k-btn k-btn-ghost k-btn-sm" type="button" title="Skift lys/mørk visning">Lys/mørk</button>
    @if (Me is { IsAdmin: true })
    {
        @* Admins could not log out (user 2026-10-26: "cannot logout of lager") - needed to switch to a test login. *@
        <a class="k-btn k-btn-ghost k-btn-sm" href="/api/logout">Log ud</a>
    }
    else if (Me is { } who) { <span class="k-small">👤 @who.Name · <a href="/api/logout">Log ud</a></span> }
</KolibriHeader>
@if (Me is { IsAdmin: true }) { <KolibriSteps Steps="Flow" Current="BogshoppenFlow.Lager" Label="Bogshoppens apps" /> }
<div class="k-main"><div class="k-content">
    @Body
</div></div>
<KolibriFooter />

@code {
    [CascadingParameter] public LagerUser? Me { get; set; }
    // Bogshoppen's five steps (2026-11-05) - names + addresses only, so the helpers stay separate.
    private static readonly IReadOnlyList<KolibriSteps.KolibriStep> Flow =
        BogshoppenFlow.Steps.Select(s => new KolibriSteps.KolibriStep(s.Name, s.Url)).ToList();
}
