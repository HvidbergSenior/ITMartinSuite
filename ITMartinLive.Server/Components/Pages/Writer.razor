@page "/w/{Slug}"
@inject LiveService Live

@if (!_auth)
{
    <div class="pin-gate">
        <div class="pin-box">
            <div class="pin-title">🔐 @(Slug)</div>
            <form method="get" action="/w/@Slug">
                <input name="pin" class="field" type="password" placeholder="PIN-kode" maxlength="20" autofocus />
                @if (_pinError) { <div class="error-msg">@_pinErrorMsg</div> }
                <button type="submit" class="primary-btn">Åbn</button>
            </form>
        </div>
    </div>
}
else if (_event is null)
{
    <div class="empty-state">Begivenhed ikke fundet</div>
}
else
{
    <div id="page-data" data-page="writer" data-slug="@Slug" data-pin="@PinParam" style="display:none"></div>

    <div class="writer-layout">

        <div class="viewer-hdr">
            <span class="live-dot"></span>
            <span class="writer-event-name">@_event.SportEmoji @_event.Name</span>
            <div class="viewer-hdr-right">
                <span id="w-count">👁️ @_event.ViewerCount</span>
                <a href="/e/@Slug" class="ghost-btn">Vis live →</a>
            </div>
        </div>

        <div class="tab-bar">
            <button class="tab tab-active" id="tab-write" onclick="writerTab('write')">✏️ Skriv</button>
            <button class="tab" id="tab-feed" onclick="writerTab('feed')">
                📋 Feed <span id="pending-badge" class="badge" style="display:none"></span>
            </button>
        </div>

        <!-- COMPOSER -->
        <div id="pane-write">

            <div class="composer-section">
                <div class="composer-label">📌 Scoreline / status</div>
                <div class="header-row">
                    <input id="w-header" class="field" placeholder="f.eks. Vingegaard +0:12 eller 2 – 1 (67')" value="@_event.HeaderText" />
                    <button class="primary-btn compact" onclick="updateHeader()">Opdater</button>
                </div>
                <div id="w-current-header" class="current-header" style="@(string.IsNullOrEmpty(_event.HeaderText) ? "display:none" : "")">
                    Nu: <strong id="w-header-val">@_event.HeaderText</strong>
                </div>
            </div>

            <div class="composer-section">
                <div class="composer-label">Type</div>
                <div class="type-row">
                    <!-- onclick values = UpdateType enum: Text=0,Score=1,Position=2,Poll=3,Breaking=4,Video=5 -->
                    <button class="type-btn type-active" onclick="selectType(0)">📝<span>Tekst</span></button>
                    <button class="type-btn" onclick="selectType(1)">⚽<span>Score</span></button>
                    <button class="type-btn" onclick="selectType(2)">🚴<span>Position</span></button>
                    <button class="type-btn" onclick="selectType(4)">🔥<span>Breaking</span></button>
                    <button class="type-btn" onclick="selectType(3)">📊<span>Afstemning</span></button>
                    <button class="type-btn" onclick="selectType(5)">🎥<span>Video</span></button>
                </div>
            </div>

            <div class="composer-section">
                <textarea id="w-text" class="field textarea-big" placeholder="Hvad sker der?" rows="3" maxlength="500"></textarea>
            </div>

            <div id="poll-section" class="composer-section" style="display:none">
                <div class="composer-label">Valgmuligheder</div>
                <div id="poll-opts">
                    <input class="field poll-opt-input" placeholder="Mulighed 1" style="margin-bottom:6px" />
                    <input class="field poll-opt-input" placeholder="Mulighed 2" style="margin-bottom:6px" />
                </div>
                <button class="ghost-btn" onclick="addPollOpt()">+ Tilføj mulighed</button>
            </div>

            <div id="video-section" class="composer-section" style="display:none">
                <div class="composer-label">Video</div>
                <input type="file" id="w-video" accept="video/*" class="file-input" onchange="onVideoSelected(this)" />
                <div id="upload-status" class="upload-status" style="display:none"></div>
                <div id="video-ready" class="upload-status" style="display:none">✅ Klar</div>
            </div>

            <div class="composer-section push-row">
                <label class="toggle-label">
                    <input type="checkbox" id="w-send-push" />
                    🔔 Send push-notifikation
                </label>
            </div>

            <button class="primary-btn big-btn" id="post-btn" onclick="postUpdate()">Post opdatering</button>

            <div class="composer-section end-section">
                <button class="ghost-btn" id="summary-btn" onclick="generateSummary()">📋 Generer opsummering (AI)</button>
                <button id="toggle-btn" class="ghost-btn danger" onclick="toggleActive()">
                    @(_event.IsActive ? "⏹️ Afslut begivenhed" : "▶️ Genåbn begivenhed")
                </button>
            </div>

        </div>

        <!-- FEED TAB -->
        <div id="pane-feed" style="display:none">
            <div id="w-pending"></div>
            <div id="w-feed" class="feed"></div>
        </div>

    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    [SupplyParameterFromQuery(Name = "pin")]
    public string? PinParam { get; set; }

    private LiveEvent? _event;
    private bool   _auth;
    private bool   _pinError;
    private string _pinErrorMsg = "";

    protected override void OnInitialized()
    {
        _event = Live.Get(Slug);
        if (PinParam is not null)
        {
            if (_event is null)
            {
                _pinError    = true;
                _pinErrorMsg = $"Begivenhed '{Slug}' findes ikke — opret den i admin først";
            }
            else if (_event.WriterPin == PinParam.Trim())
            {
                _auth = true;
            }
            else
            {
                _pinError    = true;
                _pinErrorMsg = "Forkert PIN";
            }
        }
    }
}
