@inherits LayoutComponentBase
@inject TenantContext Tenant
@inject HouseholdRegistry Registry

<div class="ep-root">
    <div class="ep-page">
        @if (Tenant.IsAdvisor && _viewing is not null)
        {
            @* An advisor must never be in doubt about whose numbers are on the screen. *@
            <div class="advisor-bar">
                Du ser <b>@_viewing</b> som rådgiver.
                <a href="/kunder">Skift kunde</a>
            </div>
        }
        @if (Tenant.Email == DemoHousehold.Email)
        {
            @* The demo from ElPriser: clear that it is a demo, and the way to your own. *@
            <div class="advisor-bar">
                👀 <b>Du ser en demo</b> med rigtige tal fra en familie i Aarhus. Klik rundt – intet bliver gemt.
                <a href="/logout?next=/opret">Opret din egen →</a>
            </div>
        }
        @Body
        <KolibriFooter />
    </div>
</div>

<nav class="bottom-nav">
    <NavLink href="/" Match="NavLinkMatch.All"><span>⚡</span>Nu</NavLink>
    <NavLink href="/dag"><span>🔎</span>Dag</NavLink>
    <NavLink href="/planlaeg"><span>📅</span>Planlæg</NavLink>
    <NavLink href="/enheder"><span>🏠</span>Enheder</NavLink>
    <NavLink href="/historik"><span>📒</span>Historik</NavLink>
    <NavLink href="/regning"><span>🧾</span>Regning</NavLink>
    <NavLink href="/groen"><span>🌱</span>Grøn</NavLink>
    <NavLink href="/elselskab"><span>🏢</span>Elselskab</NavLink>
    <NavLink href="/besked"><span>🔔</span>Besked</NavLink>
    <NavLink href="/indstillinger"><span>⚙️</span>Indstillinger</NavLink>
    <NavLink href="/konto"><span>👤</span>Konto</NavLink>
    @if (Tenant.IsAdvisor)
    {
        <NavLink href="/kunder"><span>🧑‍🤝‍🧑</span>Kunder</NavLink>
    }
</nav>

@code {
    private string? _viewing;

    protected override void OnInitialized()
    {
        if (!Tenant.IsAdvisor) return;
        if (Tenant.CurrentHouseholdId() is not { } householdId) return;
        _viewing = Registry.HouseholdName(householdId);
    }
}
