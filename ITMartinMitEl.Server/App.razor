<!DOCTYPE html>
<html lang="da">
<head>
    <script>
        (function () {
            var theme = localStorage.getItem('mitel_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MinElpris" />
    <title>MinElpris</title>
    <base href="/" />
    <link rel="manifest" href="manifest.json" />
    <link rel="icon" href="icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    <link rel="stylesheet" href="ITMartinMitEl.Server.styles.css?v=@CacheBuster" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.server.js"></script>
    <script src="js/push.js?v=@CacheBuster"></script>
    <button id="themeToggleBtn" class="theme-toggle" title="Skift lys/mørk visning">🌓</button>
    <script>
    (function () {
        var btn = document.getElementById('themeToggleBtn');
        function sync() {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            btn.textContent = current === 'light' ? '🌙' : '☀️';
            var meta = document.querySelector('meta[name=theme-color]');
            if (meta) meta.setAttribute('content', current === 'light' ? '#f5f5f7' : '#0b1220');
        }
        btn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('mitel_theme', next);
            sync();
        });
        sync();
    })();
    </script>
    <script>
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
    </script>
    <div id="components-reconnect-modal">
        <span class="reconnect-msg">Forbinder igen...</span>
        <span class="reconnect-failed-msg">Forbindelsen er tabt — <button onclick="location.reload()">Genindlæs</button></span>
    </div>
    <script>
    (function(){
        var vid = localStorage.getItem('_mid');
        if (!vid) { vid = Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2); localStorage.setItem('_mid', vid); }
        function track(path, title, referrer) {
            if (location.search.indexOf('claude_test=1') !== -1) return;
            fetch('https://stats.itmartin.dk/api/hit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: path, title: title, referrer: referrer, visitorId: vid, host: location.hostname }),
                keepalive: true
            }).catch(function(){});
        }
        track(location.pathname + location.search, document.title, document.referrer);
    })();
    </script>
</body>
</html>

@code {
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
