@page "/planlaeg"
@using System.Globalization
@inject ElectricityPriceService Prices
@inject HouseholdStore Store

<PageTitle>Planlæg – MinElpris</PageTitle>

<h1>Hvornår skal den starte?</h1>
<details class="card fold">
    <summary>ⓘ Hvad viser siden?</summary>
    <div class="fold-body small">
    <ul>
        <li>Vælg <b>hvor længe</b> maskinen kører – så viser vi det billigste tidspunkt at starte.</li>
        <li><b>2 timer</b> er vask, opvask og tørretumbler – kun dagtimer foreslås. <b>4 timer</b> og <b>hele natten</b> er ting på timer om natten.</li>
        <li><b>🔌 Hvad koster det?</b> viser den præcise pris for én tur – nu, om 1, 2, 3 og 6 timer, og det billigste tidspunkt. Vælg en af dine maskiner, eller ✏️ Egen med watt og timer.</li>
    </ul>
    </div>
</details>

<div class="chips">
    @foreach (var c in Choices)
    {
        <button class="chip @(_choice == c.Key ? "on" : "")" @onclick="() => Pick(c.Key)">@c.Label</button>
    }
</div>

@if (_raw is null)
{
    <div class="card"><div class="muted">Regner…</div></div>
}
else
{
    <div class="card plan-result">
        @switch (_choice)
        {
            case "2":
                @if (_wash is { } w && Best2(w) is { } b)
                {
                    var saving = w.Now is { } n && n.AvgKrPerKwh > b.AvgKrPerKwh ? (int)Math.Round(100 * (n.AvgKrPerKwh - b.AvgKrPerKwh) / n.AvgKrPerKwh) : 0;
                    <div class="plan-when lvl-cheap">@(b == w.Now ? "Start nu" : $"Start {When(b.Start)}:{b.Start:mm}")</div>
                    <div class="plan-price">@Kr(b.AvgKrPerKwh) kr/kWh i snit de 2 timer</div>
                    @if (w.Now is { } now && b != now)
                    {
                        <div class="muted small">Starter du nu: @Kr(now.AvgKrPerKwh) kr/kWh@(saving > 0 ? $" · du sparer {saving} %" : "")</div>
                    }
                    <div class="muted small" style="margin-top:6px">Vask, opvask, tørretumbler. Nattetimer (23–06) foreslås ikke.</div>
                }
                else
                {
                    <div class="muted">Ingen priser at regne på endnu.</div>
                }
                break;

            case "4":
            case "8":
                var hours = _choice == "4" ? 4.0 : 8.0;
                @if (_night?.Windows.FirstOrDefault(x => x.Hours == hours).Best is { } nb)
                {
                    <div class="plan-when lvl-cheap">Start i nat kl. @nb.Start.ToString("HH:mm")</div>
                    <div class="plan-price">@Kr(nb.AvgKrPerKwh) kr/kWh i snit de @hours.ToString("0") timer</div>
                    <div class="muted small" style="margin-top:6px">@(hours == 4 ? "Varmtvandsbeholder, elbil på 11 kW, opvask på timer." : "Det der kører hele natten – fx elbil på 1-faset lader.") Natten regnes 22–07.</div>
                    @if (_night is { Complete: false })
                    {
                        <div class="muted small">Morgendagens priser kommer ca. kl. 13 – indtil da er kun aftenen regnet med.</div>
                    }
                }
                else
                {
                    <div class="muted">Nattens priser er ikke kendt endnu – de kommer ca. kl. 13.</div>
                }
                break;

            case "dev":
                <div class="chips chips-small">
                    @foreach (var m in Machines)
                    {
                        <button class="chip @(_machine == m.Name ? "on" : "")" @onclick="() => PickMachine(m.Name)">@m.Icon @m.Name</button>
                    }
                    <button class="chip @(_machine == "" ? "on" : "")" @onclick='() => PickMachine("")'>✏️ Egen</button>
                </div>
                @if (_machine == "")
                {
                    <div class="row2">
                        <div class="field"><label>Effekt, watt</label><input type="number" min="1" max="20000" step="10" @bind="_watt" @bind:after="DeviceChanged" /></div>
                        <div class="field"><label>Kører i, timer</label><input type="number" min="0.25" max="24" step="0.25" @bind="_hours" @bind:after="DeviceChanged" /></div>
                    </div>
                }
                var dev = Device();
                <div class="muted small" style="margin-bottom:8px">@dev.KwhPerRun.ToString("0.##", Da) kWh over @dev.DurationHours.ToString("0.##", Da) timer</div>
                var rows = CostRows(dev);
                @if (rows.Count == 0)
                {
                    <div class="muted">Priserne dækker ikke en hel tur endnu.</div>
                }
                else
                {
                    var best = rows.MinBy(r => r.Run.CostKr)!.Run.CostKr;
                    <div class="cost-rows">
                        @foreach (var r in rows)
                        {
                            <div class="cost-row @(r.Run.CostKr <= best + 0.005 ? "best" : "")">
                                <span>@r.Label <span class="muted small">kl. @r.Run.Start.ToString("HH:mm")</span></span>
                                <b>@r.Run.CostKr.ToString("0.00", Da) kr</b>
                            </div>
                        }
                    </div>
                    <div class="muted small" style="margin-top:8px">Præcis pris for én tur: hvert kvarter maskinen kører, til det kvarters pris.</div>
                }
                break;

            case "ev":
                <div class="row2">
                    <div class="field"><label>Skal lades, kWh</label><input type="number" min="1" max="120" step="1" @bind="_evKwh" @bind:after="EvChangedAsync" /></div>
                    <div class="field"><label>Lader, kW</label><input type="number" min="1" max="22" step="0.1" @bind="_evKw" @bind:after="EvChangedAsync" /></div>
                </div>
                @if (_night?.Ev is { } ev)
                {
                    <div class="plan-when lvl-cheap">Start i nat kl. @ev.Start.ToString("HH:mm")</div>
                    <div class="plan-price">@ev.CostKr.ToString("0", Da) kr for opladningen (@((_night.EvKwh / _night.EvKw).ToString("0.#", Da)) timer)</div>
                    @if (_night.EvFromHome is { } home && home.CostKr > ev.CostKr)
                    {
                        <div class="muted small">Sat i kl. 17 når du kommer hjem: @home.CostKr.ToString("0", Da) kr – du sparer <b>@((home.CostKr - ev.CostKr).ToString("0", Da)) kr</b> pr. opladning.</div>
                    }
                }
                else
                {
                    <div class="muted">Nattens priser er ikke kendt endnu – de kommer ca. kl. 13.</div>
                }
                break;
        }
    </div>

    <details class="card fold">
        <summary>Hvorfor er strøm dyrest kl. 17–21?</summary>
        <div class="small" style="margin-top:8px">Nettariffen – det dit netselskab tager for at levere strømmen – er højest når alle kommer hjem og laver mad. Om vinteren kan den være op til 9 gange nattens. Derfor: sæt starttid i bilen, laderen eller maskinen i stedet for bare at sætte stikket i.</div>
    </details>

    <details class="card fold">
        <summary>Sådan regner vi</summary>
        <div class="small" style="margin-top:8px">Priserne kommer fra Energinet i kvarterer og er inkl. moms, elafgift og nettarif for dit område. Et starttidspunkt er regnet for hele turen – hvert kvarter maskinen kører, til det kvarters pris.</div>
    </details>

}

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private static readonly (string Key, string Label)[] Choices =
        [("2", "🧺 2 timer"), ("4", "♨️ 4 timer"), ("8", "🌙 Hele natten"), ("ev", "🚗 Elbil"), ("dev", "🔌 Hvad koster det?")];

    private string _choice = "2";
    private List<PricePoint>? _raw;
    private ApplianceView? _wash;
    private NightPlan? _night;
    private double _evKwh = 30, _evKw = 11;
    private DateTime _now;
    private double _watt = 2000, _hours = 1;
    private string _machine = "Vaskemaskine";

    // The household's own machines first, so "what does a wash cost?" needs no numbers; ✏️ Egen takes watt and hours.
    private List<Appliance> Machines = [];
    private static readonly Appliance Window = new() { Name = "Vask", Icon = "🧺", KwhPerRun = 1.0, DurationHours = 2 };
    private RunOption? _cheapestDev;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private HouseholdSettings _s = new();

    private async Task LoadAsync()
    {
        var data = Store.Get();
        var s = _s = data.Settings;
        Machines =
        [
            .. data.Appliances,
            .. new Appliance[]
            {
                new() { Name = "Ovn", Icon = "🔥", KwhPerRun = 1.5, DurationHours = 1 },
                new() { Name = "Elbil 30 kWh", Icon = "🚗", KwhPerRun = 30, DurationHours = 3 },
            }.Where(x => data.Appliances.All(a => a.Name != x.Name)),
        ];
        if (Machines.All(m => m.Name != _machine) && _machine != "") _machine = Machines.FirstOrDefault()?.Name ?? "";
        _now = DkTime.Now;
        _raw = await Prices.GetPricesAsync(s.PriceArea);
        _wash = PriceModel.Build(_raw, s, [Window], _now).Appliances.FirstOrDefault();
        _evKwh = s.EvKwh; _evKw = s.EvKw;
        _night = NightPlanner.Plan(_raw, s, _now, s.EvKwh, s.EvKw);
    }

    private Appliance Device() => Machines.FirstOrDefault(m => m.Name == _machine)
        ?? new() { Name = "Egen", KwhPerRun = Math.Max(0.001, _watt * _hours / 1000), DurationHours = Math.Clamp(_hours, 0.25, 24) };

    private sealed record CostRow(string Label, RunOption Run);

    // "What does it cost now? In an hour? In three?" - plus the cheapest start, exact per quarter.
    private List<CostRow> CostRows(Appliance a)
    {
        var rows = new List<CostRow>();
        if (_raw is null) return rows;
        var s = _s;
        foreach (var (label, h) in new[] { ("Nu", 0), ("Om 1 time", 1), ("Om 2 timer", 2), ("Om 3 timer", 3), ("Om 6 timer", 6) })
            if (PriceModel.CostOfRun(_raw, s, a, _now.AddHours(h)) is { } o) rows.Add(new CostRow(label, o));
        UpdateCheapest(a);
        if (_cheapestDev is { } c && rows.All(r => r.Run.Start != c.Start))
            rows.Add(new CostRow($"Billigst {When(c.Start)}", c));
        return rows;
    }

    // Cheapest start on the 15-minute grid anywhere in the known prices (night included).
    private void UpdateCheapest(Appliance a)
    {
        _cheapestDev = null;
        if (_raw is null) return;
        var s = _s;
        var t = new DateTime(_now.Year, _now.Month, _now.Day, _now.Hour, _now.Minute / 15 * 15, 0);
        var last = _raw.Count > 0 ? _raw.Max(p => p.TimeDk) : _now;
        for (; t <= last; t = t.AddMinutes(15))
            if (PriceModel.CostOfRun(_raw, s, a, t) is { } o && (_cheapestDev is null || o.CostKr < _cheapestDev.CostKr)) _cheapestDev = o;
    }

    private void DeviceChanged()
    {
        _watt = Math.Clamp(_watt, 1, 20000);
        _hours = Math.Clamp(_hours, 0.25, 24);
    }

    private void PickMachine(string name) => _machine = name;

    private void Pick(string key) => _choice = key;

    private async Task EvChangedAsync()
    {
        Store.Update(d =>
        {
            d.Settings.EvKwh = Math.Clamp(_evKwh, 1, 200);
            d.Settings.EvKw = Math.Clamp(_evKw, 0.5, 50);
        });
        await LoadAsync();
    }

    // Best 2-hour start from now on: now itself, later today, or tomorrow (awake hours).
    private static RunOption? Best2(ApplianceView w) =>
        new[] { w.Now, w.CheapestToday, w.CheapestTomorrow }.Where(o => o is not null).MinBy(o => o!.AvgKrPerKwh);

    private string When(DateTime t)
    {
        var d = DateOnly.FromDateTime(t);
        if (d == DateOnly.FromDateTime(_now)) return $"kl. {t:HH}";
        return t.Hour < 7 ? $"i nat kl. {t:HH}" : $"i morgen kl. {t:HH}";
    }

    private static string Kr(double v) => v.ToString("0.00", Da);
}
