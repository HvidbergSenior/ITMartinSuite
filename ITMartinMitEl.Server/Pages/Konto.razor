@page "/konto"
@rendermode InteractiveServer
@inject TenantContext Tenant
@inject AccountService Accounts
@inject AdvisorService Advisors
@inject HouseholdRegistry Registry
@inject NavigationManager Nav

<PageTitle>Konto – MinElpris</PageTitle>

<h1>Konto</h1>
<PageHelp Key="help-konto">
    <p>@Tenant.DisplayName · @Tenant.Email</p>
</PageHelp>

<div class="card">
    <div class="card-title">Skift adgangskode</div>
    <div class="field"><label>Nuværende</label><input type="password" @bind="_current" /></div>
    <div class="field"><label>Ny (mindst @AccountService.MinPasswordLength tegn)</label><input type="password" @bind="_replacement" /></div>
    <button class="btn btn-primary" @onclick="ChangePassword">Gem ny adgangskode</button>
    @if (_passwordMessage is not null)
    {
        <p class="small @(_passwordOk ? "ok" : "err")">@_passwordMessage</p>
    }
</div>

@if (!Tenant.IsAdvisor)
{
    <details class="card fold" open>
        <summary class="card-title">Giv Martin adgang</summary>
        <div class="muted small" style="margin-bottom:8px">
            Skal Martin kigge med i dine tal og hjælpe dig med at spare? Lav en kode og giv ham den.
            Han kan først se noget, når koden er brugt – og du kan altid trække adgangen tilbage igen.
        </div>

        <button class="btn btn-primary" @onclick="CreateCode">Lav en kode</button>
        @if (_newCode is not null)
        {
            <p class="code">@AdvisorService.Pretty(_newCode)</p>
            <p class="muted small">Giv koden til Martin. Den kan bruges én gang og udløber om 30 dage.</p>
        }

        @if (_grants.Count > 0)
        {
            <div style="margin-top:14px">
                @foreach (var g in _grants)
                {
                    <div class="grant">
                        <div>
                            <b>@g.AdvisorName</b>
                            <div class="muted small">
                                @if (g.RevokedUtc is { } revoked)
                                {
                                    <text>Trukket tilbage @revoked.ToLocalTime().ToString("d. MMM yyyy")</text>
                                }
                                else if (g.RedeemedUtc is { } redeemed)
                                {
                                    <text>Adgang siden @redeemed.ToLocalTime().ToString("d. MMM yyyy") · udløber @g.ExpiresUtc.ToLocalTime().ToString("d. MMM yyyy")</text>
                                }
                                else
                                {
                                    <text>Kode @AdvisorService.Pretty(g.Code) – ikke brugt endnu</text>
                                }
                            </div>
                        </div>
                        @if (g.RevokedUtc is null)
                        {
                            <button class="btn" @onclick="() => Revoke(g.Id)">Træk tilbage</button>
                        }
                    </div>
                }
            </div>
        }
    </details>
}

@if (!Tenant.IsAdvisor)
{
    @* More logins for the same home - same meter, same machines, each with their own password. *@
    <details class="card fold" open>
        <summary class="card-title">👥 Husstanden</summary>
        <div class="muted small" style="margin-bottom:8px">Alle her ser det samme: måler, maskiner og historik. Hver har sit eget login.</div>
        @foreach (var m in _members)
        {
            <div class="member-row">
                <span>@m.DisplayName <span class="muted small">@m.Email</span></span>
                @if (m.Id == Tenant.UserId) { <span class="muted small">dig</span> }
                else { <button class="btn btn-small" @onclick="() => RemoveMember(m.Id)">Fjern</button> }
            </div>
        }
        @if (_newMemberPassword is { } pw)
        {
            <div class="note" style="margin-top:10px">
                <b>@_newMemberEmail</b> kan nu logge ind på <b>minelpris.itmartin.dk</b> med adgangskoden
                <b class="code">@pw</b><br />
                Den vises kun nu – giv den videre, og bed om at den skiftes under Konto.
            </div>
        }
        <div class="row2" style="margin-top:10px">
            <div class="field"><label for="mname">Navn</label><input id="mname" type="text" @bind="_memberName" placeholder="Fx Vibeke" /></div>
            <div class="field"><label for="mmail">Mail</label><input id="mmail" type="text" inputmode="email" @bind="_memberEmail" placeholder="navn@mail.dk" /></div>
        </div>
        @if (_memberError is { } me) { <div class="small err">@me</div> }
        <button class="btn btn-primary" @onclick="AddMember">+ Giv adgang til husstanden</button>
    </details>
}

<details class="card fold" open>
    <summary class="card-title">Dine data</summary>
    <div class="muted small">
        Appen gemmer det, du selv taster – apparater, enheder og indstillinger – og de timetal, den henter
        fra din elmåler, når du har givet den en token fra Eloverblik. Tallene ligger på Martins server i
        Danmark og bliver ikke delt med nogen, medmindre du selv giver adgang med en kode.
    </div>

    @if (!_confirmDelete)
    {
        <button class="btn btn-danger" style="margin-top:10px" @onclick="() => _confirmDelete = true">Slet min konto</button>
    }
    else
    {
        <p class="small err" style="margin-top:10px">
            @(_members.Count > 1
                ? "Sletter du kontoen, forsvinder kun dit login – hjemmet og dataene bliver hos de andre i husstanden."
                : "Sletter du kontoen, forsvinder hjemmet, målertoken, forbrugshistorik og alle adgange. Det kan ikke fortrydes.")
        </p>
        <button class="btn btn-danger" @onclick="DeleteAccount">Ja, slet det hele</button>
        <button class="btn" @onclick="() => _confirmDelete = false">Fortryd</button>
    }
</details>

<details class="card fold" open>
    <summary class="card-title">Log ud</summary>
    <a class="btn" href="/logout">Log ud af MinElpris</a>
</details>

@code {
    private string _current = "";
    private string _replacement = "";
    private string? _passwordMessage;
    private bool _passwordOk;
    private string? _newCode;
    private bool _confirmDelete;
    private List<GrantView> _grants = [];

    private List<UserAccount> _members = [];
    private string _memberName = "", _memberEmail = "";
    private string? _memberError, _newMemberPassword, _newMemberEmail;

    protected override async Task OnInitializedAsync()
    {
        await LoadGrantsAsync();
        await LoadMembersAsync();
    }

    private async Task LoadMembersAsync()
    {
        if (Tenant.IsAdvisor || Tenant.OwnHouseholdId is not { } householdId) return;
        _members = await Accounts.MembersAsync(householdId);
    }

    private async Task AddMember()
    {
        _memberError = null; _newMemberPassword = null;
        if (Tenant.OwnHouseholdId is not { } householdId) return;
        var (result, password) = await Accounts.AddMemberAsync(householdId, _memberEmail, _memberName);
        if (!result.Ok) { _memberError = result.Error; return; }
        _newMemberEmail = result.User!.Email;
        _newMemberPassword = password;
        _memberName = _memberEmail = "";
        await LoadMembersAsync();
    }

    private async Task RemoveMember(Guid id)
    {
        if (Tenant.OwnHouseholdId is not { } householdId || Tenant.UserId is not { } me) return;
        await Accounts.RemoveMemberAsync(householdId, id, me);
        await LoadMembersAsync();
    }

    private async Task LoadGrantsAsync()
    {
        if (Tenant.IsAdvisor) return;
        if (await Tenant.CurrentHouseholdIdAsync() is not { } householdId) return;
        _grants = await Advisors.GrantsForHouseholdAsync(householdId);
    }

    private async Task ChangePassword()
    {
        if (Tenant.UserId is not { } userId) return;
        var result = await Accounts.ChangePasswordAsync(userId, _current, _replacement);
        _passwordOk = result.Ok;
        _passwordMessage = result.Ok ? "Adgangskoden er skiftet." : result.Error;
        if (result.Ok) { _current = ""; _replacement = ""; }
    }

    private async Task CreateCode()
    {
        if (await Tenant.CurrentHouseholdIdAsync() is not { } householdId) return;
        _newCode = await Advisors.CreateCodeAsync(householdId);
        await LoadGrantsAsync();
    }

    private async Task Revoke(Guid grantId)
    {
        if (await Tenant.CurrentHouseholdIdAsync() is not { } householdId) return;
        await Advisors.RevokeAsync(householdId, grantId);
        await LoadGrantsAsync();
    }

    private async Task DeleteAccount()
    {
        if (Tenant.UserId is not { } userId) return;
        var householdId = await Tenant.CurrentHouseholdIdAsync();
        // True only when the last person left and the household itself went.
        if (await Accounts.DeleteAccountAsync(userId) && householdId is { } id) Registry.Forget(id);
        Nav.NavigateTo("/logout", forceLoad: true);
    }
}
