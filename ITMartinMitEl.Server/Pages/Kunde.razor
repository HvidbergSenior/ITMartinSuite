@page "/kunder/{Id:guid}"
@rendermode InteractiveServer
@inject TenantContext Tenant
@inject CustomerSetupReader Setup

<PageTitle>Opsætning – MinElpris</PageTitle>

@if (!_loaded)
{
    <p class="k-muted">Henter…</p>
}
else if (_facts is null)
{
    <h1>Opsætning</h1>
    <p class="k-muted">Du har ikke adgang til den kunde (længere). Kunden giver adgang med en kode under <b>Konto</b>. <a href="/kunder">Tilbage til Kunder</a></p>
}
else
{
    <h1>Opsætning · @_facts.HouseholdName</h1>
    <p class="k-muted small" style="margin:4px 0 12px">
        Det her gør du sammen med kunden – ved besøget eller over Snak/telefon. Det meste krydser sig selv af, når kundens
        data er på plads; resten krydser du af. Til sidst får kunden overdragelsesarket.
    </p>

    <div class="k-card">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
            <b>@_done af @_total klar</b>
            <span style="display:flex;gap:8px;flex-wrap:wrap">
                <a class="k-btn k-btn-sm" href="@($"/vaelg/{Id}")">Åbn kundens app</a>
                <a class="k-btn k-btn-primary k-btn-sm" href="@($"/kunder/{Id}/overdragelse")">Overdragelsesark</a>
            </span>
        </div>
        <div style="height:8px;border-radius:6px;background:var(--k-line,#ddd);margin-top:10px;overflow:hidden">
            <div style="height:100%;width:@(_total == 0 ? 0 : _done * 100 / _total)%;background:var(--k-accent,#1f7a5c)"></div>
        </div>
    </div>

    @foreach (var s in _states)
    {
        <div class="k-card" style="padding:12px 14px">
            <div style="display:flex;gap:10px;align-items:flex-start">
                <span style="font-size:20px;line-height:1.2">@(s.Done ? "✅" : "⬜")</span>
                <div style="flex:1">
                    <b>@s.Step.Title</b>
                    <div class="k-muted small">
                        @if (s.Step.IsAuto)
                        {
                            @(s.Done ? "Krydset af automatisk – data er på plads." : "Krydser sig selv af, når det er gjort.")
                        }
                        else if (s.TickedUtc is { } at)
                        {
                            @($"Krydset af {at.ToLocalTime().ToString("d. MMM 'kl.' HH:mm", CustomerSetup.Da)}")
                        }
                    </div>
                    <details style="margin-top:4px">
                        <summary class="small">Sådan gør du</summary>
                        <div class="small" style="margin-top:4px">@s.Step.How</div>
                    </details>
                </div>
                @if (!s.Step.IsAuto)
                {
                    <button class="k-btn k-btn-sm @(s.Done ? "" : "k-btn-primary")" @onclick="() => Toggle(s)">@(s.Done ? "Fortryd" : "Klar")</button>
                }
            </div>
        </div>
    }

    <div class="k-card">
        <h2 class="k-card-title">Det aftalte vi</h2>
        <div class="k-muted small" style="margin-bottom:6px">Står på overdragelsesarket. Fx "Flyt opvasken til efter kl. 21" eller "Ring i januar, når vinterregningen er kommet".</div>
        <textarea @bind="_notes" rows="4" style="width:100%"></textarea>
        <button class="k-btn k-btn-sm" style="margin-top:6px" @onclick="SaveNotes">Gem</button>
        @if (_saved) { <span class="small ok" style="margin-left:8px">Gemt</span> }
    </div>

    <p class="small"><a href="/kunder">← Alle kunder</a></p>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loaded, _saved;
    private SetupFacts? _facts;
    private List<SetupStepState> _states = [];
    private int _done, _total;
    private string _notes = "";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loaded = true;
        if (!Tenant.IsAdvisor || Tenant.UserId is not { } advisorId || await Setup.ReadAsync(advisorId, Id) is not { } r)
        {
            _facts = null;
            return;
        }
        _facts = r.Facts;
        _states = CustomerSetup.Evaluate(r.Facts, r.Data.SetupTicks);
        (_done, _total) = CustomerSetup.Progress(_states);
        _notes = r.Data.AdvisorNotes;
    }

    private async Task Toggle(SetupStepState s)
    {
        Setup.Tick(Id, s.Step.Id, !s.Done);
        await LoadAsync();
    }

    private void SaveNotes()
    {
        Setup.SaveNotes(Id, _notes);
        _saved = true;
    }
}
