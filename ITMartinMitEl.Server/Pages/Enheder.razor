@page "/enheder"
@using ITMartinElPriser.Infrastructure
@using System.Globalization
@inject ElectricityPriceService Prices
@inject PriceProfileService Profiles
@inject HouseholdStore Store
@inject ConsumptionStore Consumption
@inject PhotoReader Photos

<PageTitle>Enheder – MinElpris</PageTitle>

<h1>Hvad koster hver enhed?</h1>
<PageHelp Key="help-enheder">
    <p>Hver maskine og hvert apparat i huset, prissat med jeres egen elpris.</p>
</PageHelp>

@if (_loading)
{
    <div class="card muted">Regner…</div>
}
else
{
    var listKwhDay = _devices.Sum(d => d.KwhPerDay) + _appliances.Sum(a => a.Appliance.KwhPerRun * a.Appliance.RunsPerWeek / 7);
    var alwaysOnKwhDay = _devices.Where(d => d.Device.HoursPerDay >= 24).Sum(d => d.KwhPerDay);
    var yearKwh = _meterKwhPerDay is { } mkY ? mkY * 365 : (double?)null;
    var avgPrice = _profile?.Average ?? 0;

    @* Camera only (user decision 2026-09-27): a photo of the plate or energy label sets the machine up.
       Nothing here can be typed or edited - a wrong one is removed and photographed again. *@
    <div class="card">
        <div class="card-title">📷 Dine maskiner og apparater</div>
        <div class="muted small" style="margin-bottom:8px">Tag et billede af mærkepladen eller energimærket – så finder appen model, forbrug og hvad en ny sparemodel ville spare.</div>
        <CameraButton Text="📷 Tilføj med kamera" BusyText="Læser mærkepladen…" Busy="_reading" OnPhoto="AddFromPhotoAsync" />
        @if (_photoError is { } pe) { <div class="small err" style="margin-top:8px">@pe</div> }
        @if (_photoAdded is { } pa) { <div class="small lvl-cheap" style="margin-top:8px">✔ @pa</div> }

        @foreach (var a in Store.Get().Appliances.OrderBy(x => x.SortOrder))
        {
            var aYear = a.Photo?.KwhPerYear is > 0 ? a.Photo.KwhPerYear : a.KwhPerRun * a.RunsPerWeek * 52;
            <div class="dev-card">
                <div class="dev-head">
                    <span class="de-icon">@a.Icon</span>
                    <div class="de-main"><b>@a.Name</b> <span class="muted small">@a.Model</span>
                        <div class="muted small">@a.KwhPerRun.ToString("0.0#", Da) kWh pr. tur · @a.DurationHours.ToString("0.#", Da) t · ca. @a.RunsPerWeek.ToString("0.#", Da) gange om ugen</div></div>
                    @if (a.Photo?.EnergyClass is { Length: > 0 } ec) { <span class="dev-class">@ec</span> }
                </div>
                @Compare(aYear, a.Photo)
                <div class="dev-actions">
                    @if (a.Photo is null) { <span class="muted small">Ikke fra billede – tag et billede af mærkepladen for model og sammenligning.</span> }
                    <button class="btn btn-small" @onclick="() => RemoveMachine(a.Id)">Fjern</button>
                </div>
            </div>
        }
        @foreach (var d in Store.Get().Devices.OrderBy(x => x.SortOrder))
        {
            var dYear = d.Photo?.KwhPerYear is > 0 ? d.Photo.KwhPerYear : d.KwhPerYear;
            <div class="dev-card">
                <div class="dev-head">
                    <span class="de-icon">@d.Icon</span>
                    <div class="de-main"><b>@d.Name</b> <span class="muted small">@d.Model</span>
                        <div class="muted small">ca. @d.Watts.ToString("0", Da) W · @(d.HoursPerDay >= 24 ? "altid tændt" : $"{d.HoursPerDay.ToString("0.#", Da)} t om dagen")</div></div>
                    @if (d.Photo?.EnergyClass is { Length: > 0 } ec) { <span class="dev-class">@ec</span> }
                </div>
                @Compare(dYear, d.Photo)
                <div class="dev-actions">
                    @if (d.Photo is null) { <span class="muted small">Ikke fra billede – tag et billede af typeskiltet for model og sammenligning.</span> }
                    <button class="btn btn-small" @onclick="() => RemoveDevice(d.Id)">Fjern</button>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-title" style="display:flex;justify-content:space-between;align-items:center;cursor:pointer" @onclick="() => _guideOpen = !_guideOpen">
            <span>🔎 Sådan finder du strømslugerne</span><span>@(_guideOpen ? "▲" : "▼")</span>
        </div>
        @if (_guideOpen)
        {
            <ol class="guide">
                <li>
                    <b>Start med det samlede tal.</b> Et hus uden elvarme bruger typisk 3.500–5.000 kWh om året; med varmepumpe eller elbil 8.000–15.000.
                    @if (yearKwh is { } yk)
                    {
                        <div class="guide-fact">Jeres måler: <b>@_meterKwhPerDay!.Value.ToString("0.0", Da) kWh/dag ≈ @yk.ToString("0", Da) kWh/år ≈ @((yk * avgPrice).ToString("0", Da)) kr/år</b> ved jeres nuværende pris@(_meterDays > 0 ? $" (snit af {_meterDays} målte døgn)" : "").</div>
                    }
                    else
                    {
                        <div class="guide-fact muted">Forbind elmåleren under <a href="/indstillinger">Indstillinger</a>, så står jeres eget tal her.</div>
                    }
                </li>
                <li>
                    <b>Se på natten.</b> Forbruget kl. 02–05, når alle sover, er husets <i>grundlast</i>: køleskabe, frysere, router, server, pumper og standby. Den kører 8.760 timer om året, så hver 10 W koster ca. @((0.01 * 8760 * avgPrice).ToString("0", Da)) kr/år.
                    @if (_baseLoadW is { } bw)
                    {
                        var baseKwhYear = bw / 1000 * 8760;
                        var listAlwaysOnW = alwaysOnKwhDay * 1000 / 24;
                        var gap = bw - listAlwaysOnW;
                        <div class="guide-fact">Jeres grundlast: <b>@bw.ToString("0", Da) W ≈ @baseKwhYear.ToString("0", Da) kWh/år ≈ @((baseKwhYear * avgPrice).ToString("0", Da)) kr/år</b>@(yearKwh is { } y2 && y2 > 0 ? $" – {(baseKwhYear / y2 * 100).ToString("0", Da)} % af hele forbruget" : "").
                            De enheder på listen der altid er tændt giver @listAlwaysOnW.ToString("0", Da) W.
                            @if (gap > 30) { <span class="lvl-expensive">Der mangler ca. @gap.ToString("0", Da) W – noget kører om natten, som ikke står på listen.</span> }
                            else if (gap < -30) { <span class="lvl-mid">Listen ligger @((-gap).ToString("0", Da)) W over det målte – nogle watt-tal er sat for højt.</span> }
                            else { <span class="lvl-cheap">Listen passer med det målte.</span> }
                        </div>
                    }
                </li>
                <li>
                    <b>Tag billeder af alt og sammenlign med måleren.</b> Tag et billede af hver enheds mærkeplade med 📷 ovenfor. Kig i skabe, bryggers, garage og udhus – den gamle fryser og cirkulationspumpen glemmes altid.
                    @if (_meterKwhPerDay is { } mk3 && mk3 > 0)
                    {
                        var pct = listKwhDay / mk3 * 100;
                        <div class="guide-fact">Listen forklarer nu <b class="@(pct > 115 ? "lvl-expensive" : pct < 60 ? "lvl-mid" : "lvl-cheap")">@pct.ToString("0", Da) %</b> af det målte. Målet er 85–110 %.</div>
                    }
                </li>
                <li>
                    <b>Mål de mistænkte.</b> En elmåler til stikkontakten (ca. 100 kr) i et døgn på fryseren, tumbleren, affugteren, spabadet – så ved du om billedets tal passer. Store faste ting (varmepumpe, vandvarmer): sluk et døgn og se hvor meget måleren falder på <a href="/forbrug">Forbrug</a>.
                </li>
                <li>
                    <b>Kig på dagsprofilen.</b> På <a href="/forbrug">Forbrug</a> ses hver time. Høje timer midt på dagen når ingen er hjemme = noget kører på timer eller termostat. Toppe om aftenen = madlavning, tv, opvask – flyt det der kan flyttes.
                    @if (_peakHour is { } ph)
                    {
                        <div class="guide-fact">Jeres dyreste time i snit er kl. @ph.Hour–@((ph.Hour + 1) % 24) med @ph.Kwh.ToString("0.00", Da) kWh; kl. 02–05 ligger på @((_baseLoadW ?? 0) / 1000).ToString("0.00", Da).</div>
                    }
                </li>
                <li>
                    <b>De sædvanlige syndere</b>, i rækkefølge: elvarme og varmt vand · gammel fryser eller ekstra køleskab · tørretumbler · elbil · spabad/pool · gaming-pc og skærme der aldrig slukkes · akvarie · cirkulationspumpe der kører hele året.
                </li>
            </ol>
        }
    </div>

    if (_devices.Count == 0 && _appliances.Count == 0)
    {
    <details class="card fold" open>
        <summary class="card-title">Ingen enheder endnu</summary>
        <p class="small">Tag et billede af mærkepladen på køleskab, fryser, tv, varmepumpe, vaskemaskine osv. med 📷 ovenfor.</p>
    </details>
    }
    else
    {
    var totalDay = _devices.Sum(d => d.DayKr) + _appliances.Sum(a => a.MonthKr) * 12 / 365;
    var totalMonth = _devices.Sum(d => d.MonthKr) + _appliances.Sum(a => a.MonthKr);
    var totalYear = _devices.Sum(d => d.YearKr) + _appliances.Sum(a => a.YearKr);
    var kwhDay = _devices.Sum(d => d.KwhPerDay) + _appliances.Sum(a => a.Appliance.KwhPerRun * a.Appliance.RunsPerWeek / 7);
    var shiftSaving = _devices.Sum(d => d.SavingPerDayKr ?? 0);

    <div class="card now-tile">
        <div class="now-price">@Kr(Pick(totalDay, totalMonth, totalYear))</div>
        <div class="now-unit">kr pr. @PeriodName() · @(Pick(kwhDay, kwhDay * 365 / 12, kwhDay * 365).ToString("0", Da)) kWh · @_devices.Count enheder + @_appliances.Count maskiner</div>
        @if (_meterKwhPerDay is { } mk && mk > 0)
        {
            var pct = kwhDay / mk * 100;
            <div class="now-compare">Måleren viser <b>@mk.ToString("0.0", Da) kWh/dag</b> i snit – listen forklarer <b class="@(pct > 115 ? "lvl-expensive" : pct < 60 ? "lvl-mid" : "lvl-cheap")">@pct.ToString("0", Da) %</b> af det@(pct > 115 ? " – nogle tal er sat for højt" : pct < 60 ? " – der mangler nok enheder" : "").</div>
        }
        else
        {
            <div class="now-compare muted">Forbind elmåleren under Indstillinger, så ses hvor stor en del af det målte forbrug listen forklarer.</div>
        }
        @if (shiftSaving > 0.01)
        {
            <div class="now-compare">Flyttes de flytbare enheder til billigste tid: <b class="lvl-cheap">spar @Kr(Pick(shiftSaving, shiftSaving * 365 / 12, shiftSaving * 365)) kr pr. @PeriodName()</b></div>
        }
    </div>

    <div class="period-tabs">
        <button class="tab @(_period == 0 ? "on" : "")" @onclick="() => _period = 0">Pr. dag</button>
        <button class="tab @(_period == 1 ? "on" : "")" @onclick="() => _period = 1">Pr. måned</button>
        <button class="tab @(_period == 2 ? "on" : "")" @onclick="() => _period = 2">Pr. år</button>
    </div>

    @if (_appliances.Count > 0)
    {
        <details class="card fold" open>
            <summary class="card-title">Pr. tur – maskiner</summary>
            @foreach (var a in _appliances)
            {
                var v = _snap?.Appliances.FirstOrDefault(x => x.Appliance.Id == a.Appliance.Id);
                <div class="dev-row">
                    <div class="dev-icon">@a.Appliance.Icon</div>
                    <div class="dev-name">@a.Appliance.Name <span class="muted">· @(a.Appliance.Programs.Count > 0 ? "gns. " : "")@a.Appliance.KwhPerRun.ToString("0.#", Da) kWh · @a.Appliance.RunsPerWeek.ToString("0.#", Da) ture/uge@(a.Appliance.Programs.Count > 0 ? $" ({string.Join(", ", a.Appliance.Programs.Select(p => p.Name))})" : "")</span></div>
                    <div class="dev-kr">@Kr(Pick(a.MonthKr * 12 / 365, a.MonthKr, a.YearKr)) kr</div>
                    <div class="dev-sub">
                        <span>Én tur: <b>@a.PerRunKr.ToString("0.00", Da) kr</b> <span class="muted">(@a.Basis)</span></span>
                        @if (v?.Now is { } n)
                        {
                            <span>
                                I dag: nu <b>@n.CostKr.ToString("0.00", Da)</b>
                                @if (v.CheapestToday is { } c) { <text> · billigst kl. @c.Start.ToString("HH:mm") <b class="lvl-cheap">@c.CostKr.ToString("0.00", Da)</b></text> }
                                @if (v.DearestUpcoming is { } dd) { <text> · dyrest <b class="lvl-expensive">@dd.CostKr.ToString("0.00", Da)</b></text> }
                            </span>
                        }
                    </div>
                    @if (totalDay > 0) { <div class="dev-share" style="width:@((a.MonthKr / totalMonth * 100).ToString("0", CultureInfo.InvariantCulture))%"></div> }
                </div>
            }
        </details>
    }

    @if (_devices.Count > 0)
    {
        <details class="card fold" open>
            <summary class="card-title">Enheder</summary>
            @foreach (var d in _devices.OrderByDescending(x => x.DayKr))
            {
                var dev = d.Device;
                <div class="dev-row">
                    <div class="dev-icon">@dev.Icon</div>
                    <div class="dev-name">@dev.Name <span class="muted">· @dev.Watts.ToString("0", Da) W · @(dev.HoursPerDay >= 24 ? "altid tændt" : $"{dev.HoursPerDay.ToString("0.#", Da)} t/dag{(dev.UsualFromHour is { } uf ? $" fra kl. {uf}" : "")}")@(dev.DaysPerWeek < 7 ? $" · {dev.DaysPerWeek} dage/uge" : "")</span></div>
                    <div class="dev-kr">@Kr(Pick(d.DayKr, d.MonthKr, d.YearKr)) kr</div>
                    <div class="dev-sub">
                        <span>@Pick(d.KwhPerDay, d.KwhPerDay * 365 / 12, d.KwhPerDay * 365).ToString("0.#", Da) kWh · @d.AvgKrPerKwh.ToString("0.00", Da) kr/kWh</span>
                        @if (d.SavingPerDayKr is { } sv && d.BestFromHour is { } bf)
                        {
                            <span class="lvl-cheap">Flyt til kl. @bf–@((bf + (int)Math.Ceiling(dev.HoursPerDay)) % 24): spar @Kr(Pick(sv, sv * 365 / 12, sv * 365)) kr</span>
                        }
                        else if (dev.Shiftable && d.BestFromHour is { } bf2)
                        {
                            <span class="lvl-cheap">Kører allerede i billigste tidsrum</span>
                        }
                        @if (_meterKwhPerDay is { } mk2 && mk2 > 0)
                        {
                            <span class="muted">@((d.KwhPerDay / mk2 * 100).ToString("0", Da)) % af måleren</span>
                        }
                    </div>
                    @if (totalDay > 0) { <div class="dev-share" style="width:@((d.DayKr / totalDay * 100).ToString("0", CultureInfo.InvariantCulture))%"></div> }
                </div>
            }
        </details>
    }

    <div class="muted small" style="margin-top:8px">
        Måned og år er regnet med jeres typiske døgnkurve (snit af de sidste @_profileDays dage@(_snap?.AllIn == false ? ", spotpris" : ", alt inkl.")) – ikke dagens pris alene. Enheder med et fast tidsrum prissættes for netop de timer.
        Ret tal og tidsrum under <a href="/indstillinger">Indstillinger</a>.
    </div>
    }
}

@code {
    private static readonly CultureInfo Da = new("da-DK");

    private bool _loading = true;
    private int _period = 1;
    private int _profileDays;
    private PriceSnapshot? _snap;
    private List<DeviceCost> _devices = [];
    private List<ApplianceCost> _appliances = [];
    private double? _meterKwhPerDay;
    private int _meterDays;
    private double? _baseLoadW;
    private (int Hour, double Kwh)? _peakHour;
    private HourProfile? _profile;
    private bool _guideOpen = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private bool _reading;
    private string? _photoError, _photoAdded;

    private async Task AddFromPhotoAsync((byte[] Bytes, string Mime) photo)
    {
        _reading = true; _photoError = null; _photoAdded = null;
        // The demo never calls the paid AI - it would cost money for every visitor who tries.
        if (DemoHousehold.IsDemo(Store.HouseholdId)) { _reading = false; _photoError = "I demoen læser vi ikke billeder – opret din egen MinElpris for at tage billede af dine egne apparater."; return; }
        StateHasChanged();
        try
        {
            var found = await Photos.IdentifyAsync(photo.Bytes, photo.Mime);
            Store.Update(d =>
            {
                if (found.Machine is { } m) { m.SortOrder = d.Appliances.Count; d.Appliances.Add(m); }
                if (found.Device is { } dv) { dv.SortOrder = d.Devices.Count; d.Devices.Add(dv); }
            });
            var name = found.Machine?.Name ?? found.Device?.Name;
            var model = found.Machine?.Model ?? found.Device?.Model;
            _photoAdded = $"{name} {model} er tilføjet.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or System.Text.Json.JsonException)
        {
            _photoError = ex.Message;
        }
        finally { _reading = false; }
    }

    private async Task RemoveMachine(Guid id) { Store.Update(d => d.Appliances.RemoveAll(a => a.Id == id)); await LoadAsync(); }
    private async Task RemoveDevice(Guid id) { Store.Update(d => d.Devices.RemoveAll(x => x.Id == id)); await LoadAsync(); }

    // Yours vs a new energy-saving model of the same kind, a year at a time at your own average price.
    private RenderFragment Compare(double yearKwh, PhotoFacts? p) => __builder =>
    {
        var price = _profile?.Average ?? 0;
        var newKwh = p?.NewModelKwhPerYear ?? 0;
        <table class="dev-table">
            <tr><th></th><th>Bruger / år</th><th>Koster / år</th></tr>
            <tr><td>Din</td><td>@yearKwh.ToString("0", Da) kWh</td><td>@((yearKwh * price).ToString("0", Da)) kr</td></tr>
            @if (newKwh > 0)
            {
                <tr><td>Ny sparemodel (AI-skøn): @p!.NewModelName</td><td>@newKwh.ToString("0", Da) kWh</td><td>@((newKwh * price).ToString("0", Da)) kr</td></tr>
                <tr><td colspan="2" class="dev-save">Du kan spare</td><td class="dev-save">@(Math.Max(0, (yearKwh - newKwh) * price).ToString("0", Da)) kr/år</td></tr>
            }
        </table>
        @if (newKwh > 0 && p!.NewModelSource.Length > 0) { <div class="muted small">Kilde ifølge AI: @p.NewModelSource · @p.Note</div> }
        else if (p?.Note is { Length: > 0 } note) { <div class="muted small">@note</div> }
    };

    private async Task LoadAsync()
    {
        _loading = true;
        var data = Store.Get();
        var (profile, profileDays) = await Profiles.GetTypicalAsync();
        _profileDays = profileDays;

        // Today's actual curve for the "now / cheapest / dearest" per run.
        var raw = await Prices.GetPricesAsync(data.Settings.PriceArea);
        _snap = PriceModel.Build(raw, data.Settings, data.Appliances, DkTime.Now);

        // No history yet (first run of the day after a restart)? Fall back to today.
        if (profileDays == 0 && _snap.HasData)
            profile = HourProfile.FromPoints(raw.Select(p => PriceBreakdownCalculator.Compute(p, data.Settings)), data.Settings.ShowAllIn);

        _profile = profile;
        var recent = data.Runs.Where(r => r.StartedAt >= DkTime.Now.AddDays(-60)).ToList();
        _devices = data.Devices.OrderBy(d => d.SortOrder).Select(d => DeviceCostModel.Price(d, profile)).ToList();
        _appliances = data.Appliances.OrderBy(a => a.SortOrder).Select(a => DeviceCostModel.Price(a, profile, recent)).ToList();

        // Meter: average of the last full days we have readings for.
        if (Consumption.LatestDay is { } latest)
        {
            var days = Enumerable.Range(0, 14).Select(i => Consumption.Day(latest.AddDays(-i))).Where(d => d.Count >= 20).ToList();
            if (days.Count > 0)
            {
                _meterDays = days.Count;
                _meterKwhPerDay = days.Average(d => d.Values.Sum());
                // Base load = what runs while everyone sleeps, in watts.
                var night = days.SelectMany(d => d.Where(kv => kv.Key is >= 2 and <= 5)).Select(kv => kv.Value).ToList();
                if (night.Count > 0) _baseLoadW = night.Average() * 1000;
                _peakHour = Enumerable.Range(0, 24).Select(h => (Hour: h, Kwh: days.Average(d => d.GetValueOrDefault(h)))).MaxBy(x => x.Kwh);
            }
        }
        _loading = false;
    }

    private double Pick(double day, double month, double year) => _period switch { 0 => day, 1 => month, _ => year };
    private string PeriodName() => _period switch { 0 => "dag", 1 => "måned", _ => "år" };
    private string Kr(double v) => v >= 100 ? v.ToString("0", Da) : v.ToString("0.00", Da);
}
