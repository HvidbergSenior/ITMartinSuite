@page "/regning"
@using System.Globalization
@inject ElectricityPriceService Prices
@inject HouseholdStore Store
@inject ConsumptionStore Consumption

<PageTitle>Regning – MinElpris</PageTitle>

<h1>Din elregning</h1>
<p class="muted small" style="margin:4px 0 14px">Regnet fra måleren time for time – og hvad hver linje på regningen egentlig er. Time for time: <a href="/forbrug">Forbrug</a>.</p>

@if (string.IsNullOrWhiteSpace(Store.Get().Settings.MeteringPointId))
{
    <div class="card">
        <div class="card-title">Ikke forbundet</div>
        <p class="small">Forbind din elmåler under <a href="/indstillinger">Indstillinger</a> – så regnes regningen her fra dit faktiske forbrug.</p>
    </div>
}
else if (_bill is null)
{
    <div class="card muted">Regner…</div>
}
else
{
    var b = _bill;
    <div class="day-tabs" style="overflow-x:auto">
        @for (var i = 0; i < _months.Count; i++)
        {
            var idx = i;
            <button class="tab @(idx == _sel ? "on" : "")" style="flex:none;padding:8px 12px" @onclick="() => SelectAsync(idx)">@_months[idx].ToString("MMM yyyy", Da)</button>
        }
    </div>

    <div class="card now-tile">
        @if (b.IsComplete)
        {
            <div class="now-price">@b.TotalKr.ToString("0", Da)</div>
            <div class="now-unit">kr for @b.From.ToString("MMMM", Da) · @b.Kwh.ToString("0", Da) kWh · @((b.Kwh > 0 ? b.TotalKr / b.Kwh : 0).ToString("0.00", Da)) kr/kWh alt inkl.</div>
        }
        else if (b.DaysMeasured > 0)
        {
            <div class="now-price">≈ @b.ProjectedKr.ToString("0", Da)</div>
            <div class="now-unit">kr forventet for hele @b.From.ToString("MMMM", Da) · ≈ @b.ProjectedKwh.ToString("0", Da) kWh</div>
            <div class="now-compare">Indtil nu: <b>@b.TotalKr.ToString("0.00", Da) kr</b> for @b.Kwh.ToString("0.0", Da) kWh over @b.DaysMeasured af @b.DaysInPeriod dage (måleren er 1–2 dage bagud).</div>
        }
        else
        {
            <div class="now-verdict lvl-mid">Ingen målinger for måneden</div>
        }
        @if (b.DaysMeasured > 0)
        {
            var moms = b.Lines.First(l => l.Id == "moms").Kr;
            var stat = b.Lines.Where(l => l.Id is "afgift" or "energinet").Sum(l => l.Kr) + moms;
            var el = b.Lines.First(l => l.Id == "spot").Kr;
            <div class="now-compare">Selve strømmen er <b>@((el / b.TotalKr * 100).ToString("0", Da)) %</b> af regningen · staten (afgift, Energinet, moms) <b>@((stat / b.TotalKr * 100).ToString("0", Da)) %</b> · resten er transport og abonnementer.</div>
        }
    </div>

    <div class="card">
        <div class="card-title">Linje for linje – tryk for forklaring</div>
        @foreach (var l in b.Lines)
        {
            var open = _open == l.Id;
            <div class="bill-line" @onclick="() => _open = open ? null : l.Id">
                <div class="appl-row">
                    <span><b>@l.Title</b> <span class="muted small">· @l.Recipient@(l.IsFixed ? " · fast" : "")</span></span>
                    <b>@l.Kr.ToString("0.00", Da) kr</b>
                </div>
                @if (b.TotalKr > 0) { <div class="bill-bar"><i style="width:@((l.Kr / b.TotalKr * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></i></div> }
                @if (open)
                {
                    <div class="bill-explain">
                        <p>@l.What</p>
                        <p><b>Kan du gøre noget?</b> @l.Influence</p>
                        @if (!string.IsNullOrEmpty(l.Tip)) { <p class="lvl-cheap">💡 @l.Tip</p> }
                    </div>
                }
            </div>
        }
        <div class="appl-row" style="padding-top:10px;font-weight:700"><span>I alt@(b.IsComplete ? "" : " indtil nu")</span><b>@b.TotalKr.ToString("0.00", Da) kr</b></div>
    </div>

    <div class="card">
        <div class="card-title">Sådan læser du regningen</div>
        <div class="small">
            <p><b>Én regning, tre modtagere.</b> Elleverandøren (@_supplierName) sender regningen, men beholder kun strømmen, tillægget og sit abonnement. Nettarif og net-abonnement sendes videre til netselskabet (@_gridName), og afgift, Energinet-tariffer og moms går til staten. Leverandøren er altså bare kassereren for det meste af beløbet.</p>
            <p><b>Det du kan vælge:</b> kun leverandøren. Netselskab, tariffer og afgifter er de samme uanset hvem du handler hos. Når du sammenligner tilbud, så se udelukkende på tillæg pr. kWh + abonnement.</p>
            <p><b>Det du kan flytte:</b> spotprisen og nettariffen afhænger af tidspunktet. Det er derfor appen sender besked om billigste tid – de to poster er typisk halvdelen af regningen.</p>
            <p><b>Det du kun kan skrue ned:</b> Energinet, elafgift og moms følger antal kWh. Mindre forbrug er det eneste der virker – se <a href="/enheder">Enheder</a> for hvor det sidder.</p>
            <p><b>Aconto og årsopgørelse:</b> mange betaler et fast aconto-beløb hver måned og får en efterregning eller penge tilbage én gang om året. Beløbet her er hvad måneden <i>faktisk</i> kostede – ikke det der blev trukket. Sammenlign med "forbrug i perioden" på årsopgørelsen.</p>
            <p class="muted">Tallene for abonnementer er fra appens forudsætninger (@_supplierName / @_gridName) – ret dem under Indstillinger hvis regningen siger noget andet. Vinterens høj- og spidslasttariffer er skøn indtil en vinterregning er tjekket.</p>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private List<DateOnly> _months = [];
    private int _sel;
    private Bill? _bill;
    private string? _open;
    private string _supplierName = "";
    private string _gridName = "";

    protected override async Task OnInitializedAsync()
    {
        var s = Store.Get().Settings;
        _supplierName = SupplierPreset.All.FirstOrDefault(p => p.Id == s.SupplierId)?.Name ?? "elleverandøren";
        _gridName = GridCompanyPreset.All.FirstOrDefault(g => g.Id == s.GridCompanyId)?.Name ?? "netselskabet";

        var today = DateOnly.FromDateTime(DkTime.Now);
        var thisMonth = new DateOnly(today.Year, today.Month, 1);
        _months = [thisMonth];
        // Earlier months only if the store has readings in them.
        for (var m = thisMonth.AddMonths(-1); m >= thisMonth.AddMonths(-12); m = m.AddMonths(-1))
            if (Consumption.Range(m, m.AddMonths(1)).Count > 0) _months.Add(m);
        await SelectAsync(0);
    }

    private async Task SelectAsync(int idx)
    {
        _sel = idx;
        _bill = null;
        var s = Store.Get().Settings;
        var from = _months[idx];
        var to = from.AddMonths(1);
        var kwh = Consumption.Range(from, to);
        var priced = new List<PricedPoint>();
        if (kwh.Count > 0)
        {
            var lo = DateOnly.FromDateTime(kwh.Keys.Min());
            var hi = DateOnly.FromDateTime(kwh.Keys.Max()).AddDays(1);
            priced = (await Prices.GetRangeAsync(lo, hi, s.PriceArea)).Select(p => PriceBreakdownCalculator.Compute(p, s)).ToList();
        }
        _bill = BillCalculator.Build(from, to, kwh, priced, s);
    }
}
