@page "/mad"
@using ITMartinElPriser.Application
@using System.Globalization
@inject MealUseCases Meals

<PageTitle>Mad – MinElpris</PageTitle>

@* A meal = several cooking devices together (user 2026-10-29). Like the free app: the page only shows and calls
   MealUseCases; every box is a k-card with a heading, so kolibri.js folds it. Tapped together - never typed. *@
<h1>Hvad koster maden?</h1>

<PageHelp Key="help-mad">
    <ul>
        <li>Hvert måltid er <b>flere apparater på én gang</b> – fx ovn, kogeplader og emfang til aftensmaden.</li>
        <li>Tryk på de apparater I bruger, og på det tidspunkt I plejer at lave mad. Så viser vi hvad det koster, og hvad det koster på det billigste tidspunkt der stadig giver mening.</li>
        <li><b>Fra jeres måler</b> viser hvad maden faktisk kostede de sidste 4 uger, og hvad det samme forbrug ville have kostet på det bedste tidspunkt.</li>
        <li>Forbruget er typiske tal for hvert apparat. Tag et billede af mærkepladen under <a href="/enheder">Enheder</a> (navngiv den fx "Ovn"), så bruger vi jeres egen.</li>
    </ul>
</PageHelp>

@if (_cards is null)
{
    <section class="k-card"><h2 class="k-card-title">Aftensmad</h2><div class="k-muted">Regner…</div></section>
}
else
{
    @foreach (var c in _cards)
    {
        var m = c.Meal;
        <section class="k-card">
            <h2 class="k-card-title">@m.Name <span class="k-muted small">kl. @Time(new TimeOnly(m.StartHour % 24, m.StartMinute))</span></h2>
            @if (m.Kinds.Count == 0)
            {
                <div class="k-muted">Vælg hvilke apparater I bruger nedenfor.</div>
            }
            else if (c.Plan.Usual is { } u)
            {
                <div class="plan-when">@Kr(u.CostKr) kr</div>
                <div class="plan-price">@(c.IsToday ? "I dag" : "I morgen") kl. @u.Start.ToString("HH:mm") · ca. @((u.CostKr * c.PerMonth).ToString("0", Da)) kr om måneden</div>
                <div class="k-muted small">@c.Plan.KwhPerMeal.ToString("0.0#", Da) kWh over @c.Plan.Hours.ToString("0.##", Da) @(c.Plan.Hours == 1 ? "time" : "timer")</div>
                @if (c.WorthMoving && c.Plan.Cheapest is { } best)
                {
                    <div class="small lvl-cheap u-mt8">Start kl. @best.Start.ToString("HH:mm") i stedet: @Kr(best.CostKr) kr – spar ca. @((c.Plan.SavingKr * c.PerMonth).ToString("0", Da)) kr om måneden.</div>
                }
                else
                {
                    <div class="small lvl-cheap u-mt8">Jeres tidspunkt er godt – at flytte maden sparer under 5 kr om måneden.</div>
                }
            }
            else
            {
                <div class="k-muted">Priserne for kl. @Time(new TimeOnly(m.StartHour % 24, m.StartMinute)) er ikke kendt endnu – morgendagens kommer ca. kl. 13.</div>
            }

            <div class="small u-mt8"><b>Apparater</b></div>
            <div class="chips chips-small">
                @foreach (var k in CookingKinds.All)
                {
                    <button class="chip @(m.Kinds.Contains(k.Key) ? "on" : "")" @onclick="() => Change(() => Meals.ToggleKind(m.Id, k.Key))">@k.Name</button>
                }
            </div>
            <div class="small"><b>Plejer at starte</b></div>
            <div class="chips chips-small">
                @foreach (var t in c.Starts)
                {
                    <button class="chip @(m.StartHour % 24 == t.Hour && m.StartMinute == t.Minute ? "on" : "")" @onclick="() => Change(() => Meals.SetStart(m.Id, t))">@Time(t)</button>
                }
            </div>
            <div class="small"><b>Dage om ugen</b></div>
            <div class="chips chips-small">
                @foreach (var d in new[] { 2, 3, 5, 7 })
                {
                    <button class="chip @(m.DaysPerWeek == d ? "on" : "")" @onclick="() => Change(() => Meals.SetDays(m.Id, d))">@d</button>
                }
            </div>
        </section>

        @if (c.Meter is { } r)
        {
            <section class="k-card">
                <h2 class="k-card-title">@m.Name fra jeres måler</h2>
                <div class="cost-rows">
                    <div class="cost-row"><span>Snit pr. dag <span class="k-muted small">@r.Days dage</span></span><b>@Kr(r.RealKrPerDay) kr</b></div>
                    <div class="cost-row best"><span>Samme forbrug på bedste tidspunkt</span><b>@Kr(r.PerfectKrPerDay) kr</b></div>
                </div>
                <div class="k-muted small u-mt8">
                    Ca. @r.KwhPerDay.ToString("0.0", Da) kWh ekstra mellem kl. @m.WindowFromHour og @(m.WindowToHour >= 24 ? "midnat" : $"kl. {m.WindowToHour}")@(r.UsualStart is { } us ? $", oftest fra kl. {us:HH\\:mm}" : "").
                    I brugte @r.PerfectPercent % perfekt.
                </div>
            </section>
        }
    }

    <section class="k-card" data-fold-closed>
        <h2 class="k-card-title">Hvorfor er aftensmaden dyr?</h2>
        <div class="small">Kl. 17–21 er nettariffen højest, fordi alle laver mad på samme tid. Mad efter kl. 21 rammer den billigere tarif – derfor er en sen ret ofte billigere end aftensmaden, selvom det er de samme apparater.</div>
    </section>
}

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private List<MealCard>? _cards;

    protected override async Task OnInitializedAsync() => _cards = await Meals.LoadAsync();

    private async Task Change(Action change)
    {
        change();
        _cards = await Meals.LoadAsync();
    }

    private static string Time(TimeOnly t) => t.ToString("HH:mm");
    private static string Kr(double v) => v.ToString("0.00", Da);
}
