@page "/"
@using ITMartinElPriser.Application
@using System.Globalization
@inject MinFrontPageUseCases Front
@inject RunMeasuringUseCases Measuring
@inject HouseholdStore Store
@inject PhotoReader Photos
@inject RunLogService RunLog
@implements IDisposable

<PageTitle>MinElpris</PageTitle>

@* Made like the free ElPriser front page (user 2026-10-29: "it needs to have the same easy page as the free one"):
   one big number for the household's OWN machine now and its cheapest start, hour by hour, "Hvad havde du sparet?",
   and one small box from the meter. Every box is a k-card with a heading, so kolibri.js folds it. The sums are
   MinFrontPageUseCases'. The 7-tile "Det kan MinElpris" grid and the machine list went - they are the tabs below. *@
<h1 class="k-visually-hidden">MinElpris</h1>

<Onboarding OnChanged="OnboardingChangedAsync" />

<PageHelp Key="help-forside">
    <ul>
        <li><b>Det store tal</b> er hvad én tur med jeres maskine koster, hvis den starter nu – hvert kvarter den kører, til det kvarters pris, med jeres egen nettarif.</li>
        <li>Tryk på en <b>søjle</b> – så viser det store tal prisen, hvis maskinen starter der.</li>
        <li><b>Kan du tidsindstille maskinen?</b> Der står, hvor mange timer du skal sætte den til – så starter den selv på det billigste tidspunkt.</li>
        <li>Maskinerne er dem, I har taget billede af under <a href="/enheder">Enheder</a>.</li>
    </ul>
</PageHelp>

@if (_view is null)
{
    <section class="k-card now-tile"><h2 class="k-card-title">Prisen nu</h2><div class="k-muted">Henter priser…</div></section>
}
else if (!_snap!.HasData || Current is not { } m || _view.RunAt(m, QuarterNow()) is not { } now)
{
    <section class="k-card now-tile">
        <h2 class="k-card-title">Prisen nu</h2>
        <div class="now-verdict lvl-mid">Ingen priser lige nu</div>
        <div class="now-compare">Energinet svarer ikke. Prøv igen om lidt.</div>
    </section>
}
else
{
    var strip = Strip();
    var allHours = (_snap.Today?.Hours ?? []).Concat(_snap.Tomorrow?.Hours ?? []).ToList();
    var min = allHours.Count > 0 ? allHours.Min(h => h.KrPerKwh) : 0;
    var span = allHours.Count > 0 ? allHours.Max(h => h.KrPerKwh) - min : 0;
    var cheapest = strip.MinBy(h => h.KrPerKwh);
    var picked = _selected is { } sel ? strip.FirstOrDefault(h => h.Start == sel) : null;
    var start = picked?.Start ?? QuarterNow();
    var run = picked is null ? now : _view.RunAt(m, start);
    double? rank = picked is null ? _snap.NowRank01 : picked.Rank01;
    var lvl = Level(rank);
    var best = _view.Cheapest(m, QuarterNow(), night: true);
    var awake = _view.Cheapest(m, QuarterNow(), night: false);
    var hasTomorrow = _snap.Tomorrow?.Hours.Count > 0;
    <section class="k-card now-tile @lvl">
        <h2 class="k-card-title">Prisen nu</h2>
        <div class="chips chips-small" role="group" aria-label="Vælg maskine">
            @foreach (var a in _view.Machines)
            {
                <button class="chip @(a.Id == m.Id ? "on" : "")" aria-pressed="@(a.Id == m.Id)" @onclick="() => PickMachine(a.Id)">@a.Name</button>
            }
        </div>
        <div class="now-device">Én tur · @Kwh(m.KwhPerRun) kWh · @Hours(m.DurationHours) · start @(picked is null ? "nu" : When(start))</div>
        <div class="now-price @lvl">@(run is null ? "–" : Kr(run.CostKr)) KR</div>
        @if (run is not null)
        {
            <div class="now-calc">@Kwh(m.KwhPerRun) kWh × @Kr(run.AvgKrPerKwh) kr/kWh i snit over @Hours(m.DurationHours) = @Kr(run.CostKr) kr</div>
        }
        <div class="now-verdict @lvl">@(run is null ? "Priserne dækker ikke hele turen endnu" : Verdict(rank))</div>
        @if (best is not null && run is not null)
        {
            <div class="now-best">
                @if (best.Start <= QuarterNow())
                {
                    <b>Start nu – det er billigst.</b>
                }
                else
                {
                    <b>Start @StartAt(best.Start) – det er billigst.</b>
                    <span>Den koster @Kr(best.CostKr) kr@(run.CostKr - best.CostKr >= 0.01 ? $" – du sparer {Kr(run.CostKr - best.CostKr)} kr i forhold til nu" : "").</span>
                    <span>Kan du tidsindstille maskinen? Sæt den til <b>@Delay(best.Start)</b>.</span>
                }
                @if (awake is not null && _view.IsQuiet(best.Start) && awake.Start != best.Start)
                {
                    <span class="k-muted small">Ikke om natten? Mellem kl. 6 og 23 er det billigst @(awake.Start <= QuarterNow() ? "lige nu" : StartAt(awake.Start)) – @Kr(awake.CostKr) kr.</span>
                }
            </div>
        }
        @if (!hasTomorrow)
        {
            <div class="k-muted small u-center">Morgendagens priser kommer ca. kl. 13.</div>
        }
        @if (picked is not null)
        {
            <button class="linkish small" @onclick="() => _selected = null">↺ Tilbage til nu</button>
        }
        @* Camera only: a photo of the display when you start the machine logs the run (Historik). *@
        <div class="u-mt8">
            <CameraButton Text="Jeg starter en maskine" BusyText="Læser displayet…" Busy="_readingStart" OnPhoto="StartFromPhotoAsync" />
        </div>
        @if (_startMessage is { } sm) { <div class="small u-mt8 @(_startOk ? "lvl-cheap" : "err")">@sm</div> }
    </section>

    @if (strip.Count > 0)
    {
        <section class="k-card">
            <h2 class="k-card-title">Time for time</h2>
            <div class="bars">
                @foreach (var h in strip)
                {
                    var pct = span > 0 ? 15 + 85 * (h.KrPerKwh - min) / span : 50;
                    <div class="bar-col @(_selected == h.Start ? "sel" : "")" title="@When(h.Start) · @Kr(h.KrPerKwh) kr/kWh"
                         @onclick="() => _selected = _selected == h.Start || h.IsNow ? null : h.Start">
                        <div class="bar @Band(h.Rank01) @(h.IsNow ? "now" : "") @(h.Start.Hour == 0 ? "midnight" : "")"
                             style="--h:@pct.ToString("0", CultureInfo.InvariantCulture)%">
                            @if (h == cheapest) { <span class="bar-tip">billigst</span> }
                        </div>
                    </div>
                }
            </div>
            <div class="bar-axis">
                @for (var i = 0; i < strip.Count; i++)
                {
                    var h = strip[i];
                    var label = h.IsNow ? "nu" : i == 1 && strip[0].IsNow ? "" : h.Start.Hour % 3 == 0 ? h.Start.Hour.ToString() : "";
                    <span>@label</span>
                }
            </div>
            <div class="k-muted small u-mt6 u-center">Høje, stribede søjler er dyre timer – lave er billige.</div>
            <div class="k-muted small u-mt6 u-center">Tryk på en søjle – så viser det store tal prisen, hvis maskinen starter der.</div>
        </section>
    }
}

@if (_hindsight is null && _hindsightLoading && _view is not null)
{
    <section class="k-card now-tile lvl-cheap hindsight-wait">
        <h2 class="k-card-title">Hvad havde du sparet?</h2>
        <div class="now-price lvl-cheap">…</div>
        <div class="now-unit">Regner ud …</div>
    </section>
}
else if (_hindsight is { } hs && hs.SavedKr >= 1 && Current is { } hm)
{
    <section class="k-card now-tile lvl-cheap">
        <h2 class="k-card-title">Hvad havde du sparet?</h2>
        <div class="now-price lvl-cheap">@hs.SavedKr.ToString("0", Da) kr</div>
        <div class="now-unit">på de sidste @hs.Days dage – ca. @Round10(hs.PerYearKr) kr om året</div>
        <div class="now-compare">Med én tur om dagen med @hm.Name (@Kwh(hm.KwhPerRun) kWh, @Hours(hm.DurationHours)): startet kl. 18 hver dag havde den kostet <b>@Kr(hs.UsualKr) kr</b>. Startet på dagens billigste tid havde den kostet <b>@Kr(hs.CheapestKr) kr</b>.</div>
    </section>
}

@if (_home is { } home)
{
    <section class="k-card">
        <h2 class="k-card-title">Dit hjem</h2>
        @if (_s.MeteringPointAddress is { Length: > 0 } addr) { <div class="k-muted small u-mb8">@addr</div> }
        <div class="appl-row"><span>@home.LatestDay.ToString("dddd d. MMM", Da): <b>@home.DayKwh.ToString("0.0", Da) kWh</b></span><b>@Kr(home.DayKr) kr</b></div>
        <div class="appl-row"><span>@DkTime.Now.ToString("MMMM", Da) indtil nu: <b>@home.MonthKwh.ToString("0", Da) kWh</b></span><b>@home.MonthKr.ToString("0", Da) kr</b></div>
        @if (home.MonthProjectedKr > 0)
        {
            <div class="appl-row k-muted small"><span>Forventet for hele måneden</span><b>≈ @home.MonthProjectedKr.ToString("0", Da) kr</b></div>
        }
        @if (home.LastRun is { } lr)
        {
            <div class="appl-row k-muted small"><span>Sidste tur: @lr.ApplianceName @lr.StartedAt.ToString("d. MMM HH:mm", Da)</span><b>@Kr(lr.CostKr) kr</b></div>
        }
        <a class="k-btn k-btn-sm u-mt8" href="/dag">Se dagen time for time</a>
        <div class="k-muted small u-mt6">Måleren er 1–2 dage bagud – det er Datahub, ikke appen.</div>
    </section>
}
else if (_view is not null && string.IsNullOrWhiteSpace(_s.MeteringPointId))
{
    <section class="k-card">
        <h2 class="k-card-title">Dit hjem</h2>
        <div class="small">Forbind jeres elmåler under <a href="/indstillinger">Indstillinger</a>, så står her hvad I faktisk bruger – dag for dag, og hvad måneden lander på.</div>
    </section>
}

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private MinNowView? _view;
    private PriceSnapshot? _snap => _view?.Snapshot;
    private HouseholdSettings _s => _view?.Settings ?? new();
    private Guid? _machineId;
    private Appliance? Current => _view?.Machine(_machineId);
    private DateTime? _selected;
    private Timer? _timer;
    private Hindsight? _hindsight;
    private bool _hindsightLoading = true;
    private HomeSummary? _home;

    protected override async Task OnInitializedAsync()
    {
        Measuring.MeasurePending();   // runs the meter now covers get their real kWh, and the machines follow
        _view = await Front.LoadAsync();
        // The "now" price steps every 15 minutes; a phone left open on the counter must never be more than a couple of minutes stale.
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            try { _view = await Front.LoadAsync(); StateHasChanged(); } catch { }
        }), null, TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(2));
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        // The two slow boxes come after the big number, each holding its place (no jumps on load).
        _ = InvokeAsync(LoadHindsightAsync);
        _ = InvokeAsync(LoadHomeAsync);
    }

    private async Task LoadHindsightAsync()
    {
        try { _hindsight = Current is { } m ? await Front.HindsightAsync(m) : null; }
        catch { _hindsight = null; }   // Energinet down: the box simply is not shown
        _hindsightLoading = false;
        StateHasChanged();
    }

    private async Task LoadHomeAsync()
    {
        try { _home = await Front.HomeAsync(); } catch { _home = null; }
        StateHasChanged();
    }

    private void PickMachine(Guid id)
    {
        _machineId = id;
        _selected = null;
        _hindsightLoading = true;
        _hindsight = null;
        _ = InvokeAsync(LoadHindsightAsync);   // "Hvad havde du sparet?" follows the machine
    }

    private bool _readingStart, _startOk;
    private string? _startMessage;

    private async Task StartFromPhotoAsync((byte[] Bytes, string Mime) photo)
    {
        _readingStart = true; _startMessage = null;
        if (DemoHousehold.IsDemo(Store.HouseholdId)) { _readingStart = false; _startOk = false; _startMessage = "I demoen læser vi ikke billeder – opret din egen MinElpris for at bruge kameraet."; return; }
        StateHasChanged();
        try
        {
            var read = await Photos.ReadStartAsync(photo.Bytes, photo.Mime, Store.Get().Appliances);
            var start = DkTime.Now.AddHours(read.DelayHours);
            var entry = await RunLog.LogAsync(read.ApplianceId!.Value, start, read.Program);
            if (entry is null)
            {
                _startOk = false;
                _startMessage = $"Så {read.Note} – men prisen for kl. {start:HH:mm} kendes ikke endnu (kommer ca. kl. 13).";
                return;
            }
            _startOk = true;
            _startMessage = $"{entry.ApplianceName} {(read.DelayHours > 0 ? $"starter om {read.DelayHours.ToString("0.#", Da)} t, kl. {entry.StartedAt:HH:mm}" : $"startet kl. {entry.StartedAt:HH:mm}")} – koster {Kr(entry.CostKr)} kr. ({read.Note})";
            await LoadHomeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or System.Text.Json.JsonException)
        {
            _startOk = false;
            _startMessage = ex.Message;
        }
        finally { _readingStart = false; }
    }

    // The meter was just connected: address, grid and use are new.
    private async Task OnboardingChangedAsync()
    {
        _view = await Front.LoadAsync();
        await LoadHomeAsync();
    }

    public void Dispose() => _timer?.Dispose();

    private DateTime QuarterNow()
    {
        var n = _snap?.At ?? DkTime.Now;
        return new DateTime(n.Year, n.Month, n.Day, n.Hour, n.Minute / 15 * 15, 0);
    }

    // The current hour onwards, today and tomorrow in one strip.
    private List<HourBar> Strip() =>
        [.. (_snap?.Today?.Hours ?? []).Concat(_snap?.Tomorrow?.Hours ?? []).Where(h => !h.IsPast)];

    // "kl. 13" today, "i nat kl. 03", "i morgen kl. 14".
    private string When(DateTime t)
    {
        var today = DateOnly.FromDateTime(_snap?.At ?? DkTime.Now);
        if (DateOnly.FromDateTime(t) == today) return $"kl. {t:HH}";
        return t.Hour < 7 ? $"i nat kl. {t:HH}" : $"i morgen kl. {t:HH}";
    }

    private string StartAt(DateTime t) => $"{When(t)}:{t:mm}";

    // For a machine with a delayed start: how long from now until the start, in half hours.
    private static string Delay(DateTime start)
    {
        var halves = Math.Max(1, (int)Math.Round((start - DkTime.Now).TotalMinutes / 30));
        var h = halves / 2;
        return (h, halves % 2 == 1) switch
        {
            (0, _) => "½ time",
            (1, false) => "1 time",
            (_, false) => $"{h} timer",
            (_, true) => $"{h}½ time" + (h == 1 ? "" : "r"),
        };
    }

    private static string Band(double rank) => rank <= 0.33 ? "band-cheap" : rank >= 0.67 ? "band-expensive" : "band-mid";
    private static string Kwh(double v) => v.ToString("0.##", Da);
    private static string Round10(double kr) => (Math.Round(kr / 10) * 10).ToString("#,##0", Da);
    private static string Hours(double h) => h == 1 ? "1 time" : h < 1 ? $"{h * 60:0} min" : $"{h.ToString("0.##", Da)} timer";
    private static string Kr(double? v) => v is { } x ? x.ToString("0.00", Da) : "–";

    private static string Level(double? rank) => rank switch
    {
        null => "lvl-mid",
        <= 0.33 => "lvl-cheap",
        >= 0.67 => "lvl-expensive",
        _ => "lvl-mid",
    };

    private static string Verdict(double? rank) => rank switch
    {
        null => "",
        <= 0.15 => "Blandt dagens billigste",
        <= 0.33 => "Billigt lige nu",
        >= 0.85 => "Dagens dyreste",
        >= 0.67 => "Dyrt lige nu",
        _ => "Middel – hverken billigt eller dyrt",
    };
}
