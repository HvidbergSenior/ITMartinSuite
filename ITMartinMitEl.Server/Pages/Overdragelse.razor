@page "/kunder/{Id:guid}/overdragelse"
@inject TenantContext Tenant
@inject CustomerSetupReader Setup

<PageTitle>Overdragelse – MinElpris</PageTitle>

@* Kolibri classes only - no inline styles, no page <style>, no emojis (user 2026-11-24). Printing: kolibri.css hides the
   header, footer and .k-no-print for every app. *@
@if (_facts is null)
{
    <h1>Overdragelse</h1>
    <p class="k-muted">Du har ikke adgang til den kunde (længere). <a href="/kunder">Tilbage til Kunder</a></p>
}
else
{
    <div class="k-row k-no-print">
        <button class="k-btn k-btn-primary k-btn-sm" type="button" onclick="window.print()">Udskriv / gem som PDF</button>
        <a class="k-btn k-btn-sm" href="@($"/kunder/{Id}")">Tilbage til opsætningen</a>
    </div>

    <h1>MinElpris – sådan bruger I den</h1>
    <p class="k-muted">@_facts.HouseholdName · sat op @DkTime.Now.ToString("d. MMMM yyyy", CustomerSetup.Da) af Martin Hvidberg, ITMartin</p>

    <section class="k-card">
        <h2 class="k-card-title">Det har vi sat op</h2>
        @if (_setUp.Count == 0)
        {
            <p>Endnu intet – gennemgå opsætningen først.</p>
        }
        else
        {
            <ul class="k-list">
                @foreach (var (label, value) in _setUp)
                {
                    <li><b>@label</b><span>@value</span></li>
                }
            </ul>
        }
    </section>

    <section class="k-card">
        <h2 class="k-card-title">Sådan logger I ind</h2>
        <ul>
            <li>Åbn <b>minelpris.itmartin.dk</b> – eller tryk på ikonet på telefonens hjemmeskærm.</li>
            <li>Mail: <b>@_facts.OwnerEmail</b> og jeres egen adgangskode.</li>
            <li>Glemt adgangskoden? Tryk <b>Glemt adgangskoden?</b> på log ind-siden, så får I et link på mail.</li>
        </ul>
    </section>

    <section class="k-card">
        <h2 class="k-card-title">Det bruger I den til</h2>
        <ol>
            <li><b>Nu</b> – hvad strømmen koster lige nu, og om det betaler sig at vente med vask og opvask.</li>
            <li><b>Dag</b> – hvad I brugte i går, time for time, og hvad det kostede.</li>
            <li><b>Enheder</b> – hvad jeres maskiner og strømslugere koster om måneden og året.</li>
            <li><b>Regning</b> – hvor pengene går hen: strømmen, netselskabet og staten.</li>
            <li><b>Besked</b> – telefonen siger til, før de billige timer starter.</li>
        </ol>
    </section>

    @if (_notes.Length > 0)
    {
        <section class="k-card">
            <h2 class="k-card-title">Det aftalte vi</h2>
            @foreach (var line in _notes.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                <p>@line</p>
            }
        </section>
    }

    <section class="k-card">
        <h2 class="k-card-title">Jeres data</h2>
        <ul>
            <li>Tallene kommer fra jeres egen elmåler (eloverblik.dk) og det, I selv lægger ind. De er kun jeres.</li>
            @if (_facts.AdvisorAccessUntilUtc is { } until)
            {
                <li>Martin kan kigge med til og med <b>@until.ToLocalTime().ToString("d. MMMM yyyy", CustomerSetup.Da)</b>, så han kan hjælpe. I kan lukke for det når som helst under <b>Konto</b>.</li>
            }
            <li>Vil I stoppe, kan I slette hele kontoen under <b>Konto</b> – så er alt væk.</li>
        </ul>
    </section>

    <div class="k-alert k-alert-info">
        <b>Brug for hjælp?</b> Ring eller skriv til Martin Hvidberg, ITMartin – telefon 31 19 47 30, mail ITMartin@Mensa.dk.
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private SetupFacts? _facts;
    private List<(string Label, string Value)> _setUp = [];
    private string _notes = "";

    protected override async Task OnParametersSetAsync()
    {
        if (!Tenant.IsAdvisor || Tenant.UserId is not { } advisorId || await Setup.ReadAsync(advisorId, Id) is not { } r) return;
        _facts = r.Facts;
        _setUp = CustomerSetup.WhatWasSetUp(r.Facts);
        _notes = r.Data.AdvisorNotes;
    }
}
