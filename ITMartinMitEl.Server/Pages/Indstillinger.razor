@page "/indstillinger"
@inject HouseholdStore Store
@inject EloverblikService Eloverblik
@inject ConsumptionSync Sync
@inject ConsumptionStore Consumption

<PageTitle>Indstillinger – MinElpris</PageTitle>

<h1>Indstillinger</h1>
<PageHelp Key="help-indstillinger">
    <p>Fælles for alle der bruger appen.</p>
</PageHelp>

@* Machines and devices are camera-only since 2026-09-27 - set up and removed under Enheder, never typed here. *@
<div class="card">
    <div class="card-title">Maskiner og apparater</div>
    <div class="small">Tilføjes med et billede af mærkepladen under <a href="/enheder">📷 Enheder</a>. Når du starter en maskine, tager du et billede af displayet på forsiden.</div>
</div>

<details class="card fold" open>
    <summary class="card-title">Pris</summary>
    <div class="field">
        <label>Prisområde</label>
        <select @bind="_s.PriceArea">
            <option value="DK1">DK1 – Jylland og Fyn</option>
            <option value="DK2">DK2 – Sjælland, Lolland-Falster, Bornholm</option>
        </select>
    </div>
    <div class="switch">
        <span>Vis alt inkl. (moms, elafgift, nettarif, leverandør)</span>
        <input type="checkbox" @bind="_s.ShowAllIn" />
    </div>
    @if (_s.ShowAllIn)
    {
        <div class="field">
            <label>Netselskab</label>
            <select @bind="_s.GridCompanyId">
                @foreach (var g in GridCompanyPreset.All) { <option value="@g.Id">@g.Name @(string.IsNullOrEmpty(g.Region) ? "" : $"– {g.Region}")</option> }
            </select>
        </div>
        @if (_s.GridCompanyId == "custom")
        {
            <div class="field"><label>Nettarif, øre/kWh ekskl. moms</label><input type="number" step="0.1" @bind="_s.CustomNettarifOre" /></div>
        }
        <div class="field">
            <label>Elleverandør</label>
            <select @bind="_s.SupplierId">
                @foreach (var sp in SupplierPreset.All) { <option value="@sp.Id">@sp.Name</option> }
            </select>
        </div>
        @if (_s.SupplierId == "custom")
        {
            <div class="field"><label>Leverandørtillæg, øre/kWh ekskl. moms</label><input type="number" step="0.1" @bind="_s.CustomTillaegOre" /></div>
        }
    }
</details>

<details class="card fold" open>
    <summary class="card-title">Nattero</summary>
    <div class="muted small" style="margin-bottom:8px">Der foreslås ikke starttidspunkter i dette tidsrum – og der sendes ingen beskeder om dem.</div>
    <div class="row2">
        <div class="field"><label>Fra kl.</label><input type="number" min="0" max="23" @bind="_s.QuietFromHour" /></div>
        <div class="field"><label>Til kl.</label><input type="number" min="0" max="23" @bind="_s.QuietToHour" /></div>
    </div>
</details>

<details class="card fold" open>
    <summary class="card-title">Din elmåler (eloverblik.dk)</summary>
    <div class="muted small" style="margin-bottom:8px">
        Log ind på <a href="https://eloverblik.dk" target="_blank">eloverblik.dk</a> med MitID → profilikonet øverst → <b>Datadeling</b> → <b>Opret token</b>. Kopiér den lange tekst herind. Tokenet gælder i et år og kan kun læse dit forbrug.
    </div>
    <div class="field"><label>Token</label><input type="text" @bind="_s.EloverblikToken" placeholder="eyJ…" autocomplete="off" /></div>
    @if (!string.IsNullOrWhiteSpace(_s.MeteringPointId))
    {
        <div class="note ok">Forbundet: @_s.MeteringPointAddress <span class="muted small">(@_s.MeteringPointId)</span></div>
    }
    <div class="btn-row">
        <button class="btn" @onclick="ConnectAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_s.EloverblikToken))">@(_busy ? "Forbinder…" : "Forbind og hent måler")</button>
    </div>
    @if (_meterMsg is not null) { <div class="note @(_meterOk ? "ok" : "err")">@_meterMsg</div> }
</details>

<button class="btn btn-primary btn-block" @onclick="Save">Gem</button>
<p class="muted small" style="text-align:center;margin-top:12px"><a href="/logout">Log ud af MinElpris</a></p>
@if (_saved) { <div class="note ok">Gemt ✓</div> }

@code {
    private HouseholdSettings _s = new();
    private bool _saved;
    private bool _busy;
    private bool _meterOk;
    private string? _meterMsg;

    protected override void OnInitialized()
    {
        var d = Store.Get();
        _s = new HouseholdSettings
        {
            PriceArea = d.Settings.PriceArea, ShowAllIn = d.Settings.ShowAllIn,
            GridCompanyId = d.Settings.GridCompanyId, CustomNettarifOre = d.Settings.CustomNettarifOre,
            SupplierId = d.Settings.SupplierId, CustomTillaegOre = d.Settings.CustomTillaegOre,
            QuietFromHour = d.Settings.QuietFromHour, QuietToHour = d.Settings.QuietToHour,
            EloverblikToken = d.Settings.EloverblikToken, MeteringPointId = d.Settings.MeteringPointId, MeteringPointAddress = d.Settings.MeteringPointAddress,
        };
    }

    private async Task ConnectAsync()
    {
        _busy = true; _meterMsg = null;
        try
        {
            var points = await Eloverblik.GetMeteringPointsAsync(_s.EloverblikToken);
            var mp = points.FirstOrDefault(p => p.TypeOfMp == "E17") ?? points.FirstOrDefault();
            if (mp is null) { _meterOk = false; _meterMsg = "Tokenet virker, men der er ingen målere på det."; return; }
            _s.MeteringPointId = mp.Id; _s.MeteringPointAddress = mp.Address;
            Save();
            var ok = await Sync.SyncAsync(Store.HouseholdId);
            _meterOk = ok;
            _meterMsg = ok ? $"Forbundet til {mp.Address}. Forbruget hentes - se Forbrug."
                : $"Måleren på {mp.Address} er fundet, men: {Consumption.LastSyncError ?? "ingen målinger endnu (Datahub er 1-2 dage bagud)"}";
        }
        catch (Exception ex) { _meterOk = false; _meterMsg = "Kunne ikke forbinde: " + ex.Message; }
        finally { _busy = false; }
    }


    private Guid? _looking;
    private readonly Dictionary<Guid, (bool Ok, string Text, List<string> Sources)> _lookupMsg = new();

    // Model number in, kWh per program + run time out - filled into the form;
    // nothing is saved until Gem, so a wrong guess costs nothing.


    // kWh/år is what the energy label says; watts follow from the hours it is on.
    private static void SetKwhPerYear(Device d, object? value)
    {
        if (!double.TryParse(Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture)?.Replace(',', '.'),
                System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var kwh) || kwh < 0) return;
        var hoursPerYear = Math.Clamp(d.HoursPerDay, 0.25, 24) * Math.Clamp(d.DaysPerWeek, 1, 7) / 7.0 * 365;
        d.Watts = Math.Round(kwh * 1000 / hoursPerYear, 1);
    }

    private static string Host(string url) => Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host : url;

    private static void AddProgram(Appliance a)
    {
        var last = a.Programs[^1];
        a.Programs.Add(new ApplianceProgram { Name = "", KwhPerRun = last.KwhPerRun, DurationHours = a.DurationHours });
    }

    private void Save()
    {
        _s.QuietFromHour = Math.Clamp(_s.QuietFromHour, 0, 23);
        _s.QuietToHour = Math.Clamp(_s.QuietToHour, 0, 23);
        // Copy only the fields this page edits: a whole-object replace used to wipe the meter's
        // own charges, the EV numbers and the grid id every time someone pressed Gem.
        Store.Update(d =>
        {
            var t = d.Settings;
            t.PriceArea = _s.PriceArea; t.ShowAllIn = _s.ShowAllIn;
            t.GridCompanyId = _s.GridCompanyId; t.CustomNettarifOre = _s.CustomNettarifOre;
            t.SupplierId = _s.SupplierId; t.CustomTillaegOre = _s.CustomTillaegOre;
            t.QuietFromHour = _s.QuietFromHour; t.QuietToHour = _s.QuietToHour;
            t.EloverblikToken = _s.EloverblikToken; t.MeteringPointId = _s.MeteringPointId; t.MeteringPointAddress = _s.MeteringPointAddress;
        });
        _saved = true;
    }
}
