@page "/"
@rendermode InteractiveServer

@using ITMartinLibrary.Application.Interfaces
@using ITMartinLibrary.Domain.Entities
@inject IScannedShelfRepository ShelfRepo

<PageTitle>Bogsamling – Søg</PageTitle>

<div class="library-page">
    <div class="page-container">

        <div class="inv-header">
            <div>
                <h1 class="inv-title">📚 Bogsamling</h1>
                <div class="inv-subtitle">@_subtitle</div>
            </div>
        </div>

        <div class="content-card inv-toolbar">
            <input class="inv-search" type="search"
                   placeholder="Søg titel eller forfatter…"
                   @bind="_search" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <div class="inv-count">
                    @_filtered.Count resultat@(_filtered.Count == 1 ? "" : "er") for "<strong>@_search</strong>" — @_allBooks.Count bøger i alt
                </div>
            }

            <div class="inv-filter-row">
                <div class="inv-chips">
                    @foreach (var t in _typeOptions)
                    {
                        <button class="inv-chip @(_typeFilter == t ? "inv-chip-active" : "")"
                                @onclick="() => _typeFilter = t">@t</button>
                    }
                </div>
            </div>
        </div>

        @if (_allBooks.Count == 0)
        {
            <div class="content-card" style="text-align:center;padding:48px 20px;">
                <div style="font-size:48px;margin-bottom:12px;">📷</div>
                <div class="text-muted">Ingen hylder scannet endnu. Brug scan-appen til at scanne en bogreol.</div>
            </div>
        }
        else if (_filtered.Count == 0)
        {
            <div class="content-card" style="text-align:center;padding:48px 20px;">
                <div style="font-size:48px;margin-bottom:12px;">🔍</div>
                <div class="text-muted">Ingen elementer matcher din søgning.</div>
            </div>
        }
        else
        {
            <div class="inv-list">
                @foreach (var (book, shelf) in _filtered.Take(100))
                {
                    <div class="inv-row">
                        <div class="inv-cover">
                            <img src="/shelf-images/@System.IO.Path.GetFileName(shelf.ImagePath)"
                                 class="inv-cover-img" loading="lazy"
                                 onerror="this.style.display='none'" alt="" />
                            <div class="inv-cover-placeholder">📚</div>
                        </div>
                        <div class="inv-info">
                            <div class="inv-item-title">@book.Title</div>
                            @if (!string.IsNullOrWhiteSpace(book.Author))
                            {
                                <div class="inv-item-sub">@book.Author</div>
                            }
                            <div class="inv-item-meta">
                                <span>Hylde @shelf.ShelfNumber</span>
                                <span>@shelf.ScannedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                <span class="inv-type-badge">@DanishType(book.MediaType)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

<style>
    .library-page { min-height: 100vh; padding: 20px 16px 60px; color: var(--text-main, #e2e8f0); }
    .inv-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .inv-title { font-size: 28px; font-weight: 900; margin: 0; line-height: 1; }
    .inv-subtitle { font-size: 13px; color: var(--text-muted, #94a3b8); margin-top: 4px; }
    .content-card { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; }
    .inv-toolbar { display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; padding: 14px 16px; }
    .inv-search {
        width: 100%; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);
        border-radius: 10px; padding: 10px 14px; color: white; font-size: 16px; outline: none;
    }
    .inv-search:focus { border-color: #6366f1; }
    .inv-search::placeholder { color: var(--text-muted, #94a3b8); }
    .inv-filter-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
    .inv-chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .inv-chip {
        padding: 5px 14px; border-radius: 999px; border: 1px solid rgba(255,255,255,.15);
        background: transparent; color: var(--text-muted, #94a3b8); font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .inv-chip:hover { border-color: rgba(255,255,255,.35); color: white; }
    .inv-chip-active { background: #6366f1 !important; border-color: #6366f1 !important; color: white !important; }
    .inv-list { display: flex; flex-direction: column; gap: 10px; }
    .inv-row {
        display: flex; align-items: center; gap: 14px;
        background: linear-gradient(160deg, #1e222b, #121317);
        border: 1px solid rgba(255,255,255,.06); border-radius: 14px; padding: 12px 14px;
    }
    .inv-row:hover { background: linear-gradient(160deg, #252a35, #161a22); }
    .inv-cover { flex-shrink: 0; width: 56px; height: 72px; border-radius: 6px; overflow: hidden; position: relative; }
    .inv-cover-placeholder {
        width: 100%; height: 100%; background: rgba(255,255,255,.06);
        border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 22px;
    }
    .inv-cover-img {
        position: absolute; inset: 0; width: 100%; height: 100%;
        object-fit: cover; border-radius: 6px;
    }
    .inv-info { flex: 1; min-width: 0; }
    .inv-item-title { font-weight: 600; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .inv-item-sub { font-size: 13px; color: var(--text-muted, #94a3b8); margin-top: 2px; }
    .inv-item-meta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 5px; font-size: 11px; color: var(--text-muted, #94a3b8); }
    .inv-count { font-size: 13px; color: var(--text-muted, #94a3b8); padding: 2px 0; }
    .inv-type-badge { background: rgba(99,102,241,.18); color: #a5b4fc; border-radius: 4px; padding: 1px 6px; }
</style>

@code {
    private List<(ShelfBook Book, ScannedShelf Shelf)> _allBooks = [];
    private string _search     = "";
    private string _typeFilter = "Alle";

    private static readonly string[] _typeOptions = ["Alle", "Bog", "Tegneserie", "DVD", "Bluray"];

    private string _subtitle =>
        _allBooks.Count == 0 ? "Ingen hylder scannet endnu"
        : _filtered.Count == _allBooks.Count ? $"{_allBooks.Count} elementer på {_shelfCount} hylde{(_shelfCount == 1 ? "" : "r")}"
        : $"{_filtered.Count} af {_allBooks.Count} elementer";

    private int _shelfCount;

    private List<(ShelfBook, ScannedShelf)> _filtered => ApplyFilters();

    protected override async Task OnInitializedAsync()
    {
        var shelves = await ShelfRepo.GetAllWithBooksAsync(default);
        _shelfCount = shelves.Count;
        _allBooks   = shelves
            .SelectMany(s => s.Books.Select(b => (b, s)))
            .ToList();
    }

    private static string DanishType(string t) => t switch
    {
        "Book"    => "Bog",
        "Comic"   => "Tegneserie",
        "Cartoon" => "Tegneserie",
        "DVD"     => "DVD",
        "Bluray"  => "Bluray",
        _         => t
    };

    private List<(ShelfBook, ScannedShelf)> ApplyFilters()
    {
        var q = _allBooks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            q = q.Where(x =>
                x.Book.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                x.Book.Author.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        q = _typeFilter switch
        {
            "Bog"        => q.Where(x => x.Book.MediaType == "Book"),
            "Tegneserie" => q.Where(x => x.Book.MediaType is "Comic" or "Cartoon"),
            "DVD"        => q.Where(x => x.Book.MediaType == "DVD"),
            "Bluray"     => q.Where(x => x.Book.MediaType == "Bluray"),
            _            => q
        };

        return q.OrderBy(x => x.Book.Title, StringComparer.OrdinalIgnoreCase).ToList();
    }
}
