@page "/indstillinger"
@inject ForeningStore Store
@inject LiveBoard Board

<PageTitle>Indstillinger · Ladestander</PageTitle>

<h1>Indstillinger</h1>

<div class="card">
    <div class="card-title">Foreningen</div>
    <div class="row">
        <div><label for="name">Navn</label><input id="name" @bind="_f.Name" /></div>
        <div><label for="hh">Husstande</label><input id="hh" type="number" @bind="_f.Households" /></div>
        <div><label for="okw">kW pr. udtag</label><input id="okw" type="number" @bind="_f.OutletKw" /></div>
    </div>
</div>

<div class="card">
    <div class="card-title">Strømpris ved standeren</div>
    <div class="row">
        <div><label for="area">Prisområde</label><select id="area" @bind="_f.Settings.PriceArea"><option>DK1</option><option>DK2</option></select></div>
        <div><label for="net">Nettarif, øre/kWh ekskl. moms</label><input id="net" type="number" step="0.01" @bind="_f.Settings.CustomNettarifOre" /></div>
        <div><label for="sup">Elleverandør</label>
            <select id="sup" @bind="_f.Settings.SupplierId">
                @foreach (var s in SupplierPreset.All) { <option value="@s.Id">@s.Name</option> }
            </select></div>
        <div><label for="til">Tillæg hvis "Andet", øre ekskl. moms</label><input id="til" type="number" step="0.1" @bind="_f.Settings.CustomTillaegOre" /></div>
    </div>
    <p class="small muted">Nettarif 26,77 = KONSTANT C-time 33,46 − rabat 6,69 (okt–dec 2024-regningen). Energinet-tariffer, elafgift og moms lægges automatisk til.</p>
</div>

<div class="card">
    <div class="card-title">Foreningens tillæg</div>
    <div class="row">
        <div><label for="till">Tillæg, øre/kWh ekskl. moms</label><input id="till" type="number" step="1" @bind="_f.TillaegOrePerKwh" /></div>
        <div><label for="op">Platform</label><input id="op" @bind="_f.OperatorName" /></div>
    </div>
    <p class="small muted">Lægges oven i strømprisen og dækker platform (Spirii), laderne og en buffer. Beboerprisen = strøm + tillæg + moms. Looads gamle cut var 40 øre.</p>
</div>

<div class="card">
    <div class="card-title">Datakilde</div>
    <p>@(Board.Simulated ? "Simulator – viser eksempeldata." : "Zaptec, live.") @if (Board.UpdatedDk is { } u) { <span class="muted small">Sidst hentet @u.ToString("HH:mm:ss").</span> }</p>
    <p class="small muted">Live-data slås til ved at lægge en API-nøgle fra Spirii Connect (Team Access → API tokens, kræver rollen Operator) i magic.env som <code>Ladestander__Spirii__ApiKey</code> og skrive hvert udtags EVSE-id herunder (står i Spirii Connect under laderen). Zaptec direkte er en reserve: <code>Ladestander__Zaptec__Username</code>, <code>__Password</code>, <code>__InstallationId</code>.</p>
    <p class="small"><a href="/overblik">Leverandøranalyse og beboerundersøgelse →</a></p>
</div>

<div class="card">
    <div class="card-title">Udtag (@_f.OutletSetup.Count)</div>
    <div class="wrap"><table>
        <tr><th>Nr.</th><th>Navn</th><th>Data</th><th>Spirii EVSE-id / Zaptec Charger ID</th><th>kW</th><th></th></tr>
        @foreach (var o in _f.OutletSetup.OrderBy(o => o.Number))
        {
            <tr>
                <td>@o.Number</td>
                <td><input aria-label="Navn på udtag @o.Number" @bind="o.Name" /></td>
                <td><select aria-label="Datakilde for udtag @o.Number" @bind="o.Source"><option value="spirii">Spirii (live)</option><option value="zaptec">Zaptec (live)</option><option value="manual">Manuel (indtastes)</option></select></td>
                <td>
                    @if (o.Source == "spirii") { <input aria-label="Spirii EVSE-id for udtag @o.Number" placeholder="fx DK*SPI*E123*1" @bind="o.SpiriiEvseId" /> }
                    else if (o.Source == "zaptec") { <input aria-label="Zaptec Charger ID for udtag @o.Number" placeholder="GUID fra Zaptec Portal" @bind="o.ZaptecChargerId" /> }
                    else { <span class="muted small">–</span> }
                </td>
                <td><input aria-label="kW for udtag @o.Number" type="number" style="width:5em" @bind="o.MaxKw" /></td>
                <td><button class="danger" @onclick="() => _f.OutletSetup.Remove(o)">Fjern</button></td>
            </tr>
        }
    </table></div>
    <button class="ghost" @onclick="AddOutlet">+ Tilføj udtag</button>
    <p class="small muted">Looad-standeren står som "Manuel", indtil vi ved, om den kan flyttes til Spirii (OCPP) – så skiftes den til Spirii eller fjernes.</p>
</div>

<div class="card">
    <div class="card-title">Husstande og ladebrikker (@_f.HouseholdList.Count)</div>
    <div class="wrap"><table>
        <tr><th>Husstand</th><th>Ladebrikker (navn på brikken i Spirii eller dens UID, komma mellem)</th><th></th></tr>
        @foreach (var h in _f.HouseholdList)
        {
            <tr>
                <td><input aria-label="Navn på husstand" @bind="h.Name" /></td>
                <td><input aria-label="Ladebrikker for @h.Name" style="width:100%" value="@string.Join(", ", h.Tokens)" @onchange="e => SetTokens(h, e)" /></td>
                <td><button class="danger" @onclick="() => _f.HouseholdList.Remove(h)">Fjern</button></td>
            </tr>
        }
    </table></div>
    <button class="ghost" @onclick="AddHousehold">+ Tilføj husstand</button>
    <p class="small muted">Opladninger knyttes til en husstand via ladebrikkens navn i Spirii (eller dens UID). Retter du en brik, gælder det nye opladninger.</p>
</div>

<button @onclick="Save">Gem</button> @if (_saved) { <span class="muted"> Gemt</span> }

@code {
    private ForeningData _f = new();
    private bool _saved;
    protected override void OnInitialized() => _f = Store.Get();

    private void AddOutlet() => _f.OutletSetup.Add(new OutletConfig
    {
        Number = _f.OutletSetup.Count == 0 ? 1 : _f.OutletSetup.Max(o => o.Number) + 1, Name = $"Udtag {_f.OutletSetup.Count + 1}",
    });

    private void AddHousehold() => _f.HouseholdList.Add(new Household { Name = "Ny husstand" });

    private static void SetTokens(Household h, ChangeEventArgs e) =>
        h.Tokens = (e.Value?.ToString() ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    private void Save()
    {
        _f.Settings.GridCompanyId = "custom";
        _f.Outlets = _f.OutletSetup.Count;
        Store.Update(_ => { });
        _saved = true;
    }
}
