@page "/biler"
@inject ForeningStore Store
@inject ElectricityPriceService Prices
@implements IDisposable

<PageTitle>Biler · Ladestander</PageTitle>

<div class="eyebrow">Udtag uden live-data · indtastes her</div>
<h1>Manuel opladning</h1>
<p class="lede">Til udtag, der ikke sender data til appen (i dag Looad-standeren). Spirii-udtagene ses automatisk under Nu og Forbrug.</p>

<div class="card">
    <div class="card-title">Udtag</div>
    <div class="list">
        @foreach (var oc in _f.OutletSetup.Where(o => o.Source == "manual").OrderBy(o => o.Number))
        {
            var outlet = oc.Number;
            var s = _f.Sessions.FirstOrDefault(x => x.Active && x.Outlet == outlet);
            var car = s is null ? null : _f.Cars.FirstOrDefault(c => c.Id == s.CarId);
            <div class="item @(s is null ? "" : "active")">
                <div>
                    <b>@oc.Name</b>
                    @if (s is null) { <span class="muted"> · ledigt</span> }
                    else
                    {
                        <div>@car?.Owner – @car?.Name <span class="muted small">siden @s.StartedAt.ToString("HH:mm") · @s.PlannedKwh kWh planlagt · færdig ca. @s.StartedAt.AddHours(s.PlannedKwh / Math.Min(_f.OutletKw, car?.MaxKw ?? _f.OutletKw)).ToString("HH:mm")</span></div>
                    }
                </div>
                @if (s is null)
                {
                    <div class="row" style="margin:0;flex:1;min-width:220px">
                        <select value="@_startCar.GetValueOrDefault(outlet)" @onchange="e => Pick(outlet, e)">
                            <option value="">Vælg bil…</option>
                            @foreach (var c in _f.Cars) { <option value="@c.Id">@c.Owner – @c.Name</option> }
                        </select>
                        <button @onclick="() => Start(outlet)" disabled="@string.IsNullOrEmpty(_startCar.GetValueOrDefault(outlet))">Start</button>
                    </div>
                }
                else
                {
                    <button class="ghost" @onclick="() => Stop(s)">Færdig</button>
                }
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-title">Biler (@_f.Cars.Count)</div>
    <div class="list">
        @foreach (var c in _f.Cars.OrderBy(c => c.Owner))
        {
            <div class="item">
                <div><b>@c.Owner</b> · @c.Name <span class="muted small">@c.BatteryKwh kWh · @c.MaxKw kW · typisk @c.TypicalKwh kWh</span></div>
                <button class="danger" @onclick="() => Remove(c)">Fjern</button>
            </div>
        }
    </div>
    <h3 style="margin-top:14px">Tilføj bil</h3>
    <div class="row">
        <div><label for="own">Navn og husnr.</label><input id="own" placeholder="Martin 222" @bind="_new.Owner" /></div>
        <div><label for="car">Bil</label><input id="car" placeholder="ID.4" @bind="_new.Name" /></div>
        <div><label for="bat">Batteri kWh</label><input id="bat" type="number" @bind="_new.BatteryKwh" /></div>
        <div><label for="kw">Max kW (AC)</label><input id="kw" type="number" @bind="_new.MaxKw" /></div>
        <div><label for="typ">Typisk opladning kWh</label><input id="typ" type="number" @bind="_new.TypicalKwh" /></div>
        <div><label for="hh">Husstand</label><select id="hh" @bind="_newHousehold"><option value="">–</option>@foreach (var h in _f.HouseholdList) { <option value="@h.Id">@h.Name</option> }</select></div>
    </div>
    <button @onclick="Add" disabled="@(string.IsNullOrWhiteSpace(_new.Owner))">Tilføj</button>
</div>

@if (_f.Sessions.Any(s => !s.Active))
{
    <div class="card">
        <div class="card-title">Seneste opladninger</div>
        <div class="wrap"><table>
            <tr><th>Dato</th><th>Bil</th><th class="n">kWh</th><th class="n">Foreningen</th><th class="n">Beboeren</th></tr>
            @foreach (var s in _f.Sessions.Where(s => !s.Active).OrderByDescending(s => s.StartedAt).Take(30))
            {
                var car = _f.Cars.FirstOrDefault(c => c.Id == s.CarId);
                <tr><td>@s.StartedAt.ToString("dd.MM HH:mm")–@s.EndedAt?.ToString("HH:mm")</td><td>@car?.Owner @car?.Name</td><td class="n">@s.Kwh?.ToString("0.0")</td><td class="n">@s.CostKr?.ToString("0.00") kr</td><td class="n">@s.UserPriceKr?.ToString("0.00") kr</td></tr>
            }
        </table></div>
        <p class="small muted" style="margin-top:8px">kWh = planlagt mængde, dog højst hvad udtaget kunne levere i tiden. Pris = de faktiske 15-minutters priser i tidsrummet + @_f.OperatorName-cut for beboeren.</p>
    </div>
}

@code {
    private ForeningData _f = new();
    private Car _new = new();
    private readonly Dictionary<int, string> _startCar = new();

    protected override void OnInitialized()
    {
        _f = Store.Get();
        Store.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(() => { _f = Store.Get(); StateHasChanged(); });
    public void Dispose() => Store.Changed -= OnChanged;

    private void Add()
    {
        _new.HouseholdId = Guid.TryParse(_newHousehold, out var hid) ? hid : null;
        Store.Update(d => d.Cars.Add(_new));
        _new = new();
        _newHousehold = "";
    }

    private string _newHousehold = "";

    private void Remove(Car c) => Store.Update(d => d.Cars.RemoveAll(x => x.Id == c.Id));

    private void Pick(int outlet, ChangeEventArgs e) => _startCar[outlet] = e.Value?.ToString() ?? "";

    private void Start(int outlet)
    {
        if (!Guid.TryParse(_startCar.GetValueOrDefault(outlet), out var carId)) return;
        var car = _f.Cars.FirstOrDefault(c => c.Id == carId);
        Store.Update(d => d.Sessions.Add(new ChargeSession { CarId = carId, Outlet = outlet, StartedAt = DkTime.Now, PlannedKwh = car?.TypicalKwh ?? 30 }));
        _startCar[outlet] = "";
    }

    private async Task Stop(ChargeSession s)
    {
        var car = _f.Cars.FirstOrDefault(c => c.Id == s.CarId);
        var kw = Math.Min(_f.OutletKw, car?.MaxKw ?? _f.OutletKw);
        var end = DkTime.Now;
        var hours = Math.Max(0.25, (end - s.StartedAt).TotalHours);
        var kwh = Math.Round(Math.Min(s.PlannedKwh, hours * kw), 1);
        var raw = await Prices.GetRangeAsync(DateOnly.FromDateTime(s.StartedAt), DateOnly.FromDateTime(end).AddDays(1), _f.Settings.PriceArea);
        var (meter, user) = SessionPricing.Price(raw, _f, s.StartedAt, end, kwh);
        Store.Update(d =>
        {
            var x = d.Sessions.First(z => z.Id == s.Id);
            x.EndedAt = end;
            x.Kwh = kwh;
            x.CostKr = meter;
            x.UserPriceKr = user;
            x.HouseholdId = car?.HouseholdId;
        });
    }
}
