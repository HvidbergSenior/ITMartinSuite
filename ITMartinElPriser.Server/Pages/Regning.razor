@page "/regning"
@using System.Globalization
@inject ElectricityPriceService Prices
@inject PrefsService Prefs

<PageTitle>Regning – ElPriser</PageTitle>

<h1>Hvad betyder regningen?</h1>
<p class="muted small" style="margin:4px 0 14px">Skriv dit forbrug, så viser vi hvordan en måned fordeler sig – linje for linje, med de seneste 30 dages priser i @_area – og hvad hver linje egentlig er.</p>

<div class="card">
    <div class="row2">
        <div class="field" style="flex:2">
            <label>Dit forbrug, kWh pr. måned</label>
            <input type="number" min="10" max="5000" step="10" @bind="_kwh" @bind:after="RecalcAsync" />
        </div>
        <div class="field" style="flex:1"><label>&nbsp;</label><span class="muted small">≈ @((_kwh * 12).ToString("N0", Da)) kWh/år</span></div>
    </div>
    <div class="muted small">Typisk: lejlighed 150–200, hus 250–350, hus med varmepumpe eller elbil 500+. Tallet står på din seneste regning eller på eloverblik.dk.</div>
</div>

@if (_bill is null)
{
    <div class="card muted">Regner…</div>
}
else
{
    var b = _bill;
    <div class="card now-tile">
        <div class="now-price">≈ @b.TotalKr.ToString("0", Da)</div>
        <div class="now-unit">kr pr. måned · @_kwh kWh · @((b.Kwh > 0 ? b.TotalKr / b.Kwh : 0).ToString("0.00", Da)) kr/kWh alt inkl.</div>
        @{
            var moms = b.Lines.First(l => l.Id == "moms").Kr;
            var stat = b.Lines.Where(l => l.Id is "afgift" or "energinet").Sum(l => l.Kr) + moms;
            var el = b.Lines.First(l => l.Id == "spot").Kr;
        }
        @if (b.TotalKr > 0)
        {
            <div class="now-compare">Selve strømmen er <b>@((el / b.TotalKr * 100).ToString("0", Da)) %</b> af regningen · staten (afgift, Energinet, moms) <b>@((stat / b.TotalKr * 100).ToString("0", Da)) %</b> · resten er transport og abonnementer.</div>
        }
    </div>

    <div class="card">
        <div class="card-title">Linje for linje – tryk for forklaring</div>
        @foreach (var l in b.Lines)
        {
            var open = _open == l.Id;
            <div class="bill-line" @onclick="() => _open = open ? null : l.Id">
                <div class="appl-row">
                    <span><b>@l.Title</b> <span class="muted small">· @l.Recipient@(l.IsFixed ? " · fast" : "")</span></span>
                    <b>@l.Kr.ToString("0.00", Da) kr</b>
                </div>
                @if (b.TotalKr > 0) { <div class="bill-bar"><i style="width:@((l.Kr / b.TotalKr * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></i></div> }
                @if (open)
                {
                    <div class="bill-explain">
                        <p>@l.What</p>
                        <p><b>Kan du gøre noget?</b> @l.Influence</p>
                        @if (!string.IsNullOrEmpty(l.Tip)) { <p class="lvl-cheap">💡 @l.Tip</p> }
                    </div>
                }
            </div>
        }
        <div class="appl-row" style="padding-top:10px;font-weight:700"><span>I alt</span><b>@b.TotalKr.ToString("0.00", Da) kr</b></div>
    </div>

    <div class="card">
        <div class="card-title">Sådan læser du regningen</div>
        <div class="small">
            <p><b>Én regning, tre modtagere.</b> Elleverandøren (@_supplierName) sender regningen, men beholder kun strømmen, tillægget og sit abonnement. Nettarif og net-abonnement sendes videre til netselskabet (@_gridName), og afgift, Energinet-tariffer og moms går til staten. Leverandøren er altså bare kassereren for det meste af beløbet.</p>
            <p><b>Det du kan vælge:</b> kun leverandøren. Netselskab, tariffer og afgifter er de samme uanset hvem du handler hos. Når du sammenligner tilbud, så se udelukkende på tillæg pr. kWh + abonnement.</p>
            <p><b>Det du kan flytte:</b> spotprisen og nettariffen afhænger af tidspunktet. Det er derfor appen sender besked om billigste tid – de to poster er typisk halvdelen af regningen.</p>
            <p><b>Det du kun kan skrue ned:</b> Energinet, elafgift og moms følger antal kWh. Mindre forbrug er det eneste der virker.</p>
            <p><b>Aconto og årsopgørelse:</b> mange betaler et fast aconto-beløb hver måned og får en efterregning eller penge tilbage én gang om året. Beløbet her er hvad en måned <i>faktisk</i> koster – ikke det der bliver trukket. Sammenlign med "forbrug i perioden" på årsopgørelsen.</p>
            <p class="muted">Regnet som om forbruget er jævnt fordelt over døgnet. Abonnementerne er fra appens forudsætninger (@_supplierName / @_gridName) – vælg dit eget netselskab og leverandør under Indstillinger. Vinterens høj- og spidslasttariffer er skøn.</p>
        </div>
    </div>

    <div class="card cta">
        <div class="card-title">Vil du se din rigtige regning?</div>
        <div class="small">MinElpris læser din elmåler time for time og regner regningen ud fra det du faktisk brugte – og finder de apparater der koster mest.</div>
        <a class="btn btn-primary btn-block" href="https://minelpris.itmartin.dk" style="margin-top:10px">Åbn MinElpris →</a>
    </div>
}

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private const int Days = 30;
    private int _kwh = 300;
    private Bill? _bill;
    private string? _open;
    private string _area = "DK1";
    private string _supplierName = "";
    private string _gridName = "";
    private List<PricedPoint>? _priced;

    protected override async Task OnInitializedAsync()
    {
        var s = Prefs.Get();
        _area = s.PriceArea;
        _supplierName = SupplierPreset.All.FirstOrDefault(p => p.Id == s.SupplierId)?.Name ?? "elleverandøren";
        _gridName = GridCompanyPreset.All.FirstOrDefault(g => g.Id == s.GridCompanyId)?.Name ?? "netselskabet";
        var to = DateOnly.FromDateTime(DkTime.Now);
        var raw = await Prices.GetRangeAsync(to.AddDays(-Days), to, s.PriceArea);
        _priced = raw.Select(p => PriceBreakdownCalculator.Compute(p, s)).ToList();
        await RecalcAsync();
    }

    // The month's kWh spread evenly over every hour of the last 30 days, so
    // the split between spot, tariffs and fees reflects real recent prices.
    private Task RecalcAsync()
    {
        if (_priced is null) return Task.CompletedTask;
        var s = Prefs.Get();
        var to = DateOnly.FromDateTime(DkTime.Now);
        var from = to.AddDays(-Days);
        var perHour = Math.Clamp(_kwh, 1, 10000) / (double)(Days * 24);
        var kwhByHour = new Dictionary<DateTime, double>();
        for (var t = from.ToDateTime(TimeOnly.MinValue); t < to.ToDateTime(TimeOnly.MinValue); t = t.AddHours(1))
            kwhByHour[t] = perHour;
        _bill = BillCalculator.Build(from, to, kwhByHour, _priced, s);
        return Task.CompletedTask;
    }
}
