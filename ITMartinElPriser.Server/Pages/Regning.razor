





































@page "/regning"
@using System.Globalization
@inject ElectricityPriceService Prices
@inject PrefsService Prefs

<PageTitle>Regning – ElPriser</PageTitle>

<h1>Hvad betyder regningen?</h1>
<p class="muted small" style="margin:4px 0 14px">Vælg dit elselskab og skriv dit forbrug, så viser vi hvordan en måned fordeler sig – linje for linje, med de seneste 30 dages priser – og hvad hver linje egentlig er.</p>

<div class="card">
    <div class="card-title">Hvad har du?</div>
    <div class="muted small" style="margin-bottom:8px">Begge dele står på din regning. Netselskabet bestemmer transport-prisen og kan ikke vælges; leverandøren kan.</div>
    <div class="field">
        <label>Elleverandør</label>
        <select @bind="_s.SupplierId" @bind:after="() => SettingsChangedAsync()">
            @foreach (var sp in SupplierPreset.All) { <option value="@sp.Id">@sp.Name</option> }
        </select>
    </div>
    @if (_s.SupplierId == "custom")
    {
        <div class="field"><label>Leverandørtillæg, øre/kWh ekskl. moms</label><input type="number" step="0.1" @bind="_s.CustomTillaegOre" @bind:after="() => SettingsChangedAsync()" /></div>
    }
    <div class="field">
        <label>Netselskab</label>
        <select @bind="_s.GridCompanyId" @bind:after="() => SettingsChangedAsync()">
            @foreach (var g in GridCompanyPreset.All) { <option value="@g.Id">@g.Name @(string.IsNullOrEmpty(g.Region) ? "" : $"– {g.Region}")</option> }
        </select>
    </div>
    @if (_s.GridCompanyId == "custom")
    {
        <div class="field"><label>Nettarif, øre/kWh ekskl. moms</label><input type="number" step="0.1" @bind="_s.CustomNettarifOre" @bind:after="() => SettingsChangedAsync()" /></div>
    }
    <div class="field">
        <label>Prisområde</label>
        <select @bind="_s.PriceArea" @bind:after="AreaChangedAsync">
            <option value="DK1">DK1 – Jylland og Fyn</option>
            <option value="DK2">DK2 – Sjælland, Lolland-Falster, Bornholm</option>
        </select>
    </div>
    <div class="row2">
        <div class="field" style="flex:2">
            <label>Dit forbrug, kWh pr. måned</label>
            <input type="number" min="10" max="5000" step="10" @bind="_kwh" @bind:after="RecalcAsync" />
        </div>
        <div class="field" style="flex:1"><label>&nbsp;</label><span class="muted small">≈ @((_kwh * 12).ToString("N0", Da)) kWh/år</span></div>
    </div>
    <div class="muted small">Typisk: lejlighed 150–200, hus 250–350, hus med varmepumpe eller elbil 500+. Tallet står på din seneste regning eller på eloverblik.dk.</div>
</div>

@if (_bill is null)
{
    <div class="card muted">Regner…</div>
}
else
{
    var b = _bill;
    <div class="card now-tile">
        <div class="now-price">≈ @b.TotalKr.ToString("0", Da)</div>
        <div class="now-unit">kr pr. måned · @_kwh kWh · @((b.Kwh > 0 ? b.TotalKr / b.Kwh : 0).ToString("0.00", Da)) kr/kWh alt inkl.</div>
        @{
            var moms = b.Lines.First(l => l.Id == "moms").Kr;
            var stat = b.Lines.Where(l => l.Id is "afgift" or "energinet").Sum(l => l.Kr) + moms;
            var el = b.Lines.First(l => l.Id == "spot").Kr;
        }
        @if (b.TotalKr > 0)
        {
            <div class="now-compare">Selve strømmen er <b>@((el / b.TotalKr * 100).ToString("0", Da)) %</b> af regningen · staten (afgift, Energinet, moms) <b>@((stat / b.TotalKr * 100).ToString("0", Da)) %</b> · resten er transport og abonnementer.</div>
        }
    </div>

    <div class="card">
        <div class="card-title">Sådan ser regningen ud</div>
        <div class="muted small" style="margin-bottom:8px">Et eksempel med dine tal, stillet op som elselskaberne gør det. Tryk på en linje for at få ordet forklaret. Tallene i cirklerne viser hvem pengene ender hos.</div>
        @{
            var perKwh = b.Kwh > 0 ? 1 / b.Kwh : 0;
            var exMoms = b.TotalKr - Kr("moms");
            var aconto = Math.Round(b.TotalKr / 50) * 50;
            string Unit(string id) => $"{b.Kwh.ToString("0", Da)} kWh × {(Kr(id) * perKwh).ToString("0.000", Da)}";
        }
        <div class="bill-paper">
            <div class="bill-head">
                <div><b>@_supplierName</b><br /><span class="muted">Elregning</span></div>
                <div style="text-align:right" class="muted">Kundenr. 1234567<br />Periode: @b.From.ToString("d/M", Da)–@b.To.AddDays(-1).ToString("d/M yyyy", Da)<br />Målt forbrug: <b>@b.Kwh.ToString("0", Da) kWh</b></div>
            </div>

            <div class="bill-sec">① Elhandel <span class="muted">– @_supplierName</span></div>
            @Paper("spot", "Strøm, spotpris", Unit("spot"))
            @Paper("tillaeg", "Tillæg", Unit("tillaeg"))
            @Paper("abo-lev", "Abonnement", "1 md.")

            <div class="bill-sec">② Transport <span class="muted">– @_gridName, opkræves af @_supplierName</span></div>
            @Paper("net", "Nettarif", Unit("net"))
            @Paper("abo-net", "Netabonnement", "1 md.")

            <div class="bill-sec">③ Afgifter og tariffer <span class="muted">– staten / Energinet</span></div>
            @Paper("energinet", "Transmissions- og systemtarif", Unit("energinet"))
            @Paper("afgift", "Elafgift", Unit("afgift"))

            <div class="bill-r bill-sum"><span>I alt ekskl. moms</span><span></span><b>@exMoms.ToString("N2", Da)</b></div>
            @Paper("moms", "③ Moms 25 %", "")
            <div class="bill-r bill-total"><span>I alt inkl. moms</span><span></span><b>@b.TotalKr.ToString("N2", Da) kr</b></div>

            <div class="bill-r muted" style="margin-top:8px"><span>Betalt aconto</span><span></span><b>-@aconto.ToString("N2", Da)</b></div>
            <div class="bill-r"><span>@((b.TotalKr - aconto) >= 0 ? "Til betaling" : "Til udbetaling")</span><span></span><b>@Math.Abs(b.TotalKr - aconto).ToString("N2", Da) kr</b></div>
        </div>
        <div class="muted small" style="margin-top:8px">Rækkefølgen og navnene varierer fra selskab til selskab – nogle skriver "Nettarif C" eller "Transport af el", andre lægger transporten sammen i én linje. Beløbene og hvem de går til er de samme. Aconto-linjen er kun et eksempel.</div>
    </div>

    <div class="card">
        <div class="card-title">Linje for linje – tryk for forklaring</div>
        @foreach (var l in b.Lines)
        {
            var open = _open == l.Id;
            <div class="bill-line" @onclick="() => _open = open ? null : l.Id">
                <div class="appl-row">
                    <span><b>@l.Title</b> <span class="muted small">· @l.Recipient@(l.IsFixed ? " · fast" : "")</span></span>
                    <b>@l.Kr.ToString("0.00", Da) kr</b>
                </div>
                @if (b.TotalKr > 0) { <div class="bill-bar"><i style="width:@((l.Kr / b.TotalKr * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></i></div> }
                @if (open)
                {
                    <div class="bill-explain">
                        <p>@l.What</p>
                        <p><b>Kan du gøre noget?</b> @l.Influence</p>
                        @if (!string.IsNullOrEmpty(l.Tip)) { <p class="lvl-cheap">💡 @l.Tip</p> }
                    </div>
                }
            </div>
        }
        <div class="appl-row" style="padding-top:10px;font-weight:700"><span>I alt</span><b>@b.TotalKr.ToString("0.00", Da) kr</b></div>
    </div>

    <div class="card">
        <div class="card-title">Sådan læser du regningen</div>
        <ol class="small guide">
            <li><b>Én regning, tre modtagere.</b> Elleverandøren (@_supplierName) sender regningen, men beholder kun strømmen, tillægget og sit abonnement. Nettarif og net-abonnement sendes videre til netselskabet (@_gridName), og afgift, Energinet-tariffer og moms går til staten. Leverandøren er altså bare kassereren for det meste af beløbet.</li>
            <li><b>Det du kan vælge:</b> kun leverandøren. Netselskab, tariffer og afgifter er de samme uanset hvem du handler hos. Når du sammenligner tilbud, så se udelukkende på tillæg pr. kWh + abonnement.</li>
            <li><b>Det du kan flytte:</b> spotprisen og nettariffen afhænger af tidspunktet. Det er derfor appen sender besked om billigste tid – de to poster er typisk halvdelen af regningen.</li>
            <li><b>Det du kun kan skrue ned:</b> Energinet, elafgift og moms følger antal kWh. Mindre forbrug er det eneste der virker.</li>
            <li><b>Aconto og årsopgørelse:</b> mange betaler et fast aconto-beløb hver måned og får en efterregning eller penge tilbage én gang om året. Beløbet her er hvad en måned <i>faktisk</i> koster – ikke det der bliver trukket. Sammenlign med "forbrug i perioden" på årsopgørelsen.</li>
        </ol>
        <p class="small muted">Regnet som om forbruget er jævnt fordelt over døgnet. Abonnementerne er fra appens forudsætninger (@_supplierName / @_gridName) – vælg dit eget netselskab og leverandør øverst. Vinterens høj- og spidslasttariffer er skøn.</p>
    </div>

    <div class="card cta">
        <div class="card-title">Vil du se din rigtige regning?</div>
        <div class="small">MinElpris læser din elmåler time for time og regner regningen ud fra det du faktisk brugte – og finder de apparater der koster mest.</div>
        <a class="btn btn-primary btn-block" href="https://minelpris.itmartin.dk" style="margin-top:10px">Åbn MinElpris →</a>
    </div>
}

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private double Kr(string id) => _bill?.Lines.FirstOrDefault(l => l.Id == id)?.Kr ?? 0;

    // One line on the "paper" bill: tap it and the same explanation as in the
    // list below unfolds right under it, so the words are learned where they appear.
    private RenderFragment Paper(string id, string name, string detail) => __builder =>
    {
        var l = _bill?.Lines.FirstOrDefault(x => x.Id == id);
        if (l is null) return;
        var open = _open == id;
        <div class="bill-r tap @(open ? "on" : "")" @onclick="() => _open = open ? null : id"><span>@name</span><span class="muted">@detail</span><b>@l.Kr.ToString("N2", Da)</b></div>
        if (open)
        {
            <div class="bill-explain paper-explain"><p><b>@l.Title</b> – @l.What</p><p><b>Kan du gøre noget?</b> @l.Influence</p>@if (!string.IsNullOrEmpty(l.Tip)) { <p class="lvl-cheap">💡 @l.Tip</p> }</div>
        }
    };

    private const int Days = 30;
    private int _kwh = 300;
    private Bill? _bill;
    private string? _open;
    private HouseholdSettings _s = new();
    private string _supplierName = "";
    private string _gridName = "";
    private List<PricePoint>? _raw;

    protected override async Task OnInitializedAsync()
    {
        _s = Prefs.Get();
        await AreaChangedAsync();
    }

    // Region decides which spot prices to fetch; everything else is applied
    // on top of the same 30 days, so only a region change refetches.
    private async Task AreaChangedAsync()
    {
        _bill = null;
        var to = DateOnly.FromDateTime(DkTime.Now);
        _raw = await Prices.GetRangeAsync(to.AddDays(-Days), to, _s.PriceArea);
        await SettingsChangedAsync(save: _seen);
        _seen = true;
    }

    private bool _seen;

    // save=false on first load: JS interop (the cookie) is not available
    // while the page is being prerendered.
    private async Task SettingsChangedAsync(bool save = true)
    {
        _s.ShowAllIn = true; // the bill only makes sense all-in
        if (save) await Prefs.SaveAsync(_s);
        _supplierName = SupplierPreset.All.FirstOrDefault(p => p.Id == _s.SupplierId)?.Name ?? "elleverandøren";
        _gridName = GridCompanyPreset.All.FirstOrDefault(g => g.Id == _s.GridCompanyId)?.Name ?? "netselskabet";
        await RecalcAsync();
    }

    // The month's kWh spread evenly over every hour of the last 30 days, so
    // the split between spot, tariffs and fees reflects real recent prices.
    private Task RecalcAsync()
    {
        if (_raw is null) return Task.CompletedTask;
        var priced = _raw.Select(p => PriceBreakdownCalculator.Compute(p, _s)).ToList();
        var to = DateOnly.FromDateTime(DkTime.Now);
        var from = to.AddDays(-Days);
        var perHour = Math.Clamp(_kwh, 1, 10000) / (double)(Days * 24);
        var kwhByHour = new Dictionary<DateTime, double>();
        for (var t = from.ToDateTime(TimeOnly.MinValue); t < to.ToDateTime(TimeOnly.MinValue); t = t.AddHours(1))
            kwhByHour[t] = perHour;
        _bill = BillCalculator.Build(from, to, kwhByHour, priced, _s);
        return Task.CompletedTask;
    }
}
