@page "/"
@using System.Globalization
@inject FrontPageUseCases Front
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>ElPriser</PageTitle>

@* The front page answers one question in five seconds: what does power cost now, and
   should I wait? Planning (start times, night, EV) lives in MinElpris (/planlaeg). Every box has a heading,
   so every box folds (kolibri.js) and the phone remembers it. *@
<h1 class="k-visually-hidden">ElPriser</h1>

@* Only once the saved settings are read - before that every visitor looked new for a moment and the box flashed
   (user 2026-10-21: "when refreshing there is another page first"). *@
@if (_view is not null && (_askHome || _gridName.Length == 0))
{
    <section class="k-card">
        <h2 class="k-card-title">Hvor bor du?</h2>
        <p class="small">Prisen afhænger af dit netselskab. Gemmes kun på din telefon.</p>
        <button class="k-btn k-btn-primary k-btn-block" @onclick="LocateAsync" disabled="@_searching">Jeg er hjemme nu – brug min placering</button>
        <form class="row2 u-mt8" @onsubmit="FindAddressAsync" @onsubmit:preventDefault>
            <input class="field u-f1" @bind="_addr" placeholder="…eller skriv din adresse eller dit postnummer" aria-label="Adresse eller postnummer" />
            <button class="k-btn" type="submit" disabled="@_searching">Find</button>
        </form>
        @if (_gridName.Length > 0)
        {
            <button class="k-btn u-mt8" @onclick="() => _askHome = false">Behold @_gridName</button>
        }
    </section>
}
@if (_askSupplier)
{
    @* The elselskab (user 2026-10-21 "chip on the front"): it is on the bill, and its markup makes the price here the person's own. *@
    <section class="k-card">
        <h2 class="k-card-title">Dit elselskab</h2>
        <p class="small">Står øverst på din elregning. Ved du det ikke, så vælg „Typisk elselskab“.</p>
        @* Kolibri controls (user 2026-11-24: no browser-default look), and nothing preselected - no one is told they have NRGi. *@
        <label class="k-label" for="supplier">Elselskab</label>
        <select id="supplier" class="k-input" @bind="_supplierPick">
            <option value="" disabled>Vælg dit elselskab</option>
            @foreach (var sp in Front.Suppliers) { <option value="@sp.Id">@sp.Name</option> }
        </select>
        @if (_supplierPick == SupplierPreset.Custom.Id)
        {
            <label class="k-label" for="custom-ore">Dit elselskabs tillæg, øre pr. kWh uden moms (står på regningen)</label>
            <input id="custom-ore" class="k-input" type="number" min="0" max="300" step="0.1" @bind="_customOre" />
        }
        <div class="k-row k-mt">
            <button class="k-btn k-btn-primary" disabled="@(_supplierPick.Length == 0)" @onclick="SaveSupplierAsync">Gem elselskab</button>
            <button class="k-btn" @onclick="() => _askSupplier = false">Fortryd</button>
        </div>
    </section>
}
@if (_locateMsg.Length > 0)
{
    <p class="k-alert k-alert-info small" role="status">@_locateMsg</p>
}
@if (_pending is { } pend)
{
    <section class="k-card small" role="status">
        <h2 class="k-card-title">Nyt hjem?</h2>
        <p class="u-mb8">Du er ved <b>@pend.Place.Label</b>, hvor netselskabet er <b>@pend.Grid.Name</b>. Er det dit nye hjem?</p>
        <p class="k-muted u-mb8">Priserne skal regnes med netselskabet, hvor du bor – ikke hvor du er lige nu.</p>
        <div class="k-row k-mt">
            <button class="k-btn k-btn-primary" @onclick="() => SaveHomeAsync(pend.Place, pend.Grid)">Ja, skift til @pend.Grid.Name</button>
            <button class="k-btn" @onclick="() => _pending = null">Nej, behold @_gridName</button>
        </div>
    </section>
}

@* How to put ElPriser on the phone: the shared Kolibri install button (kolibri.js), like every other app. *@

@* "Hvad viser siden?" removed 2026-11-24 (user): the front page explains itself. *@

@if (_view is null)
{
    <section class="k-card now-tile"><h2 class="k-card-title">Prisen nu</h2><div class="k-muted">Henter priser…</div></section>
}
else if (!_snap!.HasData || _view.RunAt(QuarterNow()) is not { } now)
{
    <section class="k-card now-tile">
        <h2 class="k-card-title">Prisen nu</h2>
        <div class="now-verdict lvl-mid">Ingen priser lige nu</div>
        <div class="now-compare">Energinet svarer ikke. Prøv igen om lidt.</div>
    </section>
}
else
{
    // One machine, one price: the chosen machine started now - or at the hour tapped in the bars -
    // and the cheapest start from now on, night included.
    var strip = Strip();
    // Heights on one scale over BOTH whole days (past hours included), colours from each hour's
    // own day (Rank01) - so an hour keeps its height and colour all day instead of changing as
    // the morning's hours drop off the strip (user 2026-10-12: "the night looked different").
    var allHours = (_snap.Today?.Hours ?? []).Concat(_snap.Tomorrow?.Hours ?? []).ToList();
    var min = allHours.Count > 0 ? allHours.Min(h => h.KrPerKwh) : 0;
    var span = allHours.Count > 0 ? allHours.Max(h => h.KrPerKwh) - min : 0;
    var picked = _selected is { } sel ? strip.FirstOrDefault(h => h.Start == sel) : null;
    var start = picked?.Start ?? QuarterNow();
    // The big number is ALWAYS "start now" (user 2026-11-24); a tapped column is shown under the chart with the difference.
    var run = now;
    var pickedRun = picked is null ? null : _view.RunAt(start);
    double? rank = _snap.NowRank01;
    var lvl = Level(rank);
    // The cheapest start from now on (user 2026-10-19: "change it to cheapest"), night included (2026-10-20: "also at
    // night"), said as one sentence: "Start i nat kl. 02:00 – det er billigst". The best start while you are up comes under it.
    var best = _view.Cheapest(QuarterNow(), night: true);
    var awake = _view.Cheapest(QuarterNow(), night: false);
    // The period the page points at (user 2026-11-26): cheapest before night, done by 23:00; at night, the cheapest from now on.
    var eveRun = _view.CheapestBeforeNight(QuarterNow());
    var nightRun = _view.CheapestAtNight(QuarterNow());
    var cheapestRun = new[] { eveRun, nightRun }.Where(r => r is not null).MinBy(r => r!.CostKr);
    var mark = cheapestRun ?? best;
    var hasTomorrow = _snap.Tomorrow?.Hours.Count > 0;
    var m = Current;
    <section class="k-card now-tile @lvl">
        <h2 class="k-card-title">Prisen nu</h2>
        @* Hidden 2026-11-26 (user: "remove ... should be hidden, maybe visible later") - flip ShowDetails to bring them back.
           First visit still asks "Hvor bor du?" in its own box above. *@
        @if (ShowDetails)
        {
        <button class="area-chip" title="Netselskabet ejer ledningerne på din vej og kan ikke vælges – ret kun adressen, hvis den er forkert" @onclick="() => _askHome = !_askHome" disabled="@_searching">
            @if (_searching) { <text>Finder dig…</text> }
            else if (_gridName.Length > 0) { <text>Netselskab i @_postal: <b>@_gridName</b> · ret adresse</text> }
            else { <text>Hvor bor du?</text> }
        </button>
        <button class="area-chip" title="Skift elselskab" @onclick="OpenSupplier">
            @if (_s.SupplierId == SupplierPreset.Typical.Id) { <text>Elselskab: <b>typisk</b> (gennemsnit) · vælg dit</text> }
            else if (FrontPageUseCases.SupplierName(_s) is { Length: > 0 } sn) { <text>Dit elselskab: <b>@sn</b> · skift</text> }
            else { <text>Vælg dit elselskab <small>(prisen er uden elselskabets tillæg)</small></text> }
        </button>
        }
        @* 4 devices (user 2026-11-26: "Opvaskemaskine, Elcykel, Elbil, Kedel"), each with typical numbers. *@
        <div class="chips chips-small" role="group" aria-label="Vælg apparat">
            @foreach (var kind in HomeMachine.FrontKinds)
            {
                var k = kind;
                <button class="chip @(m.Kind == k ? "on" : "")" aria-pressed="@(m.Kind == k)" @onclick="() => PickMachineAsync(k)">@HomeMachine.Fixed(k).Name</button>
            }
        </div>
        @* Fewer words (user 2026-11-26). *@
        @if (m.Kind == HomeMachine.CarKind)
        {
            @* Turned around so it reads naturally (user 2026-11-26): "100 km kørsel = 20 kWh". *@
            <div class="now-device">Elbil · 100 km kørsel = @Kwh(m.Kwh) kWh · @Hours(m.Hours) på @HomeMachine.HomeChargerKw kW ladeboks</div>
            @* A full charge for comparison: 10 -> 80 % of a typical 70 kWh battery = 49 kWh in the car, ~54 kWh from the wall. *@
            <div class="k-muted small u-center">Fuld opladning (10 → 80 %, ca. 54 kWh): ca. @Hours(HomeMachine.QuarterHours(54 / HomeMachine.HomeChargerKw))</div>
        }
        else
        {
            <div class="now-device">@m.Name · @Kwh(m.Kwh) kWh @m.Amount i @Hours(m.Hours)</div>
        }
        <div class="now-price @lvl">@(run is null ? "–" : Kr(run.CostKr)) KR</div>
        @* Only the cheapest (user 2026-11-26: "Billigst only"): before night or tonight, whichever is cheaper; the timer line
           only when it is at night. *@
        @if (m.CanWait && cheapestRun is { } cr && run is not null && cr.CostKr < run.CostKr)
        {
            <div class="now-device now-gap">Billigst: <b>kl. @cr.Start.ToString("HH:mm") · @Kr(cr.CostKr) kr</b></div>
            @if (_view.IsQuiet(cr.Start) && cr.Start > QuarterNow())
            {
                <div class="k-muted small u-center">Timer: sæt den til <b>@Delay(cr.Start)</b>.</div>
            }
        }
        <div class="now-verdict @lvl">@(run is null ? "Priserne dækker ikke hele perioden endnu" : Verdict(rank))</div>
        @* The explanation folded away (user 2026-11-26: "some of the info could be in a tab or otherwise hidden"). *@
        <details class="calc-fold" data-remember="regnet-pris">
            <summary>Sådan er det regnet</summary>
            @* Simple (user 2026-11-26: "needs to be more simple"): kWh, hours and the sum line are hidden with ShowDetails. *@
            @* The price for the run itself (user 2026-11-26: "it should be the price for running the opvaskemaskine in 2 hours"):
               the average kr/kWh over the hours it runs from now, so kWh x price = the big number. *@
            @if (run is not null)
            {
                @* "(lige nu 4,14)" = the "nu" column, so the two numbers do not look like a mistake (user 2026-11-26). *@
                var nowCol = strip.FirstOrDefault(x => x.IsNow);
                <div class="now-device">Prisen de næste @Hours(m.Hours): <b>@Kr(RunKrPerKwh(run, m)) kr/kWh</b>@(nowCol is null ? "" : $" (lige nu {Kr(nowCol.KrPerKwh)})")</div>
            }
            @if (run is not null)
            {
                @* The sum behind the big number, small and neutral (user 2026-11-26: "and the calculation in small letters"). *@
                var perKwh = RunKrPerKwh(run, m);
                @* One block, the second line explaining the kr/kWh of the first (user 2026-11-26: "should look associated"). *@
                <div class="now-calc calc-pair">
                    <div>@Kwh(m.Kwh) kWh × <u>@Kr(perKwh) kr/kWh</u> @(Math.Abs(Math.Round(perKwh * m.Kwh, 2) - run.CostKr) < 0.005 ? "=" : "≈") @Kr(run.CostKr) kr</div>
                    <div class="calc-why"><u>@Kr(perKwh) kr/kWh</u> @RunColumnsText(QuarterNow(), m.Hours)</div>
                </div>
            }
            @* The span in kr when the device has one (dishwasher), else what the average depends on (user 2026-11-26). *@
            @if (m.Span is { } kwhSpan && run is not null)
            {
                <div class="k-muted small u-center">@kwhSpan.Low (@Kwh(kwhSpan.LowKwh) kWh): <b>@Kr(run.CostKr * kwhSpan.LowKwh / m.Kwh) kr</b> · @kwhSpan.High (@Kwh(kwhSpan.HighKwh) kWh): <b>@Kr(run.CostKr * kwhSpan.HighKwh / m.Kwh) kr</b></div>
            }
            else
            {
                <div class="k-muted small u-center">@m.DependsOn</div>
            }
        </details>
        @* "Billigst: start ..." + "Senere start" hidden (user 2026-11-26: "remove") - comes back with ShowDetails. *@
        @if (ShowDetails && best is not null && run is not null)
        {
            @* One colour, and the answer said in words - not red/green on one line. *@
            <div class="now-best">
                @* Wording user 2026-11-24 ("needs more intuitive descriptions"): the answer first, then what it saves, then
                   exactly what to press on the machine. *@
                @if (best.Start <= QuarterNow())
                {
                    <b>Start den nu – det bliver ikke billigere de næste 12 timer.</b>
                }
                else
                {
                    @* The cheapest PERIOD within the next 12 hours, start to finish (user 2026-11-24). *@
                    @* Short (user 2026-11-26: "way too much text"). *@
                    <b>Billigst: start @StartAt(best.Start) – @Kr(best.CostKr) kr@(run.CostKr - best.CostKr >= 0.01 ? $" (spar {Kr(run.CostKr - best.CostKr)} kr)" : "")</b>
                    <span>Senere start: sæt den til <b>@Delay(best.Start)</b>.</span>
                }
                @if (awake is not null && _view.IsQuiet(best.Start) && awake.Start != best.Start)
                {
                    <span class="k-muted small">Ikke om natten: @(awake.Start <= QuarterNow() ? "start nu" : StartAt(awake.Start)) – @Kr(awake.CostKr) kr.</span>
                }
            </div>
        }
        @if (!hasTomorrow)
        {
            <div class="k-muted small u-center">Morgendagens priser kommer ca. kl. 13.</div>
        }
        @* Not changeable on the free app. "Baseret på" hidden too (user 2026-11-26: "no lines about this on frontpage...
           should be somewhere else") - behind ShowDetails until it gets its own place. *@
        @if (ShowDetails)
        {
        var supplierShown = _s.SupplierId == SupplierPreset.Typical.Id ? "typisk elselskab" : FrontPageUseCases.SupplierName(_s) is { Length: > 0 } sup ? sup : "uden elselskabets tillæg";
        <div class="k-muted small u-center u-mt6">Baseret på @(_gridName.Length > 0 ? $"{_gridName} ({_postal})" : "typisk netselskab") · @supplierShown · med moms og afgifter</div>
        }
    </section>

    @* Dishwasher savings box, like the elbil one (user 2026-11-26: "yes"): today's saving, and per year from the REAL prices
       of the last 30 days (Hindsight: one wash a day at the cheapest time instead of 18:00) - not today x 365. *@
    @if (m.Kind == HomeMachine.DishKind && run is not null && cheapestRun is { } dishCheap && dishCheap.CostKr < run.CostKr)
    {
        <section class="k-card now-tile lvl-cheap">
            <h2 class="k-card-title">Hvad sparer du på opvasken?</h2>
            <div class="now-device">Start @(dishCheap == eveRun ? "før natten" : "i nat") kl. @dishCheap.Start.ToString("HH:mm") i stedet for nu:</div>
            <div class="now-price lvl-cheap">@Kr(run.CostKr - dishCheap.CostKr) KR</div>
            <div class="now-device">sparet i dag – @Kr(dishCheap.CostKr) kr i stedet for @Kr(run.CostKr) kr</div>
            @* The line keeps its place while the 30 days are worked out, so nothing jumps. *@
            <div class="small now-gap u-center">
                @if (_hindsight is { } hy && hy.SavedKr >= 1)
                {
                    <text>Én opvask om dagen på den billigste tid i stedet for kl. 18: ca. <b>@Round10(hy.PerYearKr) kr om året</b> <span class="k-muted">(regnet på de sidste @hy.Days dages priser)</span></text>
                }
                else if (_hindsightLoading)
                {
                    <span class="k-muted">Regner året ud …</span>
                }
            </div>
        </section>
    }

    @* Elbil box (user 2026-11-26: "more specific and more clear on the savings"): one headline with the saving, then a small
       table - now / at the cheap time / saved - for four concrete situations. The explanation is folded. Kr only. *@
    @if (m.Kind == HomeMachine.CarKind && run is not null && cheapestRun is { } cheap && cheap.CostKr < run.CostKr)
    {
        var cheapWhen = cheap == eveRun ? "før natten" : "i nat";
        <section class="k-card now-tile lvl-cheap">
            <h2 class="k-card-title">Hvad sparer du på 100 km?</h2>
            <div class="now-device">Lad @cheapWhen kl. @cheap.Start.ToString("HH:mm") i stedet for nu:</div>
            <div class="now-price lvl-cheap">@Kr(run.CostKr - cheap.CostKr) KR</div>
            <div class="now-device">sparet pr. 100 km – @Kr(cheap.CostKr) kr i stedet for @Kr(run.CostKr) kr</div>
            <div class="tbl-wrap now-gap">
                <table class="small ev-table">
                    <thead><tr><th>100 km</th><th>Ladet nu</th><th>Ladet @cheapWhen</th><th>Du sparer</th></tr></thead>
                    <tbody>
                        @foreach (var (car, label, f) in EvRows())
                        {
                            <tr>
                                <td>@label</td>
                                <td>@(EvKr(car, run, m.Kwh, f)) kr</td>
                                <td>@(EvKr(car, cheap, m.Kwh, f)) kr</td>
                                <td><b>@(EvSaved(car, run, cheap, m.Kwh, f)) kr</b></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="small u-mt6 u-center">Lynlader ude: ca. @((m.Kwh * EvExample.FastChargeLow).ToString("0", Da))–@((m.Kwh * EvExample.FastChargeHigh).ToString("0", Da)) kr pr. 100 km – samme pris hele døgnet.</div>
            <details class="calc-fold" data-remember="regnet-elbil">
                <summary>Sådan er det regnet</summary>
                <div class="k-muted small">Lille bil (fx Tesla Model 3) bruger ca. @EvExample.Small.KwhPer100Km kWh pr. 100 km, stor bil (fx Audi Q8 e-tron) ca. @EvExample.Big.KwhPer100Km kWh – målt fra stikket. Ved 0 °C bruger bilen ca. 30 % mere (varme og koldt batteri), ved 130 km/t ca. 25 % mere. "Ladet @cheapWhen" er den samme tur, men bilen er ladet på den billige tid på en 11 kW ladeboks.</div>
            </details>
        </section>
    }

    @if (strip.Count > 0)
    {
        <section class="k-card">
            <h2 class="k-card-title">Time for time</h2>
            @* The hours the machine runs in are shaded, so a 2-hour run shows as more than one column (user 2026-11-24). *@
            @* Shaded: the tapped start's run - or, with nothing tapped, the cheapest period (user 2026-11-24). *@
            @{ var runFrom = picked is not null ? start : mark is not null ? mark.Start : start; var runTo = runFrom.AddHours(m.Hours);
               var runCols = strip.Count(x => x.Start < runTo && x.Start.AddHours(1) > runFrom);
               var firstRunCol = strip.FirstOrDefault(x => x.Start < runTo && x.Start.AddHours(1) > runFrom)?.Start; }
            <div class="bars">
                @foreach (var h in strip)
                {
                    var inRun = h.Start < runTo && h.Start.AddHours(1) > runFrom;
                    // Shade only the part of the hour the run uses: a 03:45 start shades the last quarter of the "3" column (user 2026-11-26).
                    var runFromFrac = inRun ? Math.Clamp((runFrom - h.Start).TotalMinutes / 60, 0, 1) : 0;
                    var runToFrac = inRun ? Math.Clamp((runTo - h.Start).TotalMinutes / 60, 0, 1) : 0;
                    var pct = span > 0 ? 15 + 85 * (h.KrPerKwh - min) / span : 50;
                    @* The whole column is the tap target: it moves the machine's start to that hour. *@
                    <div class="bar-col @(_selected == h.Start ? "sel" : "") @(inRun ? "in-run" : "")"
                         style="@(inRun ? $"--rf:{(runFromFrac * 100).ToString("0", CultureInfo.InvariantCulture)}%;--rt:{(runToFrac * 100).ToString("0", CultureInfo.InvariantCulture)}%" : null)"
                         @onclick="() => _selected = _selected == h.Start || h.IsNow ? null : h.Start">
                        <div class="bar @Band(h.Rank01) @(h.IsNow ? "now" : "") @(h.Start.Hour == 0 ? "midnight" : "")"
                             style="--h:@pct.ToString("0", CultureInfo.InvariantCulture)%">
                            @* Said in words too, not only in green (user is a bit colour-blind). *@
                            @* The tag sits where the advice says to START (the whole run's cheapest start), not on the single
                               cheapest hour - two different "billigst" confused (user 2026-11-24). *@
                            @* Each column's own price on it (user 2026-11-26: "shown instead of popup"). *@
                            <span class="bar-val">@h.KrPerKwh.ToString("0.00", Da)</span>

                        </div>
                        @* How long the shaded run is, written across the shaded columns (user 2026-11-26: "it should say 2 timer"). *@
                        @if (h.Start == firstRunCol && runCols > 0)
                        {
                            <span class="run-len" style="--n:@runCols">@Hours(m.Hours)</span>
                        }
                        @* The tag sits on the column, above every price (2026-11-26). *@
                        @* On the shaded period: when, and what the whole run costs there (user 2026-11-26: "it should say 1,79"). *@
                        @if (mark is not null && mark.Start > QuarterNow() && h.Start <= mark.Start && mark.Start < h.Start.AddHours(1))
                            { <span class="bar-tip">billigst kl. @mark.Start.ToString("HH:mm") · @Kr(mark.CostKr) kr</span> }
                    </div>
                }
            </div>
            <div class="bar-axis">
                @for (var i = 0; i < strip.Count; i++)
                {
                    var h = strip[i];
                    // The hour under every column, "nu" under the current one (user 2026-11-26: "time under each column except nu").
                    var label = h.IsNow ? "nu" : h.Start.Hour.ToString();
                    <span class="@(label.Length > 2 ? "axis-word" : "")">@label</span>
                }
            </div>
            @* Each column's numbers in words (user 2026-11-24: "each column, how much"): the tapped hour, or now. *@
            @* Start time and the whole run first; the hour's own kWh price last (user 2026-11-24: "20-21?" was confusing). *@
            @{ var shown = picked ?? strip.FirstOrDefault(h => h.IsNow); var shownRun = picked is null ? run : pickedRun;
               var from = picked is null ? QuarterNow() : start; }
            @if (shown is not null)
            {
                <div class="small u-mt4 u-center">
                    @if (shownRun is null)
                    {
                        <text><b>Start @(picked is null ? "nu" : StartAt(from))</b>: priserne dækker ikke hele perioden endnu.</text>
                    }
                    else
                    {
                        @* Closer to the columns, no dashes (user 2026-11-26). *@
                        <text><b>Start @(picked is null ? "nu" : StartAt(from))</b> · færdig kl. @from.AddHours(m.Hours).ToString("HH:mm") · <b>@Kr(shownRun.CostKr) kr</b></text>
                        @if (picked is not null && run is not null)
                        {
                            var diff = shownRun.CostKr - run.CostKr;
                            <text> · <b>@(Math.Abs(diff) < 0.01 ? "det samme som nu" : diff < 0 ? $"{Kr(-diff)} kr billigere end nu" : $"{Kr(diff)} kr dyrere end nu")</b></text>
                        }
                    }
                </div>
            }
            <div class="k-muted small u-mt6 u-center">Kr pr. kWh · hver søjle er snittet af timens 4 kvarter.</div>
            @if (picked is not null)
            {
                <div class="k-muted small u-mt6 u-center">Tryk igen for at gå tilbage til nu.</div>
            }
        </section>
    }

}


@* "Hvad havde du sparet?" hidden (user 2026-11-26: "hide") - comes back with ShowDetails. *@
@if (!ShowDetails) { }
else if (_hindsight is null && _hindsightLoading && _view is not null)
{
    @* The box holds its place while it is worked out, so nothing jumps down when the number comes. *@
    <section class="k-card now-tile lvl-cheap hindsight-wait">
        <h2 class="k-card-title">Hvad havde du sparet?</h2>
        <div class="now-price lvl-cheap">…</div>
        <div class="now-unit">Regner ud …</div>
    </section>
}
else if (_hindsight is { } hs && hs.SavedKr >= 1)
{
    @* Checked 2026-10-21 (user: "is that calculated correct?"): real prices for each of the last days, the household's
       own tariff, the machine priced quarter by quarter while it runs - started at 18:00 vs at that day's cheapest
       quarter (night included). Worked out in the Domain (Hindsight) and tested. *@
    <section class="k-card now-tile lvl-cheap">
        <h2 class="k-card-title">Hvad havde du sparet?</h2>
        <div class="now-price lvl-cheap">@hs.SavedKr.ToString("0", Da) kr</div>
        <div class="now-unit">på @hs.Days dage – ca. @Round10(hs.PerYearKr) kr om året</div>
        @* Short (user 2026-11-26: "way too much text"). *@
        <div class="now-compare">Én @Current.Run om dagen på billigste tid i stedet for kl. 18.</div>
        @if (_gridName.Length == 0)
        {
            <div class="k-muted small u-mt6">Skriv hvor du bor øverst, så bliver tallet præcist.</div>
        }
    </section>
}

@* The "Det får du i MinElpris" teaser block was removed 2026-09-28 (user): ElPriser stands on its own. *@

@code {
    private static readonly CultureInfo Da = new("da-DK");
    // The four situations in the elbil box: small/big car, mild and normal vs cold and motorway.
    private static IEnumerable<(EvExample Car, string Label, double Factor)> EvRows() =>
    [
        (EvExample.Small, "Lille bil, 20 °C", 1),
        (EvExample.Small, "Lille bil, frost + 130 km/t", EvExample.WinterFactor * EvExample.MotorwayFactor),
        (EvExample.Big, "Stor bil, 20 °C", 1),
        (EvExample.Big, "Stor bil, frost + 130 km/t", EvExample.WinterFactor * EvExample.MotorwayFactor),
    ];
    private static string EvSaved(EvExample car, RunOption now, RunOption cheap, double standardKwh, double factor) =>
        ((car.CostKr(now, standardKwh) - car.CostKr(cheap, standardKwh)) * factor).ToString("0", Da);

    // "= snittet af søjlerne 17 og 18" when the run starts on a whole hour; else the exact span, counted per quarter.
    private static string RunColumnsText(DateTime from, double hours)
    {
        if (from.Minute != 0 || hours != Math.Floor(hours))
            return $"= kl. {from:HH:mm}–{from.AddHours(hours):HH:mm}, kvarter for kvarter";
        // Named as the chart shows them: the current hour is "nu", the rest "kl. 18" (the axis has no "17" under "nu").
        var nowHour = DkTime.Now.Hour;
        var cols = Enumerable.Range(0, (int)hours).Select(i => from.AddHours(i))
            .Select(t => t.Date == DkTime.Now.Date && t.Hour == nowHour ? "nu" : $"kl. {t.Hour}").ToList();
        // Long runs (e.g. 5 hours, user 2026-11-26: "is more important when the device takes like 5 hours"): "17–21 (5 søjler)".
        return cols.Count switch
        {
            1 => $"= søjlen {cols[0]}",
            2 => $"= snittet af søjlerne {cols[0]} og {cols[1]}",
            _ => $"= snittet af søjlerne {cols[0]}–{cols[^1]} ({cols.Count} søjler)",
        };
    }

    // The run's average kr/kWh as SHOWN: worked back from the shown cost, so the top line, the sum and the big number agree.
    private static double RunKrPerKwh(RunOption run, HomeMachine m) => Math.Round(run.CostKr / m.Kwh, 2);

    private static string EvKr(EvExample car, RunOption at, double standardKwh, double factor = 1) =>
        (car.CostKr(at, standardKwh) * factor).ToString("0", Da);
    // Address/elselskab chips and the machine's model number - hidden for now (user 2026-11-26), maybe shown later.
    private const bool ShowDetails = false;
    private DateTime? _selected;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // The "now" price steps every 15 minutes; a phone left open on the counter
        // must never be more than a couple of minutes stale.
        // On the page's own thread, and a failed refresh (Energinet slow) keeps the prices already shown.
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            try { await LoadAsync(); StateHasChanged(); } catch { }
        }), null, TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(2));
    }

    private NowView? _view;
    private PriceSnapshot? _snap => _view?.Snapshot;
    private HouseholdSettings _s => _view?.Settings ?? new();
    // The free app prices one machine at a time: the dishwasher or the washing machine (user 2026-10-20), with the
    // household's own hours and kWh from the cookie, each quarter at its own price.
    private HomeMachine Current => _view?.Machine ?? HomeMachine.Fixed(HomeMachine.DishKind);

    // "kl. 22:45", "i nat kl. 02:00", "i morgen kl. 13:15".
    private string StartAt(DateTime t) => $"{When(t)}:{t:mm}";

    // For a machine with a delayed start: how long from now until the start, in the machine's own steps (half hours).
    private string Delay(DateTime start)
    {
        var halves = Math.Max(1, (int)Math.Round((start - DkTime.Now).TotalMinutes / 30));
        var h = halves / 2;
        return (h, halves % 2 == 1) switch
        {
            (0, _) => "½ time",
            (1, false) => "1 time",
            (_, false) => $"{h} timer",
            (_, true) => $"{h}½ time" + (h == 1 ? "" : "r"),
        };
    }

    private async Task PickMachineAsync(string kind)
    {
        _selected = null;
        await Front.PickMachineAsync(_s, kind);
        _ = InvokeAsync(LoadHindsightAsync);   // "Hvad havde du sparet?" follows the machine
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // First visit: nothing is guessed from where the phone happens to be - the "Hvor bor du?"
        // card asks (use my location if I am home, or type the address).
        _ = InvokeAsync(LoadHindsightAsync);
    }

    private static string Kwh(double v) => v.ToString("0.##", Da);
    private static string Round10(double kr) => (Math.Round(kr / 10) * 10).ToString("#,##0", Da);
    // "2 timer", "3 t 45 min", "45 min"
    private static string Hours(double h)
    {
        var whole = (int)h;
        var min = (int)Math.Round((h - whole) * 60);
        if (min == 0) return whole == 1 ? "1 time" : $"{whole} timer";
        return whole == 0 ? $"{min} min" : $"{whole} t {min} min";
    }

    private DateTime QuarterNow()
    {
        var n = _snap?.At ?? DkTime.Now;
        return new DateTime(n.Year, n.Month, n.Day, n.Hour, n.Minute / 15 * 15, 0);
    }

    private async Task LoadAsync()
    {
        _view = await Front.LoadAsync();
        // A phone that picked the washer before keeps getting the dishwasher (only machine on the free page now).
        if (!HomeMachine.FrontKinds.Contains(_view.Settings.Machine))
        {
            _view.Settings.Machine = HomeMachine.DishKind;   // in memory only - no cookie write while prerendering
            _view = await Front.LoadAsync();
        }
        _postal = _view.Settings.PostalCode;
        _gridName = _view.Settings.GridName;
    }

    private string _postal = "", _gridName = "";
    private bool _searching;
    private string _locateMsg = "";

    // "Hvad havde du sparet?" - worked out in the Domain (Hindsight) from the last 30 days' real prices.
    private Hindsight? _hindsight;
    private bool _hindsightLoading = true;
    private async Task LoadHindsightAsync()
    {
        // Used again by the dishwasher savings box (user 2026-11-26) - only the dishwasher needs the 30-day lookup.
        if (_view is null || _view.Machine.Kind != HomeMachine.DishKind) { _hindsight = null; _hindsightLoading = false; StateHasChanged(); return; }
        _hindsightLoading = true;
        try { _hindsight = _view is null ? null : await Front.HindsightAsync(_view.Settings); }
        catch { _hindsight = null; }   // Energinet down: the box simply is not shown
        _hindsightLoading = false;
        StateHasChanged();
    }
    private bool _askHome;
    private bool _askSupplier;
    private string _supplierPick = "";
    private double _customOre;

    private void OpenSupplier()
    {
        _supplierPick = _s.SupplierId;   // "" = "Vælg dit elselskab", never a guess
        _customOre = _s.CustomTillaegOre;
        _askSupplier = !_askSupplier;
    }

    private async Task SaveSupplierAsync()
    {
        await Front.PickSupplierAsync(_s, _supplierPick, _customOre);
        _askSupplier = false;
        await HomeSavedAsync();   // the prices change with the markup: load again, like a new home
    }
    private string _addr = "";

    // A typed address or postcode -> the grid company there. Being typed, it IS the home.
    private async Task FindAddressAsync()
    {
        _searching = true;
        _locateMsg = "";
        StateHasChanged();
        await ShowAsync(await Front.FindAddressAsync(_addr));
    }

    private sealed record GeoPoint(double Lat, double Lon, int Error = 0);

    // The phone's location -> exact grid company. No lists: one point gives one company.
    private async Task LocateAsync()
    {
        _searching = true;
        StateHasChanged();
        var pos = await JS.InvokeAsync<GeoPoint?>("epUi.locate");
        if (pos is null || pos.Error != 0)
        {
            // Never a silent nothing (user 2026-10-05: "Jeg er hjemme nu virker ikke på telefon").
            _searching = false;
            _locateMsg = FrontPageUseCases.LocationProblem(pos?.Error ?? 2);
            StateHasChanged();
            return;
        }
        await ShowAsync(await Front.AtLocationAsync(pos.Lat, pos.Lon, _askHome));
    }

    private (Place Place, GridCompany Grid)? _pending;

    private async Task ShowAsync(HomeAnswer answer)
    {
        _searching = false;
        switch (answer)
        {
            case HomeAnswer.Problem p: _locateMsg = p.Message; break;
            case HomeAnswer.AskSwitch a: _pending = (a.Place, a.Grid); break;
            case HomeAnswer.Saved: await HomeSavedAsync(); break;
        }
        StateHasChanged();
    }

    private async Task SaveHomeAsync(Place place, GridCompany g)
    {
        await Front.SaveHomeAsync(place, g);
        await HomeSavedAsync();
    }

    private async Task HomeSavedAsync()
    {
        _pending = null;
        _askHome = false;
        _locateMsg = "";
        _view = null;
        await LoadAsync();
        _ = InvokeAsync(LoadHindsightAsync);
    }

    // The current hour onwards, today and tomorrow in one strip.
    // From now until the morning after the coming night (06:00), at least 12 and at most 16 hours - so the night is in view
    // and each column has room for its price (user 2026-11-26: 30+ columns once tomorrow's prices are out was too crowded).
    private List<HourBar> Strip()
    {
        var now = QuarterNow();
        var morning = now.Date.AddHours(_s.QuietToHour);
        if (morning <= now) morning = morning.AddDays(1);
        var end = morning > now.AddHours(16) ? now.AddHours(16) : morning < now.AddHours(12) ? now.AddHours(12) : morning;
        return [.. (_snap?.Today?.Hours ?? []).Concat(_snap?.Tomorrow?.Hours ?? []).Where(h => !h.IsPast && h.Start < end)];
    }

    // "kl. 13" today, "i nat kl. 03", "i morgen kl. 14".
    private string When(DateTime t)
    {
        var today = DateOnly.FromDateTime(_snap?.At ?? DkTime.Now);
        if (DateOnly.FromDateTime(t) == today) return $"kl. {t:HH}";
        return t.Hour < 7 ? $"i nat kl. {t:HH}" : $"i morgen kl. {t:HH}";
    }

    // The bar's band as a class (colour from the theme); the height still tells the price without colour.
    private static string Band(double rank) => rank <= 0.33 ? "band-cheap" : rank >= 0.67 ? "band-expensive" : "band-mid";

    public void Dispose() => _timer?.Dispose();

    private static string Kr(double? v) => v is { } x ? x.ToString("0.00", Da) : "–";

    private static string Level(double? rank) => rank switch
    {
        null => "lvl-mid",
        <= 0.33 => "lvl-cheap",
        >= 0.67 => "lvl-expensive",
        _ => "lvl-mid",
    };

    private static string Verdict(double? rank) => rank switch
    {
        null => "",
        <= 0.15 => "Blandt dagens billigste",
        <= 0.33 => "Billigt lige nu",
        >= 0.85 => "Dagens dyreste",
        >= 0.67 => "Dyrt lige nu",
        _ => "Middel pris",
    };

}
