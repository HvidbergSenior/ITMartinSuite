@page "/"
@using System.Globalization
@inject FrontPageUseCases Front
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>ElPriser</PageTitle>

@* The front page answers one question in five seconds: what does power cost now, and
   should I wait? Planning (start times, night, EV) lives in MinElpris (/planlaeg). Every box has a heading,
   so every box folds (kolibri.js) and the phone remembers it. *@
<h1 class="k-visually-hidden">ElPriser</h1>

@if (_askHome || _gridName.Length == 0)
{
    <section class="k-card">
        <h2 class="k-card-title">Hvor bor du?</h2>
        <p class="small">Prisen afhænger af netselskabet, der leverer strømmen til dit hjem. Vi gemmer kun postnummer og netselskab – på din egen telefon.</p>
        <button class="k-btn k-btn-primary k-btn-block" @onclick="LocateAsync" disabled="@_searching">Jeg er hjemme nu – brug min placering</button>
        <form class="row2 u-mt8" @onsubmit="FindAddressAsync" @onsubmit:preventDefault>
            <input class="field u-f1" @bind="_addr" placeholder="…eller skriv din adresse eller dit postnummer" aria-label="Adresse eller postnummer" />
            <button class="k-btn" type="submit" disabled="@_searching">Find</button>
        </form>
        @if (_gridName.Length > 0)
        {
            <button class="k-btn u-mt8" @onclick="() => _askHome = false">Behold @_gridName</button>
        }
    </section>
}
@if (_askSupplier)
{
    @* The elselskab (user 2026-10-21 "chip on the front"): it is on the bill, and its markup makes the price here the person's own. *@
    <section class="k-card">
        <h2 class="k-card-title">Dit elselskab</h2>
        <p>Elselskabet lægger sit eget tillæg oven i strømprisen. Vælg dit, så er prisen her din egen pris. Navnet står øverst på din elregning.</p>
        <select class="field" @bind="_supplierPick" aria-label="Elselskab">
            @foreach (var sp in Front.Suppliers) { <option value="@sp.Id">@sp.Name</option> }
        </select>
        @if (_supplierPick == SupplierPreset.Custom.Id)
        {
            <label class="small u-mt8">Dit elselskabs tillæg, øre pr. kWh uden moms (står på regningen)</label>
            <input class="field" type="number" min="0" max="300" step="0.1" @bind="_customOre" />
        }
        <div class="btn-row">
            <button class="k-btn k-btn-primary" @onclick="SaveSupplierAsync">Gem elselskab</button>
            <button class="k-btn" @onclick="() => _askSupplier = false">Fortryd</button>
        </div>
    </section>
}
@if (_locateMsg.Length > 0)
{
    <p class="k-alert k-alert-info small" role="status">@_locateMsg</p>
}
@if (_pending is { } pend)
{
    <section class="k-card small" role="status">
        <h2 class="k-card-title">Nyt hjem?</h2>
        <p class="u-mb8">Du er ved <b>@pend.Place.Label</b>, hvor netselskabet er <b>@pend.Grid.Name</b>. Er det dit nye hjem?</p>
        <p class="k-muted u-mb8">Priserne skal regnes med netselskabet, hvor du bor – ikke hvor du er lige nu.</p>
        <div class="btn-row">
            <button class="k-btn k-btn-primary" @onclick="() => SaveHomeAsync(pend.Place, pend.Grid)">Ja, skift til @pend.Grid.Name</button>
            <button class="k-btn" @onclick="() => _pending = null">Nej, behold @_gridName</button>
        </div>
    </section>
}

@* How to put ElPriser on the phone: the shared Kolibri install button (kolibri.js), like every other app. *@

<PageHelp Key="help-nu">
    <ul>
        <li><b>Dit hjem og dit elselskab</b> øverst i boksen: tryk på dem for at skifte. Elselskabet står øverst på din elregning, og med det bliver prisen din egen.</li>
        <li><b>Vælg maskine</b> øverst i boksen: opvaskemaskine eller vaskemaskine.</li>
        <li><b>Det store tal</b> er hvad én opvask eller vask koster, hvis du starter den nu – kvarter for kvarter, så længe maskinen kører. Alt inkl. moms, elafgift og nettarif.</li>
        <li><b>Din egen maskine:</b> tryk <b>Ret tid og strøm</b> og vælg, hvor længe dit program kører, og hvor mange kWh det bruger (står i manualen eller på energimærket). Det gemmes på din egen telefon. Ved du det ikke, så brug det, der står: opvask 0,54 kWh (Eco), vask 1 kWh (40 grader).</li>
        <li><b>Farven:</b> grøn = billigt, gul = middel, rød = dyrt – i forhold til resten af samme dag. Dyre timer er også stribede, og den billigste time er mærket „billigst“, så du kan se det uden at skelne farverne.</li>
        <li><b>Søjlerne</b> er prisen time for time fra nu og frem til i morgen. Tryk på en søjle, så viser det store tal hvad opvasken koster hvis den starter der. Tryk igen for at gå tilbage til nu.</li>
        <li><b>Start kl. … – det er billigst</b> er det starttidspunkt inden for de næste 12 timer, hvor maskinen koster mindst – også om natten. Er det om natten, står der også det billigste tidspunkt mellem kl. 6 og 23, hvis du ikke vil have den kørende, mens I sover.</li>
        <li><b>Kan du tidsindstille maskinen?</b> Mange maskiner har <b>senere start</b> (et ur eller en knap med en lille klokke). Der står, hvor mange timer du skal sætte den til – så starter den selv på det billigste tidspunkt, også mens du sover. Morgendagens priser kommer ca. kl. 13.</li>
        <li>Flere maskiner (tørretumbler, ovn, elbil) finder du i <a href="https://minelpris.itmartin.dk" target="_blank" rel="noopener">MinElpris</a>.</li>
    </ul>
</PageHelp>

@if (_view is null)
{
    <section class="k-card now-tile"><h2 class="k-card-title">Prisen nu</h2><div class="k-muted">Henter priser…</div></section>
}
else if (!_snap!.HasData || _view.RunAt(QuarterNow()) is not { } now)
{
    <section class="k-card now-tile">
        <h2 class="k-card-title">Prisen nu</h2>
        <div class="now-verdict lvl-mid">Ingen priser lige nu</div>
        <div class="now-compare">Energinet svarer ikke. Prøv igen om lidt.</div>
    </section>
}
else
{
    // One machine, one price: the chosen machine started now - or at the hour tapped in the bars -
    // and the cheapest start from now on, night included.
    var strip = Strip();
    // Heights on one scale over BOTH whole days (past hours included), colours from each hour's
    // own day (Rank01) - so an hour keeps its height and colour all day instead of changing as
    // the morning's hours drop off the strip (user 2026-10-12: "the night looked different").
    var allHours = (_snap.Today?.Hours ?? []).Concat(_snap.Tomorrow?.Hours ?? []).ToList();
    var min = allHours.Count > 0 ? allHours.Min(h => h.KrPerKwh) : 0;
    var span = allHours.Count > 0 ? allHours.Max(h => h.KrPerKwh) - min : 0;
    var cheapest = strip.MinBy(h => h.KrPerKwh);
    var picked = _selected is { } sel ? strip.FirstOrDefault(h => h.Start == sel) : null;
    var start = picked?.Start ?? QuarterNow();
    var run = picked is null ? now : _view.RunAt(start);
    double? rank = picked is null ? _snap.NowRank01 : picked.Rank01;
    var lvl = Level(rank);
    // The cheapest start from now on (user 2026-10-19: "change it to cheapest"), night included (2026-10-20: "also at
    // night"), said as one sentence: "Start i nat kl. 02:00 – det er billigst". The best start while you are up comes under it.
    var best = _view.Cheapest(QuarterNow(), night: true);
    var awake = _view.Cheapest(QuarterNow(), night: false);
    var hasTomorrow = _snap.Tomorrow?.Hours.Count > 0;
    var m = Current;
    <section class="k-card now-tile @lvl">
        <h2 class="k-card-title">Prisen nu</h2>
        @* Home, not "where the phone is": asked once (location if you are home, or your address). Tap to change. *@
        <button class="area-chip" title="Skift dit hjem" @onclick="() => _askHome = !_askHome" disabled="@_searching">
            @if (_searching) { <text>Finder dig…</text> }
            else if (_gridName.Length > 0) { <text>@_postal <small>@_gridName</small> · skift</text> }
            else { <text>Hvor bor du?</text> }
        </button>
        <button class="area-chip" title="Skift elselskab" @onclick="OpenSupplier">
            @(FrontPageUseCases.SupplierName(_s) is { Length: > 0 } sn ? $"Elselskab: {sn} · skift" : "Vælg dit elselskab")
        </button>
        <div class="chips chips-small" role="group" aria-label="Vælg maskine">
            <button class="chip @(m.IsWash ? "" : "on")" aria-pressed="@(!m.IsWash)" @onclick="() => PickMachineAsync(HomeMachine.DishKind)">Opvaskemaskine</button>
            <button class="chip @(m.IsWash ? "on" : "")" aria-pressed="@m.IsWash" @onclick="() => PickMachineAsync(HomeMachine.WashKind)">Vaskemaskine</button>
        </div>
        <div class="now-device">Én @m.Run · @Kwh(m.Kwh) kWh · @Hours(m.Hours) · start @(picked is null ? "nu" : When(start))</div>
        <div class="now-price @lvl">@(run is null ? "–" : Kr(run.CostKr)) KR</div>
        @if (run is not null)
        {
            @* The sum behind the big number, in a neutral colour (never fighting the verdict's colour). *@
            <div class="now-calc">@Kwh(m.Kwh) kWh × @Kr(run.AvgKrPerKwh) kr/kWh i snit over @Hours(m.Hours) = @Kr(run.CostKr) kr</div>
        }
        <div class="now-verdict @lvl">@(run is null ? $"Priserne dækker ikke hele {m.Run}en endnu" : Verdict(rank))</div>
        @if (best is not null && run is not null)
        {
            @* One colour, and the answer said in words - not red/green on one line. *@
            <div class="now-best">
                @if (best.Start <= QuarterNow())
                {
                    <b>Start nu – det er billigst.</b>
                }
                else
                {
                    <b>Start @StartAt(best.Start) – det er billigst.</b>
                    <span>Den koster @Kr(best.CostKr) kr@(run.CostKr - best.CostKr >= 0.01 ? $" – du sparer {Kr(run.CostKr - best.CostKr)} kr i forhold til nu" : "").</span>
                    @* User 2026-10-21: "Har maskinen senere start: sæt den til 14½ timer. Something like. Hvis du kan tidsindstille". *@
                    <span>Kan du tidsindstille maskinen? Sæt den til <b>@Delay(best.Start)</b>.</span>
                }
                @if (awake is not null && _view.IsQuiet(best.Start) && awake.Start != best.Start)
                {
                    <span class="k-muted small">Ikke om natten? Mellem kl. 6 og 23 er det billigst @(awake.Start <= QuarterNow() ? "lige nu" : StartAt(awake.Start)) – @Kr(awake.CostKr) kr.</span>
                }
            </div>
        }
        @if (!hasTomorrow)
        {
            <div class="k-muted small u-center">Morgendagens priser kommer ca. kl. 13.</div>
        }
        <button class="linkish small" @onclick="() => _editMachine = !_editMachine">@(_editMachine ? "Luk" : "Ret tid og strøm")</button>
        @if (_editMachine)
        {
            @* The household's own programme (user 2026-10-20: the Asko runs 1.5 hours). Kept in the cookie on the phone. *@
            <div class="row2 u-mt8">
                <label class="small">Kører i
                    <select class="k-input" value="@m.Hours.ToString(CultureInfo.InvariantCulture)" @onchange="SetHoursAsync">
                        @foreach (var h in HourChoices) { <option value="@h.ToString(CultureInfo.InvariantCulture)">@Hours(h)</option> }
                    </select>
                </label>
                <label class="small">Bruger (kWh)
                    <input class="k-input" type="number" inputmode="decimal" min="0.1" max="5" step="0.1"
                           value="@m.Kwh.ToString(CultureInfo.InvariantCulture)" @onchange="SetKwhAsync" />
                </label>
            </div>
            <div class="k-muted small u-mt6">Står i manualen eller på energimærket. Gemmes kun på din telefon.</div>
            <button class="linkish small" @onclick="ResetMachineAsync">Brug standard (@(m.IsWash ? "1 kWh, 2 timer" : "0,54 kWh, 2 timer"))</button>
        }
        @if (picked is not null)
        {
            <button class="linkish small" @onclick="() => _selected = null">↺ Tilbage til nu</button>
        }
    </section>

    @if (strip.Count > 0)
    {
        <section class="k-card">
            <h2 class="k-card-title">Time for time</h2>
            <div class="bars">
                @foreach (var h in strip)
                {
                    var pct = span > 0 ? 15 + 85 * (h.KrPerKwh - min) / span : 50;
                    @* The whole column is the tap target: it moves the machine's start to that hour. *@
                    <div class="bar-col @(_selected == h.Start ? "sel" : "")" title="@When(h.Start) · @Kr(h.KrPerKwh) kr/kWh"
                         @onclick="() => _selected = _selected == h.Start || h.IsNow ? null : h.Start">
                        <div class="bar @Band(h.Rank01) @(h.IsNow ? "now" : "") @(h.Start.Hour == 0 ? "midnight" : "")"
                             style="--h:@pct.ToString("0", CultureInfo.InvariantCulture)%">
                            @* Said in words too, not only in green (user is a bit colour-blind). *@
                            @if (h == cheapest) { <span class="bar-tip">billigst</span> }
                        </div>
                    </div>
                }
            </div>
            <div class="bar-axis">
                @for (var i = 0; i < strip.Count; i++)
                {
                    var h = strip[i];
                    // The hour right after "nu" stays blank, so "nu" never runs into "9" or "15".
                    var label = h.IsNow ? "nu" : i == 1 && strip[0].IsNow ? "" : h.Start.Hour % 3 == 0 ? h.Start.Hour.ToString() : "";
                    <span>@label</span>
                }
            </div>
            <div class="k-muted small u-mt6 u-center">Høje, stribede søjler er dyre timer – lave er billige.</div>
            <div class="k-muted small u-mt6 u-center">Tryk på en søjle – så viser det store tal prisen, hvis @(Current.Run)en starter der.</div>
        </section>
    }

}


@if (_hindsight is { } hs && hs.SavedKr >= 1)
{
    @* Checked 2026-10-21 (user: "is that calculated correct?"): real prices for each of the last days, the household's
       own tariff, the machine priced quarter by quarter while it runs - started at 18:00 vs at that day's cheapest
       quarter (night included). Worked out in the Domain (Hindsight) and tested. *@
    <section class="k-card now-tile lvl-cheap">
        <h2 class="k-card-title">Hvad havde du sparet?</h2>
        <div class="now-price lvl-cheap">@hs.SavedKr.ToString("0", Da) kr</div>
        <div class="now-unit">på de sidste @hs.Days dage – ca. @Round10(hs.PerYearKr) kr om året</div>
        <div class="now-compare">Med én @Current.Run om dagen (@Kwh(Current.Kwh) kWh, @Hours(Current.Hours)): startet kl. 18 hver dag havde den kostet <b>@Kr(hs.UsualKr) kr</b>. Startet på dagens billigste tid havde den kostet <b>@Kr(hs.CheapestKr) kr</b>. Alt inkl. moms, afgifter og @(_gridName.Length > 0 ? _gridName : "nettarif").</div>
        @if (_gridName.Length == 0)
        {
            <div class="k-muted small u-mt6">Vi kender ikke dit netselskab endnu – skriv hvor du bor øverst, så bliver tallet præcist.</div>
        }
        <div class="k-muted small u-mt6">MinElpris regner det på <b>dit eget forbrug</b> fra måleren – for alle dine maskiner og elbilen – og siger til, når du skal starte.</div>
    </section>
}

@* The "Det får du i MinElpris" teaser block was removed 2026-09-28 (user): ElPriser stands on its own. *@

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private DateTime? _selected;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // The "now" price steps every 15 minutes; a phone left open on the counter
        // must never be more than a couple of minutes stale.
        // On the page's own thread, and a failed refresh (Energinet slow) keeps the prices already shown.
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            try { await LoadAsync(); StateHasChanged(); } catch { }
        }), null, TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(2));
    }

    private NowView? _view;
    private PriceSnapshot? _snap => _view?.Snapshot;
    private HouseholdSettings _s => _view?.Settings ?? new();
    // The free app prices one machine at a time: the dishwasher or the washing machine (user 2026-10-20), with the
    // household's own hours and kWh from the cookie, each quarter at its own price.
    private HomeMachine Current => _view?.Machine ?? HomeMachine.Dishwasher();
    private bool _editMachine;
    private static readonly double[] HourChoices = [0.5, 0.75, 1, 1.25, 1.5, 1.75, 2, 2.5, 3, 3.5, 4];

    // "kl. 22:45", "i nat kl. 02:00", "i morgen kl. 13:15".
    private string StartAt(DateTime t) => $"{When(t)}:{t:mm}";

    // For a machine with a delayed start: how long from now until the start, in the machine's own steps (half hours).
    private string Delay(DateTime start)
    {
        var halves = Math.Max(1, (int)Math.Round((start - DkTime.Now).TotalMinutes / 30));
        var h = halves / 2;
        return (h, halves % 2 == 1) switch
        {
            (0, _) => "½ time",
            (1, false) => "1 time",
            (_, false) => $"{h} timer",
            (_, true) => $"{h}½ time" + (h == 1 ? "" : "r"),
        };
    }

    private async Task PickMachineAsync(string kind)
    {
        _selected = null;
        await Front.PickMachineAsync(_s, kind);
        _ = InvokeAsync(LoadHindsightAsync);   // "Hvad havde du sparet?" follows the machine
    }

    private async Task SetHoursAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var h))
            await MachineChangedAsync(Front.SetMachineAsync(_s, h, null));
    }

    private async Task SetKwhAsync(ChangeEventArgs e)
    {
        // A phone may send "1,5" or "1.5".
        if (double.TryParse(e.Value?.ToString()?.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var k))
            await MachineChangedAsync(Front.SetMachineAsync(_s, null, k));
    }

    private Task ResetMachineAsync() => MachineChangedAsync(Front.ResetMachineAsync(_s));

    private async Task MachineChangedAsync(Task save)
    {
        await save;
        _ = InvokeAsync(LoadHindsightAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // First visit: nothing is guessed from where the phone happens to be - the "Hvor bor du?"
        // card asks (use my location if I am home, or type the address).
        _ = InvokeAsync(LoadHindsightAsync);
    }

    private static string Kwh(double v) => v.ToString("0.##", Da);
    private static string Round10(double kr) => (Math.Round(kr / 10) * 10).ToString("#,##0", Da);
    private static string Hours(double h) => h == 1 ? "1 time" : h < 1 ? $"{h * 60:0} min" : $"{h.ToString("0.##", Da)} timer";

    private DateTime QuarterNow()
    {
        var n = _snap?.At ?? DkTime.Now;
        return new DateTime(n.Year, n.Month, n.Day, n.Hour, n.Minute / 15 * 15, 0);
    }

    private async Task LoadAsync()
    {
        _view = await Front.LoadAsync();
        _postal = _view.Settings.PostalCode;
        _gridName = _view.Settings.GridName;
    }

    private string _postal = "", _gridName = "";
    private bool _searching;
    private string _locateMsg = "";

    // "Hvad havde du sparet?" - worked out in the Domain (Hindsight) from the last 30 days' real prices.
    private Hindsight? _hindsight;
    private async Task LoadHindsightAsync()
    {
        try { _hindsight = _view is null ? null : await Front.HindsightAsync(_view.Settings); }
        catch { _hindsight = null; }   // Energinet down: the box simply is not shown
        StateHasChanged();
    }
    private bool _askHome;
    private bool _askSupplier;
    private string _supplierPick = "";
    private double _customOre;

    private void OpenSupplier()
    {
        _supplierPick = _s.SupplierId.Length > 0 ? _s.SupplierId : Front.Suppliers.FirstOrDefault()?.Id ?? "";
        _customOre = _s.CustomTillaegOre;
        _askSupplier = !_askSupplier;
    }

    private async Task SaveSupplierAsync()
    {
        await Front.PickSupplierAsync(_s, _supplierPick, _customOre);
        _askSupplier = false;
        await HomeSavedAsync();   // the prices change with the markup: load again, like a new home
    }
    private string _addr = "";

    // A typed address or postcode -> the grid company there. Being typed, it IS the home.
    private async Task FindAddressAsync()
    {
        _searching = true;
        _locateMsg = "";
        StateHasChanged();
        await ShowAsync(await Front.FindAddressAsync(_addr));
    }

    private sealed record GeoPoint(double Lat, double Lon, int Error = 0);

    // The phone's location -> exact grid company. No lists: one point gives one company.
    private async Task LocateAsync()
    {
        _searching = true;
        StateHasChanged();
        var pos = await JS.InvokeAsync<GeoPoint?>("epUi.locate");
        if (pos is null || pos.Error != 0)
        {
            // Never a silent nothing (user 2026-10-05: "Jeg er hjemme nu virker ikke på telefon").
            _searching = false;
            _locateMsg = FrontPageUseCases.LocationProblem(pos?.Error ?? 2);
            StateHasChanged();
            return;
        }
        await ShowAsync(await Front.AtLocationAsync(pos.Lat, pos.Lon, _askHome));
    }

    private (Place Place, GridCompany Grid)? _pending;

    private async Task ShowAsync(HomeAnswer answer)
    {
        _searching = false;
        switch (answer)
        {
            case HomeAnswer.Problem p: _locateMsg = p.Message; break;
            case HomeAnswer.AskSwitch a: _pending = (a.Place, a.Grid); break;
            case HomeAnswer.Saved: await HomeSavedAsync(); break;
        }
        StateHasChanged();
    }

    private async Task SaveHomeAsync(Place place, GridCompany g)
    {
        await Front.SaveHomeAsync(place, g);
        await HomeSavedAsync();
    }

    private async Task HomeSavedAsync()
    {
        _pending = null;
        _askHome = false;
        _locateMsg = "";
        _view = null;
        await LoadAsync();
        _ = InvokeAsync(LoadHindsightAsync);
    }

    // The current hour onwards, today and tomorrow in one strip.
    private List<HourBar> Strip() =>
        [.. (_snap?.Today?.Hours ?? []).Concat(_snap?.Tomorrow?.Hours ?? []).Where(h => !h.IsPast)];

    // "kl. 13" today, "i nat kl. 03", "i morgen kl. 14".
    private string When(DateTime t)
    {
        var today = DateOnly.FromDateTime(_snap?.At ?? DkTime.Now);
        if (DateOnly.FromDateTime(t) == today) return $"kl. {t:HH}";
        return t.Hour < 7 ? $"i nat kl. {t:HH}" : $"i morgen kl. {t:HH}";
    }

    // The bar's band as a class (colour from the theme); the height still tells the price without colour.
    private static string Band(double rank) => rank <= 0.33 ? "band-cheap" : rank >= 0.67 ? "band-expensive" : "band-mid";

    public void Dispose() => _timer?.Dispose();

    private static string Kr(double? v) => v is { } x ? x.ToString("0.00", Da) : "–";

    private static string Level(double? rank) => rank switch
    {
        null => "lvl-mid",
        <= 0.33 => "lvl-cheap",
        >= 0.67 => "lvl-expensive",
        _ => "lvl-mid",
    };

    private static string Verdict(double? rank) => rank switch
    {
        null => "",
        <= 0.15 => "Blandt dagens billigste",
        <= 0.33 => "Billigt lige nu",
        >= 0.85 => "Dagens dyreste",
        >= 0.67 => "Dyrt lige nu",
        _ => "Middel – hverken billigt eller dyrt",
    };

}
