@page "/"
@using System.Globalization
@inject ElectricityPriceService Prices
@inject HouseholdStore Store
@inject RunLogService RunLog
@implements IDisposable

<PageTitle>ElPriser</PageTitle>

<div class="ep-header">
    <div class="ep-logo">⚡</div>
    <div>
        <div class="ep-title">ElPriser</div>
        <div class="ep-sub">@(_snap?.AllIn == false ? "Spotpris" : "Alt inkl. moms, afgift og nettarif") · @_area</div>
    </div>
</div>

@if (_snap is null)
{
    <div class="card now-tile"><div class="muted">Henter priser…</div></div>
}
else if (!_snap.HasData)
{
    <div class="card now-tile">
        <div class="now-verdict lvl-mid">Ingen priser lige nu</div>
        <div class="now-compare">Energinet svarer ikke. Prøv igen om lidt.</div>
    </div>
}
else
{
    var lvl = Level(_snap.NowRank01);
    <div class="card now-tile @lvl">
        <div class="now-price @lvl">@Kr(_snap.NowKrPerKwh)</div>
        <div class="now-unit">kr/kWh lige nu · kl. @_snap.At.ToString("HH:mm")</div>
        <div class="now-verdict @lvl">@Verdict(_snap.NowRank01)</div>
        @if (_snap.Today is { } t)
        {
            <div class="now-compare">
                I dag: billigst <b>@Kr(t.Min)</b> kl. @t.Cheapest?.Start.ToString("HH") · dyrest <b>@Kr(t.Max)</b> kl. @t.Dearest?.Start.ToString("HH") · snit @Kr(t.Avg)
            </div>
        }
    </div>

    <div class="card">
        <div class="card-title">Hvad koster en tur?</div>
        @foreach (var a in _snap.Appliances)
        {
            <div class="appl">
                <div class="appl-icon">@a.Appliance.Icon</div>
                <div class="appl-name">@a.Appliance.Name <span class="muted">· @a.Appliance.DurationHours.ToString("0.#") t · @a.Appliance.KwhPerRun.ToString("0.#") kWh</span></div>
                @if (a.Now is { } n)
                {
                    <div class="appl-row"><span>Starter du nu</span><b class="@Level(RankOf(a, n))">@n.CostKr.ToString("0.00") kr</b></div>
                }
                @if (a.CheapestToday is { } c && (a.Now is null || c.Start > a.Now.Start))
                {
                    <div class="appl-row">
                        <span>Billigst i dag kl. @c.Start.ToString("HH:mm")</span>
                        <b class="lvl-cheap">@c.CostKr.ToString("0.00") kr @if (a.Now is { } nn && nn.CostKr > c.CostKr) { <span class="saving">(spar @((nn.CostKr - c.CostKr).ToString("0.00")))</span> }</b>
                    </div>
                }
                else if (a.Now is not null)
                {
                    <div class="appl-row"><span class="lvl-cheap">Nu er det billigste tidspunkt i dag</span><b></b></div>
                }
                @if (a.CheapestTomorrow is { } tm)
                {
                    <div class="appl-row"><span>I morgen kl. @tm.Start.ToString("HH:mm")</span><b>@tm.CostKr.ToString("0.00") kr</b></div>
                }
                <div class="run-row">
                    @if (_logged.TryGetValue(a.Appliance.Id, out var done))
                    {
                        <span class="ok">✓ Registreret kl. @done.StartedAt.ToString("HH:mm") – @done.CostKr.ToString("0.00") kr</span>
                    }
                    else if (_pickTime == a.Appliance.Id)
                    {
                        <input type="time" @bind="_pickedTime" step="900" />
                        <button class="btn btn-small btn-primary" @onclick="() => LogAsync(a.Appliance, _pickedTime)">Registrér</button>
                        <button class="btn btn-small" @onclick="() => _pickTime = null">Luk</button>
                    }
                    else
                    {
                        <button class="btn btn-small btn-primary" @onclick="() => LogAsync(a.Appliance, null)">▶ Startet nu</button>
                        <button class="btn btn-small" @onclick="() => { _pickTime = a.Appliance.Id; _pickedTime = TimeOnly.FromDateTime(DkTime.Now); }">Anden tid</button>
                    }
                </div>
            </div>
        }
        <div class="muted small" style="margin-top:8px">Prisen er regnet for hele turen – hvert kvarter maskinen kører, til det kvarters pris. Ret maskinerne under Indstillinger.</div>
    </div>

    <div class="card">
        <div class="day-tabs">
            <button class="tab @(_showTomorrow ? "" : "on")" @onclick="() => { _showTomorrow = false; _selected = null; }">I dag</button>
            <button class="tab @(_showTomorrow ? "on" : "")" @onclick="() => { _showTomorrow = true; _selected = null; }" disabled="@(_snap.Tomorrow is null)">
                @(_snap.Tomorrow is null ? "I morgen (kommer ca. kl. 13)" : "I morgen")
            </button>
        </div>
        @{ var day = _showTomorrow ? _snap.Tomorrow : _snap.Today; }
        @if (day is null)
        {
            <div class="muted">Ingen priser for dagen endnu.</div>
        }
        else
        {
            var span = day.Max - day.Min;
            <div class="bars">
                @foreach (var h in day.Hours)
                {
                    var pct = span > 0 ? 15 + 85 * (h.KrPerKwh - day.Min) / span : 50;
                    <div class="bar @(h.IsPast ? "past" : "") @(h.IsNow ? "now" : "") @(_selected == h.Start ? "sel" : "")"
                         style="height:@pct.ToString("0", CultureInfo.InvariantCulture)%;background:@Color(h.Rank01)"
                         title="@h.Start.ToString("HH:00") @Kr(h.KrPerKwh)"
                         @onclick="() => _selected = h.Start"></div>
                }
            </div>
            <div class="bar-axis">
                @foreach (var h in day.Hours) { <span>@(h.Start.Hour % 3 == 0 ? h.Start.Hour.ToString() : "")</span> }
            </div>
            <div class="bar-info">
                @if (_selected is { } sel && day.Hours.FirstOrDefault(h => h.Start == sel) is { } hb)
                {
                    <span>Kl. @hb.Start.ToString("HH:00")–@hb.Start.AddHours(1).ToString("HH:00")</span>
                    <b class="@Level(hb.Rank01)">@Kr(hb.KrPerKwh) kr/kWh</b>
                }
                else
                {
                    <span class="muted">Tryk på en søjle for prisen</span>
                    <span class="muted">@day.Date.ToString("dddd d. MMM", Da)</span>
                }
            </div>
            <div class="legend"><span><i style="background:var(--cheap)"></i>billig</span><span><i style="background:var(--mid)"></i>middel</span><span><i style="background:var(--expensive)"></i>dyr</span></div>
        }
    </div>
}

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private PriceSnapshot? _snap;
    private string _area = "DK1";
    private bool _showTomorrow;
    private DateTime? _selected;
    private Timer? _timer;
    private readonly Dictionary<Guid, RunEntry> _logged = new();
    private Guid? _pickTime;
    private TimeOnly _pickedTime;

    private async Task LogAsync(Appliance a, TimeOnly? at)
    {
        var start = at is { } t ? DkTime.Now.Date.Add(t.ToTimeSpan()) : DkTime.Now;
        var entry = await RunLog.LogAsync(a.Id, start);
        if (entry is not null) _logged[a.Id] = entry;
        _pickTime = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // The "now" price steps every 15 minutes; refresh a bit more often so
        // the tile is never more than a couple of minutes stale on a phone
        // left open on the counter.
        _timer = new Timer(async _ => { await LoadAsync(); await InvokeAsync(StateHasChanged); }, null, TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(2));
    }

    private async Task LoadAsync()
    {
        var data = Store.Get();
        _area = data.Settings.PriceArea;
        var raw = await Prices.GetPricesAsync(_area);
        _snap = PriceModel.Build(raw, data, DkTime.Now);
    }

    public void Dispose() => _timer?.Dispose();

    private static string Kr(double? v) => v is { } x ? x.ToString("0.00", Da) : "–";

    private static string Level(double? rank) => rank switch
    {
        null => "lvl-mid",
        <= 0.33 => "lvl-cheap",
        >= 0.67 => "lvl-expensive",
        _ => "lvl-mid",
    };

    private static string Verdict(double? rank) => rank switch
    {
        null => "",
        <= 0.15 => "Blandt dagens billigste – kør nu",
        <= 0.33 => "Billigt lige nu",
        >= 0.85 => "Dagens dyreste – vent hvis du kan",
        >= 0.67 => "Dyrt lige nu",
        _ => "Middel – hverken billigt eller dyrt",
    };

    private static double? RankOf(ApplianceView a, RunOption o)
    {
        var lo = a.CheapestToday?.CostKr ?? o.CostKr;
        var hi = a.DearestUpcoming?.CostKr ?? o.CostKr;
        return hi > lo ? (o.CostKr - lo) / (hi - lo) : 0.5;
    }

    private static string Color(double rank) => rank <= 0.33 ? "var(--cheap)" : rank >= 0.67 ? "var(--expensive)" : "var(--mid)";
}
