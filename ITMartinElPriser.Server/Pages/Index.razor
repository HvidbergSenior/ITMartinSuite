@page "/"
@using System.Globalization
@inject ElectricityPriceService Prices
@inject PrefsService Prefs
@implements IDisposable

<PageTitle>ElPriser</PageTitle>

<div class="ep-header">
    <div class="ep-logo">⚡</div>
    <div>
        <div class="ep-title">ElPriser</div>
        <div class="ep-sub">@(_snap?.AllIn == false ? "Spotpris" : "Alt inkl. moms, afgift og nettarif")</div>
    </div>
    <div class="area-toggle">
        <button class="tab @(_area == "DK1" ? "on" : "")" @onclick='() => SetAreaAsync("DK1")'>DK1<small>Vest</small></button>
        <button class="tab @(_area == "DK2" ? "on" : "")" @onclick='() => SetAreaAsync("DK2")'>DK2<small>Øst</small></button>
    </div>
</div>

@if (_snap is null)
{
    <div class="card now-tile"><div class="muted">Henter priser…</div></div>
}
else if (!_snap.HasData)
{
    <div class="card now-tile">
        <div class="now-verdict lvl-mid">Ingen priser lige nu</div>
        <div class="now-compare">Energinet svarer ikke. Prøv igen om lidt.</div>
    </div>
}
else
{
    var lvl = Level(_snap.NowRank01);
    <div class="card now-tile @lvl">
        <div class="now-price @lvl">@Kr(_snap.NowKrPerKwh)</div>
        <div class="now-unit">kr/kWh lige nu · kl. @_snap.At.ToString("HH:mm")</div>
        <div class="now-verdict @lvl">@Verdict(_snap.NowRank01)</div>
        @if (_snap.Today is { } t)
        {
            <div class="now-compare">
                I dag: billigst <b>@Kr(t.Min)</b> kl. @t.Cheapest?.Start.ToString("HH") · dyrest <b>@Kr(t.Max)</b> kl. @t.Dearest?.Start.ToString("HH") · snit @Kr(t.Avg)
            </div>
        }
    </div>

    @if (_snap.Appliances.FirstOrDefault() is { } w)
    {
        <div class="card">
            <div class="card-title">Hvornår er det billigst?</div>
            <div class="muted small" style="margin-bottom:8px">De billigste to timer i træk – til en vask, en opvask eller en opladning. Nattetimer (@_quietFrom–@_quietTo) foreslås ikke.</div>
            @if (w.CheapestToday is { } c && (w.Now is null || c.Start >= w.Now.Start))
            {
                <div class="appl-row"><span>🟢 I dag kl. @c.Start.ToString("HH:mm")–@c.End.ToString("HH:mm")</span><b class="lvl-cheap">@Kr(c.AvgKrPerKwh) kr/kWh</b></div>
            }
            else if (w.Now is not null)
            {
                <div class="appl-row"><span class="lvl-cheap">🟢 Nu er det billigste tidspunkt i dag</span><b></b></div>
            }
            @if (w.DearestUpcoming is { } d && d.Start.AddHours(2) > _snap.At)
            {
                <div class="appl-row"><span>🔴 Dyrest i dag kl. @d.Start.ToString("HH:mm")–@d.End.ToString("HH:mm")</span><b class="lvl-expensive">@Kr(d.AvgKrPerKwh) kr/kWh</b></div>
            }
            @if (w.CheapestTomorrow is { } tm)
            {
                <div class="appl-row"><span>🟢 I morgen kl. @tm.Start.ToString("HH:mm")–@tm.End.ToString("HH:mm")</span><b>@Kr(tm.AvgKrPerKwh) kr/kWh</b></div>
            }
            else
            {
                <div class="appl-row muted small"><span>Morgendagens priser kommer ca. kl. 13.</span><b></b></div>
            }
            @if (_snap.Today is { } td)
            {
                <button class="btn btn-small" style="margin-top:8px" @onclick="() => _showWindows = !_showWindows">@(_showWindows ? "Skjul alle to-timers-vinduer" : "Vis alle to-timers-vinduer i dag")</button>
                @if (_showWindows)
                {
                    <div class="windows">
                        @foreach (var win in TwoHourWindows(td))
                        {
                            <div class="appl-row @(win.Past ? "past" : "")">
                                <span>Kl. @win.Start.ToString("HH")–@win.Start.AddHours(2).ToString("HH")@(win.Now ? " · nu" : "")</span>
                                <b class="@Level(win.Rank)">@Kr(win.Avg) kr/kWh</b>
                            </div>
                        }
                    </div>
                    <div class="muted small" style="margin-top:6px">Gennemsnit for de to timer – det du betaler pr. kWh hvis maskinen kører hele vinduet.</div>
                }
            }
        </div>
    }

    <div class="card">
        <div class="card-title">Hvad koster en tur?</div>
        @foreach (var a in _snap.Appliances.Skip(1))
        {
            <div class="appl">
                <div class="appl-icon">@a.Appliance.Icon</div>
                <div class="appl-name">@a.Appliance.Name <span class="muted">· @a.Appliance.DurationHours.ToString("0.#") t · @a.Appliance.KwhPerRun.ToString("0.#") kWh</span></div>
                @if (a.Now is { } n)
                {
                    <div class="appl-row"><span>Starter du nu</span><b class="@Level(RankOf(a, n))">@n.CostKr.ToString("0.00") kr</b></div>
                }
                @if (a.CheapestToday is { } c && (a.Now is null || c.Start > a.Now.Start))
                {
                    <div class="appl-row">
                        <span>Billigst i dag kl. @c.Start.ToString("HH:mm")</span>
                        <b class="lvl-cheap">@c.CostKr.ToString("0.00") kr @if (a.Now is { } nn && nn.CostKr > c.CostKr) { <span class="saving">(spar @((nn.CostKr - c.CostKr).ToString("0.00")))</span> }</b>
                    </div>
                }
                else if (a.Now is not null)
                {
                    <div class="appl-row"><span class="lvl-cheap">Nu er det billigste tidspunkt i dag</span><b></b></div>
                }
                @if (a.CheapestTomorrow is { } tm)
                {
                    <div class="appl-row"><span>I morgen kl. @tm.Start.ToString("HH:mm")</span><b>@tm.CostKr.ToString("0.00") kr</b></div>
                }
            </div>
        }
        <div class="muted small" style="margin-top:8px">Typiske maskiner. Prisen er regnet for hele turen – hvert kvarter maskinen kører, til det kvarters pris.</div>
    </div>

    <div class="card">
        <div class="day-tabs">
            <button class="tab @(_showTomorrow ? "" : "on")" @onclick="() => { _showTomorrow = false; _selected = null; }">I dag</button>
            <button class="tab @(_showTomorrow ? "on" : "")" @onclick="() => { _showTomorrow = true; _selected = null; }" disabled="@(_snap.Tomorrow is null)">
                @(_snap.Tomorrow is null ? "I morgen (kommer ca. kl. 13)" : "I morgen")
            </button>
        </div>
        @{ var day = _showTomorrow ? _snap.Tomorrow : _snap.Today; }
        @if (day is null)
        {
            <div class="muted">Ingen priser for dagen endnu.</div>
        }
        else
        {
            var span = day.Max - day.Min;
            <div class="bars">
                @foreach (var h in day.Hours)
                {
                    var pct = span > 0 ? 15 + 85 * (h.KrPerKwh - day.Min) / span : 50;
                    <div class="bar @(h.IsPast ? "past" : "") @(h.IsNow ? "now" : "") @(_selected == h.Start ? "sel" : "")"
                         style="height:@pct.ToString("0", CultureInfo.InvariantCulture)%;background:@Color(h.Rank01)"
                         title="@h.Start.ToString("HH:00") @Kr(h.KrPerKwh)"
                         @onclick="() => _selected = h.Start"></div>
                }
            </div>
            <div class="bar-axis">
                @foreach (var h in day.Hours) { <span>@(h.Start.Hour % 3 == 0 ? h.Start.Hour.ToString() : "")</span> }
            </div>
            <div class="bar-info">
                @if (_selected is { } sel && day.Hours.FirstOrDefault(h => h.Start == sel) is { } hb)
                {
                    <span>Kl. @hb.Start.ToString("HH:00")–@hb.Start.AddHours(1).ToString("HH:00")</span>
                    <b class="@Level(hb.Rank01)">@Kr(hb.KrPerKwh) kr/kWh</b>
                }
                else
                {
                    <span class="muted">Tryk på en søjle for prisen</span>
                    <span class="muted">@day.Date.ToString("dddd d. MMM", Da)</span>
                }
            </div>
            <div class="legend"><span><i style="background:var(--cheap)"></i>billig</span><span><i style="background:var(--mid)"></i>middel</span><span><i style="background:var(--expensive)"></i>dyr</span></div>
        }
    </div>

    <div class="card cta">
        <div class="card-title">Dine egne maskiner, din måler, din regning</div>
        <div class="small">MinElpris regner på <b>dine</b> apparater, læser din elmåler og viser hvad hver linje på din regning koster – og hvor du kan spare.</div>
        <a class="btn btn-primary btn-block" href="https://minelpris.itmartin.dk" style="margin-top:10px">Åbn MinElpris →</a>
    </div>
}

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private PriceSnapshot? _snap;
    private string _area = "DK1";
    private int _quietFrom = 23, _quietTo = 6;
    private bool _showTomorrow;
    private bool _showWindows;
    private DateTime? _selected;

    private sealed record Window(DateTime Start, double Avg, double Rank, bool Past, bool Now);

    // Today cut into fixed two-hour blocks (00–02, 02–04, …), each priced as
    // the average of its two hours, coloured against the day's own range.
    private static List<Window> TwoHourWindows(DayView day)
    {
        var list = new List<Window>();
        for (var i = 0; i + 1 < day.Hours.Count; i += 2)
        {
            var a = day.Hours[i]; var b = day.Hours[i + 1];
            var avg = (a.KrPerKwh + b.KrPerKwh) / 2;
            var rank = day.Max > day.Min ? (avg - day.Min) / (day.Max - day.Min) : 0.5;
            list.Add(new Window(a.Start, avg, rank, b.IsPast, a.IsNow || b.IsNow));
        }
        return list;
    }
    private Timer? _timer;

    // The first entry is the two-hour "window" (never listed as a machine);
    // the rest are the typical machines shown under "Hvad koster en tur?".
    private static List<Appliance> Examples() => [NotificationScheduler.Window, .. Appliance.Defaults()];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // The "now" price steps every 15 minutes; refresh a bit more often so
        // the tile is never more than a couple of minutes stale on a phone
        // left open on the counter.
        _timer = new Timer(async _ => { await LoadAsync(); await InvokeAsync(StateHasChanged); }, null, TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(2));
    }

    private async Task LoadAsync()
    {
        var s = Prefs.Get();
        _area = s.PriceArea;
        _quietFrom = s.QuietFromHour;
        _quietTo = s.QuietToHour;
        var raw = await Prices.GetPricesAsync(_area);
        _snap = PriceModel.Build(raw, s, Examples(), DkTime.Now);
    }

    // DK1 = Jylland/Fyn, DK2 = Sjælland og øerne. Saved on the phone so
    // Regning and Besked follow the same choice.
    private async Task SetAreaAsync(string area)
    {
        var s = Prefs.Get();
        if (s.PriceArea == area) return;
        s.PriceArea = area;
        await Prefs.SaveAsync(s);
        _snap = null;
        await LoadAsync();
    }

    public void Dispose() => _timer?.Dispose();

    private static string Kr(double? v) => v is { } x ? x.ToString("0.00", Da) : "–";

    private static string Level(double? rank) => rank switch
    {
        null => "lvl-mid",
        <= 0.33 => "lvl-cheap",
        >= 0.67 => "lvl-expensive",
        _ => "lvl-mid",
    };

    private static string Verdict(double? rank) => rank switch
    {
        null => "",
        <= 0.15 => "Blandt dagens billigste – kør nu",
        <= 0.33 => "Billigt lige nu",
        >= 0.85 => "Dagens dyreste – vent hvis du kan",
        >= 0.67 => "Dyrt lige nu",
        _ => "Middel – hverken billigt eller dyrt",
    };

    private static double? RankOf(ApplianceView a, RunOption o)
    {
        var lo = a.CheapestToday?.CostKr ?? o.CostKr;
        var hi = a.DearestUpcoming?.CostKr ?? o.CostKr;
        return hi > lo ? (o.CostKr - lo) / (hi - lo) : 0.5;
    }

    private static string Color(double rank) => rank <= 0.33 ? "var(--cheap)" : rank >= 0.67 ? "var(--expensive)" : "var(--mid)";
}
