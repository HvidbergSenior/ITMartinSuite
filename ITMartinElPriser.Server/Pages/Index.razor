@page "/"
@using System.Globalization
@inject ElectricityPriceService Prices
@inject PrefsService Prefs
@inject GridTariffs Grids
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>ElPriser</PageTitle>

@* The front page answers one question in five seconds: what does power cost now, and
   should I wait? Planning (start times, night, EV) lives in MinElpris (/planlaeg). *@
<div class="ep-header">
    <div class="ep-logo">⚡</div>
    <div class="ep-title">ElPriser</div>
    @* Location only: found automatically on the first visit, tap to look again. Nothing to choose. *@
    <button class="area-chip" title="Find mit netselskab ud fra min placering" @onclick="LocateAsync" disabled="@_searching">
        @if (_searching) { <text>📍 Finder dig…</text> }
        else if (_gridName.Length > 0) { <text>📍 @_postal <small>@_gridName</small></text> }
        else { <text>📍 Find mig</text> }
    </button>
</div>

<PageHelp Key="help-nu">
    <ul>
        <li><b>Det store tal</b> er hvad det koster at køre din opvaskemaskine, hvis du starter den nu – regnet med 1 kWh over 2 timer, kvarter for kvarter. Alt inkl. moms, elafgift og nettarif.</li>
        <li><b>Farven:</b> grøn = billigt, gul = middel, rød = dyrt – i forhold til resten af dagen.</li>
        <li><b>Søjlerne</b> er prisen time for time fra nu og frem til i morgen. Tryk på en søjle, så viser det store tal hvad opvasken koster hvis den starter der. Tryk igen for at gå tilbage til nu.</li>
        <li><b>I morgen</b> er den samme opvask, startet på samme klokkeslæt i morgen. Morgendagens priser kommer ca. kl. 13.</li>
        <li>Flere maskiner (vaskemaskine, tørretumbler, ovn) finder du i <a href="https://minelpris.itmartin.dk" target="_blank" rel="noopener">MinElpris</a>.</li>
    </ul>
</PageHelp>

@if (_snap is null)
{
    <div class="card now-tile"><div class="muted">Henter priser…</div></div>
}
else if (!_snap.HasData || Dishes(QuarterNow()) is not { } now)
{
    <div class="card now-tile">
        <div class="now-verdict lvl-mid">Ingen priser lige nu</div>
        <div class="now-compare">Energinet svarer ikke. Prøv igen om lidt.</div>
    </div>
}
else
{
    // One machine, one price: the dishwasher started now - or at the hour tapped in the bars -
    // and the same start on the other day.
    var strip = Strip();
    var min = strip.Count > 0 ? strip.Min(h => h.KrPerKwh) : 0;
    var span = strip.Count > 0 ? strip.Max(h => h.KrPerKwh) - min : 0;
    var picked = _selected is { } sel ? strip.FirstOrDefault(h => h.Start == sel) : null;
    var start = picked?.Start ?? QuarterNow();
    var run = picked is null ? now : Dishes(start);
    double? rank = picked is null ? _snap.NowRank01 : span > 0 ? (picked.KrPerKwh - min) / span : 0.5;
    var lvl = Level(rank);
    var isTomorrow = DateOnly.FromDateTime(start) > DateOnly.FromDateTime(_snap.At);
    var other = isTomorrow ? Dishes(start.AddDays(-1)) : Dishes(start.AddDays(1));
    if (isTomorrow && start.AddDays(-1) < QuarterNow()) other = null;
    <div class="card now-tile @lvl">
        <div class="now-device">🍽️ Opvaskemaskinen · 2 timer · start @(picked is null ? "nu" : When(start))</div>
        <div class="now-price @lvl">@(run is null ? "–" : Kr(run.CostKr)) KR</div>
        <div class="now-verdict @lvl">@(run is null ? "Priserne dækker ikke hele opvasken endnu" : Verdict(rank))</div>
        <div class="now-tomorrow">
            @if (other is not null && run is not null)
            {
                <span>@(isTomorrow ? "I dag" : "I morgen") kl. @start.ToString("HH:mm")</span>
                <b class="@(other.CostKr < run.CostKr ? "lvl-cheap" : other.CostKr > run.CostKr ? "lvl-expensive" : "")">@Kr(other.CostKr) KR</b>
            }
            else if (!isTomorrow)
            {
                <span class="muted">I morgen: prisen kommer ca. kl. 13</span>
            }
        </div>
        @if (picked is not null)
        {
            <button class="linkish small" @onclick="() => _selected = null">↺ Tilbage til nu</button>
        }
    </div>

    @if (strip.Count > 0)
    {
        <div class="card">
            <div class="bars">
                @foreach (var h in strip)
                {
                    var pct = span > 0 ? 15 + 85 * (h.KrPerKwh - min) / span : 50;
                    var r = span > 0 ? (h.KrPerKwh - min) / span : 0.5;
                    @* The whole column is the tap target: it moves the dishwasher's start to that hour. *@
                    <div class="bar-col @(_selected == h.Start ? "sel" : "")" title="@When(h.Start) · @Kr(h.KrPerKwh) kr/kWh"
                         @onclick="() => _selected = _selected == h.Start || h.IsNow ? null : h.Start">
                        <div class="bar @(h.IsNow ? "now" : "") @(h.Start.Hour == 0 ? "midnight" : "")"
                             style="height:@pct.ToString("0", CultureInfo.InvariantCulture)%;background:@Color(r)"></div>
                    </div>
                }
            </div>
            <div class="bar-axis">
                @foreach (var h in strip)
                {
                    <span>@(h.IsNow ? "nu" : h.Start.Hour == 0 ? "0" : h.Start.Hour % 3 == 0 ? h.Start.Hour.ToString() : "")</span>
                }
            </div>
            <div class="muted small" style="margin-top:6px;text-align:center">Tryk på en søjle – så viser det store tal prisen hvis opvasken starter der.</div>
        </div>
    }
}

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private PriceSnapshot? _snap;
    private string _area = "DK1";
    private DateTime? _selected;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // The "now" price steps every 15 minutes; a phone left open on the counter
        // must never be more than a couple of minutes stale.
        _timer = new Timer(async _ => { await LoadAsync(); await InvokeAsync(StateHasChanged); }, null, TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(2));
    }

    private List<PricePoint> _raw = [];
    private HouseholdSettings _s = new();
    // The free app prices one machine: a dishwasher, 1 kWh over 2 hours, each quarter at its own price.
    private static readonly Appliance Dishwasher = new() { Name = "Opvaskemaskine", Icon = "🍽️", KwhPerRun = 1.0, DurationHours = 2 };

    private RunOption? Dishes(DateTime start) =>
        _raw.Count == 0 ? null : PriceModel.CostOfRun(_raw, _s, Dishwasher, start);

    private DateTime QuarterNow()
    {
        var n = _snap?.At ?? DkTime.Now;
        return new DateTime(n.Year, n.Month, n.Day, n.Hour, n.Minute / 15 * 15, 0);
    }

    private async Task LoadAsync()
    {
        var s = _s = await Prefs.GetAsync();
        _area = s.PriceArea;
        _postal = s.PostalCode;
        _gridName = s.GridName;
        var raw = _raw = await Prices.GetPricesAsync(_area);
        _snap = PriceModel.Build(raw, s, [], DkTime.Now);
    }

    private string _postal = "", _gridName = "";
    private bool _searching;

    private sealed record GeoPoint(double Lat, double Lon);

    // The phone's location -> exact grid company. No lists: one point gives one company.
    private async Task LocateAsync()
    {
        _searching = true;
        StateHasChanged();
        var pos = await JS.InvokeAsync<GeoPoint?>("epUi.locate");
        if (pos is null)
        {
            _searching = false;
            StateHasChanged();
            return;
        }
        var place = await Grids.ReverseAsync(pos.Lat, pos.Lon) ?? new Place("din placering", "", pos.Lat, pos.Lon);
        await UsePlaceAsync(place);
    }



    private async Task UsePlaceAsync(Place place)
    {
        var g = await Grids.FindAtAsync(place.Lat, place.Lon);
        _searching = false;
        if (g is null)
        {
            return;
        }
        var s = Prefs.Get();
        s.PostalCode = place.PostalCode;
        s.GridSupplierId = g.Id;
        s.GridName = g.Name;
        s.PriceArea = g.PriceArea;
        s.NettarifLookup = null;
        await Prefs.SaveAsync(s);
       
        _snap = null;
        await LoadAsync();
    }

    // The current hour onwards, today and tomorrow in one strip.
    private List<HourBar> Strip() =>
        [.. (_snap?.Today?.Hours ?? []).Concat(_snap?.Tomorrow?.Hours ?? []).Where(h => !h.IsPast)];

    // "kl. 13" today, "i nat kl. 03", "i morgen kl. 14".
    private string When(DateTime t)
    {
        var today = DateOnly.FromDateTime(_snap?.At ?? DkTime.Now);
        if (DateOnly.FromDateTime(t) == today) return $"kl. {t:HH}";
        return t.Hour < 7 ? $"i nat kl. {t:HH}" : $"i morgen kl. {t:HH}";
    }

    private static string Color(double rank) => rank <= 0.33 ? "var(--cheap)" : rank >= 0.67 ? "var(--expensive)" : "var(--mid)";

    public void Dispose() => _timer?.Dispose();

    private static string Kr(double? v) => v is { } x ? x.ToString("0.00", Da) : "–";

    private static string Level(double? rank) => rank switch
    {
        null => "lvl-mid",
        <= 0.33 => "lvl-cheap",
        >= 0.67 => "lvl-expensive",
        _ => "lvl-mid",
    };

    private static string Verdict(double? rank) => rank switch
    {
        null => "",
        <= 0.15 => "Blandt dagens billigste",
        <= 0.33 => "Billigt lige nu",
        >= 0.85 => "Dagens dyreste",
        >= 0.67 => "Dyrt lige nu",
        _ => "Middel – hverken billigt eller dyrt",
    };

}
