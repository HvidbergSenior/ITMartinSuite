@page "/"
@using System.Globalization
@inject ElectricityPriceService Prices
@inject PrefsService Prefs
@inject GridTariffs Grids
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>ElPriser</PageTitle>

@* The front page answers one question in five seconds: what does power cost now, and
   should I wait? Planning (start times, night, EV) lives on /planlaeg. *@
<div class="ep-header">
    <div class="ep-logo">⚡</div>
    <div class="ep-title">ElPriser</div>
    <button class="area-chip" title="Hvor bor du?" @onclick="() => _pickArea = !_pickArea">
        @if (_gridName.Length > 0) { <text>@_postal <small>@_gridName</small> ▾</text> }
        else { <text>📍 Postnr. ▾</text> }
    </button>
</div>

@if (_pickArea)
{
    <div class="card area-pick">
        <div class="small" style="margin-bottom:10px">Hvor bor du? Så finder vi dit netselskab og regner med <b>dine</b> tariffer.</div>
        <button class="btn btn-primary btn-block" @onclick="LocateAsync" disabled="@_searching">📍 Brug min placering</button>
        <div class="field" style="margin-top:10px">
            <label for="addr">…eller skriv din adresse eller dit postnummer</label>
            <input id="addr" type="text" autocomplete="street-address" placeholder="fx Skelagervej 230, 8200" @bind="_addrInput" @onkeydown="AddrKeyAsync" />
        </div>
        <button class="btn btn-block" @onclick="ResolveAsync" disabled="@(_searching || _addrInput.Trim().Length == 0)">Find mit netselskab</button>
        @if (_searching) { <div class="muted small" style="margin-top:8px">Finder…</div> }
        @if (_placeMsg is not null) { <div class="small @(_placeOk ? "ok" : "err")" style="margin-top:8px">@_placeMsg</div> }
    </div>
}

<PageHelp Key="help-nu">
    <ul>
        <li><b>Det store tal</b> er prisen for 1 kWh lige nu – alt inkl. moms, elafgift og nettarif. Den skifter hvert kvarter.</li>
        <li><b>Farven:</b> grøn = billigt, gul = middel, rød = dyrt – i forhold til resten af dagen.</li>
        <li><b>➜-linjen</b> svarer på “skal jeg vente?”: er strømmen mindst 10 % billigere inden for 12 timer, står der hvornår.</li>
        <li><b>Søjlerne</b> er prisen time for time fra nu og frem til i morgen. Tryk på en søjle for prisen.</li>
        <li><b>📍 øverst:</b> brug din placering eller skriv din adresse, så finder vi dit netselskab og regner med dets rigtige tariffer. Det huskes på telefonen.</li>
    </ul>
</PageHelp>

@if (_snap is null)
{
    <div class="card now-tile"><div class="muted">Henter priser…</div></div>
}
else if (!_snap.HasData)
{
    <div class="card now-tile">
        <div class="now-verdict lvl-mid">Ingen priser lige nu</div>
        <div class="now-compare">Energinet svarer ikke. Prøv igen om lidt.</div>
    </div>
}
else
{
    // "Cheap" next to "wait – 34 % cheaper later" reads as a contradiction: when waiting pays,
    // the tile is never shown as cheap.
    var adv = Advice();
    var lvl = adv?.Wait == true && _snap.NowRank01 <= 0.33 ? "lvl-mid" : Level(_snap.NowRank01);
    <div class="card now-tile @lvl">
        <div class="now-price @lvl">@Kr(_snap.NowKrPerKwh)</div>
        <div class="now-unit">kr/kWh lige nu · kl. @_snap.At.ToString("HH:mm")@(_snap.AllIn ? " · alt inkl." : " · spotpris")</div>
        <div class="now-verdict @lvl">@Verdict(_snap.NowRank01, adv?.Wait == true)</div>
        @if (adv is not null)
        {
            <div class="now-advice @(adv.Wait ? "" : "lvl-cheap")">➜ @adv.Text</div>
        }
    </div>

    var strip = Strip();
    @if (strip.Count > 0)
    {
        var min = strip.Min(h => h.KrPerKwh);
        var max = strip.Max(h => h.KrPerKwh);
        var span = max - min;
        var lo = strip.MinBy(h => h.KrPerKwh)!;
        var hi = strip.MaxBy(h => h.KrPerKwh)!;
        <div class="card">
            <div class="bars">
                @foreach (var h in strip)
                {
                    var pct = span > 0 ? 15 + 85 * (h.KrPerKwh - min) / span : 50;
                    var rank = span > 0 ? (h.KrPerKwh - min) / span : 0.5;
                    @* The whole column is the tap target; the price sits right above the tapped bar. *@
                    <div class="bar-col @(_selected == h.Start ? "sel" : "")" title="@When(h.Start) · @Kr(h.KrPerKwh) kr/kWh"
                         @onclick="() => _selected = _selected == h.Start ? null : h.Start">
                        @if (_selected == h.Start) { <span class="bar-tip">@Kr(h.KrPerKwh)</span> }
                        <div class="bar @(h.IsNow ? "now" : "") @(h.Start.Hour == 0 ? "midnight" : "")"
                             style="height:@pct.ToString("0", CultureInfo.InvariantCulture)%;background:@Color(rank)"></div>
                    </div>
                }
            </div>
            <div class="bar-axis">
                @foreach (var h in strip)
                {
                    <span>@(h.IsNow ? "nu" : h.Start.Hour == 0 ? "0" : h.Start.Hour % 3 == 0 ? h.Start.Hour.ToString() : "")</span>
                }
            </div>
            <div class="bar-info">
                @if (_selected is { } sel && strip.FirstOrDefault(h => h.Start == sel) is { } hb)
                {
                    <span>@When(hb.Start)–@hb.Start.AddHours(1).ToString("HH:00")</span>
                    <b class="@Level(span > 0 ? (hb.KrPerKwh - min) / span : 0.5)">@Kr(hb.KrPerKwh) kr/kWh</b>
                }
                else
                {
                    <span>🟢 Billigst @When(lo.Start) · <b>@Kr(lo.KrPerKwh)</b></span>
                    <span>🔴 Dyrest @When(hi.Start) · <b>@Kr(hi.KrPerKwh)</b></span>
                }
            </div>
            @if (_snap.Tomorrow is null)
            {
                <div class="muted small" style="margin-top:6px">Morgendagens priser kommer ca. kl. 13.@(ForecastText() is { } f ? " " + f : "")</div>
            }
        </div>
    }

    <a class="plan-link" href="/planlaeg">📅 Hvornår skal vaskemaskinen, opvasken eller elbilen starte? →</a>
}

@code {
    private static readonly CultureInfo Da = new("da-DK");
    private PriceSnapshot? _snap;
    private string _area = "DK1";
    private DateTime? _selected;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // The "now" price steps every 15 minutes; a phone left open on the counter
        // must never be more than a couple of minutes stale.
        _timer = new Timer(async _ => { await LoadAsync(); await InvokeAsync(StateHasChanged); }, null, TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(2));
    }

    private async Task LoadAsync()
    {
        var s = await Prefs.GetAsync();
        _area = s.PriceArea;
        _postal = s.PostalCode;
        _gridName = s.GridName;
        var raw = await Prices.GetPricesAsync(_area);
        _forecast = await Grids.TomorrowForecastAsync(_area);
        _snap = PriceModel.Build(raw, s, [], DkTime.Now);
    }

    private bool _pickArea;
    private string _postal = "", _gridName = "", _addrInput = "";
    private bool _searching, _placeOk;
    private string? _placeMsg;
    private List<(DateTime Hour, double Price)> _forecast = [];

    private sealed record GeoPoint(double Lat, double Lon);

    // The phone's location -> exact grid company. No lists: one point gives one company.
    private async Task LocateAsync()
    {
        _searching = true; _placeMsg = null;
        var pos = await JS.InvokeAsync<GeoPoint?>("epUi.locate");
        if (pos is null)
        {
            _searching = false; _placeOk = false;
            _placeMsg = "Placeringen kunne ikke hentes. Skriv din adresse i stedet.";
            return;
        }
        var place = await Grids.ReverseAsync(pos.Lat, pos.Lon) ?? new Place("din placering", "", pos.Lat, pos.Lon);
        await UsePlaceAsync(place);
    }

    private async Task AddrKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ResolveAsync();
    }

    private async Task ResolveAsync()
    {
        _searching = true; _placeMsg = null;
        var place = await Grids.ResolveAsync(_addrInput);
        if (place is null)
        {
            _searching = false; _placeOk = false;
            _placeMsg = "Adressen blev ikke fundet. Prøv med vej, husnummer og postnummer.";
            return;
        }
        await UsePlaceAsync(place);
    }

    private async Task UsePlaceAsync(Place place)
    {
        var g = await Grids.FindAtAsync(place.Lat, place.Lon);
        _searching = false;
        if (g is null)
        {
            _placeOk = false;
            _placeMsg = $"Vi kunne ikke finde netselskabet for {place.Label}.";
            return;
        }
        var s = Prefs.Get();
        s.PostalCode = place.PostalCode;
        s.GridSupplierId = g.Id;
        s.GridName = g.Name;
        s.PriceArea = g.PriceArea;
        s.NettarifLookup = null;
        await Prefs.SaveAsync(s);
        _placeOk = true;
        _placeMsg = $"✓ {place.Label} · netselskab {g.Name} · {g.PriceArea}";
        _snap = null;
        await LoadAsync();
    }

    // Before ~13:00 tomorrow is unknown; Strømligning's forecast gives its shape.
    // Only the cheapest hours are named - never a forecast price as if it were real.
    private string? ForecastText()
    {
        if (_forecast.Count < 12) return null;
        var night = _forecast.Where(h => h.Hour.Hour is >= 0 and < 7).MinBy(h => h.Price);
        var day = _forecast.Where(h => h.Hour.Hour is >= 7 and < 23).MinBy(h => h.Price);
        if (night == default || day == default) return null;
        return $"Prognose: billigst i nat omkring kl. {night.Hour:HH} og i morgen omkring kl. {day.Hour:HH}.";
    }


    // The current hour onwards, today and tomorrow in one strip.
    private List<HourBar> Strip() =>
        [.. (_snap?.Today?.Hours ?? []).Concat(_snap?.Tomorrow?.Hours ?? []).Where(h => !h.IsPast)];

    private sealed record Answer(string Text, bool Wait);

    // One line: wait until the cheapest hour in the next 12 hours, or run now. "Now" is
    // compared with hourly averages; within 10 % of the best counts as "now is fine".
    private Answer? Advice()
    {
        if (_snap?.NowKrPerKwh is not { } now) return null;
        var ahead = Strip().Where(h => !h.IsNow && h.Start < _snap.At.AddHours(12)).ToList();
        if (ahead.Count == 0) return null;
        var best = ahead.MinBy(h => h.KrPerKwh)!;
        if (best.KrPerKwh >= now * 0.9)
            return new Answer("Kør nu – det bliver ikke billigere de næste 12 timer", false);
        var pct = (int)Math.Round(100 * (now - best.KrPerKwh) / now);
        return new Answer($"Vent til {When(best.Start)} – {pct} % billigere", true);
    }

    // "kl. 13" today, "i nat kl. 03", "i morgen kl. 14".
    private string When(DateTime t)
    {
        var today = DateOnly.FromDateTime(_snap?.At ?? DkTime.Now);
        var d = DateOnly.FromDateTime(t);
        if (d == today) return $"kl. {t:HH}";
        if (t.Hour < 7) return $"i nat kl. {t:HH}";
        return $"i morgen kl. {t:HH}";
    }

    public void Dispose() => _timer?.Dispose();

    private static string Kr(double? v) => v is { } x ? x.ToString("0.00", Da) : "–";

    private static string Level(double? rank) => rank switch
    {
        null => "lvl-mid",
        <= 0.33 => "lvl-cheap",
        >= 0.67 => "lvl-expensive",
        _ => "lvl-mid",
    };

    private static string Verdict(double? rank, bool wait) => rank switch
    {
        null => "",
        < 0.67 when wait => "Middel – det bliver billigere",
        <= 0.15 => "Blandt dagens billigste",
        <= 0.33 => "Billigt lige nu",
        >= 0.85 => "Dagens dyreste",
        >= 0.67 => "Dyrt lige nu",
        _ => "Middel – hverken billigt eller dyrt",
    };

    private static string Color(double rank) => rank <= 0.33 ? "var(--cheap)" : rank >= 0.67 ? "var(--expensive)" : "var(--mid)";
}
