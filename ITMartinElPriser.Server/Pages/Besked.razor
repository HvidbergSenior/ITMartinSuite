@page "/besked"
@inject IJSRuntime JS
@inject FrontPageUseCases Front
@inject PushUseCases Push

<PageTitle>Besked – ElPriser</PageTitle>

<h1>Besked på telefonen</h1>
<PageHelp Key="help-besked">
    <p>Telefonen får en besked <b>en time før</b> dagens billigste to timer – så du kan nå at fylde vaskemaskinen. Du kan også få en advarsel før de dyreste timer.</p>
    <p>Beskeder er gratis for kunder: skriv dig op én gang på itmartin.dk (Mine apps → ElPriser → Prøv gratis), så får du et kundenummer på mail. Skriv det her, og tryk Slå beskeder til.</p>
    <p>Vi gemmer kun telefonens besked-adresse, dit prisområde og dit kundenummer. Stop når som helst nederst på siden.</p>
</PageHelp>

<div class="k-card">
    <h2 class="k-card-title">Besked på telefonen</h2>
    @switch (_state)
    {
        case "unsupported":
            <div class="err">Denne browser kan ikke modtage beskeder. Prøv Chrome på Android eller Safari på iPhone.</div>
            break;

        case "ios-needs-homescreen":
            <div class="note">
                <b>På iPhone skal appen først på hjemmeskærmen:</b><br />
                Tryk på <b>(⋯)</b> nederst til højre i Safari → <b>Del</b> ⬆︎ → <b>Føj til hjemmeskærm</b> → åbn ElPriser derfra og kom tilbage hertil. Se også <a href="/">Læg ElPriser på telefonen</a> på forsiden.
            </div>
            break;

        case "denied":
            <div class="err">Beskeder er blokeret for denne side i telefonens indstillinger. Slå dem til der, og genindlæs.</div>
            break;

        default:
            <div class="field">
                <label>Navn (valgfrit – kun så du selv kan kende telefonen)</label>
                <input type="text" @bind="_name" placeholder="fx Martins telefon" disabled="@(_state == "on")" />
            </div>
            <div class="switch">
                <span>En time før dagens <b>billigste</b> strøm</span>
                <input type="checkbox" @bind="_cheapest" />
            </div>
            <div class="switch">
                <span>En time før dagens <b>dyreste</b> strøm</span>
                <input type="checkbox" @bind="_expensive" />
            </div>

            @if (_state == "on")
            {
                <div class="ok">✓ Denne telefon får beskeder@(string.IsNullOrWhiteSpace(_name) ? "" : $" ({_name})")</div>
                <div class="btn-row">
                    <button class="k-btn" @onclick="SaveAsync" disabled="@_busy">Gem valg</button>
                    <button class="k-btn" @onclick="TestAsync" disabled="@_busy">Send test</button>
                </div>
                <button class="k-btn k-btn-danger k-btn-block" @onclick="UnsubscribeAsync" disabled="@_busy">Stop beskeder på denne telefon</button>
                @* A phone from before the kundenummer rule keeps its beskeder, and is asked to sign up (user 2026-10-22). *@
                @if (!_hasCode)
                {
                    <div class="note k-mt">
                        <b>Skriv dig op gratis</b> – så får du et kundenummer til alle de gratis apps. Dine beskeder fortsætter uanset hvad.
                        <div class="field">
                            <label>Dit kundenummer (8 cifre – står i mailen, du fik, da du skrev dig op)</label>
                            <input type="text" inputmode="numeric" autocomplete="off" @bind="_code" placeholder="fx 4821 7730" />
                        </div>
                        <button class="k-btn k-btn-primary k-btn-block" @onclick="AddCodeAsync" disabled="@_busy">Gem kundenummer</button>
                        <a class="k-btn k-btn-block k-mt" href="https://itmartin.dk/mine-apps?app=ElPriser" target="_blank" rel="noopener">Har du ikke et? Skriv dig op gratis på itmartin.dk</a>
                    </div>
                }
            }
            else
            {
                <div class="field">
                    <label>Dit kundenummer (8 cifre – står i mailen, du fik, da du skrev dig op)</label>
                    <input type="text" inputmode="numeric" autocomplete="off" @bind="_code" placeholder="fx 4821 7730" />
                </div>
                @* While the phone is being checked the form is already there, greyed out - no "Tjekker…" page that jumps away. *@
                <button class="k-btn k-btn-primary k-btn-block" @onclick="SubscribeAsync" disabled="@(_busy || _state is null)">@(_busy ? "Vent…" : _state is null ? "Tjekker telefonen …" : "Slå beskeder til")</button>
                <p class="small k-muted">Har du ikke et kundenummer? Det er gratis:</p>
                <a class="k-btn k-btn-block" href="https://itmartin.dk/mine-apps?app=ElPriser" target="_blank" rel="noopener">Skriv dig op gratis på itmartin.dk</a>
            }
            @if (_msg is not null) { <div class="note">@_msg</div> }
            break;
    }
</div>

<div class="k-card">
    <div class="k-card-title">Sådan virker det</div>
    <div>
        Hver dag ca. kl. 13 kommer morgendagens priser. Appen finder de billigste to timer i træk for <b>@Front.Describe()</b> (skift dit hjem på forsiden, og tryk "Gem valg" igen her) og sender en besked én time før. Vi gemmer kun det der skal til for at sende beskeden: telefonens besked-adresse, dit prisområde og dit kundenummer – ingen e-mail.
    </div>
</div>

@code {
    private string? _state;
    private string _name = "";
    private string _code = "";
    private bool _cheapest = true;
    private bool _expensive;
    private bool _busy;
    private string? _msg;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        try { _code = await JS.InvokeAsync<string?>("localStorage.getItem", "elpriser-kundenummer") ?? ""; } catch { }
        try
        {
            _state = await JS.InvokeAsync<string>("elpush.state");
            if (_state == "on")
            {
                var me = await JS.InvokeAsync<Status?>("elpush.status");
                if (me is not null) { _name = me.Name; _cheapest = me.NotifyCheapest; _expensive = me.NotifyExpensive; _hasCode = me.HasCode; }
                else _state = "off"; // browser has a subscription the server forgot - re-subscribe
            }
        }
        catch { _state = "unsupported"; }
        StateHasChanged();
    }

    private sealed record Status(string Name, bool NotifyCheapest, bool NotifyExpensive, bool HasCode);

    private bool _hasCode = true;

    private async Task AddCodeAsync()
    {
        _busy = true; _msg = null;
        try
        {
            var (ok, error) = await Push.CheckCodeAsync(_code);
            if (!ok) { _msg = error; return; }
            try { await JS.InvokeVoidAsync("localStorage.setItem", "elpriser-kundenummer", _code); } catch { }
            var state = await JS.InvokeAsync<string>("elpush.subscribe", _name, _cheapest, _expensive, _code);
            if (state == "on") { _hasCode = true; _msg = "Tak – dit kundenummer er gemt."; }
            else _msg = "Dit kundenummer kunne ikke gemmes lige nu – prøv igen om lidt.";
        }
        finally { _busy = false; }
    }

    private async Task SubscribeAsync()
    {
        _busy = true; _msg = null;
        try
        {
            // The kundenummer first, so the person hears what is wrong before the phone asks for permission.
            var (ok, error) = await Push.CheckCodeAsync(_code);
            if (!ok) { _msg = error; return; }
            try { await JS.InvokeVoidAsync("localStorage.setItem", "elpriser-kundenummer", _code); } catch { }
            var state = await JS.InvokeAsync<string>("elpush.subscribe", _name, _cheapest, _expensive, _code);
            if (state == "code") { _msg = "Dit kundenummer kunne ikke tjekkes lige nu – prøv igen om lidt."; return; }
            _state = state;
            _msg = _state == "on" ? "Tilmeldt. Tryk 'Send test' for at se at det virker." : _state == "denied" ? "Du sagde nej til beskeder – slå dem til i telefonens indstillinger." : "Noget gik galt – prøv igen.";
        }
        finally { _busy = false; }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await JS.InvokeAsync<string>("elpush.subscribe", _name, _cheapest, _expensive, _code);
            _msg = "Gemt.";
        }
        finally { _busy = false; }
    }

    private async Task TestAsync()
    {
        _busy = true; _msg = null;
        try
        {
            var ok = await JS.InvokeAsync<bool>("elpush.test");
            _msg = ok ? "Test sendt – den dukker op om et øjeblik." : "Kunne ikke sende. Prøv at slå beskeder fra og til igen.";
        }
        finally { _busy = false; }
    }

    private async Task UnsubscribeAsync()
    {
        _busy = true;
        try
        {
            _state = await JS.InvokeAsync<string>("elpush.unsubscribe");
            _msg = "Beskeder stoppet på denne telefon.";
        }
        finally { _busy = false; }
    }
}
