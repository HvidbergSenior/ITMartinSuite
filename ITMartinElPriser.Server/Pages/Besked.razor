@page "/besked"
@inject IJSRuntime JS
@inject PrefsService Prefs

<PageTitle>Besked – ElPriser</PageTitle>

<h1>Besked på telefonen</h1>
<p class="muted small" style="margin:4px 0 14px">Få en besked en time før dagens billigste to timer – så du kan nå at fylde vaskemaskinen.</p>

<div class="card">
    @switch (_state)
    {
        case null:
            <div class="muted">Tjekker…</div>
            break;

        case "unsupported":
            <div class="err">Denne browser kan ikke modtage beskeder. Prøv Chrome på Android eller Safari på iPhone.</div>
            break;

        case "ios-needs-homescreen":
            <div class="note">
                <b>På iPhone skal appen først på hjemmeskærmen:</b><br />
                Tryk på <b>Del</b> (firkanten med pilen) nederst i Safari → <b>Føj til hjemmeskærm</b> → åbn ElPriser derfra og kom tilbage hertil.
            </div>
            break;

        case "denied":
            <div class="err">Beskeder er blokeret for denne side i telefonens indstillinger. Slå dem til der, og genindlæs.</div>
            break;

        default:
            <div class="field">
                <label>Navn (valgfrit – kun så du selv kan kende telefonen)</label>
                <input type="text" @bind="_name" placeholder="fx Martins telefon" disabled="@(_state == "on")" />
            </div>
            <div class="switch">
                <span>🟢 En time før dagens <b>billigste</b> strøm</span>
                <input type="checkbox" @bind="_cheapest" />
            </div>
            <div class="switch">
                <span>🔴 En time før dagens <b>dyreste</b> strøm</span>
                <input type="checkbox" @bind="_expensive" />
            </div>

            @if (_state == "on")
            {
                <div class="ok" style="margin-top:10px">✓ Denne telefon får beskeder@(string.IsNullOrWhiteSpace(_name) ? "" : $" ({_name})")</div>
                <div class="btn-row">
                    <button class="btn" @onclick="SaveAsync" disabled="@_busy">Gem valg</button>
                    <button class="btn" @onclick="TestAsync" disabled="@_busy">Send test</button>
                </div>
                <button class="btn btn-danger btn-block" @onclick="UnsubscribeAsync" disabled="@_busy">Stop beskeder på denne telefon</button>
            }
            else
            {
                <button class="btn btn-primary btn-block" @onclick="SubscribeAsync" disabled="@_busy">@(_busy ? "Vent…" : "Slå beskeder til")</button>
            }
            @if (_msg is not null) { <div class="note">@_msg</div> }
            break;
    }
</div>

<div class="card">
    <div class="card-title">Sådan virker det</div>
    <div class="small muted">
        Hver dag ca. kl. 13 kommer morgendagens priser. Appen finder de billigste to timer i træk for <b>@PrefsService.Describe(Prefs.Get())</b> (vælg område på forsiden og elselskab under Regning, og tryk "Gem valg" igen) og sender en besked én time før. Vi gemmer kun det der skal til for at sende beskeden – ingen konto, ingen e-mail.
    </div>
</div>

@code {
    private string? _state;
    private string _name = "";
    private bool _cheapest = true;
    private bool _expensive;
    private bool _busy;
    private string? _msg;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        try
        {
            _state = await JS.InvokeAsync<string>("elpush.state");
            if (_state == "on")
            {
                var me = await JS.InvokeAsync<Status?>("elpush.status");
                if (me is not null) { _name = me.Name; _cheapest = me.NotifyCheapest; _expensive = me.NotifyExpensive; }
                else _state = "off"; // browser has a subscription the server forgot - re-subscribe
            }
        }
        catch { _state = "unsupported"; }
        StateHasChanged();
    }

    private sealed record Status(string Name, bool NotifyCheapest, bool NotifyExpensive);

    private async Task SubscribeAsync()
    {
        _busy = true; _msg = null;
        try
        {
            _state = await JS.InvokeAsync<string>("elpush.subscribe", _name, _cheapest, _expensive);
            _msg = _state == "on" ? "Tilmeldt. Tryk 'Send test' for at se at det virker." : _state == "denied" ? "Du sagde nej til beskeder – slå dem til i telefonens indstillinger." : "Noget gik galt – prøv igen.";
        }
        finally { _busy = false; }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await JS.InvokeAsync<string>("elpush.subscribe", _name, _cheapest, _expensive);
            _msg = "Gemt.";
        }
        finally { _busy = false; }
    }

    private async Task TestAsync()
    {
        _busy = true; _msg = null;
        try
        {
            var ok = await JS.InvokeAsync<bool>("elpush.test");
            _msg = ok ? "Test sendt – den dukker op om et øjeblik." : "Kunne ikke sende. Prøv at slå beskeder fra og til igen.";
        }
        finally { _busy = false; }
    }

    private async Task UnsubscribeAsync()
    {
        _busy = true;
        try
        {
            _state = await JS.InvokeAsync<string>("elpush.unsubscribe");
            _msg = "Beskeder stoppet på denne telefon.";
        }
        finally { _busy = false; }
    }
}
