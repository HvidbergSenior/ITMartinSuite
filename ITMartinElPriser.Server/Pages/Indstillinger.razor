@page "/indstillinger"
@inject HouseholdStore Store

<PageTitle>Indstillinger – ElPriser</PageTitle>

<h1>Indstillinger</h1>
<p class="muted small" style="margin:4px 0 14px">Fælles for alle der bruger appen.</p>

<div class="card">
    <div class="card-title">Maskiner</div>
    <div class="muted small" style="margin-bottom:8px">Den øverste maskine bestemmer hvad beskederne regner på. kWh pr. tur står typisk i manualen eller på energimærket.</div>
    @foreach (var a in _appliances)
    {
        <div class="row2">
            <div class="field" style="flex:2"><label>Navn</label><input type="text" @bind="a.Name" /></div>
            <div class="field"><label>Timer</label><input type="number" step="0.5" min="0.25" max="12" @bind="a.DurationHours" /></div>
            <div class="field"><label>kWh</label><input type="number" step="0.1" min="0.1" max="20" @bind="a.KwhPerRun" /></div>
            <div class="field" style="flex:0"><label>&nbsp;</label><button class="btn" title="Fjern" @onclick="() => _appliances.Remove(a)">✕</button></div>
        </div>
    }
    <div class="btn-row">
        <button class="btn" @onclick="AddAppliance">+ Tilføj maskine</button>
    </div>
</div>

<div class="card">
    <div class="card-title">Pris</div>
    <div class="field">
        <label>Prisområde</label>
        <select @bind="_s.PriceArea">
            <option value="DK1">DK1 – Jylland og Fyn</option>
            <option value="DK2">DK2 – Sjælland, Lolland-Falster, Bornholm</option>
        </select>
    </div>
    <div class="switch">
        <span>Vis alt inkl. (moms, elafgift, nettarif, leverandør)</span>
        <input type="checkbox" @bind="_s.ShowAllIn" />
    </div>
    @if (_s.ShowAllIn)
    {
        <div class="field">
            <label>Netselskab</label>
            <select @bind="_s.GridCompanyId">
                @foreach (var g in GridCompanyPreset.All) { <option value="@g.Id">@g.Name @(string.IsNullOrEmpty(g.Region) ? "" : $"– {g.Region}")</option> }
            </select>
        </div>
        @if (_s.GridCompanyId == "custom")
        {
            <div class="field"><label>Nettarif, øre/kWh ekskl. moms</label><input type="number" step="0.1" @bind="_s.CustomNettarifOre" /></div>
        }
        <div class="field">
            <label>Elleverandør</label>
            <select @bind="_s.SupplierId">
                @foreach (var sp in SupplierPreset.All) { <option value="@sp.Id">@sp.Name</option> }
            </select>
        </div>
        @if (_s.SupplierId == "custom")
        {
            <div class="field"><label>Leverandørtillæg, øre/kWh ekskl. moms</label><input type="number" step="0.1" @bind="_s.CustomTillaegOre" /></div>
        }
    }
</div>

<div class="card">
    <div class="card-title">Nattero</div>
    <div class="muted small" style="margin-bottom:8px">Der foreslås ikke starttidspunkter i dette tidsrum – og der sendes ingen beskeder om dem.</div>
    <div class="row2">
        <div class="field"><label>Fra kl.</label><input type="number" min="0" max="23" @bind="_s.QuietFromHour" /></div>
        <div class="field"><label>Til kl.</label><input type="number" min="0" max="23" @bind="_s.QuietToHour" /></div>
    </div>
</div>

<button class="btn btn-primary btn-block" @onclick="Save">Gem</button>
@if (_saved) { <div class="note ok">Gemt ✓</div> }

@code {
    private HouseholdSettings _s = new();
    private List<Appliance> _appliances = [];
    private bool _saved;

    protected override void OnInitialized()
    {
        var d = Store.Get();
        _s = new HouseholdSettings
        {
            PriceArea = d.Settings.PriceArea, ShowAllIn = d.Settings.ShowAllIn,
            GridCompanyId = d.Settings.GridCompanyId, CustomNettarifOre = d.Settings.CustomNettarifOre,
            SupplierId = d.Settings.SupplierId, CustomTillaegOre = d.Settings.CustomTillaegOre,
            QuietFromHour = d.Settings.QuietFromHour, QuietToHour = d.Settings.QuietToHour,
        };
        _appliances = d.Appliances.OrderBy(a => a.SortOrder)
            .Select(a => new Appliance { Id = a.Id, Name = a.Name, Icon = a.Icon, KwhPerRun = a.KwhPerRun, DurationHours = a.DurationHours, SortOrder = a.SortOrder })
            .ToList();
    }

    private void AddAppliance() => _appliances.Add(new Appliance { Name = "", KwhPerRun = 1, DurationHours = 1, SortOrder = _appliances.Count });

    private void Save()
    {
        _s.QuietFromHour = Math.Clamp(_s.QuietFromHour, 0, 23);
        _s.QuietToHour = Math.Clamp(_s.QuietToHour, 0, 23);
        var list = _appliances.Where(a => !string.IsNullOrWhiteSpace(a.Name) && a.KwhPerRun > 0 && a.DurationHours > 0).ToList();
        for (var i = 0; i < list.Count; i++) list[i].SortOrder = i;
        Store.Update(d => { d.Settings = _s; d.Appliances = list; });
        _saved = true;
    }
}
