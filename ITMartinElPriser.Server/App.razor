<!DOCTYPE html>
<html lang="da" data-family="puls">
<head>
    <script>
        (function () {
            // What the visitor chose with Lys/Mørk, else what the phone is set to (user 2026-10-21 "follow the phone").
            var theme = localStorage.getItem('elpriser_theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ElPriser" />
    <base href="/" />
    <link rel="manifest" href="manifest.json" />
    <link rel="icon" href="icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <link rel="stylesheet" href="_content/ITMartin.Shared.UI/css/kolibri.css?v=@CacheBuster" />
    <script src="_content/ITMartin.Shared.UI/kolibri.js?v=@CacheBuster" defer></script>
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    <link rel="stylesheet" href="ITMartinElPriser.Server.styles.css?v=@CacheBuster" />
    <HeadOutlet @rendermode="InteractiveServer" />   @* the tab title (PageTitle) - it was missing, so the tab showed the address (2026-11-05) *@
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script>
    // The first tap did nothing on a phone (user 2026-11-27): the page shows before Blazor has connected, and a tap in
    // that second was lost. Catch the last tap while connecting, mark it, and replay it on the same element once ready.
    (function () {
        var pending = null;
        function pathOf(el) {
            var parts = [];
            while (el && el !== document.body) {
                var i = 0, s = el; while ((s = s.previousElementSibling)) i++;
                parts.unshift(el.tagName + ':' + i); el = el.parentElement;
            }
            return parts;
        }
        function find(parts) {
            var el = document.body;
            for (var p = 0; p < parts.length && el; p++) {
                var bits = parts[p].split(':'), c = el.children[+bits[1]];
                el = c && c.tagName === bits[0] ? c : null;
            }
            return el;
        }
        function onEarlyClick(e) {
            var t = e.target.closest && e.target.closest('button, .bar-col, [role=button]');
            if (!t || t.id === 'themeToggleBtn') return;
            if (pending && pending.el) pending.el.classList.remove('tap-pending');
            pending = { el: t, path: pathOf(t), text: t.textContent.trim() };
            t.classList.add('tap-pending');
        }
        document.addEventListener('click', onEarlyClick, true);
        window.epBooted = function () {
            document.removeEventListener('click', onEarlyClick, true);
            if (!pending) return;
            var p = pending; pending = null;
            if (p.el) p.el.classList.remove('tap-pending');
            setTimeout(function () {          // let the first interactive render land
                var el = find(p.path);
                if (el && el.textContent.trim() === p.text) el.click();
            }, 250);
        };
    })();
    </script>
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script>Blazor.start().then(function () { window.epBooted && window.epBooted(); });</script>
    <script src="js/push.js?v=@CacheBuster"></script>
    <script src="js/ui.js?v=@CacheBuster"></script>
    <script>
    // The light/dark button is in the Kolibri header, which Blazor renders again - so the click is caught on the
    // document and the label is kept in step whenever the page changes.
    (function () {
        function sync() {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            var btn = document.getElementById('themeToggleBtn');
            var label = current === 'light' ? 'Mørk' : 'Lys';
            if (btn && btn.textContent !== label) btn.textContent = label;   // only when it differs - else the observer loops
            var meta = document.querySelector('meta[name=theme-color]');
            if (meta) meta.setAttribute('content', current === 'light' ? '#f5f5f7' : '#0b1220');
        }
        document.addEventListener('click', function (e) {
            if (!e.target.closest || !e.target.closest('#themeToggleBtn')) return;
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('elpriser_theme', next);
            sync();
        });
        new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
        sync();
    })();
    </script>
    <script>
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
    </script>
    <div id="components-reconnect-modal">
        <span class="reconnect-msg">Forbinder igen...</span>
        <span class="reconnect-failed-msg">Forbindelsen er tabt — <button onclick="location.reload()">Genindlæs</button></span>
    </div>
    <script>
    (function(){
        var vid = localStorage.getItem('_mid');
        if (!vid) { vid = Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2); localStorage.setItem('_mid', vid); }
        function track(path, title, referrer) {
            if (location.search.indexOf('claude_test=1') !== -1) return;
            fetch('https://stats.itmartin.dk/api/hit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: path, title: title, referrer: referrer, visitorId: vid, host: location.hostname }),
                keepalive: true
            }).catch(function(){});
        }
        track(location.pathname + location.search, document.title, document.referrer);
    })();
    </script>
</body>
</html>

@code {
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
