@inherits LayoutComponentBase

@* The shared Kolibri frame like the other apps (user 2026-10-21: "elpriser should be ddd and clean as the others. also
   using the shared components"): KolibriHeader with the three tabs, k-main/k-content, KolibriFooter. *@
<KolibriHeader>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/" Match="NavLinkMatch.All">Nu</NavLink>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/besked">Besked</NavLink>
    @* Light/dark (App.razor's script listens for clicks on it). *@
    <button id="themeToggleBtn" class="k-btn k-btn-ghost k-btn-sm" type="button" title="Skift lys/mørk visning">Lys/mørk</button>
</KolibriHeader>
<div class="k-main"><div class="k-content">
    @Body
</div></div>
<KolibriFooter />
