@page "/library/shelf-scanner"

@using System.Threading.Channels
@using ITMartinLibrary.Application.Interfaces
@using ITMartinLibrary.Application.Models
@using ITMartinLibrary.Application.Workflows
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject IShelfScanOrchestrator ShelfScanOrchestrator
@inject InventoryService InventoryService
@implements IAsyncDisposable

<PageTitle>Shelf Scanner</PageTitle>

<div class="scanner-page">

    <div class="scanner-header">

        <div>
            <h1 class="scanner-title">Shelf Scanner</h1>
            <div class="scanner-subtitle">Point your camera at the shelf to identify all items</div>
        </div>

        <div class="ai-badge">AI Vision</div>

    </div>

    <div class="scanner-wrapper">

        @if (!_cameraStarted)
        {
            <div class="camera-start-panel">
                <button @onclick="StartCamera">
                    Start Camera
                </button>
            </div>
        }
        else
        {
            <video id="video"
                   autoplay
                   muted
                   playsinline
                   webkit-playsinline
                   class="scanner-video">
            </video>

            <div class="scanner-guide">
                <div class="guide-text">Point at the shelf</div>
            </div>
        }

        @if (_isProcessing)
        {
            <div class="scanner-overlay">
                <div class="scanner-loading">
                    <div class="spinner-border text-light"></div>
                    <div class="mt-4 fw-bold">@_statusText</div>
                </div>
            </div>
        }

    </div>

    <div class="scanner-buttons" style="gap:12px;">

        <button class="btn btn-success btn-lg scan-button"
                @onclick="Capture"
                disabled="@_continuousMode">
            @if (_isProcessing)
            {
                <span>Scanning...</span>
            }
            else
            {
                <span>Scan Once</span>
            }
        </button>

        <button class="btn btn-lg @(_continuousMode ? "btn-danger" : "btn-warning") scan-button"
                @onclick="ToggleContinuous">
            @(_continuousMode ? "Stop Auto" : "Auto Scan")
        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(_statusText))
    {
        <div class="alert alert-dark scanner-alert mt-4">
            @_statusText
        </div>
    }

    @if (_sessionItems.Count > 0)
    {
        <div class="content-card mt-4">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h4 style="margin:0;">Added this session (@_sessionItems.Count)</h4>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _sessionItems.Clear()">Clear</button>
            </div>
            <div class="stack">
                @foreach (var item in _sessionItems)
                {
                    <div class="recent-scan-row">
                        <div>
                            <div class="recent-scan-title">@item.Title</div>
                            @if (!string.IsNullOrWhiteSpace(item.Author))
                            {
                                <div class="text-muted" style="font-size:13px;">@item.Author</div>
                            }
                        </div>
                        <div class="text-success" style="font-size:13px; white-space:nowrap;">✓ Added</div>
                    </div>
                }
            </div>
        </div>
    }

    @if (_context != null && !_context.Failed && _context.Result != null)
    {
        <div class="result-panel">

            <h4 class="mb-3">
                Found @_context.Result.Items.Count item(s)
            </h4>

            <div class="shelf-items-grid">

                @foreach (var item in _context.Result.Items)
                {
                    <div class="shelf-item-card">

                        <div class="shelf-item-type-badge">
                            @item.MediaType
                        </div>

                        <div class="shelf-item-title">
                            @(string.IsNullOrWhiteSpace(item.Title) ? "Unknown Title" : item.Title)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Author))
                        {
                            <div class="shelf-item-author">
                                @item.Author
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.Barcode) || !string.IsNullOrWhiteSpace(item.Isbn))
                        {
                            <div class="shelf-item-barcode">
                                @(item.Isbn ?? item.Barcode)
                            </div>
                        }

                        <div class="shelf-item-confidence">
                            @((item.Confidence * 100).ToString("F0"))% confidence
                        </div>

                        @if (!item.AddedToInventory)
                        {
                            <button class="btn btn-sm btn-primary mt-2"
                                    @onclick="() => AddToInventory(item)">
                                Add to Inventory
                            </button>
                        }
                        else if (item.AddedToInventory)
                        {
                            <div class="text-success mt-2">Added</div>
                        }

                    </div>
                }

            </div>

        </div>
    }

    @if (_context?.Failed == true)
    {
        <div class="alert alert-danger mt-4">
            @_context.FailureReason
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_capturedImage))
    {
        <div class="mt-4">
            <h5>Captured Image</h5>
            <img src="@_capturedImage"
                 style="max-width:100%; border-radius:12px; border:2px solid #444;" />
        </div>
    }

</div>

@code {

    private string? _capturedImage;
    private string? _statusText;
    private bool _isProcessing;
    private bool _cameraStarted;
    private bool _disposed;
    private ShelfScanContext? _context;
    private bool _continuousMode;
    private CancellationTokenSource? _continuousCts;

    private sealed record SessionItem(string Title, string? Author);
    private readonly List<SessionItem> _sessionItems = [];
    private readonly HashSet<string> _addedTitles = new(StringComparer.OrdinalIgnoreCase);

    private readonly Channel<(string ImagePath, bool AutoMode)> _workChannel =
        Channel.CreateBounded<(string, bool)>(
            new BoundedChannelOptions(4) { FullMode = BoundedChannelFullMode.DropOldest });

    protected override Task OnInitializedAsync()
    {
        _ = RunWorkerAsync();
        return Task.CompletedTask;
    }

    private async Task RunWorkerAsync()
    {
        await foreach (var (imagePath, autoMode) in _workChannel.Reader.ReadAllAsync())
        {
            if (_disposed) break;
            try
            {
                _isProcessing = true;
                _statusText = "Identifying items...";
                await InvokeAsync(StateHasChanged);

                _context = await ShelfScanOrchestrator.ExecuteAsync(imagePath, CancellationToken.None);

                if (autoMode && _context is { Failed: false, Result: not null })
                {
                    foreach (var item in _context.Result.Items)
                    {
                        var key = item.Title ?? item.Barcode ?? item.Isbn ?? "";
                        if (!string.IsNullOrWhiteSpace(key) && _addedTitles.Add(key))
                            await AddToInventory(item);
                    }
                    _statusText = $"Auto scan: {_sessionItems.Count} items added";
                }
                else
                {
                    _statusText = _context.Failed
                        ? _context.FailureReason
                        : $"Found {_context.Result?.Items.Count ?? 0} item(s)";
                }
            }
            catch (Exception ex)
            {
                _statusText = ex.Message;
            }
            finally
            {
                _isProcessing = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _continuousCts?.Cancel();
        _workChannel.Writer.TryComplete();
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
    }

    private async Task ToggleContinuous()
    {
        if (_continuousMode)
        {
            _continuousMode = false;
            _continuousCts?.Cancel();
            _statusText = "Auto scan stopped.";
            StateHasChanged();
            return;
        }

        if (!_cameraStarted) await StartCamera();

        _continuousMode = true;
        _continuousCts = new CancellationTokenSource();
        _statusText = "Auto scan running...";
        StateHasChanged();

        _ = RunContinuousAsync(_continuousCts.Token);
    }

    private async Task RunContinuousAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested && !_disposed)
        {
            await Capture(autoMode: true);
            try { await Task.Delay(4000, ct); } catch (OperationCanceledException) { break; }
        }
    }

    private async Task StartCamera()
    {
        try
        {
            _cameraStarted = true;
            StateHasChanged();
            await Task.Delay(300);
            await JS.InvokeVoidAsync("webcam.start");
        }
        catch (Exception ex)
        {
            _cameraStarted = false;
            _statusText = ex.Message;
        }
        StateHasChanged();
    }

    private Task Capture() => Capture(autoMode: false);

    private async Task Capture(bool autoMode)
    {
        if (_disposed) return;

        try
        {
            if (!autoMode) { _statusText = "Capturing..."; _context = null; StateHasChanged(); }

            CameraCaptureResult capture;
            try { capture = await JS.InvokeAsync<CameraCaptureResult>("webcam.capture"); }
            catch (TaskCanceledException) { return; }

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(clean);

            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "shelves");
            Directory.CreateDirectory(folder);
            var imagePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(imagePath, bytes);

            _capturedImage = $"data:image/jpeg;base64,{clean}";
            _statusText = "Queued...";
            StateHasChanged();

            await _workChannel.Writer.WriteAsync((imagePath, autoMode));
        }
        catch (Exception ex)
        {
            _statusText = ex.Message;
            StateHasChanged();
        }
    }

    private async Task AddToInventory(ScannedShelfItem item)
    {
        var barcode = item.Barcode ?? item.Isbn;

        if (!string.IsNullOrWhiteSpace(barcode))
        {
            var existing = await InventoryService.GetByBarcodeAsync(barcode);
            if (existing is not null) { item.AddedToInventory = true; return; }
            await InventoryService.ScanOrIncrementAsync(barcode);
        }
        else if (!string.IsNullOrWhiteSpace(item.Title))
        {
            var existing = await InventoryService.GetByTitleAsync(item.Title);
            if (existing is not null) { item.AddedToInventory = true; return; }
            await InventoryService.AddAsync(new InventoryItem
            {
                Barcode = $"SHELF-{Guid.NewGuid():N}",
                Title = item.Title,
                Type = item.MediaType,
                AuthorOrDirector = item.Author ?? "",
                Quantity = 1,
                LookupStatus = "Completed"
            });
        }

        item.AddedToInventory = true;
        _sessionItems.Insert(0, new SessionItem(item.Title ?? "Unknown", item.Author));
        await InvokeAsync(StateHasChanged);
    }

    private sealed class CameraCaptureResult
    {
        public string Image { get; set; } = "";
    }
}
