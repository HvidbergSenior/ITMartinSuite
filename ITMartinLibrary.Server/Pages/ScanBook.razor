@page "/library/scan-book"

@using ITMartinLibrary.Application.Services
@using ITMartinLibrary.Domain.Entities
@using Microsoft.JSInterop
@inject InventoryService InventoryService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="library-page">
    <div class="page-container">

        <div class="scan-hero-card">
            <div class="library-row">
                <div>
                    <h1>📚 Scan Books</h1>
                    <p class="hero-text">Scan barcodes — items are added or stock incremented automatically.</p>
                </div>
                <div style="display:flex; gap:8px; align-items:center;">
                    <button class="btn @(_cameraMode ? "btn-warning" : "btn-outline-secondary")"
                            @onclick="ToggleCameraMode">
                        @(_cameraMode ? "📷 Camera ON" : "📷 Use Camera")
                    </button>
                </div>
                @if (_sessionCount > 0)
                {
                    <div class="content-card stat-card" style="min-width:100px; text-align:center;">
                        <h3>@_sessionCount</h3>
                        <p>Scanned</p>
                    </div>
                }
            </div>
        </div>

        @if (_cameraMode)
        {
            <div class="camera-scan-wrapper mt-3">
                <video id="barcode-video" autoplay muted playsinline webkit-playsinline
                       style="width:100%; border-radius:16px; background:black;"></video>
                <div class="camera-scan-hint">Point camera at barcode — auto detects</div>
                @if (!string.IsNullOrWhiteSpace(_cameraStatus))
                {
                    <div class="alert alert-dark mt-2">@_cameraStatus</div>
                }
            </div>
        }
        else
        {
            <input @ref="barcodeInput"
                   @bind="Barcode"
                   @bind:event="oninput"
                   class="form-control scan-input"
                   placeholder="Ready for book scan..." />
        }

        @if (_error is not null)
        {
            <div class="alert alert-danger mt-3">@_error</div>
        }

        @if (_recentScans.Count > 0)
        {
            <div class="content-card mt-4">
                <h4 class="mb-3">Recently Scanned</h4>
                <div class="stack">
                    @foreach (var entry in _recentScans)
                    {
                        <div class="recent-scan-row">
                            <div>
                                <div class="recent-scan-title">
                                    @(string.IsNullOrWhiteSpace(entry.Item.Title) || entry.Item.Title == "Untitled"
                                        ? entry.Item.Barcode
                                        : entry.Item.Title)
                                </div>
                                @if (!string.IsNullOrWhiteSpace(entry.Item.AuthorOrDirector))
                                {
                                    <div class="text-muted" style="font-size:13px;">@entry.Item.AuthorOrDirector</div>
                                }
                                <div class="text-muted" style="font-size:12px;">@entry.Item.Barcode</div>
                            </div>
                            <div class="recent-scan-right">
                                <div class="item-status-badge @GetStatusClass(entry.Item.LookupStatus)">
                                    @entry.Item.LookupStatus
                                </div>
                                <div class="recent-scan-action">
                                    @(entry.IsNew ? "Added" : $"Qty: {entry.Item.Quantity}")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>

<style>
    .recent-scan-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .recent-scan-row:last-child {
        border-bottom: none;
    }

    .recent-scan-title {
        font-weight: 600;
        font-size: 15px;
    }

    .recent-scan-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        white-space: nowrap;
    }

    .recent-scan-action {
        font-size: 13px;
        color: var(--text-muted);
    }

    .camera-scan-wrapper {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        background: black;
        max-height: 50vh;
    }

    .camera-scan-hint {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,.7);
        color: white;
        padding: 6px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }
</style>

@code {
    private string barcode = "";
    private string? _error;
    private bool isProcessing;
    private int _sessionCount;
    private ElementReference barcodeInput;
    private bool _cameraMode;
    private string? _cameraStatus;
    private DotNetObjectReference<ScanBook>? _dotNetRef;

    private readonly record struct ScanEntry(InventoryItem Item, bool IsNew);
    private List<ScanEntry> _recentScans = new();

    public async ValueTask DisposeAsync()
    {
        if (_cameraMode) await StopCamera();
        _dotNetRef?.Dispose();
    }

    private async Task ToggleCameraMode()
    {
        _cameraMode = !_cameraMode;
        StateHasChanged();
        if (_cameraMode)
        {
            await Task.Delay(200);
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _cameraStatus = "Starting camera...";
            await JS.InvokeVoidAsync("barcodeScanner.start", "barcode-video", _dotNetRef);
            _cameraStatus = "Point at barcode";
        }
        else
        {
            await StopCamera();
        }
    }

    private async Task StopCamera()
    {
        try { await JS.InvokeVoidAsync("barcodeScanner.stop"); } catch { }
        _cameraStatus = null;
    }

    [JSInvokable]
    public async Task OnBarcodeDetected(string code)
    {
        if (isProcessing || string.IsNullOrWhiteSpace(code)) return;
        barcode = code;
        _cameraStatus = $"Detected: {code}";
        await ProcessScan();
    }

    private string Barcode
    {
        get => barcode;
        set
        {
            barcode = value;

            if (!isProcessing &&
                barcode.Length == 13 &&
                (barcode.StartsWith("978") || barcode.StartsWith("979")))
            {
                _ = ProcessScan();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await barcodeInput.FocusAsync();
    }

    private async Task ProcessScan()
    {
        if (isProcessing)
            return;

        isProcessing = true;
        _error = null;

        try
        {
            var scannedCode = barcode;
            var (item, isNew) = await InventoryService.ScanOrIncrementAsync(scannedCode);

            _sessionCount++;
            _recentScans.Insert(0, new ScanEntry(item, isNew));

            if (_recentScans.Count > 10)
                _recentScans.RemoveAt(_recentScans.Count - 1);

            barcode = "";

            await InvokeAsync(StateHasChanged);
            await barcodeInput.FocusAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string GetStatusClass(string? status) => status switch
    {
        "Completed" => "status-completed",
        "Processing" => "status-processing",
        "Pending" => "status-pending",
        "Pending Manual Review" => "status-review",
        _ => "status-pending"
    };
}
