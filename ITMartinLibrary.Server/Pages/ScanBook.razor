@page "/g/{slug}"
@page "/g/{slug}/bookcase"

@using ITMartin.Ai.Interfaces
@using ITMartinLibrary.Application.Interfaces
@using ITMartinLibrary.Domain.Entities
@using ITMartinLibrary.Infrastructure
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject IScannedShelfRepository ShelfRepo
@inject ILibraryShelfRecognitionService ShelfRecognition
@inject LibraryDbContext Db
@implements IAsyncDisposable

<PageTitle>Bogsamling – Scan hylde</PageTitle>

@if (!_loaded)
{
    <div class="library-page"><div class="page-container">Indlæser...</div></div>
}
else if (_group is null)
{
    <div class="library-page"><div class="page-container">Ukendt samling "@Slug". <a href="/">‹ Tilbage</a></div></div>
}
else
{
<div class="library-page">
    <div class="page-container">

        <div class="scan-hero-card">
            <h1>📷 Scan bogreol – @_group.Name</h1>
            <p class="hero-text">Scan én hylde ad gangen. Tryk Færdig når alle hylder er fotograferet.</p>
        </div>

        <div class="shelf-camera-wrap mt-3 @(_magnifierMode ? "magnifier-mode" : "")">
            @if (_cameraError != null)
            {
                <div class="shelf-cam-error">@_cameraError</div>
            }
            else
            {
                <video id="video" autoplay muted playsinline webkit-playsinline></video>
                @if (_state == PageState.Ready && !_magnifierMode)
                {
                    <div class="shelf-guide">
                        <span class="shelf-corner shelf-corner-tl"></span>
                        <span class="shelf-corner shelf-corner-tr"></span>
                        <span class="shelf-corner shelf-corner-bl"></span>
                        <span class="shelf-corner shelf-corner-br"></span>
                        <div class="shelf-guide-tip">Fyld rammen med bogrygge – vandret giver flest bøger</div>
                    </div>
                }
                @if (_magnifierMode)
                {
                    <div class="magnifier-label">🔍 Forstørrelsesglas</div>
                    <button class="magnifier-close-btn" @onclick="ToggleMagnifier">✕</button>
                }
                @if (_state == PageState.Analyzing)
                {
                    <div class="shelf-overlay">
                        <div class="shelf-spinner"></div>
                        <div class="shelf-overlay-text">Analyserer @_pendingImages.Count hylde(r)…</div>
                    </div>
                }
                @if (_state == PageState.Ready || _magnifierMode)
                {
                    <div class="zoom-strip">
                        @foreach (var (z, lbl) in new[] { (0.125, "⅛×"), (0.25, "¼×"), (1.0, "1×"), (1.5, "1.5×"), (2.0, "2×"), (3.0, "3×") })
                        {
                            var zCopy = z;
                            <button class="zoom-btn @(_zoomLevel == zCopy ? "zoom-active" : "")"
                                    @onclick="() => SetZoomAsync(zCopy)">@lbl</button>
                        }
                    </div>
                }
            }
        </div>

        @if (_pendingImages.Count > 0)
        {
            <div class="shelf-pending-row mt-3">
                @for (var i = 0; i < _pendingImages.Count; i++)
                {
                    <span class="shelf-badge">Hylde @(i + 1) ✓</span>
                }
            </div>
        }

        @if (_cameraError == null && !_magnifierMode)
        {
            <div class="magnifier-toggle-row mt-2">
                <button class="btn-magnifier" @onclick="ToggleMagnifier">🔍 Forstørrelsesglas</button>
            </div>
        }

        @if (!_magnifierMode)
        {
            <div class="mt-3 scan-actions">
                <button class="btn btn-primary btn-lg"
                        @onclick="CaptureAsync"
                        disabled="@(_state != PageState.Ready || _cameraError != null)">
                    @if (_pendingImages.Count == 0)
                    {
                        <text>Scan hylde 1</text>
                    }
                    else
                    {
                        <text>Scan hylde @(_pendingImages.Count + 1)</text>
                    }
                </button>

                @if (_pendingImages.Count > 0 && _state == PageState.Ready)
                {
                    <button class="btn btn-success btn-lg" @onclick="FinishAsync">
                        Færdig – analyser @_pendingImages.Count hylde(r)
                    </button>
                }
            </div>
        }

        @if (_error != null)
        {
            <div class="alert alert-danger mt-3">@_error</div>
        }

        @if (_done)
        {
            <div class="alert alert-success mt-3">
                ✓ @_savedCount hylde(r) gemt. Find bøgerne i <a href="@SearchUrl">Søg Bøger ↗</a>
            </div>
        }

    </div>
</div>
}

<style>
    .shelf-camera-wrap {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        background: #111;
        aspect-ratio: 4/3;
        max-height: 55vh;
        transition: max-height .3s ease, aspect-ratio .3s ease;
    }
    .shelf-camera-wrap.magnifier-mode {
        aspect-ratio: unset;
        max-height: 70vh;
        height: 70vh;
        border-radius: 12px;
    }
    .shelf-camera-wrap video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .2s ease;
    }

    /* ── Zoom buttons ── */
    .zoom-strip {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 6px;
        z-index: 15;
    }
    .zoom-btn {
        background: rgba(0,0,0,.55);
        color: #fff;
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 20px;
        padding: 5px 9px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }
    .zoom-btn.zoom-active {
        background: rgba(255,255,255,.25);
        border-color: #fff;
    }

    /* ── Magnifier close button (top-right overlay) ── */
    .magnifier-close-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0,0,0,.6);
        color: #fff;
        border: 1px solid rgba(255,255,255,.4);
        border-radius: 50%;
        width: 36px;
        height: 36px;
        font-size: 16px;
        cursor: pointer;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }

    /* ── Magnifier label ── */
    .magnifier-label {
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,.5);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 4px 14px;
        border-radius: 20px;
        pointer-events: none;
        z-index: 15;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }

    /* ── Magnifier toggle button ── */
    .magnifier-toggle-row {
        display: flex;
        justify-content: center;
    }
    .btn-magnifier {
        background: rgba(255,255,255,.08);
        color: rgba(255,255,255,.7);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 20px;
        padding: 6px 18px;
        font-size: 13px;
        cursor: pointer;
    }
    .btn-magnifier-active {
        background: rgba(255,200,0,.15);
        color: #fcd34d;
        border-color: rgba(252,211,77,.4);
    }
    .shelf-cam-error {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 200px;
        color: rgba(255,255,255,.5);
        font-size: 14px;
        padding: 24px;
        text-align: center;
    }
    .shelf-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,.65);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
    }
    .shelf-overlay-text {
        color: #fff;
        font-size: 16px;
        font-weight: 600;
    }
    .shelf-spinner {
        width: 44px;
        height: 44px;
        border: 3px solid rgba(255,255,255,.2);
        border-top-color: #fff;
        border-radius: 50%;
        animation: shelf-spin .8s linear infinite;
    }
    @@keyframes shelf-spin { to { transform: rotate(360deg); } }

    .shelf-pending-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
    }
    .shelf-badge {
        background: rgba(34,197,94,.15);
        border: 1px solid rgba(34,197,94,.3);
        color: #4ade80;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 13px;
        font-weight: 600;
    }

    .scan-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: center;
        padding-bottom: max(16px, env(safe-area-inset-bottom));
    }

    .alert-success a {
        color: #86efac;
    }

    /* ── Landscape phone: fill the viewport so buttons stay visible ── */
    @@media (orientation: landscape) and (max-height: 500px) {
        .library-page {
            min-height: 0;
            height: 100vh;
            height: 100dvh;
            padding: 0 12px;
            display: flex;
            flex-direction: column;
        }
        .page-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            padding: 5px 0 max(6px, env(safe-area-inset-bottom));
            gap: 5px;
        }
        .scan-hero-card { padding: 4px 10px !important; }
        .scan-hero-card h1 { font-size: 15px !important; margin: 0 !important; }
        .hero-text { display: none !important; }
        .shelf-camera-wrap {
            flex: 1;
            min-height: 0;
            max-height: none !important;
            aspect-ratio: unset !important;
            margin-top: 0 !important;
            border-radius: 10px;
        }
        .shelf-pending-row { margin-top: 0 !important; }
        .scan-actions {
            flex-shrink: 0;
            flex-direction: row !important;
            justify-content: center;
            gap: 10px;
            padding-bottom: max(4px, env(safe-area-inset-bottom)) !important;
            margin-top: 0 !important;
        }
        .mt-3 { margin-top: 0 !important; }
    }

    .shelf-guide {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 10;
    }
    .shelf-corner {
        position: absolute;
        width: 28px;
        height: 28px;
    }
    /* Wide horizontal strip — matches a row of book spines */
    .shelf-corner-tl { top: 25%; left: 4%; border-top: 3px solid rgba(255,255,255,.85); border-left: 3px solid rgba(255,255,255,.85); }
    .shelf-corner-tr { top: 25%; right: 4%; border-top: 3px solid rgba(255,255,255,.85); border-right: 3px solid rgba(255,255,255,.85); }
    .shelf-corner-bl { bottom: 25%; left: 4%; border-bottom: 3px solid rgba(255,255,255,.85); border-left: 3px solid rgba(255,255,255,.85); }
    .shelf-corner-br { bottom: 25%; right: 4%; border-bottom: 3px solid rgba(255,255,255,.85); border-right: 3px solid rgba(255,255,255,.85); }
    .shelf-guide-tip {
        position: absolute;
        bottom: 8%;
        left: 0; right: 0;
        text-align: center;
        color: rgba(255,255,255,.9);
        font-size: 12px;
        font-weight: 600;
        text-shadow: 0 1px 4px rgba(0,0,0,.9);
        letter-spacing: .02em;
    }
</style>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private string SearchUrl => $"https://search-books.itmartin.dk/g/{Slug}";

    private enum PageState { Starting, Ready, Analyzing }

    private bool _loaded;
    private LibraryGroup? _group;
    private PageState _state = PageState.Starting;
    private string? _cameraError;
    private string? _error;
    private readonly List<string> _pendingImages = [];
    private bool _done;
    private int _savedCount;
    private double _zoomLevel = 1.0;
    private bool _magnifierMode;

    protected override async Task OnInitializedAsync()
    {
        _group = await Db.Groups.FirstOrDefaultAsync(g => g.Slug == Slug);
        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _group is null) return;

        try
        {
            await JS.InvokeVoidAsync("webcam.start");
            _state = PageState.Ready;
        }
        catch (Exception ex)
        {
            _cameraError = $"Kamera ikke tilgængeligt: {ex.Message}";
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
    }

    private async Task CaptureAsync()
    {
        if (_state != PageState.Ready) return;

        _error = null;
        StateHasChanged();

        try
        {
            var capture = await JS.InvokeAsync<CaptureResult>("webcam.capture");
            var base64 = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(base64);

            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "shelves");
            Directory.CreateDirectory(folder);
            var imgPath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(imgPath, bytes);

            _pendingImages.Add(imgPath);
            await JS.InvokeVoidAsync("webcam.flash");
            await JS.InvokeVoidAsync("webcam.speak", $"Hylde {_pendingImages.Count} fotograferet");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task FinishAsync()
    {
        if (_pendingImages.Count == 0 || _state != PageState.Ready) return;

        _state = PageState.Analyzing;
        _error = null;
        _done = false;
        StateHasChanged();

        try
        {
            var existing = await ShelfRepo.GetAllWithBooksAsync(_group!.Id, default);
            var nextNumber = existing.Count == 0 ? 1 : existing.Max(x => x.ShelfNumber) + 1;

            var shelves = new List<ScannedShelf>();
            foreach (var imgPath in _pendingImages)
            {
                var result = await ShelfRecognition.AnalyzeAsync(imgPath, CancellationToken.None);
                shelves.Add(new ScannedShelf
                {
                    GroupId = _group.Id,
                    ShelfNumber = nextNumber++,
                    ImagePath = imgPath,
                    ScannedAt = DateTime.UtcNow,
                    Books = (result?.Items ?? [])
                        .Where(i => !string.IsNullOrWhiteSpace(i.Title))
                        .Select(i => new ShelfBook
                        {
                            GroupId = _group.Id,
                            Title = i.Title ?? "",
                            Author = i.Author ?? "",
                            BBoxX = i.BBoxX ?? 0,
                            BBoxY = i.BBoxY ?? 0,
                            BBoxW = i.BBoxW ?? 0,
                            BBoxH = i.BBoxH ?? 0,
                            MediaType = i.MediaType ?? "Book",
                        })
                        .ToList()
                });
            }

            await ShelfRepo.AddShelvesAsync(shelves, CancellationToken.None);
            _savedCount = shelves.Count;
            _pendingImages.Clear();
            _done = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _state = PageState.Ready;
            StateHasChanged();
        }
    }

    private async Task SetZoomAsync(double level)
    {
        _zoomLevel = level;
        await JS.InvokeVoidAsync("webcam.setZoom", level);
        StateHasChanged();
    }

    private void ToggleMagnifier()
    {
        _magnifierMode = !_magnifierMode;
        StateHasChanged();
    }

    private sealed class CaptureResult { public string Image { get; set; } = ""; }
}
