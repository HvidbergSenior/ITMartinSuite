@page "/"
@page "/library"
@page "/library/bookcase"

@using ITMartin.Ai.Interfaces
@using ITMartinLibrary.Application.Interfaces
@using ITMartinLibrary.Domain.Entities
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject IScannedShelfRepository ShelfRepo
@inject ILibraryShelfRecognitionService ShelfRecognition
@implements IAsyncDisposable

<PageTitle>Bogsamling – Scan hylde</PageTitle>

<div class="library-page">
    <div class="page-container">

        <div class="scan-hero-card">
            <h1>📷 Scan bogreol</h1>
            <p class="hero-text">Peg kameraet mod en hylde og tryk Scan.</p>
        </div>

        <div class="shelf-camera-wrap mt-3">
            @if (_cameraError != null)
            {
                <div class="shelf-cam-error">@_cameraError</div>
            }
            else
            {
                <video id="video" autoplay muted playsinline webkit-playsinline></video>
                @if (_state == PageState.Analyzing)
                {
                    <div class="shelf-overlay">
                        <div class="shelf-spinner"></div>
                        <div class="shelf-overlay-text">Analyserer hylde…</div>
                    </div>
                }
            }
        </div>

        <div class="mt-3" style="display:flex;justify-content:center">
            <button class="btn btn-primary btn-lg"
                    @onclick="CaptureAsync"
                    disabled="@(_state != PageState.Ready || _cameraError != null)">
                @(_state == PageState.Analyzing ? "Analyserer…" : "Scan hylde")
            </button>
        </div>

        @if (_error != null)
        {
            <div class="alert alert-danger mt-3">@_error</div>
        }

        @if (_recentShelves.Any())
        {
            <div class="content-card mt-4">
                <h4 class="mb-3">Seneste scanninger</h4>
                @foreach (var shelf in _recentShelves)
                {
                    <div class="shelf-result">
                        <div class="shelf-result-header">
                            <span class="shelf-result-label">Hylde @shelf.ShelfNumber</span>
                            <span class="text-muted" style="font-size:12px">@shelf.ScannedAt.ToLocalTime().ToString("dd MMM HH:mm")</span>
                        </div>
                        @if (shelf.Books.Any())
                        {
                            <ul class="shelf-book-list">
                                @foreach (var book in shelf.Books.Take(12))
                                {
                                    <li>
                                        <span class="shelf-book-title">@book.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(book.Author))
                                        {
                                            <span class="text-muted"> — @book.Author</span>
                                        }
                                    </li>
                                }
                                @if (shelf.Books.Count > 12)
                                {
                                    <li class="text-muted">…og @(shelf.Books.Count - 12) til</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted" style="font-size:13px;padding:6px 0">Ingen genstande identificeret</div>
                        }
                    </div>
                }
            </div>
        }

    </div>
</div>

<style>
    .shelf-camera-wrap {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        background: #111;
        aspect-ratio: 4/3;
        max-height: 55vh;
    }
    .shelf-camera-wrap video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .shelf-cam-error {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 200px;
        color: rgba(255,255,255,.5);
        font-size: 14px;
        padding: 24px;
        text-align: center;
    }
    .shelf-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,.65);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
    }
    .shelf-overlay-text {
        color: #fff;
        font-size: 16px;
        font-weight: 600;
    }
    .shelf-spinner {
        width: 44px;
        height: 44px;
        border: 3px solid rgba(255,255,255,.2);
        border-top-color: #fff;
        border-radius: 50%;
        animation: shelf-spin .8s linear infinite;
    }
    @@keyframes shelf-spin { to { transform: rotate(360deg); } }
    .shelf-result {
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 10px;
    }
    .shelf-result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }
    .shelf-result-label {
        font-weight: 700;
        font-size: 14px;
    }
    .shelf-book-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    .shelf-book-list li {
        font-size: 13px;
    }
    .shelf-book-title {
        font-weight: 500;
    }
</style>

@code {
    private enum PageState { Starting, Ready, Analyzing }

    private PageState _state = PageState.Starting;
    private string? _cameraError;
    private string? _error;
    private List<ScannedShelf> _recentShelves = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await LoadRecentAsync();

        try
        {
            await JS.InvokeVoidAsync("webcam.start");
            _state = PageState.Ready;
        }
        catch (Exception ex)
        {
            _cameraError = $"Kamera ikke tilgængeligt: {ex.Message}";
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
    }

    private async Task LoadRecentAsync()
    {
        var all = await ShelfRepo.GetAllWithBooksAsync(default);
        _recentShelves = [.. all.OrderByDescending(x => x.ScannedAt).Take(5)];
        await InvokeAsync(StateHasChanged);
    }

    private async Task CaptureAsync()
    {
        if (_state != PageState.Ready) return;

        _state = PageState.Analyzing;
        _error = null;
        StateHasChanged();

        try
        {
            var capture = await JS.InvokeAsync<CaptureResult>("webcam.capture");
            var base64  = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes   = Convert.FromBase64String(base64);

            var folder  = Path.Combine(Directory.GetCurrentDirectory(), "data", "shelves");
            Directory.CreateDirectory(folder);
            var imgPath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(imgPath, bytes);

            var result = await ShelfRecognition.AnalyzeAsync(imgPath, CancellationToken.None);

            var existing   = await ShelfRepo.GetAllWithBooksAsync(default);
            var nextNumber = existing.Count == 0 ? 1 : existing.Max(x => x.ShelfNumber) + 1;

            var shelf = new ScannedShelf
            {
                ShelfNumber = nextNumber,
                ImagePath   = imgPath,
                ScannedAt   = DateTime.UtcNow,
                Books       = (result?.Items ?? [])
                    .Where(i => !string.IsNullOrWhiteSpace(i.Title))
                    .Select(i => new ShelfBook
                    {
                        Title  = i.Title  ?? "",
                        Author = i.Author ?? "",
                        BBoxX  = i.BBoxX  ?? 0,
                        BBoxY  = i.BBoxY  ?? 0,
                        BBoxW  = i.BBoxW  ?? 0,
                        BBoxH  = i.BBoxH  ?? 0,
                    })
                    .ToList()
            };

            await ShelfRepo.AddShelvesAsync([shelf], CancellationToken.None);
            await LoadRecentAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _state = PageState.Ready;
            StateHasChanged();
        }
    }

    private sealed class CaptureResult { public string Image { get; set; } = ""; }
}
