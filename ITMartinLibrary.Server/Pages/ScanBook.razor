@page "/library/scan-book"
@page "/library/scan-media"

@using ITMartinLibrary.Application.Services
@using ITMartinLibrary.Domain.Entities
@using Microsoft.JSInterop
@inject InventoryService InventoryService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="library-page">
    <div class="page-container">

        <div class="scan-hero-card">
            <div class="library-row">
                <div>
                    <h1>📷 Scan Item</h1>
                    <p class="hero-text">Books, DVDs, and Blu-rays — point the barcode at the frame.</p>
                </div>
                @if (_sessionCount > 0)
                {
                    <div class="content-card stat-card" style="min-width:100px; text-align:center;">
                        <h3>@_sessionCount</h3>
                        <p>Scanned</p>
                    </div>
                }
            </div>
        </div>

        <div class="camera-wrapper mt-3">
            <video id="barcode-video" autoplay muted playsinline webkit-playsinline></video>
            <div class="scan-guide-box">
                <div class="corner tl"></div>
                <div class="corner tr"></div>
                <div class="corner bl"></div>
                <div class="corner br"></div>
                @if (!string.IsNullOrWhiteSpace(_cameraStatus))
                {
                    <div class="scan-guide-status">@_cameraStatus</div>
                }
            </div>
            <div class="scan-guide-hint">Hold barcode inside the frame</div>
        </div>

        <input @ref="_barcodeInput" @bind="_barcode" @bind:event="oninput"
               class="scan-hidden-input" tabindex="-1" autocomplete="off" />

        @if (_error is not null)
        {
            <div class="alert alert-danger mt-3">@_error</div>
        }

        @if (_recentScans.Count > 0)
        {
            <div class="content-card mt-4">
                <h4 class="mb-3">Recently Scanned</h4>
                <div class="stack">
                    @foreach (var entry in _recentScans)
                    {
                        <div class="recent-scan-row">
                            <div>
                                <div class="recent-scan-title">
                                    @(string.IsNullOrWhiteSpace(entry.Item.Title) || entry.Item.Title == "Untitled"
                                        ? entry.Item.Barcode
                                        : entry.Item.Title)
                                </div>
                                @if (!string.IsNullOrWhiteSpace(entry.Item.AuthorOrDirector))
                                {
                                    <div class="text-muted" style="font-size:13px;">@entry.Item.AuthorOrDirector</div>
                                }
                                <div class="text-muted" style="font-size:12px;">
                                    @entry.Item.Barcode · @entry.Item.Type
                                </div>
                            </div>
                            <div class="recent-scan-right">
                                <div class="item-status-badge @GetStatusClass(entry.Item.LookupStatus)">
                                    @entry.Item.LookupStatus
                                </div>
                                <div class="recent-scan-action">
                                    @(entry.IsNew ? "Added" : $"Qty: {entry.Item.Quantity}")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>

<style>
    .camera-wrapper {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        background: black;
        aspect-ratio: 4/3;
        max-height: 55vh;
    }

    .camera-wrapper video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .scan-guide-box {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -56%);
        width: 78%;
        height: 100px;
        border-radius: 6px;
        box-shadow: 0 0 0 9999px rgba(0,0,0,0.48);
    }

    .corner {
        position: absolute;
        width: 22px;
        height: 22px;
        border-color: #fff;
        border-style: solid;
    }

    .corner.tl { top: -2px; left: -2px;  border-width: 3px 0 0 3px; border-radius: 5px 0 0 0; }
    .corner.tr { top: -2px; right: -2px; border-width: 3px 3px 0 0; border-radius: 0 5px 0 0; }
    .corner.bl { bottom: -2px; left: -2px;  border-width: 0 0 3px 3px; border-radius: 0 0 0 5px; }
    .corner.br { bottom: -2px; right: -2px; border-width: 0 3px 3px 0; border-radius: 0 0 5px 0; }

    .scan-guide-status {
        position: absolute;
        bottom: -30px;
        left: 50%;
        transform: translateX(-50%);
        color: #4ade80;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .scan-guide-hint {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.6);
        color: rgba(255,255,255,0.85);
        padding: 5px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        backdrop-filter: blur(4px);
    }

    .scan-hidden-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 1px;
        height: 1px;
    }

    .recent-scan-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .recent-scan-row:last-child { border-bottom: none; }

    .recent-scan-title {
        font-weight: 600;
        font-size: 15px;
    }

    .recent-scan-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        white-space: nowrap;
    }

    .recent-scan-action {
        font-size: 13px;
        color: var(--text-muted);
    }
</style>

@code {
    private string _barcode = "";
    private string? _error;
    private bool _isProcessing;
    private int _sessionCount;
    private ElementReference _barcodeInput;
    private string? _cameraStatus;
    private DotNetObjectReference<ScanBook>? _dotNetRef;

    private readonly record struct ScanEntry(InventoryItem Item, bool IsNew);
    private List<ScanEntry> _recentScans = new();

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("barcodeScanner.stop"); } catch { }
        _dotNetRef?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _dotNetRef = DotNetObjectReference.Create(this);
        _cameraStatus = "Starting camera...";
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("barcodeScanner.start", "barcode-video", _dotNetRef);
            _cameraStatus = null;
        }
        catch
        {
            _cameraStatus = "Camera unavailable";
        }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnBarcodeDetected(string code)
    {
        if (_isProcessing || string.IsNullOrWhiteSpace(code)) return;
        _barcode = code;
        _cameraStatus = code;
        await ProcessScan();
    }

    private string Barcode
    {
        get => _barcode;
        set
        {
            _barcode = value;
            if (!_isProcessing && _barcode.Length is 12 or 13)
                _ = ProcessScan();
        }
    }

    private async Task ProcessScan()
    {
        if (_isProcessing) return;
        _isProcessing = true;
        _error = null;

        try
        {
            var code = _barcode;
            var (item, isNew) = await InventoryService.ScanOrIncrementAsync(code);

            _sessionCount++;
            _recentScans.Insert(0, new ScanEntry(item, isNew));
            if (_recentScans.Count > 10) _recentScans.RemoveAt(_recentScans.Count - 1);

            _barcode = "";
            _cameraStatus = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private string GetStatusClass(string? status) => status switch
    {
        "Completed"             => "status-completed",
        "Processing"            => "status-processing",
        "Pending"               => "status-pending",
        "Pending Manual Review" => "status-review",
        _                       => "status-pending"
    };
}
