@page "/library/dashboard"
@implements IDisposable

@using ITMartin.Ai.Interfaces
@using ITMartinLibrary.Domain.Entities
@inject InventoryService InventoryService
@inject IAuthorSimilarityService AuthorSimilarity

<div class="library-page">
    <div class="page-container">

        <!-- HERO -->
        <div class="scan-hero-card dashboard-hero">
            <div class="library-row">
                <div>
                    <h1>📚 Library Dashboard</h1>
                    <p class="hero-text">
                        Manage inventory, stock and recently added items.
                    </p>
                </div>

                <div class="form-actions">
                    <a href="/library/inventory" class="btn btn-primary">
                        🗂️ Browse All
                    </a>

                    <a href="/library/new" class="btn btn-success">
                        ➕ Add New Item
                    </a>

                    <a href="/library/bookcase" class="btn btn-success">
                        📷 Scan Bookcase
                    </a>

                    <a href="/library/shelf-scanner" class="btn btn-success">
                        📷 Scan Shelf
                    </a>

                    <a href="/library/scan-book" class="btn btn-primary">
                        📷 Scan Items
                    </a>
                </div>
            </div>
        </div>

        <!-- STATS -->
        <div class="dashboard-stats-grid">
            <div class="content-card stat-card">
                <h3>@items.Count</h3>
                <p>Total Items</p>
            </div>

            <div class="content-card stat-card">
                <h3>@items.Sum(x => x.Quantity)</h3>
                <p>Total Stock</p>
            </div>

            <div class="content-card stat-card">
                <h3>@items.Count(x => string.IsNullOrWhiteSpace(x.Title))</h3>
                <p>Incomplete</p>
            </div>
        </div>

        <!-- RECENT -->
        <div class="content-card recent-section-card">
            <div class="library-row">
                <div>
                    <h3>🕒 Recently Added</h3>
                    <p class="text-muted">Latest 5 inventory items</p>
                </div>
            </div>

            @if (!recentItems.Any())
            {
                <p>No recent items.</p>
            }
            else
            {
                <div class="recent-items-grid">
                    @foreach (var item in recentItems)
                    {
                        <div class="recent-item-card highlight-card">

                            <div class="item-status-badge @GetStatusClass(item.LookupStatus)">
                                @item.LookupStatus
                            </div>

                            <div class="recent-item-header">
                                <span class="recent-item-icon">📘</span>

                                <div>
                                    <h4 class="item-title">
                                        @(string.IsNullOrWhiteSpace(item.Title) ? "Untitled" : item.Title)
                                    </h4>

                                    <div class="item-subtitle">
                                        Recently added
                                    </div>
                                </div>
                            </div>

                            <div class="item-meta mt-3">
                                <div><span class="item-label">Barcode:</span> @item.Barcode</div>
                                <div><span class="item-label">Quantity:</span> @item.Quantity</div>
                                <div><span class="item-label">Type:</span> @item.Type</div>
                            </div>

                            <div class="mt-3">
                                <a href="/library/edit/@item.Id" class="btn btn-secondary card-action-btn">
                                    ✏️ Edit
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <!-- SIMILAR AUTHORS -->
        <div class="content-card mt-4">
            <div class="library-row">
                <div>
                    <h3>🔍 Discover Similar Authors</h3>
                    <p class="text-muted">AI suggestions based on your library</p>
                </div>
                <button class="btn btn-primary" @onclick="LoadSuggestions" disabled="@_loadingSuggestions">
                    @(_loadingSuggestions ? "Thinking..." : "Get Suggestions")
                </button>
            </div>

            @if (_suggestions.Count > 0)
            {
                <div class="suggestions-grid mt-3">
                    @foreach (var s in _suggestions)
                    {
                        <div class="suggestion-card">
                            <div class="suggestion-name">@s.AuthorName</div>
                            <div class="suggestion-genre">@s.Genre</div>
                            <div class="suggestion-reason">@s.Reason</div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>

<style>
    .suggestions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 12px;
    }

    .suggestion-card {
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 12px;
        padding: 14px;
    }

    .suggestion-name {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .suggestion-genre {
        font-size: 12px;
        color: #f59e0b;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .suggestion-reason {
        font-size: 13px;
        color: var(--text-muted);
    }
</style>

@code {
    private List<InventoryItem> items = new();
    private List<InventoryItem> recentItems = new();
    private List<AuthorSuggestion> _suggestions = new();
    private bool _loadingSuggestions;

    private PeriodicTimer? refreshTimer;
    private CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return Task.CompletedTask;
        refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RefreshLoop();
        return Task.CompletedTask;
    }

    private async Task RefreshLoop()
    {
        try
        {
            while (await refreshTimer!.WaitForNextTickAsync(cts.Token))
            {
                await LoadDashboard();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // normal on dispose
        }
    }

    private async Task LoadDashboard()
    {
        items = await InventoryService.GetAllAsync() ?? new();

        recentItems = items
            .OrderByDescending(x => x.DetailsUpdatedAt ?? x.LastScannedAt)
            .Take(5)
            .ToList();
    }

    private async Task LoadSuggestions()
    {
        _loadingSuggestions = true;
        StateHasChanged();
        try
        {
            var authors = items
                .Select(x => x.AuthorOrDirector)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct();
            _suggestions = await AuthorSimilarity.GetSimilarAuthorsAsync(authors);
        }
        catch { }
        finally
        {
            _loadingSuggestions = false;
            StateHasChanged();
        }
    }

    private string GetStatusClass(string? status)
    {
        return status switch
        {
            "Completed" => "status-completed",
            "Processing" => "status-processing",
            "Pending" => "status-pending",
            "Pending Manual Review" => "status-review",
            _ => "status-pending"
        };
    }

    public void Dispose()
    {
        cts.Cancel();
        refreshTimer?.Dispose();
        cts.Dispose();
    }
}