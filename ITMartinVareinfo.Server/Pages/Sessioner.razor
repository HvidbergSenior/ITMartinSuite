@page "/sessioner"
@inject SessionUseCases Sessions
@inject HelperUseCases Helpers

@* Martin's page (user 2026-10-29: "Session 1, 2, 3, etc... A session should be named something like location and/or
   intent" - no boxes). The rules are in WorkSession / SessionUseCases; this page only calls them. *@
<PageTitle>Sessioner – Bogshoppen Vareinfo</PageTitle>

@if (Me is not { IsAdmin: true })
{
    <section class="k-card">
        <h1 class="k-card-title">Kun for Martin</h1>
        <p>Her starter Martin sessionerne til hjælperne.</p>
        <a class="k-btn k-btn-secondary" href="/">📷 Tilbage til billederne</a>
    </section>
}
else
{
    <section class="k-card">
        <h1 class="k-card-title">Sessioner</h1>
        <p>En session er en gang, I tager billeder – fx <i>Session 3 – Boxit, reol 2</i>. Sessionerne får numre af sig selv (1, 2, 3 …). Giv hver et navn efter <b>stedet</b> og/eller <b>hvad I tager billeder af</b> – så kan tingene findes igen bagefter.</p>
        <ol>
            <li>Skriv sted og/eller formål, og tryk <b>Start session</b>.</li>
            <li>Hjælperne ser de åbne sessioner og trykker bare på den, de er med i. I kan godt være flere i samme session.</li>
            <li>Vælg under <b>Til</b>, hvis en session kun er til én hjælper. Står der <b>Alle</b>, kan alle tage billeder i den.</li>
            <li>Når I er færdige, tryk <b>Luk</b>. Billederne bliver gemt.</li>
        </ol>
        <form class="lg-row" @onsubmit="Start">
            <input class="k-input" @bind="_newName" placeholder="Sted og/eller formål, fx Boxit, reol 2" aria-label="Sessionens sted og/eller formål" />
            <button class="k-btn k-btn-primary" type="submit" disabled="@_busy">Start session</button>
        </form>
        @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
        @if (_msg is not null) { <p class="lg-ok" role="status">✓ @_msg</p> }
    </section>

    @if (_list.Count > 0)
    {
    <section class="k-card">
        <h2 class="k-card-title">Alle sessioner</h2>
        <p>Navnet gemmes, når du går ud af feltet. Lukkede sessioner står nederst.</p>
        <ul class="lg-list">
            @foreach (var st in _list)
            {
                var s = st.Session;
                <li>
                    <span class="lg-box">@s.Number</span>
                    <input class="k-input" value="@s.Name" placeholder="Sted og/eller formål" aria-label="Navn på session @s.Number"
                           @onchange="e => Rename(s.Id, e.Value?.ToString())" />
                    <label class="k-small">Til
                        <select class="k-input" aria-label="Hvem session @s.Number er til" @onchange="e => Give(s.Id, e.Value?.ToString())">
                            <option value="" selected="@(s.HelperId is null)">Alle</option>
                            @foreach (var h in _helpers)
                            {
                                <option value="@h.Id" selected="@(s.HelperId == h.Id)">@h.Name</option>
                            }
                            @if (s.HelperId is { } given && _helpers.All(h => h.Id != given))
                            {
                                <option value="@given" selected>@s.HelperName</option>
                            }
                        </select>
                    </label>
                    <span class="k-small">@(s.Open ? "åben" : "lukket") · @st.Photos billeder@(st.Scans > 0 ? $" · {st.Scans} stregkoder" : "")@(st.Helpers.Count > 0 ? " · " + string.Join(", ", st.Helpers) : "")</span>
                    @if (s.Open) { <button class="k-btn k-btn-sm k-btn-secondary" @onclick="() => Close(s.Id)" disabled="@_busy">Luk</button> }
                    else { <button class="k-btn k-btn-sm k-btn-secondary" @onclick="() => Reopen(s.Id)" disabled="@_busy">Åbn igen</button> }
                    @if (st.Photos + st.Scans == 0)
                    {
                        @if (_confirmDelete == s.Id)
                        {
                            <button class="k-btn k-btn-sm k-btn-primary" @onclick="() => Delete(s.Id)" disabled="@_busy">Ja, slet</button>
                            <button class="k-btn k-btn-sm k-btn-ghost" @onclick="() => _confirmDelete = null">Nej</button>
                        }
                        else
                        {
                            <button class="k-btn k-btn-sm k-btn-ghost" @onclick="() => _confirmDelete = s.Id">Slet</button>
                        }
                    }
                </li>
            }
        </ul>
        <p class="k-small k-muted">En session med billeder kan kun lukkes, ikke slettes – så tingene altid kan findes igen.</p>
    </section>
    }
}

@code {
    [CascadingParameter] public Taker? Me { get; set; }

    private List<SessionStatus> _list = [];
    private string _newName = "";
    private int? _confirmDelete;
    private List<HelperChoice> _helpers = [];
    private bool _busy;
    private string? _error, _msg;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        if (Me is not { IsAdmin: true }) return;
        _list = await Sessions.OverviewAsync();
        _helpers = await Helpers.ChoicesAsync();
    }

    private Task Start() => Do(async () => { var s = await Sessions.StartAsync(_newName); _newName = ""; _msg = $"{s.Title} er startet. Hjælperne kan vælge den nu."; });
    private Task Rename(int id, string? name) => Do(() => Sessions.RenameAsync(id, name));

    private Task Give(int id, string? value) => Do(() =>
        Sessions.GiveAsync(id, int.TryParse(value, out var h) ? _helpers.FirstOrDefault(x => x.Id == h) ?? new HelperChoice(h, "") : null));

    private Task Delete(int id) => Do(async () => { await Sessions.DeleteAsync(id); _confirmDelete = null; _msg = "Sessionen er slettet."; });
    private Task Close(int id) => Do(async () => { await Sessions.CloseAsync(id); _msg = "Sessionen er lukket. Hjælperne ser den ikke mere – billederne er gemt."; });
    private Task Reopen(int id) => Do(() => Sessions.ReopenAsync(id));

    private async Task Do(Func<Task> action)
    {
        _busy = true; _error = null; _msg = null;
        try { await action(); await Load(); }
        catch (VareinfoException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
