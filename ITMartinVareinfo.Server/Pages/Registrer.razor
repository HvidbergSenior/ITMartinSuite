@page "/"
@page "/registrer"
@inject CaptureUseCases Capture
@inject SessionUseCases Sessions
@inject IJSRuntime JS
@implements IAsyncDisposable
@using System.Text.Json

@* The capture page (user 2026-10-20): "The users of that app should easily take pictures of all and select the relevant
   box number ... 100 people on 100 boxes with own phone each". Type the number on the box -> photos and barcodes -> done.
   Everything is only stored; Lager reads it later. *@
<PageTitle>Kasse – Bogshoppen Vareinfo</PageTitle>

@if (Me is null)
{
    <section class="k-card"><p><a class="k-btn k-btn-primary" href="/login">Log ind</a></p></section>
}
else if (_box is null)
{
    @* The prepared boxes (user 2026-10-26: "I prepare which boxes so that they just have to choose"): a helper only taps
       one of these - or their own test box below. *@
    <section class="k-card">
        <h1 class="k-card-title">📦 Vælg en kasse</h1>
        @if (_choices.Count == 0)
        {
            <p>Hej @Me.Name. Der er ikke gjort kasser klar lige nu. Martin gør dem klar, før I går i gang – imens kan du prøve din <b>testkasse</b> nedenfor.</p>
        }
        else
        {
            <p>Hej @Me.Name. Tryk på den kasse, du har foran dig. Nummeret står på kassen. En kasse, en anden er i gang med, kan du ikke vælge.</p>
            <ul class="lg-list">
                @foreach (var c in _choices)
                {
                    <li>
                        <span class="lg-main"><b>@c.Title</b>
                            <span class="k-small">@(c.State switch
                            {
                                ChoiceState.Mine => "Din – du er i gang",
                                ChoiceState.Busy => $"{c.Who} er i gang",
                                ChoiceState.Done => $"Færdig{(c.Who != "" ? " – " + c.Who : "")}",
                                _ => "Fri",
                            })@(c.Photos > 0 ? $" · {c.Photos} billeder" : "")</span></span>
                        @if (c.CanTake)
                        {
                            <button class="k-btn k-btn-primary" @onclick="() => TakeChoice(c)" disabled="@_busy">@(c.State == ChoiceState.Mine ? "Fortsæt" : "Vælg")</button>
                        }
                    </li>
                }
            </ul>
        }
        @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
        @if (_saved is not null) { <p class="lg-ok" role="status">✓ @_saved</p> }
        <p data-photo-status role="status" hidden></p>
    </section>

    @if (Me.IsAdmin)
    {
    <section class="k-card" data-fold-closed>
        <h2 class="k-card-title">Andre kasser (kun Martin)</h2>
        <p>Har kassen en label med QR-kode, så tryk <b>Scan kassens label</b> og hold kameraet foran QR-koden. Ellers skriv det nummer, der står på kassen, og tryk <b>Start kassen</b>. Hjælperne kan kun vælge kasserne på listen ovenfor – dem gør du klar under <b>Sessioner</b>.</p>
        @if (!_scanningLabel)
        {
            <button type="button" class="k-btn k-btn-primary lg-big" @onclick="StartLabelScan" disabled="@_busy">▣ Scan kassens label</button>
        }
        else
        {
            <div class="lg-scan">
                <video id="label-video" muted playsinline></video>
                <p class="lg-answer" role="status">Hold kameraet foran QR-koden på kassens label …</p>
                <button type="button" class="k-btn k-btn-secondary" @onclick="StopLabelScan">Annullér – jeg skriver nummeret</button>
            </div>
        }
        <form class="lg-row" @onsubmit="Take">
            <input class="k-input lg-pin" type="number" inputmode="numeric" min="1" max="@BoxClaim.MaxNormal" placeholder="Kassens nr." @bind="_number" aria-label="Kassens nummer" />
            <button class="k-btn k-btn-primary lg-big" type="submit" disabled="@_busy">Start kassen</button>
        </form>
    </section>
    }

    <section class="k-card">
        <h2 class="k-card-title">Min testkasse</h2>
        <p>Vil du bare prøve? Din egen testkasse er kun din, og tingene i den bliver <b>kun vist</b> – de bliver aldrig solgt. Tryk <b>Min testkasse</b> og tag billeder af hvad som helst.</p>
        <button type="button" class="k-btn k-btn-secondary lg-big" @onclick="TakeTest" disabled="@_busy">Min testkasse</button>
    </section>
}
else
{
    <section class="k-card">
        <h1 class="k-card-title">📦 @BoxName(_box)</h1>
        <p class="lg-answer" role="status">I @BoxName(_box).ToLowerInvariant(): <b>@_photos billeder</b> og <b>@_scans stregkoder</b>.</p>
        <p>Læg 10-20 ting fra kassen ud med forsiden op, og tag billedet lige ovenfra. Gentag til kassen er tom. Det hele <b>gemmes bare</b> – det læses senere på Lager.</p>
        <p><b>CD'er, DVD'er, LP'er og bøger på række:</b> stil dem tæt op ad hinanden med ryggen mod dig og tag ét billede af 20-30 rygge ad gangen – gå tæt på, så teksten på ryggene kan læses.</p>
        @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
        @* Plain HTML + fotokoe.js, not InputFile: the photo is kept on the phone until the server has it (2026-10-19). *@
        <button type="button" class="k-btn k-btn-primary lg-big" data-camera-open data-photo-url="/api/foto" data-fields="@BoxFields">📷 Tag billeder</button>
        <div id="foto-cam" class="lg-scan" hidden>
            <video id="foto-video" class="lg-cam-video" muted playsinline></video>
            <div id="foto-cam-tools" class="lg-row lg-cam-tools"></div>
            <button type="button" class="k-btn k-btn-primary lg-big" data-camera-shoot>📸 Tag billede</button>
            <p id="foto-cam-note" class="lg-answer" role="status"></p>
            <button type="button" class="k-btn k-btn-secondary" data-camera-close>✓ Færdig med billeder</button>
        </div>
        <p data-photo-status role="status" hidden></p>
        <p class="k-small k-muted">Kameraet åbner her på siden, så du kan tage det ene billede efter det andet. Billederne gemmes først på telefonen og sendes bagefter – mister du forbindelsen, sendes de, når den er tilbage.</p>
        <div class="lg-row">
            <label class="k-btn k-btn-ghost k-btn-sm lg-camera">Brug telefonens kamera
                <input type="file" accept="image/*" capture="environment" class="lg-hidden-file" data-photo-url="/api/foto" data-fields="@BoxFields" />
            </label>
            <label class="k-btn k-btn-ghost k-btn-sm lg-camera">Vælg billeder fra telefonen
                <input type="file" accept="image/*" multiple class="lg-hidden-file" data-photo-url="/api/foto" data-fields="@BoxFields" />
            </label>
        </div>
    </section>

    <section class="k-card" data-fold-closed>
        <h2 class="k-card-title">▮▯▮ Stregkoder</h2>
        <p>Bedst til DVD, Blu-ray, CD, spil og bøger. Hold stregkoden foran kameraet – <b>bip</b> – næste. Samme stregkode igen = ét eksemplar mere.</p>
        @if (!_scanning)
        {
            <button class="k-btn k-btn-secondary lg-big" @onclick="StartScan">▮▯▮ Scan stregkoder</button>
        }
        else
        {
            <div class="lg-scan">
                <video id="scan-video" muted playsinline></video>
                <p class="lg-answer" role="status">@_scanStatus</p>
                <button class="k-btn k-btn-primary" @onclick="StopScan">✓ Færdig med at scanne</button>
            </div>
        }
    </section>

    <section class="k-card">
        <h2 class="k-card-title">Er kassen tom?</h2>
        <p>Når alt i kassen har været på et billede, så tryk her. Så er kassen fri, og du kan tage den næste.</p>
        @if (!_confirmDone)
        {
            <button class="k-btn k-btn-secondary lg-big" @onclick="() => _confirmDone = true" disabled="@_busy">✓ Kassen er færdig</button>
        }
        else
        {
            <div class="lg-row">
                <button class="k-btn k-btn-primary" @onclick="Finish" disabled="@_busy">✓ Ja, @BoxName(_box).ToLowerInvariant() er færdig</button>
                <button class="k-btn k-btn-ghost" @onclick="() => _confirmDone = false">Nej, jeg er ikke færdig</button>
            </div>
        }
    </section>
}

@code {
    [CascadingParameter] public Taker? Me { get; set; }

    private BoxClaim? _box;
    private int? _number;
    private int _photos, _scans;
    private bool _confirmDone, _busy, _scanning;
    private string? _error, _saved;
    private string _scanStatus = "";
    private string _lastCode = "";
    private DateTime _lastAt;
    private DotNetObjectReference<Registrer>? _ref;

    protected override async Task OnInitializedAsync()
    {
        if (Me is null) return;
        // Back on the page (reload, next morning): the box this helper was filling.
        _box = await Capture.MyBoxAsync(Me);
        await LoadChoices();
        await Count();
    }

    private List<BoxChoice> _choices = [];

    private async Task LoadChoices()
    {
        if (Me is null) return;
        try { _choices = await Sessions.ChoicesAsync(Me); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task TakeChoice(BoxChoice c)
    {
        _number = BoxCodes.Number(c.BoxCode);
        await Take();
        if (_box is null) await LoadChoices();   // someone else took it a moment ago - show the list as it is now
    }

    // "Kasse 7 – Anders And 1970'erne" when Martin named it in the session.
    private string BoxName(BoxClaim box) => box.IsTest ? $"Testkasse {box.Number}"
        : _choices.FirstOrDefault(c => c.BoxCode == box.BoxCode)?.Title ?? $"Kasse {box.Number}";

    // Each photo carries its own box, so photos still waiting on the phone land in the right box after the next box.
    private string BoxFields => _box is null ? "{}" : JsonSerializer.Serialize(new { boxCode = _box.BoxCode });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("photoQueue.listen", _ref); } catch (JSDisconnectedException) { }
    }

    // fotokoe.js: one more photo is on the server.
    [JSInvokable]
    public async Task PhotoSent()
    {
        await Count();
        StateHasChanged();
    }

    private async Task Take()
    {
        if (Me is null) return;
        _busy = true; _error = null; _saved = null;
        try
        {
            if (_number is not { } n) throw new VareinfoException("Skriv nummeret på kassen.");
            _box = await Capture.TakeBoxAsync(n, Me);
            _confirmDone = false;
            await Count();
        }
        catch (VareinfoException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task TakeTest()
    {
        if (Me is null) return;
        _busy = true; _error = null; _saved = null;
        try
        {
            _box = await Capture.MyTestBoxAsync(Me);
            _confirmDone = false;
            await Count();
        }
        catch (VareinfoException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }


    private async Task Finish()
    {
        if (Me is null || _box is null) return;
        await StopScan();
        try { await JS.InvokeVoidAsync("photoQueue.closeCamera"); } catch { }
        _busy = true;
        try
        {
            await Capture.FinishBoxAsync(_box.BoxCode, Me);
            _saved = $"{BoxName(_box)} er færdig: {_photos} billeder og {_scans} stregkoder. Vælg den næste kasse på listen.";
            _box = null;
            _number = null;
            await LoadChoices();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; _confirmDone = false; }
    }

    private async Task Count()
    {
        if (_box is null) return;
        try { (_photos, _scans) = await Capture.CountAsync(_box.BoxCode); }
        catch (Exception ex) { _error = ex.Message; }
    }

    // ── The box label (Lager prints it: number + QR to /kasse/K0007). Scanning it = typing the number, without typos.
    private bool _scanningLabel;

    private async Task StartLabelScan()
    {
        _error = null; _saved = null;
        _scanningLabel = true;
        StateHasChanged();
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("scanner.start", _ref, new { qr = true, videoId = "label-video" }); }
        catch (Exception ex) { _scanningLabel = false; _error = "Kameraet kunne ikke startes: " + ex.Message + " Skriv nummeret i stedet."; }
    }

    private async Task StopLabelScan()
    {
        _scanningLabel = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
    }

    // Called by scanner.js with the first QR code it sees.
    [JSInvokable]
    public async Task OnQr(string raw)
    {
        _scanningLabel = false;
        if (BoxCodes.FromLabel(raw) is var n and > 0)
        {
            _number = n;
            _ = JS.InvokeVoidAsync("scanner.beep");
            await Take();
        }
        else _error = "Det var ikke en kasse-label fra Bogshoppen. Prøv igen, eller skriv nummeret på kassen.";
        StateHasChanged();
    }

    private async Task StartScan()
    {
        _error = null;
        _scanning = true;
        _scanStatus = "Hold stregkoden foran kameraet …";
        StateHasChanged();
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("scanner.start", _ref); }
        catch (Exception ex) { _scanning = false; _error = "Kameraet kunne ikke startes: " + ex.Message; }
    }

    private async Task StopScan()
    {
        if (!_scanning) return;
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        await Count();
    }

    // Called by scanner.js for each code. The same code twice within 4 s = the camera saw it again, not a second copy.
    [JSInvokable]
    public async Task OnBarcode(string raw)
    {
        var code = Barcodes.Clean(raw);
        var again = code == _lastCode && (DateTime.Now - _lastAt).TotalSeconds < 4;
        _lastCode = code; _lastAt = DateTime.Now;
        if (!again && code.Length >= 8 && _box is not null && Me is not null)
        {
            try
            {
                var copies = await Capture.ScanAsync(code, _box.BoxCode, Me);
                _ = JS.InvokeVoidAsync("scanner.beep");
                _scanStatus = copies > 1 ? $"✓ {code} – nu {copies} stk. i kasse {_box.Number}" : $"✓ {code} gemt i kasse {_box.Number}";
                await Count();
            }
            catch (Exception ex) { _scanStatus = "⚠ " + ex.Message; }
        }
        StateHasChanged();
        if (_scanning)
        {
            await Task.Delay(800);
            try { if (_scanning) await JS.InvokeVoidAsync("scanner.start", _ref); } catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _scanning = _scanningLabel = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        try { if (_ref is not null) await JS.InvokeVoidAsync("photoQueue.unlisten", _ref); } catch { }
        _ref?.Dispose();
    }
}
