@page "/"
@page "/registrer"
@inject ReadingUseCases Reg
@inject LagerLinks Lager
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Registrér – Bogshoppen Vareinfo</PageTitle>

<section class="k-card">
    <h1 class="k-card-title">📷 Registrér en bunke</h1>

    <p>Tag et billede af en bunke, eller scan stregkoderne – så finder Vareinfo ud af hvad tingene er og lægger dem på <a href="@Lager.LagerBase">Lager</a>, hvor prisjægeren finder priserne. Ingen kasse at vælge.</p>
    <p>Læg 10-20 ting ud side om side med forsiden op – så alle titler kan ses. Tag billedet lige ovenfra.</p>
    <input class="k-input" @bind="_hint" placeholder="Valgfrit: hvad er det mest? (fx Anders And 1970'erne)" />
    <label class="k-btn k-btn-primary lg-big lg-camera @(_busy ? "is-busy" : "")">
        @(_busy ? "⏳ Læser billedet …" : "📷 Tag billede")
        <InputFile OnChange="Upload" accept="image/*" capture="environment" multiple disabled="@_busy" class="lg-hidden-file" />
    </label>
    <p class="k-small k-muted">Du kan også vælge flere billeder fra telefonen på én gang. AI-kald i dag: @_callsToday af @Reg.MaxCallsPerDay.</p>

    <p><b>Eller scan stregkoden</b> – bedst til DVD, Blu-ray, CD, spil og bøger. Scan den ene efter den anden; det bipper for hver.</p>
    @if (!_scanning)
    {
        <button class="k-btn k-btn-secondary lg-big" @onclick="StartScan">▮▯▮ Scan stregkoder</button>
    }
    else
    {
        <div class="lg-scan">
            <video id="scan-video" muted playsinline></video>
            <p class="lg-answer" role="status">@(_scanStatus)</p>
            <button class="k-btn k-btn-primary" @onclick="StopScan">✓ Færdig med at scanne</button>
        </div>
    }
    @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
    @if (_saved is not null) { <p class="lg-ok" role="status">✓ @_saved</p> }
</section>

@if (_review.Count > 0)
{
    <section class="k-card">
        <h2 class="k-card-title">Tjek og gem (@_review.Count(SavesIt) af @_review.Count)</h2>
        @if (_review.Any(r => r.Keep && r.Interest.Trim() == ""))
        {
            <button class="k-btn k-btn-secondary" @onclick="WriteInterest" disabled="@_busy">✨ Skriv det interessante for de @_review.Count(r => r.Keep && r.Interest.Trim() == "") uden (valgfrit – koster ca. 2 øre pr. vare)</button>
        }
        <p class="k-small">Ret det, der er læst forkert. <b>⚠ Tjek</b> = AI'en var usikker. Fjern fluebenet for ting, der ikke skal med.</p>
        <div class="lg-review">
            @foreach (var r in _review)
            {
                <div class="lg-ritem @(r.Keep ? "" : "is-off")">
                    <div class="lg-rhead">
                        <label><input type="checkbox" @bind="r.Keep" /> @Kinds.Icon(r.Kind)</label>
                        <select class="k-input lg-kind" @bind="r.Kind">
                            @foreach (var k in Kinds.All) { <option value="@k">@k</option> }
                        </select>
                        @if (r.Confidence < 0.6) { <span class="lg-check">⚠ Tjek</span> }
                    </div>
                    @if (r.Gold is not null)
                    {
                        <p class="lg-ok" role="status"><b>🏆 GULD</b> – @r.Gold. Tjek nummer, år og stand. @if (r.GoldUrl is { } gu) { <a href="@gu" target="_blank" rel="noopener">Se annoncen</a> }</p>
                    }
                    @if (r.InStock > 0 || r.DupInList)
                    {
                        <div class="lg-warn" role="status">
                            ⚠ @(r.InStock > 0 ? $"Har vi allerede {r.InStock} stk." : "Står også længere oppe på listen.")
                            @if (r.ItemId is { } iid) { <a href="@Lager.LagerBase/vare/@iid" target="_blank" rel="noopener">Se den på Lager</a> }
                            <div class="lg-chips">
                                <button class="k-btn k-btn-sm @(r.AddCopy ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => r.AddCopy = true">+1 eksemplar</button>
                                <button class="k-btn k-btn-sm @(!r.AddCopy ? "k-btn-primary" : "k-btn-secondary")" @onclick="() => r.AddCopy = false">Samme – gem ikke</button>
                            </div>
                        </div>
                    }
                    <input class="k-input" @bind="r.Title" placeholder="Titel" />
                    <div class="lg-rgrid">
                        @if (r.Kind is Kinds.Cd or Kinds.Bog) { <input class="k-input" @bind="r.Artist" placeholder="@(r.Kind == Kinds.Cd ? "Kunstner" : "Forfatter")" /> }
                        @if (r.Kind == Kinds.Konsolspil) { <input class="k-input" @bind="r.Platform" placeholder="Konsol" /> }
                        <input class="k-input" @bind="r.Series" placeholder="Serie / blad" />
                        <input class="k-input lg-short" @bind="r.Number" placeholder="Nr." />
                        <input class="k-input lg-short" @bind="r.Year" placeholder="År" type="number" />
                        <select class="k-input" @bind="r.Condition">
                            @foreach (var c in Conditions.All) { <option value="@c">@c</option> }
                        </select>
                        <input class="k-input lg-short" @bind="r.Quantity" type="number" min="1" title="Antal" />
                    </div>
                    <textarea class="k-input lg-interest" @bind="r.Interest" rows="2" placeholder="Det interessante ved den …"></textarea>
                    @if (r.EditionHint != "") { <p class="k-small"><b>📖 @r.EditionHint</b> (set på omslaget)</p> }
                    @if (r.Note != "") { <p class="k-small k-muted">@r.Note</p> }
                </div>
            }
        </div>
        <div class="lg-row">
            <button class="k-btn k-btn-primary lg-big" @onclick="Save" disabled="@_busy">✓ Gem @_review.Count(SavesIt) på lager</button>
            <button class="k-btn k-btn-ghost" @onclick="() => _review.Clear()">Kassér</button>
        </div>
    </section>
}

@code {
    private sealed class Row
    {
        public bool Keep = true;
        public string Kind = Kinds.Andet, Title = "", Artist = "", Series = "", Number = "", Platform = "", Condition = "God", Note = "", Interest = "";
        public int? Year;
        public int Quantity = 1;
        public double Confidence = 1;
        public int PhotoId;
        public string Barcode = "", EditionHint = "";
        // Already in Lager, or twice on this list: saved only when the person says "+1 eksemplar".
        public int InStock;
        public int? ItemId;
        public string? Gold, GoldUrl;   // on Lager's gold list (the dearest issues for sale right now)
        public bool DupInList, AddCopy;
        public bool IsDuplicate => InStock > 0 || DupInList;

        public string TitleKey => new(Title.ToLowerInvariant().Where(char.IsLetterOrDigit).ToArray());

        // Same rule as Lager's Item.LooksLike: same barcode, or the title (one may be the other plus a subtitle - a scan
        // gives the publisher's full title) with number and year when both have one.
        public bool LooksLike(Row o)
        {
            if (Barcode != "" && Barcode == o.Barcode) return true;
            string a = TitleKey, b = o.TitleKey;
            var titles = a != "" && b != "" && (a == b || (Math.Min(a.Length, b.Length) >= 8 && (a.StartsWith(b) || b.StartsWith(a))));
            return titles && (Number.Trim() == "" || o.Number.Trim() == "" || string.Equals(Number.Trim(), o.Number.Trim(), StringComparison.OrdinalIgnoreCase))
                && (Year is null || o.Year is null || Year == o.Year);
        }

        public Found ToFound() => new(Kinds.Normalise(Kind), Title.Trim(), Artist.Trim(), Series.Trim(), Number.Trim(), Year,
            Platform.Trim(), Conditions.Normalise(Condition), Math.Max(1, Quantity), Confidence, Note, Interest.Trim(), Barcode, EditionHint: EditionHint);
    }

    private static bool SavesIt(Row r) => r.Keep && r.Title.Trim() != "" && (!r.IsDuplicate || r.AddCopy);

    // Marks rows Lager already has, and rows that are on the list twice (two photos of the same pile).
    private async Task MarkDuplicatesAsync(List<Row> fresh)
    {
        fresh = fresh.Where(r => r.Title.Trim() != "").ToList();
        // Against every row that was on the list before these (a scan is put at the top, a photo's rows at the bottom).
        foreach (var r in fresh) r.DupInList = _review.Any(x => !fresh.Contains(x) && x.Title.Trim() != "" && x.LooksLike(r))
                                               || fresh.TakeWhile(x => x != r).Any(x => x.LooksLike(r));
        try
        {
            var stock = await Reg.InStockAsync(fresh.Select(r => r.ToFound()).ToList());
            for (var n = 0; n < fresh.Count && n < stock.Count; n++)
                (fresh[n].InStock, fresh[n].ItemId, fresh[n].Gold, fresh[n].GoldUrl) = (stock[n].Quantity, stock[n].ItemId, stock[n].Gold, stock[n].GoldUrl);
        }
        catch (Exception ex) { _error = "Kunne ikke tjekke om vi har dem i forvejen: " + ex.Message; }
    }

    private string _hint = "";
    private string? _error, _saved;
    private bool _busy;
    private int _callsToday;
    private readonly List<Row> _review = [];
    private bool _scanning;
    private string _scanStatus = "";
    private string _lastCode = "";
    private DateTime _lastAt;
    private DotNetObjectReference<Registrer>? _ref;

    protected override async Task OnInitializedAsync()
    {
        _callsToday = await Reg.CallsTodayAsync();
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        _busy = true; _error = null; _saved = null;
        StateHasChanged();
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                int photoId;
                List<Found> found;
                await using (var s = file.OpenReadStream(30 * 1024 * 1024))
                    (photoId, found) = await Reg.ReadPileAsync(s, _hint, null, "pile");

                var fresh = found.Select(f => new Row
                {
                    Kind = f.Kind, Title = f.Title, Artist = f.Artist, Series = f.Series, Number = f.Number, Year = f.Year,
                    Platform = f.Platform, Condition = f.Condition, Quantity = f.Quantity, Confidence = f.Confidence,
                    Note = f.Note, Interest = f.Interest, EditionHint = f.EditionHint, PhotoId = photoId,
                }).ToList();
                _review.AddRange(fresh);
                await MarkDuplicatesAsync(fresh);
                if (found.Count == 0) _error = "AI'en fandt ingen ting på billedet. Tag det lidt tættere på, i godt lys.";
                else if (Reg.AutoInterest)
                {
                    // Off by default (user 2026-10-05: "disable texts, add it later maybe") - the text is the costly part.
                    StateHasChanged();
                    await FillInterestAsync(_review.Where(x => x.PhotoId == photoId).ToList());
                }
                StateHasChanged();
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _busy = false;
            _callsToday = await Reg.CallsTodayAsync();
        }
    }

    private async Task Save()
    {
        _busy = true; _error = null;
        int added = 0, merged = 0;
        try
        {
            // Something Lager has, skipped as "Samme" but scanned: the item still gets its barcode (no extra copy).
            var codesOnly = _review.Where(r => r.Keep && r.InStock > 0 && r.ItemId is not null && !r.AddCopy && r.Barcode != "")
                .Select(r => (r.ItemId!.Value, 0, r.Barcode)).ToList();
            if (codesOnly.Count > 0) await Reg.SaveAsync(null, [], codesOnly);
            foreach (var g in _review.Where(SavesIt).GroupBy(r => r.PhotoId).ToList())
            {
                // "+1 eksemplar" on something Lager has goes onto that very item; everything else is new (or merged by Lager).
                var addTo = g.Where(r => r.InStock > 0 && r.ItemId is not null).Select(r => (r.ItemId!.Value, Math.Max(1, r.Quantity), r.Barcode)).ToList();
                var fresh = g.Where(r => !(r.InStock > 0 && r.ItemId is not null)).Select(r => r.ToFound()).ToList();
                var (a, m) = await Reg.SaveAsync(g.Key == 0 ? null : g.Key, fresh, addTo);
                added += a; merged += m;
                _review.RemoveAll(r => r.PhotoId == g.Key && SavesIt(r));   // saved = off the list, so a retry never saves twice
            }
            var skipped = _review.Count(r => r.Keep && r.IsDuplicate && !r.AddCopy);
            _review.Clear();
            _saved = $"Gemt på Lager: {added} nye" + (merged > 0 ? $", {merged} ekstra eksemplarer lagt til nogen, vi havde" : "")
                + (skipped > 0 ? $", {skipped} sprunget over (havde vi allerede)" : "") + ". Prisjægeren finder priserne af sig selv. Tag næste billede.";
        }
        catch (Exception ex) { _error = ex.Message + (added > 0 ? $" ({added} blev gemt, de står ikke længere på listen.)" : ""); }
        finally { _busy = false; }
    }

    private async Task StartScan()
    {
        _error = null; _saved = null;
        _scanning = true;
        _scanStatus = "Hold stregkoden foran kameraet …";
        StateHasChanged();
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("scanner.start", _ref); }
        catch (Exception ex) { _scanning = false; _error = "Kameraet kunne ikke startes: " + ex.Message; }
    }

    private async Task StopScan()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
    }

    // Called by scanner.js for each code. The same code twice within 4 s = the camera saw it again, not a second copy;
    // scanning it again later = one more copy (quantity + 1).
    [JSInvokable]
    public async Task OnBarcode(string raw)
    {
        var code = Barcodes.Clean(raw);
        var again = code == _lastCode && (DateTime.Now - _lastAt).TotalSeconds < 4;
        _lastCode = code; _lastAt = DateTime.Now;
        if (!again && code.Length >= 8)
        {
            _ = JS.InvokeVoidAsync("scanner.beep");
            var same = _review.FirstOrDefault(r => r.Barcode == code);
            if (same is not null)
            {
                same.Quantity++;
                _scanStatus = $"✓ {same.Title}: nu {same.Quantity} stk.";
            }
            else
            {
                _scanStatus = $"Slår {code} op …";
                StateHasChanged();
                var f = await Reg.LookupBarcodeAsync(code);
                _review.Insert(0, f is null
                    ? new Row { Barcode = code, Kind = Barcodes.IsIsbn(code) ? Kinds.Bog : Kinds.Andet, Title = "", Confidence = 0, Note = $"Stregkode {code} – ikke fundet, skriv titlen" }
                    : new Row { Barcode = code, Kind = f.Kind, Title = f.Title, Artist = f.Artist, Year = f.Year, Platform = f.Platform, Confidence = f.Confidence, Note = f.Note });
                _scanStatus = f is null ? $"⚠ {code} ikke fundet – skriv titlen i listen" : $"✓ {f.Title}";
                if (f is not null) await MarkDuplicatesAsync([_review[0]]);
            }
        }
        StateHasChanged();
        if (_scanning)
        {
            await Task.Delay(1200);
            try { if (_scanning) await JS.InvokeVoidAsync("scanner.start", _ref); } catch { }
        }
    }

    private async Task WriteInterest()
    {
        var rows = _review.Where(r => r.Keep && r.Interest.Trim() == "" && r.Title.Trim() != "").Take(40).ToList();
        if (rows.Count == 0) return;
        _busy = true; _error = null;
        StateHasChanged();
        try { await FillInterestAsync(rows); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task FillInterestAsync(List<Row> rows)
    {
        rows = rows.Where(r => r.Title.Trim() != "").Take(40).ToList();
        if (rows.Count == 0) return;
        var lines = rows.Select(r => string.Join(" · ", new[] { r.Kind, r.Artist, r.Title, r.Series, r.Number, r.Year?.ToString() ?? "", r.Platform }
            .Where(x => !string.IsNullOrWhiteSpace(x)))).ToList();
        var texts = await Reg.WriteInterestAsync(lines);
        foreach (var (idx, text) in texts) rows[idx].Interest = text;
        _callsToday = await Reg.CallsTodayAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        _ref?.Dispose();
    }
}
