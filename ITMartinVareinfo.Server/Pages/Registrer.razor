@page "/"
@page "/registrer"
@inject CaptureUseCases Capture
@inject SessionUseCases Sessions
@inject HelperUseCases Helpers
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable
@using System.Text.Json

@* Vareinfo's one job (user 2026-11-15): "Take photos and put into lager". Front page = what you take pictures of; the button opens
   today's session for it (?s=12 in the address, so a reload lands in it again). Lager reads the photos at once. Tjek is its own
   app, Sessioner is gone - nothing to start, name or close. *@
<PageTitle>Tag billeder – Bogshoppen Vareinfo</PageTitle>

@if (Me is null)
{
    <section class="k-card"><p><a class="k-btn k-btn-primary" href="/login">Log ind</a></p></section>
}
else if (_session is null)
{
    @* User 2026-11-15: "Mine varer only" + "choose what to take pictures of. add strik and ting". Each pile button joins today's
       session of that button, or makes it. Strik and Ting are one thing at a time with price and maker, so they open Lager's page. *@
    <section class="k-card">
        <h1 class="k-card-title">Hvad tager du billeder af?</h1>
        <p class="k-help">Dine egne ting til Bogshoppen. Tryk på det, du tager billeder af – billederne bliver læst med det samme og kommer på lager af sig selv.</p>
        <div class="vi-kinds">
            @foreach (var k in CaptureKinds.All)
            {
                <button type="button" class="k-btn k-btn-secondary lg-big" @onclick="() => Today(k.Name)" disabled="@_busy">@k.Name</button>
            }
            <a class="k-btn k-btn-secondary lg-big" href="@($"{Helpers.LagerBase}/strik")">Strik</a>
            <a class="k-btn k-btn-secondary lg-big" href="@($"{Helpers.LagerBase}/ting")">Ting</a>
        </div>
        <p class="k-help">Strik og Ting lægges ind én ad gangen med pris og hvem der har lavet det.</p>
        <p class="k-help">Tag billederne med telefonens kamera. Tryk så på det, de er af, og <b>Upload billeder fra telefonen</b> – du kan vælge mange på én gang.</p>
        @if (_error is not null) { <p class="lg-warn" role="alert">@_error</p> }
        <p data-photo-status role="status" hidden></p>
        @* Photos whose session is gone wait on the phone (fotokoe.js, 2026-10-29) - tap a button above to send them there. *@
        <div data-photo-stranded class="lg-warn" role="status" hidden><p data-photo-stranded-text></p></div>
    </section>
}
else
{
    @* User 2026-11-10: "I do not want to say done with or end session... That should happen automatically pr day... I just want to
       take pictures" + "boxes are not relevant only days/sessions -> i write on the box: sessionname". So: the name for the box at
       the top, Upload (2026-11-15: "only upload from photos" - no camera inside the page), and a small way back. *@
    <section class="k-card">
        <h1 class="k-card-title">@_session.Title</h1>
        <p class="vi-boxname">Skriv på kassen: <b>@_session.Title</b></p>
        <p class="lg-answer" role="status"><b>@_photos billeder</b>@(_scans > 0 ? $" og {_scans} stregkoder" : "") i dag.</p>
        <p>Tag billeder med telefonens kamera – 10-20 ting med forsiden op på hvert. Tryk så <b>Upload billeder fra telefonen</b>, og vælg dem – mange på én gang.
            Det samme to gange gør ikke noget. Tingene bliver læst af sig selv og kommer på lager.</p>
        @if (_error is not null) { <p class="lg-warn" role="alert">@_error</p> }
        <p data-photo-status role="status" hidden></p>
        <div data-photo-stranded class="lg-warn" role="status" hidden>
            <p data-photo-stranded-text></p>
            <button type="button" class="k-btn k-btn-primary" data-photo-adopt>Send dem til denne session</button>
        </div>
        @* Plain HTML + fotokoe.js, not InputFile: the photo is kept on the phone until the server has it (2026-10-19). *@
        <label class="k-btn k-btn-primary lg-big lg-camera">Upload billeder fra telefonen
            <input type="file" accept="image/*" multiple class="lg-hidden-file" data-photo-url="/api/foto" data-fields="@SessionFields" />
        </label>
    </section>

    @* Barcodes (2026-10-26: "something that can be done afterwards") - folded, under the photos. *@
    <section class="k-card" data-fold-closed>
        <h2 class="k-card-title">Stregkoder</h2>
        <p>Bedst til DVD, Blu-ray, CD, spil og bøger. Hold stregkoden foran kameraet – <b>bip</b> – næste. Samme stregkode igen = ét eksemplar mere.</p>
        @if (!_scanning)
        {
            <button class="k-btn k-btn-secondary lg-big" @onclick="StartScan">Scan stregkoder</button>
        }
        else
        {
            <div class="lg-scan">
                <video id="scan-video" muted playsinline></video>
                <p class="lg-answer" role="status">@_scanStatus</p>
                <button class="k-btn k-btn-primary" @onclick="StopScan">Færdig med at scanne</button>
            </div>
        }
    </section>

    <p class="vi-back"><button type="button" class="k-btn k-btn-ghost k-btn-sm" @onclick="Leave">Tag billeder af noget andet</button></p>
}

@code {
    [CascadingParameter] public Taker? Me { get; set; }
    [SupplyParameterFromQuery(Name = "s")] public int? SessionId { get; set; }

    private WorkSession? _session;
    private int _photos, _scans;
    private bool _busy, _scanning;
    private string? _error;
    private string _scanStatus = "";
    private string _lastCode = "";
    private DateTime _lastAt;
    private DotNetObjectReference<Registrer>? _ref;

    // The address says which session (?s=12): after a reload, or a tap on a button or Vælg.
    protected override async Task OnParametersSetAsync()
    {
        if (Me is null) return;
        _error = null;
        try
        {
            _session = SessionId is { } id ? await Sessions.OpenForAsync(id, Me) : null;
            if (SessionId is not null && _session is null) _error = "Den dag er slut – tryk på det, du tager billeder af, så starter i dag.";
            await Count();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Today(string kind)
    {
        if (Me is null) return;
        _busy = true; _error = null;
        try { Nav.NavigateTo($"/?s={(await Sessions.TodayAsync(Me, kind)).Id}"); }
        catch (Exception e) when (e is VareinfoException or InvalidOperationException) { _error = e.Message; }
        finally { _busy = false; }
    }

    private async Task Leave()
    {
        await StopScan();
        Nav.NavigateTo("/");
    }

    // Each photo carries its own session, so photos still waiting on the phone land in the right one.
    private string SessionFields => _session is null ? "{}" : JsonSerializer.Serialize(new { sessionId = _session.Id });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("photoQueue.listen", _ref); } catch (JSDisconnectedException) { }
    }

    // fotokoe.js: one more photo is on the server.
    [JSInvokable]
    public async Task PhotoSent()
    {
        await Count();
        StateHasChanged();
    }

    private async Task Count()
    {
        if (_session is null) return;
        try { (_photos, _scans) = await Capture.CountAsync(_session.Id); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task StartScan()
    {
        _error = null;
        _scanning = true;
        _scanStatus = "Hold stregkoden foran kameraet …";
        StateHasChanged();
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("scanner.start", _ref); }
        catch (Exception ex) { _scanning = false; _error = "Kameraet kunne ikke startes: " + ex.Message; }
    }

    private async Task StopScan()
    {
        if (!_scanning) return;
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        await Count();
    }

    // Called by scanner.js for each code. The same code twice within 4 s = the camera saw it again, not a second copy.
    [JSInvokable]
    public async Task OnBarcode(string raw)
    {
        var code = Barcodes.Clean(raw);
        var again = code == _lastCode && (DateTime.Now - _lastAt).TotalSeconds < 4;
        _lastCode = code; _lastAt = DateTime.Now;
        if (!again && code.Length >= 8 && _session is not null && Me is not null)
        {
            try
            {
                var copies = await Capture.ScanAsync(code, _session.Id, Me);
                _ = JS.InvokeVoidAsync("scanner.beep");
                _scanStatus = copies > 1 ? $"{code} – nu {copies} stk. i sessionen" : $"{code} gemt";
                await Count();
            }
            catch (Exception ex) { _scanStatus = ex.Message; }
        }
        StateHasChanged();
        if (_scanning)
        {
            await Task.Delay(800);
            try { if (_scanning) await JS.InvokeVoidAsync("scanner.start", _ref); } catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        try { if (_ref is not null) await JS.InvokeVoidAsync("photoQueue.unlisten", _ref); } catch { }
        _ref?.Dispose();
    }
}
