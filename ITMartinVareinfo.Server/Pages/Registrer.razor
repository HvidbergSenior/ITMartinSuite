@page "/"
@page "/registrer"
@inject CaptureUseCases Capture
@inject SessionUseCases Sessions
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable
@using System.Text.Json

@* The capture page (user 2026-10-29: "Session 1, 2, 3, etc... named something like location and/or intent" - no boxes).
   Tap the session -> photos (and Martin: barcodes). The open session is in the address (?s=12), so a reload or the next
   morning lands in it again. Everything is only stored; Lager reads it later. *@
<PageTitle>Tag billeder – Bogshoppen Vareinfo</PageTitle>

@if (Me is null)
{
    <section class="k-card"><p><a class="k-btn k-btn-primary" href="/login">Log ind</a></p></section>
}
else if (_session is null)
{
    <section class="k-card">
        <h1 class="k-card-title">@(_choices.Count == 1 && !Me.IsAdmin ? "Din session" : "Vælg en session")</h1>
        @if (_choices.Count == 0)
        {
            <p>Hej @Me.Name. Der er ingen session i gang lige nu. Martin starter den, før I går i gang – imens kan du prøve din <b>øvesession</b> nedenfor.@(Me.IsAdmin ? " Du starter en session under Sessioner." : "")</p>
        }
        else
        {
            <p>Hej @Me.Name. Tryk på den session, du er med i – navnet siger hvor, eller hvad I tager billeder af. I kan godt være flere i samme session.</p>
            <ul class="lg-list">
                @foreach (var c in _choices)
                {
                    <li>
                        <span class="lg-main"><b>@c.Title</b>
                            <span class="k-small">@(c.Photos > 0 ? $"{c.Photos} billeder indtil nu" : "Ingen billeder endnu")</span></span>
                        <button class="k-btn k-btn-primary" @onclick="() => Open(c.Id)">Vælg</button>
                    </li>
                }
            </ul>
        }
        @if (Me.IsAdmin) { <p><a class="k-btn k-btn-secondary" href="/sessioner">Sessioner – start en ny</a></p> }
        @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
        <p data-photo-status role="status" hidden></p>
        @* Photos whose session is gone wait on the phone (fotokoe.js, 2026-10-29) - choose a session above to send them. *@
        <div data-photo-stranded class="lg-warn" role="status" hidden><p data-photo-stranded-text></p></div>
    </section>

    @* Helpers see the øvesession only while no real session is open (user 2026-10-31: "Only push the new session take pictures thats it"). *@
    @if (Me.IsAdmin || _choices.Count == 0)
    {
    <section class="k-card">
        <h2 class="k-card-title">Min øvesession</h2>
        <p>Vil du bare prøve? Din egen øvesession er kun din, og tingene i den bliver <b>kun vist</b> – de bliver aldrig solgt. Tryk <b>Min øvesession</b> og tag billeder af hvad som helst.</p>
        <button type="button" class="k-btn k-btn-secondary lg-big" @onclick="Practice" disabled="@_busy">Min øvesession</button>
    </section>
    }
}
else
{
    <section class="k-card">
        <h1 class="k-card-title">@_session.Title</h1>
        <p class="lg-answer" role="status"><b>@_photos billeder</b>@(Me.IsAdmin ? $" og {_scans} stregkoder" : "") taget i sessionen.</p>
        <p>Læg 10-20 ting ud med forsiden op, og tryk <b>Tag billeder</b>. Gentag, til alt har været på et billede.</p>
        @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
        @* Plain HTML + fotokoe.js, not InputFile: the photo is kept on the phone until the server has it (2026-10-19). *@
        <button type="button" class="k-btn k-btn-primary lg-big" data-camera-open data-photo-url="/api/foto" data-fields="@SessionFields">📷 Tag billeder</button>
        <div id="foto-cam" class="lg-scan" hidden>
            <video id="foto-video" class="lg-cam-video" muted playsinline></video>
            <div id="foto-cam-tools" class="lg-row lg-cam-tools"></div>
            <button type="button" class="k-btn k-btn-primary lg-big" data-camera-shoot>📸 Tag billede</button>
            <p id="foto-cam-note" class="lg-answer" role="status"></p>
            <button type="button" class="k-btn k-btn-secondary lg-big" data-camera-close data-done-url="@(Me.IsAdmin ? null : "/")">✓ Færdig med billeder</button>
        </div>
        <p data-photo-status role="status" hidden></p>
        <div data-photo-stranded class="lg-warn" role="status" hidden>
            <p data-photo-stranded-text></p>
            <button type="button" class="k-btn k-btn-primary" data-photo-adopt>Send dem til denne session</button>
        </div>
        @if (Me.IsAdmin)
        {
        <details class="lg-more-tips">
            <summary>Gode råd</summary>
            <ul>
                <li>Tag billedet lige ovenfra, så alt kan ses.</li>
                <li><b>CD'er, DVD'er, LP'er og bøger på række:</b> stil dem tæt med ryggen mod dig, og tag ét billede af 20-30 rygge – gå tæt på, så teksten kan læses.</li>
                <li>Kameraet bliver åbent, så du kan tage det ene billede efter det andet.</li>
                <li>Mister du forbindelsen, venter billederne på telefonen og sendes, når den er tilbage.</li>
            </ul>
        </details>
        }
        @* "Brug telefonens kamera" stays for everybody: fotokoe.js shows it big when the in-page camera gives no picture. *@
        <div class="lg-row">
            <label class="k-btn k-btn-ghost k-btn-sm lg-camera">Brug telefonens kamera
                <input type="file" accept="image/*" capture="environment" class="lg-hidden-file" data-photo-url="/api/foto" data-fields="@SessionFields" />
            </label>
        </div>
        @* User 2026-10-31: take photos with the phone's own camera first, add them to the session later - many at once. *@
        <label class="k-btn k-btn-secondary lg-big lg-camera">🖼 Tilføj billeder, du allerede har taget
            <input type="file" accept="image/*" multiple class="lg-hidden-file" data-photo-url="/api/foto" data-fields="@SessionFields" />
        </label>
    </section>

    @* Barcodes are not a helper's job (user 2026-10-26: "hide stregkoder for helper... something that can be done
       afterwards") - only Martin sees them. *@
    @if (Me.IsAdmin)
    {
    <section class="k-card" data-fold-closed>
        <h2 class="k-card-title">▮▯▮ Stregkoder</h2>
        <p>Bedst til DVD, Blu-ray, CD, spil og bøger. Hold stregkoden foran kameraet – <b>bip</b> – næste. Samme stregkode igen = ét eksemplar mere.</p>
        @if (!_scanning)
        {
            <button class="k-btn k-btn-secondary lg-big" @onclick="StartScan">▮▯▮ Scan stregkoder</button>
        }
        else
        {
            <div class="lg-scan">
                <video id="scan-video" muted playsinline></video>
                <p class="lg-answer" role="status">@_scanStatus</p>
                <button class="k-btn k-btn-primary" @onclick="StopScan">✓ Færdig med at scanne</button>
            </div>
        }
    </section>
    }

    @* A helper's way out is "Færdig med billeder" (user 2026-10-31: "vælg session, tag billede, færdig med billeder"). *@
    @if (Me.IsAdmin)
    {
    <section class="k-card">
        <h2 class="k-card-title">Færdig her?</h2>
        <p>Billederne er gemt, så snart de er sendt. Martin lukker sessionen, når I er færdige.</p>
        <button class="k-btn k-btn-secondary lg-big" @onclick="Leave">Vælg en anden session</button>
    </section>
    }
}

@code {
    [CascadingParameter] public Taker? Me { get; set; }
    [SupplyParameterFromQuery(Name = "s")] public int? SessionId { get; set; }

    private WorkSession? _session;
    private List<SessionChoice> _choices = [];
    private int _photos, _scans;
    private bool _busy, _scanning;
    private string? _error;
    private string _scanStatus = "";
    private string _lastCode = "";
    private DateTime _lastAt;
    private DotNetObjectReference<Registrer>? _ref;

    // The address says which session (?s=12): after a reload, or a tap on Vælg / Min øvesession.
    protected override async Task OnParametersSetAsync()
    {
        if (Me is null) return;
        _error = null;
        try
        {
            _session = SessionId is { } id ? await Sessions.OpenForAsync(id, Me) : null;
            if (SessionId is not null && _session is null) _error = "Den session er lukket eller ikke din – vælg en på listen.";
            if (_session is null) _choices = await Sessions.ChoicesAsync(Me);
            await Count();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void Open(int id) => Nav.NavigateTo($"/?s={id}");

    private async Task Leave()
    {
        await StopScan();
        try { await JS.InvokeVoidAsync("photoQueue.closeCamera"); } catch { }
        Nav.NavigateTo("/");
    }

    private async Task Practice()
    {
        if (Me is null) return;
        _busy = true; _error = null;
        try { Open((await Sessions.PracticeAsync(Me)).Id); }
        catch (VareinfoException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // Each photo carries its own session, so photos still waiting on the phone land in the right one.
    private string SessionFields => _session is null ? "{}" : JsonSerializer.Serialize(new { sessionId = _session.Id });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("photoQueue.listen", _ref); } catch (JSDisconnectedException) { }
    }

    // fotokoe.js: one more photo is on the server.
    [JSInvokable]
    public async Task PhotoSent()
    {
        await Count();
        StateHasChanged();
    }

    private async Task Count()
    {
        if (_session is null) return;
        try { (_photos, _scans) = await Capture.CountAsync(_session.Id); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task StartScan()
    {
        _error = null;
        _scanning = true;
        _scanStatus = "Hold stregkoden foran kameraet …";
        StateHasChanged();
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("scanner.start", _ref); }
        catch (Exception ex) { _scanning = false; _error = "Kameraet kunne ikke startes: " + ex.Message; }
    }

    private async Task StopScan()
    {
        if (!_scanning) return;
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        await Count();
    }

    // Called by scanner.js for each code. The same code twice within 4 s = the camera saw it again, not a second copy.
    [JSInvokable]
    public async Task OnBarcode(string raw)
    {
        var code = Barcodes.Clean(raw);
        var again = code == _lastCode && (DateTime.Now - _lastAt).TotalSeconds < 4;
        _lastCode = code; _lastAt = DateTime.Now;
        if (!again && code.Length >= 8 && _session is not null && Me is not null)
        {
            try
            {
                var copies = await Capture.ScanAsync(code, _session.Id, Me);
                _ = JS.InvokeVoidAsync("scanner.beep");
                _scanStatus = copies > 1 ? $"✓ {code} – nu {copies} stk. i sessionen" : $"✓ {code} gemt";
                await Count();
            }
            catch (Exception ex) { _scanStatus = "⚠ " + ex.Message; }
        }
        StateHasChanged();
        if (_scanning)
        {
            await Task.Delay(800);
            try { if (_scanning) await JS.InvokeVoidAsync("scanner.start", _ref); } catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        try { if (_ref is not null) await JS.InvokeVoidAsync("photoQueue.unlisten", _ref); } catch { }
        _ref?.Dispose();
    }
}
