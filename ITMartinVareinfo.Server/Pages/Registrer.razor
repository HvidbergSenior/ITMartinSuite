@page "/"
@page "/registrer"
@inject ReadingUseCases Reg
@inject BoxPhotoUseCases Boxes
@inject LagerLinks Lager
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Box by box, camera only (user 2026-10-15): "Take picture -> storage", "scanning should just beep beep beep. next box",
   "only pictures camera... All the further investigation should be done in the other app". Photos and barcodes are
   only stored here; Læs reads them later into the box on Lager, where everything else happens. *@
<PageTitle>Registrér – Bogshoppen Vareinfo</PageTitle>

@if (_box is null)
{
    <section class="k-card"><p>⏳ Henter kassen fra Lager …</p>@if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }</section>
}
else
{
    <section class="k-card">
        <h1 class="k-card-title">📦 Kasse @_box.Number</h1>
        <p>Skriv <b>NR @_box.Number</b> på kassen. Tag billeder af alt i kassen – eller scan stregkoderne. Det hele <b>gemmes bare</b> i kasse @_box.Number; der læses ikke noget nu.</p>
        <p class="lg-answer" role="status">I kasse @_box.Number: <b>@CurrentPhotos billeder</b> og <b>@CurrentScans stregkoder</b>.</p>
        @if (_error is not null) { <p class="lg-warn" role="alert">⚠ @_error</p> }
        @if (_saved is not null) { <p class="lg-ok" role="status">✓ @_saved</p> }
    </section>

    <section class="k-card">
        <h2 class="k-card-title">📷 Billeder</h2>
        <p>Læg 10-20 ting ud med forsiden op, og tag billedet lige ovenfra. Gentag til kassen er tom.</p>
        <label class="k-btn k-btn-primary lg-big lg-camera @(_busy ? "is-busy" : "")">
            @(_busy ? "⏳ Gemmer billedet …" : "📷 Tag billede")
            <InputFile OnChange="Store" accept="image/*" capture="environment" multiple disabled="@_busy" class="lg-hidden-file" />
        </label>
        <p class="k-small k-muted">Du kan også vælge flere billeder fra telefonen på én gang.</p>
    </section>

    <section class="k-card">
        <h2 class="k-card-title">▮▯▮ Stregkoder</h2>
        <p>Bedst til DVD, Blu-ray, CD, spil og bøger. Hold stregkoden foran kameraet – <b>bip</b> – næste. Samme stregkode igen = ét eksemplar mere.</p>
        @if (!_scanning)
        {
            <button class="k-btn k-btn-secondary lg-big" @onclick="StartScan">▮▯▮ Scan stregkoder</button>
        }
        else
        {
            <div class="lg-scan">
                <video id="scan-video" muted playsinline></video>
                <p class="lg-answer" role="status">@_scanStatus</p>
                <button class="k-btn k-btn-primary" @onclick="StopScan">✓ Færdig med at scanne</button>
            </div>
        }
    </section>

    <section class="k-card">
        <h2 class="k-card-title">Kassen er fuld?</h2>
        @if (!_confirmNew)
        {
            <button class="k-btn k-btn-secondary" @onclick="() => _confirmNew = true" disabled="@_busy">Ny kasse</button>
        }
        else
        {
            <div class="lg-row">
                <button class="k-btn k-btn-primary" @onclick="NewBox" disabled="@_busy">✓ Ja, start kasse @(_box.Number + 1)</button>
                <button class="k-btn k-btn-ghost" @onclick="() => _confirmNew = false">Nej, fortsæt med kasse @_box.Number</button>
            </div>
        }
    </section>

    @if (_boxes.Count > 0)
    {
        <section class="k-card">
            <h2 class="k-card-title">Læs kasserne</h2>
            <p>Tryk <b>Læs</b>, når det passer dig. Billederne læses af AI'en og stregkoderne slås op – i baggrunden, ca. 5 billeder i minuttet. Tingene lægges i kassen på <a href="@Lager.LagerBase">Lager</a>, hvor priser og alt det andet findes. Du kan godt lukke siden imens.</p>
            <ul class="lg-boxes">
                @foreach (var b in _boxes)
                {
                    <li>
                        <b>Kasse @b.Number</b> ·
                        @if (b.Waiting + b.Scans > 0)
                        {
                            <span>@b.Waiting billeder og @b.Scans stregkoder venter@(b.Wanted + b.ScansWanted > 0 ? " (bliver læst nu)" : "")</span>
                        }
                        @if (b.Read > 0 || (b.Waiting + b.Scans == 0)) { <span> · læst – <a href="@Lager.LagerBase/kasse/@b.BoxCode" target="_blank" rel="noopener">se på Lager</a></span> }
                        @if (b.HasUnread) { <button class="k-btn k-btn-sm k-btn-secondary" @onclick="() => WantRead(b.BoxCode)">Læs kasse @b.Number</button> }
                    </li>
                }
            </ul>
            @if (_boxes.Count(b => b.HasUnread) > 1)
            {
                <button class="k-btn k-btn-primary" @onclick="() => WantRead(null)">Læs alle</button>
            }
            <button class="k-btn k-btn-ghost k-btn-sm" @onclick="Refresh">↻ Opdatér</button>
            <p class="k-small k-muted">AI-kald i dag: @_callsToday af @Reg.MaxCallsPerDay (ét pr. billede – stregkoder er gratis).</p>
        </section>
    }
}

@code {
    private LagerBox? _box;
    private List<BoxPhotos> _boxes = [];
    private bool _confirmNew, _busy, _scanning;
    private string? _error, _saved;
    private int _callsToday;
    private string _scanStatus = "";
    private string _lastCode = "";
    private DateTime _lastAt;
    private DotNetObjectReference<Registrer>? _ref;

    private BoxPhotos? Current => _boxes.FirstOrDefault(b => b.BoxCode == _box?.Code);
    private int CurrentPhotos => Current is { } c ? c.Waiting + c.Read : 0;
    private int CurrentScans => Current?.Scans ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try { _box = await Boxes.CurrentBoxAsync(); }
        catch (Exception ex) { _error = "Kunne ikke hente kassen fra Lager: " + ex.Message; }
        await Refresh();
    }

    private async Task Store(InputFileChangeEventArgs e)
    {
        if (_box is null) return;
        _busy = true; _error = null; _saved = null; _confirmNew = false;
        StateHasChanged();
        var stored = 0;
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                await using var s = file.OpenReadStream(30 * 1024 * 1024);
                await Boxes.StoreAsync(s, _box);
                stored++;
            }
            _saved = $"{stored} billede{(stored == 1 ? "" : "r")} gemt i kasse {_box.Number}. Tag det næste.";
        }
        catch (Exception ex) { _error = (stored > 0 ? $"{stored} blev gemt, men: " : "") + ex.Message; }
        finally
        {
            _busy = false;
            await Refresh();
        }
    }

    private async Task NewBox()
    {
        await StopScan();
        _busy = true; _error = null; _saved = null;
        try
        {
            _box = await Boxes.NewBoxAsync();
            _saved = $"Ny kasse: skriv NR {_box.Number} på den.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; _confirmNew = false; await Refresh(); }
    }

    private async Task WantRead(string? code)
    {
        _error = null;
        try
        {
            var n = await Boxes.WantReadAsync(code);
            _saved = $"{n} billeder og stregkoder bliver læst i baggrunden. Tryk ↻ Opdatér for at se hvor langt den er.";
        }
        catch (Exception ex) { _error = ex.Message; }
        await Refresh();
    }

    private async Task Refresh()
    {
        try
        {
            _boxes = await Boxes.BoxesAsync();
            _callsToday = await Reg.CallsTodayAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task StartScan()
    {
        _error = null; _saved = null;
        _scanning = true;
        _scanStatus = "Hold stregkoden foran kameraet …";
        StateHasChanged();
        _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("scanner.start", _ref); }
        catch (Exception ex) { _scanning = false; _error = "Kameraet kunne ikke startes: " + ex.Message; }
    }

    private async Task StopScan()
    {
        if (!_scanning) return;
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        await Refresh();
    }

    // Called by scanner.js for each code. The same code twice within 4 s = the camera saw it again, not a second copy.
    [JSInvokable]
    public async Task OnBarcode(string raw)
    {
        var code = Barcodes.Clean(raw);
        var again = code == _lastCode && (DateTime.Now - _lastAt).TotalSeconds < 4;
        _lastCode = code; _lastAt = DateTime.Now;
        if (!again && code.Length >= 8 && _box is not null)
        {
            try
            {
                var copies = await Boxes.ScanAsync(code, _box);
                _ = JS.InvokeVoidAsync("scanner.beep");
                _scanStatus = copies > 1 ? $"✓ {code} – nu {copies} stk. i kasse {_box.Number}" : $"✓ {code} gemt i kasse {_box.Number}";
            }
            catch (Exception ex) { _scanStatus = "⚠ " + ex.Message; }
        }
        StateHasChanged();
        if (_scanning)
        {
            await Task.Delay(800);
            try { if (_scanning) await JS.InvokeVoidAsync("scanner.start", _ref); } catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _scanning = false;
        try { await JS.InvokeVoidAsync("scanner.stop"); } catch { }
        _ref?.Dispose();
    }
}
