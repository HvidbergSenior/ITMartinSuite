@page "/"
@page "/ny"

<PageTitle>Tag billede</PageTitle>

@* Photo first: the piece is standing in front of you, the person who
   brought it is still talking. Every photo is uploaded by the browser the
   moment it is taken (see tag-billede.js) - nothing here depends on the
   Blazor connection, which is exactly what the phone drops while the camera
   is open. The details form is a plain POST; every field is optional. *@

<div class="top-row">
    <h1>Tag billede</h1>
    <a class="top-link" href="/api/auth/logout">Log ud</a>
</div>

<div class="section-label">1. Billeder af møblet</div>
<div class="camera-block" id="camera">
    <label class="camera-btn" for="cam-input">
        <span class="camera-icon">📷</span>
        <span id="cam-text">Tag billede</span>
    </label>
    <input id="cam-input" class="camera-input" type="file" accept="image/*" capture="environment" />
    <label class="camera-secondary" for="lib-input">Vælg billeder eller video fra telefonen</label>
    <input id="lib-input" class="camera-input" type="file" accept="image/*,video/*" multiple />
    <div id="upload-status" class="chosen-files"></div>
    <div id="upload-thumbs" class="thumb-row"></div>
    <div id="upload-error" class="error-box" hidden></div>
</div>

<form method="post" action="/api/pieces" id="piece-form">
    <input type="hidden" name="pieceId" id="pieceId" />

    <div class="section-label">2. Hvad er det? <span class="muted">(alt er valgfrit)</span></div>
    <div class="field">
        <label>Møbel</label>
        <input type="text" name="title" placeholder="fx Lænestol, grøn" />
    </div>
    <div class="field">
        <label>Type</label>
        <div class="tag-row" id="cat-chips">
            @foreach (var c in FurnitureCategories.All)
            {
                <button type="button" class="tag" data-cat="@c">@c</button>
            }
        </div>
        <input type="text" name="category" id="category" placeholder="eller skriv selv" />
    </div>
    <div class="field-row">
        <div class="field">
            <label>Polstrer</label>
            <input type="text" name="worker" placeholder="Hvem arbejder på det" autocomplete="on" />
        </div>
        <div class="field">
            <label>Kunde</label>
            <input type="text" name="customer" placeholder="Navn" />
        </div>
    </div>
    <div class="field-row">
        <div class="field">
            <label>Stof / materiale</label>
            <input type="text" name="material" placeholder="fx uld, læder, Kvadrat Hallingdal" />
        </div>
        <div class="field">
            <label>Deadline</label>
            <input type="date" name="deadline" />
        </div>
    </div>
    <div class="field">
        <label>Teknikker (adskilt med komma)</label>
        <input type="text" name="techniques" placeholder="fjedre, nakkerulle, kantsyning" />
    </div>

    <div class="section-label">3. Hvad blev der sagt?</div>
    <div class="field">
        <label>Hvem fortalte dig det?</label>
        <input type="text" name="instructedBy" placeholder="fx kunden, Peter" />
    </div>
    <div class="field">
        <label>Besked / instruktion</label>
        <textarea rows="5" name="instructions" placeholder="Nyt betræk i samme stof, behold nakkerullen, fjedrene skal efterses…"></textarea>
    </div>

    <button type="submit" class="btn btn-primary btn-block" id="save-btn">Gem møblet</button>
    <p class="hint" style="text-align:center">Billederne er allerede gemt når de vises herover – Gem tilføjer bare oplysningerne.</p>
</form>

<script src="tag-billede.js?v=@DateTime.UtcNow.Ticks"></script>
