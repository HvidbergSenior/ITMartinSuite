@page "/job/{JobId:guid}"
@inject PolstrerDbContext Db
@inject NasPhotoService NasPhoto
@inject NavigationManager Nav

<div class="page">
    <a class="back-link" href="/">← Alle opgaver</a>

    @if (_job is null)
    {
        <p class="empty">Indlæser...</p>
    }
    else
    {
        <h1>
            @_job.Title
            @if (_job.IsDone) { <span class="badge-done">Færdig</span> }
        </h1>

        <div class="field">
            <label>Instrukser</label>
            <textarea @bind="_job.Instructions" @bind:event="oninput" @onblur="SaveInstructionsAsync"></textarea>
        </div>

        <CameraUpload Slug="@_job.Slug" />

        <a class="gallery-link" href="https://gallery.itmartin.dk" target="_blank">
            📷 Se billeder/videoer på gallery.itmartin.dk<br />
            <span style="font-weight:400;font-size:13px">Vælg "Møbelpolstrer" — kodeord: @GalleryPassword</span>
        </a>

        <button class="btn @(_job.IsDone ? "btn-secondary" : "")" @onclick="ToggleDoneAsync">
            @(_job.IsDone ? "Marker som ikke færdig" : "Marker som færdig")
        </button>
    }
</div>

@code {
    [Parameter] public Guid JobId { get; set; }

    private Job? _job;

    // Mirrors NasPhotoService's own convention - shown so she knows what to
    // type without needing to ask.
    private static string GalleryPassword => $"polstrer{DateTime.UtcNow.Year}";

    protected override async Task OnParametersSetAsync()
    {
        _job = await Db.Jobs.FirstOrDefaultAsync(j => j.Id == JobId);
    }

    private async Task SaveInstructionsAsync()
    {
        if (_job is null) return;
        await Db.SaveChangesAsync();
    }

    private async Task ToggleDoneAsync()
    {
        if (_job is null) return;
        _job.IsDone = !_job.IsDone;
        await Db.SaveChangesAsync();
    }

}
