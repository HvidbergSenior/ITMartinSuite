@page "/"
@inject IDbContextFactory<PolstrerDbContext> DbFactory

<PageTitle>Møbler</PageTitle>

<div class="top-row">
    <h1>Møbler</h1>
    <a class="top-link" href="/api/auth/logout">Log ud</a>
</div>

<div class="filter-row">
    <button class="chip @(_showDone ? "" : "chip-on")" @onclick="() => SetFilter(false)">I arbejde</button>
    <button class="chip @(_showDone ? "chip-on" : "")" @onclick="() => SetFilter(true)">Afleveret</button>
</div>

@if (_pieces is null)
{
    <p class="muted">Henter…</p>
}
else if (_pieces.Count == 0)
{
    <div class="empty">
        <div class="empty-icon">🪑</div>
        @if (_showDone)
        {
            <p>Ingen afleverede møbler endnu.</p>
        }
        else
        {
            <p>Ingen møbler i arbejde.</p>
            <a class="btn btn-primary" href="/ny">📷 Nyt møbel</a>
        }
    </div>
}
else
{
    @foreach (var p in _pieces)
    {
        var cover = p.Steps.SelectMany(s => s.Media).Where(m => !m.IsVideo).OrderBy(m => m.UploadedAt).FirstOrDefault();
        <a class="piece-card @UrgencyClass(p)" href="/moebel/@p.Slug">
            <div class="piece-cover">
                @if (cover is not null)
                {
                    <img src="@MediaStore.Url(cover.ThumbPath ?? cover.RelativePath)" alt="" loading="lazy" />
                }
                else
                {
                    <span>🪑</span>
                }
            </div>
            <div class="piece-body">
                <div class="piece-title">@p.Title</div>
                @if (!string.IsNullOrWhiteSpace(p.Customer))
                {
                    <div class="piece-sub">@p.Customer</div>
                }
                <div class="piece-meta">
                    <span class="status status-@p.Status.ToString().ToLower()">@StatusText(p.Status)</span>
                    @if (p.Deadline is { } d)
                    {
                        <span class="deadline">@DeadlineText(d)</span>
                    }
                </div>
            </div>
        </a>
    }
}

@code {
    private List<Piece>? _pieces;
    private bool _showDone;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetFilter(bool done)
    {
        _showDone = done;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.Pieces.Include(p => p.Steps).ThenInclude(s => s.Media).AsNoTracking();
        q = _showDone
            ? q.Where(p => p.Status == PieceStatus.Afleveret)
            : q.Where(p => p.Status != PieceStatus.Afleveret);
        var list = await q.ToListAsync();
        _pieces = _showDone
            ? list.OrderByDescending(p => p.ReceivedAt).ToList()
            : list.OrderBy(p => p.Deadline ?? DateOnly.MaxValue).ThenBy(p => p.ReceivedAt).ToList();
    }

    public static string StatusText(PieceStatus s) => s switch
    {
        PieceStatus.Modtaget => "Modtaget",
        PieceStatus.IGang => "I gang",
        PieceStatus.Faerdig => "Færdig",
        PieceStatus.Afleveret => "Afleveret",
        _ => s.ToString()
    };

    public static string DeadlineText(DateOnly d)
    {
        var days = d.DayNumber - DateOnly.FromDateTime(DateTime.Now).DayNumber;
        if (days < 0) return $"Overskredet {-days} dg";
        if (days == 0) return "I dag";
        if (days == 1) return "I morgen";
        return $"{days} dage – {d:d. MMM}";
    }

    private static string UrgencyClass(Piece p)
    {
        if (p.Status >= PieceStatus.Faerdig || p.Deadline is null) return "";
        var days = p.Deadline.Value.DayNumber - DateOnly.FromDateTime(DateTime.Now).DayNumber;
        return days < 0 ? "urgent-over" : days <= 3 ? "urgent-soon" : "";
    }
}
