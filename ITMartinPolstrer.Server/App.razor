<!DOCTYPE html>
<html lang="da" data-family="hukommelse" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Møbelpolstrer</title>
    <base href="/" />
    <link rel="stylesheet" href="_content/ITMartin.Shared.UI/css/kolibri.css?v=@CacheBuster" />
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/_content/ITMartin.Shared.UI/kolibri-icon.svg" />
    <meta name="theme-color" content="#121917" />
    <script>
        // Theme choice lives in the phone's localStorage; applied before first paint to avoid a flash.
        (function () {
            try { var t = localStorage.getItem("polstrer-theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t); } catch (e) { }
        })();
        window.polstrerToggleTheme = function () {
            var h = document.documentElement, next = h.getAttribute("data-theme") === "dark" ? "light" : "dark";
            h.setAttribute("data-theme", next);
            try { localStorage.setItem("polstrer-theme", next); } catch (e) { }
            var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute("content", next === "dark" ? "#121917" : "#f4f6f5");
        };
    </script>
</head>
<body>
    <Routes />
    <script src="_framework/blazor.server.js"></script>
    <script>if("serviceWorker" in navigator){navigator.serviceWorker.register("/kolibri-sw.js").catch(function(){});}</script>
    <div id="components-reconnect-modal">
        <span class="reconnect-msg">Forbinder igen...</span>
        <span class="reconnect-failed-msg">Forbindelsen er tabt — <button onclick="location.reload()">Genindlæs</button></span>
    </div>
</body>
</html>

@code {
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
