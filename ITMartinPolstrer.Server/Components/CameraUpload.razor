@* One big camera button (rear camera, straight to capture) plus a quieter
   "pick from the phone" button that also allows video and several files at
   once. The component just hands the chosen files to its parent - what
   happens to them (new piece, new step) is the page's business. *@

<div class="camera-block">
    <label class="camera-btn @(Busy ? "camera-busy" : "")" for="@_cameraId">
        @if (Busy)
        {
            <span>@BusyText</span>
        }
        else
        {
            <span class="camera-icon">📷</span>
            <span>@Text</span>
        }
    </label>
    <InputFile id="@_cameraId" class="camera-input" OnChange="OnFiles" accept="image/*" capture="environment" disabled="@Busy" />

    <label class="camera-secondary" for="@_libraryId">Vælg billeder eller video fra telefonen</label>
    <InputFile id="@_libraryId" class="camera-input" OnChange="OnFiles" accept="image/*,video/*" multiple disabled="@Busy" />
</div>

@code {
    [Parameter] public string Text { get; set; } = "Tag billede";
    [Parameter] public string BusyText { get; set; } = "Gemmer…";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> FilesChosen { get; set; }

    private readonly string _cameraId = "cam-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _libraryId = "lib-" + Guid.NewGuid().ToString("N")[..8];

    private Task OnFiles(InputFileChangeEventArgs e)
        => FilesChosen.InvokeAsync(e.GetMultipleFiles(maximumFileCount: 30));
}
