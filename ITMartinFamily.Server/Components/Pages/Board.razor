@page "/{slug}/opgaver"
@rendermode InteractiveServer

@using ITMartinFamily.Application.Interfaces
@using ITMartinFamily.Domain.Entities
@using ITMartinFamily.Infrastructure
@using ITMartinFamily.Server.Components
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject IDailyTaskRepository TaskRepo
@inject FamilyDbContext Db
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ITMartinFamily.Application.Interfaces.IPushNotificationService PushService

@implements IAsyncDisposable

<PageTitle>@(_family?.Name ?? "Gruppen") · Opgaver</PageTitle>

<link rel="stylesheet" href="css/family.css?v=12" />

@if (!_ready)
{
    <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;color:#64748b">Indlæser...</div>
}
else
{
    <div class="family-page">

        <div class="family-header">
            <div>
                <h1 class="family-title">Opgaver</h1>
                <div class="family-subtitle">@(_family?.Name) · Hej @_myName</div>
            </div>
            <div style="display:flex;gap:8px;align-items:center">
                <button class="add-btn" @onclick="ToggleAdd">@(_showAdd ? "✕ Annuller" : "+ Ny opgave")</button>
                <button class="logout-btn" @onclick="Logout">Log ud</button>
            </div>
        </div>

        @if (_showAdd)
        {
            <div class="add-panel">
                <input class="task-input" @bind="_newNote" placeholder="Hvad skal gøres?" />
                <select class="task-input" @bind="_newAssignedTo">
                    <option value="">— ingen tildeling —</option>
                    @foreach (var m in _members)
                    {
                        <option value="@m.Name">@m.Name</option>
                    }
                </select>
                <button class="submit-btn" @onclick="AddTask" disabled="@(string.IsNullOrWhiteSpace(_newNote) || _adding)">
                    @(_adding ? "Tilføjer..." : "Tilføj opgave")
                </button>
            </div>
        }

        <div class="today-tasks-header">
            <div class="today-tasks-title">Åbne opgaver</div>
        </div>

        @if (_open.Count == 0)
        {
            <div class="empty-state">
                <div style="font-size:56px;">✅</div>
                <div>Ingen åbne opgaver!</div>
            </div>
        }
        else
        {
            <div class="item-list">
                @foreach (var task in _open)
                {
                    <div class="today-task-card @(task.AssignedTo == _myName ? "today-task-mine" : "")" @key="task.Id">
                        <div class="today-task-body">
                            <div class="today-task-note">@task.Note</div>
                            @if (string.IsNullOrWhiteSpace(task.AssignedTo))
                            {
                                <div class="today-task-badge open-badge">⚡ Ingen har taget den</div>
                            }
                            else
                            {
                                <div class="today-task-badge claimed-badge">✋ @task.AssignedTo klarer det</div>
                            }
                            <div class="task-meta">Tilføjet af @task.CreatedBy</div>
                            <div style="display:flex;gap:8px">
                                @if (task.AssignedTo == _myName)
                                {
                                    <button class="today-action-btn done-btn" @onclick="() => MarkDone(task)">Markér færdig ✓</button>
                                }
                                else
                                {
                                    <button class="today-action-btn claim-btn" @onclick="() => ClaimTask(task)">Jeg tager den</button>
                                }
                                <button class="delete-btn" @onclick="() => DeleteTask(task)">✕</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_done.Count > 0)
        {
            <div class="today-tasks-header" style="margin-top:24px">
                <div class="today-tasks-title">Udførte opgaver</div>
            </div>
            <div class="item-list">
                @foreach (var task in _done)
                {
                    <div class="today-task-card today-task-done" @key="task.Id">
                        <div class="today-task-body">
                            <div class="today-task-note">@task.Note</div>
                            <div class="today-task-badge done-badge">✅ Færdig af @task.CompletedBy</div>
                            <button class="delete-btn" @onclick="() => DeleteTask(task)">✕</button>
                        </div>
                    </div>
                }
            </div>
        }

        <BottomNav Slug="@Slug" Active="opgaver" />

    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Family? _family;
    private FamilyMember? _member;
    private string _myName = "";
    private List<DailyTask> _tasks = [];
    private List<DailyTask> _open => _tasks.Where(t => !t.CompletedAt.HasValue)
        .OrderBy(t => string.IsNullOrEmpty(t.AssignedTo) ? 0 : 1)
        .ThenBy(t => t.CreatedAt)
        .ToList();
    private List<DailyTask> _done => _tasks.Where(t => t.CompletedAt.HasValue)
        .OrderByDescending(t => t.CompletedAt)
        .Take(20)
        .ToList();
    private List<FamilyMember> _members = [];
    private bool _ready;
    private bool _showAdd;
    private bool _adding;
    private string _newNote = "";
    private string _newAssignedTo = "";
    private HubConnection? _hub;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var sessionStr = await JS.InvokeAsync<string?>("familyApp.getSession", Slug);
        if (string.IsNullOrEmpty(sessionStr) || !Guid.TryParse(sessionStr, out var sessionId))
        { Navigation.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

        var session = await Db.Sessions.FirstOrDefaultAsync(s => s.Id == sessionId);
        if (session == null) { Navigation.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

        _member = await Db.Members.FindAsync(session.MemberId);
        if (_member == null) { Navigation.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

        _family = await Db.Families.FindAsync(_member.FamilyId);
        if (_family?.Slug != Slug) { Navigation.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

        _myName  = _member.Name;
        _tasks   = await TaskRepo.GetAllAsync(_family.Id);
        _members = await Db.Members.Where(m => m.FamilyId == _family.Id).OrderBy(m => m.Name).ToListAsync();
        _ready   = true;

        var hubUrl = Environment.GetEnvironmentVariable("ASPNETCORE_URLS")
            ?.Split(';').FirstOrDefault()
            ?.Replace("+", "localhost")
            ?.Replace("*", "localhost")
            ?? "http://localhost:8080";

        _hub = new HubConnectionBuilder()
            .WithUrl(hubUrl + "/hubs/family")
            .WithAutomaticReconnect()
            .Build();

        _hub.On<DailyTask>("TaskAdded", task => { _tasks.Add(task); InvokeAsync(StateHasChanged); });
        _hub.On<Guid, string>("TaskAssigned", (id, by) =>
        {
            var t = _tasks.FirstOrDefault(x => x.Id == id);
            if (t is not null) t.AssignedTo = by;
            InvokeAsync(StateHasChanged);
        });
        _hub.On<Guid, string>("TaskCompleted", (id, by) =>
        {
            var t = _tasks.FirstOrDefault(x => x.Id == id);
            if (t is not null) { t.CompletedAt = DateTime.UtcNow; t.CompletedBy = by; }
            InvokeAsync(StateHasChanged);
        });
        _hub.On<Guid>("TaskDeleted", id =>
        {
            _tasks.RemoveAll(x => x.Id == id);
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hub.StartAsync();
            await _hub.SendAsync("JoinFamily", Slug);
        }
        catch { }

        StateHasChanged();
        await SetupPushAsync();
    }

    private async Task SetupPushAsync()
    {
        try
        {
            var permission = await JS.InvokeAsync<string>("familyApp.requestPushPermission");
            if (permission != "granted") return;
            var publicKey = PushService.GetPublicKey();
            await JS.InvokeVoidAsync("familyApp.subscribeForPush", publicKey, _family!.Id, _myName);
        }
        catch { }
    }

    private void ToggleAdd()
    {
        _showAdd = !_showAdd;
        if (!_showAdd) { _newNote = ""; _newAssignedTo = ""; }
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(_newNote) || _family is null) return;

        _adding = true;
        StateHasChanged();

        var task = new DailyTask
        {
            FamilyId   = _family.Id,
            Note       = _newNote.Trim(),
            CreatedBy  = _myName,
            AssignedTo = string.IsNullOrWhiteSpace(_newAssignedTo) ? null : _newAssignedTo
        };

        await TaskRepo.AddAsync(task);
        _tasks.Add(task);

        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("TaskAdded", Slug, task);

        _ = PushService.SendToFamilyAsync(_family!.Id, _myName, "📋 Ny opgave", $"{_myName}: {task.Note}");

        _newNote = "";
        _newAssignedTo = "";
        _showAdd = false;
        _adding = false;
        StateHasChanged();
    }

    private async Task ClaimTask(DailyTask task)
    {
        task.AssignedTo = _myName;
        await TaskRepo.UpdateAsync(task);
        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("TaskAssigned", Slug, task.Id, _myName);
        if (task.CreatedBy != _myName)
            _ = PushService.SendToMemberAsync(_family!.Id, task.CreatedBy, "✋ Opgave taget", $"{_myName} klarer: {task.Note}");
        StateHasChanged();
    }

    private async Task MarkDone(DailyTask task)
    {
        task.CompletedAt = DateTime.UtcNow;
        task.CompletedBy = _myName;
        await TaskRepo.UpdateAsync(task);
        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("TaskCompleted", Slug, task.Id, _myName);
        if (task.CreatedBy != _myName)
            _ = PushService.SendToMemberAsync(_family!.Id, task.CreatedBy, "✅ Opgave færdig", $"{_myName} er færdig: {task.Note}");
        StateHasChanged();
    }

    private async Task DeleteTask(DailyTask task)
    {
        _tasks.Remove(task);
        await TaskRepo.DeleteAsync(task.Id);
        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("TaskDeleted", Slug, task.Id);
        StateHasChanged();
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("familyApp.clearSession", Slug);
        Navigation.NavigateTo($"/{Slug}/join", forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
