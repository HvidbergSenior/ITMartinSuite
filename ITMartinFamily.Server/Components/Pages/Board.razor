@page "/{slug}/opgaver"
@rendermode InteractiveServer

@using ITMartinFamily.Application.Interfaces
@using ITMartinFamily.Domain.Entities
@using ITMartinFamily.Infrastructure
@using ITMartinFamily.Server.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject IDailyTaskRepository TaskRepo
@inject FamilyDbContext Db
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ITMartinFamily.Application.Interfaces.IPushNotificationService PushService
@inject ToastService Toast

@implements IAsyncDisposable

<PageTitle>@(_family?.Name ?? "Gruppen")</PageTitle>

<link rel="stylesheet" href="css/family.css?v=6" />

@if (!_ready)
{
    <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;color:#64748b">Indlæser...</div>
}
else
{
    <div class="family-page">

        <div class="family-header">
            <div>
                <h1 class="family-title">@(_family?.Name ?? "Gruppen")</h1>
                <div class="family-subtitle">@DateTime.Today.ToString("dddd d. MMMM") · Hej @_myName</div>
            </div>
            <div style="display:flex;gap:8px;align-items:center">
                <button class="add-btn" @onclick="ToggleAdd">@(_showAdd ? "✕ Annuller" : "+ Tilføj opgave")</button>
                <button class="logout-btn" @onclick="Logout">Log ud</button>
            </div>
        </div>

        @if (_showAdd)
        {
            <div class="add-panel">
                <input class="task-input" @bind="_newNote" placeholder="Hvad skal gøres?" />

                @if (!_cameraOpen)
                {
                    <button class="cam-btn" @onclick="OpenCamera">📷 Tag foto</button>
                }
                else
                {
                    <div style="position:relative;">
                        <video id="task-video" autoplay muted playsinline webkit-playsinline
                               style="width:100%;border-radius:12px;"></video>
                        <button class="capture-btn" @onclick="CapturePhoto">Tag billede</button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_previewImage))
                {
                    <img src="data:image/jpeg;base64,@_previewImage" class="preview-img" />
                }

                <button class="submit-btn" @onclick="AddTask" disabled="@_adding">
                    @(_adding ? "Tilføjer..." : "Tilføj opgave")
                </button>
            </div>
        }

        @if (!_tasks.Any())
        {
            <div class="empty-state">
                <div style="font-size:56px;">✅</div>
                <div>Ingen opgaver i dag!</div>
            </div>
        }
        else
        {
            <div class="task-grid">
                @foreach (var task in _tasks.OrderBy(t => t.CompletedAt.HasValue).ThenBy(t => t.CreatedAt))
                {
                    <div class="task-card @(task.CompletedAt.HasValue ? "task-done" : "") @(task.ClaimedBy == _myName && task.CompletedAt is null ? "task-mine" : "")">

                        @if (!string.IsNullOrWhiteSpace(task.ImagePath) && File.Exists(task.ImagePath))
                        {
                            <img src="/task-image/@task.Id" class="task-img" />
                        }

                        <div class="task-body">
                            @if (!string.IsNullOrWhiteSpace(task.Note))
                            {
                                <div class="task-note">@task.Note</div>
                            }
                            <div class="task-meta">Tilføjet af @task.CreatedBy</div>

                            @if (task.CompletedAt.HasValue)
                            {
                                <div class="task-status done">✅ Færdig af @task.ClaimedBy</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(task.ClaimedBy))
                            {
                                <div class="task-status claimed">@task.ClaimedBy klarer det</div>
                                @if (task.ClaimedBy == _myName)
                                {
                                    <button class="action-btn done-btn" @onclick="() => MarkDone(task)">Markér færdig ✓</button>
                                    <button class="action-btn postpone-btn" @onclick="() => TryPostpone(task)">↷ Gør det i morgen</button>
                                }
                            }
                            else
                            {
                                <button class="action-btn claim-btn" @onclick="() => ClaimTask(task)">Jeg tager den</button>
                            }
                        </div>

                        @if (task.CreatedBy == _myName && task.CompletedAt is null)
                        {
                            <button class="delete-btn" @onclick="() => DeleteTask(task)">✕</button>
                        }

                    </div>
                }
            </div>
        }

        <BottomNav Slug="@Slug" Active="opgaver" />

    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Family? _family;
    private FamilyMember? _member;
    private string _myName = "";
    private List<DailyTask> _tasks = [];
    private bool _ready;
    private bool _showAdd;
    private bool _cameraOpen;
    private bool _adding;
    private string _newNote = "";
    private string? _previewImage;
    private HubConnection? _hub;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var sessionStr = await JS.InvokeAsync<string?>("familyApp.getSession", Slug);
        if (string.IsNullOrEmpty(sessionStr) || !Guid.TryParse(sessionStr, out var sessionId))
        { Navigation.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

        var session = await Db.Sessions.FirstOrDefaultAsync(s => s.Id == sessionId);
        if (session == null) { Navigation.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

        _member = await Db.Members.FindAsync(session.MemberId);
        if (_member == null) { Navigation.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

        _family = await Db.Families.FindAsync(_member.FamilyId);
        if (_family?.Slug != Slug) { Navigation.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

        _myName = _member.Name;
        _tasks  = await TaskRepo.GetTodayAsync(_family.Id);
        _ready  = true;

        var hubUrl = Environment.GetEnvironmentVariable("ASPNETCORE_URLS")
            ?.Split(';').FirstOrDefault()
            ?.Replace("+", "localhost")
            ?.Replace("*", "localhost")
            ?? "http://localhost:8080";

        _hub = new HubConnectionBuilder()
            .WithUrl(hubUrl + "/hubs/family")
            .WithAutomaticReconnect()
            .Build();

        _hub.On<DailyTask>("TaskAdded", task => { _tasks.Add(task); InvokeAsync(StateHasChanged); });
        _hub.On<Guid, string>("TaskClaimed", (id, by) =>
        {
            var t = _tasks.FirstOrDefault(x => x.Id == id);
            if (t is not null) { t.ClaimedBy = by; t.ClaimedAt = DateTime.UtcNow; }
            InvokeAsync(StateHasChanged);
        });
        _hub.On<Guid>("TaskCompleted", id =>
        {
            var t = _tasks.FirstOrDefault(x => x.Id == id);
            if (t is not null) t.CompletedAt = DateTime.UtcNow;
            InvokeAsync(StateHasChanged);
        });
        _hub.On<Guid>("TaskDeleted", id =>
        {
            _tasks.RemoveAll(x => x.Id == id);
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hub.StartAsync();
            await _hub.SendAsync("JoinFamily", Slug);
        }
        catch { }

        StateHasChanged();
        await SetupPushAsync();
    }

    private async Task SetupPushAsync()
    {
        try
        {
            var permission = await JS.InvokeAsync<string>("familyApp.requestPushPermission");
            if (permission != "granted") return;
            var publicKey = PushService.GetPublicKey();
            await JS.InvokeVoidAsync("familyApp.subscribeForPush", publicKey, _family!.Id, _myName);
        }
        catch { }
    }

    private void ToggleAdd()
    {
        _showAdd = !_showAdd;
        if (!_showAdd) { _cameraOpen = false; _previewImage = null; _newNote = ""; }
    }

    private async Task OpenCamera()
    {
        _cameraOpen = true;
        StateHasChanged();
        await JS.InvokeVoidAsync("familyApp.startCamera", "task-video");
    }

    private async Task CapturePhoto()
    {
        try
        {
            _previewImage = await JS.InvokeAsync<string>("familyApp.capturePhoto");
            await JS.InvokeVoidAsync("familyApp.stopCamera", "task-video");
            _cameraOpen = false;
        }
        catch
        {
            _previewImage = null;
            _cameraOpen = false;
        }
        StateHasChanged();
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(_newNote) && _previewImage is null) return;
        if (_family is null) return;

        _adding = true;
        StateHasChanged();

        string? imagePath = null;
        if (_previewImage is not null)
        {
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "tasks");
            Directory.CreateDirectory(folder);
            imagePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(imagePath, Convert.FromBase64String(_previewImage));
        }

        var task = new DailyTask
        {
            FamilyId  = _family.Id,
            Note      = _newNote.Trim(),
            ImagePath = imagePath,
            CreatedBy = _myName,
            Date      = DateOnly.FromDateTime(DateTime.Today)
        };

        await TaskRepo.AddAsync(task);
        _tasks.Add(task);

        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("TaskAdded", Slug, task);

        _ = PushService.SendToFamilyAsync(_family!.Id, _myName, "📋 Ny opgave", $"{_myName}: {task.Note}");

        _newNote = "";
        _previewImage = null;
        _showAdd = false;
        _adding = false;
        StateHasChanged();
    }

    private async Task ClaimTask(DailyTask task)
    {
        task.ClaimedBy = _myName;
        task.ClaimedAt = DateTime.UtcNow;
        await TaskRepo.UpdateAsync(task);
        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("TaskClaimed", Slug, task.Id, _myName);
        if (task.CreatedBy != _myName)
            _ = PushService.SendToMemberAsync(_family!.Id, task.CreatedBy, "✋ Opgave taget", $"{_myName} klarer: {task.Note}");
        StateHasChanged();
    }

    private async Task MarkDone(DailyTask task)
    {
        task.CompletedAt = DateTime.UtcNow;
        await TaskRepo.UpdateAsync(task);
        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("TaskCompleted", Slug, task.Id);
        if (task.CreatedBy != _myName)
            _ = PushService.SendToMemberAsync(_family!.Id, task.CreatedBy, "✅ Opgave færdig", $"{_myName} er færdig: {task.Note}");
        StateHasChanged();
    }

    private void TryPostpone(DailyTask task)
    {
        var messages = new[]
        {
            $"🙅 Nej, {_myName}! Opgaverne er til I DAG. Klar det nu – eller giv det videre til en anden.",
            $"⚠️ 'I morgen' er ikke en mulighed! Du tog ansvaret – følg det.",
            $"🚫 Ingen udsættelse! Enten gør {_myName} det nu, eller giver det til en anden.",
            $"😤 Du satte dit navn på det! Klar det – eller giv det til nogen der KAN."
        };
        Toast.Show(messages[Math.Abs(task.Id.GetHashCode()) % messages.Length], "warn", 5000);
    }

    private async Task DeleteTask(DailyTask task)
    {
        _tasks.Remove(task);
        await TaskRepo.DeleteAsync(task.Id);
        if (_hub?.State == HubConnectionState.Connected)
            await _hub.SendAsync("TaskDeleted", Slug, task.Id);
        StateHasChanged();
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("familyApp.clearSession", Slug);
        Navigation.NavigateTo($"/{Slug}/join", forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
