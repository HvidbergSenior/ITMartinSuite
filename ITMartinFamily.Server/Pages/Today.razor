@page "/{slug}"
@rendermode InteractiveServer

@using ITMartinFamily.Application.Interfaces
@using ITMartinFamily.Domain.Entities
@using ITMartinFamily.Infrastructure
@using ITMartinFamily.Server.Components
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Globalization

@inject IDailyTaskRepository        TaskRepo
@inject IPersonalReminderRepository ReminderRepo
@inject IFamilyStoredItemRepository StoredItemRepo
@inject FamilyDbContext              Db
@inject NavigationManager            Nav
@inject IJSRuntime                   JS

@implements IAsyncDisposable

<PageTitle>I dag</PageTitle>

<link rel="stylesheet" href="css/family.css?v=5" />

@if (!_ready)
{
    <div class="page-loading">Indlæser...</div>
}
else
{
    <div class="family-page">

        <div class="today-header">
            <div>
                <div class="today-date">@DateTime.Today.ToString("dddd d. MMMM", new CultureInfo("da-DK"))</div>
                <div class="today-greeting">Hej @_myName 👋</div>
            </div>
            <button class="logout-btn" @onclick="Logout">Log ud</button>
        </div>

        <!-- ── Tasks ───────────────────────────────── -->
        <div class="today-card">
            <div class="today-card-header">
                <span class="today-card-title">📋 Opgaver i dag</span>
                <a href="/@Slug/opgaver" class="section-add-link">Tilføj opgave</a>
            </div>
            <div class="today-card-body">
                @if (_tasks.Count == 0)
                {
                    <div class="section-empty">Ingen opgaver i dag ✓</div>
                }
                else
                {
                    @foreach (var task in _tasks.ToList()
                        .OrderBy(t => t.CompletedAt.HasValue)
                        .ThenBy(t => t.ClaimedBy is null ? 0 : 1)
                        .ThenBy(t => t.CreatedAt))
                    {
                        <div class="today-task-card @(task.CompletedAt.HasValue ? "today-task-done" : "") @(task.ClaimedBy == _myName && !task.CompletedAt.HasValue ? "today-task-mine" : "")">
                            @if (!string.IsNullOrWhiteSpace(task.ImagePath) && File.Exists(task.ImagePath))
                            {
                                <img src="/task-image/@task.Id" class="today-task-img" />
                            }
                            <div class="today-task-body">
                                <div class="today-task-note">@task.Note</div>
                                @if (task.CompletedAt.HasValue)
                                {
                                    <div class="today-task-badge done-badge">✅ Færdig af @task.ClaimedBy</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(task.ClaimedBy))
                                {
                                    <div class="today-task-badge claimed-badge">✋ @task.ClaimedBy klarer det</div>
                                    @if (task.ClaimedBy == _myName)
                                    {
                                        <button class="today-action-btn done-btn" @onclick="() => MarkDoneAsync(task)">Markér færdig</button>
                                    }
                                }
                                else
                                {
                                    <div class="today-task-badge open-badge">⚡ Ingen har taget den</div>
                                    <button class="today-action-btn claim-btn" @onclick="() => ClaimAsync(task)">Jeg tager den</button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ── Urgent notes / Husk i dag ──────────── -->
        <div class="today-card">
            <div class="today-card-header">
                <span class="today-card-title">⚡ Husk i dag</span>
            </div>
            <div class="today-card-body">

                @if (_urgentCamera)
                {
                    <div class="camera-wrap">
                        <video id="urgent-video" autoplay muted playsinline class="camera-video"></video>
                        <div class="camera-actions">
                            <button class="btn-capture" @onclick="CaptureUrgentPhotoAsync">📸 Tag billede</button>
                            <button class="btn-cancel"  @onclick="CloseUrgentCameraAsync">Annuller</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="add-row">
                        <button class="btn-camera" @onclick="OpenUrgentCameraAsync" title="Tag et billede som påmindelse">📷</button>
                        <input class="add-input" @bind="_urgentText" @bind:event="oninput"
                               placeholder="Hvad skal du huske?" @onkeydown="OnUrgentKey" />
                        <button class="btn-primary-sm" @onclick="AddUrgentAsync"
                                disabled="@(string.IsNullOrWhiteSpace(_urgentText) && string.IsNullOrEmpty(_urgentPreview))">
                            Tilføj
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(_urgentPreview))
                    {
                        <div class="photo-preview-row">
                            <img src="data:image/jpeg;base64,@_urgentPreview" class="preview-thumb" />
                            <span class="preview-label">Billede tilføjes</span>
                            <button class="btn-remove-photo" @onclick="() => _urgentPreview = string.Empty">Fjern</button>
                        </div>
                    }

                    @if (_showTimeInput)
                    {
                        <div class="time-row">
                            <span class="time-label">⏰ Påmind mig kl.</span>
                            <input class="time-input" type="time" value="@_urgentTimeStr"
                                   @oninput="e => _urgentTimeStr = e.Value?.ToString() ?? string.Empty" />
                            <button class="btn-text" @onclick="() => { _showTimeInput = false; _urgentTimeStr = string.Empty; }">Fjern</button>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_urgentText) || !string.IsNullOrEmpty(_urgentPreview))
                    {
                        <button class="btn-text-sm" @onclick="() => _showTimeInput = true">
                            ⏰ Tilføj påmindelsestidspunkt
                        </button>
                    }
                }

                @{
                    var activeReminders = _reminders.Where(r => !r.Done).OrderBy(r => r.RemindAt ?? DateTime.MaxValue).ThenBy(r => r.CreatedAt).ToList();
                }
                @if (activeReminders.Count > 0)
                {
                    <div class="reminder-list">
                        @foreach (var r in activeReminders)
                        {
                            <div class="reminder-item" @key="r.Id">
                                @if (r.PhotoPath is not null && File.Exists(r.PhotoPath))
                                {
                                    <img src="/reminder-photo/@r.Id" class="reminder-photo" />
                                }
                                <div class="reminder-content">
                                    @if (!string.IsNullOrWhiteSpace(r.Text))
                                    {
                                        <div class="reminder-text">@r.Text</div>
                                    }
                                    @if (r.RemindAt.HasValue)
                                    {
                                        <div class="reminder-time">⏰ @r.RemindAt.Value.ToLocalTime().ToString("HH:mm")</div>
                                    }
                                </div>
                                <button class="btn-done" @onclick="() => DismissReminderAsync(r)">Klaret</button>
                            </div>
                        }
                    </div>
                }
                else if (!_urgentCamera)
                {
                    <div class="section-empty">Intet ekstra at huske</div>
                }
            </div>
        </div>

        <!-- ── Mini FindIt ─────────────────────────── -->
        <div class="today-card">
            <div class="today-card-header">
                <span class="today-card-title">📍 Hvad har du lagt fra dig?</span>
            </div>
            <div class="today-card-body">

                @if (_findItCamera)
                {
                    <div class="camera-wrap">
                        <video id="findit-video" autoplay muted playsinline class="camera-video"></video>
                        <div class="camera-actions">
                            <button class="btn-capture" @onclick="CaptureFindItPhotoAsync">📸 Tag billede</button>
                            <button class="btn-cancel"  @onclick="CloseFindItCameraAsync">Annuller</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="findit-form">
                        @if (!string.IsNullOrEmpty(_findItPreview))
                        {
                            <div class="photo-preview-row">
                                <img src="data:image/jpeg;base64,@_findItPreview" class="preview-thumb" />
                                <span class="preview-label">Billede tilføjes</span>
                                <button class="btn-remove-photo" @onclick="() => _findItPreview = string.Empty">Fjern</button>
                            </div>
                        }
                        <div class="add-row">
                            <button class="btn-camera" @onclick="OpenFindItCameraAsync" title="Tag et billede af genstanden">📷</button>
                            <input class="add-input" @bind="_findItName" @bind:event="oninput"
                                   placeholder="Hvad? (nøgler, pung...)" @onkeydown="OnFindItKey" />
                        </div>
                        <input class="add-input-full" @bind="_findItLoc" @bind:event="oninput"
                               placeholder="Hvor? (skuffen, sofaen...)" @onkeydown="OnFindItKey" />
                        <button class="btn-primary" @onclick="SaveFindItAsync"
                                disabled="@(string.IsNullOrWhiteSpace(_findItName) || string.IsNullOrWhiteSpace(_findItLoc))">
                            Gem
                        </button>
                    </div>

                    @if (_storedItems.Count > 0)
                    {
                        <div class="findit-list">
                            @foreach (var item in _storedItems.Take(5))
                            {
                                <div class="findit-mini-card" @key="item.Id">
                                    @if (item.PhotoPath is not null && File.Exists(item.PhotoPath))
                                    {
                                        <img class="findit-mini-thumb" src="/findit-photo/@item.Id" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="findit-mini-icon">📦</div>
                                    }
                                    <div class="findit-mini-body">
                                        <div class="findit-mini-name">@item.Name</div>
                                        <div class="findit-mini-loc">📍 @item.Location</div>
                                    </div>
                                    <button class="btn-found" @onclick="() => FoundItAsync(item)">Har det</button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="section-empty">Intet registreret</div>
                    }
                }
            </div>
        </div>

    </div>

    <BottomNav Slug="@Slug" Active="today" />
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Family?  _family;
    private Guid     _familyId;
    private string   _myName = "";
    private bool     _ready;

    private List<DailyTask>        _tasks       = [];
    private List<PersonalReminder> _reminders   = [];
    private List<FamilyStoredItem> _storedItems = [];

    // Urgent
    private string _urgentText    = "";
    private string _urgentTimeStr = "";
    private bool   _showTimeInput = false;
    private bool   _urgentCamera  = false;
    private string _urgentPreview = "";

    // FindIt
    private string _findItName    = "";
    private string _findItLoc     = "";
    private bool   _findItCamera  = false;
    private string _findItPreview = "";

    private HubConnection? _hub;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Session validation — redirect to join only if session is missing/invalid
        try
        {
            var sessionStr = await JS.InvokeAsync<string?>("familyApp.getSession", Slug);
            if (string.IsNullOrEmpty(sessionStr) || !Guid.TryParse(sessionStr, out var sessionId))
            { Nav.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

            var session = await Db.Sessions.FirstOrDefaultAsync(s => s.Id == sessionId);
            if (session is null) { Nav.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

            var member = await Db.Members.FindAsync(session.MemberId);
            if (member is null) { Nav.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

            _family = await Db.Families.FindAsync(member.FamilyId);
            if (_family?.Slug != Slug) { Nav.NavigateTo($"/{Slug}/join", forceLoad: true); return; }

            _familyId = _family.Id;
            _myName   = member.Name;
        }
        catch
        {
            Nav.NavigateTo($"/{Slug}/join", forceLoad: true);
            return;
        }

        // Load data — on error show empty lists, don't redirect
        try { _tasks       = await TaskRepo.GetTodayAsync(_familyId); } catch { _tasks = []; }
        try { _reminders   = await ReminderRepo.GetTodayAsync(_familyId, _myName); } catch { _reminders = []; }
        try { _storedItems = await StoredItemRepo.GetRecentAsync(_familyId, 20); } catch { _storedItems = []; }

        _ready = true;

        // Hub setup — fire and forget, don't let failures affect the page
        try
        {
            var hubUrl = Environment.GetEnvironmentVariable("ASPNETCORE_URLS")
                ?.Split(';').FirstOrDefault()
                ?.Replace("+", "localhost")
                ?.Replace("*", "localhost")
                ?? "http://localhost:8080";

            _hub = new HubConnectionBuilder()
                .WithUrl(hubUrl + "/hubs/family")
                .WithAutomaticReconnect()
                .Build();

            _hub.On<DailyTask>("TaskAdded",     t    => { _tasks.Add(t); InvokeAsync(StateHasChanged); });
            _hub.On<Guid, string>("TaskClaimed", (id, by) =>
            {
                var t = _tasks.FirstOrDefault(x => x.Id == id);
                if (t is not null) { t.ClaimedBy = by; t.ClaimedAt = DateTime.UtcNow; }
                InvokeAsync(StateHasChanged);
            });
            _hub.On<Guid>("TaskCompleted", id =>
            {
                var t = _tasks.FirstOrDefault(x => x.Id == id);
                if (t is not null) t.CompletedAt = DateTime.UtcNow;
                InvokeAsync(StateHasChanged);
            });
            _hub.On<Guid>("TaskDeleted", id =>
            {
                _tasks.RemoveAll(x => x.Id == id);
                InvokeAsync(StateHasChanged);
            });

            await _hub.StartAsync();
            await _hub.SendAsync("JoinFamily", Slug);
        }
        catch { }

        StateHasChanged();
    }

    // ── Task actions ──────────────────────────────────────
    private async Task ClaimAsync(DailyTask task)
    {
        try
        {
            task.ClaimedBy = _myName; task.ClaimedAt = DateTime.UtcNow;
            await TaskRepo.UpdateAsync(task);
            if (_hub?.State == HubConnectionState.Connected)
                await _hub.SendAsync("TaskClaimed", Slug, task.Id, _myName);
            StateHasChanged();
        }
        catch { }
    }

    private async Task MarkDoneAsync(DailyTask task)
    {
        try
        {
            task.CompletedAt = DateTime.UtcNow;
            await TaskRepo.UpdateAsync(task);
            if (_hub?.State == HubConnectionState.Connected)
                await _hub.SendAsync("TaskCompleted", Slug, task.Id);
            StateHasChanged();
        }
        catch { }
    }

    // ── Urgent camera ─────────────────────────────────────
    private async Task OpenUrgentCameraAsync()
    {
        _urgentCamera = true; StateHasChanged();
        await JS.InvokeVoidAsync("familyApp.startCamera", "urgent-video");
    }

    private async Task CaptureUrgentPhotoAsync()
    {
        try { _urgentPreview = await JS.InvokeAsync<string>("familyApp.capturePhoto"); }
        catch { }
        await JS.InvokeVoidAsync("familyApp.stopCamera", "urgent-video");
        _urgentCamera = false; StateHasChanged();
    }

    private async Task CloseUrgentCameraAsync()
    {
        await JS.InvokeVoidAsync("familyApp.stopCamera", "urgent-video");
        _urgentCamera = false; StateHasChanged();
    }

    // ── Urgent note add ───────────────────────────────────
    private async Task OnUrgentKey(KeyboardEventArgs e) { if (e.Key == "Enter") await AddUrgentAsync(); }

    private async Task AddUrgentAsync()
    {
        if (string.IsNullOrWhiteSpace(_urgentText) && string.IsNullOrEmpty(_urgentPreview)) return;
        try
        {
            DateTime? remindAt = null;
            if (!string.IsNullOrEmpty(_urgentTimeStr) && TimeOnly.TryParse(_urgentTimeStr, out var t))
                remindAt = DateTime.Today.Add(t.ToTimeSpan()).ToUniversalTime();

            string? photoPath = null;
            if (!string.IsNullOrEmpty(_urgentPreview))
                photoPath = await SavePhotoAsync(_urgentPreview, "reminders");

            var r = new PersonalReminder
            {
                FamilyId   = _familyId,
                MemberName = _myName,
                Text       = _urgentText.Trim(),
                RemindAt   = remindAt,
                PhotoPath  = photoPath
            };
            await ReminderRepo.AddAsync(r);
            _reminders.Add(r);
            _urgentText    = "";
            _urgentTimeStr = "";
            _urgentPreview = "";
            _showTimeInput = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task DismissReminderAsync(PersonalReminder r)
    {
        try { r.Done = true; await ReminderRepo.UpdateAsync(r); StateHasChanged(); }
        catch { }
    }

    // ── FindIt camera ─────────────────────────────────────
    private async Task OpenFindItCameraAsync()
    {
        _findItCamera = true; StateHasChanged();
        await JS.InvokeVoidAsync("familyApp.startCamera", "findit-video");
    }

    private async Task CaptureFindItPhotoAsync()
    {
        try { _findItPreview = await JS.InvokeAsync<string>("familyApp.capturePhoto"); }
        catch { }
        await JS.InvokeVoidAsync("familyApp.stopCamera", "findit-video");
        _findItCamera = false; StateHasChanged();
    }

    private async Task CloseFindItCameraAsync()
    {
        await JS.InvokeVoidAsync("familyApp.stopCamera", "findit-video");
        _findItCamera = false; StateHasChanged();
    }

    // ── FindIt save ───────────────────────────────────────
    private async Task OnFindItKey(KeyboardEventArgs e) { if (e.Key == "Enter") await SaveFindItAsync(); }

    private async Task SaveFindItAsync()
    {
        if (string.IsNullOrWhiteSpace(_findItName) || string.IsNullOrWhiteSpace(_findItLoc)) return;
        try
        {
            string? photoPath = null;
            if (!string.IsNullOrEmpty(_findItPreview))
                photoPath = await SavePhotoAsync(_findItPreview, "findit-photos");

            var saved = await StoredItemRepo.SaveAsync(_familyId, _findItName.Trim(), _findItLoc.Trim(), null, photoPath);
            var ex = _storedItems.FirstOrDefault(x => x.Id == saved.Id);
            if (ex is not null) _storedItems.Remove(ex);
            _storedItems.Insert(0, saved);
            _findItName    = "";
            _findItLoc     = "";
            _findItPreview = "";
            StateHasChanged();
        }
        catch { }
    }

    private async Task FoundItAsync(FamilyStoredItem item)
    {
        try
        {
            await StoredItemRepo.DeleteAsync(item.Id);
            _storedItems.Remove(item);
            StateHasChanged();
        }
        catch { }
    }

    // ── Helpers ───────────────────────────────────────────
    private static async Task<string> SavePhotoAsync(string base64, string subfolder)
    {
        var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", subfolder);
        Directory.CreateDirectory(folder);
        var path = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
        await File.WriteAllBytesAsync(path, Convert.FromBase64String(base64));
        return path;
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("familyApp.clearSession", Slug);
        Nav.NavigateTo($"/{Slug}/join", forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
