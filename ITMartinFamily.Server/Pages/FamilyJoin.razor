@page "/{slug}/join"
@rendermode InteractiveServer

@using ITMartinFamily.Domain.Entities
@using ITMartinFamily.Infrastructure
@using ITMartinFamily.Server.Components
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject FamilyDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS

<link rel="stylesheet" href="css/family.css" />

<div class="join-wrap">
    <div class="join-card">
        <div class="join-logo">👥</div>
        <h1 class="join-title">@(_family?.Name ?? "Gruppen")</h1>

        @if (_error is not null) { <div class="join-error">@_error</div> }

        @if (!_loaded)
        {
            <div class="join-loading">Indlæser...</div>
        }
        else if (_family is null)
        {
            <div class="join-error">Gruppen findes ikke. <a href="/" style="color:#6366f1">Opret en gruppe</a></div>
        }
        else
        {
            <div class="join-sub">Hvem er du?</div>

            <div class="member-grid">
                @foreach (var m in _members)
                {
                    var color = AvatarColor(m.Name);
                    <button class="member-card @(_selectedName == m.Name ? "member-card-active" : "")"
                            @onclick="() => Pick(m.Name)"
                            style="@(_selectedName == m.Name ? $"border-color:{color};background:color-mix(in srgb,{color} 15%,transparent)" : "")">
                        <div class="member-avatar" style="background:@color">
                            @m.Name[0].ToString().ToUpperInvariant()
                        </div>
                        <div class="member-name">@m.Name</div>
                    </button>
                }
                <button class="member-card member-card-new @(_selectedName == "__new__" ? "member-card-active" : "")"
                        @onclick='() => Pick("__new__")'>
                    <div class="member-avatar" style="background:#475569">+</div>
                    <div class="member-name">Ny person</div>
                </button>
            </div>

            @if (_selectedName is not null)
            {
                <div class="join-fields">
                    @if (_selectedName == "__new__")
                    {
                        <input class="join-input" @bind="_newName" placeholder="Dit navn" maxlength="60"
                               @onkeydown="OnKey" />
                    }
                    <input class="join-input" type="password" @bind="_password"
                           placeholder="Familiens adgangskode" @onkeydown="OnKey" />
                    <button class="join-btn" @onclick="JoinAsync" disabled="@_joining">
                        @(_joining ? "Logger ind..." : "Kom ind")
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Family?             _family;
    private List<FamilyMember>  _members      = [];
    private string?             _selectedName;
    private string              _newName      = "";
    private string              _password     = "";
    private string?             _error;
    private bool                _joining, _loaded;

    private static readonly string[] Colors = ["#6366f1", "#ec4899", "#f59e0b", "#10b981", "#3b82f6", "#f97316"];
    private static string AvatarColor(string name) => Colors[Math.Abs(name.GetHashCode()) % Colors.Length];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Already logged in → redirect to today
        var existing = await JS.InvokeAsync<string?>("familyApp.getSession", Slug);
        if (!string.IsNullOrEmpty(existing) && Guid.TryParse(existing, out var sid))
        {
            var session = await Db.Sessions.FirstOrDefaultAsync(s => s.Id == sid);
            if (session is not null)
            {
                var m = await Db.Members.FindAsync(session.MemberId);
                if (m is not null)
                {
                    var f = await Db.Families.FindAsync(m.FamilyId);
                    if (f?.Slug == Slug) { Nav.NavigateTo($"/{Slug}", forceLoad: true); return; }
                }
            }
        }

        _family  = await Db.Families.FirstOrDefaultAsync(f => f.Slug == Slug);
        _members = _family is not null
            ? await Db.Members.Where(m => m.FamilyId == _family.Id).OrderBy(m => m.Name).ToListAsync()
            : [];
        _loaded = true;
        StateHasChanged();
        await JS.InvokeVoidAsync("familyApp.preventBackToJoin");
    }

    private void Pick(string name)
    {
        _selectedName = _selectedName == name ? null : name;
        _error        = null;
        _password     = "";
    }

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await JoinAsync(); }

    private async Task JoinAsync()
    {
        _error = null;
        if (_family is null) return;
        if (_password.Trim() != _family.Password) { _error = "Forkert adgangskode."; return; }

        var nameToUse = _selectedName == "__new__" ? _newName.Trim() : _selectedName ?? "";
        if (string.IsNullOrWhiteSpace(nameToUse)) { _error = "Skriv dit navn."; return; }

        _joining = true;
        StateHasChanged();

        try
        {
            var member = await Db.Members.FirstOrDefaultAsync(m => m.FamilyId == _family.Id && m.Name == nameToUse);
            if (member is null)
            {
                member = new FamilyMember { FamilyId = _family.Id, Name = nameToUse };
                Db.Members.Add(member);
            }

            var session = new FamilySession { MemberId = member.Id };
            Db.Sessions.Add(session);
            await Db.SaveChangesAsync();

            await JS.InvokeVoidAsync("familyApp.setSession", Slug, session.Id.ToString());
            Nav.NavigateTo($"/{Slug}", forceLoad: true);
        }
        catch (Exception ex)
        {
            _error   = $"Noget gik galt: {ex.Message}";
            _joining = false;
        }
    }
}
