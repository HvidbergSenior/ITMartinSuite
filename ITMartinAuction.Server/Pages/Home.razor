@page "/"
@rendermode InteractiveServer
@inject AuctionService Svc
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="home-page">
    <div class="home-card">
        <div class="home-logo">🔨</div>
        <h1 class="home-title">Live Auktion</h1>
        <p class="home-sub">Byd på genstande i realtid</p>

        <div class="home-section">
            <label class="home-label">Auktionsnavn</label>
            <input class="home-input"
                   @bind="SessionName"
                   @bind:event="oninput"
                   placeholder="Samlekort — Juli 2026"
                   maxlength="60" />
            <button class="btn-primary"
                    @onclick="CreateSession"
                    disabled="@(string.IsNullOrWhiteSpace(SessionName) || Creating)">
                @(Creating ? "Opretter…" : "Opret auktion")
            </button>
        </div>

        <div class="home-divider">eller deltag i eksisterende</div>

        <div class="home-section">
            <label class="home-label">Auktionskode</label>
            <input class="home-input home-code"
                   @bind="JoinCode"
                   @bind:event="oninput"
                   placeholder="ABC123"
                   maxlength="6" />
            <button class="btn-secondary"
                    @onclick="JoinSession"
                    disabled="@string.IsNullOrWhiteSpace(JoinCode)">
                Deltag
            </button>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="home-error">@Error</p>
        }
    </div>
</div>

@code {
    private string SessionName = "";
    private string JoinCode    = "";
    private string Error       = "";
    private bool   Creating;

    private async Task CreateSession()
    {
        if (string.IsNullOrWhiteSpace(SessionName)) return;
        Creating = true;
        Error    = "";
        await InvokeAsync(StateHasChanged);
        try
        {
            var session = await Svc.CreateAsync(SessionName.Trim());
            await JS.InvokeVoidAsync("auction.setItem", $"admin_{session.Code}", session.AdminToken);
            Nav.NavigateTo($"/auction/{session.Code}/admin", forceLoad: true);
        }
        catch (Exception ex)
        {
            Error    = $"Kunne ikke oprette: {ex.Message}";
            Creating = false;
        }
    }

    private async Task JoinSession()
    {
        var code    = JoinCode.Trim().ToUpper();
        var session = await Svc.GetByCodeAsync(code);
        if (session is null)
        {
            Error = "Session ikke fundet. Tjek koden.";
            return;
        }
        Nav.NavigateTo($"/auction/{code}", forceLoad: true);
    }
}
