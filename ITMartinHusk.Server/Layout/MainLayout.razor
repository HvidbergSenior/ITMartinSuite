@inherits LayoutComponentBase

@* The same frame as ElPriser (the reference app): KolibriHeader with the tabs, k-main/k-content, KolibriFooter.
   The active tab is filled, not only coloured. *@
<KolibriHeader>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/" Match="NavLinkMatch.All">I dag</NavLink>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/bolde">Bolde</NavLink>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/tilfoej">Tilføj</NavLink>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/alt">Alt</NavLink>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/regler">Regler</NavLink>
    <button id="themeToggleBtn" class="k-btn k-btn-ghost k-btn-sm" type="button" title="Skift lys/mørk visning">Lys/mørk</button>
</KolibriHeader>
<div class="k-main"><div class="k-content">
    @Body
</div></div>
<KolibriFooter />
