@page "/"
@inject GuitarAiService Ai
@inject IJSRuntime JS

<PageTitle>SongHelper — Skriv din sang</PageTitle>

<div class="sh-wrap">

    @* ── Phase 0: Mood selection ── *@
    @if (_phase == Phase.Mood)
    {
        <div class="sh-hero">
            <div class="sh-guitar-icon">🎸</div>
            <h1 class="sh-title">Lad os skrive en sang</h1>
            <p class="sh-sub">Hvad skal stemningen være?</p>
            <div class="sh-moods">
                <button class="sh-mood-btn" @onclick='() => StartSession("glad")'>😄 Glad</button>
                <button class="sh-mood-btn" @onclick='() => StartSession("trist")'>😢 Trist</button>
                <button class="sh-mood-btn" @onclick='() => StartSession("kraftfuld")'>🔥 Kraftfuld</button>
                <button class="sh-mood-btn" @onclick='() => StartSession("rolig")'>🌙 Rolig</button>
            </div>
        </div>
    }

    @* ── Phase 1: Loading ── *@
    @if (_phase == Phase.Loading)
    {
        <div class="sh-loading">
            <div class="sh-spinner"></div>
            <p>Finder en god plan til dig...</p>
        </div>
    }

    @* ── Phase 2: Session ── *@
    @if (_phase == Phase.Session && _session != null)
    {
        <div class="sh-session">

            <div class="sh-session-header">
                <span class="sh-mood-tag">@_mood.ToUpper()</span>
                <button class="sh-restart" @onclick="Restart">← ny stemning</button>
            </div>

            @* Chord progression *@
            <section class="sh-section">
                <h2 class="sh-section-title">🎵 Akkorder</h2>
                <div class="sh-chord-flow">
                    @foreach (var chord in _session.Chords)
                    {
                        <div class="sh-chord-pill-wrap">
                            <span class="sh-chord-pill">@ChordNames.DanishSymbol(chord)</span>
                            <span class="sh-chord-full-name">@ChordNames.FullName(chord)</span>
                        </div>
                    }
                </div>
            </section>

            @* Strumming *@
            <section class="sh-section">
                <h2 class="sh-section-title">🥁 Strum-mønster</h2>
                <div class="sh-strum">@_session.StrummingPattern</div>
                <p class="sh-strum-desc">@_session.StrummingDescription</p>
            </section>

            @* Chord diagrams *@
            <section class="sh-section">
                <h2 class="sh-section-title">🖐 Grebsbilleder</h2>
                <p class="sh-hint">Tryk på en akkord for at skifte grebsform</p>
                <div class="sh-chord-cards">
                    @foreach (var chord in _session.Chords)
                    {
                        var voicings = ChordLibrary.GetVoicings(chord);
                        var idx = _voicingIndex.GetValueOrDefault(chord, 0);
                        var current = voicings.Length > 0 ? voicings[Math.Min(idx, voicings.Length - 1)] : null;
                        <div class="sh-chord-card" @onclick="() => NextVoicing(chord, voicings.Length)">
                            <div class="sh-chord-card-name">@ChordNames.DanishSymbol(chord)</div>
                            <div class="sh-chord-card-full">@ChordNames.FullName(chord)</div>
                            @if (current != null)
                            {
                                <ChordDiagram Voicing="current" />
                                <div class="sh-voicing-tip">@current.Tip</div>
                                <div class="sh-voicing-nav">@(idx + 1) / @voicings.Length  →</div>
                                @if (_session.TransitionTips.TryGetValue(GetTransitionKey(chord), out var tt))
                                {
                                    <div class="sh-transition-tip">➡ @tt</div>
                                }
                            }
                        </div>
                    }
                </div>
            </section>

            @* Melody tips *@
            <section class="sh-section">
                <h2 class="sh-section-title">🎤 Melodi-tips</h2>
                <ul class="sh-tips-list">
                    @foreach (var tip in _session.MelodyTips)
                    {
                        <li class="sh-tip">@tip</li>
                    }
                </ul>
                <div class="sh-general-tip">💡 @_session.GeneralTip</div>
            </section>

            @* More tips from AI *@
            <section class="sh-section">
                <button class="sh-btn-outline" @onclick="GetMoreTips" disabled="@_moreTipsLoading">
                    @(_moreTipsLoading ? "Henter tips..." : "🤖 Få flere tips fra AI")
                </button>
                @if (!string.IsNullOrEmpty(_moreTips))
                {
                    <div class="sh-more-tips">@_moreTips</div>
                }
            </section>

            @* Recording *@
            <section class="sh-section">
                <h2 class="sh-section-title">⏺ Optag din idé</h2>
                @if (!string.IsNullOrEmpty(_recError))
                {
                    <div class="sh-rec-error">@_recError</div>
                }
                @if (!_recording)
                {
                    <button class="sh-btn-rec" @onclick="StartRecording">⏺ Start optagelse</button>
                }
                else
                {
                    <button class="sh-btn-rec sh-btn-stop" @onclick="StopRecording">⏹ Stop (@_recSeconds s)</button>
                }
                @if (_recordings.Count > 0)
                {
                    <h3 class="sh-rec-header">Dine optagelser</h3>
                    <div class="sh-recordings">
                        @foreach (var (b64, i) in _recordings.Select((r, i) => (r, i + 1)))
                        {
                            <div class="sh-recording-row">
                                <span class="sh-rec-label">Idé @i</span>
                                <button class="sh-btn-play" @onclick="() => PlayRecording(b64)">▶ Afspil</button>
                                <button class="sh-btn-del" @onclick="() => DeleteRecording(b64)">✕</button>
                            </div>
                        }
                    </div>
                }
            </section>

        </div>
    }

</div>

@code {
    private enum Phase { Mood, Loading, Session }
    private Phase _phase = Phase.Mood;

    private string _mood = "";
    private SongSession? _session;
    private Dictionary<string, int> _voicingIndex = new();

    private bool _recording;
    private int _recSeconds;
    private System.Timers.Timer? _recTimer;
    private string _recError = "";
    private List<string> _recordings = new();

    private bool _moreTipsLoading;
    private string _moreTips = "";

    private async Task StartSession(string mood)
    {
        _mood = mood;
        _phase = Phase.Loading;
        StateHasChanged();

        _session = await Ai.GenerateSessionAsync(mood);
        _voicingIndex = _session.Chords.ToDictionary(c => c, _ => 0);
        _phase = Phase.Session;
    }

    private void Restart()
    {
        _phase = Phase.Mood;
        _session = null;
        _voicingIndex.Clear();
        _moreTips = "";
        _recError = "";
    }

    private void NextVoicing(string chord, int count)
    {
        if (count == 0) return;
        _voicingIndex[chord] = (_voicingIndex.GetValueOrDefault(chord, 0) + 1) % count;
    }

    private string GetTransitionKey(string chord)
    {
        if (_session == null) return "";
        var chords = _session.Chords;
        var i = Array.IndexOf(chords, chord);
        if (i < 0 || i >= chords.Length - 1) return "";
        return $"{chords[i]}→{chords[i + 1]}";
    }

    private async Task StartRecording()
    {
        _recError = "";
        _recSeconds = 0;
        _recTimer = new System.Timers.Timer(1000) { AutoReset = true };
        _recTimer.Elapsed += async (_, _) => { _recSeconds++; await InvokeAsync(StateHasChanged); };
        _recTimer.Start();
        _recording = true;
        try
        {
            await JS.InvokeVoidAsync("musicHelper.startRecording");
        }
        catch (JSException ex)
        {
            _recTimer?.Stop(); _recTimer?.Dispose();
            _recording = false; _recSeconds = 0;
            _recError = $"Mikrofon ikke tilgængelig: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopRecording()
    {
        _recTimer?.Stop(); _recTimer?.Dispose();
        _recording = false;
        var b64 = await JS.InvokeAsync<string>("musicHelper.stopRecording");
        if (!string.IsNullOrEmpty(b64))
            _recordings.Add(b64);
    }

    private async Task PlayRecording(string b64)
    {
        await JS.InvokeVoidAsync("musicHelper.playBase64Audio", b64);
    }

    private void DeleteRecording(string b64)
    {
        _recordings.Remove(b64);
    }

    private async Task GetMoreTips()
    {
        if (_session == null || _moreTipsLoading) return;
        _moreTipsLoading = true;
        _moreTips = await Ai.GetMoreTipsAsync(_session.Chords, _mood);
        _moreTipsLoading = false;
    }
}
