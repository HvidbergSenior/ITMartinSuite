@page "/tutorials"
@inject IJSRuntime JS

<PageTitle>Tutorials — Guitar, Piano & Sang</PageTitle>

<div class="sh-wrap">

    <div class="tut-header">
        <h1 class="tut-title">Tutorials</h1>
        <p class="tut-sub">Guitar · Piano · Sang</p>
    </div>

    @* ── Tab bar ── *@
    <div class="tut-tabs">
        <button class="tut-tab @(_tab == "guitar"  ? "active" : "")" @onclick='() => _tab = "guitar"'>🎸 Guitar</button>
        <button class="tut-tab @(_tab == "piano"   ? "active" : "")" @onclick='() => _tab = "piano"'>🎹 Piano</button>
        <button class="tut-tab @(_tab == "vocal"   ? "active" : "")" @onclick='() => _tab = "vocal"'>🎤 Sang</button>
    </div>

    @* ── Guitar ── *@
    @if (_tab == "guitar")
    {
        <div class="tut-grid">
            @foreach (var tut in TutorialLibrary.Guitar)
            {
                var open = _openId == tut.Id;
                <div class="tut-card @(open ? "open" : "")">
                    <button class="tut-card-head" @onclick="() => Toggle(tut.Id)">
                        <span class="tut-card-icon">@tut.Icon</span>
                        <span class="tut-card-title">@tut.Title</span>
                        <span class="tut-chevron">@(open ? "▲" : "▼")</span>
                    </button>
                    @if (open)
                    {
                        <div class="tut-body">
                            @foreach (var step in tut.Steps)
                            {
                                <div class="tut-step">
                                    <h3 class="tut-step-title">@step.Title</h3>
                                    <p class="tut-step-body">@step.Body</p>
                                    @if (!string.IsNullOrEmpty(step.Pattern))
                                    {
                                        <div class="tut-pattern">@step.Pattern</div>
                                    }
                                    @if (!string.IsNullOrEmpty(step.Example))
                                    {
                                        <div class="tut-example">💡 @step.Example</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── Piano ── *@
    @if (_tab == "piano")
    {
        <div class="tut-grid">
            @foreach (var tut in TutorialLibrary.Piano)
            {
                var open = _openId == tut.Id;
                <div class="tut-card @(open ? "open" : "")">
                    <button class="tut-card-head" @onclick="() => Toggle(tut.Id)">
                        <span class="tut-card-icon">@tut.Icon</span>
                        <span class="tut-card-title">@tut.Title</span>
                        <span class="tut-chevron">@(open ? "▲" : "▼")</span>
                    </button>
                    @if (open)
                    {
                        <div class="tut-body">
                            @foreach (var step in tut.Steps)
                            {
                                <div class="tut-step">
                                    <h3 class="tut-step-title">@step.Title</h3>
                                    <p class="tut-step-body">@step.Body</p>
                                    @if (!string.IsNullOrEmpty(step.Pattern))
                                    {
                                        <div class="tut-pattern">@step.Pattern</div>
                                    }
                                    @if (!string.IsNullOrEmpty(step.Example))
                                    {
                                        <div class="tut-example">💡 @step.Example</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── Vocal ── *@
    @if (_tab == "vocal")
    {
        <div class="tut-grid">
            @foreach (var ex in VocalLibrary.Warmups)
            {
                var open = _openId == ex.Id;
                <div class="tut-card @(open ? "open" : "")">
                    <button class="tut-card-head" @onclick="() => Toggle(ex.Id)">
                        <span class="tut-card-icon">@ex.Icon</span>
                        <div class="tut-card-title-group">
                            <span class="tut-card-title">@ex.Title</span>
                            <span class="tut-card-dur">⏱ @ex.Duration</span>
                        </div>
                        <span class="tut-chevron">@(open ? "▲" : "▼")</span>
                    </button>
                    @if (open)
                    {
                        <div class="tut-body">
                            <p class="tut-step-body">@ex.Description</p>
                            @if (!string.IsNullOrEmpty(ex.Pattern))
                            {
                                <div class="tut-pattern">@ex.Pattern</div>
                            }
                            <ol class="tut-steps-list">
                                @foreach (var step in ex.Steps)
                                {
                                    <li class="tut-step-item">@step</li>
                                }
                            </ol>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── Recording (all tabs) ── *@
    <div class="sh-section tut-rec-section">
        <h2 class="sh-section-title">⏺ Optag din øvelse</h2>

        @if (!_recording)
        {
            <div class="tut-rec-mode">
                <button class="tut-mode-btn @(!_videoMode ? "active" : "")" @onclick='() => _videoMode = false'>🎙 Lyd</button>
                <button class="tut-mode-btn @(_videoMode ? "active" : "")"  @onclick='() => _videoMode = true'>📹 Video</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_recError))
        {
            <div class="sh-rec-error">@_recError</div>
        }

        @if (_recording && _videoMode)
        {
            <video id="tut-cam" autoplay muted playsinline class="tut-cam-preview"></video>
        }

        @if (!_recording)
        {
            <button class="sh-btn-rec" @onclick="StartRec">⏺ Start optagelse</button>
        }
        else
        {
            <button class="sh-btn-rec sh-btn-stop" @onclick="StopRec">⏹ Stop (@_recSec s)</button>
        }

        @if (_recordings.Count > 0)
        {
            <div class="sh-rec-header">Dine optagelser</div>
            <div class="sh-recordings">
                @foreach (var (rec, i) in _recordings.Select((r, i) => (r, i + 1)))
                {
                    <div class="sh-recording-row">
                        <span class="sh-rec-label">@(rec.HasVideo ? "📹" : "🎙") Øvelse @i</span>
                        <button class="sh-btn-play" @onclick="() => PlayRec(rec)">▶ Afspil</button>
                        <button class="sh-btn-del"  @onclick="() => _recordings.Remove(rec)">✕</button>
                    </div>
                }
            </div>
        }
    </div>

</div>

@code {
    private string _tab = "guitar";
    private string? _openId;

    private bool _recording;
    private bool _videoMode;
    private int _recSec;
    private System.Timers.Timer? _recTimer;
    private string _recError = "";
    private List<Recording> _recordings = new();

    private record Recording(string Data, bool HasVideo);

    private void Toggle(string id) => _openId = _openId == id ? null : id;

    private async Task StartRec()
    {
        _recError = "";
        _recSec = 0;
        _recording = true;
        StateHasChanged();

        try
        {
            // Pass video element id and mode; JS returns actual hasVideo (may fall back to audio)
            _videoMode = await JS.InvokeAsync<bool>("musicHelper.startRecording", "tut-cam", _videoMode);
            _recTimer = new System.Timers.Timer(1000) { AutoReset = true };
            _recTimer.Elapsed += async (_, _) => { _recSec++; await InvokeAsync(StateHasChanged); };
            _recTimer.Start();
        }
        catch (JSException ex)
        {
            _recording = false;
            _recError = $"Mikrofon/kamera ikke tilgængeligt: {ex.Message}";
        }
    }

    private async Task StopRec()
    {
        _recTimer?.Stop(); _recTimer?.Dispose();
        _recording = false;
        var result = await JS.InvokeAsync<RecResult>("musicHelper.stopRecording");
        if (!string.IsNullOrEmpty(result?.Data))
            _recordings.Add(new Recording(result.Data, result.HasVideo));
    }

    private async Task PlayRec(Recording rec) =>
        await JS.InvokeVoidAsync("musicHelper.playRecording", rec.Data, rec.HasVideo);

    private record RecResult(string Data, bool HasVideo);
}
