@page "/library"

@using ITMartin.Media.Contracts.Contracts.Constants
@using ITMartin.Media.Contracts.Contracts.Runtime.Enums
@using ITMartin.Media.Contracts.Contracts.Runtime.Helpers
@using ITMartin.Media.Contracts.Contracts.Runtime.Models
@using ITMartin.Media.Infrastructure.FileSystem

@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject ILogger<Library> Logger

<div class="filesorter-app">

    <div class="page-container stack library-page">

        <div class="library-header">

            <SectionTitle Title="🎬 Media Library" />

            <div class="library-actions">

                <button class="btn btn-secondary"
                        @onclick="GoBack"
                        disabled="@(!CanGoBack)">
                    ← Back
                </button>

                <button class="btn btn-secondary"
                        @onclick="GoToRoot">
                    📁 Library Root
                </button>

            </div>

        </div>

        @if (Folders.Any())
        {
            <ContentCard Title="📁 Folders">

                <div class="library-grid">

                    @foreach (var folder in Folders)
                    {
                        <div class="folder-card"
                             @onclick="() => OpenFolder(folder.FullPath)">

                            @if (!string.IsNullOrWhiteSpace(folder.CoverImageUrl))
                            {
                                <img class="folder-cover"
                                     src="@folder.CoverImageUrl"
                                     alt="@folder.Name" />
                            }
                            else
                            {
                                <div class="folder-cover-placeholder">
                                    📁
                                </div>
                            }

                            <div class="folder-info">

                                <div class="folder-title">
                                    @folder.Name
                                </div>

                                <div class="folder-meta">
                                    @folder.FileCount files
                                    · @FormatSize(folder.TotalBytes)
                                </div>

                            </div>

                        </div>
                    }

                </div>

            </ContentCard>
        }

        @if (Files.Any())
        {
            <ContentCard Title="🎬 Media">

                <div class="media-grid">

                    @foreach (var file in Files)
                    {
                        <div class="media-card"
                             @onclick="() => OpenFile(file)">

                            @if (file.Type == MediaType.Image)
                            {
                                var thumb = GetThumbnailUrl(file);
                                <img class="media-thumb"
                                     src="@thumb"
                                     alt="@file.FileName"
                                     loading="lazy" />
                            }
                            else if (file.Type == MediaType.Video)
                            {
                                <div class="media-video-thumb">
                                    <span class="play-icon">▶</span>
                                </div>
                            }
                            else if (file.Type == MediaType.Audio)
                            {
                                <div class="media-audio-thumb">
                                    🎵
                                </div>
                            }
                            else
                            {
                                <div class="media-doc-thumb">
                                    📄
                                </div>
                            }

                            <div class="media-info">

                                <div class="media-name">
                                    @file.FileName
                                </div>

                                <div class="media-meta">
                                    @FormatSize(file.SizeBytes)
                                    @if (file.CreatedAt != default)
                                    {
                                        <span class="media-date">
                                            · @file.CreatedAt!.Value.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                </div>

                            </div>

                        </div>
                    }

                </div>

            </ContentCard>
        }

        @if (!Folders.Any() && !Files.Any())
        {
            <EmptyState
                Icon="📭"
                Title="Empty folder"
                Subtitle="No media files here yet" />
        }

    </div>

</div>

@code {

    private string RootPath = "";

    private string CurrentPath = "";

    private List<FolderItem> Folders = [];

    private List<MediaFile> Files = [];

    [Parameter]
    [SupplyParameterFromQuery]
    public string? path { get; set; }

    protected override void OnParametersSet()
    {
        RootPath =
            Configuration["MediaSettings:LibraryRoot"]
            ?? "";

        var initial =
            string.IsNullOrWhiteSpace(path)
                ? RootPath
                : path;

        LoadFolder(initial);
    }

    private bool CanGoBack =>
        !string.Equals(
            CurrentPath,
            RootPath,
            StringComparison.OrdinalIgnoreCase);

    private void GoBack()
    {
        var parent =
            Directory.GetParent(CurrentPath);

        if (parent != null)
        {
            LoadFolder(parent.FullName);
        }
    }

    private void GoToRoot()
    {
        LoadFolder(RootPath);
    }

    private void OpenFolder(string folderPath)
    {
        Navigation.NavigateTo(
            $"/library?path={Uri.EscapeDataString(folderPath)}");
    }

    private void OpenFile(MediaFile file)
    {
        var index = Files.FindIndex(f =>
            f.FullPath == file.FullPath);

        Navigation.NavigateTo(
            $"/viewer?path={Uri.EscapeDataString(file.FullPath)}&index={index}",
            true);
    }

    private void LoadFolder(string folderPath)
    {
        if (!Directory.Exists(folderPath))
        {
            Logger.LogWarning(
                "Library folder does not exist: {Path}",
                folderPath);

            return;
        }

        CurrentPath = folderPath;

        Folders = Directory
            .EnumerateDirectories(folderPath)
            .Select(CreateFolderItem)
            .OrderBy(x => x.Name)
            .ToList();

        Files = Directory
            .EnumerateFiles(folderPath)
            .Where(MediaDisplayHelper.IsDisplayable)
            .Select(CreateMediaFile)
            .OrderByDescending(f => f.CreatedAt)
            .ToList();

        StateHasChanged();
    }

    private string GetThumbnailUrl(MediaFile file)
    {
        var root =
            Configuration["MediaSettings:LibraryRoot"];

        if (string.IsNullOrWhiteSpace(root))
            return "";

        // Try thumbnail first (generated by Package 1)
        var dir = Path.GetDirectoryName(file.FullPath) ?? "";

        var thumbPath = Path.Combine(
            dir,
            "thumbnails",
            $"{Path.GetFileNameWithoutExtension(file.FullPath)}.jpg");

        if (File.Exists(thumbPath))
        {
            var thumbRelative = Path
                .GetRelativePath(root, thumbPath)
                .Replace("\\", "/");

            return $"/libraryfiles/{thumbRelative}";
        }

        // Fall back to full image
        var relative = Path
            .GetRelativePath(root, file.FullPath)
            .Replace("\\", "/");

        return $"/libraryfiles/{relative}";
    }

    private string GetFolderCoverUrl(string folderPath)
    {
        var root =
            Configuration["MediaSettings:LibraryRoot"];

        if (string.IsNullOrWhiteSpace(root))
            return "";

        var first = Directory
            .EnumerateFiles(
                folderPath,
                "*.*",
                SearchOption.AllDirectories)
            .FirstOrDefault(f =>
            {
                var ext = Path.GetExtension(f).ToLowerInvariant();
                return ext is ".jpg" or ".jpeg" or ".png" or ".webp";
            });

        if (first == null)
            return "";

        // Prefer thumbnail
        var thumbPath = Path.Combine(
            Path.GetDirectoryName(first) ?? "",
            "thumbnails",
            $"{Path.GetFileNameWithoutExtension(first)}.jpg");

        var source = File.Exists(thumbPath) ? thumbPath : first;

        var relative = Path
            .GetRelativePath(root, source)
            .Replace("\\", "/");

        return $"/libraryfiles/{relative}";
    }

    private FolderItem CreateFolderItem(string folder)
    {
        var files = Directory
            .EnumerateFiles(
                folder,
                "*.*",
                SearchOption.AllDirectories)
            .Where(MediaFileHelper.IsSupportedMedia)
            .ToList();

        return new FolderItem
        {
            Name = Path.GetFileName(folder),
            FullPath = folder,
            FileCount = files.Count,
            TotalBytes = files.Sum(f => new FileInfo(f).Length),
            CoverImageUrl = GetFolderCoverUrl(folder)
        };
    }

    private MediaFile CreateMediaFile(string file)
    {
        var info = new FileInfo(file);

        var extension =
            Path.GetExtension(file)
                .ToLowerInvariant();

        var type =
            MediaExtensions.ImageExtensions.Contains(extension)
                ? MediaType.Image
                : MediaExtensions.VideoExtensions.Contains(extension)
                    ? MediaType.Video
                    : MediaExtensions.AudioExtensions.Contains(extension)
                        ? MediaType.Audio
                        : MediaType.Document;

        return new MediaFile(
            file,
            info.LastWriteTimeUtc,
            type,
            info.Length);
    }

    private static string FormatSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];

        double len = bytes;
        var order = 0;

        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }

        return $"{len:0.#} {sizes[order]}";
    }

    private sealed class FolderItem
    {
        public string Name { get; set; } = "";
        public string FullPath { get; set; } = "";
        public int FileCount { get; set; }
        public long TotalBytes { get; set; }
        public string CoverImageUrl { get; set; } = "";
    }
}
