@inherits LayoutComponentBase

<div class="app-shell">

    <header class="app-header gl-header">

        <div class="header-title">
            <span class="header-icon">🎬</span>
            Gallery
        </div>

        <nav class="gl-nav">

            <NavLink class="gl-nav-link"
                     href="/library"
                     Match="NavLinkMatch.All">
                🎬 Library
            </NavLink>

            <NavLink class="gl-nav-link"
                     href="/ai-collections">
                🗂️ Collections
            </NavLink>

            <NavLink class="gl-nav-link"
                     href="/curator">
                ✏️ Curator
            </NavLink>

        </nav>

    </header>

    <main class="app-main">
        @Body
    </main>
    <ToastContainer />
    <footer style="text-align:center;padding:.6rem 1rem;font-size:.72rem;color:#64748b;border-top:1px solid rgba(255,255,255,.06)"><a href="https://all-apps.itmartin.dk/vilkaar" target="_blank" style="color:#64748b;text-decoration:underline">Vilkår &amp; Privatlivspolitik</a> · &copy; @DateTime.Now.Year ITMartin</footer>

</div>
