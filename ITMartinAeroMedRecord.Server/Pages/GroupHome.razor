@page "/g/{Slug}"
@rendermode InteractiveServer
@inject AeroDbContext Db
@inject AeroAuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject AeroPushService PushService

@if (_group is null)
{
    <p style="padding:20px">Indlæser...</p>
}
else
{
    <div class="home-wrap">
        <AeroNav Slug="@Slug" GroupName="@_group.Name" MemberLabel="@($"Logget ind som {_me?.Name}")" Active="home" OnLogout="LeaveAsync" />

        <div class="home-body">
            <InfoBanners PageKey="home"
                Problem="Opgaver er det centrale. Men hvem tager hvilken opgave? Og hvor langt er man kommet?"
                Losning="Det vigtigste er ikke at beskrive sine opgaver i detaljer. Det vigtigste er, at der er fremdrift og at opgaverne bliver lukkede. Så tydelig status på opgaven og hvem der har ansvaret lige nu, skal fremgå."
                Beskrivelse="Denne AeroMedRecord formidlingsapp er et værktøj som skal styre alt der har med den kommende AeroMedRecord-løsning at gøre. Løsningen er beskrevet i dokumentet under Dokumenter."
                Steps="@_homeSteps" />

            @if (_pushStatusMessage is not null)
            {
                <div class="push-status-banner">@_pushStatusMessage</div>
            }
            else
            {
                <button class="push-enable-btn" @onclick="EnablePushAsync">🔔 Slå notifikationer til på denne enhed</button>
            }

            <div class="home-toolbar">
                <div class="home-members">👥 @string.Join(", ", _members.Select(m => m.Name))</div>
                <button class="btn-ghost" @onclick="AddColumnAsync">+ Hovedopgave</button>
            </div>

            <div class="maintask-grid">
                @foreach (var col in _mainTasks)
                {
                    <div class="maintask-card" style="background:@ColumnColor(_mainTasks.IndexOf(col))">
                        <div class="maintask-header">
                            @if (_editingColumnId == col.Id)
                            {
                                <input class="column-title-input" @bind="_editColumnTitle" @bind:event="oninput" @onkeydown="e => OnColumnEditKeyDown(e, col)" />
                                <div class="column-edit-actions">
                                    <button class="icon-btn" @onclick="() => SaveColumnAsync(col)" title="Gem">✓</button>
                                    <button class="icon-btn" @onclick="() => _editingColumnId = null" title="Annullér">✕</button>
                                </div>
                            }
                            else
                            {
                                <h2>@col.Title</h2>
                                <div class="column-edit-actions">
                                    <span class="section-count">@_assignments.Count(a => a.MainTaskId == col.Id)</span>
                                    <button class="icon-btn" @onclick="() => StartEditColumn(col)" title="Omdøb hovedopgave">✏️</button>
                                    <button class="icon-btn" @onclick="() => DeleteColumnAsync(col)" title="Slet hovedopgave">🗑️</button>
                                </div>
                            }
                        </div>

                        @foreach (var a in _assignments.Where(x => x.MainTaskId == col.Id))
                        {
                            <div class="task-row-item @(a.IsAssignedTo(_me?.Name ?? "") ? "task-row-mine" : "")">
                                @if (_editingTaskId == a.Id)
                                {
                                    <div class="task-info">
                                        <input class="task-add-input" @bind="_editTaskTitle" @bind:event="oninput" @onkeydown="e => OnTaskEditKeyDown(e, a)" />
                                        <div class="task-edit-actions">
                                            <button class="icon-btn" @onclick="() => SaveTaskAsync(a)" title="Gem">✓</button>
                                            <button class="icon-btn" @onclick="() => _editingTaskId = null" title="Annullér">✕</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="task-info">
                                        <div class="task-item-title">@a.Title</div>
                                        @if (a.Assignees.Count == 0)
                                        {
                                            <div class="task-badge task-badge-open">⚡ Ingen har taget den</div>
                                        }
                                        else
                                        {
                                            <div class="task-badge task-badge-claimed">✋ @a.AssigneeLabel klarer det</div>
                                        }
                                        <div class="task-meta">Oprettet af @a.CreatedByName</div>

                                        @if (_editingAssigneesId == a.Id)
                                        {
                                            <div class="assignee-picker">
                                                @foreach (var m in _members)
                                                {
                                                    <label class="assignee-option">
                                                        <input type="checkbox" checked="@a.IsAssignedTo(m.Name)" @onchange="e => ToggleAssigneeAsync(a, m.Name, (bool)e.Value!)" />
                                                        @m.Name
                                                    </label>
                                                }
                                                <button class="task-take-btn" @onclick="() => _editingAssigneesId = null">✓ Luk</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="display:flex;gap:8px;flex-wrap:wrap">
                                                @if (a.IsAssignedTo(_me?.Name ?? ""))
                                                {
                                                    <button class="task-complete-btn" @onclick="() => ToggleAsync(a, true)">Markér som færdig ✓</button>
                                                }
                                                else
                                                {
                                                    <button class="task-take-btn" @onclick="() => ToggleAssigneeAsync(a, _me!.Name, true)">@(a.Assignees.Count == 0 ? "Jeg tager den 👋" : "Deltag også 🙋")</button>
                                                }
                                                <button class="task-take-btn" @onclick="() => _editingAssigneesId = a.Id">👤 Vælg ansvarlige</button>
                                            </div>
                                        }
                                    </div>
                                    <div style="display:flex;flex-direction:column;gap:4px">
                                        <button class="task-del-btn" @onclick="() => StartEditTask(a)" title="Redigér">✏️</button>
                                        <button class="task-del-btn" @onclick="() => DeleteTaskAsync(a)" title="Slet">✕</button>
                                    </div>
                                }
                            </div>
                        }
                        <div class="task-add-row">
                            <input @bind="_newTaskTitle[col.Id]" @bind:event="oninput" placeholder="Ny underopgave..." class="task-add-input" @onkeydown="e => OnTaskKeyDown(e, col.Id)" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <style>
        .home-wrap { max-width: 900px; margin: 0 auto; color: var(--text); }
        .home-body { padding: 16px 16px 64px; }
        .home-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .home-members { color: var(--muted); font-size: 13px; }
        .push-enable-btn { display: block; width: 100%; margin: 12px 0; padding: 10px; border-radius: 10px; border: 1px dashed var(--accent); background: transparent; color: var(--accent); font-size: 13px; font-weight: 700; cursor: pointer; }
        .push-status-banner { margin: 12px 0; padding: 10px 14px; border-radius: 10px; background: var(--card); border: 1px solid var(--border); font-size: 13px; color: var(--text); }
        .maintask-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; align-items: start; }
        @@media (max-width: 640px) { .maintask-grid { grid-template-columns: 1fr; } }
        .maintask-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 16px; }
        .maintask-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; gap: 8px; }
        .maintask-header h2 { margin: 0; font-size: 16px; font-weight: 800; color: var(--text); }
        .section-count { font-size: 12px; font-weight: 700; color: var(--muted); background: var(--surface); border-radius: 999px; padding: 2px 10px; }
        .column-edit-actions, .task-edit-actions { display: flex; align-items: center; gap: 4px; }
        .column-title-input { flex: 1; background: var(--surface); border: 1px solid var(--accent); border-radius: 6px; padding: 4px 8px; color: var(--text); font-size: 14px; font-weight: 700; box-sizing: border-box; }
        .icon-btn { background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 13px; padding: 2px 4px; line-height: 1; }
        .icon-btn:hover { color: var(--text); }
        .btn-ghost { background: var(--card); border: 1px solid var(--border); color: var(--text); padding: 8px 14px; border-radius: 8px; cursor: pointer; font-size: 13px; }

        .task-row-item { display: flex; align-items: flex-start; gap: 12px; padding: 12px 10px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 8px; background: var(--card); }
        .task-row-mine { border-color: #6366f1; background: rgba(99,102,241,.08); }
        .task-info { flex: 1; }
        .task-item-title { font-size: 15px; font-weight: 600; margin-bottom: 4px; color: var(--text); }
        .task-badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; margin: 2px 0 6px; }
        .task-badge-open { background: var(--red); color: white; }
        .task-badge-claimed { background: #d97706; color: white; }
        .task-meta { font-size: 12px; color: var(--muted); margin-bottom: 6px; }
        .task-complete-btn { width: auto; padding: 8px 16px; border-radius: 10px; border: none; background: var(--accent); color: white; font-size: 13px; font-weight: 700; cursor: pointer; }
        .task-take-btn { background: transparent; border: 1px solid rgba(59,130,246,.4); color: #60a5fa; border-radius: 8px; padding: 4px 10px; font-size: 12px; cursor: pointer; }
        .task-take-btn:hover { background: rgba(59,130,246,.1); }
        .task-del-btn { background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 14px; padding: 2px 6px; flex-shrink: 0; }
        .task-del-btn:hover { color: var(--red); }
        .assignee-picker { margin-top: 6px; background: var(--surface); border: 1px solid var(--accent); border-radius: 8px; padding: 8px 10px; display: flex; flex-direction: column; gap: 6px; }
        .assignee-option { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text); }
        .task-add-row { margin-top: 6px; }
        .task-add-input { width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 6px 8px; color: var(--text); font-size: 12px; box-sizing: border-box; }
    </style>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Group? _group;
    private Member? _me;
    private List<MainTask> _mainTasks = [];
    private List<Assignment> _assignments = [];
    private List<Member> _members = [];
    private Dictionary<Guid, string> _newTaskTitle = [];
    private string? _pushStatusMessage;
    private Guid? _editingTaskId;
    private string _editTaskTitle = "";
    private Guid? _editingAssigneesId;
    private Guid? _editingColumnId;
    private string _editColumnTitle = "";

    private static readonly string[] _homeSteps =
    [
        "Opret en hovedopgave (fx et sagsområde) med \"+ Hovedopgave\" øverst.",
        "Skriv en underopgave i feltet \"Ny underopgave...\" nederst under hovedopgaven, og tryk Enter.",
        "Sæt en eller flere ansvarlige på underopgaven, og markér den som færdig via checkboxen når den er løst."
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _group = await Db.Groups.FirstOrDefaultAsync(g => g.Slug == Slug);
        if (_group is null) return;

        // JS interop (reading the session id from localStorage) can only run
        // once the circuit is interactive, not during static prerendering -
        // that's why this lives here and not in OnInitializedAsync (same
        // reasoning as Club's ClubAuthService callers).
        var session = await Auth.ResolveSessionAsync(Js, Db, Slug);
        if (session is null)
        {
            Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true);
            return;
        }
        _me = session.Member;

        await LoadAsync();

        if (_mainTasks.Count == 0)
        {
            Db.MainTasks.Add(new MainTask { GroupId = _group.Id, Title = "Opgaver", SortOrder = 0 });
            await Db.SaveChangesAsync();
            await LoadAsync();
        }

        StateHasChanged();

        try
        {
            var publicKey = PushService.GetPublicKey();
            var status = await Js.InvokeAsync<string>("aeroJs.subscribePush", publicKey, _group.Id, _me!.Name);
            // Only surface success/hard-failure from the silent on-load
            // attempt - leave the banner as the enable button for anything
            // that just needs the manual click (Safari etc.).
            if (status == "granted")
            {
                _pushStatusMessage = "🔔 Notifikationer er slået til på denne enhed.";
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task LoadAsync()
    {
        _mainTasks = await Db.MainTasks.Where(m => m.GroupId == _group!.Id).OrderBy(m => m.SortOrder).ToListAsync();
        _assignments = await Db.Assignments.Where(a => a.GroupId == _group!.Id && !a.IsCompleted).OrderBy(a => a.CreatedAt).ToListAsync();
        _members = await Db.Members.Where(m => m.GroupId == _group!.Id).OrderBy(m => m.Name).ToListAsync();
        foreach (var col in _mainTasks)
            _newTaskTitle.TryAdd(col.Id, "");
    }

    private async Task AddColumnAsync()
    {
        var nextSort = _mainTasks.Count == 0 ? 0 : _mainTasks.Max(m => m.SortOrder) + 1;
        Db.MainTasks.Add(new MainTask { GroupId = _group!.Id, Title = "Ny hovedopgave", SortOrder = nextSort });
        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task ToggleAsync(Assignment a, bool value)
    {
        a.IsCompleted = value;
        a.CompletedAt = value ? DateTime.UtcNow : null;
        await Db.SaveChangesAsync();
        // Completed tasks move to Historik, not just strike through here - the
        // list this binds to is already filtered to !IsCompleted.
        await LoadAsync();

        if (value)
            _ = PushService.SendToGroupAsync(Db, _group!.Id, _me!.Name, "✅ Opgave færdig", $"{_me.Name}: {a.Title}");
    }

    private async Task ToggleAssigneeAsync(Assignment a, string name, bool isChecked)
    {
        var names = a.Assignees;
        if (isChecked) { if (!names.Contains(name, StringComparer.OrdinalIgnoreCase)) names.Add(name); }
        else names.RemoveAll(n => string.Equals(n, name, StringComparison.OrdinalIgnoreCase));
        a.AssignedToNames = string.Join(';', names);
        await Db.SaveChangesAsync();

        if (isChecked && !string.Equals(name, _me!.Name, StringComparison.Ordinal))
            _ = PushService.SendToGroupAsync(Db, _group!.Id, _me.Name, "👋 Opgave tildelt", $"{_me.Name}: {name} skal klare \"{a.Title}\"");
    }

    private async Task OnTaskKeyDown(KeyboardEventArgs e, Guid mainTaskId)
    {
        if (e.Key != "Enter") return;
        var title = _newTaskTitle.GetValueOrDefault(mainTaskId, "").Trim();
        if (title.Length == 0) return;

        Db.Assignments.Add(new Assignment
        {
            GroupId = _group!.Id,
            MainTaskId = mainTaskId,
            Title = title,
            CreatedByName = _me!.Name,
        });
        await Db.SaveChangesAsync();
        _newTaskTitle[mainTaskId] = "";
        await LoadAsync();

        _ = PushService.SendToGroupAsync(Db, _group.Id, _me.Name, "✅ Ny opgave", $"{_me.Name}: {title}");
    }

    private void StartEditTask(Assignment a)
    {
        _editingTaskId = a.Id;
        _editTaskTitle = a.Title;
    }

    private async Task SaveTaskAsync(Assignment a)
    {
        var title = _editTaskTitle.Trim();
        if (title.Length > 0) a.Title = title;
        await Db.SaveChangesAsync();
        _editingTaskId = null;
        await LoadAsync();
    }

    private async Task OnTaskEditKeyDown(KeyboardEventArgs e, Assignment a)
    {
        if (e.Key == "Enter") await SaveTaskAsync(a);
        else if (e.Key == "Escape") _editingTaskId = null;
    }

    private async Task DeleteTaskAsync(Assignment a)
    {
        Db.Assignments.Remove(a);
        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    private void StartEditColumn(MainTask col)
    {
        _editingColumnId = col.Id;
        _editColumnTitle = col.Title;
    }

    private async Task SaveColumnAsync(MainTask col)
    {
        var title = _editColumnTitle.Trim();
        if (title.Length > 0) col.Title = title;
        await Db.SaveChangesAsync();
        _editingColumnId = null;
        await LoadAsync();
    }

    private async Task OnColumnEditKeyDown(KeyboardEventArgs e, MainTask col)
    {
        if (e.Key == "Enter") await SaveColumnAsync(col);
        else if (e.Key == "Escape") _editingColumnId = null;
    }

    private async Task DeleteColumnAsync(MainTask col)
    {
        // Cascade: deleting a column takes its tasks (open and completed)
        // with it - there's no "uncategorized" bucket to fall back to here,
        // unlike Club's Assignments board.
        var inColumn = await Db.Assignments.Where(a => a.MainTaskId == col.Id).ToListAsync();
        Db.Assignments.RemoveRange(inColumn);
        Db.MainTasks.Remove(col);
        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task LeaveAsync()
    {
        await Js.InvokeVoidAsync("aeroJs.clearSession");
        Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true);
    }

    private async Task EnablePushAsync()
    {
        try
        {
            var publicKey = PushService.GetPublicKey();
            var status = await Js.InvokeAsync<string>("aeroJs.subscribePush", publicKey, _group!.Id, _me!.Name);
            _pushStatusMessage = status switch
            {
                "granted" => "🔔 Notifikationer er slået til på denne enhed.",
                "denied" => "🔕 Du har blokeret notifikationer for denne side. Åbn browserens side-indstillinger (tryk på hængelåsen/ikonet ved adressen) → Notifikationer → Tillad, og prøv igen.",
                "unsupported" => "⚠️ Denne browser understøtter ikke notifikationer her. På iPhone: åbn siden i Safari, tryk Del → 'Føj til hjemmeskærm', og brug appen derfra.",
                _ => "❌ Noget gik galt. Prøv igen, eller genindlæs siden.",
            };
        }
        catch { _pushStatusMessage = "❌ Noget gik galt. Prøv igen, eller genindlæs siden."; }
    }

    // Same cycling pastel palette as Club's MainTaskColor, so a new column
    // always gets a distinct tint rather than a stored-per-item color that
    // would need migrating on reorder.
    private static readonly string[] ColumnColors =
    [
        "rgba(99,102,241,.10)",  // indigo
        "rgba(16,185,129,.10)",  // green
        "rgba(245,158,11,.10)",  // amber
        "rgba(236,72,153,.10)",  // pink
        "rgba(56,189,248,.10)",  // sky
        "rgba(248,113,113,.10)", // red
        "rgba(168,85,247,.10)",  // purple
        "rgba(163,163,163,.10)", // gray
    ];

    private static string ColumnColor(int index) => ColumnColors[index % ColumnColors.Length];
}
