@page "/"
@inject NewsFeed News
@inject IJSRuntime JS

<PageTitle>Nyheder</PageTitle>

<section class="nh-intro">
    <h1>Nyheder</h1>
    <p class="k-help">De nyeste nyheder fra dine kilder, nyeste først – og så er listen færdig. Tryk på en nyhed for at læse den.
        Tryk <b>Kilder</b> øverst for at vælge kilder og antal.</p>
    @if (!_loading && _items.Count > 0)
    {
        <p class="k-muted">@_items.Count nyheder fra @_sourceCount @(_sourceCount == 1 ? "kilde" : "kilder")</p>
    }
</section>

<ProblemPurposeBanner
    Problem="Doomscrolling - vi kan ikke styre det, og nu er TV2 også begyndt."
    Formaal="Afgræns nyhedsstrømmen, så den ikke æder dagen." />

@if (_loading)
{
    <div class="k-card" data-nofold><p class="k-muted">Henter de nyeste nyheder…</p></div>
}
else if (_items.Count == 0)
{
    <div class="k-card" data-nofold>
        <div class="k-card-title">Ingen nyheder lige nu</div>
        <p class="k-help">Enten er alle kilder slået fra, eller de svarer ikke. Slå mindst én kilde til under Kilder.</p>
        <a class="k-btn k-btn-primary" href="/settings">Vælg kilder</a>
    </div>
}
else
{
    <div class="nh-list">
        @foreach (var item in _items)
        {
            <a class="k-card nh-item" href="/article/@item.Id">
                <div class="nh-text">
                    <div class="nh-meta">
                        <span class="nh-source" style="--src:@item.SourceColor">@item.SourceName</span>
                        <span class="k-muted">@item.TimeAgo(News.Now)</span>
                        @if (item.HasAudio) { <span class="k-tag">Lyd</span> }
                    </div>
                    <div class="nh-title">@item.Title</div>
                    @if (item.Description.Length > 0) { <div class="nh-desc">@item.Description</div> }
                </div>
                @if (item.HasImage) { <img class="nh-img" src="@item.ImageUrl" alt="" loading="lazy" /> }
            </a>
        }
    </div>
    <div class="k-card nh-done" data-nofold>
        <div class="k-card-title">Du er opdateret</div>
        <p class="k-help">Det var de @_items.Count nyeste. Kom tilbage senere, eller opdatér siden for at se, om der er nyt.</p>
    </div>
}

@code {
    private List<NewsItem> _items = [];
    private bool _loading = true;
    private int _sourceCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var choice = await BrowserChoice.LoadAsync(JS);
        _sourceCount = choice.ActiveSources.Count();
        _items = await News.FrontPageAsync(choice);
        _loading = false;
        StateHasChanged();
    }
}
