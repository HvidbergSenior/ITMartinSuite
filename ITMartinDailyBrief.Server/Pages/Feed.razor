@page "/"
@inject NewsFeed News
@inject IJSRuntime JS

<PageTitle>Nyheder</PageTitle>

<section class="nh-intro">
    <h1>Nyheder</h1>
    <p class="k-help">De nyeste nyheder fra dine kilder, nyeste først – og så er listen færdig. Tryk på en nyhed for at læse den.
        Vil du kun læse om ét emne, så skriv det i boksen herunder. Tryk <b>Kilder</b> øverst for at vælge kilder og antal.</p>
    @if (!_loading && _items.Count > 0)
    {
        <p class="k-muted">@_items.Count nyheder fra @_sourceCount @(_sourceCount == 1 ? "kilde" : "kilder")@(_topics.Length > 0 ? $" – kun om {_topics}" : "")</p>
    }
</section>

<div class="k-card nh-topics" data-fold-closed>
    <div class="k-card-title">Kun nyheder om …</div>
    <p class="k-help">Skriv det, du vil læse om, fx <b>Trump</b>. Flere emner: sæt komma imellem (fx <b>Trump, Ukraine</b>).
        Tom = alle nyheder. Gemmes kun på denne telefon eller computer.</p>
    <form class="nh-topic-row" @onsubmit="ShowTopicsAsync">
        <input class="k-input" placeholder="fx Trump" aria-label="Emner" @bind="_topicInput" @bind:event="oninput" />
        <button class="k-btn k-btn-primary" type="submit" disabled="@_loading">Vis</button>
    </form>
    @if (_topics.Length > 0)
    {
        <button class="k-btn k-btn-sm k-btn-ghost k-mt" disabled="@_loading" @onclick="ClearTopicsAsync">Vis alle nyheder igen</button>
    }
</div>

<ProblemPurposeBanner
    Problem="Doomscrolling - vi kan ikke styre det, og nu er TV2 også begyndt."
    Formaal="Afgræns nyhedsstrømmen, så den ikke æder dagen." />

@if (_loading)
{
    <div class="k-card" data-nofold><p class="k-muted">Henter de nyeste nyheder…</p></div>
}
else if (_items.Count == 0 && _topics.Length > 0)
{
    <div class="k-card" data-nofold>
        <div class="k-card-title">Ingen nyheder om @_topics lige nu</div>
        <p class="k-help">Ingen af de nyeste nyheder fra dine kilder handler om det. Prøv et andet ord, eller slå flere kilder til under Kilder.</p>
        <button class="k-btn" @onclick="ClearTopicsAsync">Vis alle nyheder</button>
    </div>
}
else if (_items.Count == 0)
{
    <div class="k-card" data-nofold>
        <div class="k-card-title">Ingen nyheder lige nu</div>
        <p class="k-help">Enten er alle kilder slået fra, eller de svarer ikke. Slå mindst én kilde til under Kilder.</p>
        <a class="k-btn k-btn-primary" href="/settings">Vælg kilder</a>
    </div>
}
else
{
    <div class="nh-list">
        @foreach (var item in _items)
        {
            <a class="k-card nh-item" href="/article/@item.Id">
                <div class="nh-text">
                    <div class="nh-meta">
                        <span class="nh-source" style="--src:@item.SourceColor">@item.SourceName</span>
                        <span class="k-muted">@item.TimeAgo(News.Now)</span>
                        @if (item.HasAudio) { <span class="k-tag">Lyd</span> }
                    </div>
                    <div class="nh-title">@item.Title</div>
                    @if (item.Description.Length > 0) { <div class="nh-desc">@item.Description</div> }
                </div>
                @if (item.HasImage) { <img class="nh-img" src="@item.ImageUrl" alt="" loading="lazy" /> }
            </a>
        }
    </div>
    <div class="k-card nh-done" data-nofold>
        <div class="k-card-title">Du er opdateret</div>
        <p class="k-help">Det var de @_items.Count nyeste. Kom tilbage senere, eller opdatér siden for at se, om der er nyt.</p>
    </div>
}

@code {
    private List<NewsItem> _items = [];
    private bool _loading = true;
    private int _sourceCount;
    private ReaderChoice? _choice;
    private string _topics = "", _topicInput = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _choice = await BrowserChoice.LoadAsync(JS);
        _topicInput = _choice.Topics.AsText;
        await LoadAsync();
    }

    private async Task ShowTopicsAsync()
    {
        if (_choice is null) return;
        _choice.SetTopics(_topicInput);
        _topicInput = _choice.Topics.AsText;
        await BrowserChoice.SaveAsync(JS, _choice);
        await LoadAsync();
    }

    private async Task ClearTopicsAsync() { _topicInput = ""; await ShowTopicsAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _sourceCount = _choice!.ActiveSources.Count();
        _topics = _choice.Topics.AsText;
        _items = await News.FrontPageAsync(_choice);
        _loading = false;
        StateHasChanged();
    }
}
