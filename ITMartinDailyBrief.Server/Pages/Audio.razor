@page "/audio"
@rendermode InteractiveServer
@inject FeedService FeedSvc
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>DailyBrief — Go' Morgen P3</PageTitle>

<div class="brief-root">

    <header class="brief-header">
        <button class="brief-back-btn"
                @onclick='() => Nav.NavigateTo("/", forceLoad: true)'>
            ← Tilbage
        </button>

        <span class="brief-logo">Go' Morgen P3</span>
    </header>

    @if (_loading)
    {
        <div class="brief-empty">
            <p>Henter episoder…</p>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="brief-empty">
            <p>Ingen episoder fundet.</p>
        </div>
    }
    else
    {
        <div class="brief-feed">

            @foreach (var item in _items)
            {
                <div class="brief-card">

                    <div class="brief-card-text">

                        <div class="brief-card-meta">

                            <span class="brief-source-badge"
                                  style="background:@item.SourceColor">
                                @item.SourceName
                            </span>

                            <span class="brief-time">
                                @item.Published.ToLocalTime().ToString("d. MMM yyyy")
                            </span>

                        </div>

                        <div class="brief-card-title">
                            @item.Title
                        </div>

                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <div class="brief-card-desc">
                                @item.Description
                            </div>
                        }

                        @if (item.HasAudio)
                        {
                            <div style="margin-top:12px">

                                <audio controls
                                       preload="none"
                                       style="width:100%">
                                    <source src="@item.AudioUrl" />
                                    Din browser understøtter ikke lydafspilning.
                                </audio>

                                <div style="margin-top:8px">
                                    <a href="@item.AudioUrl"
                                       target="_blank"
                                       download
                                       class="brief-settings-btn">
                                        ↓ Download lyd
                                    </a>
                                </div>

                            </div>
                        }
                        else
                        {
                            <div style="margin-top:8px;color:#777">
                                Ingen lydfil fundet
                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>

@code {

    private List<FeedItem> _items = [];
    private bool _loading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        StateHasChanged();

        var sources = await LoadSourcesAsync();

        var p3 = sources.FirstOrDefault(s =>
            s.Name.Equals(
                "Go' Morgen P3",
                StringComparison.OrdinalIgnoreCase));

        if (p3 is not null)
        {
            // Hent langt flere end forsiden.
            _items = await FeedSvc.GetItemsAsync(
                new[] { p3 },
                100);
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task<List<FeedSource>> LoadSourcesAsync()
    {
        var sources = FeedSource.Presets.ToList();

        foreach (var s in sources)
        {
            var raw =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    $"brief_source_{s.Id}");

            s.Enabled =
                raw == null || raw == "true";
        }

        var customJson =
            await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "brief_custom_sources");

        if (!string.IsNullOrEmpty(customJson))
        {
            try
            {
                var customs =
                    System.Text.Json.JsonSerializer
                        .Deserialize<List<CustomSourceDto>>(
                            customJson);

                if (customs is not null)
                {
                    foreach (var c in customs)
                    {
                        var raw =
                            await JS.InvokeAsync<string?>(
                                "localStorage.getItem",
                                $"brief_source_{c.Id}");

                        sources.Add(new FeedSource
                        {
                            Id = c.Id,
                            Name = c.Name,
                            RssUrl = c.Url,
                            Enabled =
                                raw == null ||
                                raw == "true"
                        });
                    }
                }
            }
            catch
            {
            }
        }

        return sources;
    }

    private record CustomSourceDto(
        string Id,
        string Name,
        string Url);
}