@page "/settings"
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Nyheder – kilder</PageTitle>

<a class="k-btn k-btn-sm nh-back" href="/">Tilbage til nyhederne</a>

<section class="nh-intro">
    <h1>Dine kilder</h1>
    <p class="k-help">Vælg hvor mange nyheder du vil se, og hvilke kilder de kommer fra. Tryk <b>Gem</b> nederst.
        Valget gemmes kun på denne telefon eller computer – ikke hos os.</p>
</section>

@if (_choice is null)
{
    <div class="k-card" data-nofold><p class="k-muted">Henter dine valg…</p></div>
}
else
{
    <div class="k-card">
        <div class="k-card-title">Antal nyheder</div>
        <p class="k-help">Listen slutter efter dette antal – så bliver du færdig.</p>
        <div class="k-row">
            @foreach (var n in ReaderChoice.Counts)
            {
                <button class="k-btn @(_choice.MaxItems == n ? "k-btn-primary" : "")" @onclick="() => _choice.SetCount(n)">@n</button>
            }
        </div>
    </div>

    <div class="k-card">
        <div class="k-card-title">Kilder</div>
        <p class="k-help">Sæt flueben ved de kilder, du vil have nyheder fra.</p>
        <ul class="nh-sources">
            @foreach (var s in _choice.AllSources)
            {
                <li>
                    <label>
                        <input type="checkbox" checked="@_choice.IsOn(s)" @onchange="e => _choice.Switch(s, e.Value is true)" />
                        <span class="nh-source" style="--src:@s.Color">@s.Name</span>
                    </label>
                    @if (!s.IsPreset) { <button class="k-btn k-btn-sm k-btn-ghost" @onclick="() => _choice.RemoveCustom(s.Id)">Fjern</button> }
                </li>
            }
        </ul>
    </div>

    <div class="k-card">
        <div class="k-card-title">Tilføj din egen kilde</div>
        <p class="k-help">Mange nyhedssider har en RSS-adresse (søg på "sidens navn RSS"). Skriv et navn og indsæt adressen.</p>
        <label class="k-label" for="nh-name">Navn</label>
        <input id="nh-name" class="k-input" placeholder="fx Zetland" @bind="_newName" @bind:event="oninput" />
        <label class="k-label" for="nh-url">RSS-adresse</label>
        <input id="nh-url" class="k-input" placeholder="https://…" type="url" @bind="_newUrl" @bind:event="oninput" />
        <button class="k-btn k-mt" disabled="@(_newName.Trim().Length == 0 || _newUrl.Trim().Length == 0)" @onclick="Add">Tilføj kilden</button>
        @if (_addNote.Length > 0) { <p class="k-muted">@_addNote</p> }
    </div>

    <button class="k-btn k-btn-primary k-btn-block" @onclick="SaveAsync">Gem og se nyhederne</button>
}

@code {
    private ReaderChoice? _choice;
    private string _newName = "", _newUrl = "", _addNote = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _choice = await BrowserChoice.LoadAsync(JS);
        StateHasChanged();
    }

    private void Add()
    {
        if (_choice!.AddCustom(_newName, _newUrl)) { _newName = _newUrl = ""; _addNote = "Kilden er tilføjet – husk at trykke Gem."; }
        else _addNote = "Adressen skal starte med https:// (og du kan højst have " + ReaderChoice.MaxCustom + " egne kilder).";
    }

    private async Task SaveAsync()
    {
        await BrowserChoice.SaveAsync(JS, _choice!);
        Nav.NavigateTo("/");
    }
}
