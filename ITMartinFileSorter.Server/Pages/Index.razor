@page "/filesorter"

@using ITMartin.Media.Application.Pipelines.QuickSort.Models
@using ITMartin.Media.Application.Pipelines.QuickSort.Services
@using ITMartin.Media.Contracts.Contracts.Runtime.Helpers
@using ITMartin.Media.Contracts.Contracts.Runtime.Interfaces
@using ITMartin.Media.Contracts.Contracts.Runtime.Models
@using ITMartin.Media.Contracts.Contracts.Runtime.Services
@using ITMartin.Media.Contracts.Entities
@using ITMartin.Media.Contracts.Contracts.Runtime.Requests
@using ITMartin.Media.Contracts.Contracts.Runtime.Requests.QuickSort
@using ITMartin.Media.Contracts.Contracts.Runtime.Requests.AnalogDigitize
@using ITMartinFileSorter.Server.Services
@using Microsoft.JSInterop
@implements IDisposable

@inject ProgressService Progress
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject ILogger<Index> Logger
@inject IQuickSortClient QuickSortClient
@inject IAnalogDigitizeClient AnalogDigitizeClient
@inject QuickSortManifestSummaryService ManifestSummaryService
@inject ILibraryPolishService LibraryPolishService
@inject IStaticGalleryExportService GalleryExportService
@inject IGalleryThumbnailService GalleryThumbnailService
@inject ISmartFoldersService SmartFoldersService
@inject IFaceIndexService FaceIndexService
@inject IImageTaggingService ImageTaggingService
@inject IJSRuntime JS
@inject FileSorterPushService PushService

<PageLayout Title="📦 QuickSort — Oprydning & Struktur">

    <div class="filesorter-app">

        <div class="info-toggle-row">
            <button class="info-toggle-btn" @onclick="TogglePush" disabled="@_pushBusy">
                @(_pushSubscribed ? "🔕 Slå notifikationer fra" : "🔔 Få besked når QuickSort er færdig")
            </button>
            <button class="info-toggle-btn" @onclick="ToggleInfo">
                @(_showInfo ? "🙈 Skjul info" : "ℹ️ Vis info")
            </button>
        </div>

        @if (_showInfo)
        {
            <ProblemPurposeBanner
                Problem="Billeder og videoer fra telefoner og gamle harddiske ender tit som en stor, rodet bunke uden dato eller struktur — svært at finde noget i, og svært at vide hvad der egentlig er gemt og sikkert."
                Formaal="FileSorter scanner mappen, fjerner dubletter og organiserer automatisk alt efter dato i et rent, gennemsøgeligt bibliotek du kan bladre i."
                Beskrivelse="Peg på kildemappen og tryk 'Start Cleanup' for at køre QuickSort (sortering + oprydning). Kør derefter eventuelt AI-forbedring (AnalogDigitize) og Temamapper-tilkøbene nedenfor (Rejser, Årbog, Find personer m.fl.), når biblioteket er klar." />
        }

        <ContentCard CssClass="scan-hero-card">

            <h2 class="mb-3">
                Oprydning & Struktur
            </h2>

            <p class="hero-text">
                Scan, fjern dubletter og organiser dine mediefiler.
            </p>

            <div class="scan-action-row">
                <button class="btn btn-primary btn-lg"
                        disabled="@IsScanning"
                        @onclick="ScanFolder">
                    @(IsScanning ? Progress.Info.Stage : "Start oprydning")
                </button>
                @if (!string.IsNullOrWhiteSpace(FolderPath))
                {
                    <span class="scan-source-label">📂 @FolderPath</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="text-danger mt-2">
                    @ErrorMessage
                </div>
            }

        </ContentCard>

        @if (ShowScanning)
        {
            <ProgressPanel
                Title="@Progress.Info.Stage"
                Current="@Progress.Info.WorkDone"
                Total="@Progress.Info.TotalWork"
                Percent="@ProgressPercent"
                CurrentItem="@CurrentFileName"
                LoadingText="Behandler filer..."
                Icon="📂" />

            @if (_waitingSeconds > 0)
            {
                <div class="scan-waiting-msg">
                    ⏳ Venter på at workeren bliver færdig… @_waitingSeconds s
                </div>
            }
        }

        @if (ShowSummary)
        {
            <SectionTitle Title="Oprydningsoversigt" />

            <div class="main-category-row mt-3">

                @foreach (var cat in CategoryOrder)
                {
                    var filesInCat =
                        ScanResult!.Files
                            .Where(f =>
                                CategoryHelper
                                    .GetCategory(f) == cat)
                            .ToList();

                    var totalSize =
                        filesInCat
                            .Where(f =>
                                f.Status !=
                                MediaFileStatus.ToDelete)
                            .Sum(f =>
                                f.SizeBytes);

                    <CategorySummaryCard
                        Title="@CategoryLabel(cat)"
                        ReviewCount="0"
                        ProcessedCount="@filesInCat.Count"
                        Total="@filesInCat.Count"
                        SizeText="@FormatSize(totalSize)"
                        CssClass="@GetCategoryCssClass(cat)"
                        OnClick="@(e => {})" />
                }

            </div>

            <ContentCard CssClass="mt-4">

                <div class="summary-grid">

                    <div class="summary-box">
                        <div class="summary-title">
                            Filer i alt
                        </div>

                        <div class="summary-value">
                            @ScanResult!.TotalFiles
                        </div>
                    </div>

                    <div class="summary-box">
                        <div class="summary-title">
                            Filer der beholdes
                        </div>

                        <div class="summary-value">
                            @ScanResult!.KeepCount
                        </div>
                    </div>

                    <div class="summary-box">
                        <div class="summary-title">
                            Filer der slettes
                        </div>

                        <div class="summary-value">
                            @ScanResult!.DeleteCount
                        </div>
                    </div>

                    <div class="summary-box">
                        <div class="summary-title">
                            Dublet-grupper
                        </div>

                        <div class="summary-value">
                            @ScanResult!.DuplicateGroups
                        </div>
                    </div>

                    <div class="summary-box">
                        <div class="summary-title">
                            Samlet størrelse
                        </div>

                        <div class="summary-value">
                            @FormatSize(
                                ScanResult!.TotalBytes)
                        </div>
                    </div>

                    <div class="summary-box">
                        <div class="summary-title">
                            Plads sparet
                        </div>

                        <div class="summary-value">
                            @FormatSize(
                                ScanResult!.BytesToDelete)
                        </div>
                    </div>

                </div>

            </ContentCard>

            @if (_finishingStage is not null)
            {
                <ActionButtonBar CssClass="bottom export-bar">
                    <div class="export-status">
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>@_finishingStage</span>
                    </div>
                </ActionButtonBar>
            }
            else if (_pipelineComplete)
            {
                <ActionButtonBar CssClass="bottom export-bar">

                    <div class="export-status">
                        <span class="text-success">
                            ✔ Klar — biblioteket er organiseret og galleriet er bygget
                        </span>
                        <div class="text-muted" style="font-size:13px;margin-top:4px">
                            📁 Lokalt kun indtil videre — kør de Temamapper-tilkøb nedenfor du vil have <strong>først</strong>
                            (de kører kun lokalt; at tilføje dem senere kræver at hente biblioteket ned fra NAS'en igen).
                            Synk derefter til NAS'en for at se det på gallery.itmartin.dk (se sync-note nederst).
                        </div>
                    </div>

                    <span class="spacer"></span>
                </ActionButtonBar>

                @if (_livePhotoStats is { Count: > 0 } stats)
                {
                    <ContentCard CssClass="mt-3">
                        <SectionTitle Title="🎬 Live Photos — videoklip" />
                        <p class="mt-2">
                            <strong>@stats.Count</strong> Live Photo-videoklip fundet, i alt <strong>@FormatSize(stats.TotalBytes)</strong>.
                            Selve billederne ligger allerede i de almindelige mapper uanset hvad du vælger her —
                            dette handler kun om de ekstra bevægelsesklip de fleste ikke ved de har.
                        </p>
                        <div style="display:flex;gap:10px">
                            <button class="btn btn-outline-secondary" disabled="@(_addonBusy is not null)" @onclick="KeepLivePhotoVideosAsync">
                                Behold videoklip
                            </button>
                            <button class="btn btn-outline-danger" disabled="@(_addonBusy is not null)" @onclick="DeleteLivePhotoVideosAsync">
                                @(_addonBusy == "LivePhotos" ? "⏳ Sletter..." : $"🗑 Slet videoklip (frigør {FormatSize(stats.TotalBytes)})")
                            </button>
                        </div>
                    </ContentCard>
                }

                <ContentCard CssClass="mt-3">
                    <SectionTitle Title="Temamapper (valgfrit) — kør disse før du synker til NAS" />
                    <div class="addon-row" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:10px">

                        <button class="btn btn-outline-primary"
                                disabled="@(_addonBusy is not null)"
                                @onclick="RunRejserAsync">
                            @(_addonBusy == "Rejser" ? "⏳ Rejser..." : "🧳 Rejser")
                        </button>

                        <span style="display:flex;gap:6px;align-items:center">
                            <input type="number" class="form-control" style="width:90px"
                                   @bind="_yearbookYear" disabled="@(_addonBusy is not null)" />
                            <button class="btn btn-outline-primary"
                                    disabled="@(_addonBusy is not null)"
                                    @onclick="RunAarbogAsync">
                                @(_addonBusy == "Årbog" ? "⏳ Årbog..." : "📖 Årbog")
                            </button>
                            <button class="btn btn-outline-primary"
                                    disabled="@(_addonBusy is not null)"
                                    @onclick="RunAarbogTekstAsync">
                                @(_addonBusy == "AI-billedtekster" ? "⏳ Skriver tekster..." : "✍️ AI-billedtekster")
                            </button>
                        </span>

                        <button class="btn btn-outline-primary"
                                disabled="@(_addonBusy is not null)"
                                @onclick="RunFindPeopleAsync">
                            @(_addonBusy == "Efter person" ? "⏳ Finder personer..." : "🔍 Find personer")
                        </button>

                        <button class="btn btn-outline-primary"
                                disabled="@(_addonBusy is not null)"
                                @onclick="RunTagImagesAsync">
                            @(_addonBusy == "Søgning & mærker" ? "⏳ Mærker billeder..." : "🔍🏷️ Søgning & mærker")
                        </button>

                        <button class="btn btn-outline-primary"
                                disabled="@(_addonBusy is not null)"
                                @onclick="RunBestOfBurstAsync">
                            @(_addonBusy == "Bedste billede" ? "⏳ Finder bedste billeder..." : "⭐ Bedste billede")
                        </button>

                        <button class="btn btn-outline-primary"
                                disabled="@(_addonBusy is not null)"
                                @onclick="RunTraditionsAsync">
                            @(_addonBusy == "Traditioner" ? "⏳ Finder traditioner..." : "🎄 Traditioner")
                        </button>

                        <button class="btn btn-outline-primary"
                                disabled="@(_addonBusy is not null)"
                                @onclick="RunFixOrientationAsync">
                            @(_addonBusy == "Ret rotation" ? "⏳ Retter rotation..." : "🔄 Ret rotation")
                        </button>

                    </div>

                    @if (_bestShotResult is { } bestShot)
                    {
                        <div class="text-muted mt-2">
                            ⭐ @bestShot.BurstsFound serier fundet, @bestShot.PhotosPicked billeder valgt som de bedste.
                        </div>
                    }

                    @if (_traditionResults is { Count: > 0 } traditions)
                    {
                        <div class="text-muted mt-2">
                            🎄 @foreach (var t in traditions)
                            {
                                <span>@t.Name (@t.YearsFound år, @t.PhotoCount billeder)@(t == traditions[^1] ? "" : ", ")</span>
                            }
                        </div>
                    }
                    else if (_traditionResults is not null)
                    {
                        <div class="text-muted mt-2">Ingen tradition fundet med billeder fra mindst 2 forskellige år.</div>
                    }

                    @if (_taggingResult is { } tagging)
                    {
                        <div class="text-muted mt-2">
                            🏷️ @tagging.TaggedCount nye billeder mærket, @tagging.AlreadyTaggedCount var allerede mærket, @tagging.TotalImages billeder i alt.
                            Tryk igen for kun at mærke nye billeder (skifter ikke de allerede mærkede).
                        </div>
                    }

                    @if (_orientationResult is { } orientation)
                    {
                        <div class="text-muted mt-2">
                            🔄 @orientation.PhotosChecked billeder tjekket, @orientation.PhotosRotated rettet.
                            @if (orientation.RemainingCount > 0)
                            {
                                <text>@orientation.RemainingCount mangler stadig - tryk igen for at fortsætte.</text>
                            }
                        </div>
                    }

                    @if (_discoveredClusters is { Count: > 0 })
                    {
                        <div class="cluster-list" style="margin-top:16px;display:flex;flex-direction:column;gap:10px">
                            @foreach (var cluster in _discoveredClusters)
                            {
                                <div style="display:flex;gap:10px;align-items:center;border:1px solid var(--border);border-radius:8px;padding:8px 12px">
                                    <span>👤 @cluster.PhotoCount fotos — @System.IO.Path.GetFileName(cluster.SampleMediaFilePath)</span>
                                    <input type="text" class="form-control" style="max-width:200px"
                                           placeholder="Navn..."
                                           @bind="_clusterNames[cluster]" @bind:event="oninput" />
                                    <button class="btn btn-sm btn-primary"
                                            disabled="@(string.IsNullOrWhiteSpace(GetClusterName(cluster)) || _addonBusy is not null)"
                                            @onclick="() => NameClusterAsync(cluster)">
                                        Navngiv
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else if (_discoveredClusters is not null)
                    {
                        <div class="text-muted mt-2">Ingen tydelige, ikke-navngivne personer fundet (mindst 3 fotos kræves pr. person).</div>
                    }
                </ContentCard>

                <ActionButtonBar CssClass="bottom export-bar">
                    <button class="btn btn-primary btn-lg"
                            @onclick="ContinueToEnhancement">
                        ✨ Fortsæt til Forbedring
                    </button>
                    <span class="spacer"></span>
                    <div class="text-muted" style="font-size:13px;max-width:420px">
                        📤 Sidste trin: synk til NAS'en (samme tar+scp-mønster som Mie/Vibeke/Jørgen), og genudrul gallery-web
                        med denne klients Galleries-indgang (allerede tilføjet i docker-compose.yaml, sæt en rigtig adgangskode først).
                    </div>
                </ActionButtonBar>
            }
            else
            {
                <ActionButtonBar CssClass="bottom export-bar">
                    <div class="export-status">
                        <span class="text-success">
                            ✔ Oprydning gennemført
                        </span>
                    </div>
                </ActionButtonBar>
            }

        }

    </div>

</PageLayout>

@code {

    private bool _showInfo = true;

    private bool _pushSubscribed;
    private bool _pushBusy;

    private string FolderPath = "";

    private bool IsScanning;

    private string CurrentFileName = "";

    private string ErrorMessage = "";

    private int _waitingSeconds;

    private QuickSortScanResult? ScanResult;

    private int ProgressPercent =>
        Progress.Info.TotalWork == 0
            ? 1
            : (int)((double)
                Progress.Info.WorkDone /
                Progress.Info.TotalWork * 100);

    private bool ShowScanning =>
        IsScanning ||
        Progress.Info.WorkDone > 0;

    private bool ShowSummary =>
        !IsScanning &&
        ScanResult != null;

    private readonly string[] CategoryOrder =
    [
        "Audio",
        "Documents",
        "Images",
        "Videos",
        "Screenshots"
    ];

    protected override void OnInitialized()
    {
        Progress.OnChange +=
            HandleProgressChanged;

        var source =
            Configuration[
                "MediaSettings:SourceRoot"];

        if (!string.IsNullOrWhiteSpace(source))
        {
            FolderPath = source;
        }
    }

    private void HandleProgressChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "filesorter_show_info");
        if (stored == "hidden")
        {
            _showInfo = false;
            StateHasChanged();
        }

        try
        {
            await JS.InvokeVoidAsync("fileSorterPush.registerServiceWorker");
            var endpoint = await JS.InvokeAsync<string?>("fileSorterPush.getSubscriptionEndpoint");
            _pushSubscribed = !string.IsNullOrWhiteSpace(endpoint);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Push isn't supported in every browser/context - fail quietly,
            // the toggle button just stays in its "off" state.
            Logger.LogWarning(ex, "Push subscription status check failed");
        }
    }

    private async Task TogglePush()
    {
        if (_pushBusy) return;
        _pushBusy = true;
        StateHasChanged();

        try
        {
            if (_pushSubscribed)
            {
                await JS.InvokeVoidAsync("fileSorterPush.unsubscribeFromPush");
                _pushSubscribed = false;
            }
            else
            {
                var permission = await JS.InvokeAsync<string>("fileSorterPush.requestPushPermission");
                if (permission == "granted")
                {
                    var publicKey = PushService.GetPublicKey();
                    var endpoint = await JS.InvokeAsync<string?>("fileSorterPush.subscribeForPush", publicKey);
                    _pushSubscribed = !string.IsNullOrWhiteSpace(endpoint);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Push toggle failed");
        }
        finally
        {
            _pushBusy = false;
            StateHasChanged();
        }
    }

    private void ToggleInfo()
    {
        // Fire-and-forget the localStorage write - awaiting it here made the
        // toggle visibly lag behind the click, since Blazor doesn't re-render
        // until the handler completes and this JS round-trip isn't needed
        // before the UI can update.
        _showInfo = !_showInfo;
        _ = JS.InvokeVoidAsync("localStorage.setItem", "filesorter_show_info", _showInfo ? "shown" : "hidden");
    }

    public void Dispose()
    {
        Progress.OnChange -=
            HandleProgressChanged;
    }

    private async Task ScanFolder()
    {
        if (IsScanning)
            return;

        ErrorMessage = "";

        if (string.IsNullOrWhiteSpace(FolderPath))
        {
            ErrorMessage = "Ingen kildemappe konfigureret (MediaSettings:SourceRoot).";
            return;
        }

        try
        {
            IsScanning = true;

            ScanResult = null;

            await InvokeAsync(
                StateHasChanged);

            Logger.LogInformation(
                "Starting QuickSort scan");

            var paths =
                Directory
                    .EnumerateFiles(
                        FolderPath,
                        "*.*",
                        SearchOption
                            .AllDirectories)
                    .Count();

            Progress.Start(
                "Scanning files...",
                paths);

        var scanStartedAt = DateTime.UtcNow;

        await QuickSortClient.StartAsync(
        new StartQuickSortRequest
        {
        SourceLibraryPath =
        FolderPath,

        WorkingDirectory =
        Path.Combine(
        FolderPath,
        ".quicksort"),

        EnableDeduplication =
        true,

        EnableAiClassification =
        false,

        EnableOcr =
        false,

        Profile =
        "QuickSort"
        },
        CancellationToken.None);
            Logger.LogInformation(
                "Workflow enqueued");

            var exportRoot =
                Configuration[
                    "MediaSettings:LibraryRoot"];

            _waitingSeconds = 0;
            for (var i = 0; i < 300; i++)
            {
                _waitingSeconds = i + 1;
                await InvokeAsync(StateHasChanged);

                var manifestPath =
                    Path.Combine(
                        exportRoot!,
                        "manifest.json");

                if (File.Exists(manifestPath) &&
                    File.GetLastWriteTimeUtc(manifestPath) > scanStartedAt)
                {
                    ScanResult =
                        await ManifestSummaryService
                            .LoadAsync(
                                exportRoot,
                                CancellationToken.None);

                    IsScanning = false;
                    _waitingSeconds = 0;

                    await InvokeAsync(
                        StateHasChanged);

                    // QuickSort sort itself just finished (manifest.json written) -
                    // fire-and-forget so a slow/offline push send never blocks the
                    // UI from moving on to the default pipeline below.
                    _ = PushService.SendToAllAsync(
                        "📦 QuickSort færdig",
                        $"{ScanResult.TotalFiles} filer sorteret, {ScanResult.DuplicateGroups} dublet-grupper fundet.");

                    await RunDefaultPipelineAsync(exportRoot!);

                    break;
                }

                await Task.Delay(1000);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "QuickSort failed");

            ErrorMessage =
                ex.Message;
        }
        finally
        {
            await InvokeAsync(
                StateHasChanged);
        }
    }

    private string? _finishingStage;

    private bool _pipelineComplete;

    private string? _addonBusy;

    private int _yearbookYear = DateTime.UtcNow.Year;

    // Default one-click pipeline - QuickSort already scans+dedupes+classifies+
    // exports in one workflow (see QuickSortWorkflowDefinition), so everything
    // here runs automatically once that's done. AnalogDigitize (AI enhancement) and
    // every Temamapper add-on (Rejser/Årbog/Efter person) stay
    // explicitly opt-in, not part of the default run.
    private async Task RunDefaultPipelineAsync(string libraryPath)
    {
        try
        {
            _finishingStage = "Rydder op i biblioteket...";
            await InvokeAsync(StateHasChanged);
            await LibraryPolishService.PolishAsync(libraryPath);

            _finishingStage = "Bygger offline-galleri...";
            await InvokeAsync(StateHasChanged);
            await GalleryExportService.ExportAsync(libraryPath);

            _finishingStage = "Genererer miniaturer...";
            await InvokeAsync(StateHasChanged);
            await GalleryThumbnailService.GenerateAsync(libraryPath);

            _livePhotoStats = ComputeLivePhotoStats(libraryPath);

            _pipelineComplete = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Default pipeline failed");
            ErrorMessage = ex.Message;
        }
        finally
        {
            _finishingStage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string LibraryPath =>
        Configuration["MediaSettings:LibraryRoot"] ?? "";

    private sealed record LivePhotoStats(int Count, long TotalBytes);

    private LivePhotoStats? _livePhotoStats;

    // The still image half of a Live Photo stays in its normal category/date
    // folder - only the video-motion half gets segregated into LivePhotos/
    // (see LivePhotoDetectionWorkflowStep), so scanning just this one folder
    // is enough to size up "the part most people don't know they have."
    private static LivePhotoStats ComputeLivePhotoStats(string libraryPath)
    {
        var dir = Path.Combine(libraryPath, "LivePhotos");
        if (!Directory.Exists(dir)) return new LivePhotoStats(0, 0);

        var files = Directory.EnumerateFiles(dir, "*.*", SearchOption.AllDirectories).ToList();
        var totalBytes = files.Sum(f => new FileInfo(f).Length);
        return new LivePhotoStats(files.Count, totalBytes);
    }

    private Task KeepLivePhotoVideosAsync()
    {
        _livePhotoStats = null;
        return Task.CompletedTask;
    }

    private Task DeleteLivePhotoVideosAsync() =>
        RunAddonAsync("LivePhotos", () =>
        {
            var dir = Path.Combine(LibraryPath, "LivePhotos");
            if (Directory.Exists(dir))
                Directory.Delete(dir, recursive: true);

            _livePhotoStats = null;
            return Task.CompletedTask;
        });

    private async Task RunAddonAsync(string label, Func<Task> action)
    {
        if (_addonBusy is not null) return;

        try
        {
            _addonBusy = label;
            await InvokeAsync(StateHasChanged);
            await action();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Add-on {Label} failed", label);
            ErrorMessage = ex.Message;
        }
        finally
        {
            _addonBusy = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task RunRejserAsync() =>
        RunAddonAsync("Rejser", () => SmartFoldersService.GenerateTripFoldersAsync(LibraryPath));

    private Task RunAarbogAsync() =>
        RunAddonAsync("Årbog", () => SmartFoldersService.GenerateYearbookAsync(LibraryPath, _yearbookYear));

    private Task RunAarbogTekstAsync() =>
        RunAddonAsync("AI-billedtekster", () => SmartFoldersService.AddYearbookCaptionsAsync(LibraryPath, _yearbookYear));

    private ImageTaggingResult? _taggingResult;

    private Task RunTagImagesAsync() =>
        RunAddonAsync("Søgning & mærker", async () =>
        {
            _taggingResult = await ImageTaggingService.TagLibraryAsync(LibraryPath);
        });

    private BestShotResult? _bestShotResult;

    private Task RunBestOfBurstAsync() =>
        RunAddonAsync("Bedste billede", async () =>
        {
            _bestShotResult = await SmartFoldersService.PickBestShotsAsync(LibraryPath);
        });

    private List<TraditionResult>? _traditionResults;

    private Task RunTraditionsAsync() =>
        RunAddonAsync("Traditioner", async () =>
        {
            _traditionResults = await SmartFoldersService.GenerateTraditionsAsync(LibraryPath);
        });

    private OrientationFixResult? _orientationResult;

    private Task RunFixOrientationAsync() =>
        RunAddonAsync("Ret rotation", async () =>
        {
            _orientationResult = await LibraryPolishService.FixOrientationAsync(LibraryPath);
        });

    private List<UnnamedPersonCluster>? _discoveredClusters;

    private readonly Dictionary<UnnamedPersonCluster, string> _clusterNames = new();

    private string GetClusterName(UnnamedPersonCluster cluster) =>
        _clusterNames.TryGetValue(cluster, out var name) ? name : "";

    private Task RunFindPeopleAsync() =>
        RunAddonAsync("Efter person", async () =>
        {
            // Face indexing is skip-if-already-done (see IFaceIndexService docs),
            // so re-running "Find personer" after new photos are added is safe
            // and only processes what's new.
            await FaceIndexService.IndexFacesAsync(LibraryPath);
            _discoveredClusters = await FaceIndexService.DiscoverUnnamedPeopleAsync(LibraryPath);
        });

    private async Task NameClusterAsync(UnnamedPersonCluster cluster)
    {
        var name = GetClusterName(cluster);
        if (string.IsNullOrWhiteSpace(name) || _addonBusy is not null) return;

        await RunAddonAsync("Efter person", async () =>
        {
            var personId = await FaceIndexService.NamePersonFromClusterAsync(name, cluster.MediaFilePaths, LibraryPath);
            await SmartFoldersService.GeneratePersonFolderAsync(LibraryPath, personId);

            _discoveredClusters?.Remove(cluster);
            _clusterNames.Remove(cluster);
        });
    }

    private static string FormatSize(
        long bytes)
    {
        string[] sizes =
        [
            "B",
            "KB",
            "MB",
            "GB",
            "TB"
        ];

        double len = bytes;

        var order = 0;

        while (len >= 1024 &&
               order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }

        return
            $"{len:0.#} {sizes[order]}";
    }

    // Danish display label for a category - the underlying "cat" value stays
    // in English since it's matched against CategoryHelper.GetCategory() and
    // used as a CSS class key, both defined outside Pages/ (out of scope here).
    private static string CategoryLabel(string cat) =>
        cat switch
        {
            "Audio" => "Lyd",
            "Documents" => "Dokumenter",
            "Images" => "Billeder",
            "Videos" => "Videoer",
            "Screenshots" => "Screenshots",
            _ => cat
        };

    private static string GetCategoryCssClass(
        string cat) =>
        cat switch
        {
            "Audio" =>
                "category-audio",

            "Documents" =>
                "category-document",

            "Images" =>
                "category-image",

            "Videos" =>
                "category-video",

            "Screenshots" =>
                "category-auto",

            _ => ""
        };

    private async Task ContinueToEnhancement()
    {
        try
        {
            var exportPath =
                Configuration[
                    "MediaSettings:LibraryRoot"];

            await AnalogDigitizeClient.StartAsync(
                new StartAnalogDigitizeRequest
                {
                    SourceLibraryPath =
                        exportPath!,

                    WorkingDirectory =
                        Path.Combine(
                            exportPath!,
                            ".analogdigitize"),

                    EnableAiEnhancement =
                        true,

                    EnableUpscaling =
                        true,

                    EnableFrameInterpolation =
                        false,

                    EnableAudioEnhancement =
                        true,

                    EnableVideoEnhancement =
                        true,

                    EnableImageEnhancement =
                        true
                },
                CancellationToken.None);

            Logger.LogInformation(
                "AnalogDigitize enqueued");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed to start AnalogDigitize");

            ErrorMessage =
                ex.Message;
        }
    }
}