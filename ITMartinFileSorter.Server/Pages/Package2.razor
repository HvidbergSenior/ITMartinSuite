@page "/package2"

@using ITMartin.Media.Application.Pipelines.Package2.Services
@using ITMartin.Media.Contracts.Contracts.Runtime.Enums
@using ITMartin.Media.Contracts.Contracts.Runtime.Interfaces
@using ITMartin.Media.Contracts.Contracts.Runtime.Models
@using ITMartin.Media.Contracts.Contracts.Runtime.Requests.Package2
@using ITMartin.Media.Contracts.Contracts.Runtime.Services

@implements IDisposable

@inject IPackage2Client Package2Client
@inject ProgressService Progress
@inject Package2ProfileBuilder ProfileBuilder
@inject IConfiguration Configuration
@inject ILogger<Package2> Logger

<PageLayout Title="✨ Package 2 — Forbedring">

    <div class="filesorter-app">

        <ContentCard CssClass="scan-hero-card">

            <h2 class="mb-3">Video- & lydforbedring</h2>

            <p class="hero-text">
                Genopliv og forbedr dine medier med ffmpeg-behandlingspipelines.
            </p>

            <div class="p2-field mt-3">
                <div class="p2-label">Biblioteksmappe</div>
                <input class="p2-input" @bind="LibraryPath" disabled="@IsRunning" placeholder="/library/jespermette" />
                <div class="p2-hint">Mappe der indeholder manifest.json (eller scannes direkte hvis den mangler)</div>
            </div>

            <div class="p2-profile-grid mt-3">

                <div>
                    <div class="p2-label">Restaureringsprofil</div>
                    <select class="p2-select"
                            @bind="SelectedRestorationProfile"
                            @bind:after="RefreshConfiguration"
                            disabled="@IsRunning">
                        <option value="@RestorationProfile.FamilyArchive">Familiearkiv</option>
                        <option value="@RestorationProfile.Hi8">Hi8</option>
                        <option value="@RestorationProfile.VHS">VHS</option>
                        <option value="@RestorationProfile.VHSAggressive">VHS (aggressiv)</option>
                        <option value="@RestorationProfile.HandheldCamera">Håndholdt kamera</option>
                        <option value="@RestorationProfile.CleanDigitalCapture">Ren digital optagelse</option>
                    </select>
                </div>

                <div>
                    <div class="p2-label">Forbedringsprofil</div>
                    <select class="p2-select"
                            @bind="SelectedEnhancementProfile"
                            @bind:after="RefreshConfiguration"
                            disabled="@IsRunning">
                        <option value="@EnhancementProfile.FastPreview">Hurtig forhåndsvisning</option>
                        <option value="@EnhancementProfile.Standard">Standard</option>
                        <option value="@EnhancementProfile.HighQuality">Høj kvalitet</option>
                        <option value="@EnhancementProfile.Archival">Arkivkvalitet</option>
                        <option value="@EnhancementProfile.WebOptimized">Weboptimeret</option>
                        <option value="@EnhancementProfile.AggressiveAi">Aggressiv AI</option>
                    </select>
                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="text-danger mt-3">@ErrorMessage</div>
            }

            @if (!IsRunning && !IsComplete)
            {
                <div class="mt-3">
                    <button class="btn btn-primary btn-lg"
                            @onclick="StartPackage2"
                            disabled="@string.IsNullOrWhiteSpace(LibraryPath)">
                        ✨ Start forbedring
                    </button>
                </div>
            }

        </ContentCard>

        @if (IsRunning || Progress.Info.WorkDone > 0)
        {
            <ProgressPanel
                Title="@Progress.Info.Stage"
                Current="@Progress.Info.WorkDone"
                Total="@Progress.Info.TotalWork"
                Percent="@ProgressPercent"
                CurrentItem=""
                LoadingText="Forbedrer medier..."
                Icon="✨" />
        }

        @if (IsComplete)
        {
            <ContentCard>
                <div class="text-success">
                    ✔ Forbedringsjob sendt — se Status-siden for fremgang
                </div>
            </ContentCard>
        }

        <ContentCard Title="Aktiv konfiguration">

            <div class="p2-config-grid">

                <div class="p2-config-group">
                    <div class="p2-config-title">Video</div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Deinterlace</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Video.EnableDeinterlace)">
                            @BoolLabel(ActiveConfig.Video.EnableDeinterlace)
                        </span>
                    </div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Beskæring</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Video.EnableCrop)">
                            @BoolLabel(ActiveConfig.Video.EnableCrop)
                        </span>
                    </div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Støjreduktion</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Video.EnableDenoise)">
                            @BoolLabel(ActiveConfig.Video.EnableDenoise)
                        </span>
                    </div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Skarphed</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Video.EnableSharpen)">
                            @BoolLabel(ActiveConfig.Video.EnableSharpen)
                        </span>
                    </div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Stabilisering</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Video.EnableStabilization)">
                            @BoolLabel(ActiveConfig.Video.EnableStabilization)
                        </span>
                    </div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Farvekorrektion</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Video.EnableColorCorrection)">
                            @BoolLabel(ActiveConfig.Video.EnableColorCorrection)
                        </span>
                    </div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Opskalering</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Video.EnableUpscaling)">
                            @BoolLabel(ActiveConfig.Video.EnableUpscaling)
                        </span>
                    </div>
                </div>

                <div class="p2-config-group">
                    <div class="p2-config-title">Lyd</div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Normalisering</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Audio.EnableNormalize)">
                            @BoolLabel(ActiveConfig.Audio.EnableNormalize)
                        </span>
                    </div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Støjreduktion</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Audio.EnableNoiseReduction)">
                            @BoolLabel(ActiveConfig.Audio.EnableNoiseReduction)
                        </span>
                    </div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">AI-forbedring</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Audio.EnableAiEnhancement)">
                            @BoolLabel(ActiveConfig.Audio.EnableAiEnhancement)
                        </span>
                    </div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Taleforbedring</span>
                        <span class="p2-config-val @OnOff(ActiveConfig.Audio.EnableSpeechEnhancement)">
                            @BoolLabel(ActiveConfig.Audio.EnableSpeechEnhancement)
                        </span>
                    </div>
                </div>

            </div>

        </ContentCard>

    </div>

</PageLayout>

@code {

    private string LibraryPath = "";

    private RestorationProfile SelectedRestorationProfile = RestorationProfile.FamilyArchive;

    private EnhancementProfile SelectedEnhancementProfile = EnhancementProfile.Standard;

    private Package2Configuration ActiveConfig = new();

    private bool IsRunning;

    private bool IsComplete;

    private string ErrorMessage = "";

    private int ProgressPercent =>
        Progress.Info.TotalWork == 0
            ? 1
            : (int)((double)Progress.Info.WorkDone / Progress.Info.TotalWork * 100);

    protected override void OnInitialized()
    {
        LibraryPath = Configuration["MediaSettings:LibraryRoot"] ?? "";
        Progress.OnChange += HandleProgressChanged;
        RefreshConfiguration();
    }

    public void Dispose()
    {
        Progress.OnChange -= HandleProgressChanged;
    }

    private void HandleProgressChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void RefreshConfiguration()
    {
        ActiveConfig = ProfileBuilder.Build(
            SelectedRestorationProfile,
            SelectedEnhancementProfile);
    }

    private async Task StartPackage2()
    {
        if (IsRunning) return;

        ErrorMessage = "";
        IsComplete = false;

        if (string.IsNullOrWhiteSpace(LibraryPath))
        {
            ErrorMessage = "Biblioteksmappe er påkrævet.";
            return;
        }

        try
        {
            IsRunning = true;
            await InvokeAsync(StateHasChanged);

            await Package2Client.StartAsync(
                new StartPackage2Request
                {
                    SourceLibraryPath = LibraryPath,
                    WorkingDirectory = Path.Combine(LibraryPath, ".package2"),
                    RestorationProfile = SelectedRestorationProfile,
                    EnhancementProfile = SelectedEnhancementProfile
                },
                CancellationToken.None);

            Logger.LogInformation(
                "Package2 enqueued: {Restoration} + {Enhancement}",
                SelectedRestorationProfile,
                SelectedEnhancementProfile);

            IsComplete = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Package2 failed");
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string BoolLabel(bool value) => value ? "Til" : "Fra";

    private static string OnOff(bool value) => value ? "on" : "off";
}
