@page "/package2"

@using ITMartin.Media.Contracts.Contracts.Runtime.Enums
@using ITMartin.Media.Contracts.Contracts.Runtime.Models
@using ITMartin.Media.Contracts.Contracts.Runtime.Interfaces
@using ITMartin.Media.Contracts.Contracts.Runtime.Requests.Package2

@inject IPackage2Client Package2Client
@inject IConfiguration Configuration
@inject ILogger<Package2> Logger

<PageTitle>Package 2</PageTitle>

<h3>✨ Package 2</h3>

<div class="mb-3">
    <label>Library Folder</label>

    <input class="form-control"
           @bind="FolderPath" />
</div>

<div class="mb-3">
    <label>Restoration Profile</label>

    <select class="form-select"
            @bind="SelectedProfile">

        <option value="FamilyArchive">
            Family Archive
        </option>

        <option value="VHSAggressive">
            VHS Aggressive
        </option>

    </select>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableAiEnhancement" />

    <label class="form-check-label">
        AI Enhancement
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableUpscaling" />

    <label class="form-check-label">
        Upscaling
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableFrameInterpolation" />

    <label class="form-check-label">
        Frame Interpolation
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableAudioEnhancement" />

    <label class="form-check-label">
        Audio Enhancement
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableVideoEnhancement" />

    <label class="form-check-label">
        Video Enhancement
    </label>
</div>

<div class="form-check mb-4">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableImageEnhancement" />

    <label class="form-check-label">
        Image Enhancement
    </label>
</div>

<button class="btn btn-primary"
        @onclick="StartPackage2">
    Start Package2
</button>

@if (!string.IsNullOrWhiteSpace(Status))
{
    <div class="mt-3 alert alert-info">
        @Status
    </div>
}

@code {

    private string FolderPath = "";

    private string Status = "";

    private RestorationProfile
        SelectedProfile =
            RestorationProfile.VHSAggressive;

    private bool EnableAiEnhancement = true;

    private bool EnableUpscaling = false;

    private bool EnableFrameInterpolation = false;

    private bool EnableAudioEnhancement = true;

    private bool EnableVideoEnhancement = true;

    private bool EnableImageEnhancement = true;

    protected override void OnInitialized()
    {
        var libraryRoot =
            Configuration[
                "MediaSettings:LibraryRoot"];

        if (!string.IsNullOrWhiteSpace(
                libraryRoot))
        {
            FolderPath = libraryRoot;
        }
    }

    private async Task StartPackage2()
    {
        try
        {
            Status = "Starting Package2...";

            await Package2Client.StartAsync(
                new StartPackage2Request
                {
                    SourceLibraryPath =
                        FolderPath,

                    WorkingDirectory =
                        Path.Combine(
                            FolderPath,
                            ".package2"),

                    RestorationProfile =
                        SelectedProfile,

                    EnableAiEnhancement =
                        EnableAiEnhancement,

                    EnableUpscaling =
                        EnableUpscaling,

                    EnableFrameInterpolation =
                        EnableFrameInterpolation,

                    EnableAudioEnhancement =
                        EnableAudioEnhancement,

                    EnableVideoEnhancement =
                        EnableVideoEnhancement,

                    EnableImageEnhancement =
                        EnableImageEnhancement
                },
                CancellationToken.None);

            Status =
                $"Package2 started using {SelectedProfile}";
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed to start Package2");

            Status = ex.Message;
        }
    }
}