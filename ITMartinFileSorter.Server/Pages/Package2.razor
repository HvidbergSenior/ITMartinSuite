@page "/package2"

@using ITMartin.Media.Contracts.Contracts.Runtime.Enums
@using ITMartin.Media.Contracts.Contracts.Runtime.Interfaces
@using ITMartin.Media.Contracts.Contracts.Runtime.Requests.Package2

@inject IPackage2Client Package2Client
@inject IConfiguration Configuration
@inject ILogger<Package2> Logger

<PageTitle>Package 2</PageTitle>

<h3>✨ Package 2</h3>

<div class="mb-3">
    <label class="form-label">
        Library Folder
    </label>

    <input class="form-control"
           @bind="FolderPath" />
</div>

<div class="mb-4">
    <label class="form-label">
        Restoration Profile
    </label>

    <select class="form-select"
            @bind="SelectedProfile">

        <option value="@RestorationProfile.FamilyArchive">
            Family Archive (Recommended)
        </option>

        <option value="@RestorationProfile.VHSAggressive">
            VHS Aggressive
        </option>

    </select>
</div>

<h5 class="mt-4">
    Video
</h5>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableVideoEnhancement" />

    <label class="form-check-label">
        Enable Video Enhancement
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableDeinterlace" />

    <label class="form-check-label">
        Enable Deinterlace
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableCrop" />

    <label class="form-check-label">
        Enable Crop Bottom Noise
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableDenoise" />

    <label class="form-check-label">
        Enable Video Denoise
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableSharpen" />

    <label class="form-check-label">
        Enable Sharpen
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableUpscaling" />

    <label class="form-check-label">
        Enable Upscaling (Slow)
    </label>
</div>

<div class="form-check mb-4">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableFrameInterpolation" />

    <label class="form-check-label">
        Enable Frame Interpolation (Very Slow)
    </label>
</div>

<h5>
    Audio
</h5>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableAudioEnhancement" />

    <label class="form-check-label">
        Enable Audio Enhancement
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableAudioNormalize" />

    <label class="form-check-label">
        Enable Audio Normalize
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableHumRemoval" />

    <label class="form-check-label">
        Enable Hum Removal
    </label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableAudioNoiseReduction" />

    <label class="form-check-label">
        Enable Audio Noise Reduction
    </label>
</div>

<div class="form-check mb-4">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableAiEnhancement" />

    <label class="form-check-label">
        Enable AI Speech Enhancement
    </label>
</div>

<h5>
    Images
</h5>

<div class="form-check mb-4">
    <input class="form-check-input"
           type="checkbox"
           @bind="EnableImageEnhancement" />

    <label class="form-check-label">
        Enable Image Enhancement
    </label>
</div>

<button class="btn btn-primary"
        @onclick="StartPackage2">
    Start Package2
</button>

@if (!string.IsNullOrWhiteSpace(Status))
{
    <div class="mt-4 alert alert-info">
        @Status
    </div>
}

@code {

    private string FolderPath = "";

    private string Status = "";

    private RestorationProfile
        SelectedProfile =
            RestorationProfile.FamilyArchive;

    // VIDEO

    private bool EnableVideoEnhancement = true;

    private bool EnableDeinterlace = true;

    private bool EnableCrop = true;

    private bool EnableDenoise = false;

    private bool EnableSharpen = false;

    private bool EnableUpscaling = false;

    private bool EnableFrameInterpolation = false;

    // AUDIO

    private bool EnableAudioEnhancement = true;

    private bool EnableAudioNormalize = true;

    private bool EnableHumRemoval = false;

    private bool EnableAudioNoiseReduction = false;

    private bool EnableAiEnhancement = false;

    // IMAGE

    private bool EnableImageEnhancement = false;

    protected override void OnInitialized()
    {
        var libraryRoot =
            Configuration[
                "MediaSettings:LibraryRoot"];

        if (!string.IsNullOrWhiteSpace(
                libraryRoot))
        {
            FolderPath = libraryRoot;
        }
    }

    private async Task StartPackage2()
    {
        try
        {
            Status = "Starting Package2...";

            await Package2Client.StartAsync(
                new StartPackage2Request
                {
                    SourceLibraryPath =
                        FolderPath,

                    WorkingDirectory =
                        Path.Combine(
                            FolderPath,
                            ".package2"),

                    RestorationProfile =
                        SelectedProfile,

                    EnableVideoEnhancement =
                        EnableVideoEnhancement,

                    EnableDeinterlace =
                        EnableDeinterlace,

                    EnableCrop =
                        EnableCrop,

                    EnableDenoise =
                        EnableDenoise,

                    EnableSharpen =
                        EnableSharpen,

                    EnableUpscaling =
                        EnableUpscaling,

                    EnableFrameInterpolation =
                        EnableFrameInterpolation,

                    EnableAudioEnhancement =
                        EnableAudioEnhancement,

                    EnableAudioNormalize =
                        EnableAudioNormalize,

                    EnableHumRemoval =
                        EnableHumRemoval,

                    EnableAudioNoiseReduction =
                        EnableAudioNoiseReduction,

                    EnableAiEnhancement =
                        EnableAiEnhancement,

                    EnableImageEnhancement =
                        EnableImageEnhancement
                },
                CancellationToken.None);

            Status =
                $"Package2 started using {SelectedProfile}";
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed to start Package2");

            Status = ex.Message;
        }
    }
}