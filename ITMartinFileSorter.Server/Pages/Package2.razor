@page "/package2"

@using ITMartin.Media.Application.Pipelines.Package2.Services
@using ITMartin.Media.Contracts.Contracts.Runtime.Enums
@using ITMartin.Media.Contracts.Contracts.Runtime.Interfaces
@using ITMartin.Media.Contracts.Contracts.Runtime.Models
@using ITMartin.Media.Contracts.Contracts.Runtime.Requests.Package2

@inject IPackage2Client Package2Client
@inject ILogger<Package2> Logger
@inject Package2ProfileBuilder ProfileBuilder
<PageTitle>Package 2</PageTitle>

<h3>✨ Package 2</h3>

<div class="card shadow-sm mb-4">
    <div class="card-body">

        <div class="mb-3">
            <label class="form-label">
                Library Folder
            </label>

            <input class="form-control"
                   @bind="FolderPath" />
        </div>

        <div class="row">

            <div class="col-md-6 mb-4">

                <label class="form-label">
                    Restoration Profile
                </label>

                <select class="form-select"
                        @bind="SelectedRestorationProfile">

                    <option value="@RestorationProfile.FamilyArchive">
                        Family Archive
                    </option>

                    <option value="@RestorationProfile.Hi8">
                        Hi8
                    </option>

                    <option value="@RestorationProfile.VHS">
                        VHS
                    </option>

                    <option value="@RestorationProfile.VHSAggressive">
                        VHS Aggressive
                    </option>

                    <option value="@RestorationProfile.HandheldCamera">
                        Handheld Camera
                    </option>

                    <option value="@RestorationProfile.CleanDigitalCapture">
                        Clean Digital Capture
                    </option>

                </select>

            </div>

            <div class="col-md-6 mb-4">

                <label class="form-label">
                    Enhancement Profile
                </label>

                <select class="form-select"
                        @bind="SelectedEnhancementProfile">

                    <option value="@EnhancementProfile.FastPreview">
                        Fast Preview
                    </option>

                    <option value="@EnhancementProfile.Standard">
                        Standard
                    </option>

                    <option value="@EnhancementProfile.HighQuality">
                        High Quality
                    </option>

                    <option value="@EnhancementProfile.Archival">
                        Archival
                    </option>

                    <option value="@EnhancementProfile.WebOptimized">
                        Web Optimized
                    </option>

                    <option value="@EnhancementProfile.AggressiveAi">
                        Aggressive AI
                    </option>

                </select>

            </div>

        </div>

        <button class="btn btn-primary"
                @onclick="StartPackage2">
            Start Package2
        </button>

    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">

        <h5>
            Active Configuration
        </h5>

        <div class="row mt-4">

            <div class="col-md-6">

                <h6>
                    Video
                </h6>

                <ul class="list-group">

                    <li class="list-group-item">
                        Deinterlace:
                        <strong>
                            @Configuration.Video.EnableDeinterlace
                        </strong>
                    </li>

                    <li class="list-group-item">
                        Crop:
                        <strong>
                            @Configuration.Video.EnableCrop
                        </strong>
                    </li>

                    <li class="list-group-item">
                        Denoise:
                        <strong>
                            @Configuration.Video.EnableDenoise
                        </strong>
                    </li>

                    <li class="list-group-item">
                        Sharpen:
                        <strong>
                            @Configuration.Video.EnableSharpen
                        </strong>
                    </li>

                    <li class="list-group-item">
                        Stabilization:
                        <strong>
                            @Configuration.Video.EnableStabilization
                        </strong>
                    </li>

                    <li class="list-group-item">
                        Color Correction:
                        <strong>
                            @Configuration.Video.EnableColorCorrection
                        </strong>
                    </li>

                    <li class="list-group-item">
                        Upscaling:
                        <strong>
                            @Configuration.Video.EnableUpscaling
                        </strong>
                    </li>

                </ul>

            </div>

            <div class="col-md-6">

                <h6>
                    Audio
                </h6>

                <ul class="list-group">

                    <li class="list-group-item">
                        Normalize:
                        <strong>
                            @Configuration.Audio.EnableNormalize
                        </strong>
                    </li>

                    <li class="list-group-item">
                        Noise Reduction:
                        <strong>
                            @Configuration.Audio.EnableNoiseReduction
                        </strong>
                    </li>

                    <li class="list-group-item">
                        AI Enhancement:
                        <strong>
                            @Configuration.Audio.EnableAiEnhancement
                        </strong>
                    </li>

                    <li class="list-group-item">
                        Speech Enhancement:
                        <strong>
                            @Configuration.Audio.EnableSpeechEnhancement
                        </strong>
                    </li>

                </ul>

            </div>

        </div>

    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Status))
{
    <div class="alert alert-info">
        @Status
    </div>
}

@code {

    private string FolderPath = "";

    private string Status = "";

    private RestorationProfile
        SelectedRestorationProfile =
            RestorationProfile.FamilyArchive;

    private EnhancementProfile
        SelectedEnhancementProfile =
            EnhancementProfile.Standard;

    private Package2Configuration
        Configuration =
            new();

    protected override void OnInitialized()
    {
        var libraryRoot =
            ConfigurationManager[
                "MediaSettings:LibraryRoot"];

        if (!string.IsNullOrWhiteSpace(
                libraryRoot))
        {
            FolderPath =
                libraryRoot;
        }

        RefreshConfiguration();
    }

    [Inject]
    private IConfiguration
        ConfigurationManager
    {
        get;
        set;
    } = default!;

    private void RefreshConfiguration()
    {
        Configuration =
            ProfileBuilder.Build(
                SelectedRestorationProfile,
                SelectedEnhancementProfile);
    }

    private async Task StartPackage2()
    {
        try
        {
            RefreshConfiguration();

            Status =
                "Starting Package2...";

            await Package2Client.StartAsync(
                new StartPackage2Request
                {
                    SourceLibraryPath =
                        FolderPath,

                    WorkingDirectory =
                        Path.Combine(
                            FolderPath,
                            ".package2"),

                    RestorationProfile =
                        SelectedRestorationProfile,

                    EnhancementProfile =
                        SelectedEnhancementProfile
                },
                CancellationToken.None);

            Status =
                $"Package2 started using {SelectedRestorationProfile} + {SelectedEnhancementProfile}";
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed to start Package2");

            Status =
                ex.Message;
        }
    }
}