    private sealed record WorkflowStatusView(string Status, string? CurrentStep, string? FailureReason);

    private async Task PollStatus()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var instance = await db.WorkflowInstances
            .Where(x => x.WorkflowName == "Package4Workflow")
            .OrderByDescending(x => x.StartedAtUtc)
            .FirstOrDefaultAsync();

        if (instance is null) return;

        _lastStatus = new WorkflowStatusView(instance.Status.ToString(), instance.CurrentStep, instance.FailureReason);

        if (instance.Status.ToString() is "Completed" or "Failed" or "Cancelled")
        {
            _running = false;
            _statusTimer?.Dispose();
            _statusTimer = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyTextOverlay()
    {
        _textError = null;
        _textRunning = true;
        _textOutputPath = null;

        try
        {
            if (!File.Exists(_textInputPath))
            {
                _textError = "Filen findes ikke.";
                return;
            }

            var directory = Path.GetDirectoryName(_textInputPath)!;
            var extension = Path.GetExtension(_textInputPath);
            var outputFile = Path.Combine(directory, $"{Path.GetFileNameWithoutExtension(_textInputPath)}.texted{extension}");

            // fontcolor/fontsize/position via drawtext - x/y expressions center-align
            // then offset per the chosen preset; text is escaped for ffmpeg's filter syntax.
            var escapedText = _textContent.Replace("\\", "\\\\").Replace(":", "\\:").Replace("'", "\\'");
            var yExpr = _textPosition switch
            {
                "top" => "h*0.08",
                "center" => "(h-text_h)/2",
                _ => "h*0.85"
            };

            // ffmpeg's Windows builds have no fontconfig set up, so drawtext needs an
            // explicit fontfile - otherwise it fails with "Fontconfig error: Cannot
            // load default config file". Path colon must be escaped for the filter parser.
            const string fontFile = "C\\:/Windows/Fonts/arial.ttf";
            var drawtext = $"drawtext=fontfile='{fontFile}':text='{escapedText}':fontsize={_textFontSize}:fontcolor={_textColor}:x=(w-text_w)/2:y={yExpr}:box=1:boxcolor=black@0.4:boxborderw=10";

            string arguments;
            if (IsVideo(_textInputPath))
            {
                drawtext += $":enable='between(t,{_textStartSeconds.ToString(CultureInfo.InvariantCulture)},{(_textStartSeconds + _textDurationSeconds).ToString(CultureInfo.InvariantCulture)})'";
                arguments = $"-y -i \"{Path.GetFileName(_textInputPath)}\" -vf \"{drawtext}\" -c:v libx264 -preset medium -crf 20 -c:a copy \"{Path.GetFileName(outputFile)}\"";
            }
            else
            {
                arguments = $"-y -i \"{Path.GetFileName(_textInputPath)}\" -vf \"{drawtext}\" \"{Path.GetFileName(outputFile)}\"";
            }

            using var process = new Process
            {
                StartInfo = new ProcessStartInfo
                {
                    FileName = _ffmpegPath,
                    Arguments = arguments,
                    WorkingDirectory = directory,
                    RedirectStandardError = true,
                    UseShellExecute = false,
                    CreateNoWindow = true
                }
            };

            process.Start();
            var stderrTask = process.StandardError.ReadToEndAsync();
            await process.WaitForExitAsync();
            var stderr = await stderrTask;

            if (process.ExitCode != 0)
            {
                _textError = $"ffmpeg fejlede: {stderr}";
                return;
            }

            _textOutputPath = outputFile;
        }
        catch (Exception ex)
        {
            _textError = ex.Message;
        }
        finally
        {
            _textRunning = false;
        }
    }

    // Shared runner for the effects handlers below - captures stderr (ffmpeg/whisper
    // both report progress and errors there), same pattern as ApplyTextOverlay.
    private async Task<(int ExitCode, string Stderr)> RunProcessAsync(string fileName, string arguments, string workingDir, string? extraPathDir = null)
    {
        using var process = new Process
        {
            StartInfo = new ProcessStartInfo
            {
                FileName = fileName,
                Arguments = arguments,
                WorkingDirectory = workingDir,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            }
        };

        if (!string.IsNullOrEmpty(extraPathDir))
        {
            process.StartInfo.EnvironmentVariables["PATH"] = extraPathDir + ";" + Environment.GetEnvironmentVariable("PATH");
        }

        process.Start();
        var stderrTask = process.StandardError.ReadToEndAsync();
        await process.WaitForExitAsync();
        var stderr = await stderrTask;
        return (process.ExitCode, stderr);
    }

    // ffmpeg filter options that embed a Windows absolute path break the filter
    // parser on the colon after the drive letter - same fix as drawtext's fontfile.
    private static string EscapeFilterPath(string path) =>
        path.Replace("\\", "/").Replace(":", "\\:");

    private async Task ApplyAutoCaptions()
    {
        _capError = null;
        _capRunning = true;
        _capOutputPath = null;

        try
        {
            if (!File.Exists(_capInputPath))
            {
                _capError = "Filen findes ikke.";
                return;
            }

            var directory = Path.GetDirectoryName(_capInputPath)!;
            var baseName = Path.GetFileNameWithoutExtension(_capInputPath);
            var captionsDir = Path.Combine(directory, ".captions");
            Directory.CreateDirectory(captionsDir);

            var (whisperExit, whisperErr) = await RunProcessAsync(
                PythonExe,
                $"-m whisper --model base --output_format srt --output_dir \"{captionsDir}\" \"{_capInputPath}\"",
                directory,
                extraPathDir: _ffmpegDir);

            var srtPath = Path.Combine(captionsDir, $"{baseName}.srt");
            if (whisperExit != 0 || !File.Exists(srtPath))
            {
                _capError = $"Whisper fejlede: {whisperErr}";
                return;
            }

            var outputFile = Path.Combine(directory, $"{baseName}.captioned.mp4");
            var subtitlesFilter = $"subtitles='{EscapeFilterPath(srtPath)}':force_style='FontName=Arial,FontSize=20,PrimaryColour=&Hffffff,OutlineColour=&H000000,BorderStyle=3,Outline=1,Shadow=0'";
            var arguments = $"-y -i \"{_capInputPath}\" -vf \"{subtitlesFilter}\" -c:v libx264 -preset medium -crf 20 -c:a copy \"{outputFile}\"";

            var (exitCode, stderr) = await RunProcessAsync(_ffmpegPath, arguments, directory);
            if (exitCode != 0)
            {
                _capError = $"ffmpeg fejlede: {stderr}";
                return;
            }

            _capOutputPath = outputFile;
        }
        catch (Exception ex)
        {
            _capError = ex.Message;
        }
        finally
        {
            _capRunning = false;
        }
    }

