    private static bool IsVideo(string path) =>
        path.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) ||
        path.EndsWith(".mov", StringComparison.OrdinalIgnoreCase);

    private static string FormatSize(long bytes) =>
        bytes > 1_000_000 ? $"{bytes / 1_000_000.0:F1} MB" : $"{bytes / 1024.0:F0} KB";

    // /libraryfiles is an existing static-file mount rooted at LibraryPathProvider.LibraryRoot
    // (see Program.cs) - reuse it instead of building a new file-serving endpoint.
    private string ToLibraryUrl(string absolutePath)
    {
        var relative = Path.GetRelativePath(LibraryPathProvider.LibraryRoot, absolutePath);
        if (relative.StartsWith("..") || Path.IsPathRooted(relative))
        {
            // Outside the library root entirely (e.g. a standalone test folder) -
            // /libraryfiles can't reach it, so fall back to serving by absolute path.
            return $"/localfile?path={Uri.EscapeDataString(absolutePath)}";
        }

        return $"/libraryfiles/{Uri.EscapeDataString(relative.Replace('\\', '/')).Replace("%2F", "/")}";
    }

    private void RefreshFiles()
    {
        _browseError = null;
        try
        {
            var trimmed = _browseFolder?.Trim() ?? string.Empty;
            var folder = Path.IsPathRooted(trimmed)
                ? trimmed
                : Path.Combine(LibraryPathProvider.LibraryRoot, trimmed);
            if (!Directory.Exists(folder))
            {
                _browseError = $"Mappe findes ikke: {folder}";
                _files = [];
                return;
            }

            _files = Directory.EnumerateFiles(folder, "*.*", SearchOption.AllDirectories)
                .Where(f => IsVideo(f) || f.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || f.EndsWith(".png", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(f => new FileInfo(f).LastWriteTimeUtc)
                .ToList();
        }
        catch (Exception ex)
        {
            _browseError = ex.Message;
        }
    }

