    private async Task ApplySplitAudioVideo()
    {
        _splitError = null;
        _splitRunning = true;
        _splitAudioOutputPath = null;
        _splitVideoOutputPath = null;

        try
        {
            if (!File.Exists(_splitInputPath))
            {
                _splitError = "Videofilen findes ikke.";
                return;
