    // atempo only accepts 0.5-2.0 per stage, so factors outside that range chain
    // multiple atempo filters (e.g. 4x = atempo=2.0,atempo=2.0).
    private static string BuildAtempoChain(double factor)
    {
        var stages = new List<double>();
        var remaining = factor;
        while (remaining > 2.0)
        {
            stages.Add(2.0);
            remaining /= 2.0;
        }
        while (remaining < 0.5)
        {
            stages.Add(0.5);
            remaining /= 0.5;
        }
        stages.Add(remaining);
        return string.Join(",", stages.Select(s => $"atempo={s.ToString(CultureInfo.InvariantCulture)}"));
    }

    private async Task ApplySpeedRamp()
    {
        _speedError = null;
        _speedRunning = true;
        _speedOutputPath = null;

        try
        {
            if (!File.Exists(_speedInputPath))
            {
                _speedError = "Filen findes ikke.";
                return;
            }

            var directory = Path.GetDirectoryName(_speedInputPath)!;
            var outputFile = Path.Combine(directory, $"{Path.GetFileNameWithoutExtension(_speedInputPath)}.speed{_speedFactor.ToString(CultureInfo.InvariantCulture)}x.mp4");

            var startParsed = double.TryParse(_speedRangeStartText, NumberStyles.Float, CultureInfo.InvariantCulture, out var rangeStart);
            var endParsed = double.TryParse(_speedRangeEndText, NumberStyles.Float, CultureInfo.InvariantCulture, out var rangeEnd);
            var hasRange = startParsed && endParsed && rangeEnd > rangeStart;

            var trimArgs = hasRange
                ? $"-ss {rangeStart.ToString(CultureInfo.InvariantCulture)} -t {(rangeEnd - rangeStart).ToString(CultureInfo.InvariantCulture)} "
                : "";

            var ptsFactor = (1.0 / _speedFactor).ToString(CultureInfo.InvariantCulture);
            var atempoChain = BuildAtempoChain(_speedFactor);
            var arguments = $"-y {trimArgs}-i \"{_speedInputPath}\" -vf \"setpts={ptsFactor}*PTS\" -af \"{atempoChain}\" -c:v libx264 -preset medium -crf 20 \"{outputFile}\"";

            var (exitCode, stderr) = await RunProcessAsync(_ffmpegPath, arguments, directory);
            if (exitCode != 0)
            {
                _speedError = $"ffmpeg fejlede: {stderr}";
                return;
            }

            _speedOutputPath = outputFile;
        }
        catch (Exception ex)
        {
            _speedError = ex.Message;
        }
        finally
        {
            _speedRunning = false;
        }
    }

    private async Task ApplyAspectCrop()
    {
        _cropError = null;
        _cropRunning = true;
        _cropOutputPath = null;

        try
        {
            if (!File.Exists(_cropInputPath))
            {
                _cropError = "Filen findes ikke.";
                return;
            }

            var directory = Path.GetDirectoryName(_cropInputPath)!;
            var presetSlug = _cropPreset.Replace(":", "-");
            var outputFile = Path.Combine(directory, $"{Path.GetFileNameWithoutExtension(_cropInputPath)}.crop{presetSlug}.mp4");

            var parts = _cropPreset.Split(':');
            var ar = double.Parse(parts[0], CultureInfo.InvariantCulture) / double.Parse(parts[1], CultureInfo.InvariantCulture);
            var arText = ar.ToString(CultureInfo.InvariantCulture);

            // Generic centered crop to the target aspect ratio without needing ffprobe
            // first - min(iw, ih*ar) picks whichever dimension the source is short on.
            var cropFilter = $"crop='min(iw,ih*{arText})':'min(ih,iw/{arText})':'(iw-min(iw,ih*{arText}))/2':'(ih-min(ih,iw/{arText}))/2'";
            var arguments = $"-y -i \"{_cropInputPath}\" -vf \"{cropFilter}\" -c:v libx264 -preset medium -crf 20 -c:a copy \"{outputFile}\"";

            var (exitCode, stderr) = await RunProcessAsync(_ffmpegPath, arguments, directory);
            if (exitCode != 0)
            {
                _cropError = $"ffmpeg fejlede: {stderr}";
                return;
            }

            _cropOutputPath = outputFile;
        }
        catch (Exception ex)
        {
            _cropError = ex.Message;
        }
        finally
        {
            _cropRunning = false;
        }
    }

