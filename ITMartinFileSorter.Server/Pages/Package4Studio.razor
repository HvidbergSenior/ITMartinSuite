            var directory = Path.GetDirectoryName(_splitInputPath)!;
            var baseName = Path.GetFileNameWithoutExtension(_splitInputPath);
            var audioOutputFile = Path.Combine(directory, $"{baseName}.audio.mp3");
            var videoOutputFile = Path.Combine(directory, $"{baseName}.silent.mp4");

            // -vn drops the video stream (audio-only output); -an drops the
            // audio stream (silent video, stream-copied so no re-encode).
            var (audioExit, audioStderr) = await RunProcessAsync(_ffmpegPath, $"-y -i \"{_splitInputPath}\" -vn -c:a libmp3lame -q:a 2 \"{audioOutputFile}\"", directory);
            if (audioExit != 0)
            {
                _splitError = $"ffmpeg fejlede (lyd): {audioStderr}";
                return;
            }

            var (videoExit, videoStderr) = await RunProcessAsync(_ffmpegPath, $"-y -i \"{_splitInputPath}\" -an -c:v copy \"{videoOutputFile}\"", directory);
            if (videoExit != 0)
            {
                _splitError = $"ffmpeg fejlede (video): {videoStderr}";
                return;
            }

            _splitAudioOutputPath = audioOutputFile;
            _splitVideoOutputPath = videoOutputFile;
        }
        catch (Exception ex)
        {
            _splitError = ex.Message;
        }
        finally
        {
            _splitRunning = false;
        }
    }

