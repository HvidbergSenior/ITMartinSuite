@page "/status"

@using System.Text.Json
@using ITMartin.Media.Infrastructure.Persistence
@using ITMartin.Media.Infrastructure.Persistence.Entities
@using Microsoft.EntityFrameworkCore

@implements IDisposable

@inject IDbContextFactory<MediaDbContext> DbFactory

<div class="filesorter-app">

    <div class="page-container stack">

        <SectionTitle Title="⚙️ Worker-status" />

        @if (Running is not null)
        {
            <ContentCard Title="🔄 Kører">

                <div class="status-row">
                    <span class="status-label">Workflow</span>
                    <span>@Running.WorkflowName</span>
                </div>

                <div class="status-row">
                    <span class="status-label">Trin</span>
                    <span class="status-step">@Running.CurrentStep</span>
                </div>

                @if (Running.ProgressTotal > 0)
                {
                    var pct = (int)((double)Running.ProgressCurrent! / Running.ProgressTotal * 100);
                    <div class="status-row">
                        <span class="status-label">Fremgang</span>
                        <span>@Running.ProgressCurrent / @Running.ProgressTotal (@pct%)</span>
                    </div>
                    <div class="progress-bar-track">
                        <div class="progress-bar-fill" style="width: @pct%"></div>
                    </div>
                    <div class="status-row">
                        <span class="status-label">Fil</span>
                        <span class="status-step">@Running.ProgressItem</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Running.ProgressData))
                    {
                        var counts = JsonSerializer.Deserialize<Dictionary<string, int>>(Running.ProgressData);
                        if (counts is not null && counts.Count > 0)
                        {
                            <div class="status-row">
                                <span class="status-label">Fundet</span>
                                <div class="category-chips">
                                    @foreach (var (type, count) in counts.OrderByDescending(x => x.Value))
                                    {
                                        <span class="category-chip chip-@type.ToLower()">
                                            @GetTypeIcon(type) @GetTypeLabel(type) <strong>@count</strong>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    }
                }

                <div class="status-row">
                    <span class="status-label">Startet</span>
                    <span>@Running.StartedAtUtc.ToString("HH:mm:ss") UTC</span>
                </div>

                <div class="status-row">
                    <span class="status-label">Har kørt i</span>
                    <span>@FormatDuration(DateTime.UtcNow - Running.StartedAtUtc)</span>
                </div>

            </ContentCard>
        }
        else
        {
            <EmptyState Title="Inaktiv" Text="Ingen workflow kører i øjeblikket" />
        }

        @if (Recent.Any())
        {
            <ContentCard Title="📋 Seneste">

                <div class="history-list">

                    @foreach (var item in Recent)
                    {
                        <div class="history-row">

                            <span class="history-badge status-@item.Status.ToLower()">
                                @item.Status
                            </span>

                            <span class="history-name">@item.WorkflowName</span>

                            <span class="history-time">
                                @item.StartedAtUtc.ToString("yyyy-MM-dd HH:mm")
                            </span>

                            @if (item.CompletedAtUtc.HasValue)
                            {
                                <span class="history-duration">
                                    @FormatDuration(item.CompletedAtUtc.Value - item.StartedAtUtc)
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.FailureReason))
                            {
                                <span class="history-error">@item.FailureReason</span>
                            }

                        </div>
                    }

                </div>

            </ContentCard>
        }

    </div>

</div>

@code {

    private WorkflowInstanceEntity? Running;

    private List<WorkflowInstanceEntity> Recent = [];

    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();

        _timer = new Timer(async _ =>
        {
            await Refresh();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private async Task Refresh()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        Running = await db.WorkflowInstances
            .Where(x => x.Status == "Running")
            .OrderByDescending(x => x.StartedAtUtc)
            .FirstOrDefaultAsync();

        Recent = await db.WorkflowInstances
            .Where(x => x.Status != "Running")
            .OrderByDescending(x => x.StartedAtUtc)
            .Take(10)
            .ToListAsync();
    }

    private static string GetTypeIcon(string type) => type switch
    {
        "Image"    => "📷",
        "Video"    => "🎬",
        "Audio"    => "🎵",
        "Document" => "📄",
        _          => "❓"
    };

    // Danish display label - the underlying "type" value stays in English
    // since it's the raw key produced by the scan/classification pipeline.
    private static string GetTypeLabel(string type) => type switch
    {
        "Image"    => "Billede",
        "Video"    => "Video",
        "Audio"    => "Lyd",
        "Document" => "Dokument",
        _          => type
    };

    private static string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalHours >= 1)
            return $"{(int)ts.TotalHours}h {ts.Minutes}m {ts.Seconds}s";
        if (ts.TotalMinutes >= 1)
            return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Seconds}s";
    }

    public void Dispose() => _timer?.Dispose();

}
