@page "/history"

@using ITMartin.Media.Contracts.Contracts.Runtime.Interfaces
@using ITMartin.Media.Contracts.Contracts.Runtime.Models

@inject IPackageHistoryService HistoryService

<PageLayout Title="📜 Package 1 — Kørselshistorik">

    <div class="filesorter-app">

        <ContentCard>
            <p class="hero-text">
                Hver sorteringskørsel, med bevis for om alle kildefiler er gjort rede for —
                eksporteret, markeret som dublet, eller logget som fejlet. "Mismatch" betyder at
                nogle filer ikke er gjort rede for, og kilden bør ikke behandles som sikkert
                sikkerhedskopieret endnu.
            </p>
        </ContentCard>

        @if (_runs is null)
        {
            <ContentCard><p class="hero-text">Indlæser…</p></ContentCard>
        }
        else if (_runs.Count == 0)
        {
            <ContentCard><p class="hero-text">Ingen kørsler endnu.</p></ContentCard>
        }
        else
        {
            @foreach (var run in _runs)
            {
                <ContentCard CssClass="p3-person-row">
                    <div class="p3-person-header">
                        <span class="@VerdictClass(run.Verdict)">@VerdictLabel(run.Verdict)</span>
                        <span class="p2-hint">@run.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        <span class="p2-hint">@run.Status</span>
                    </div>

                    <div class="mt-2 p2-hint">
                        <strong>Kilde:</strong> @(run.SourcePath ?? "—") &nbsp;→&nbsp;
                        <strong>Output:</strong> @(run.OutputPath ?? "(standardbibliotek)")
                    </div>

                    <div class="p2-config-grid mt-2">
                        <div class="p2-config-row">
                            <span class="p2-config-key">Kildefiler</span>
                            <span class="p2-config-val">@run.SourceFileCount (@FormatBytes(run.SourceSizeBytes))</span>
                        </div>
                        <div class="p2-config-row">
                            <span class="p2-config-key">Eksporteret</span>
                            <span class="p2-config-val">@run.ExportedFileCount (@FormatBytes(run.ExportedSizeBytes))</span>
                        </div>
                        <div class="p2-config-row">
                            <span class="p2-config-key">Dubletter udelukket</span>
                            <span class="p2-config-val">@run.DuplicateFileCount</span>
                        </div>
                        <div class="p2-config-row">
                            <span class="p2-config-key">Fejlet / sprunget over</span>
                            <span class="p2-config-val">@run.FailedFileCount</span>
                        </div>
                    </div>

                    @if (run.SourceSizeBytes > 0 && run.ExportedSizeBytes > 0)
                    {
                        var shrink = 100.0 * (run.SourceSizeBytes - run.ExportedSizeBytes) / run.SourceSizeBytes;
                        if (shrink > 1)
                        {
                            <div class="mt-2 p2-hint">
                                Output er @(Math.Round(shrink, 0))% mindre end kilden — forventet ved
                                video-genkodning og/eller dubletfjernelse, ikke et tegn på tabte filer
                                (se filtallene ovenfor for det bevis i stedet).
                            </div>
                        }
                    }

                    @if (run.FailedFiles.Count > 0)
                    {
                        <details class="mt-2">
                            <summary class="p2-hint" style="cursor:pointer">@run.FailedFiles.Count fejlet(e) fil(er) — klik for at se hvorfor</summary>
                            <ul class="mt-2">
                                @foreach (var f in run.FailedFiles)
                                {
                                    <li class="p2-hint">@f.FilePath — @f.Reason</li>
                                }
                            </ul>
                        </details>
                    }
                </ContentCard>
            }
        }

    </div>

</PageLayout>

@code {
    private List<PackageRunSummary>? _runs;

    protected override async Task OnInitializedAsync()
    {
        _runs = await HistoryService.GetRunsAsync();
    }

    private static string VerdictClass(ReconciliationVerdict v) => v switch
    {
        ReconciliationVerdict.Verified => "stage stage-done",
        ReconciliationVerdict.Mismatch => "stage stage-warn",
        ReconciliationVerdict.InProgress => "stage stage-running",
        _ => "stage stage-pending"
    };

    private static string VerdictLabel(ReconciliationVerdict v) => v switch
    {
        ReconciliationVerdict.Verified => "✓ Verificeret — alle filer er gjort rede for",
        ReconciliationVerdict.Mismatch => "⚠ Mismatch — nogle filer er ikke gjort rede for",
        ReconciliationVerdict.InProgress => "… Kører stadig — tjek igen når den er færdig",
        _ => "? Ukendt — ikke nok data til at verificere"
    };

    private static string FormatBytes(long bytes)
    {
        double b = bytes;
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var i = 0;
        while (b >= 1024 && i < units.Length - 1) { b /= 1024; i++; }
        return $"{b:0.#} {units[i]}";
    }
}
