@page "/browse"

@using ITMartin.Media.Contracts.Contracts.Constants
@using ITMartin.Media.Contracts.Contracts.Runtime.Enums
@using ITMartin.Media.Contracts.Contracts.Runtime.Helpers
@using ITMartin.Media.Contracts.Contracts.Runtime.Models
@using ITMartin.Media.Infrastructure.FileSystem

@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject ILogger<LocalBrowser> Logger

<PageLayout Title="📁 Browse Local Files">

    <div class="filesorter-app">

        <div class="page-container stack library-page">

            <div class="library-header">

                <SectionTitle Title="📁 Local Files" />

                <div class="library-actions">

                    <button class="btn btn-secondary"
                            @onclick="GoBack"
                            disabled="@(!CanGoBack)">
                        ← Back
                    </button>

                    <button class="btn btn-secondary"
                            @onclick="GoToRoot">
                        📁 Source Root
                    </button>

                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(CurrentPath))
            {
                <div class="meta" style="margin-bottom:8px;word-break:break-all">
                    @CurrentPath
                </div>
            }

            @if (Folders.Any())
            {
                <ContentCard Title="📁 Folders">

                    <div class="library-grid">

                        @foreach (var folder in Folders)
                        {
                            <div class="folder-card"
                                 @onclick="() => OpenFolder(folder.FullPath)">

                                <div class="folder-cover-placeholder">
                                    📁
                                </div>

                                <div class="folder-info">

                                    <div class="folder-title">
                                        @folder.Name
                                    </div>

                                    <div class="folder-meta">
                                        @folder.FileCount files
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </ContentCard>
            }

            @if (Files.Any())
            {
                <ContentCard Title="@($"🎬 Media ({Files.Count})")">

                    <div class="media-grid">

                        @foreach (var file in Files)
                        {
                            <div class="media-card"
                                 @onclick="() => OpenFile(file)">

                                @if (file.Type == MediaType.Image)
                                {
                                    <img class="media-thumb"
                                         src="@GetFileUrl(file.FullPath)"
                                         alt="@file.FileName"
                                         loading="lazy" />
                                }
                                else if (file.Type == MediaType.Video)
                                {
                                    <div class="media-video-thumb">
                                        <span class="play-icon">▶</span>
                                    </div>
                                }
                                else if (file.Type == MediaType.Audio)
                                {
                                    <div class="media-audio-thumb">🎵</div>
                                }
                                else
                                {
                                    <div class="media-doc-thumb">📄</div>
                                }

                                <div class="media-info">

                                    <div class="media-name">
                                        @file.FileName
                                    </div>

                                    <div class="media-meta">
                                        @FormatSize(file.SizeBytes)
                                        @if (file.CreatedAt != default)
                                        {
                                            <span class="media-date">
                                                · @file.CreatedAt!.Value.ToString("yyyy-MM-dd")
                                            </span>
                                        }
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </ContentCard>
            }

            @if (!Folders.Any() && !Files.Any() && !string.IsNullOrWhiteSpace(CurrentPath))
            {
                <EmptyState Title="Empty folder" Text="No media files found here" />
            }

        </div>

    </div>

</PageLayout>

@code {

    [Parameter]
    [SupplyParameterFromQuery]
    public string? path { get; set; }

    private string RootPath = "";
    private string CurrentPath = "";
    private List<FolderItem> Folders = [];
    private List<MediaFile> Files = [];

    protected override void OnParametersSet()
    {
        RootPath = Configuration["MediaSettings:SourceRoot"] ?? "";

        var initial = string.IsNullOrWhiteSpace(path) ? RootPath : path;

        LoadFolder(initial);
    }

    private bool CanGoBack =>
        !string.Equals(CurrentPath, RootPath, StringComparison.OrdinalIgnoreCase);

    private void GoBack()
    {
        var parent = Directory.GetParent(CurrentPath);
        if (parent != null)
            LoadFolder(parent.FullName);
    }

    private void GoToRoot() => LoadFolder(RootPath);

    private void OpenFolder(string folderPath) =>
        Navigation.NavigateTo($"/browse?path={Uri.EscapeDataString(folderPath)}");

    private void OpenFile(MediaFile file) =>
        Navigation.NavigateTo(
            $"/localviewer?path={Uri.EscapeDataString(file.FullPath)}",
            forceLoad: true);

    private void LoadFolder(string folderPath)
    {
        if (!Directory.Exists(folderPath))
        {
            Logger.LogWarning("Browse folder does not exist: {Path}", folderPath);
            return;
        }

        CurrentPath = folderPath;

        Folders = Directory
            .EnumerateDirectories(folderPath)
            .Select(d => new FolderItem
            {
                Name = Path.GetFileName(d),
                FullPath = d,
                FileCount = Directory
                    .EnumerateFiles(d, "*.*", SearchOption.AllDirectories)
                    .Count(MediaFileHelper.IsSupportedMedia)
            })
            .OrderBy(x => x.Name)
            .ToList();

        Files = Directory
            .EnumerateFiles(folderPath)
            .Where(MediaDisplayHelper.IsDisplayable)
            .Select(f =>
            {
                var info = new FileInfo(f);
                var ext = Path.GetExtension(f).ToLowerInvariant();
                var type = MediaExtensions.ImageExtensions.Contains(ext) ? MediaType.Image
                    : MediaExtensions.VideoExtensions.Contains(ext) ? MediaType.Video
                    : MediaExtensions.AudioExtensions.Contains(ext) ? MediaType.Audio
                    : MediaType.Document;
                return new MediaFile(f, info.LastWriteTimeUtc, type, info.Length);
            })
            .OrderByDescending(f => f.CreatedAt)
            .ToList();

        StateHasChanged();
    }

    private string GetFileUrl(string fullPath)
    {
        if (string.IsNullOrWhiteSpace(RootPath)) return "";
        var relative = Path.GetRelativePath(RootPath, fullPath).Replace("\\", "/");
        return $"/sourcefiles/{relative}";
    }

    private static string FormatSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];
        double len = bytes;
        var order = 0;
        while (len >= 1024 && order < sizes.Length - 1) { order++; len /= 1024; }
        return $"{len:0.#} {sizes[order]}";
    }

    private sealed class FolderItem
    {
        public string Name { get; set; } = "";
        public string FullPath { get; set; } = "";
        public int FileCount { get; set; }
    }
}
