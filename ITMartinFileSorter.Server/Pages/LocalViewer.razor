@page "/localviewer"

@using ITMartin.Media.Contracts.Contracts.Runtime.Helpers
@using ITMartin.Media.Infrastructure.FileSystem
@using Microsoft.AspNetCore.WebUtilities

@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject ILogger<LocalViewer> Logger

<div class="viewer-root">

    <div class="viewer-page">

        <div class="viewer-header">

            <div class="viewer-title">
                @Path.GetFileName(FilePath)
            </div>

        </div>

        <div class="viewer-content">

            <div class="viewer-stage"
                 @ref="StageRef"
                 @onclick="HandleStageClick"
                 tabindex="0"
                 @onkeydown="HandleKey">

                @if (!string.IsNullOrWhiteSpace(FilePath))
                {
                    @if (IsVideo)
                    {
                        <video class="viewer-media"
                               controls
                               autoplay
                               playsinline
                               preload="metadata"
                               @onclick:stopPropagation
                               @key="WebPath">
                            <source src="@WebPath" />
                        </video>
                    }
                    else
                    {
                        <img class="viewer-media"
                             src="@WebPath"
                             alt="@Path.GetFileName(FilePath)"
                             @onclick:stopPropagation />
                    }
                }

                @if (IsVideo)
                {
                    <button class="nav-video left" @onclick="PlayPrevious">❮</button>
                    <button class="nav-video right" @onclick="PlayNext">❯</button>
                }
                else
                {
                    <div class="nav-zone left" @onclick="PlayPrevious"></div>
                    <div class="nav-zone right" @onclick="PlayNext"></div>
                    <div class="nav-btn left">❮</div>
                    <div class="nav-btn right">❯</div>
                }

            </div>

        </div>

        <div class="viewer-controls">

            <button class="btn" @onclick="GoHome">🏠</button>

            <button class="btn" @onclick="GoToFolder">📁</button>

            <span class="viewer-counter">
                @(CurrentIndex + 1) / @Playlist.Count
            </span>

        </div>

    </div>

</div>

@code {

    private string FilePath = "";
    private string WebPath = "";
    private bool IsVideo;
    private List<string> Playlist = [];
    private int CurrentIndex;
    private string FolderPath = "";
    private string SourceRoot = "";
    private ElementReference StageRef;

    protected override void OnParametersSet()
    {
        SourceRoot = Configuration["MediaSettings:SourceRoot"] ?? "";

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("path", out var path))
        {
            Logger.LogWarning("LocalViewer opened without path query");
            return;
        }

        FilePath = Uri.UnescapeDataString(path!);
        FolderPath = System.IO.Path.GetDirectoryName(FilePath) ?? "";

        if (!Directory.Exists(FolderPath))
        {
            Logger.LogWarning("LocalViewer folder does not exist: {Folder}", FolderPath);
            return;
        }

        Playlist = Directory
            .EnumerateFiles(FolderPath)
            .Where(MediaFileHelper.IsSupportedMedia)
            .OrderBy(x => x)
            .ToList();

        CurrentIndex = Playlist.FindIndex(f => f == FilePath);
        if (CurrentIndex < 0) CurrentIndex = 0;

        Load();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await StageRef.FocusAsync();
    }

    private void Load()
    {
        if (!Playlist.Any()) return;

        FilePath = Playlist[CurrentIndex];

        if (string.IsNullOrWhiteSpace(SourceRoot))
        {
            Logger.LogWarning("SourceRoot missing in configuration");
            return;
        }

        var relative = System.IO.Path
            .GetRelativePath(SourceRoot, FilePath)
            .Replace("\\", "/");

        WebPath = $"/sourcefiles/{relative}";
        IsVideo = MediaTypeHelper.IsVideo(FilePath);

        StateHasChanged();
    }

    private void PlayNext()
    {
        if (!Playlist.Any()) return;
        CurrentIndex = (CurrentIndex + 1) % Playlist.Count;
        Load();
    }

    private void PlayPrevious()
    {
        if (!Playlist.Any()) return;
        CurrentIndex = (CurrentIndex - 1 + Playlist.Count) % Playlist.Count;
        Load();
    }

    private void GoHome() =>
        Navigation.NavigateTo("/browse", forceLoad: true);

    private void GoToFolder() =>
        Navigation.NavigateTo(
            $"/browse?path={Uri.EscapeDataString(FolderPath)}",
            forceLoad: true);

    private void HandleStageClick(MouseEventArgs e)
    {
        if (!IsVideo) PlayNext();
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight") PlayNext();
        if (e.Key == "ArrowLeft") PlayPrevious();
        if (e.Key == "Escape") GoToFolder();
    }
}
