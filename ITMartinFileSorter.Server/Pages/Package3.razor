@page "/package3"

@using ITMartin.Media.Contracts.Contracts.Runtime.Interfaces
@using ITMartin.Media.Contracts.Contracts.Runtime.Models

@implements IDisposable

@inject IPackage3Service Package3Service
@inject IServiceScopeFactory ScopeFactory
@inject IConfiguration Configuration
@inject ILogger<Package3> Logger

<PageLayout Title="🔎 Package 3 — Search &amp; People">

    <div class="filesorter-app">

        <ContentCard Title="Library folder">

            <div class="p2-field mt-3">
                <div class="p2-label">Library folder</div>
                <input class="p2-input" @bind="LibraryPath" disabled="@IsFaceIndexing" placeholder="/library/mie" />
            </div>

        </ContentCard>

        <ContentCard Title="🆓 Face Index — free, runs locally, no API cost">

            <p class="hero-text">
                Extracts face data using local ONNX models — no API calls, no cost, ever.
                Powers person search below. Already-indexed files are skipped on re-runs.
            </p>

            @if (!string.IsNullOrWhiteSpace(FaceIndexError))
            {
                <div class="text-danger mt-3">@FaceIndexError</div>
            }

            <div class="mt-3">
                <button class="btn btn-primary btn-lg"
                        @onclick="StartFaceIndexing"
                        disabled="@(IsFaceIndexing || string.IsNullOrWhiteSpace(LibraryPath))">
                    🧑 Start Face Index
                </button>
            </div>

            @if (FaceStatus is not null)
            {
                <div class="mt-3">
                    <div class="p2-config-row">
                        <span class="p2-config-key">Status</span>
                        <span class="p2-config-val">@FaceStatus.Status</span>
                    </div>
                    <div class="p2-config-row">
                        <span class="p2-config-key">Progress</span>
                        <span class="p2-config-val">@FaceStatus.ProcessedFiles / @FaceStatus.TotalFiles</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(FaceStatus.CurrentFile))
                    {
                        <div class="p2-config-row">
                            <span class="p2-config-key">Current file</span>
                            <span class="p2-config-val">@System.IO.Path.GetFileName(FaceStatus.CurrentFile)</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(FaceStatus.ErrorMessage))
                    {
                        <div class="text-danger mt-2">@FaceStatus.ErrorMessage</div>
                    }
                </div>
            }

        </ContentCard>

        <ContentCard Title="People">

            <p class="hero-text">
                Add a person with one or more reference photos of them, then search the library for their face.
                More reference photos (different angles, ages, lighting) means better matching.
            </p>

            <div class="p2-field mt-3">
                <div class="p2-label">Name</div>
                <input class="p2-input" @bind="NewPersonName" placeholder="Jakob" />
            </div>

            <div class="p2-field mt-3">
                <div class="p2-label">Reference photos</div>
                <InputFile OnChange="OnReferencePhotosSelected" multiple accept="image/*" />
                @if (NewPersonFiles.Count > 0)
                {
                    <div class="p2-hint">@NewPersonFiles.Count photo(s) selected</div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(PersonError))
            {
                <div class="text-danger mt-2">@PersonError</div>
            }

            <div class="mt-3">
                <button class="btn btn-primary"
                        @onclick="AddPerson"
                        disabled="@(IsAddingPerson || string.IsNullOrWhiteSpace(NewPersonName) || NewPersonFiles.Count == 0)">
                    ➕ Add Person
                </button>
            </div>

            <div class="p3-people-list mt-4">
                @foreach (var person in People)
                {
                    <div class="p3-person-row">

                        <div class="p3-person-header">
                            <span class="p3-person-name">@person.Name</span>
                            <span class="p2-hint">@person.ReferencePhotoCount reference photo(s)</span>
                            <button class="btn btn-secondary" @onclick="() => FindMatches(person)" disabled="@(SearchingPersonId == person.Id)">
                                🔎 Find matches
                            </button>
                            <button class="btn btn-danger" @onclick="() => DeletePerson(person)">🗑</button>
                        </div>

                        @if (ActivePersonId == person.Id)
                        {
                            @if (CurrentMatches.Count == 0)
                            {
                                <div class="hero-text mt-2">No matches found yet.</div>
                            }
                            else
                            {
                                <div class="p3-results-grid mt-2">
                                    @foreach (var match in CurrentMatches)
                                    {
                                        <div class="p3-result-card">
                                            <img class="p3-thumb" src="@ToWebPath(match.MediaFilePath)" loading="lazy" />
                                            <div class="p2-hint">@((int)(match.Confidence * 100))% match</div>
                                            <label class="p3-confirm-label">
                                                <input type="checkbox" checked="@SelectedMatches.Contains(match.MediaFilePath)"
                                                       @onchange="@(e => ToggleMatch(match.MediaFilePath, (bool)e.Value!))" />
                                                Confirm
                                            </label>
                                        </div>
                                    }
                                </div>

                                <div class="mt-3">
                                    <button class="btn btn-primary" @onclick="() => SaveConfirmed(person)" disabled="@(SelectedMatches.Count == 0)">
                                        💾 Save "@person.Name" (@SelectedMatches.Count selected)
                                    </button>
                                </div>
                            }
                        }

                    </div>
                }
            </div>

        </ContentCard>

    </div>

</PageLayout>

@code {

    private string LibraryPath = "";
    private bool IsFaceIndexing;
    private string FaceIndexError = "";
    private Package3IndexStatus? FaceStatus;
    private System.Threading.Timer? _pollTimer;

    private string NewPersonName = "";
    private List<IBrowserFile> NewPersonFiles = [];
    private bool IsAddingPerson;
    private string PersonError = "";
    private List<PersonDto> People = [];

    private Guid? ActivePersonId;
    private Guid? SearchingPersonId;
    private List<PersonMatchResult> CurrentMatches = [];
    private HashSet<string> SelectedMatches = [];

    protected override async Task OnInitializedAsync()
    {
        LibraryPath = Configuration["MediaSettings:LibraryRoot"] ?? "";
        await RefreshPeople();
        await RefreshStatus();

        _pollTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshStatus();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }

    private async Task RefreshStatus()
    {
        if (string.IsNullOrWhiteSpace(LibraryPath)) return;
        FaceStatus = await Package3Service.GetIndexStatusAsync(LibraryPath, Package3IndexType.Faces);
        IsFaceIndexing = FaceStatus?.Status == "Running";
    }

    private async Task RefreshPeople()
    {
        People = await Package3Service.GetPeopleAsync();
    }

    private async Task StartFaceIndexing()
    {
        FaceIndexError = "";

        if (string.IsNullOrWhiteSpace(LibraryPath) || !Directory.Exists(LibraryPath))
        {
            FaceIndexError = "That folder doesn't exist.";
            return;
        }

        IsFaceIndexing = true;
        var path = LibraryPath;

        // Own DI scope, independent of this Blazor circuit's lifetime - if the
        // user navigates away or closes the tab, indexing keeps running.
        _ = Task.Run(async () =>
        {
            using var scope = ScopeFactory.CreateScope();
            var service = scope.ServiceProvider.GetRequiredService<IPackage3Service>();
            try
            {
                await service.IndexFacesAsync(path);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Package3 face indexing failed for {Path}", path);
            }
        });

        await RefreshStatus();
    }

    private void OnReferencePhotosSelected(InputFileChangeEventArgs e)
    {
        NewPersonFiles = e.GetMultipleFiles(20).ToList();
    }

    private async Task AddPerson()
    {
        PersonError = "";
        IsAddingPerson = true;

        try
        {
            var inputs = new List<ReferencePhotoInput>();
            foreach (var file in NewPersonFiles)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                inputs.Add(new ReferencePhotoInput(file.Name, ms.ToArray()));
            }

            await Package3Service.AddPersonAsync(NewPersonName, inputs, LibraryPath);

            NewPersonName = "";
            NewPersonFiles = [];
            await RefreshPeople();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add person");
            PersonError = ex.Message;
        }
        finally
        {
            IsAddingPerson = false;
        }
    }

    private async Task DeletePerson(PersonDto person)
    {
        await Package3Service.DeletePersonAsync(person.Id);
        if (ActivePersonId == person.Id) ActivePersonId = null;
        await RefreshPeople();
    }

    private async Task FindMatches(PersonDto person)
    {
        SearchingPersonId = person.Id;
        ActivePersonId = person.Id;
        SelectedMatches = [];

        try
        {
            CurrentMatches = await Package3Service.FindMatchesAsync(person.Id);
            SelectedMatches = CurrentMatches.Where(m => m.UserConfirmed).Select(m => m.MediaFilePath).ToHashSet();
        }
        finally
        {
            SearchingPersonId = null;
        }
    }

    private void ToggleMatch(string path, bool isSelected)
    {
        if (isSelected) SelectedMatches.Add(path);
        else SelectedMatches.Remove(path);
    }

    private async Task SaveConfirmed(PersonDto person)
    {
        await Package3Service.ConfirmMatchesAsync(person.Id, SelectedMatches.ToList(), LibraryPath);
        await FindMatches(person);
    }

    private string ToWebPath(string absolutePath)
    {
        if (string.IsNullOrWhiteSpace(LibraryPath)) return "";
        var relative = Path.GetRelativePath(LibraryPath, absolutePath).Replace('\\', '/');
        return $"/libraryfiles/{relative}";
    }
}
