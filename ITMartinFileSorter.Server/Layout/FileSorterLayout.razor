
@inherits LayoutComponentBase

@inject IConfiguration Configuration

<div class="app-shell">

    <header class="app-header fs-header">

        <div class="header-title">
            📦 Sort
        </div>

        <nav class="fs-nav">

            <NavLink class="fs-nav-link"
                     href="/filesorter"
                     Match="NavLinkMatch.All">
                📦 Cleanup
            </NavLink>

            <NavLink class="fs-nav-link"
                     href="/package2">
                ✨ Enhancement
            </NavLink>

            <NavLink class="fs-nav-link"
                     href="/browse">
                📁 Browse
            </NavLink>

            <NavLink class="fs-nav-link"
                     href="/status">
                ⚙️ Status
            </NavLink>

            <a class="fs-nav-link"
               href="@GalleryUrl">
                🎬 Gallery ↗
            </a>

        </nav>

    </header>

    <main class="app-main">
        @Body
    </main>
    <ToastContainer />

</div>

@code {
    private string GalleryUrl =>
        Configuration["Apps:GalleryUrl"] ?? "https://gallery.itmartin.dk";
}
