
@inherits LayoutComponentBase

@inject IConfiguration Configuration

<div class="app-shell">

    <header class="app-header fs-header">

        <div class="header-title">
            <span class="header-icon">📦</span>
            FileSorter
        </div>

        <nav class="fs-nav">

            <NavLink class="fs-nav-link"
                     href="/filesorter"
                     Match="NavLinkMatch.All">
                📦 Cleanup
            </NavLink>

            <NavLink class="fs-nav-link"
                     href="/package2">
                ✨ Enhancement
            </NavLink>

            <NavLink class="fs-nav-link"
                     href="/browse">
                📁 Browse
            </NavLink>

            <NavLink class="fs-nav-link"
                     href="/status">
                ⚙️ Status
            </NavLink>

            <a class="fs-nav-link"
               href="@GalleryUrl">
                🎬 Gallery ↗
            </a>

        </nav>

    </header>

    <main class="app-main">
        @Body
    </main>
    <ToastContainer />
    <footer style="text-align:center;padding:.6rem 1rem;font-size:.72rem;color:#64748b;border-top:1px solid rgba(255,255,255,.06)"><a href="https://all-apps.itmartin.dk/vilkaar" target="_blank" style="color:#64748b;text-decoration:underline">Vilkår &amp; Privatlivspolitik</a> · &copy; @DateTime.Now.Year Den Digitale Rådgiver</footer>

</div>

@code {
    private string GalleryUrl =>
        Configuration["Apps:GalleryUrl"] ?? "https://gallery.itmartin.dk";
}
