@page "/"
@page "/scanner"

@using System.Threading.Channels
@using ITMartin.Receipt.Application.Interfaces
@using ITMartin.Receipt.Application.Models
@using ITMartin.Receipt.Application.Workflows
@using ITMartin.Receipt.Server.Components
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject IReceiptWorkflowOrchestrator ReceiptOrchestrator
@implements IAsyncDisposable

<PageTitle>Kvitteringer</PageTitle>

<div class="scanner-page">

    <div class="info-toggle-row">
        <button class="info-toggle-btn" @onclick="ToggleInfo">
            @(_showInfo ? "🙈 Skjul info" : "ℹ️ Vis info")
        </button>
    </div>

    @if (_showInfo)
    {
        <ProblemPurposeBanner
            Problem="Kvitteringer ser forskellige ud fra butik til butik, og det kan være svært at overskue, hvad man egentlig har betalt for."
            Formaal="Tag et billede af kvitteringen, og få med det samme et klart overblik over varer, rabatter og eventuelle medlemsfordele." />

        <HowToUseBanner Steps='@(new[]
        {
            "Tag et billede af kvitteringen, gerne i god belysning og så tydeligt som muligt.",
            "Se med det samme varerne du har købt, samt hvilke rabatter og fordele du fik på dem."
        })' />

        <details class="home-screen-hint">
            <summary>📱 Tilføj til hjemmeskærm</summary>
            <p><strong>iPhone:</strong> Tryk på Del-ikonet i Safari, og vælg "Tilføj til hjemmeskærm".</p>
            <p><strong>Android:</strong> Tryk på menuen (⋮) i Chrome, og vælg "Tilføj til startskærm".</p>
        </details>
    }

    <div class="scanner-wrapper">

        @if (!_cameraStarted)
        {
            <div class="camera-start-panel">
                <button @onclick="StartCamera">
                    Start kamera
                </button>
            </div>
        }
        else
        {
            <video id="video"
                   autoplay
                   muted
                   playsinline
                   webkit-playsinline
                   class="scanner-video">
            </video>

            <div class="scanner-guide">
                <div class="guide-text">Placér kvitteringen i rammen</div>
            </div>
        }

        @if (_isProcessing)
        {
            <div class="scanner-overlay">
                <div class="scanner-loading">
                    <div class="spinner-border text-light"></div>
                    <div class="mt-4 fw-bold">@_statusText</div>
                </div>
            </div>
        }

    </div>

    @if (_cameraStarted && !string.IsNullOrWhiteSpace(_itemsPhotoBase64))
    {
        <div class="items-photo-preview">
            <img src="@_itemsPhotoBase64" style="max-width:160px; border-radius:10px; border:2px solid #444;" />
            <div>
                <div class="items-photo-label">📷 Billede af varer taget</div>
                <button class="btn-clear-items-photo" @onclick="ClearItemsPhoto">✕ Fjern</button>
            </div>
        </div>
    }

    @if (_pendingPages.Count > 0)
    {
        <div class="pending-pages-row">
            @foreach (var pendingPage in _pendingPages)
            {
                <img src="@pendingPage.Base64" class="pending-page-thumb" />
            }
            <div class="pending-pages-label">@_pendingPages.Count side(r) klar — tag et billede mere, eller tryk "Scan" for at afslutte</div>
        </div>
    }

    <div class="scanner-buttons">

        @if (_cameraStarted && string.IsNullOrWhiteSpace(_itemsPhotoBase64))
        {
            <button class="btn btn-outline-light btn-lg items-photo-button"
                    @onclick="CaptureItemsPhoto"
                    disabled="@_isProcessing">
                📷 Tag billede af varer (valgfrit, til sammenligning)
            </button>
        }

        @if (_cameraStarted)
        {
            <button class="btn btn-outline-light btn-lg more-pages-button"
                    @onclick="AddPage"
                    disabled="@_isProcessing">
                📄 Kvitteringen fortsætter — tag et billede mere
            </button>
        }

        <button class="btn btn-success btn-lg scan-button"
                @onclick="Capture"
                disabled="@(_isProcessing || !_cameraStarted)">
            @if (_isProcessing)
            {
                <span>Scanner...</span>
            }
            else if (_pendingPages.Count > 0)
            {
                <span>Scan @(_pendingPages.Count + 1) billeder</span>
            }
            else
            {
                <span>Scan kvittering</span>
            }
        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(_statusText) && !_isProcessing)
    {
        <div class="alert alert-dark scanner-alert mt-4">
            @_statusText
        </div>
    }

    @if (_context != null && !_context.Failed && _context.Transaction != null)
    {
        <div class="result-panel">
            <ReceiptSummary Transaction="_context.Transaction"
                            LoyaltyAccount="_context.ExtractionResult?.LoyaltyAccount"
                            FontSizeRem="_zoom">
                <HeaderExtra>
                    <div class="zoom-controls">
                        <button class="zoom-btn" @onclick="ZoomOut" disabled="@(_zoom <= 0.8)">Formindsk</button>
                        <button class="zoom-btn" @onclick="ZoomIn" disabled="@(_zoom >= 2.0)">Forstør</button>
                    </div>
                </HeaderExtra>
            </ReceiptSummary>
        </div>
    }

    @if (_context?.Failed == true)
    {
        <div class="alert alert-danger mt-4">
            @_context.FailureReason
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_capturedImage) || !string.IsNullOrWhiteSpace(_itemsPhotoUsedBase64))
    {
        <div class="mt-4 compare-row">
            @if (!string.IsNullOrWhiteSpace(_itemsPhotoUsedBase64))
            {
                <div>
                    <h5>Varer (før)</h5>
                    <img src="@_itemsPhotoUsedBase64" style="max-width:280px; border-radius:12px; border:2px solid #444;" />
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_capturedImage))
            {
                <div>
                    <h5>Kvittering</h5>
                    <img src="@_capturedImage" style="max-width:280px; border-radius:12px; border:2px solid #444;" />
                </div>
            }
        </div>
    }

</div>

@code {

    private string? _capturedImage;
    private string? _statusText;
    private bool _isProcessing;
    private bool _cameraStarted;
    private bool _disposed;
    private ReceiptContext? _context;
    private double _zoom = 1.0;
    private bool _showInfo = true;
    private string? _itemsPhotoBase64;
    private string? _itemsPhotoPath;
    private string? _itemsPhotoUsedBase64;

    // Extra pages for a receipt too long for one shot - captured but not
    // submitted until the main "Scan" button is pressed, which sends this
    // photo plus the final one together as one multi-page scan.
    private readonly List<(string Path, string Base64)> _pendingPages = [];

    private void ZoomIn()  => _zoom = Math.Min(2.0, Math.Round(_zoom + 0.2, 1));
    private void ZoomOut() => _zoom = Math.Max(0.8, Math.Round(_zoom - 0.2, 1));

    private readonly Channel<(string ImagePath, string? ItemsPhotoPath, string? ItemsPhotoBase64, List<string> AdditionalImagePaths)> _workChannel =
        Channel.CreateBounded<(string, string?, string?, List<string>)>(new BoundedChannelOptions(2) { FullMode = BoundedChannelFullMode.DropOldest });

    protected override Task OnInitializedAsync()
    {
        _ = RunWorkerAsync();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "receipt_show_info");
        if (stored == "hidden")
        {
            _showInfo = false;
            StateHasChanged();
        }
    }

    private void ToggleInfo()
    {
        // Fire-and-forget the localStorage write - awaiting it here made the
        // toggle visibly lag behind the click, since Blazor doesn't re-render
        // until the handler completes and this JS round-trip isn't needed
        // before the UI can update.
        _showInfo = !_showInfo;
        _ = JS.InvokeVoidAsync("localStorage.setItem", "receipt_show_info", _showInfo ? "shown" : "hidden");
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _workChannel.Writer.TryComplete();
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
    }

    private async Task RunWorkerAsync()
    {
        await foreach (var work in _workChannel.Reader.ReadAllAsync())
        {
            if (_disposed) break;
            try
            {
                var result = await ReceiptOrchestrator.ExecuteAsync(work.ImagePath, CancellationToken.None, work.ItemsPhotoPath, work.AdditionalImagePaths);
                await InvokeAsync(() =>
                {
                    _context = result;
                    _isProcessing = false;
                    _statusText = result.Failed ? result.FailureReason : "Scanning fuldført";
                    _itemsPhotoUsedBase64 = work.ItemsPhotoBase64;
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _isProcessing = false;
                    _statusText = ex.Message;
                    StateHasChanged();
                });
            }
        }
    }

    private async Task StartCamera()
    {
        try
        {
            _cameraStarted = true;
            StateHasChanged();
            await Task.Delay(300);
            await JS.InvokeVoidAsync("webcam.start");
        }
        catch (Exception ex)
        {
            _cameraStarted = false;
            _statusText = ex.Message;
        }
        StateHasChanged();
    }

    private async Task Capture()
    {
        if (_isProcessing || _disposed) return;

        if (!_cameraStarted)
        {
            _statusText = "Start kameraet, før du scanner.";
            StateHasChanged();
            return;
        }

        try
        {
            _isProcessing = true;
            _statusText = "Tager billede af kvitteringen...";
            _context = null;
            StateHasChanged();

            CameraCaptureResult capture;
            try { capture = await JS.InvokeAsync<CameraCaptureResult>("webcam.capture"); }
            catch (TaskCanceledException) { _isProcessing = false; return; }

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(clean);
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "receipts");
            Directory.CreateDirectory(folder);
            var imagePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(imagePath, bytes);

            _capturedImage = $"data:image/jpeg;base64,{clean}";
            _statusText = "Analyserer kvittering...";
            var additionalImagePaths = _pendingPages.Select(p => p.Path).ToList();
            _workChannel.Writer.TryWrite((imagePath, _itemsPhotoPath, _itemsPhotoBase64, additionalImagePaths));

            // Clear so the next scan starts fresh rather than accidentally
            // reusing this items photo (or these pending pages) for an
            // unrelated receipt.
            _itemsPhotoBase64 = null;
            _itemsPhotoPath = null;
            _pendingPages.Clear();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _isProcessing = false;
            _statusText = ex.Message;
            StateHasChanged();
        }
    }

    private async Task AddPage()
    {
        if (_isProcessing || _disposed || !_cameraStarted) return;

        try
        {
            CameraCaptureResult capture;
            try { capture = await JS.InvokeAsync<CameraCaptureResult>("webcam.capture"); }
            catch (TaskCanceledException) { return; }

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(clean);
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "receipts");
            Directory.CreateDirectory(folder);
            var imagePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(imagePath, bytes);

            _pendingPages.Add((imagePath, $"data:image/jpeg;base64,{clean}"));
            _statusText = $"{_pendingPages.Count} side(r) klar — tag et billede mere, eller tryk \"Scan\" for at afslutte.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _statusText = ex.Message;
            StateHasChanged();
        }
    }

    private async Task CaptureItemsPhoto()
    {
        if (_isProcessing || _disposed || !_cameraStarted) return;

        try
        {
            CameraCaptureResult capture;
            try { capture = await JS.InvokeAsync<CameraCaptureResult>("webcam.capture"); }
            catch (TaskCanceledException) { return; }

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(clean);
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "items-photos");
            Directory.CreateDirectory(folder);
            var path = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(path, bytes);

            _itemsPhotoPath = path;
            _itemsPhotoBase64 = $"data:image/jpeg;base64,{clean}";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _statusText = ex.Message;
            StateHasChanged();
        }
    }

    private void ClearItemsPhoto()
    {
        _itemsPhotoPath = null;
        _itemsPhotoBase64 = null;
    }

    private sealed class CameraCaptureResult { public string Image { get; set; } = ""; }
}
