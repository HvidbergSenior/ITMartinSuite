@page "/"
@page "/scanner"

@using System.Threading.Channels
@using ITMartin.Receipt.Application.Interfaces
@using ITMartin.Receipt.Application.Models
@using ITMartin.Receipt.Application.Workflows
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject IReceiptWorkflowOrchestrator ReceiptOrchestrator
@implements IAsyncDisposable

<PageTitle>Receipt Scanner</PageTitle>

<div class="scanner-page">

    <div class="scanner-header">

        <div>
            <h1 class="scanner-title">Receipt Scanner</h1>
            <div class="scanner-subtitle">AI-powered receipt analysis</div>
        </div>

        <div class="ai-badge">AI Vision</div>

    </div>

    <div class="scanner-wrapper">

        @if (!_cameraStarted)
        {
            <div class="camera-start-panel">
                <button @onclick="StartCamera">
                    Start Camera
                </button>
            </div>
        }
        else
        {
            <video id="video"
                   autoplay
                   muted
                   playsinline
                   webkit-playsinline
                   class="scanner-video">
            </video>

            <div class="scanner-guide">
                <div class="guide-text">Align receipt inside frame</div>
            </div>
        }

        @if (_isProcessing)
        {
            <div class="scanner-overlay">
                <div class="scanner-loading">
                    <div class="spinner-border text-light"></div>
                    <div class="mt-4 fw-bold">@_statusText</div>
                </div>
            </div>
        }

    </div>

    <div class="scanner-buttons">

        <button class="btn btn-success btn-lg scan-button"
                @onclick="Capture"
                disabled="@_isProcessing">
            @if (_isProcessing)
            {
                <span>Scanning...</span>
            }
            else
            {
                <span>Scan Receipt</span>
            }
        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(_statusText) && !_isProcessing)
    {
        <div class="alert alert-dark scanner-alert mt-4">
            @_statusText
        </div>
    }

    @if (_context != null && !_context.Failed && _context.Transaction != null)
    {
        var tx = _context.Transaction;

        <div class="result-panel">

            <div class="receipt-result" style="font-size: @(_zoom)rem;">

                <div class="receipt-header-row">

                    <div>
                        <h2 class="receipt-merchant">
                            @(string.IsNullOrWhiteSpace(tx.MerchantName)
                                ? "Unknown Merchant"
                                : tx.MerchantName)
                        </h2>

                        @if (tx.PurchaseDate.HasValue)
                        {
                            <div class="receipt-date">
                                @tx.PurchaseDate.Value.ToString("dd MMM yyyy")
                            </div>
                        }
                    </div>

                    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px;">
                        @if (tx.TotalAmount.HasValue)
                        {
                            <div class="receipt-total">
                                <span>Total</span>
                                <strong>@tx.Currency @tx.TotalAmount.Value.ToString("F2")</strong>
                            </div>
                        }
                        <div class="zoom-controls">
                            <button class="zoom-btn" @onclick="ZoomOut" disabled="@(_zoom <= 0.8)">A−</button>
                            <button class="zoom-btn" @onclick="ZoomReset">A</button>
                            <button class="zoom-btn" @onclick="ZoomIn" disabled="@(_zoom >= 2.0)">A+</button>
                        </div>
                    </div>

                </div>

                @if (tx.Items.Any())
                {
                    <div class="receipt-items">
                        @foreach (var item in tx.Items)
                        {
                            var hasDiscount  = item.DiscountAmount.HasValue && item.DiscountAmount != 0;
                            var netPrice     = (item.OriginalPrice ?? 0) + (item.DiscountAmount ?? 0);
                            var isKupon      = item.DiscountType == "Plus-kupon";
                            var itemClass    = item.IsSuspicious ? "receipt-item receipt-item-suspicious"
                                             : "receipt-item";

                            <div class="@itemClass">

                                <div class="receipt-item-main">
                                    <span class="item-desc">
                                        @item.Description
                                        @if (item.IsSuspicious)
                                        {
                                            <span class="suspicious-badge" title="Price may be wrong">⚠</span>
                                        }
                                    </span>
                                    <span class="item-price">
                                        @if (hasDiscount && item.OriginalPrice.HasValue)
                                        {
                                            <span class="item-price-struck">@($"{tx.Currency} {item.OriginalPrice.Value:F2}")</span>
                                        }
                                        else if (item.OriginalPrice.HasValue)
                                        {
                                            @($"{tx.Currency} {item.OriginalPrice.Value:F2}")
                                        }
                                    </span>
                                </div>

                                @if (hasDiscount)
                                {
                                    <div class="receipt-item-sub @(isKupon ? "sub-kupon" : "")">
                                        <span class="sub-label">@(item.DiscountType ?? "Rabat")</span>
                                        <span class="sub-amount">- @($"{tx.Currency} {Math.Abs(item.DiscountAmount ?? 0):F2}")</span>
                                    </div>

                                    <div class="receipt-item-net">
                                        <span>Netto</span>
                                        <span>@($"{tx.Currency} {netPrice:F2}")</span>
                                    </div>
                                }

                            </div>
                        }
                    </div>
                }

            </div>

        </div>
    }

    @if (_context?.Failed == true)
    {
        <div class="alert alert-danger mt-4">
            @_context.FailureReason
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_capturedImage))
    {
        <div class="mt-4">
            <h5>Captured Image</h5>
            <img src="@_capturedImage"
                 style="max-width:400px; border-radius:12px; border:2px solid #444;" />
        </div>
    }

</div>

@code {

    private string? _capturedImage;
    private string? _statusText;
    private bool _isProcessing;
    private bool _cameraStarted;
    private bool _disposed;
    private ReceiptContext? _context;
    private double _zoom = 1.0;

    private void ZoomIn()    => _zoom = Math.Min(2.0, Math.Round(_zoom + 0.2, 1));
    private void ZoomOut()   => _zoom = Math.Max(0.8, Math.Round(_zoom - 0.2, 1));
    private void ZoomReset() => _zoom = 1.0;

    private readonly Channel<string> _workChannel =
        Channel.CreateBounded<string>(new BoundedChannelOptions(2) { FullMode = BoundedChannelFullMode.DropOldest });

    protected override Task OnInitializedAsync()
    {
        _ = RunWorkerAsync();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _workChannel.Writer.TryComplete();
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
    }

    private async Task RunWorkerAsync()
    {
        await foreach (var imagePath in _workChannel.Reader.ReadAllAsync())
        {
            if (_disposed) break;
            try
            {
                var result = await ReceiptOrchestrator.ExecuteAsync(imagePath, CancellationToken.None);
                await InvokeAsync(() =>
                {
                    _context = result;
                    _isProcessing = false;
                    _statusText = result.Failed ? result.FailureReason : "Scan complete";
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _isProcessing = false;
                    _statusText = ex.Message;
                    StateHasChanged();
                });
            }
        }
    }

    private async Task StartCamera()
    {
        try
        {
            _cameraStarted = true;
            StateHasChanged();
            await Task.Delay(300);
            await JS.InvokeVoidAsync("webcam.start");
        }
        catch (Exception ex)
        {
            _cameraStarted = false;
            _statusText = ex.Message;
        }
        StateHasChanged();
    }

    private async Task Capture()
    {
        if (_isProcessing || _disposed) return;

        try
        {
            _isProcessing = true;
            _statusText = "Capturing receipt...";
            _context = null;
            StateHasChanged();

            CameraCaptureResult capture;
            try { capture = await JS.InvokeAsync<CameraCaptureResult>("webcam.capture"); }
            catch (TaskCanceledException) { _isProcessing = false; return; }

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(clean);
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "receipts");
            Directory.CreateDirectory(folder);
            var imagePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(imagePath, bytes);

            _capturedImage = $"data:image/jpeg;base64,{clean}";
            _statusText = "Analyzing receipt...";
            _workChannel.Writer.TryWrite(imagePath);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _isProcessing = false;
            _statusText = ex.Message;
            StateHasChanged();
        }
    }

    private sealed class CameraCaptureResult { public string Image { get; set; } = ""; }
}
