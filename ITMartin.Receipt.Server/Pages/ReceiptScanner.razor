@page "/scanner"

@using ITMartin.Receipt.Application.Interfaces
@using ITMartin.Receipt.Application.Models
@using ITMartin.Receipt.Application.Workflows
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject IReceiptWorkflowOrchestrator ReceiptOrchestrator
@implements IAsyncDisposable

<PageTitle>Receipt Scanner</PageTitle>

<div class="scanner-page">

    <div class="scanner-header">

        <div>
            <h1 class="scanner-title">Receipt Scanner</h1>
            <div class="scanner-subtitle">AI-powered receipt analysis</div>
        </div>

        <div class="ai-badge">AI + OCR</div>

    </div>

    <div class="scanner-wrapper">

        @if (!_cameraStarted)
        {
            <div class="camera-start-panel">
                <button @onclick="StartCamera">
                    Start Camera
                </button>
            </div>
        }
        else
        {
            <video id="video"
                   autoplay
                   muted
                   playsinline
                   webkit-playsinline
                   class="scanner-video">
            </video>

            <div class="scanner-guide">
                <div class="guide-text">Align receipt inside frame</div>
            </div>
        }

        @if (_isProcessing)
        {
            <div class="scanner-overlay">
                <div class="scanner-loading">
                    <div class="spinner-border text-light"></div>
                    <div class="mt-4 fw-bold">@_statusText</div>
                </div>
            </div>
        }

    </div>

    <div class="scanner-buttons">

        <button class="btn btn-success btn-lg scan-button"
                @onclick="Capture"
                disabled="@_isProcessing">
            @if (_isProcessing)
            {
                <span>Scanning...</span>
            }
            else
            {
                <span>Scan Receipt</span>
            }
        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(_statusText) && !_isProcessing)
    {
        <div class="alert alert-dark scanner-alert mt-4">
            @_statusText
        </div>
    }

    @if (_context != null && !_context.Failed && _context.Transaction != null)
    {
        var tx = _context.Transaction;

        <div class="result-panel">

            <div class="receipt-result">

                <div class="receipt-header-row">

                    <div>
                        <h2 class="receipt-merchant">
                            @(string.IsNullOrWhiteSpace(tx.MerchantName)
                                ? "Unknown Merchant"
                                : tx.MerchantName)
                        </h2>

                        @if (tx.PurchaseDate.HasValue)
                        {
                            <div class="receipt-date">
                                @tx.PurchaseDate.Value.ToString("dd MMM yyyy")
                            </div>
                        }
                    </div>

                    @if (tx.TotalAmount.HasValue)
                    {
                        <div class="receipt-total">
                            <span>Total</span>
                            <strong>@tx.Currency @tx.TotalAmount.Value.ToString("F2")</strong>
                        </div>
                    }

                </div>

                @if (tx.Items.Any())
                {
                    <div class="receipt-items">

                        <h4 class="mb-3">Items</h4>

                        @foreach (var item in tx.Items)
                        {
                            <div class="receipt-item-row">

                                <div class="item-description">
                                    @item.Description
                                    @if (!string.IsNullOrWhiteSpace(item.Category))
                                    {
                                        <span class="item-category">@item.Category</span>
                                    }
                                </div>

                                <div class="item-amount">
                                    @if (item.Amount.HasValue)
                                    {
                                        @($"{tx.Currency} {item.Amount.Value:F2}")
                                    }
                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>
    }

    @if (_context?.Failed == true)
    {
        <div class="alert alert-danger mt-4">
            @_context.FailureReason
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_capturedImage))
    {
        <div class="mt-4">
            <h5>Captured Image</h5>
            <img src="@_capturedImage"
                 style="max-width:400px; border-radius:12px; border:2px solid #444;" />
        </div>
    }

</div>

@code {

    private string? _capturedImage;
    private string? _statusText;
    private bool _isProcessing;
    private bool _cameraStarted;
    private bool _disposed;
    private ReceiptContext? _context;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        try
        {
            await JS.InvokeVoidAsync("webcam.stop");
        }
        catch { }
    }

    private async Task StartCamera()
    {
        try
        {
            _cameraStarted = true;
            StateHasChanged();
            await Task.Delay(300);
            await JS.InvokeVoidAsync("webcam.start");
        }
        catch (Exception ex)
        {
            _cameraStarted = false;
            _statusText = ex.Message;
        }

        StateHasChanged();
    }

    private async Task Capture()
    {
        if (_isProcessing || _disposed) return;

        try
        {
            _isProcessing = true;
            _statusText = "Capturing receipt...";
            _context = null;
            StateHasChanged();

            CameraCaptureResult capture;

            try
            {
                capture = await JS.InvokeAsync<CameraCaptureResult>("webcam.capture");
            }
            catch (TaskCanceledException)
            {
                return;
            }

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(clean);

            var folder = Path.Combine(
                Directory.GetCurrentDirectory(), "data", "receipts");

            Directory.CreateDirectory(folder);

            var imagePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");

            await File.WriteAllBytesAsync(imagePath, bytes);

            _capturedImage = $"data:image/jpeg;base64,{clean}";
            _statusText = "Analyzing receipt...";
            StateHasChanged();

            _context = await ReceiptOrchestrator.ExecuteAsync(
                imagePath,
                CancellationToken.None);

            _statusText = _context.Failed
                ? _context.FailureReason
                : "Scan complete";
        }
        catch (Exception ex)
        {
            _statusText = ex.Message;
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private sealed class CameraCaptureResult
    {
        public string Image { get; set; } = "";
    }
}
