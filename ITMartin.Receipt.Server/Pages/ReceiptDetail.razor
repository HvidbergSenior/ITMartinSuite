@page "/history/{Id:guid}"

@using ITMartin.Receipt.Application.Interfaces
@using DomainEntities = ITMartin.Receipt.Domain.Entities
@using AppModels = ITMartin.Receipt.Application.Models
@using ITMartin.Receipt.Server.Components

@inject IReceiptRepository ReceiptRepository

<PageTitle>Receipt Detail</PageTitle>

<div class="page-container">

    <div class="scanner-header">
        <div>
            <h1 class="scanner-title">Receipt Detail</h1>
            @if (_scannedAt.HasValue)
            {
                <div class="scanner-subtitle">Scanned @_scannedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
            }
        </div>
        <a href="/history" class="btn btn-outline-secondary">&larr; Back to History</a>
    </div>

    @if (_notFound)
    {
        <div class="content-card" style="text-align:center; padding:40px;">
            <div style="font-size:48px; margin-bottom:12px;">🧾</div>
            <div style="color:var(--text-muted);">Receipt not found.</div>
        </div>
    }
    else if (_transaction is null)
    {
        <div class="text-muted">Loading...</div>
    }
    else
    {
        <div class="result-panel">
            <ReceiptSummary Transaction="_transaction" />
        </div>
    }

</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private AppModels.ReceiptTransaction? _transaction;
    private DateTime? _scannedAt;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        var tx = await ReceiptRepository.GetByIdAsync(Id);
        _notFound = tx is null;

        if (tx is not null)
        {
            _scannedAt = tx.ScannedAt;
            _transaction = new AppModels.ReceiptTransaction
            {
                Id = tx.Id,
                MerchantName = tx.MerchantName,
                PurchaseDate = tx.PurchaseDate,
                TotalAmount = tx.TotalAmount,
                VatAmount = tx.VatAmount,
                Currency = tx.Currency,
                Items = tx.Items
                    .Select(i => new AppModels.ReceiptTransactionItem
                    {
                        Description = i.Description,
                        OriginalPrice = i.OriginalPrice,
                        DiscountAmount = i.DiscountAmount,
                        DiscountType = i.DiscountType,
                        IsSuspicious = i.IsSuspicious
                    })
                    .ToList()
            };
        }
    }
}
