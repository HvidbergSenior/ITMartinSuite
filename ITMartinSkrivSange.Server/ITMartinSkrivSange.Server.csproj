<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- SkrivSange - the thin web front: pages and endpoints that only call ITMartinSkrivSange.Application. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ITMartinSkrivSange.Server</RootNamespace>
        <AssemblyName>ITMartinSkrivSange.Server</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ITMartin.Shared.UI\ITMartin.Shared.UI.csproj" />
        <ProjectReference Include="..\ITMartinSkrivSange.Application\ITMartinSkrivSange.Application.csproj" />
        <ProjectReference Include="..\ITMartinSkrivSange.Infrastructure\ITMartinSkrivSange.Infrastructure.csproj" />
    </ItemGroup>

</Project>
