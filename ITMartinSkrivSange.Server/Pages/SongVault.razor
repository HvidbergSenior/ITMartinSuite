@page "/vault"
@inject Vault Vault
@inject IJSRuntime JS

<PageTitle>Song Vault - SkrivSange</PageTitle>

<section class="k-card" data-nofold>
    <h1 class="k-card-title">Song Vault</h1>
    <p class="k-help">Vælg en indspilning fra musikmappen. Så kan du dele den i vokal og instrumental, finde akkorder og tempo, skrive teksten og synge ovenpå instrumentalen.</p>
    @if (_error is not null) { <p class="k-alert k-alert-warn">@_error</p> }
    <label class="k-label" for="vault-pick">Indspilning</label>
    <select id="vault-pick" class="k-input" value="@(_song?.RelativePath ?? "")" @onchange="e => Select(e.Value?.ToString())">
        <option value="">Vælg en sang ...</option>
        @foreach (var s in _sources)
        {
            <option value="@s.RelativePath">@s.Title</option>
        }
    </select>
    @if (_sources.Count == 0) { <p class="k-muted ss-small">Ingen lyd- eller videofiler fundet i musikmappen.</p> }
</section>

@if (_song is not null)
{
    <section class="k-card">
        <h2 class="k-card-title">Original</h2>
        <audio controls src="/stream?path=@Uri.EscapeDataString(_song.RelativePath)" preload="metadata" class="ss-audio"></audio>
    </section>

    <section class="k-card">
        <h2 class="k-card-title">Vokal og instrumental</h2>
        @if (_song.Stems is { Vocals: not null })
        {
            <p class="k-label">Vokal</p>
            <audio controls src="/stream?path=@Uri.EscapeDataString(Vault.StemPath(_song, "vocals.wav"))" preload="metadata" class="ss-audio"></audio>
        }
        @if (_song.Stems is { Instrumental: not null })
        {
            <p class="k-label k-mt">Instrumental (trommer, bas og resten)</p>
            <audio controls src="/stream?path=@Uri.EscapeDataString(Vault.StemPath(_song, "instrumental.wav"))" preload="metadata" class="ss-audio"></audio>
        }
        @if (_song.Stems is null) { <p class="k-help">Sporene er ikke delt endnu.</p> }
        @if (Vault.CanSplit)
        {
            <button class="k-btn k-mt" @onclick="Split" disabled="@_busy">@(_busy ? "Deler ... (kan tage flere minutter)" : _song.Stems is null ? "Del i vokal og instrumental" : "Del igen")</button>
        }
        else
        {
            <p class="k-muted ss-small">Opdeling kræver Demucs (Python), som ikke er installeret i denne udgave.</p>
        }
    </section>

    <section class="k-card">
        <h2 class="k-card-title">Tekst</h2>
        <p class="k-help">Skriv eller ret teksten mens du lytter. Gemmes når du forlader feltet.</p>
        <textarea class="k-textarea" rows="6" @bind="_lyrics" @bind:after="SaveMeta"></textarea>
    </section>

    <section class="k-card">
        <h2 class="k-card-title">Akkorder og tempo</h2>
        <label class="k-label" for="vault-chords">Akkorder (mm:ss akkord pr. linje)</label>
        <textarea id="vault-chords" class="k-textarea ss-mono" rows="6" @bind="_chords" @bind:after="SaveMeta"></textarea>
        <label class="k-label k-mt" for="vault-bpm">Tempo (BPM)</label>
        <input id="vault-bpm" class="k-input ss-bpm" type="number" @bind="_tempo" @bind:after="SaveMeta" />
        @if (Vault.CanDetect)
        {
            <div class="ss-row k-mt">
                <button class="k-btn" @onclick="DetectChords" disabled="@_busy">Find akkorder</button>
                <button class="k-btn" @onclick="DetectTempo" disabled="@_busy">Find tempo</button>
            </div>
        }
        else
        {
            <p class="k-muted ss-small">At finde akkorder og tempo kræver librosa (Python), som ikke er installeret i denne udgave.</p>
        }
    </section>

    <section class="k-card">
        <h2 class="k-card-title">Optag dig selv (@_song.Recordings.Count)</h2>
        <p class="k-help">Optager mikrofonen, mens instrumentalen (eller originalen) spiller.</p>
        @if (!_recording)
        {
            <button class="k-btn k-btn-primary" @onclick="StartRecording">Start optagelse</button>
        }
        else
        {
            <button class="k-btn k-btn-danger" @onclick="StopRecording">Stop optagelse</button>
        }
        @foreach (var r in _song.Recordings)
        {
            <p class="k-muted ss-small k-mt">@r.CreatedAt.ToLocalTime().ToString("d. MMM HH:mm")</p>
            <audio controls src="/stream?path=@Uri.EscapeDataString(r.RelativePath)" class="ss-audio"></audio>
        }
    </section>
}

@code {
    private List<SourceFile> _sources = [];
    private VaultSong? _song;
    private string _lyrics = "";
    private string _chords = "";
    private double? _tempo;
    private bool _busy;
    private bool _recording;
    private string? _error;

    protected override void OnInitialized() => _sources = Vault.Sources();

    private void Select(string? relativePath)
    {
        _error = null;
        _recording = false;
        _song = string.IsNullOrEmpty(relativePath) ? null : Vault.Open(relativePath);
        if (_song is null) return;
        (_lyrics, _chords, _tempo) = (_song.Meta.Lyrics, _song.Meta.Chords, _song.Meta.Tempo);
    }

    private void SaveMeta()
    {
        if (_song is null) return;
        Vault.SaveMeta(_song, new SongMeta(_lyrics, _chords, _tempo));
    }

    private async Task Busy(Func<VaultSong, Task> work)
    {
        if (_song is null) return;
        _busy = true;
        _error = null;
        StateHasChanged();
        try { await work(_song); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task Split() => Busy(async s => _song = s with { Stems = await Vault.SplitAsync(s) });

    private Task DetectChords() => Busy(async s => { _chords = await Vault.DetectChordsAsync(s); SaveMeta(); });

    private Task DetectTempo() => Busy(async s => { _tempo = await Vault.DetectTempoAsync(s); SaveMeta(); });

    private async Task StartRecording()
    {
        if (_song is null) return;
        _recording = true;
        var playPath = _song.Stems?.Instrumental is not null ? Vault.StemPath(_song, "instrumental.wav") : _song.RelativePath;
        await JS.InvokeVoidAsync("studio.startOverdub", _song.Key, $"/stream?path={Uri.EscapeDataString(playPath)}", false, 0);
    }

    private async Task StopRecording()
    {
        if (_song is null) return;
        _recording = false;
        await JS.InvokeVoidAsync("studio.stopRecording");
        await Task.Delay(800);
        _song = _song with { Recordings = Vault.Recordings(_song) };
    }
}
