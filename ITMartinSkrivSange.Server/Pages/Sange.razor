@page "/sange"
@inject SongWriting Writing
@inject Drafts OldDrafts
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>Mine sange - SkrivSange</PageTitle>

<section class="k-card" data-nofold>
    <h1 class="k-card-title">Mine sange</h1>
    <p class="k-help">Giv en ny sang en titel og tryk <b>Start</b> - så får du de seks dele Intro, Vers 1, Vers 2, Bridge, Vers 3 og Outro. Eller åbn en sang, du er i gang med.</p>
    <form class="ss-row" @onsubmit="Create">
        <input class="k-input ss-grow" placeholder="Hvad skal sangen hedde?" maxlength="@Song.MaxTitle" @bind="_title" aria-label="Titel på den nye sang" />
        <button class="k-btn k-btn-primary" type="submit" disabled="@string.IsNullOrWhiteSpace(_title)">Start</button>
    </form>
    @if (_error is not null) { <p class="k-alert k-alert-warn">@_error</p> }
</section>

<section class="k-card">
    <h2 class="k-card-title">Sange i gang (@(_songs?.Count ?? 0))</h2>
    @if (_songs is null)
    {
        <p class="k-muted">Henter ...</p>
    }
    else if (_songs.Count == 0)
    {
        <p class="k-help">Ingen sange endnu. Skriv en titel ovenfor og tryk Start.</p>
    }
    else
    {
        <div class="ss-tiles">
            @foreach (var s in _songs)
            {
                <a class="ss-tile" href="/sang/@s.Id">
                    <b>@s.Title</b>
                    <span>@s.Summary()</span>
                    <span class="k-muted">Ændret @s.UpdatedAt.ToLocalTime().ToString("d. MMM HH:mm")</span>
                </a>
            }
        </div>
    }
</section>

@if (_drafts is { Count: > 0 })
{
    <section class="k-card">
        <h2 class="k-card-title">Gamle udkast fra Musik Studio (@_drafts.Count)</h2>
        <p class="k-help">Udkast skrevet med den gamle guide (akkordrække, spillemønster, tempo, idé-optagelse). De ligger i Musik Studios database og kan åbnes her.</p>
        <div class="ss-tiles">
            @foreach (var d in _drafts)
            {
                <a class="ss-tile" href="/skriv/@Uri.EscapeDataString(d.Key)">
                    <b>@d.Title</b>
                    <span>@(string.IsNullOrWhiteSpace(d.ChordChart) ? "Ingen akkorder endnu" : d.ChordChart.Split('\n')[0])@(d.Tempo is { } t ? $" · {t} BPM" : "")</span>
                    <span class="k-muted">Ændret @d.UpdatedAt.ToLocalTime().ToString("d. MMM")</span>
                </a>
            }
        </div>
    </section>
}

<section class="k-card">
    <h2 class="k-card-title">Videre</h2>
    <div class="ss-tiles">
        <a class="ss-tile" href="/vault">
            <b>Song Vault</b>
            <span>Find akkorder og tempo i en indspilning, og syng ovenpå</span>
        </a>
        @if (!string.IsNullOrWhiteSpace(StudioUrl))
        {
            <a class="ss-tile" href="@StudioUrl" target="_blank" rel="noopener">
                <b>Musik Studio ↗</b>
                <span>Øv og indspil færdige sange</span>
            </a>
        }
        <a class="ss-tile" href="/api/logout">
            <b>Log ud</b>
            <span>Glem koden på denne enhed</span>
        </a>
    </div>
</section>

@code {
    private IReadOnlyList<Song>? _songs;
    private IReadOnlyList<StudioSong>? _drafts;
    private string _title = "";
    private string? _error;
    private string StudioUrl => Config["StudioSettings:StudioUrl"] ?? "";

    protected override async Task OnInitializedAsync()
    {
        _songs = await Writing.ListAsync();
        // studio.db sits on the NAS share; SkrivSange works without it.
        try { _drafts = await OldDrafts.ListAsync(); } catch (Exception) { _drafts = []; }
    }

    private async Task Create()
    {
        try
        {
            var song = await Writing.CreateAsync(_title);
            Nav.NavigateTo($"/sang/{song.Id}");
        }
        catch (SongException ex) { _error = ex.Message; }
    }
}
