@page "/"
@layout EmptyLayout

<PageTitle>SkrivSange</PageTitle>

<div class="ss-login">
    <section class="k-card" data-nofold>
        <h1 class="k-card-title">SkrivSange</h1>
        <p class="k-help">Skriv din egen sang del for del - Intro, vers, bridge og outro - med åbne greb og capo. Skriv koden for at komme ind.</p>
        @if (Fejl == "1") { <p class="k-alert k-alert-warn">Forkert kode - prøv igen.</p> }
        <form method="post" action="/api/login" class="k-stack">
            <label class="k-label" for="kode">Kode</label>
            <input id="kode" type="password" name="kode" class="k-input" autocomplete="current-password" autofocus />
            <button class="k-btn k-btn-primary k-btn-block" type="submit">Kom ind</button>
        </form>
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? Fejl { get; set; }
}
