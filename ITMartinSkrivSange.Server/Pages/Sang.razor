@page "/sang/{Id:guid}"
@implements IAsyncDisposable
@inject SongWriting Writing
@inject Practice Practice
@inject IJSRuntime JS

<PageTitle>@(_song?.Title ?? "Sang") - SkrivSange</PageTitle>

@if (_song is null)
{
    <section class="k-card" data-nofold>
        <h1 class="k-card-title">@(_loaded ? "Sangen findes ikke" : "Henter ...")</h1>
        @if (_loaded) { <a class="k-btn k-btn-primary" href="/sange">Til Mine sange</a> }
    </section>
}
else
{
    <section class="k-card ss-top" data-nofold>
        <h1 class="k-card-title">@_song.Title</h1>
        <p class="ss-summary">@_song.Summary()</p>
        <p class="k-help">Seks dele: tryk <b>Foreslå</b> på en del for akkorder der passer til resten, eller <b>Vælg selv</b>. <b>Spil</b> spiller delen med spillemåden nedenfor. Tekstnoterne gemmes af sig selv.</p>
        @if (_error is not null) { <p class="k-alert k-alert-warn">@_error</p> }
        <div class="ss-row">
            @if (_playing is null)
            {
                <button class="k-btn k-btn-primary" @onclick="PlaySong" disabled="@(!_song.Parts.Any(p => p.HasChords))">Spil hele sangen</button>
            }
            else
            {
                <button class="k-btn k-btn-danger" @onclick="Stop">Stop</button>
            }
            <a class="k-btn k-btn-ghost" href="/sange">Mine sange</a>
        </div>
    </section>

    <section class="k-card">
        <h2 class="k-card-title">Sangen: titel, stemning, capo, tempo, spillemåde</h2>
        <p class="k-help">Stemningen bestemmer, hvad Foreslå starter med. Capoen flytter hele sangen op - grebene er de samme.</p>

        <label class="k-label" for="ss-title">Titel</label>
        <input id="ss-title" class="k-input" value="@_song.Title" maxlength="@Song.MaxTitle" @onchange="Rename" />

        <div class="k-label k-mt">Stemning</div>
        <div class="ss-chips">
            @foreach (var mood in ProgressionLibrary.Moods)
            {
                <button class="ss-chip @(mood == _song.Mood ? "is-on" : "")" aria-pressed="@(mood == _song.Mood)" @onclick="() => Do(s => Writing.SetMoodAsync(s, mood))">@mood</button>
            }
        </div>

        <div class="ss-grid k-mt">
            <div>
                <label class="k-label" for="ss-capo">Capo</label>
                <select id="ss-capo" class="k-input" value="@_song.Capo" @onchange="e => Do(s => Writing.SetCapoAsync(s, int.Parse(e.Value!.ToString()!)))">
                    @for (var c = 0; c <= Capo.Max; c++)
                    {
                        <option value="@c">@(c == 0 ? "Ingen capo" : $"Bånd {c}")</option>
                    }
                </select>
                @if (_song.HomeGrip is { } home)
                {
                    <p class="k-muted ss-small">Greb i @Chords.KeyName(home) - klinger i @_song.SoundingKey</p>
                }
            </div>
            <div>
                <label class="k-label" for="ss-bpm">Tempo (BPM)</label>
                <div class="ss-row">
                    <button class="k-btn k-btn-sm" @onclick="() => Do(s => Writing.SetBpmAsync(s, s.Bpm - 5))" aria-label="5 langsommere">−</button>
                    <input id="ss-bpm" class="k-input ss-bpm" type="number" min="@Song.MinBpm" max="@Song.MaxBpm" value="@_song.Bpm"
                           @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var b)) return Do(s => Writing.SetBpmAsync(s, b)); return Task.CompletedTask; }" />
                    <button class="k-btn k-btn-sm" @onclick="() => Do(s => Writing.SetBpmAsync(s, s.Bpm + 5))" aria-label="5 hurtigere">+</button>
                </div>
            </div>
        </div>

        <div class="k-label k-mt">Spillemåde - slag, pluk eller begge</div>
        @foreach (var group in Strums.Kinds)
        {
            <div class="ss-kind">@group</div>
            <div class="ss-chips">
                @foreach (var strum in Strums.All.Where(x => x.Kind == group))
                {
                    <button class="ss-chip @(strum.Id == _song.StrumId ? "is-on" : "")" aria-pressed="@(strum.Id == _song.StrumId)" title="@strum.Feel"
                            @onclick="() => Do(s => Writing.SetStrumAsync(s, strum.Id))">
                        @strum.Name <span class="ss-strum">@StrumText(strum)</span>
                    </button>
                }
            </div>
        }
        <p class="k-muted ss-small">@Strums.Find(_song.StrumId).Feel. N = slag ned, O = slag op, B = bas (tommel), V = vekselbas, 3 2 1 = G-, B- og lyse e-streng, · = lad den klinge.</p>
    </section>

    @foreach (var part in _song.Parts)
    {
        var kind = part.Kind;
        var playingThis = _playing == kind;
        <section class="k-card ss-part" id="part-@kind">
            <h2 class="k-card-title">@part.Label <span class="ss-head-chords">@(part.HasChords ? string.Join(" ", part.Chords) : "ingen akkorder endnu")</span></h2>

            @if (part.HasChords)
            {
                <div class="ss-chords">
                    @for (var i = 0; i < part.Chords.Count; i++)
                    {
                        var index = i;
                        var picked = _focus == (kind, index);
                        <div class="ss-tile-wrap">
                            <button class="ss-grip @(picked ? "is-picked" : "")" id="chord-@((int)kind)-@i" aria-expanded="@picked"
                                    title="Tryk for andre akkorder og hvad der lyder godt bagefter" @onclick="() => Focus(kind, index)"><span class="ss-grip-name">@part.Chords[i]</span><GripDiagram Chord="@part.Chords[i]" /></button>
                            <button class="ss-grip-x" aria-label="Fjern @part.Chords[i]" title="Fjern @part.Chords[i]" @onclick="() => Remove(kind, index)">✕</button>
                        </div>
                    }
                    @if (part.Chords.Count < Song.MaxChords)
                    {
                        <button class="ss-grip ss-grip-add @(_adding == kind ? "is-picked" : "")" aria-expanded="@(_adding == kind)" title="Sæt en akkord ind til sidst" @onclick="() => ToggleAdd(kind)">+<span class="ss-grip-name">Akkord</span></button>
                    }
                </div>
                @if (_adding == kind)
                {
                    var last = part.HasChords ? part.Chords[^1] : null;
                    <div class="ss-ideas">
                        @if (last is not null)
                        {
                            <div class="k-label">Lyder godt efter @last</div>
                            <div class="ss-chips">
                                @foreach (var idea in Writing.ChordIdeas(_song, last).Next)
                                {
                                    <button class="ss-chip" @onclick="() => Append(kind, idea.Chord)">+ <b>@idea.Chord</b> <span class="ss-why">@idea.Why</span></button>
                                }
                            </div>
                        }
                        <div class="k-label k-mt">Alle åbne greb</div>
                        <div class="ss-chips">
                            @foreach (var g in Chords.OpenGrips)
                            {
                                <button class="ss-chip" @onclick="() => Append(kind, g)">+ <b>@g</b></button>
                            }
                        </div>
                        <div class="ss-row"><button class="k-btn k-btn-ghost k-btn-sm" @onclick="() => _adding = null">Luk</button></div>
                    </div>
                }
                @if (_focus is { } f && f.Kind == kind && f.Index < part.Chords.Count)
                {
                    var chord = part.Chords[f.Index];
                    var (instead, next) = Writing.ChordIdeas(_song, chord);
                    <div class="ss-ideas">
                        <div class="k-label">I stedet for @chord</div>
                        <div class="ss-chips">
                            @foreach (var idea in instead)
                            {
                                <button class="ss-chip" title="Skift @chord ud med @idea.Chord" @onclick="() => Replace(kind, f.Index, idea.Chord)"><b>@idea.Chord</b> <span class="ss-why">@idea.Why</span></button>
                            }
                            @if (instead.Count == 0) { <span class="k-muted ss-small">Ingen åbne greb i tonearten ligner @chord.</span> }
                        </div>
                        <div class="k-label k-mt">Lyder godt efter @chord</div>
                        <div class="ss-chips">
                            @foreach (var idea in next)
                            {
                                <button class="ss-chip" title="Sæt @idea.Chord ind efter @chord" disabled="@(part.Chords.Count >= Song.MaxChords)" @onclick="() => InsertAfter(kind, f.Index, idea.Chord)">+ <b>@idea.Chord</b> <span class="ss-why">@idea.Why</span></button>
                            }
                        </div>
                        <details class="ss-all">
                            <summary>Andre greb at sætte ind efter @chord</summary>
                            <div class="ss-chips">
                                @foreach (var g in Chords.OpenGrips)
                                {
                                    <button class="ss-chip" disabled="@(part.Chords.Count >= Song.MaxChords)" @onclick="() => InsertAfter(kind, f.Index, g)">+ <b>@g</b></button>
                                }
                            </div>
                        </details>
                        <p class="k-muted ss-small">Tryk en akkord for at skifte eller sætte den ind - tryk Spil for at høre det. @(part.Chords.Count >= Song.MaxChords ? $"Delen har allerede {Song.MaxChords} akkorder." : "")</p>
                        <div class="ss-row">
                            <button class="k-btn k-btn-ghost k-btn-sm" @onclick="() => Remove(kind, f.Index)">Fjern @chord</button>
                            <button class="k-btn k-btn-ghost k-btn-sm" @onclick="() => _focus = null">Luk</button>
                        </div>
                    </div>
                }
                @if (_song.Capo > 0)
                {
                    <p class="k-muted ss-small">Grebene tælles fra capoen på bånd @_song.Capo. Det klinger som @string.Join(" ", Chords.Transpose(part.Chords, _song.Capo))</p>
                }
                @if (ProgressionLibrary.Find(part.ProgressionId) is { } prog)
                {
                    <p class="k-muted ss-small">@prog.Name (@prog.Mood.ToLowerInvariant()) - @prog.Feel</p>
                }
                else if (_own.FirstOrDefault(o => o.ProgressionId == part.ProgressionId) is { } mine)
                {
                    <p class="k-muted ss-small">@mine.Name - din egen</p>
                }
            }
            else
            {
                <p class="k-help">Tryk Foreslå, Vælg selv mellem akkordrækkerne, Skriv selv dine egne - eller byg den op akkord for akkord med +.</p>
                <div class="ss-chords">
                    <button class="ss-grip ss-grip-add @(_adding == kind ? "is-picked" : "")" aria-expanded="@(_adding == kind)" title="Sæt den første akkord ind" @onclick="() => ToggleAdd(kind)">+<span class="ss-grip-name">Akkord</span></button>
                </div>
                @if (_adding == kind)
                {
                    var last = part.HasChords ? part.Chords[^1] : null;
                    <div class="ss-ideas">
                        @if (last is not null)
                        {
                            <div class="k-label">Lyder godt efter @last</div>
                            <div class="ss-chips">
                                @foreach (var idea in Writing.ChordIdeas(_song, last).Next)
                                {
                                    <button class="ss-chip" @onclick="() => Append(kind, idea.Chord)">+ <b>@idea.Chord</b> <span class="ss-why">@idea.Why</span></button>
                                }
                            </div>
                        }
                        <div class="k-label k-mt">Alle åbne greb</div>
                        <div class="ss-chips">
                            @foreach (var g in Chords.OpenGrips)
                            {
                                <button class="ss-chip" @onclick="() => Append(kind, g)">+ <b>@g</b></button>
                            }
                        </div>
                        <div class="ss-row"><button class="k-btn k-btn-ghost k-btn-sm" @onclick="() => _adding = null">Luk</button></div>
                    </div>
                }
                @if (ChordInput.TryParse(part.Notes) is { } fromNotes)
                {
                    @* Chords written in the lyric notes before Skriv selv existed (user 2026-10-14). *@
                    <button class="k-btn k-btn-primary" @onclick="() => ChordsFromNotes(kind)">Brug @string.Join(" ", fromNotes) fra tekstnoterne som akkorder</button>
                }
            }

            @if (_why.TryGetValue(kind, out var why)) { <p class="k-alert k-alert-info">@why</p> }

            <div class="ss-row">
                <button class="k-btn k-btn-primary" @onclick="() => Suggest(kind)">@(part.HasChords ? "Foreslå en anden" : "Foreslå")</button>
                @if (part.HasChords)
                {
                    @if (playingThis)
                    {
                        <button class="k-btn k-btn-danger" @onclick="Stop">Stop</button>
                    }
                    else
                    {
                        <button class="k-btn" @onclick="() => PlayPart(kind)" disabled="@(_playing is not null)">Spil</button>
                    }
                }
                <button class="k-btn k-btn-ghost" aria-expanded="@(_picker == kind)" @onclick="() => _picker = _picker == kind ? null : kind">@(_picker == kind ? "Luk listen" : "Vælg selv")</button>
                <button class="k-btn k-btn-ghost" aria-expanded="@(_typing == kind)" @onclick="() => OpenTyping(kind)">@(_typing == kind ? "Luk" : "Skriv selv")</button>
                @if (part.HasChords)
                {
                    <button class="k-btn k-btn-ghost" @onclick="() => Do(s => Writing.ClearChordsAsync(s, kind))">Ryd akkorder</button>
                }
            </div>

            @if (_typing == kind)
            {
                <div class="ss-picker">
                    <p class="k-help k-mt">Skriv dine egne akkorder, fx <b>Am G Am G</b> (komma eller mellemrum). De bruges her og gemmes som @(string.IsNullOrWhiteSpace(_typedName) ? OwnProgression.NextName(_own) : _typedName.Trim()), så du kan vælge dem i alle sange under Vælg selv.</p>
                    <form class="ss-row" @onsubmit="() => SaveTyped(kind)">
                        <input class="k-input ss-grow" @bind="_typedChords" @bind:event="oninput" placeholder="Am G Am G" aria-label="Dine akkorder" />
                        <input class="k-input ss-grow" @bind="_typedName" @bind:event="oninput" maxlength="@OwnProgression.MaxName" placeholder="Navn (ellers @OwnProgression.NextName(_own))" aria-label="Navn til akkordrækken" />
                        <button class="k-btn k-btn-primary" type="submit" disabled="@string.IsNullOrWhiteSpace(_typedChords)">Brug og gem</button>
                    </form>
                    <p class="k-muted ss-small">Åbne greb: @string.Join(" ", Chords.OpenGrips). Skift toneart med capoen.</p>
                </div>
            }

            @if (_picker == kind)
            {
                <div class="ss-picker">
                    @if (_own.Count > 0)
                    {
                        <div class="k-label k-mt">Mine egne</div>
                        <div class="ss-options">
                            @foreach (var o in _own)
                            {
                                <div class="ss-own">
                                    <button class="ss-option @(o.ProgressionId == part.ProgressionId ? "is-on" : "")" aria-pressed="@(o.ProgressionId == part.ProgressionId)" @onclick="() => Pick(kind, o.ProgressionId)">
                                        <b>@string.Join(" ", o.Chords)</b>
                                        <span>@o.Name</span>
                                    </button>
                                    <button class="k-btn k-btn-ghost k-btn-sm" title="Fjern @o.Name fra listen (sange beholder akkorderne)" @onclick="() => DeleteOwn(o)">Fjern</button>
                                </div>
                            }
                        </div>
                    }
                    @foreach (var mood in ProgressionLibrary.Moods.OrderBy(m => m == _song.Mood ? 0 : 1))
                    {
                        <div class="k-label k-mt">@mood</div>
                        <div class="ss-options">
                            @foreach (var p in ProgressionLibrary.ForMood(mood))
                            {
                                <button class="ss-option @(p.Id == part.ProgressionId ? "is-on" : "")" aria-pressed="@(p.Id == part.ProgressionId)" @onclick="() => Pick(kind, p.Id)">
                                    <b>@string.Join(" ", p.Chords)</b>
                                    <span>@p.Name - @p.Feel</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            @if (part.HasChords)
            {
                var takes = Practice.Takes(_song, kind);
                <div class="ss-practice">
                    <div class="k-label">Øv og optag @part.Label.ToLowerInvariant()</div>
                    <p class="k-muted ss-small">Øv i loop spiller delen igen og igen, så du kan spille med. Optag gemmer dig selv fra mikrofonen - med loopet med i baggrunden, hvis du vil (brug høretelefoner for en ren optagelse).</p>
                    <div class="ss-row">
                        <label class="k-label ss-inline" for="speed-@kind">Tempo</label>
                        <select id="speed-@kind" class="k-input ss-speed" value="@_speed" @onchange="e => _speed = int.Parse(e.Value!.ToString()!)">
                            <option value="100">Fuldt (@_song.Bpm BPM)</option>
                            <option value="80">80 % (@(_song.Bpm * 80 / 100) BPM)</option>
                            <option value="60">60 % (@(_song.Bpm * 60 / 100) BPM)</option>
                        </select>
                        @if (_loop == kind && _recordingPart is null)
                        {
                            <button class="k-btn k-btn-danger" @onclick="Stop">Stop loop</button>
                        }
                        else
                        {
                            <button class="k-btn" @onclick="() => Loop(kind)" disabled="@(_playing is not null || _recordingPart is not null)">Øv i loop</button>
                        }
                    </div>
                    <div class="ss-row">
                        @if (_recordingPart == kind)
                        {
                            <button class="k-btn k-btn-danger" @onclick="StopRecording">Stop optagelse (@FormatTime(_recSeconds))</button>
                        }
                        else
                        {
                            <button class="k-btn k-btn-primary" @onclick="() => Record(kind)" disabled="@(_recordingPart is not null || _playing is not null)">Optag</button>
                            <label class="ss-check"><input type="checkbox" @bind="_recordWithLoop" /> med loopet i baggrunden</label>
                        }
                    </div>
                    @foreach (var take in takes)
                    {
                        <div class="ss-take">
                            <span class="k-muted ss-small">@take.CreatedAt.ToLocalTime().ToString("d. MMM HH:mm")</span>
                            <audio controls preload="none" src="/stream?path=@Uri.EscapeDataString(take.RelativePath)" class="ss-audio"></audio>
                            <button class="k-btn k-btn-ghost k-btn-sm" @onclick="() => DeleteTake(take)">Slet</button>
                        </div>
                    }
                    @if (takes.Count == 0) { <p class="k-muted ss-small">Ingen optagelser af @part.Label.ToLowerInvariant() endnu.</p> }
                </div>
            }

            <label class="k-label k-mt" for="notes-@kind">Tekstnoter til @part.Label.ToLowerInvariant()</label>
            <textarea id="notes-@kind" class="k-textarea ss-notes" rows="4" maxlength="@Song.MaxNotes"
                      placeholder="Linjer, ord, rim, hvad delen skal handle om ..." value="@NotesValue(part)"
                      @oninput="e => NotesTyped(kind, e.Value?.ToString())" @onchange="e => NotesDone(kind, e.Value?.ToString())"></textarea>
            <p class="k-muted ss-small">@(_saved.Contains(kind) ? "Gemt." : "Gemmes af sig selv, mens du skriver.")</p>
        </section>
    }

    <section class="k-card">
        <h2 class="k-card-title">Slet sangen</h2>
        <p class="k-help">Sletter titlen, akkorderne og alle tekstnoter. Det kan ikke fortrydes.</p>
        @if (_confirmDelete)
        {
            <div class="ss-row">
                <button class="k-btn k-btn-danger" @onclick="Delete">Ja, slet @_song.Title</button>
                <button class="k-btn k-btn-ghost" @onclick="() => _confirmDelete = false">Nej</button>
            </div>
        }
        else
        {
            <button class="k-btn k-btn-ghost" @onclick="() => _confirmDelete = true">Slet sangen</button>
        }
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private Song? _song;
    private IReadOnlyList<OwnProgression> _own = [];
    private PartKind? _typing;
    private (PartKind Kind, int Index)? _focus;     // the chord tile pressed for ideas
    private PartKind? _loop;                         // the part looping for practice
    private PartKind? _adding;                       // the part whose + tile is open
    private PartKind? _recordingPart;
    private bool _recordWithLoop = true;
    private int _speed = 100;                        // practice tempo in % of the song's BPM
    private int _recSeconds;
    private System.Threading.Timer? _recTimer;
    private string _typedChords = "";
    private string _typedName = "";
    private bool _loaded;
    private string? _error;
    private PartKind? _picker;
    private PartKind? _playing;      // the part playing, or Intro..Outro while the whole song plays
    private bool _playingSong;
    private bool _confirmDelete;
    private readonly Dictionary<PartKind, string> _why = [];
    private readonly HashSet<PartKind> _saved = [];
    private readonly Dictionary<PartKind, string> _pendingNotes = [];
    private System.Threading.Timer? _notesTimer;
    private DotNetObjectReference<Sang>? _self;

    protected override async Task OnInitializedAsync()
    {
        _song = await Writing.GetAsync(Id);
        _own = await Writing.OwnProgressionsAsync();
        _loaded = true;
    }

    private static string StrumText(StrumPattern s) =>
        string.Join(" ", s.Pattern.Select(c => c switch { 'D' => "N", 'U' => "O", '-' => "·", var x => x.ToString() }));

    private async Task Do(Func<Song, Task> change)
    {
        if (_song is null) return;
        _error = null;
        try { await change(_song); }
        catch (SongException ex) { _error = ex.Message; }
    }

    private Task Rename(ChangeEventArgs e) => Do(s => Writing.RenameAsync(s, e.Value?.ToString() ?? ""));

    private async Task Suggest(PartKind kind)
    {
        if (_song is null) return;
        _error = null;
        try { _why[kind] = (await Writing.SuggestAndUseAsync(_song, kind)).Why; }
        catch (SongException ex) { _error = ex.Message; }
    }

    private async Task Pick(PartKind kind, string progressionId)
    {
        _why.Remove(kind);
        await Do(s => Writing.UseProgressionAsync(s, kind, progressionId));
        _picker = null;
    }

    // ---- Ideas for one chord: alternatives and what sounds nice next (domain ChordAdvisor, no AI).

    private void Focus(PartKind kind, int index) => _focus = _focus == (kind, index) ? null : (kind, index);

    private async Task Replace(PartKind kind, int index, string chord)
    {
        _why.Remove(kind);
        await Do(s => Writing.ReplaceChordAsync(s, kind, index, chord));
        await Changed(kind);
    }

    private async Task InsertAfter(PartKind kind, int index, string chord)
    {
        _why.Remove(kind);
        await Do(s => Writing.InsertChordAfterAsync(s, kind, index, chord));
        if (_error is null) _focus = (kind, index + 1);   // go on from the new chord
        await Changed(kind);
    }

    private async Task Remove(PartKind kind, int index)
    {
        _why.Remove(kind);
        await Do(s => Writing.RemoveChordAsync(s, kind, index));
        _focus = null;
        await Changed(kind);
    }

    private void ToggleAdd(PartKind kind)
    {
        _adding = _adding == kind ? null : kind;
        _focus = null;
    }

    // + tile: add at the end, keep the panel open for the next one.
    private async Task Append(PartKind kind, string chord)
    {
        if (_song is null) return;
        _why.Remove(kind);
        await Do(s => Writing.InsertChordAfterAsync(s, kind, s.Part(kind).Chords.Count - 1, chord));
        if (_song.Part(kind).Chords.Count >= Song.MaxChords) _adding = null;
        await Changed(kind);
    }

    // On the fly (user 2026-10-14): a part that is looping starts again with the new chords - a running recording goes on.
    private async Task Changed(PartKind kind)
    {
        if (_loop != kind || _song is null) return;
        if (_song.Part(kind).HasChords) await Loop(kind);
        else if (_recordingPart is null) await Stop();
    }

    // ---- Own chords ("MartinChord n"), user 2026-10-14.

    private void OpenTyping(PartKind kind)
    {
        _typing = _typing == kind ? null : kind;
        _picker = null;
        _typedChords = _song?.Part(kind).Chords is { Count: > 0 } c ? string.Join(" ", c) : "";
        _typedName = "";
    }

    private async Task SaveTyped(PartKind kind)
    {
        if (_song is null) return;
        _error = null;
        try
        {
            var countBefore = _own.Count;
            var mine = await Writing.UseOwnChordsAsync(_song, kind, _typedChords, _typedName);
            _own = await Writing.OwnProgressionsAsync();
            _why[kind] = _own.Count > countBefore
                ? $"Gemt som {mine.Name} - findes nu under Vælg selv i alle sange."
                : $"De akkorder har du allerede gemt som {mine.Name}.";
            _typing = null;
        }
        catch (SongException ex) { _error = ex.Message; }
    }

    // The notes held only chords: make them the part's chords (saved as MartinChord) and empty the notes.
    private async Task ChordsFromNotes(PartKind kind)
    {
        if (_song is null) return;
        _typedChords = _song.Part(kind).Notes;
        _typedName = "";
        await SaveTyped(kind);
        if (_error is null && _song.Part(kind).HasChords) await Writing.WriteNotesAsync(_song, kind, "");
    }

    private async Task DeleteOwn(OwnProgression o)
    {
        await Writing.DeleteOwnAsync(o);
        _own = await Writing.OwnProgressionsAsync();
    }

    // ---- Lyric notes: saved 1 s after the last key, and at once when the field is left.

    // What is typed but not saved yet wins, so a re-render never takes letters back.
    private string NotesValue(SongPart p) => _pendingNotes.TryGetValue(p.Kind, out var t) ? t : p.Notes;

    private void NotesTyped(PartKind kind, string? text)
    {
        _pendingNotes[kind] = text ?? "";
        _saved.Remove(kind);
        _notesTimer ??= new System.Threading.Timer(_ => InvokeAsync(FlushNotes));
        _notesTimer.Change(1000, Timeout.Infinite);
    }

    private async Task NotesDone(PartKind kind, string? text)
    {
        _pendingNotes[kind] = text ?? "";
        await FlushNotes();
    }

    private async Task FlushNotes()
    {
        if (_song is null || _pendingNotes.Count == 0) return;
        foreach (var (kind, text) in _pendingNotes.ToList())
        {
            await Writing.WriteNotesAsync(_song, kind, text);
            if (_pendingNotes.GetValueOrDefault(kind) != text) continue;   // typed on while saving - the timer takes the rest
            _pendingNotes.Remove(kind);
            _saved.Add(kind);
        }
        StateHasChanged();
    }

    // ---- Playing (js/strum.js: plucked strings in Web Audio, no sound files).

    // The player gets the exact strings of each grip (domain Grips), so what you hear is what the chord box shows.
    private object PartForJs(SongPart p) => new { index = (int)p.Kind, chords = p.Chords.Select(c => Grips.For(c)?.Frets ?? []) };

    private async Task PlayPart(PartKind kind) => await Play([_song!.Part(kind)], kind, song: false);

    private async Task PlaySong() => await Play(_song!.Parts.Where(p => p.HasChords).ToList(), _song.Parts.First(p => p.HasChords).Kind, song: true);

    private async Task Loop(PartKind kind)
    {
        await Play([_song!.Part(kind)], kind, song: false, loop: true);
        if (_playing is not null) _loop = kind;
    }

    private async Task Play(List<SongPart> parts, PartKind first, bool song, bool loop = false)
    {
        if (_song is null || parts.Count == 0) return;
        _self ??= DotNetObjectReference.Create(this);
        _playing = first;
        _playingSong = song;
        var bpm = loop ? Math.Max(Song.MinBpm, _song.Bpm * _speed / 100) : _song.Bpm;
        try
        {
            await JS.InvokeVoidAsync("skrivStrum.play", parts.Select(PartForJs), bpm, Strums.Find(_song.StrumId).Pattern, _song.Capo, _self, loop);
        }
        catch (JSException)
        {
            _playing = null;
            _error = "Browseren kunne ikke spille lyd. Prøv Chrome, Edge eller Safari.";
        }
    }

    [JSInvokable] public async Task PartStarted(int index)
    {
        if (_playingSong) { _playing = (PartKind)index; await InvokeAsync(StateHasChanged); }
    }

    [JSInvokable] public async Task PlayDone()
    {
        _playing = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Stop()
    {
        _playing = null;
        _loop = null;
        try { await JS.InvokeVoidAsync("skrivStrum.stop"); } catch (JSException) { }
    }

    // ---- Recording a part (js/studio.js records the mic and uploads it as take-{part}-{time}.webm).

    private static string FormatTime(int seconds) => $"{seconds / 60}:{seconds % 60:D2}";

    private async Task Record(PartKind kind)
    {
        if (_song is null) return;
        _error = null;
        // Browsers only give the microphone to https pages (and localhost) - on http://10.0.0.126:8131 it never even asks.
        if (!await JS.InvokeAsync<bool>("eval", "window.isSecureContext === true"))
        {
            _error = "Optagelse virker kun på en sikker adresse (https). Åbn SkrivSange på https://skrivsange.itmartin.dk - på http://10.0.0.126:8131 må browseren ikke bruge mikrofonen.";
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("studio.startRecording", _song.RecordingKey, false, Parts.Slug(kind));
        }
        catch (JSException)
        {
            _error = "Mikrofonen kunne ikke startes. Tillad mikrofon i browseren (hængelåsen ved adressen) og prøv igen.";
            return;
        }
        _recordingPart = kind;
        _recSeconds = 0;
        _recTimer = new System.Threading.Timer(_ => InvokeAsync(() => { _recSeconds++; StateHasChanged(); }), null, 1000, 1000);
        if (_recordWithLoop) await Loop(kind);
    }

    private async Task StopRecording()
    {
        if (_recTimer is not null) { await _recTimer.DisposeAsync(); _recTimer = null; }
        await Stop();
        try { await JS.InvokeVoidAsync("studio.stopRecording"); } catch (JSException) { }
        _recordingPart = null;   // studio.stopRecording waits for the upload, so the new take is on disk now
    }

    private void DeleteTake(RecordingFile take)
    {
        if (!Practice.DeleteTake(take)) _error = "Optagelsen kunne ikke slettes - stop afspilningen af den og prøv igen.";
    }

    private async Task Delete()
    {
        if (_song is null) return;
        await Writing.DeleteAsync(_song);
        Nav.NavigateTo("/sange");
    }

    public async ValueTask DisposeAsync()
    {
        if (_notesTimer is not null) await _notesTimer.DisposeAsync();
        if (_recTimer is not null) await _recTimer.DisposeAsync();
        try { if (_recordingPart is not null) await JS.InvokeVoidAsync("studio.stopRecording"); } catch (Exception) { }
        if (_song is not null && _pendingNotes.Count > 0)
            foreach (var (kind, text) in _pendingNotes) await Writing.WriteNotesAsync(_song, kind, text);
        try { if (_playing is not null) await JS.InvokeVoidAsync("skrivStrum.stop"); } catch (Exception) { }
        _self?.Dispose();
    }
}
