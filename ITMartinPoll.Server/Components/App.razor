<!DOCTYPE html>
<html lang="da" data-family="bestoever">
<head>
    <script>
        // Dark or light: what the visitor chose with Lys/Mørk, else what the phone is set to (user 2026-10-21 "follow the
        // phone"). Set before the first paint, so it never flashes the other way.
        (function () {
            var t = localStorage.getItem('stem_theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f6f5" />
    <base href="/" />
    <link rel="stylesheet" href="_content/ITMartin.Shared.UI/css/kolibri.css?v=@CacheBuster" />
    <script src="_content/ITMartin.Shared.UI/kolibri.js?v=@CacheBuster" defer></script>
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/_content/ITMartin.Shared.UI/kolibri-icon.svg" />
    <link rel="stylesheet" href="ITMartinPoll.Server.styles.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    @* One connected app, like ElPriser (2026-10-21): every page in the same connection, so going between pages does not
       flicker and the kundenummer is read once per visit (CustomerSession). *@
    <Routes @rendermode="InteractiveServer" />
    <script>
    // The Lys/Mørk button is in the Kolibri header, which Blazor renders again - so the click is caught on the document
    // and the label is kept in step whenever the page changes.
    (function () {
        function sync() {
            var current = document.documentElement.getAttribute('data-theme') || 'light';
            var btn = document.getElementById('themeToggleBtn');
            var label = current === 'light' ? 'Mørk' : 'Lys';
            if (btn && btn.textContent !== label) btn.textContent = label;   // only when it differs - else the observer loops
            var meta = document.querySelector('meta[name=theme-color]');
            if (meta) meta.setAttribute('content', current === 'light' ? '#f4f6f5' : '#121917');
        }
        document.addEventListener('click', function (e) {
            if (!e.target.closest || !e.target.closest('#themeToggleBtn')) return;
            var next = (document.documentElement.getAttribute('data-theme') || 'light') === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('stem_theme', next);
            sync();
        });
        new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
        sync();
    })();
    </script>
    <script src="_framework/blazor.web.js"></script>
    <script>if("serviceWorker" in navigator){navigator.serviceWorker.register("/kolibri-sw.js").catch(function(){});}</script>
    <script>
        window.scrollToId = function(id) {
            var el = document.getElementById(id);
            if (el) el.scrollIntoView({ block: 'start' });
        };
    </script>

<script>
(function(){
    var vid = localStorage.getItem('_mid');
    if (!vid) { vid = Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2); localStorage.setItem('_mid', vid); }
    function track(path, title, referrer) {
        if (location.search.indexOf('claude_test=1') !== -1) return;
        fetch('https://stats.itmartin.dk/api/hit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: path, title: title, referrer: referrer, visitorId: vid, host: location.hostname }),
            keepalive: true
        }).catch(function(){});
    }
    track(location.pathname + location.search, document.title, document.referrer);
    document.addEventListener('click', function(e) {
        var a = e.target.closest('a');
        if (!a || !a.href || a.href.startsWith('javascript')) return;
        var href = a.getAttribute('href') || a.href;
        track('click:' + href, a.textContent.trim().slice(0, 80), location.pathname);
    }, true);
})();
</script>
</body>
</html>

@code {
    // Was a manually-incremented "?v=8" that never got bumped across
    // deploys, exactly why a CSS fix (poll-hero-img sizing, 2026-08-24)
    // silently kept serving the stale cached version behind Cloudflare's
    // edge cache (max-age=14400) even after a fresh deploy. Same
    // per-process-start cache-buster pattern already used by PDF-tool/
    // DailyBrief - auto-bumps every deploy since it's a fresh process.
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
