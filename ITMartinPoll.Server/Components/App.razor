<!DOCTYPE html>
<html lang="da">
<head>
    @* Lyst tema, og kun lyst (bruger, 2026-09-10). Temavælgeren og det
       tilhørende script er fjernet, og paletten står nu direkte i :root i
       app.css - så der er intet at anvende før første paint, og ingen gammel
       "dark"-værdi i localStorage kan slå igennem. *@
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f5f9" />
    <base href="/" />
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    <link rel="stylesheet" href="ITMartinPoll.Server.styles.css" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.scrollToId = function(id) {
            var el = document.getElementById(id);
            if (el) el.scrollIntoView({ block: 'start' });
        };
    </script>

<script>
(function(){
    var vid = localStorage.getItem('_mid');
    if (!vid) { vid = Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2); localStorage.setItem('_mid', vid); }
    function track(path, title, referrer) {
        if (location.search.indexOf('claude_test=1') !== -1) return;
        fetch('https://stats.itmartin.dk/api/hit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: path, title: title, referrer: referrer, visitorId: vid, host: location.hostname }),
            keepalive: true
        }).catch(function(){});
    }
    track(location.pathname + location.search, document.title, document.referrer);
    document.addEventListener('click', function(e) {
        var a = e.target.closest('a');
        if (!a || !a.href || a.href.startsWith('javascript')) return;
        var href = a.getAttribute('href') || a.href;
        track('click:' + href, a.textContent.trim().slice(0, 80), location.pathname);
    }, true);
})();
</script>
</body>
</html>

@code {
    // Was a manually-incremented "?v=8" that never got bumped across
    // deploys, exactly why a CSS fix (poll-hero-img sizing, 2026-08-24)
    // silently kept serving the stale cached version behind Cloudflare's
    // edge cache (max-age=14400) even after a fresh deploy. Same
    // per-process-start cache-buster pattern already used by PDF-tool/
    // DailyBrief - auto-bumps every deploy since it's a fresh process.
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
