@page "/datepoll/{DatePollId:int}"
@inject DatePolls DatePolls
@inject IJSRuntime  JS
@inject NavigationManager Nav
@inject DatePollBroadcastService Broadcast
@implements IAsyncDisposable

<PageTitle>@(_poll?.Title ?? "Datoafstemning")</PageTitle>

<div class="poll-root">
    <header class="poll-header">
        <a href="/" class="poll-back">← Tilbage</a>
    </header>

    @if (_poll is null)
    {
        <div class="poll-empty"><p>Afstemningen findes ikke.</p></div>
    }
    else
    {
        <div class="poll-view">
            <PageHelp>
                <p>En afstemning om, hvilken dato der passer bedst. Under hver dato står, hvor mange der har svaret Ja, Måske og Nej.</p>
                <p><b>Sådan gør du:</b> skriv dit navn og tryk <b>Fortsæt</b>. Tryk så <b>Ja</b>, <b>Måske</b> eller <b>Nej</b> ved
                   hver dato – dit svar får et ✓. Tryk <b>☆ Foretræk</b> ved den ene dato, du helst vil have. Alt gemmes med det
                   samme; der er ingen send-knap. Nederst kan du tilbyde at være vært og skrive i chatten.</p>
            </PageHelp>

            @if (!string.IsNullOrEmpty(_poll.ImageName))
            {
                <img class="poll-hero-img" src="/poll-images/@_poll.ImageName" alt="" />
            }

            <div class="poll-content">
                <h1 class="poll-title">@_poll.Title</h1>

                @if (!string.IsNullOrEmpty(_poll.Description))
                {
                    <PollText Text="@_poll.Description" />
                }

                @if (_poll.Deadline.HasValue)
                {
                    <div class="poll-deadline-banner @(_poll.HasDeadlinePassed ? "expired" : "")">
                        @(_poll.HasDeadlinePassed
                            ? "Denne afstemning er lukket"
                            : "Åben til " + _poll.Deadline.Value.ToString("d. MMMM yyyy"))
                    </div>
                }
            </div>

            @if (_locked)
            {
                <div class="admin-form" style="padding:0 16px">
                    <label class="form-label">Adgangskode</label>
                    <input class="poll-input" type="password" placeholder="Indtast adgangskode"
                           @bind="_passwordInput" @bind:event="oninput" @onkeydown="OnPasswordKey" />
                    @if (!string.IsNullOrEmpty(_passwordError))
                    {
                        <div class="form-error">@_passwordError</div>
                    }
                    <button class="poll-submit-btn" @onclick="CheckPassword" disabled="@string.IsNullOrWhiteSpace(_passwordInput)">Fortsæt</button>
                </div>
            }
            else if (!_hasName)
            {
                <div class="pkg-identity">
                    <div class="poll-vote-label">Hvem svarer?</div>
                    <input class="poll-input" style="width:100%" placeholder="Dit navn, fx Mikkel" maxlength="120"
                           @bind="_voterNamesInput" @bind:event="oninput" @onkeydown="OnNameKey" />
                    <div class="pkg-identity-hint">Svarer du også for andre? Skriv navnene med komma imellem, fx <b>Far, Eigil, Bertil</b>.</div>
                    <button class="poll-submit-btn" style="width:100%" @onclick="SaveName" disabled="@string.IsNullOrWhiteSpace(_voterNamesInput)">Fortsæt →</button>
                </div>
            }
            else
            {
                <div class="pkg-identity dp-me">
                    <span>Svarer som <strong>@string.Join(", ", _voterNames)</strong></span>
                    <button class="k-btn k-btn-sm" @onclick="ChangeName">Skift navn</button>
                    <button class="k-btn k-btn-sm" style="margin-left:auto" @onclick='() => JS.InvokeVoidAsync("scrollToId", "chat")'>↓ Til chatten</button>
                </div>

                <div>
                    @{
                        int? lastMonthKey = null;
                        var dateIndex = 0;
                        var nextImageIdx = 0;
                        // Evenly spaced, not clustered at the top - one photo
                        // roughly every (dates / (images+1)) rows.
                        var imageEveryNDates = _poll.Images.Count > 0
                            ? Math.Max(1, (int)Math.Ceiling((double)_poll.Dates.Count / (_poll.Images.Count + 1)))
                            : 0;
                    }
                    @foreach (var d in _poll.Dates.OrderBy(x => x.Date))
                    {
                        var dateId = d.Id;
                        var mine = _myResponses.GetValueOrDefault(dateId);
                        var monthKey = d.Date.Year * 12 + d.Date.Month;
                        if (monthKey != lastMonthKey)
                        {
                            lastMonthKey = monthKey;
                            <div class="month-header">@d.Date.ToString("MMMM yyyy")</div>
                        }
                        var closed = _poll.HasDeadlinePassed;
                        <div class="poll-results">
                            <div class="dp-date">@d.Date.ToString("dddd d. MMMM")</div>

                            @* The one Kolibri colour for the chosen answer, said in words too (✓) - no red/green (user is a bit colour-blind). *@
                            <div class="dp-answers" role="group" aria-label="@($"Kan du {d.Date:dddd d. MMMM}?")">
                                @foreach (var (status, label) in Answers)
                                {
                                    var s = status;
                                    var on = mine?.Status == s;
                                    <button class="dp-choice @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" disabled="@closed"
                                            @onclick="() => RespondAsync(dateId, s)">@(on ? "✓ " : "")@label</button>
                                }
                            </div>
                            <button class="dp-choice dp-star @(mine?.IsPreferred == true ? "on" : "")" disabled="@closed"
                                    aria-pressed="@(mine?.IsPreferred == true ? "true" : "false")"
                                    title="Den dato du helst vil have, hvis du kun kunne vælge én"
                                    @onclick="() => TogglePreferredAsync(dateId)">
                                @(mine?.IsPreferred == true ? "★ Din foretrukne dato" : "☆ Foretræk denne dato")
                            </button>

                            @if (mine is not null && !closed)
                            {
                                <input class="poll-input" style="width:100%;margin-bottom:var(--k-space-2)" placeholder="Kommentar (valgfrit)"
                                       value="@mine.Comment" maxlength="200"
                                       @onchange="e => SaveCommentAsync(dateId, e.Value?.ToString() ?? string.Empty)" />
                            }

                            @{ var counts = d.Responses.GroupBy(r => r.Status).ToDictionary(g => g.Key, g => g.Count()); }
                            @{ var preferredCount = d.Responses.Count(r => r.IsPreferred); }
                            <div class="dp-counts">
                                <span>Ja: @counts.GetValueOrDefault("Yes")</span>
                                <span>Måske: @counts.GetValueOrDefault("Maybe")</span>
                                <span>Nej: @counts.GetValueOrDefault("No")</span>
                                @if (preferredCount > 0)
                                {
                                    <span>★ @preferredCount foretrækker</span>
                                }
                            </div>
                        </div>

                        dateIndex++;
                        if (imageEveryNDates > 0 && dateIndex % imageEveryNDates == 0 && nextImageIdx < _poll.Images.Count)
                        {
                            <img class="poll-spread-img" src="/poll-images/@_poll.Images[nextImageIdx].FileName" alt="" />
                            nextImageIdx++;
                        }
                    }

                    @if (_poll.ChatOpen)
                    {
                        <div class="poll-results">
                            <div class="dp-date" style="text-transform:none">Mangler der en dato?</div>
                            <div class="dp-row">
                                <input type="date" class="poll-input" value="@_suggestedDate" aria-label="Dato du vil foreslå"
                                       @onchange="e => _suggestedDate = e.Value?.ToString() ?? string.Empty" />
                                <button class="k-btn k-btn-primary" @onclick="SuggestDateAsync" disabled="@string.IsNullOrEmpty(_suggestedDate)">+ Foreslå dato</button>
                            </div>
                            @if (!string.IsNullOrEmpty(_suggestError))
                            {
                                <div class="form-error">@_suggestError</div>
                            }
                        </div>
                    }
                </div>

                <div class="poll-results" id="vaert">
                    <div class="dp-date" style="text-transform:none">Hvem vil gerne være vært?</div>
                    @if (_hosts.Count == 0) { <p class="muted" style="margin:0 0 8px">Ingen har tilbudt endnu.</p> }
                    else
                    {
                        <ul style="margin:0 0 10px;padding-left:18px">
                            @foreach (var h in _hosts) { <li><b>@h.VoterName</b>@(h.Place.Length > 0 ? $" – {h.Place}" : "")</li> }
                        </ul>
                    }
                    @if (_hasName && _poll.ChatOpen)
                    {
                        <label style="display:flex;gap:8px;align-items:center;font-weight:700">
                            <input type="checkbox" checked="@_iHost" @onchange="e => _iHost = e.Value is true" /> Jeg vil gerne være vært
                        </label>
                        @if (_iHost)
                        {
                            <input class="poll-input" style="margin-top:6px" maxlength="120" @bind="_hostPlace" placeholder="Hvor? Fx: hos mig i Aarhus – plads til alle" />
                        }
                        <div class="dp-me" style="margin-top:var(--k-space-2)">
                            <button class="k-btn k-btn-primary" @onclick="SaveHostAsync">Gem</button>
                            @if (_hostNote.Length > 0) { <span class="muted">@_hostNote</span> }
                        </div>
                    }
                </div>

                <div class="poll-results" id="chat">
                    <DatePollChatWidget DatePollId="DatePollId" ChatOpen="_poll.ChatOpen" VoterName="@(_voterNames.FirstOrDefault() ?? string.Empty)" />
                </div>
            }

        </div>
    }
</div>

@code {
    [Parameter] public int DatePollId { get; set; }

    private static readonly (string Status, string Label)[] Answers = [("Yes", "Ja"), ("Maybe", "Måske"), ("No", "Nej")];

    private void ChangeName() { _hasName = false; _myResponses = []; }

    private DatePoll? _poll;
    private bool _hasName;
    private bool _locked;
    private string _passwordInput = "";
    private string _passwordError = "";

    // Raw textbox content (what's persisted to localStorage), and the parsed
    // list every response actually gets written against - lets one person
    // (a parent, say) submit the same Yes/Maybe/No + comment for everyone
    // they're voting on behalf of in a single click, rather than needing to
    // switch "voter" and re-click for each family member. The active-button
    // highlight and comment box reflect the FIRST name's existing response
    // as representative - not meant for a household that actually disagrees
    // with itself date-by-date, just for "count me and my kids the same way".
    private string _voterNamesInput = "";
    private List<string> _voterNames = [];
    private Dictionary<int, DatePollResponse> _myResponses = [];
    private string _suggestedDate = "";
    private string _suggestError = "";
    private bool _subscribed;

    protected override async Task OnInitializedAsync() { await LoadPollAsync(); LoadHosts(); }

    // ── "Jeg vil gerne være vært" ──
    private List<DatePollHost> _hosts = [];
    private bool _iHost;
    private string _hostPlace = "", _hostNote = "";

    private void LoadHosts()
    {
        _hosts = _poll?.Hosts.OrderBy(h => h.OfferedAt).ToList() ?? [];
        var me = _voterNames.FirstOrDefault();
        if (me is not null && _hosts.FirstOrDefault(h => h.VoterName == me) is { } mine) { _iHost = true; _hostPlace = mine.Place; }
    }

    private async Task SaveHostAsync()
    {
        var me = _voterNames.FirstOrDefault();
        if (me is null) return;
        await DatePolls.SetHostAsync(DatePollId, me, _iHost, _hostPlace);   // the change signal refreshes the open pages
        _hostNote = _iHost ? "Tak – du står som mulig vært ✓" : "Fjernet";
        await LoadPollAsync();
        LoadHosts();
    }

    private async Task LoadPollAsync() => _poll = await DatePolls.GetAsync(DatePollId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _poll is null) return;

        if (!string.IsNullOrEmpty(_poll.Password))
        {
            var unlocked = await JS.InvokeAsync<string?>("localStorage.getItem", $"datepoll_unlocked_{DatePollId}");
            _locked = unlocked != "true";
        }

        if (!_locked)
        {
            _voterNamesInput = await JS.InvokeAsync<string?>("localStorage.getItem", "voter_name") ?? "";
            ParseVoterNames();
            _hasName = _voterNames.Count > 0;
            if (_hasName) LoadMyResponses();
            LoadHosts();
        }

        Broadcast.Subscribe(DatePollId, OnBroadcast);
        _subscribed = true;

        StateHasChanged();
    }

    private async Task OnPasswordKey(KeyboardEventArgs e) { if (e.Key == "Enter") await CheckPassword(); }

    private async Task CheckPassword()
    {
        _passwordError = "";
        if (_poll is null) return;

        if (string.Equals(_passwordInput.Trim(), _poll.Password, StringComparison.Ordinal))
        {
            await JS.InvokeVoidAsync("localStorage.setItem", $"datepoll_unlocked_{DatePollId}", "true");
            _locked = false;
            _passwordInput = "";

            _voterNamesInput = await JS.InvokeAsync<string?>("localStorage.getItem", "voter_name") ?? "";
            ParseVoterNames();
            _hasName = _voterNames.Count > 0;
            if (_hasName) LoadMyResponses();
        }
        else
        {
            _passwordError = "Forkert adgangskode";
        }
    }

    private void OnBroadcast() => InvokeAsync(async () =>
    {
        await LoadPollAsync();
        LoadHosts();
        if (_hasName) LoadMyResponses();
        StateHasChanged();
    });

    public ValueTask DisposeAsync()
    {
        if (_subscribed) Broadcast.Unsubscribe(DatePollId, OnBroadcast);
        return ValueTask.CompletedTask;
    }

    private void ParseVoterNames()
    {
        _voterNames = DatePollRules.ParseNames(_voterNamesInput);
    }

    private void LoadMyResponses()
    {
        // Representative view only - if the names' existing responses ever
        // disagree (e.g. someone was previously entered on their own), the
        // first name's answer is what the buttons/comment box show, but a
        // click still applies to every name in the list.
        var primary = _voterNames.FirstOrDefault() ?? "";
        _myResponses = _poll!.Dates
            .SelectMany(d => d.Responses.Where(r => r.VoterName == primary))
            .ToDictionary(r => r.DateId, r => r);
    }

    private async Task OnNameKey(KeyboardEventArgs e) { if (e.Key == "Enter") await SaveName(); }

    private async Task SaveName()
    {
        ParseVoterNames();
        if (_voterNames.Count == 0) return;
        await JS.InvokeVoidAsync("localStorage.setItem", "voter_name", _voterNamesInput.Trim());
        _hasName = true;
        LoadMyResponses();
    }

    // The rules (several names at once, one preferred date, comments only on existing answers, no duplicate dates)
    // live in ITMartinPoll.Domain.DatePollRules; DatePolls tells the open pages to refresh.
    private async Task RespondAsync(int dateId, string status)
    {
        if (_poll is null || _poll.HasDeadlinePassed || _voterNames.Count == 0) return;
        await DatePolls.RespondAsync(DatePollId, dateId, _voterNames, status);
        await AfterChangeAsync();
    }

    private async Task TogglePreferredAsync(int dateId)
    {
        if (_poll is null || _poll.HasDeadlinePassed || _voterNames.Count == 0) return;
        await DatePolls.TogglePreferredAsync(DatePollId, dateId, _voterNames);
        await AfterChangeAsync();
    }

    private async Task SaveCommentAsync(int dateId, string comment)
    {
        if (_poll is null || _poll.HasDeadlinePassed || _voterNames.Count == 0) return;
        await DatePolls.SaveCommentAsync(DatePollId, dateId, _voterNames, comment);
        await AfterChangeAsync();
    }

    private async Task SuggestDateAsync()
    {
        _suggestError = "";
        if (_poll is null || _poll.HasDeadlinePassed) return;
        if (!DateTime.TryParse(_suggestedDate, out var date)) { _suggestError = "Ugyldig dato"; return; }
        _suggestError = await DatePolls.SuggestDateAsync(DatePollId, date) ?? "";
        if (_suggestError != "") return;
        _suggestedDate = "";
        await AfterChangeAsync();
    }

    private async Task AfterChangeAsync()
    {
        await LoadPollAsync();
        LoadMyResponses();
        StateHasChanged();
    }
}
