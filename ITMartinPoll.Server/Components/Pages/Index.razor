@page "/"
@rendermode InteractiveServer
@inject Catalog Catalog
@inject AdminSession Session

<PageTitle>Stem</PageTitle>

<div class="poll-root">
    <KolibriHeader />

    @* Problem/formål- og "sådan bruger du appen"-bannerne er fjernet (bruger,
       2026-09-10). De solgte appen til en førstegangsbesøgende, men forsiden
       bruges nu til konkrete forespørgsler til folk der allerede har fået et
       link - så pitchen stod bare i vejen for det de kom efter. *@

    @if (!_polls.Any() && !_sessions.Any() && !_datePolls.Any() && !_packages.Any() && !_helpEvents.Any())
    {
        <div class="poll-empty">
            @if (Session.IsAdmin) { <p>Ingen aktive meningsmålinger lige nu</p> }
            else
            {
                <p><b>Afstemningerne her er private.</b></p>
                <p>Har du fået et link til en afstemning, så åbn det direkte – så kommer du lige derhen.</p>
                <p>Vil du selv spørge familien, foreningen eller vennerne? Det er gratis for kunder.</p>
                <a class="k-btn k-btn-primary" href="/lav">Lav din egen afstemning</a>
            }
        </div>
    }
    else
    {
        @* Hvorfor og hvad-skal-jeg-gøre står HER, på forsiden, i fuld længde -
           ikke gemt bag et klik. Den der lander her skal kunne se hvad det
           handler om og hvad der forventes, før han beslutter sig for at gå
           i gang. Derfor et helt afsnit frem for et listepunkt. *@
        @if (_packages.Count > 0) { <p class="muted" style="text-align:center">Kun admin ser forespørgslerne herunder.</p> }
        @foreach (var pkg in _packages)
        {
            var steps = (pkg.Instructions ?? "")
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            <div class="pkg-front">
                @if (!string.IsNullOrWhiteSpace(pkg.Audience))
                {
                    <div class="pkg-audience">@pkg.Audience</div>
                }
                <div class="pkg-front-badge">FORESPØRGSEL · @(pkg.Polls.Count + pkg.Sessions.Count) dele</div>
                <h1 class="pkg-front-title">@pkg.Title</h1>

                @if (!string.IsNullOrWhiteSpace(pkg.Intro))
                {
                    <p class="pkg-front-intro">@pkg.Intro</p>
                }

                @if (steps.Length > 0)
                {
                    <div class="pkg-front-howto">
                        <div class="pkg-front-howto-label">Sådan gør du</div>
                        <ol class="pkg-front-steps">
                            @foreach (var step in steps)
                            {
                                <li>@step</li>
                            }
                        </ol>
                    </div>
                }

                <a class="poll-submit-btn pkg-front-cta" href="/pakke/@pkg.Id">Svar på forespørgslen →</a>
                <a class="pkg-pdf-link" href="/pakke/@pkg.Id/pdf" target="_blank">Hent skemaet som PDF til print</a>
            </div>
        }

        @if (_sessions.Any())
        {
        <div class="vote-section-label">Billedserier — bedøm billeder</div>
        <div class="poll-list">

            @foreach (var s in _sessions)
            {
                <a class="poll-card" href="/session/@s.Id">
                    @if (!string.IsNullOrEmpty(s.CoverImageName))
                    {
                        <img class="poll-card-img session-cover-img"
                             src="/poll-images/@s.CoverImageName" alt="" />
                    }
                    <div class="poll-card-body">
                        <span class="session-badge">BILLEDSERIE · @s.Images.Count billeder</span>
                        <div class="poll-card-title">@s.Title</div>
                        @if (!string.IsNullOrEmpty(s.Description))
                        {
                            <div class="poll-card-desc">@s.Description</div>
                        }
                        <div class="poll-card-meta">
                            <span>Tryk for at bedømme</span>
                        </div>
                    </div>
                </a>
            }
        </div>
        }

        @if (_helpEvents.Any())
        {
        <div class="vote-section-label">Giv en hånd — skriv dig på</div>
        <div class="poll-list">
            @foreach (var h in _helpEvents)
            {
                <a class="poll-card" href="/tilmeld/@h.Id">
                    @if (!string.IsNullOrEmpty(h.ImageName))
                    {
                        <img class="poll-card-img" src="/poll-images/@h.ImageName" alt="" />
                    }
                    <div class="poll-card-body">
                        <div class="poll-card-title">@h.Title</div>
                        <div class="poll-card-desc">@h.Body.Split("\n\n")[0]</div>
                    </div>
                </a>
            }
        </div>
        }

        @if (_datePolls.Any())
        {
        <div class="vote-section-label">Datoafstemninger — hvilke dage passer?</div>
        <div class="poll-list">
            @foreach (var dp in _datePolls)
            {
                <a class="poll-card" href="/datepoll/@dp.Id">
                    @if (!string.IsNullOrEmpty(dp.ImageName))
                    {
                        <img class="poll-card-img" src="/poll-images/@dp.ImageName" alt="" />
                    }
                    <div class="poll-card-body">
                        <div class="poll-card-title">@dp.Title</div>
                        @if (!string.IsNullOrEmpty(dp.Description))
                        {
                            <div class="poll-card-desc">@dp.Description</div>
                        }
                        <div class="poll-card-meta">
                            <span>@dp.Dates.Count datoer</span>
                            @if (dp.Deadline.HasValue)
                            {
                                <span class="poll-deadline @(dp.HasDeadlinePassed ? "expired" : "")">
                                    @(dp.HasDeadlinePassed ? "Lukket" : "Frist: " + dp.Deadline.Value.ToString("d. MMM"))
                                </span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
        }

        @if (_polls.Any())
        {
        <div class="vote-section-label">Meningsmålinger — svar på et spørgsmål</div>
        <div class="poll-list">
            @foreach (var p in _polls)
            {
                <a class="poll-card" href="/poll/@p.Id">
                    @if (!string.IsNullOrEmpty(p.ImageName))
                    {
                        <img class="poll-card-img" src="/poll-images/@p.ImageName" alt="" />
                    }
                    <div class="poll-card-body">
                        <div class="poll-card-title">@p.Title</div>
                        @if (!string.IsNullOrEmpty(p.Body))
                        {
                            <div class="poll-card-desc">@p.Body</div>
                        }
                        <div class="poll-card-meta">
                            <span>@p.Votes.Count stemmer</span>
                            @if (p.Deadline.HasValue)
                            {
                                <span class="poll-deadline @(p.HasDeadlinePassed ? "expired" : "")">
                                    @(p.HasDeadlinePassed ? "Lukket" : "Frist: " + p.Deadline.Value.ToString("d. MMM"))
                                </span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
        }
    }
</div>

@code {
    private List<Poll>         _polls    = [];
    private List<ImageSession> _sessions = [];
    private List<DatePoll>     _datePolls = [];
    private List<HelpEvent>    _helpEvents = [];
    private List<Package>      _packages = [];

    // Nothing is listed for guests (user 2026-10-10) - rules in Application.Catalog.
    protected override async Task OnInitializedAsync()
    {
        var f = await Catalog.FrontPageAsync(Session.IsAdmin);
        (_packages, _polls, _sessions, _helpEvents, _datePolls) = (f.Packages, f.Polls, f.Sessions, f.Help, f.DatePolls);
    }
}
