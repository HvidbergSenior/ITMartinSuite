@page "/"
@rendermode InteractiveServer
@inject PollDb Db

<PageTitle>Stem</PageTitle>

<div class="poll-root">
    <header class="poll-header">
        <span class="poll-logo">Stem</span>
    </header>

    @* Problem/formål- og "sådan bruger du appen"-bannerne er fjernet (bruger,
       2026-09-10). De solgte appen til en førstegangsbesøgende, men forsiden
       bruges nu til konkrete forespørgsler til folk der allerede har fået et
       link - så pitchen stod bare i vejen for det de kom efter. *@

    @if (!_polls.Any() && !_sessions.Any() && !_datePolls.Any() && !_packages.Any())
    {
        <div class="poll-empty">
            <p>Ingen aktive meningsmålinger lige nu</p>
        </div>
    }
    else
    {
        @if (_packages.Any())
        {
        <div class="vote-section-label">📦 Forespørgsler — flere spørgsmål samlet</div>
        <div class="poll-list">
            @foreach (var pkg in _packages)
            {
                <a class="poll-card" href="/pakke/@pkg.Id">
                    <div class="poll-card-body">
                        <span class="session-badge">
                            FORESPØRGSEL · @(pkg.Polls.Count + pkg.Sessions.Count) dele
                        </span>
                        <div class="poll-card-title">@pkg.Title</div>
                        @if (!string.IsNullOrEmpty(pkg.Intro))
                        {
                            <div class="poll-card-desc">@pkg.Intro</div>
                        }
                        <div class="poll-card-meta"><span>Tryk for at svare</span></div>
                    </div>
                </a>
            }
        </div>
        }

        @if (_sessions.Any())
        {
        <div class="vote-section-label">🖼️ Billedserier — bedøm billeder</div>
        <div class="poll-list">

            @foreach (var s in _sessions)
            {
                <a class="poll-card" href="/session/@s.Id">
                    @if (!string.IsNullOrEmpty(s.CoverImageName))
                    {
                        <img class="poll-card-img session-cover-img"
                             src="/poll-images/@s.CoverImageName" alt="" />
                    }
                    <div class="poll-card-body">
                        <span class="session-badge">BILLEDSERIE · @s.Images.Count billeder</span>
                        <div class="poll-card-title">@s.Title</div>
                        @if (!string.IsNullOrEmpty(s.Description))
                        {
                            <div class="poll-card-desc">@s.Description</div>
                        }
                        <div class="poll-card-meta">
                            <span>Tryk for at bedømme</span>
                        </div>
                    </div>
                </a>
            }
        </div>
        }

        @if (_datePolls.Any())
        {
        <div class="vote-section-label">📅 Datoafstemninger — hvilke dage passer?</div>
        <div class="poll-list">
            @foreach (var dp in _datePolls)
            {
                <a class="poll-card" href="/datepoll/@dp.Id">
                    @if (!string.IsNullOrEmpty(dp.ImageName))
                    {
                        <img class="poll-card-img" src="/poll-images/@dp.ImageName" alt="" />
                    }
                    <div class="poll-card-body">
                        <div class="poll-card-title">@dp.Title</div>
                        @if (!string.IsNullOrEmpty(dp.Description))
                        {
                            <div class="poll-card-desc">@dp.Description</div>
                        }
                        <div class="poll-card-meta">
                            <span>@dp.Dates.Count datoer</span>
                            @if (dp.Deadline.HasValue)
                            {
                                <span class="poll-deadline @(dp.HasDeadlinePassed ? "expired" : "")">
                                    @(dp.HasDeadlinePassed ? "Lukket" : "Frist: " + dp.Deadline.Value.ToString("d. MMM"))
                                </span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
        }

        @if (_polls.Any())
        {
        <div class="vote-section-label">📊 Meningsmålinger — svar på et spørgsmål</div>
        <div class="poll-list">
            @foreach (var p in _polls)
            {
                <a class="poll-card" href="/poll/@p.Id">
                    @if (!string.IsNullOrEmpty(p.ImageName))
                    {
                        <img class="poll-card-img" src="/poll-images/@p.ImageName" alt="" />
                    }
                    <div class="poll-card-body">
                        <div class="poll-card-title">@p.Title</div>
                        @if (!string.IsNullOrEmpty(p.Body))
                        {
                            <div class="poll-card-desc">@p.Body</div>
                        }
                        <div class="poll-card-meta">
                            <span>@p.Votes.Count stemmer</span>
                            @if (p.Deadline.HasValue)
                            {
                                <span class="poll-deadline @(p.HasDeadlinePassed ? "expired" : "")">
                                    @(p.HasDeadlinePassed ? "Lukket" : "Frist: " + p.Deadline.Value.ToString("d. MMM"))
                                </span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
        }
    }
</div>

@code {
    private List<Poll>         _polls    = [];
    private List<ImageSession> _sessions = [];
    private List<DatePoll>     _datePolls = [];
    private List<Package>      _packages = [];

    protected override void OnInitialized()
    {
        _packages = Db.Packages
            .Where(p => p.IsActive)
            .OrderByDescending(p => p.CreatedAt)
            .Select(p => new Package
            {
                Id       = p.Id,
                Title    = p.Title,
                Intro    = p.Intro,
                Polls    = p.Polls.Where(x => x.IsActive).ToList(),
                Sessions = p.Sessions.Where(x => x.IsActive).ToList(),
            })
            .ToList();

        // Items belonging to a package are reached through the package, not
        // on their own - listing them both places invites someone to answer
        // one question in isolation and never see the rest.
        _polls = Db.Polls
            .Where(p => p.IsActive && p.PackageId == null)
            .OrderByDescending(p => p.CreatedAt)
            .Select(p => new Poll
            {
                Id        = p.Id,
                Title     = p.Title,
                Body      = p.Body,
                ImageName = p.ImageName,
                Deadline  = p.Deadline,
                Votes     = p.Votes.ToList(),
            })
            .ToList();

        _sessions = Db.Sessions
            .Where(s => s.IsActive && s.PackageId == null)
            .OrderByDescending(s => s.CreatedAt)
            .Select(s => new ImageSession
            {
                Id             = s.Id,
                Title          = s.Title,
                Description    = s.Description,
                CoverImageName = s.CoverImageName,
                Images         = s.Images.ToList(),
            })
            .ToList();

        _datePolls = Db.DatePolls
            .Where(dp => dp.IsActive)
            .OrderByDescending(dp => dp.CreatedAt)
            .Select(dp => new DatePoll
            {
                Id          = dp.Id,
                Title       = dp.Title,
                Description = dp.Description,
                ImageName   = dp.ImageName,
                Deadline    = dp.Deadline,
                Dates       = dp.Dates.ToList(),
            })
            .ToList();
    }
}
