@page "/afmeld/{Token}"
@inject CustomerList Customers

@* One-click unsubscribe (the link in mails sent before 2026-10-21). The list is in Kunder now; the link is passed on there. *@
<PageTitle>Afmeld mails</PageTitle>

<div class="poll-root">
    <div class="poll-view">
        <div class="poll-content">
            @if (_found)
            {
                <h1 class="poll-title">Du er afmeldt</h1>
                <p class="poll-body">Vi sender ikke flere mails@(_email == "" ? "" : " til " + _email).
                    Vil du have dine oplysninger slettet helt, så skriv til ITMartin@Mensa.dk.</p>
            }
            else
            {
                <h1 class="poll-title">Linket virker ikke</h1>
                <p class="poll-body">Skriv til ITMartin@Mensa.dk, så afmelder vi dig med det samme.</p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = "";
    private bool _found;
    private string _email = "";

    protected override async Task OnInitializedAsync() => (_found, _email) = await Customers.UnsubscribeByLinkAsync(Token);
}
