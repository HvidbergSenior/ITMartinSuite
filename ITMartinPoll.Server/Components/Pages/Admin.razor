@page "/admin"
@rendermode InteractiveServer
@inject Catalog Catalog
@inject IConfiguration Config
@inject AdminSession   Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Admin — Stem</PageTitle>

<div class="poll-root">
    <header class="poll-header">
        <span class="poll-logo">Admin</span>
        @if (Session.IsAdmin) { <a href="/" class="poll-back">← Forsiden</a> }
    </header>

    @if (!Session.IsAdmin)
    {
        <div class="admin-pin-wrap">
            <div class="admin-pin-card">
                <h2>Admin adgang</h2>
                <input class="poll-input" type="password" placeholder="PIN"
                       @bind="_pin" @bind:event="oninput"
                       @onkeydown="OnPinKey" />
                @if (_pinWrong) { <div class="admin-pin-error">Forkert PIN</div> }
                <button class="poll-submit-btn" @onclick="CheckPin">Log ind</button>
            </div>
        </div>
    }
    else
    {
        <div class="admin-body">

            <a href="/admin/kunder" class="admin-create-btn" style="margin-bottom:20px">Kundekartotek</a>

            <div class="admin-section-label">BILLEDSERIER</div>
            <a href="/admin/session/create" class="admin-create-btn">+ Ny billedserie</a>

            @if (!_sessions.Any())
            {
                <div class="poll-empty" style="padding:24px 0"><p>Ingen billedserier endnu</p></div>
            }
            @foreach (var s in _sessions)
            {
                <div class="admin-poll-row">
                    <div class="admin-poll-info">
                        <span class="@(s.IsActive ? "admin-active" : "admin-inactive")">
                            @(s.IsActive ? "● Aktiv" : "○ Inaktiv")
                        </span>
                        <span class="admin-poll-title">@s.Title</span>
                        <span class="admin-poll-votes">@s.Images.Count billeder</span>
                    </div>
                    @if (!string.IsNullOrEmpty(s.Question))
                    {
                        <div class="admin-poll-question">@s.Question</div>
                    }
                    <div class="admin-poll-actions">
                        <a href="/admin/session/edit/@s.Id" class="admin-btn">Resultater / Rediger</a>
                        <button class="admin-btn" @onclick="() => ToggleSession(s)">
                            @(s.IsActive ? "Deaktiver" : "Aktivér")
                        </button>
                        <button class="admin-btn danger" @onclick="() => DeleteSession(s)">Slet</button>
                    </div>
                </div>
            }

            <div class="admin-section-label">DATOAFSTEMNINGER</div>
            <a href="/admin/datepoll/create" class="admin-create-btn">+ Ny datoafstemning</a>

            @if (!_datePolls.Any())
            {
                <div class="poll-empty" style="padding:24px 0"><p>Ingen datoafstemninger endnu</p></div>
            }
            @foreach (var dp in _datePolls)
            {
                <div class="admin-poll-row">
                    <div class="admin-poll-info">
                        <span class="@(dp.IsActive ? "admin-active" : "admin-inactive")">
                            @(dp.IsActive ? "● Aktiv" : "○ Inaktiv")
                        </span>
                        <span class="admin-poll-title">@dp.Title</span>
                        <span class="admin-poll-votes">@dp.Dates.Count datoer</span>
                    </div>
                    <div class="admin-poll-actions">
                        <a href="/admin/datepoll/edit/@dp.Id" class="admin-btn">Rediger</a>
                        <button class="admin-btn" @onclick="() => ToggleDatePoll(dp)">
                            @(dp.IsActive ? "Deaktiver" : "Aktivér")
                        </button>
                        <button class="admin-btn danger" @onclick="() => DeleteDatePoll(dp)">Slet</button>
                    </div>
                </div>
            }

            <div class="admin-section-label" style="margin-top:24px">MENINGSMÅLINGER</div>
            <a href="/admin/create" class="admin-create-btn">+ Ny meningsmåling</a>

            @if (!_polls.Any())
            {
                <div class="poll-empty" style="padding:24px 0"><p>Ingen meningsmålinger endnu</p></div>
            }
            @foreach (var p in _polls)
            {
                <div class="admin-poll-row">
                    <div class="admin-poll-info">
                        <span class="@(p.IsActive ? "admin-active" : "admin-inactive")">
                            @(p.IsActive ? "● Aktiv" : "○ Inaktiv")
                        </span>
                        <span class="admin-poll-title">@p.Title</span>
                        <span class="admin-poll-votes">@p.Votes.Count stemmer</span>
                    </div>
                    <div class="admin-poll-actions">
                        <a href="/admin/edit/@p.Id" class="admin-btn">Rediger</a>
                        <button class="admin-btn" @onclick="() => ToggleActive(p)">
                            @(p.IsActive ? "Deaktiver" : "Aktivér")
                        </button>
                        <button class="admin-btn danger" @onclick="() => DeletePoll(p)">Slet</button>
                    </div>
                </div>
            }

        </div>
    }
</div>

@code {
    private string             _pin      = "";
    private bool               _pinWrong = false;
    private List<Poll>         _polls    = [];
    private List<ImageSession> _sessions = [];
    private List<DatePoll>     _datePolls = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var o = await Catalog.OverviewAsync();
        (_polls, _sessions, _datePolls) = (o.Polls, o.Sessions, o.DatePolls);
    }

    private async Task CheckPin()
    {
        var correct = Config["Poll:AdminPin"] ?? "1234";
        if (_pin == correct)
        {
            Session.IsAdmin = true; _pinWrong = false;
            await JS.InvokeVoidAsync("eval", $"document.cookie='poll_admin={AdminToken.For(correct)}; path=/; max-age=31536000; samesite=lax' + (location.protocol === 'https:' ? '; secure' : '')");
        }
        else _pinWrong = true;
    }

    private async Task OnPinKey(KeyboardEventArgs e) { if (e.Key == "Enter") await CheckPin(); }

    private async Task ToggleActive(Poll p) { await Catalog.ToggleAsync(p); await LoadAsync(); }
    private async Task DeletePoll(Poll p) { await Catalog.DeleteAsync(p); await LoadAsync(); }
    private async Task ToggleDatePoll(DatePoll dp) { await Catalog.ToggleAsync(dp); await LoadAsync(); }
    private async Task DeleteDatePoll(DatePoll dp) { await Catalog.DeleteAsync(dp); await LoadAsync(); }
    private async Task ToggleSession(ImageSession s) { await Catalog.ToggleAsync(s); await LoadAsync(); }
    private async Task DeleteSession(ImageSession s) { await Catalog.DeleteAsync(s); await LoadAsync(); }
}
