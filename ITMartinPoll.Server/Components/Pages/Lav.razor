@page "/lav"
@inject CustomerPolls Mine
@inject CustomerSession Customer
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

@* "Lav din egen afstemning" (user 2026-10-21): free for customers - the kundenummer from the sign-up on itmartin.dk opens it.
   The number is remembered on this phone. Every box says what it is and how to use it. *@
<PageTitle>Lav din egen afstemning – Stem</PageTitle>

<div class="lav">
    <PageHelp>
        <p>Her laver du din egen afstemning og ser, hvad folk har stemt.</p>
        <p><b>Sådan gør du:</b> skriv dit kundenummer, skriv spørgsmålet og mindst 2 svar, og tryk Lav afstemningen. Send linket til dem, der skal stemme.</p>
        <p>Vi spørger ikke efter e-mails på din afstemning – kun et navn, hvis folk selv vil skrive det.</p>
    </PageHelp>

    @if (!Customer.Ready)
    {
        @* The phone may remember the kundenummer - read in a moment. Only the heading until then, so the number box does
           not flash before the form (user 2026-10-21: "when i push lav din egen afstemning something happens"). *@
        <section class="k-card">
            <h1 class="k-card-title">Lav din egen afstemning</h1>
            <p>Et øjeblik …</p>
        </section>
    }
    else if (!Customer.LoggedIn)
    {
        <section class="k-card">
            <h1 class="k-card-title">Lav din egen afstemning</h1>
            <p>Spørg familien, foreningen eller vennerne – og se hvad de vælger. Gratis for kunder.</p>
            <label class="lav-label">Dit kundenummer (8 cifre – står i mailen, du fik)</label>
            <input class="k-input lav-big" inputmode="numeric" autocomplete="off" @bind="_code" placeholder="fx 4821 7730" />
            @if (_error != "") { <p class="lav-warn">@_error</p> }
            <button class="k-btn k-btn-primary k-btn-block k-mt" disabled="@_busy" @onclick="LoginAsync">Fortsæt</button>
            <p class="k-mt">Har du ikke et kundenummer? Det er gratis:</p>
            <a class="k-btn k-btn-block" href="https://itmartin.dk/mine-apps?app=Stem" target="_blank" rel="noopener">Skriv dig op gratis på itmartin.dk</a>
        </section>
    }
    else
    {
        @* Three numbered steps, the extras folded away, colour on the steps (user 2026-10-21: "I need some colors as well...
           and also it is not simple to use"). *@
        var open = Customer.Mine.FirstOrDefault(m => m.Open);
        @if (_newId > 0)
        {
            <section class="k-card lav-ready" data-nofold>
                <h2 class="k-card-title">Din afstemning er klar</h2>
                <p>Send linket til dem, der skal stemme. De skal ikke oprette noget.</p>
                <p class="lav-link">@Link(_newId)</p>
                <button class="k-btn k-btn-primary k-btn-block" @onclick="() => ShareAsync(_newId)">Del linket</button>
                <div class="btn-pair">
                    <button class="k-btn" @onclick="() => CopyAsync(_newId)">@(_copied == _newId ? "Kopieret" : "Kopiér linket")</button>
                    <a class="k-btn" href="@Link(_newId)" target="_blank" rel="noopener">Se den</a>
                </div>
            </section>
        }
        else if (open is not null)
        {
            @* Free version: one open poll at a time - say it up front instead of after the person has typed everything. *@
            <section class="k-card lav-ready" data-nofold>
                <h2 class="k-card-title">Du har en åben afstemning</h2>
                <p><b>@open.Title</b> – @open.People har stemt. I den gratis udgave har du én åben ad gangen.</p>
                <div class="btn-pair">
                    <button class="k-btn" @onclick="() => ShareAsync(open.Id)">Del linket</button>
                    <button class="k-btn" @onclick="() => ToggleAsync(open.Id)">Luk den og lav en ny</button>
                </div>
            </section>
        }
        else
        {
            <section class="k-card lav-step" data-nofold>
                <h2 class="k-card-title"><span class="lav-num">1</span> Hvad vil du spørge om?</h2>
                <input class="k-input lav-big" @bind="_title" maxlength="120" placeholder="fx Hvor skal vi holde sommerfest?" />
            </section>
            <section class="k-card lav-step" data-nofold>
                <h2 class="k-card-title"><span class="lav-num">2</span> Hvad kan man svare?</h2>
                @for (var i = 0; i < _options.Count; i++)
                {
                    var n = i;
                    <input class="k-input lav-big lav-option" @bind="_options[n]" maxlength="100" placeholder="@($"Svar {n + 1}")" />
                }
                @if (_options.Count < CustomerPollRules.MaxOptions) { <button class="k-btn k-btn-block" @onclick="() => _options.Add(string.Empty)">+ Tilføj et svar</button> }
                <details class="lav-more">
                    <summary>Flere valg</summary>
                    <label class="lav-check"><input type="checkbox" @bind="_multi" /> Man må vælge flere svar</label>
                    <label class="lav-label">Fortæl lidt mere (valgfrit) <textarea class="k-input k-textarea" rows="2" @bind="_body" maxlength="1000"></textarea></label>
                    <label class="lav-label">Slutter (valgfrit) <input class="k-input" type="date" @bind="_end" max="@DateTime.Today.AddDays(CustomerPollRules.MaxDays).ToString("yyyy-MM-dd")" /></label>
                    <p class="k-help">Den lukker af sig selv efter højst 14 dage.</p>
                </details>
            </section>
            <section class="k-card lav-step" data-nofold>
                <h2 class="k-card-title"><span class="lav-num">3</span> Lav den og send linket</h2>
                @if (_error != "") { <p class="lav-warn">@_error</p> }
                <button class="k-btn k-btn-primary k-btn-block lav-go" disabled="@_busy" @onclick="CreateAsync">Lav afstemningen</button>
            </section>
        }

        <section class="k-card" data-fold-closed>
            <h2 class="k-card-title">Mine afstemninger (@Customer.Mine.Count)</h2>
            @if (Customer.Mine.Count == 0) { <p>Du har ikke lavet nogen endnu.</p> }
            @foreach (var m in Customer.Mine)
            {
                var total = Math.Max(1, m.Results.Sum(r => r.People));
                <div class="lav-mine">
                    <div><b>@m.Title</b> <span class="lav-tag @(m.Open ? "is-open" : "")">@(m.Open ? "ÅBEN" : "LUKKET")</span></div>
                    <div class="k-help">@m.People @(m.People == 1 ? "person" : "personer") har stemt</div>
                    @foreach (var r in m.Results)
                    {
                        <div class="lav-bar"><span>@r.Label</span><b>@r.People</b><i style="width:@(r.People * 100 / total)%"></i></div>
                    }
                    <div class="btn-pair">
                        <button class="k-btn k-btn-sm" @onclick="() => ShareAsync(m.Id)">Del linket</button>
                        <button class="k-btn k-btn-sm" @onclick="() => ToggleAsync(m.Id)">@(m.Open ? "Luk" : "Åbn igen")</button>
                    </div>
                </div>
            }
            <button class="k-btn k-btn-sm k-mt" @onclick="LogoutAsync">Glem mit kundenummer på denne telefon</button>
        </section>
    }
</div>

@code {
    private string _code = "", _error = "", _title = "", _body = "";
    private bool _busy, _multi;
    private DateTime? _end;
    private int _newId, _copied;
    private List<string> _options = ["", ""];

    private string Link(int id) => Nav.ToAbsoluteUri($"/poll/{id}").ToString();

    // The kundenummer is read once per visit (CustomerSession, from MainLayout): opened from the menu it is known already.
    protected override void OnInitialized() => Customer.Changed += OnCustomerChanged;
    protected override Task OnAfterRenderAsync(bool first) => first ? Customer.StartAsync() : Task.CompletedTask;
    private void OnCustomerChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Customer.Changed -= OnCustomerChanged;

    private async Task LoginAsync()
    {
        _busy = true; _error = "";
        try { _error = await Customer.LoginAsync(_code) ?? ""; }
        finally { _busy = false; }
    }

    private async Task CreateAsync()
    {
        _busy = true; _error = ""; _newId = 0;
        try
        {
            DateTime? endUtc = _end is { } d ? TimeZoneInfo.ConvertTimeToUtc(d.Date.AddDays(1).AddSeconds(-1), TimeZoneInfo.FindSystemTimeZoneById("Europe/Copenhagen")) : null;
            var (error, id) = await Mine.CreateAsync(Customer.Code, _title, _body, _options, _multi, endUtc);
            if (error is not null) { _error = error; return; }
            _newId = id; _title = _body = ""; _options = ["", ""]; _multi = false; _end = null;
            await Customer.RefreshAsync();
        }
        finally { _busy = false; }
    }

    private async Task ToggleAsync(int id) { await Mine.ToggleAsync(Customer.Code, id); await Customer.RefreshAsync(); }

    private async Task CopyAsync(int id)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Link(id)); _copied = id; } catch { }
    }

    // The phone's own share menu (Messenger, SMS, mail ...); where there is none (most PCs), the link is copied instead.
    private async Task ShareAsync(int id)
    {
        try
        {
            var shared = await JS.InvokeAsync<bool>("eval",
                $"(navigator.share ? navigator.share({{ title: 'Stem', url: '{Link(id)}' }}).then(() => true, () => true) : Promise.resolve(false))");
            if (!shared) await CopyAsync(id);
        }
        catch { await CopyAsync(id); }
    }

    private async Task LogoutAsync() { _code = ""; await Customer.LogoutAsync(); }
}
