@page "/lav"
@inject CustomerPolls Mine
@inject CustomerSession Customer
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

@* "Lav din egen afstemning" (user 2026-10-21): free for customers - the kundenummer from the sign-up opens it, and the phone
   remembers it. Three numbered steps with colour ("it is not simple to use"); as many questions as you like ("only one
   question per poll"), each of three kinds ("maybe make 3 choices"): choose answers (Ja/Nej, A/B ...), give grades 1-5 with a
   comment on each, or pick days (weekends the next 3 months, every Tuesday ...). *@
<PageTitle>Lav din egen afstemning – Stem</PageTitle>

<div class="lav">
    <PageHelp>
        <p>Her laver du din egen afstemning og ser, hvad folk har svaret.</p>
        <p><b>Sådan gør du:</b> skriv hvad det handler om, tilføj dine spørgsmål og tryk Lav afstemningen. Send linket til dem, der skal svare.</p>
        <p>Tre slags spørgsmål: <b>Vælg svar</b> (fx Ja/Nej eller A/B), <b>Giv karakter</b> (1–5 og en kommentar til hver) og <b>Vælg dage</b> (fx weekender de næste 3 måneder).
           Vil du vise noget, kan hvert svar få et <b>billede</b> – tryk Billede ved svaret.</p>
        <p>Folk kan skrive en kommentar til hvert svar, de vælger, og give deres første valg en stjerne.</p>
        <p>Gratis: én åben afstemning af hver slags ad gangen, og den lukker efter højst 14 dage.</p>
        <p>Vi spørger ikke efter e-mails på din afstemning – navnet er frivilligt.</p>
    </PageHelp>

    @if (!Customer.Ready)
    {
        @* The phone may remember the kundenummer - read in a moment. Only the heading until then (no flash of the number box). *@
        <section class="k-card">
            <h1 class="k-card-title">Lav din egen afstemning</h1>
            <p>Et øjeblik …</p>
        </section>
    }
    else if (!Customer.LoggedIn)
    {
        <section class="k-card">
            <h1 class="k-card-title">Lav din egen afstemning</h1>
            <p>Spørg familien, foreningen eller vennerne – og se hvad de vælger. Gratis for kunder.</p>
            <label class="lav-label">Dit kundenummer (8 cifre – står i mailen, du fik)</label>
            <input class="k-input lav-big" inputmode="numeric" autocomplete="off" @bind="_code" placeholder="fx 4821 7730" />
            @if (_error != "") { <p class="lav-warn">@_error</p> }
            <button class="k-btn k-btn-primary k-btn-block k-mt" disabled="@_busy" @onclick="LoginAsync">Fortsæt</button>
            <p class="k-mt">Har du ikke et kundenummer? Det er gratis:</p>
            <a class="k-btn k-btn-block" href="https://itmartin.dk/mine-apps?app=Stem" target="_blank" rel="noopener">Skriv dig op gratis på itmartin.dk</a>
        </section>
    }
    else
    {
        // Free: one open of each kind (rule B) - the kinds an open poll uses cannot be picked again until it closes.
        var busy = Customer.Mine.Where(m => m.Open).SelectMany(m => m.Kinds).ToHashSet();
        var openNow = Customer.Mine.Where(m => m.Open).ToList();
        @if (_made is not null)
        {
            <section class="k-card lav-ready" data-nofold>
                <h2 class="k-card-title">Din afstemning er klar</h2>
                <p>Send linket til dem, der skal svare. De skal ikke oprette noget.</p>
                <p class="lav-link">@Link(_made)</p>
                <button class="k-btn k-btn-primary k-btn-block" @onclick="() => ShareAsync(_made)">Del linket</button>
                <div class="btn-pair">
                    <button class="k-btn" @onclick="() => CopyAsync(_made)">@(_copied == _made.Path ? "Kopieret" : "Kopiér linket")</button>
                    <a class="k-btn" href="@Link(_made)" target="_blank" rel="noopener">Se den</a>
                </div>
            </section>
        }
        else if (QuestionKinds.All.All(busy.Contains))
        {
            @* Free version: all three kinds are open - said up front instead of after the person has typed everything. *@
            <section class="k-card lav-ready" data-nofold>
                <h2 class="k-card-title">Du har åbne afstemninger af alle tre slags</h2>
                <p>I den gratis udgave har du én åben af hver slags. Luk en af dem for at lave en ny.</p>
                @foreach (var open in openNow)
                {
                    <p><b>@open.Title</b> – @open.People har svaret.</p>
                    <div class="btn-pair">
                        @* The maker answers too - through the same link as everyone (user 2026-10-27 "can I answer?"). *@
                        <a class="k-btn" href="@open.Path">Svar selv</a>
                        <button class="k-btn" @onclick="() => ShareAsync(open)">Del linket</button>
                        <button class="k-btn" @onclick="() => ToggleAsync(open)">Luk den</button>
                    </div>
                }
            </section>
        }
        else
        {
            @if (busy.Count > 0)
            {
                <p class="k-help">Du har allerede en åben med @string.Join(" og ", QuestionKinds.All.Where(busy.Contains).Select(k => $"„{QuestionKinds.Name(k)}“")) –
                   i den gratis udgave én af hver slags. De andre slags kan du godt lave nu.</p>
            }
            <section class="k-card lav-step" data-nofold>
                <h2 class="k-card-title"><span class="lav-num">1</span> Hvad handler det om?</h2>
                <input class="k-input lav-big" @bind="_title" maxlength="120" placeholder="fx Sommerfest i foreningen" />
            </section>

            @for (var qi = 0; qi < _questions.Count; qi++)
            {
                var q = _questions[qi];
                var number = qi + 1;
                if (busy.Contains(q.Kind)) q.Kind = FreeKind(busy);   // never start on a kind that is open already
                <section class="k-card lav-step" data-nofold>
                    <h2 class="k-card-title"><span class="lav-num">2</span> Spørgsmål @(number)</h2>
                    <div class="lav-kinds" role="group" aria-label="Slags spørgsmål">
                        @foreach (var kind in QuestionKinds.All)
                        {
                            var k = kind;
                            var taken = busy.Contains(k);
                            <button class="k-btn k-btn-sm @(q.Kind == k ? "k-btn-primary" : "")" disabled="@taken" aria-pressed="@(q.Kind == k ? "true" : "false")"
                                    @onclick="() => q.Kind = k">@QuestionKinds.Name(k)@(taken ? " (har en åben)" : "")</button>
                        }
                    </div>
                    <input class="k-input lav-big" @bind="q.Text" maxlength="120"
                           placeholder="@(q.Kind == QuestionKinds.Grade ? "fx Hvilket mærke er pænest?" : q.Kind == QuestionKinds.Days ? "fx Hvilke dage kan du?" : "fx Hvor skal vi holde festen?")" />

                    @if (q.Kind == QuestionKinds.Days)
                    {
                        @* The days in a period on the chosen weekdays become the answers. *@
                        <div class="lav-sub">Hvilken periode?</div>
                        <div class="lav-chips">
                            @foreach (var (label, months) in Periods)
                            {
                                var mo = months;
                                <button class="k-btn k-btn-sm @(q.Months == mo ? "k-btn-primary" : "")" @onclick="() => q.Months = mo">@label</button>
                            }
                        </div>
                        <div class="lav-sub">Hvilke dage?</div>
                        <div class="lav-chips">
                            <button class="k-btn k-btn-sm" @onclick="() => q.SetDays(DayRules.Weekend)">Weekender</button>
                            <button class="k-btn k-btn-sm" @onclick="() => q.SetDays(DayRules.Weekdays)">Hverdage</button>
                            <button class="k-btn k-btn-sm" @onclick="() => q.SetDays(Enum.GetValues<DayOfWeek>())">Alle dage</button>
                        </div>
                        <div class="lav-weekdays" role="group" aria-label="Ugedage">
                            @foreach (var d in WeekOrder)
                            {
                                var day = d;
                                <button class="lav-day @(q.Days.Contains(day) ? "on" : "")" aria-pressed="@(q.Days.Contains(day) ? "true" : "false")"
                                        @onclick="() => q.Toggle(day)">@DayNames[(int)day]</button>
                            }
                        </div>
                        var days = q.DayOptions(Today);
                        <p class="k-help">@(days.Count == 0 ? "Vælg mindst én ugedag." : $"{days.Count} dage: {string.Join(", ", days.Take(4))}{(days.Count > 4 ? " …" : "")}")</p>
                    }
                    else
                    {
                        <div class="lav-sub">@(q.Kind == QuestionKinds.Grade ? "Hvad skal have karakter?" : "Hvad kan man svare?")</div>
                        @if (q.Kind == QuestionKinds.Choose)
                        {
                            <div class="lav-chips">
                                <button class="k-btn k-btn-sm" @onclick='() => q.Quick("Ja", "Nej")'>Ja / Nej</button>
                                <button class="k-btn k-btn-sm" @onclick='() => q.Quick("A", "B")'>A / B</button>
                                <button class="k-btn k-btn-sm" @onclick='() => q.Quick("Ja", "Nej", "Måske")'>Ja / Nej / Måske</button>
                            </div>
                        }
                        @for (var i = 0; i < q.Options.Count; i++)
                        {
                            var n = i;
                            var pic = q.ImageAt(n);
                            @* A picture per answer (user 2026-10-28, "pictures as choices"): made small on the phone before it is sent. *@
                            <div class="lav-answer">
                                <input class="k-input lav-big lav-option" @bind="q.Options[n]" maxlength="100" placeholder="@(q.Kind == QuestionKinds.Grade ? $"Ting {n + 1}, fx et mærke" : $"Svar {n + 1}")" />
                                <label class="k-btn k-btn-sm lav-pic-btn">@(pic is null ? "Billede" : "Skift")
                                    <InputFile accept="image/*" aria-label="@($"Billede til svar {n + 1}")" OnChange="e => PickImageAsync(q, n, e)" />
                                </label>
                                @if (pic is not null)
                                {
                                    <div class="lav-pic">
                                        <img src="/poll-images/@pic" alt="@($"Billede til svar {n + 1}")" />
                                        <button class="k-btn k-btn-sm" @onclick="() => q.SetImage(n, null)">Fjern billedet</button>
                                    </div>
                                }
                            </div>
                        }
                        @if (q.Options.Count < CustomerPollRules.MaxOptions) { <button class="k-btn k-btn-block" @onclick="() => q.Options.Add(string.Empty)">+ Tilføj @(q.Kind == QuestionKinds.Grade ? "en ting" : "et svar")</button> }
                        @if (q.Kind == QuestionKinds.Choose) { <label class="lav-check"><input type="checkbox" @bind="q.Multi" /> Man må vælge flere svar</label> }
                        @if (q.Kind == QuestionKinds.Grade) { <p class="k-help">Folk giver hver ting 1–5 og kan skrive en kommentar til hver.</p> }
                    }
                    @if (_questions.Count > 1) { <button class="k-btn k-btn-sm k-mt" @onclick="() => _questions.Remove(q)">Fjern spørgsmål @(number)</button> }
                </section>
            }
            @if (_questions.Count < CustomerPollRules.MaxQuestions)
            {
                <button class="k-btn k-btn-block lav-add" @onclick="() => _questions.Add(new QuestionForm { Kind = FreeKind(busy) })">+ Tilføj et spørgsmål</button>
            }

            <section class="k-card lav-step" data-nofold>
                <h2 class="k-card-title"><span class="lav-num">3</span> Lav den og send linket</h2>
                <details class="lav-more">
                    <summary>Flere valg</summary>
                    <label class="lav-label">Fortæl lidt mere (valgfrit) <textarea class="k-input k-textarea" rows="2" @bind="_body" maxlength="1000"></textarea></label>
                    <label class="lav-label">Slutter (valgfrit) <input class="k-input" type="date" @bind="_end" max="@DateTime.Today.AddDays(CustomerPollRules.MaxDays).ToString("yyyy-MM-dd")" /></label>
                    <p class="k-help">Den lukker af sig selv efter højst 14 dage.</p>
                </details>
                @if (_error != "") { <p class="lav-warn">@_error</p> }
                <button class="k-btn k-btn-primary k-btn-block lav-go" disabled="@_busy" @onclick="CreateAsync">Lav afstemningen</button>
            </section>
        }

        <section class="k-card" data-fold-closed>
            <h2 class="k-card-title">Mine afstemninger (@Customer.Mine.Count)</h2>
            @if (Customer.Mine.Count == 0) { <p>Du har ikke lavet nogen endnu.</p> }
            @foreach (var m in Customer.Mine)
            {
                <div class="lav-mine">
                    <div><b>@m.Title</b> <span class="lav-tag @(m.Open ? "is-open" : "")">@(m.Open ? "ÅBEN" : "LUKKET")</span></div>
                    <div class="k-help">@m.People @(m.People == 1 ? "person" : "personer") har svaret</div>
                    @foreach (var question in m.Questions)
                    {
                        @if (m.Questions.Count > 1) { <div class="lav-sub">@question.Text</div> }
                        var total = Math.Max(1, question.Results.Count == 0 ? 1 : question.Results.Max(r => r.People));
                        @for (var i = 0; i < question.Results.Count; i++)
                        {
                            var r = question.Results[i];
                            var who = i < question.Who.Count ? question.Who[i] : [];
                            <div class="lav-bar"><span>@r.Label</span><b>@r.People</b><i style="width:@(r.People * 100 / total)%"></i></div>
                            @* Who answered what - only you, the maker, see the names here (user 2026-10-27). *@
                            @if (who.Count > 0) { <div class="lav-who">@string.Join(", ", who)</div> }
                        }
                        @if (question.Comments.Count > 0)
                        {
                            <div class="lav-comments">
                                <b>Kommentarer</b>
                                @foreach (var c in question.Comments) { <div><b>@c.Name:</b> @c.Text</div> }
                            </div>
                        }
                    }
                    <div class="btn-pair">
                        @if (m.Open)
                        {
                            <a class="k-btn k-btn-sm" href="@m.Path">Svar selv</a>
                        }
                        <button class="k-btn k-btn-sm" @onclick="() => ShareAsync(m)">Del linket</button>
                        <button class="k-btn k-btn-sm" @onclick="() => ToggleAsync(m)">@(m.Open ? "Luk" : "Åbn igen")</button>
                    </div>
                </div>
            }
            <button class="k-btn k-btn-sm k-mt" @onclick="LogoutAsync">Glem mit kundenummer på denne telefon</button>
        </section>
    }
</div>

@code {
    private string _code = "", _error = "", _title = "", _body = "", _copied = "";
    private bool _busy;
    private DateTime? _end;
    private CustomerPolls.Mine? _made;
    private List<QuestionForm> _questions = [new()];

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private static readonly (string Label, int Months)[] Periods = [("Næste måned", 1), ("Næste 3 måneder", 3), ("Næste 6 måneder", 6)];
    private static readonly DayOfWeek[] WeekOrder = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];
    private static readonly string[] DayNames = ["Søn", "Man", "Tir", "Ons", "Tor", "Fre", "Lør"];

    // One question while it is being written (UI state only; the rules are in CustomerPollRules / DayRules).
    private sealed class QuestionForm
    {
        public string Kind { get; set; } = QuestionKinds.Choose;
        public string Text { get; set; } = "";
        public List<string> Options { get; set; } = ["", ""];
        public bool Multi { get; set; }
        public int Months { get; set; } = 3;
        public HashSet<DayOfWeek> Days { get; } = [DayOfWeek.Saturday, DayOfWeek.Sunday];

        public List<string?> Images { get; } = [];   // same order as Options; null = no picture

        public string? ImageAt(int n) => n < Images.Count ? Images[n] : null;
        public void SetImage(int n, string? name) { while (Images.Count <= n) Images.Add(null); Images[n] = name; }
        public void Quick(params string[] answers) { Options = [.. answers]; Images.Clear(); }

        public void SetDays(IEnumerable<DayOfWeek> days) { Days.Clear(); Days.UnionWith(days); }
        public void Toggle(DayOfWeek d) { if (!Days.Remove(d)) Days.Add(d); }
        public List<string> DayOptions(DateOnly today) => DayRules.Days(today, today.AddMonths(Months), Days);

        public QuestionDraft Draft(DateOnly today) => Kind == QuestionKinds.Days
            ? new QuestionDraft(Text, DayOptions(today), true, Kind)
            : new QuestionDraft(Text, Options.ToList(), Multi, Kind, Images.ToList());
    }

    // A kind the customer can still make (the first free one), so a new question never starts on a taken kind.
    private static string FreeKind(HashSet<string> busy) => QuestionKinds.All.FirstOrDefault(k => !busy.Contains(k)) ?? QuestionKinds.Choose;

    private async Task PickImageAsync(QuestionForm q, int n, InputFileChangeEventArgs e)
    {
        _error = "";
        try
        {
            // The phone makes it a jpeg of at most 1200 px first - a 10 MB photo becomes ~200 KB before it is sent.
            var small = await e.File.RequestImageFileAsync("image/jpeg", 1200, 1200);
            await using var read = small.OpenReadStream(5_000_000);
            using var copy = new MemoryStream();
            await read.CopyToAsync(copy);
            copy.Position = 0;
            var name = await Mine.SaveImageAsync(Customer.Code, copy);
            if (name is null) { _error = "Dit kundenummer virker ikke længere – skriv det igen."; return; }
            q.SetImage(n, name);
        }
        catch
        {
            _error = "Billedet kunne ikke bruges. Prøv et andet billede.";
        }
    }

    private string Link(CustomerPolls.Mine m) => Nav.ToAbsoluteUri(m.Path).ToString();

    // The kundenummer is read once per visit (CustomerSession, from MainLayout): opened from the menu it is known already.
    protected override void OnInitialized() => Customer.Changed += OnCustomerChanged;
    protected override Task OnAfterRenderAsync(bool first) => first ? Customer.StartAsync() : Task.CompletedTask;
    private void OnCustomerChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Customer.Changed -= OnCustomerChanged;

    private async Task LoginAsync()
    {
        _busy = true; _error = "";
        try { _error = await Customer.LoginAsync(_code) ?? ""; }
        finally { _busy = false; }
    }

    private async Task CreateAsync()
    {
        _busy = true; _error = ""; _made = null;
        try
        {
            DateTime? endUtc = _end is { } d ? TimeZoneInfo.ConvertTimeToUtc(d.Date.AddDays(1).AddSeconds(-1), TimeZoneInfo.FindSystemTimeZoneById("Europe/Copenhagen")) : null;
            var (error, made) = await Mine.CreateAsync(Customer.Code, _title, _body, _questions.Select(q => q.Draft(Today)).ToList(), endUtc);
            if (error is not null) { _error = error; return; }
            _made = made; _title = _body = ""; _questions = [new()]; _end = null;
            _questions[0].Kind = FreeKind(Customer.Mine.Where(m => m.Open).SelectMany(m => m.Kinds).Concat(made!.Kinds).ToHashSet());
            await Customer.RefreshAsync();
        }
        finally { _busy = false; }
    }

    private async Task ToggleAsync(CustomerPolls.Mine m) { await Mine.ToggleAsync(Customer.Code, m); _made = null; await Customer.RefreshAsync(); }

    private async Task CopyAsync(CustomerPolls.Mine m)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Link(m)); _copied = m.Path; } catch { }
    }

    // The phone's own share menu (Messenger, SMS, mail ...); where there is none (most PCs), the link is copied instead.
    private async Task ShareAsync(CustomerPolls.Mine m)
    {
        try
        {
            var shared = await JS.InvokeAsync<bool>("eval",
                $"(navigator.share ? navigator.share({{ title: 'Stem', url: '{Link(m)}' }}).then(() => true, () => true) : Promise.resolve(false))");
            if (!shared) await CopyAsync(m);
        }
        catch { await CopyAsync(m); }
    }

    private async Task LogoutAsync() { _code = ""; await Customer.LogoutAsync(); }
}
