@page "/admin/kunder"
@inject IConfiguration Config

@* The Kundekartotek moved to Kunder on 2026-10-21 (one list for all apps). This old address sends Martin there. *@
<PageTitle>Kundekartotek — Stem</PageTitle>

<div class="poll-root">
    <header class="poll-header">
        <a href="/admin" class="poll-back">← Admin</a>
        <span class="poll-logo">Kundekartotek</span>
    </header>
    <div class="admin-form">
        <p class="admin-hint">Kundekartoteket er flyttet til <b>Kunder</b> – én liste for alle apps. Dem, der skriver sig op i Stem, kommer også dér.</p>
        <a class="admin-create-btn" href="@KunderSite">Åbn Kunder</a>
    </div>
</div>

@code {
    private string KunderSite => Config["Kunder:PublicUrl"] ?? "https://kunder.itmartin.dk";
}
