@page "/admin/datepoll/create"
@page "/admin/datepoll/edit/{DatePollId:int}"
@rendermode InteractiveServer
@inject DatePolls DatePolls
@inject AdminSession   Session
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Ny" : "Rediger") datoafstemning</PageTitle>

<div class="poll-root">
    <header class="poll-header">
        <a href="/admin" class="poll-back">← Admin</a>
        <span class="poll-logo">@(_isNew ? "Ny datoafstemning" : "Rediger")</span>
    </header>

    @if (!Session.IsAdmin)
    {
        <div class="poll-empty"><p>Ingen adgang. <a href="/admin">Log ind</a></p></div>
    }
    else
    {
        <div class="admin-form">

            <label class="form-label">Titel</label>
            <input class="poll-input" placeholder="Hvad skal I finde en dato til?"
                   @bind="_title" @bind:event="oninput" />

            <label class="form-label">Beskrivelse</label>
            <textarea class="poll-textarea" rows="4"
                      placeholder="Uddyb gerne baggrunden…"
                      @bind="_description" @bind:event="oninput"></textarea>

            <label class="form-label">Topbillede (valgfrit)</label>
            <InputFile OnChange="OnImageSelected" accept="image/*" class="file-input" />
            @if (!string.IsNullOrEmpty(_imageName))
            {
                <img src="/poll-images/@_imageName" class="admin-preview-img" alt="" />
            }

            <label class="form-label">Ekstra billeder, spredt ud mellem datoerne (valgfrit)</label>
            <InputFile OnChange="OnSpreadImagesSelected" accept="image/*" multiple class="file-input" />
            @if (_spreadImageNames.Count > 0)
            {
                <div class="admin-spread-preview">
                    @foreach (var name in _spreadImageNames)
                    {
                        <div class="admin-spread-preview-item">
                            <img src="/poll-images/@name" class="admin-preview-img" alt="" />
                            <button class="admin-btn danger small" type="button" @onclick="() => _spreadImageNames.Remove(name)">✕</button>
                        </div>
                    }
                </div>
            }

            <label class="form-label">Frist (valgfrit)</label>
            <input type="date" class="poll-input"
                   value="@_deadlineStr"
                   @onchange="e => _deadlineStr = e.Value?.ToString() ?? string.Empty" />

            <label class="form-label">Adgangskode (valgfrit)</label>
            <input class="poll-input" placeholder="Lad stå tom for ingen adgangskode"
                   @bind="_password" @bind:event="oninput" />

            <label class="form-label">Datoer</label>
            @for (int i = 0; i < _dates.Count; i++)
            {
                var idx = i;
                <div class="option-row">
                    <input type="date" class="poll-input option-input"
                           value="@_dates[idx]"
                           @onchange="e => _dates[idx] = e.Value?.ToString() ?? string.Empty" />
                    @if (_dates.Count > 1)
                    {
                        <button class="admin-btn danger small" @onclick="() => _dates.RemoveAt(idx)">✕</button>
                    }
                </div>
            }
            <button class="admin-btn" @onclick="() => _dates.Add(string.Empty)">+ Tilføj dato</button>

            @if (!_isNew)
            {
                @if (_voters.Count > 0)
                {
                    <label class="form-label">Deltagere (@_voters.Count)</label>
                    <div class="voter-matrix-wrap">
                        <table class="voter-matrix">
                            <thead>
                                <tr>
                                    <th>Navn</th>
                                    @foreach (var d in _results)
                                    {
                                        <th>@d.Date.ToString("d/M")</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in _voters)
                                {
                                    <tr>
                                        <td class="voter-name">@v.Name</td>
                                        @foreach (var d in _results)
                                        {
                                            var cell = v.ByDate.TryGetValue(d.Date, out var c) ? c : ("", false);
                                            <td title="@(cell.Item1 == "" ? "Ikke svaret" : StatusLabel(cell.Item1))">
                                                @(cell.Item1 == "" ? "—" : StatusIcon(cell.Item1))@(cell.Item2 ? "⭐" : "")
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <label class="form-label">Resultater</label>
                @foreach (var d in _results)
                {
                    var noCount = d.Counts.FirstOrDefault(c => c.Status == "No").Count;
                    var flagged = noCount >= NoVoteFlagThreshold;
                    <div class="poll-results" style="padding:0 0 12px@(flagged ? ";opacity:.5" : "")">
                        <div class="poll-results-label" style="margin-bottom:6px;display:flex;align-items:center;gap:8px">
                            <span>@d.Date.ToString("dddd d. MMMM")</span>
                            @if (d.PreferredCount > 0)
                            {
                                <span style="font-size:12px;font-weight:700;color:#CA8A04">⭐ @d.PreferredCount foretrækker</span>
                            }
                            @if (flagged)
                            {
                                <span style="font-size:12px;font-weight:700;color:#B91C1C">⚠ @noCount kan ikke</span>
                                <button class="admin-btn danger small" @onclick="() => RemoveDate(d.Date)">Fjern denne dato</button>
                            }
                        </div>
                        @foreach (var (status, count) in d.Counts)
                        {
                            var pct = d.Total > 0 ? (int)Math.Round(count * 100.0 / d.Total) : 0;
                            <div class="poll-result-row">
                                <div class="poll-result-label">@StatusLabel(status)</div>
                                <div class="poll-result-bar-wrap">
                                    <div class="poll-result-bar" style="width:@pct%;background:@StatusColor(status)"></div>
                                </div>
                                <div class="poll-result-pct">@pct%</div>
                                <div class="poll-result-count">(@count)</div>
                            </div>
                        }
                    </div>
                }

                @if (_comments.Count > 0)
                {
                    <div class="poll-comments" style="padding:0">
                        <div class="poll-comments-label">Kommentarer</div>
                        @foreach (var c in _comments)
                        {
                            <div class="poll-comment">
                                <span class="poll-comment-opt" style="background:@StatusColor(c.Status)">
                                    @c.DateLabel · @StatusLabel(c.Status)
                                </span>
                                <span class="session-comment-name @(string.IsNullOrWhiteSpace(c.VoterName) ? "anon" : "")">
                                    @(string.IsNullOrWhiteSpace(c.VoterName) ? "Anonym" : c.VoterName)
                                </span>
                                <span class="poll-comment-text">@c.Comment</span>
                            </div>
                        }
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="form-error">@_error</div>
            }

            <button class="poll-submit-btn" @onclick="Save">
                @(_isNew ? "Opret datoafstemning" : "Gem ændringer")
            </button>

        </div>
    }
</div>

@code {
    [Parameter] public int DatePollId { get; set; }

    private bool _isNew = true;
    private string _title = "";
    private string _description = "";
    private string _deadlineStr = "";
    private string? _imageName;
    private List<string> _spreadImageNames = [];
    private string? _password;
    private List<string> _dates = [DateTime.Today.ToString("yyyy-MM-dd")];
    private string _error = "";

    private List<DateResult> _results = [];
    private List<CommentRow> _comments = [];
    private List<VoterRow> _voters = [];

    private record DateResult(DateTime Date, int Total, List<(string Status, int Count)> Counts, int PreferredCount);
    private record CommentRow(string DateLabel, string Status, string VoterName, string Comment);
    private record VoterRow(string Name, Dictionary<DateTime, (string Status, bool Preferred)> ByDate);

    private static string StatusLabel(string status) => status switch
    {
        "Yes" => "✅ Ja", "No" => "❌ Nej", _ => "🤔 Måske"
    };

    private static string StatusIcon(string status) => status switch
    {
        "Yes" => "✅", "No" => "❌", "Maybe" => "🤔", _ => "—"
    };

    private static string StatusColor(string status) => status switch
    {
        "Yes" => "#16A34A", "No" => "#B91C1C", _ => "#B45309"
    };

    // A week the admin might want to rule out at a glance - stays visible
    // (never auto-removed) but greyed out with a warning and a manual
    // "remove" button, since only the admin should decide a week is truly
    // off the table.
    private const int NoVoteFlagThreshold = 5;

    protected override async Task OnInitializedAsync()
    {
        _isNew = DatePollId == 0;
        if (_isNew) return;

        await LoadPollDataAsync();
    }

    private async Task LoadPollDataAsync()
    {
        var full = await DatePolls.GetAsync(DatePollId);
        var p = full is null ? null : new
        {
            full.Title, full.Description, full.ImageName, full.Deadline, full.Password,
            Images = full.Images.OrderBy(i => i.SortOrder).Select(i => i.FileName).ToList(),
            Dates = full.Dates.OrderBy(d => d.SortOrder).Select(d => new
            {
                d.Date,
                Responses = d.Responses.Select(r => new { r.Status, r.VoterName, r.Comment, r.IsPreferred }).ToList(),
            }).ToList(),
        };

        if (p is null) return;

        _title       = p.Title;
        _description = p.Description;
        _imageName   = p.ImageName;
        _spreadImageNames = p.Images;
        _deadlineStr = p.Deadline?.ToString("yyyy-MM-dd") ?? "";
        _password    = p.Password;
        _dates       = p.Dates.Select(d => d.Date.ToString("yyyy-MM-dd")).ToList();
        if (_dates.Count == 0) _dates = [DateTime.Today.ToString("yyyy-MM-dd")];

        _results = p.Dates.Select(d => new DateResult(
            d.Date, d.Responses.Count,
            new[] { "Yes", "Maybe", "No" }.Select(s => (s, d.Responses.Count(r => r.Status == s))).ToList(),
            d.Responses.Count(r => r.IsPreferred)
        )).ToList();

        _comments = p.Dates.SelectMany(d => d.Responses
                .Where(r => !string.IsNullOrWhiteSpace(r.Comment))
                .Select(r => new CommentRow(d.Date.ToString("d. MMM"), r.Status, r.VoterName, r.Comment)))
            .ToList();

        // One row per distinct person who has answered at least one date -
        // multi-name voting (e.g. "Vibz, Eigil, Bertil") already creates a
        // separate DatePollResponse per name, so this naturally lists
        // individuals rather than raw submissions.
        var voterNames = p.Dates.SelectMany(d => d.Responses.Select(r => r.VoterName))
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _voters = voterNames.Select(name => new VoterRow(
            name,
            p.Dates.ToDictionary(
                d => d.Date,
                d =>
                {
                    var r = d.Responses.FirstOrDefault(x => string.Equals(x.VoterName, name, StringComparison.OrdinalIgnoreCase));
                    return (r?.Status ?? "", r?.IsPreferred ?? false);
                })
        )).ToList();
    }

    // Admin-only, explicit action - a flagged week is never removed
    // automatically, only offered up for a one-click removal once it's
    // crossed the No-vote threshold. Its responses go with it (same
    // no-explicit-cascade-cleanup convention Save() already uses above for
    // the whole-date-list re-key case).
    private async Task RemoveDate(DateTime date)
    {
        await DatePolls.RemoveDateAsync(DatePollId, date);
        await LoadPollDataAsync();
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        if (e.File is null) return;
        await using var ms = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        _imageName = await DatePolls.SaveImageAsync(ms, e.File.Name);
    }

    // Multiple files at once, appended to what is already staged.
    private async Task OnSpreadImagesSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(maximumFileCount: 20))
        {
            await using var ms = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            _spreadImageNames.Add(await DatePolls.SaveImageAsync(ms, file.Name));
        }
    }

    private async Task Save()
    {
        DateTime? deadline = null;
        if (!string.IsNullOrEmpty(_deadlineStr) && DateTime.TryParse(_deadlineStr, out var dl)) deadline = dl.ToUniversalTime();
        var dates = _dates.Where(d => DateTime.TryParse(d, out _)).Select(DateTime.Parse).ToList();
        _error = await DatePolls.SaveAsync(_isNew ? 0 : DatePollId,
            new DatePolls.Form(_title, _description, _imageName, deadline, _password, dates, _spreadImageNames)) ?? "";
        if (_error == "") Nav.NavigateTo("/admin");
    }
}
