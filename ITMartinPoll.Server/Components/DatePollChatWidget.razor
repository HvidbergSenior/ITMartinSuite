@inject DatePolls DatePolls
@inject DatePollBroadcastService Broadcast
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="dp-date" style="margin-bottom:0">Chat om afstemningen</div>
<div class="chat-widget-messages" id="datepoll-chat-@DatePollId" style="max-height:280px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;padding:10px 0">
    @foreach (var m in _messages)
    {
        <div class="chat-widget-msg @(m.SenderName == VoterName ? "mine" : "")">
            <div class="chat-widget-sender">@m.SenderName</div>
            <div class="chat-widget-bubble">@m.Text</div>
        </div>
    }
    @if (_messages.Count == 0)
    {
        <div class="chat-widget-empty">Ingen beskeder endnu.</div>
    }
</div>

@if (ChatOpen)
{
    <div class="chat-widget-input-row" style="padding:8px 0">
        <input class="chat-widget-input poll-input" placeholder="Skriv..." value="@_text"
               @oninput="e => _text = e.Value?.ToString() ?? string.Empty" @onkeydown="OnKey" style="flex:1" />
        <button class="chat-widget-send" @onclick="SendAsync" disabled="@string.IsNullOrWhiteSpace(_text)" aria-label="Send besked">Send</button>
    </div>
}
else
{
    <div class="chat-widget-empty">Afstemningen er lukket - chatten er ikke længere åben.</div>
}

<style>
    /* Kolibri tokens so it reads in Lys and Mørk; other people's messages sit in a grey bubble, yours in the one colour. */
    .chat-widget-msg { display: flex; flex-direction: column; max-width: 85%; align-self: flex-start; }
    .chat-widget-msg.mine { align-self: flex-end; align-items: flex-end; }
    .chat-widget-sender { font-size: var(--k-fs-small); font-weight: 700; color: var(--k-muted); margin-bottom: 2px; }
    .chat-widget-bubble { background: var(--k-bg-deep); border: 1px solid var(--k-border); border-radius: 14px 14px 14px 4px; padding: 8px 12px;
        font-size: var(--k-fs-body); color: var(--k-text); word-break: break-word; }
    .chat-widget-msg.mine .chat-widget-bubble { background: var(--k-accent); border-color: var(--k-accent); color: var(--k-accent-text); border-radius: 14px 14px 4px 14px; }
    .chat-widget-empty { color: var(--k-muted); font-size: var(--k-fs-small); text-align: center; padding: 12px 0; }
    .chat-widget-input-row { display: flex; gap: 6px; }
    .chat-widget-send { min-width: var(--k-tap, 48px); background: var(--k-accent); color: var(--k-accent-text); border: none; border-radius: var(--k-radius);
        font-size: 1rem; font-weight: 700; cursor: pointer; }
    .chat-widget-send:disabled { opacity: .45; }
</style>

@code {
    [Parameter, EditorRequired] public int DatePollId { get; set; }
    [Parameter, EditorRequired] public bool ChatOpen { get; set; }
    [Parameter, EditorRequired] public string VoterName { get; set; } = "";

    private string _text = "";
    private List<DatePollChatMessage> _messages = [];
    private bool _subscribed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _subscribed) return;
        await RefreshAsync();
        Broadcast.Subscribe(DatePollId, OnBroadcast);
        _subscribed = true;
        StateHasChanged();
    }

    private async Task RefreshAsync() => _messages = await DatePolls.ChatAsync(DatePollId);

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendAsync();
    }

    private async Task SendAsync()
    {
        var text = _text.Trim();
        if (string.IsNullOrEmpty(text) || !ChatOpen) return;

        await DatePolls.SendChatAsync(DatePollId, VoterName, text);   // tells the open pages to refresh
        _text = "";
        await RefreshAsync();
        try { await JS.InvokeVoidAsync("eval", $"document.getElementById('datepoll-chat-{DatePollId}').scrollTop = 999999"); } catch { }
    }

    private void OnBroadcast() => InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    public ValueTask DisposeAsync()
    {
        if (_subscribed) Broadcast.Unsubscribe(DatePollId, OnBroadcast);
        return ValueTask.CompletedTask;
    }
}
