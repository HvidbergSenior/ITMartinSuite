@page "/percussion"
@inject IJSRuntime JS

<div class="ka-page">
    <div class="ka-card">
        <h1 class="ka-title">🥁 Tromme med</h1>
        <p class="ka-sub">Tryk løs i takt med musikken - eller brug en spand, et bord, hvad der nu er ved hånden!</p>

        <div class="ka-pad-grid">
            <button class="ka-pad clap" @onclick='() => Hit("clap")'>👏</button>
            <button class="ka-pad drum" @onclick='() => Hit("drum")'>🥁</button>
            <button class="ka-pad tom" @onclick='() => Hit("tom")'>🔔</button>
            <button class="ka-pad shaker" @onclick='() => Hit("shaker")'>🪇</button>
        </div>
    </div>
</div>

@code {
    private async Task Hit(string kind) => await JS.InvokeVoidAsync("karaoke.playPad", kind);
}
