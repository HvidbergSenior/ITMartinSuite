@page "/titel/{IdText}"
@layout AdminLayout
@inject Catalog Catalog
@inject NavigationManager Nav

<PageTitle>@(_item?.Title ?? "Titel") – Bibliotek</PageTitle>

@if (_item is null)
{
    <p class="muted">Henter…</p>
}
else
{
    <div class="top-row">
        <h1>@(_isNew ? "Ny titel" : _item.Title)</h1>
        <a class="top-link" href="@(_item.Kind == MediaKind.Musik ? Links.Music : "/?kind=" + (_item.Kind == MediaKind.Serie ? "serier" : "film"))">Tilbage</a>
    </div>

    @if (Ny == "1")
    {
        <div class="ok-box">Tilføjet til samlingen. Ret detaljerne her hvis noget er forkert.</div>
    }

    <div class="detail-head">
        <div class="detail-cover">
            <Cover Url="@_item.CoverUrl" Icon="@Display.Icon(_item.Kind)" Square="@(_item.Kind == MediaKind.Musik)" />
        </div>
        <div class="detail-status">
            <p class="muted">@(_item.Status == MediaStatus.Rippet ? "Rippet – kan afspilles." : "Kun på hylden – ikke rippet endnu.")</p>
            @if (_item.Kind == MediaKind.Musik && _item.JellyfinId != "")
            {
                <button type="button" class="btn btn-primary btn-block" data-play-album="@_item.JellyfinId">▶ Afspil</button>
                <a class="hint" href="@_playUrl" target="_blank" rel="noopener">Åbn i Jellyfin</a>
            }
            else if (!string.IsNullOrEmpty(_playUrl))
            {
                <a class="btn btn-primary btn-block" href="@_playUrl" target="_blank" rel="noopener">▶ Afspil i Jellyfin</a>
            }
            else if (_item.Status == MediaStatus.Ejet)
            {
                <p class="hint">Rip den med MakeMKV/HandBrake ind i MartinBibliotek, så finder Jellyfin-synk den selv.</p>
            }
        </div>
    </div>

    <div class="field">
        <label>Titel</label>
        <input type="text" @bind="_item.Title" />
    </div>
    <div class="field-row">
        <div class="field">
            <label>Type</label>
            <select @bind="_item.Kind">
                <option value="@MediaKind.Film">Film</option>
                <option value="@MediaKind.Serie">Serie</option>
                <option value="@MediaKind.Musik">Musik</option>
            </select>
        </div>
        <div class="field">
            <label>Format</label>
            <select @bind="_item.Format">
                <option value="@MediaFormat.Dvd">DVD</option>
                <option value="@MediaFormat.BluRay">Blu-ray</option>
                <option value="@MediaFormat.Cd">CD</option>
                <option value="@MediaFormat.Digital">Kun digital</option>
            </select>
        </div>
        <div class="field">
            <label>År</label>
            <input type="text" inputmode="numeric" @bind="_item.Year" />
        </div>
    </div>
    @if (_item.Kind == MediaKind.Musik)
    {
        <div class="field">
            <label>Kunstner</label>
            <input type="text" @bind="_item.Artist" />
        </div>
    }
    <div class="field">
        <label>Stregkode</label>
        <input type="text" inputmode="numeric" @bind="_item.Barcode" />
    </div>
    <div class="field">
        <label>Cover (URL)</label>
        <input type="text" @bind="_item.CoverUrl" />
    </div>
    <div class="field">
        <label>Noter</label>
        <textarea rows="3" @bind="_item.Notes" placeholder="Fx hvor discen står, om den er ridset, hvem der har lånt den"></textarea>
    </div>

    <div class="btn-row">
        <button class="btn btn-primary" @onclick="Save" disabled="@_saving">Gem</button>
        <button class="btn" @onclick="FindMetadata" disabled="@_busy">Slå titlen op</button>
    </div>
    @if (_saved)
    {
        <p class="hint" style="margin-top:8px">Gemt.</p>
    }

    @if (_busy)
    {
        <p class="muted">Søger…</p>
    }
    else if (_candidates is { Count: > 0 })
    {
        <div class="section-label">Vælg for at hente år, cover og id</div>
        @foreach (var c in _candidates)
        {
            <button class="hit" @onclick="() => Apply(c)">
                <div class="hit-cover">
                    <Cover Url="@c.CoverUrl" Icon="@Display.Icon(c.Kind)" />
                </div>
                <div class="hit-body">
                    <div class="hit-title">@c.Title</div>
                    <div class="hit-sub">@c.Artist @(c.Year?.ToString() ?? "")</div>
                    <div class="hit-src">@c.Source</div>
                </div>
            </button>
        }
    }
    else if (_candidates is { Count: 0 })
    {
        <p class="muted">Ingen træffere. @(_item.Kind == MediaKind.Musik ? "" : "Er TMDB-nøglen sat under Indstillinger?")</p>
    }

    @if (!_isNew)
    {
        <div class="ids">
            @if (_item.TmdbId != "") { <span>TMDB @_item.TmdbId</span> }
            @if (_item.MusicBrainzId != "") { <span>MusicBrainz @_item.MusicBrainzId[..8]…</span> }
            @if (_item.DiscogsId != "") { <span>Discogs @_item.DiscogsId</span> }
            @if (_item.JellyfinId != "") { <span>I Jellyfin</span> }
            <span>Tilføjet @_item.AddedAt.ToLocalTime().ToString("d. MMM yyyy")</span>
        </div>
        <button class="btn btn-danger" @onclick="Delete">Fjern fra samlingen</button>
    }
}

@code {
    [Parameter] public string IdText { get; set; } = "";
    [SupplyParameterFromQuery] public string? Barcode { get; set; }
    [SupplyParameterFromQuery] public string? Ny { get; set; }

    [CascadingParameter] public Viewer? Viewer { get; set; }

    private MediaItem? _item;
    private bool _isNew;
    private bool _saving;
    private bool _saved;
    private bool _busy;
    private string _playUrl = "";
    private List<Candidate>? _candidates;

    protected override async Task OnParametersSetAsync()
    {
        if (Viewer is not { IsAdmin: true }) return;
        if (IdText == "ny")
        {
            _isNew = true;
            _item = Catalog.New(Viewer, Barcode ?? "");
            return;
        }
        if (!Guid.TryParse(IdText, out var id)) { Nav.NavigateTo("/"); return; }
        _item = await Catalog.GetAsync(Viewer, id);
        if (_item is null) { Nav.NavigateTo("/"); return; }
        _playUrl = await Catalog.PlayUrlAsync(_item);
    }

    private async Task Save()
    {
        if (_item is null || string.IsNullOrWhiteSpace(_item.Title)) return;
        _saving = true;
        await Catalog.SaveAsync(_item, _isNew);
        if (_isNew)
        {
            Nav.NavigateTo($"/titel/{_item.Id}?ny=1");
            return;
        }
        _saving = false;
        _saved = true;
    }

    private async Task FindMetadata()
    {
        if (_item is null || string.IsNullOrWhiteSpace(_item.Title)) return;
        _busy = true;
        _candidates = null;
        _candidates = await Catalog.FindAsync(_item);
        _busy = false;
    }

    private async Task Apply(Candidate c)
    {
        Catalog.Apply(_item!, c);
        _candidates = null;
        await Save();
    }

    private async Task Delete()
    {
        await Catalog.DeleteAsync(_item!);
        Nav.NavigateTo("/");
    }
}
