@page "/login"
@layout EmptyLayout

<PageTitle>Log ind – Bibliotek</PageTitle>

@* The ITMartin/Kolibri header on the login page too (user 2026-11-09: all apps the same template). *@
<KolibriHeader />

<div class="login-wrap">
    <div class="login-box">
        <img class="login-icon" src="/_content/ITMartin.Shared.UI/kolibri-icon.svg" alt="" />
        <div class="login-title">Bibliotek</div>
        @if (Error == "1")
        {
            <div class="login-error">Forkert PIN – prøv igen</div>
        }
        <form method="post" action="/api/auth/login">
            <input type="password" name="pin" class="login-field" placeholder="PIN-kode" autofocus maxlength="30" />
            <button type="submit" class="btn btn-primary btn-block">Log ind</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
