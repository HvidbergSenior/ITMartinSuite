@page "/"
@inject Library Library
@inject Admin Admin
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(IsCustomer ? "Min musik" : "Samling") – Bibliotek</PageTitle>

<div class="top-row">
    <h1>@(Viewer is { IsAdmin: false } v ? v.Name + "s musik" : "Bibliotek")</h1>
    <a class="top-link" href="/api/auth/logout">Log ud</a>
</div>

@if (_items is null)
{
    <p class="muted">Henter…</p>
}
else if (IsCustomer)
{
    @* A customer has two things: listen here, and Send musik in the menu (user 2026-10-15). *@
    @if (_albums.Count == 0)
    {
        <section class="card">
            <h2>Her kommer din musik</h2>
            <p>Når du har sendt dine cd'er, står de her. Tryk på et cover for at høre det.</p>
            <p class="muted">Martin hjælper dig i gang: 31 19 47 30.</p>
        </section>
    }
    else
    {
        <p class="lede">Tryk på et cover for at høre det.</p>
        <div class="grid grid-albums">
            @foreach (var a in _albums)
            {
                <AlbumTile Album="a" ShowArtist="true" TapToPlay="true" />
            }
        </div>
    }
}
else
{
    <PageInfo Id="om-samling">
        <p>Her er hele samlingen: musik, film og serier.</p>
        <p>Søg i feltet. Det leder i det hele på én gang: kunstnere, album, sange og film.</p>
        <p>Musik: tryk på et bogstav, så en kunstner og et album. Tryk ▶ Afspil, eller tryk på en sang for at starte ved den. Film og serier åbner i Jellyfin.</p>
    </PageInfo>

    <div class="search-bar">
        <input type="search" id="soeg" placeholder="Søg kunstner, album, sang eller film" aria-label="Søg i hele samlingen"
               value="@_query" @oninput="OnSearch" autocomplete="off" enterkeyhint="search" />
    </div>

    @if (_result is not null)
    {
        <SearchResults Result="_result" Songs="_songs" SongsLoading="_songsLoading" Query="@_query" PlayBase="@_playBase" />
    }
    else
    {
        <nav class="tabs" aria-label="Vælg hylde">
            <a class="tab @(_kind == MediaKind.Musik ? "is-on" : "")" href="/?kind=musik">Musik <span>@_artists.Count</span></a>
            <a class="tab @(_kind == MediaKind.Film ? "is-on" : "")" href="/?kind=film">Film <span>@Count(MediaKind.Film)</span></a>
            <a class="tab @(_kind == MediaKind.Serie ? "is-on" : "")" href="/?kind=serier">Serier <span>@Count(MediaKind.Serie)</span></a>
        </nav>

        @if (_kind == MediaKind.Musik)
        {
            @if (_artists.Count == 0)
            {
                <p class="muted">Ingen musik endnu. Synkroniser med Jellyfin under Indstillinger.</p>
            }
            else
            {
                var letters = _artists.Select(a => a.Letter).ToHashSet();
                <nav class="letters" aria-label="Gå til bogstav">
                    @foreach (var l in Shelf.Alphabet)
                    {
                        var letter = l;
                        <button type="button" disabled="@(!letters.Contains(letter))" @onclick="() => Jump(letter)">@letter</button>
                    }
                </nav>
                @foreach (var g in _artists.GroupBy(a => a.Letter))
                {
                    <h2 class="letter-head" id="@LetterId(g.Key)">@g.Key</h2>
                    <ul class="artist-list">
                        @foreach (var a in g)
                        {
                            <ArtistRow Artist="a" />
                        }
                    </ul>
                }
            }
        }
        else
        {
            var shown = _items.Where(i => i.Kind == _kind && (_group is null || i.Collection == _group))
                .OrderBy(i => Shelf.SortKey(i.Title), StringComparer.Ordinal).ToList();
            // One tile per category (Film\X-Men\...); an opened category shows its titles.
            var groups = _group is null
                ? shown.Where(i => i.Collection != "").GroupBy(i => i.Collection)
                    .OrderBy(g => Shelf.SortKey(g.Key), StringComparer.Ordinal).ToList()
                : [];
            var singles = _group is null ? shown.Where(i => i.Collection == "").ToList() : shown;
            @if (_group is not null)
            {
                <p class="group-head"><a href="@KindUrl()">← Alle</a> <b>@_group</b></p>
            }
            <div class="grid grid-posters">
                @foreach (var g in groups)
                {
                    var first = g.OrderBy(i => i.Year ?? 9999).First();
                    <div class="tile">
                        <a class="tile-link" href="@($"{KindUrl()}&gruppe={Uri.EscapeDataString(g.Key)}")">
                            <Cover Url="@first.CoverUrl" Icon="@Display.Icon(first.Kind)" />
                            <span class="tile-title">@g.Key</span>
                            <span class="tile-sub">@g.Count() @(g.Count() == 1 ? "titel" : "titler")</span>
                        </a>
                    </div>
                }
                @foreach (var i in singles)
                {
                    <TitleTile Item="i" PlayBase="@_playBase" />
                }
            </div>
        }
    }
}

@code {
    [CascadingParameter] public Viewer? Viewer { get; set; }

    // The shelf lives in the URL (/?kind=musik) so Back from an album lands on the same shelf.
    [SupplyParameterFromQuery(Name = "kind")] public string? KindText { get; set; }
    [SupplyParameterFromQuery(Name = "gruppe")] public string? GroupText { get; set; }

    private bool IsCustomer => Viewer is { IsAdmin: false };

    private List<MediaItem>? _items;
    private List<Album> _albums = [];
    private List<Artist> _artists = [];
    private MediaKind _kind = MediaKind.Musik;
    private string? _group;
    private string _playBase = "";

    private string _query = "";
    private SearchResult? _result;
    private List<SongHit> _songs = [];
    private bool _songsLoading;
    private CancellationTokenSource? _songSearch;

    protected override async Task OnInitializedAsync()
    {
        if (Viewer is null) { _items = []; return; }
        _items = await Library.ItemsAsync(Viewer);
        _albums = Shelf.Albums(_items.Where(i => i.Kind == MediaKind.Musik));
        _artists = Shelf.Artists(_albums);
        if (!IsCustomer) _playBase = await Admin.PlayUrlAsync("");
    }

    protected override void OnParametersSet()
    {
        _kind = KindText switch
        {
            "film" => MediaKind.Film,
            "serier" => MediaKind.Serie,
            _ => MediaKind.Musik
        };
        _group = string.IsNullOrWhiteSpace(GroupText) ? null : GroupText;
    }

    private string KindUrl() => "/?kind=" + (_kind switch { MediaKind.Serie => "serier", MediaKind.Film => "film", _ => "musik" });

    private int Count(MediaKind k) => _items?.Count(i => i.Kind == k) ?? 0;


    private static string LetterId(string letter) => "bogstav-" + (letter == Shelf.OtherLetter ? "andet" : letter);

    private async Task Jump(string letter)
    {
        try { await JS.InvokeVoidAsync("bibliotekScrollTo", LetterId(letter)); } catch (JSException) { }
    }

    // The shelf is searched at once on every key; songs come from Jellyfin, so they wait
    // until typing pauses.
    private async Task OnSearch(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _songSearch?.Cancel();
        _songs = [];
        if (_query.Trim().Length == 0 || _items is null)
        {
            _result = null;
            _songsLoading = false;
            return;
        }
        _result = Shelf.Search(_items, _query);
        if (Shelf.Fold(_query).Length < 3) { _songsLoading = false; return; }

        var cts = _songSearch = new CancellationTokenSource();
        _songsLoading = true;
        try
        {
            await Task.Delay(400, cts.Token);
            var songs = await Library.SearchSongsAsync(Viewer!, _query);
            if (cts.IsCancellationRequested) return;
            _songs = songs;
        }
        catch (OperationCanceledException) { return; }
        catch (Exception) { _songs = []; }
        _songsLoading = false;
    }

    public void Dispose() => _songSearch?.Cancel();
}
