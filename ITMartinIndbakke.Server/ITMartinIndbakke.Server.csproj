    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ITMartin.Shared.UI\ITMartin.Shared.UI.csproj" />
        <ProjectReference Include="..\ITMartinIndbakke.Application\ITMartinIndbakke.Application.csproj" />
        <ProjectReference Include="..\ITMartinIndbakke.Infrastructure\ITMartinIndbakke.Infrastructure.csproj" />
    </ItemGroup>
</Project>
