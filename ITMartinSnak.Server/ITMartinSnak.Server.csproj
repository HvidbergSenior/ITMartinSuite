<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- "Snak" (Kolibri Kommunikere), 2026-10-09: a small group chat for a few friends instead of a
         Facebook group. One shared group code, live messages, push to the phone, no ads, no tracking. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ITMartinSnak.Server</RootNamespace>
        <AssemblyName>ITMartinSnak.Server</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="WebPush" Version="1.0.12" />
        <ProjectReference Include="..\ITMartin.Shared.UI\ITMartin.Shared.UI.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ITMartinSnak.Tests" />
    </ItemGroup>

</Project>
