<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ITMartinSuite.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ITMartinSuite.Maui.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Hjem"
            Route="home"
            ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent
            Title="Familie"
            Route="familie/board"
            ContentTemplate="{DataTemplate views:TaskBoardPage}" />
    </TabBar>

</Shell>
