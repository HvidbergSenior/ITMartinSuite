<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ITMartinSuite.Maui.Views.DailyBriefPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ITMartinSuite.Maui.ViewModels"
    xmlns:models="clr-namespace:ITMartinSuite.Maui.Models"
    Title=""
    BackgroundColor="#0F1117">

    <ContentPage.Resources>
        <Style x:Key="HeadlineStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#F0F0F0" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="DescStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#9999AA" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MaxLines" Value="2" />
        </Style>
        <Style x:Key="MetaStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#666677" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,52,16,10" ColumnDefinitions="*,Auto" BackgroundColor="#0F1117">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="DailyBrief" FontSize="24" FontAttributes="Bold" TextColor="#F0F0F0" />
                <Label Text="{Binding Summary}" FontSize="13" TextColor="#6B7280" IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="⚙"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="#6B7280"
                    Clicked="OnSettingsClicked"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Divider -->
        <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="#1E2030" />

        <!-- Feed -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="0,4,0,32">

                    <!-- Error state -->
                    <VerticalStackLayout IsVisible="{Binding HasError}" Padding="24" Spacing="12">
                        <Label Text="⚠ Kunne ikke hente nyheder" FontSize="16" TextColor="#EF4444" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="#9CA3AF" HorizontalTextAlignment="Center" />
                        <Button Text="Prøv igen" Command="{Binding LoadCommand}"
                                BackgroundColor="#1E2030" TextColor="#F0F0F0"
                                CornerRadius="8" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Loading skeleton (3 placeholder cards) -->
                    <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="1">
                        <BoxView HeightRequest="100" Color="#161825" Margin="0,0,0,1" />
                        <BoxView HeightRequest="100" Color="#161825" Margin="0,0,0,1" />
                        <BoxView HeightRequest="100" Color="#161825" Margin="0,0,0,1" />
                    </VerticalStackLayout>

                    <!-- Articles -->
                    <CollectionView
                        ItemsSource="{Binding Items}"
                        IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                        SelectionMode="None">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FeedItem">
                                <Grid>
                                    <!-- Tap target -->
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DailyBriefViewModel}}, Path=OpenArticleCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Card -->
                                    <Grid ColumnDefinitions="*,Auto" Padding="16,14" BackgroundColor="#161825"
                                          ColumnSpacing="12">

                                        <!-- Text column -->
                                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                                            <!-- Source badge + time -->
                                            <HorizontalStackLayout Spacing="8">
                                                <Border BackgroundColor="{Binding SourceColor}"
                                                        Stroke="Transparent" StrokeThickness="0"
                                                        Padding="6,2">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="3" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding SourceName}" FontSize="11"
                                                           FontAttributes="Bold" TextColor="White" />
                                                </Border>
                                                <Label Text="{Binding TimeAgo}" Style="{StaticResource MetaStyle}" VerticalOptions="Center" />
                                                <Label Text="{Binding ReadMinutes, StringFormat='{0} min'}"
                                                       Style="{StaticResource MetaStyle}" VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <!-- Headline -->
                                            <Label Text="{Binding Title}" Style="{StaticResource HeadlineStyle}" />

                                            <!-- Description -->
                                            <Label Text="{Binding Description}" Style="{StaticResource DescStyle}"
                                                   IsVisible="{Binding HasImage, Converter={StaticResource InvertBoolConverter}}" />
                                        </VerticalStackLayout>

                                        <!-- Thumbnail -->
                                        <Image Grid.Column="1"
                                               Source="{Binding ImageUrl}"
                                               WidthRequest="90"
                                               HeightRequest="68"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding HasImage}">
                                            <Image.Clip>
                                                <RoundRectangleGeometry CornerRadius="6"
                                                    Rect="0,0,90,68" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>

                                    <!-- Bottom border -->
                                    <BoxView VerticalOptions="End" HeightRequest="1" BackgroundColor="#0F1117" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="32" Spacing="16">
                                <Label Text="📰" FontSize="48" HorizontalTextAlignment="Center" />
                                <Label Text="Ingen nyheder at vise" FontSize="16" TextColor="#6B7280" HorizontalTextAlignment="Center" />
                                <Label Text="Aktivér mindst én kilde i indstillinger" FontSize="13" TextColor="#4B5563" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- Done banner — shown when items loaded and not loading -->
                    <VerticalStackLayout
                        Padding="16,20"
                        IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                        Spacing="4">
                        <Label Text="✓ Du er opdateret"
                               FontSize="14"
                               TextColor="#374151"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Træk ned for at opdatere"
                               FontSize="12"
                               TextColor="#1F2937"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>

</ContentPage>
