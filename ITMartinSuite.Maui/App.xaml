<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:ITMartinSuite.Maui.Converters"
             x:Class="ITMartinSuite.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:NullConverter x:Key="NullConverter" />
            <conv:NotNullConverter x:Key="NotNullConverter" />
            <conv:NotEmptyConverter x:Key="NotEmptyConverter" />
            <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
            <conv:TypeColorConverter x:Key="TypeColorConverter" />
            <conv:TypeSelectedColorConverter x:Key="TypeSelectedColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
