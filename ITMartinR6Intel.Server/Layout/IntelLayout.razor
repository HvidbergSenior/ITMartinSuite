@inherits LayoutComponentBase
@inject IntelSessionService Session
@inject IntelDataService DataService
@implements IDisposable

<div class="intel-shell">

    <header class="intel-header">
        <div class="intel-header-inner">
            <a href="/" style="text-decoration:none;display:flex;align-items:center;gap:8px;color:inherit">
                <span class="intel-logo">R6</span>
                <span class="intel-header-title">INTEL</span>
            </a>
            @if (Session.SelectedMap is not null)
            {
                <span class="intel-header-map">— @Session.SelectedMap</span>
            }
            <nav style="margin-left:auto;display:flex;gap:8px">
                <a href="/" style="color:#9ca3af;text-decoration:none;font-size:.85rem">👁 Viewer</a>
                <a href="/intel" style="color:#9ca3af;text-decoration:none;font-size:.85rem">🎯 Intel</a>
                <a href="/admin" style="color:#9ca3af;text-decoration:none;font-size:.85rem">🛠 Admin</a>
            </nav>
        </div>
        @if (Session.SelectedMap is not null)
        {
            var map = DataService.GetMap(Session.SelectedMap);
            if (map is not null && map.Floors.Count > 0)
            {
                <div class="intel-floor-tabs">
                    @foreach (var floor in map.Floors)
                    {
                        <button class="intel-floor-tab @(Session.ActiveFloor == floor.Label ? "active" : "")"
                                @onclick="() => Session.SetFloor(floor.Label)">
                            @floor.Label
                        </button>
                    }
                </div>
            }
        }
    </header>

    <main class="intel-main">
        @Body
    </main>
    <footer style="text-align:center;padding:.6rem 1rem;font-size:.72rem;color:#64748b;border-top:1px solid rgba(255,255,255,.06)"><a href="https://all-apps.itmartin.dk/vilkaar" target="_blank" style="color:#64748b;text-decoration:underline">Vilkår &amp; Privatlivspolitik</a> · &copy; @DateTime.Now.Year ITMartin - Den digitale kolibri</footer>

</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnStateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.OnStateChanged -= OnStateChanged;
}
