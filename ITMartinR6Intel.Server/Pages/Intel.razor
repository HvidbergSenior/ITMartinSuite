@page "/intel"
@layout IntelLayout
@inject IntelSessionService Session
@implements IDisposable

<div class="intel-page intel-control-page">

    @if (Session.SelectedMap is null)
    {
        <div class="intel-waiting">
            <div class="intel-waiting-icon">R6</div>
            <div class="intel-waiting-title">Waiting for round to start...</div>
            <div class="intel-waiting-sub">Admin selects map to begin</div>
        </div>
    }
    else
    {
        <div class="marker-type-bar">
            @foreach (var mt in _markerTypes)
            {
                var m = mt;
                <button class="marker-type-btn @(Session.ActiveMarkerMode == m.Type ? "active" : "")"
                        style="--marker-color: @m.Color"
                        @onclick="() => Session.SetActiveMarkerMode(m.Type)">
                    <span class="marker-type-icon">@m.Icon</span>
                    <span class="marker-type-label">@m.Type</span>
                </button>
            }
        </div>

        <div class="floor-plan-wrapper">
            <FloorPlanView IsInteractive="true" />
        </div>

        <div class="intel-control-actions">
            <button class="intel-btn intel-btn-danger" @onclick="Session.ClearFloorMarkers">
                Clear Floor
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Session.LiveNote))
    {
        <div class="live-note">@Session.LiveNote</div>
    }

</div>

@code {
    private record MarkerTypeInfo(string Type, string Icon, string Color);

    private readonly MarkerTypeInfo[] _markerTypes =
    [
        new("Enemy",   "\U0001F480", "#ef4444"),
        new("Gadget",  "\U0001F527", "#f97316"),
        new("Caution", "⚠️",         "#eab308"),
        new("Rotate",  "\U0001F504", "#6b7280"),
    ];

    private static readonly HashSet<string> _intelTypeSet =
        new() { "Enemy", "Gadget", "Caution", "Rotate" };

    protected override void OnInitialized()
    {
        // Ensure we start in an intel-compatible mode (not a tactical mode set by admin)
        if (!_intelTypeSet.Contains(Session.ActiveMarkerMode))
            Session.SetActiveMarkerMode("Enemy");
        Session.OnStateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.OnStateChanged -= OnStateChanged;
}
