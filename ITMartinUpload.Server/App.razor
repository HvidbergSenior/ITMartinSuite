<!DOCTYPE html>
<html lang="da">
<head>
    <script>
        (function () {
            var theme = localStorage.getItem('upload_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Upload – ITMartin</title>
    <base href="/" />
    @* The version makes Cloudflare fetch the stylesheet again after a deploy
       instead of serving the cached one next to freshly rendered markup. *@
    <link rel="stylesheet" href="@($"app.css?v={AssetVersion}")" />
    <HeadOutlet />
    <script>
        // Android: keep the browser's install offer so the event page can show its own button.
        window.addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); window._installPrompt = e; });
        window.eventApp = {
            installed: function () { return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true; },
            canPrompt: function () { return !!window._installPrompt; },
            isIos: function () { return /iphone|ipad|ipod/i.test(navigator.userAgent); },
            inApp: function () { return /FBAN|FBAV|FB_IAB|Instagram|Messenger|Snapchat|MicroMessenger|Line\/|GSA\//.test(navigator.userAgent); },
            isMobile: function () { return /android|iphone|ipad|ipod|mobile/i.test(navigator.userAgent); },
            isEdge: function () { return /Edg\//.test(navigator.userAgent); },
            prompt: async function () {
                if (!window._installPrompt) return false;
                window._installPrompt.prompt();
                var r = await window._installPrompt.userChoice;
                window._installPrompt = null;
                return r && r.outcome === 'accepted';
            }
        };
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function () {});
    </script>
</head>
<body>
    <Routes />
    <script src="_framework/blazor.server.js"></script>
<script>
(function(){
    var vid = localStorage.getItem('_mid');
    if (!vid) { vid = Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2); localStorage.setItem('_mid', vid); }
    function track(path, title, referrer) {
        if (location.search.indexOf('claude_test=1') !== -1) return;
        fetch('https://stats.itmartin.dk/api/hit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: path, title: title, referrer: referrer, visitorId: vid, host: location.hostname }),
            keepalive: true
        }).catch(function(){});
    }
    track(location.pathname + location.search, document.title, document.referrer);
    document.addEventListener('click', function(e) {
        var a = e.target.closest('a');
        if (!a || !a.href || a.href.startsWith('javascript')) return;
        var href = a.getAttribute('href') || a.href;
        track('click:' + href, a.textContent.trim().slice(0, 80), location.pathname);
    }, true);
})();
</script>

    <button id="themeToggleBtn" title="Skift lys/mørk visning"
            style="position:fixed;bottom:20px;right:20px;z-index:9999;width:52px;height:52px;border-radius:50%;border:2px solid #fff;background:linear-gradient(135deg,#f472b6,#a855f7);color:#fff;font-size:22px;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center">
        🌓
    </button>
    <script>
    (function () {
        var btn = document.getElementById('themeToggleBtn');
        function sync() {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            btn.textContent = current === 'light' ? '🌙' : '☀️';
        }
        btn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('upload_theme', next);
            sync();
        });
        sync();
    })();
    </script>
</body>
</html>

@code {
    private static readonly string AssetVersion =
        File.GetLastWriteTimeUtc(typeof(App).Assembly.Location).Ticks.ToString();
}
