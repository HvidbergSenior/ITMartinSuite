@page "/upload/{Slug}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IConfiguration Config
@inject NavigationManager Nav
@inject ITMartinUpload.Server.Services.UploadStore Store
@inject Microsoft.Extensions.Options.IOptions<ITMartinUpload.Server.Services.UploadOptions> Options

<PageTitle>Upload – @DisplayName – ITMartin</PageTitle>

@if (!_authorized)
{
    <div class="root">
        <div class="header">
            <div class="logo">🔒</div>
            <h1 class="title">Adgang nægtet</h1>
            <p class="sub">Linket mangler sin kode, eller den er forkert. Skriv til Martin på ITMartin@Mensa.dk eller ring 31 19 47 30, så sender han et nyt.</p>
        </div>
    </div>
    return;
}

<div class="root">
    <div class="header">
        <div class="logo">🐦</div>
        <h1 class="title">@Greeting</h1>
        <p class="sub">@Intro</p>
    </div>

    <div class="steps">
        <div class="step"><span class="step-emoji">🗂️</span><span class="step-no">1</span><div class="step-text"><b>Find billederne</b><span>På telefonen, computeren, USB-stikket eller den gamle harddisk.</span></div></div>
        <div class="step"><span class="step-emoji">📤</span><span class="step-no">2</span><div class="step-text"><b>Træk dem herind</b><span>Mange ad gangen. Lad siden være åben, mens de sendes.</span></div></div>
        <div class="step"><span class="step-emoji">✨</span><span class="step-no">3</span><div class="step-text"><b>Martin sorterer</b><span>Dubletter væk, orden efter år og begivenhed – og et galleri til jer.</span></div></div>
    </div>

    <div class="dropzone" id="dz">
        <div class="dz-icon">🗂️</div>
        <div class="dz-text">Træk filer hertil</div>
        <div class="dz-or">eller</div>
        <label class="dz-btn">
            Vælg billeder på telefon eller computer
            <input type="file" id="fi" multiple style="display:none" />
        </label>
        <div class="dz-hint">Billeder, film, scanninger, dokumenter – alt kan sendes</div>
    </div>

    @if (_uploads.Count > 0)
    {
        <div class="section">
            <div class="section-header">
                <span class="section-label">Uploadkø</span>
                <span class="section-meta">
                    @DoneCount af @_uploads.Count filer
                    @if (SkippedCount > 0) { <text> · @SkippedCount havde I sendt før</text> }
                    @if (ErrorCount > 0) { <text> · @ErrorCount fejl</text> }
                </span>
            </div>
            <div class="file-list">
                @foreach (var f in _uploads)
                {
                    <div class="file-row @RowClass(f.Status)">
                        <div class="file-status">@StatusIcon(f.Status)</div>
                        <div class="file-body">
                            <div class="file-name" title="@f.Name">@f.Name</div>
                            <div class="file-meta">
                                @FormatSize(f.Size)
                                @if (f.Status == UploadStatus.Skipped)
                                {
                                    <span class="file-skip"> · havde I sendt før – sendes ikke igen</span>
                                }
                                @if (f.Error != null)
                                {
                                    <span class="file-err"> · @f.Error</span>
                                }
                            </div>
                            @if (f.Status == UploadStatus.Uploading)
                            {
                                <div class="bar-track">
                                    <div class="bar-fill" style="width:@(f.Progress)%"></div>
                                </div>
                            }
                            @if (f.Status == UploadStatus.Done)
                            {
                                <div class="bar-track">
                                    <div class="bar-fill done" style="width:100%"></div>
                                </div>
                            }
                        </div>
                        <div class="file-pct">
                            @if (f.Status == UploadStatus.Uploading)
                            {
                                <span>@(f.Progress)%</span>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (AllDone)
            {
                <div class="done-banner">
                    ✅ @DoneCount fil@(DoneCount == 1 ? "" : "er") er kommet frem til Martin. Tak!
                    @if (SkippedCount > 0)
                    {
                        <span class="skip-note"> · @SkippedCount havde I sendt før og blev sprunget over</span>
                    }
                    @if (ErrorCount > 0)
                    {
                        <span class="err-note"> · @ErrorCount mislykkedes</span>
                    }
                </div>
            }
        </div>
    }

    @if (_existing.Count > 0)
    {
        <div class="section">
            <div class="section-header">
                <span class="section-label">Det, I har sendt</span>
                <span class="section-meta">@_existing.Count filer · @FormatSize(_existing.Sum(f => f.Size))</span>
            </div>
            <p class="section-note">
                Alt herunder ligger trygt hos Martin. I behøver ikke sende det igen – og hvis I kommer til det,
                opdager siden selv, at filen er den samme, og springer den over.
            </p>
            @if (_existing.Count > 12)
            {
                <input class="filter" type="search" placeholder="Søg i det, I har sendt …"
                       @bind="_filter" @bind:event="oninput" />
            }
            <div class="file-list">
                @foreach (var f in FilteredExisting)
                {
                    <div class="file-row done">
                        <div class="file-status">@FileIcon(f.Name)</div>
                        <div class="file-body">
                            <div class="file-name" title="@f.Name">@f.Name</div>
                            <div class="file-meta">@FormatSize(f.Size) · @f.Modified.ToLocalTime().ToString("d. MMM yyyy")</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (_loaded && _uploads.Count == 0 && _existing.Count == 0)
    {
        <div class="empty-hint">
            📭 I har ikke sendt noget endnu – træk de første billeder ind i boksen ovenfor
        </div>
    }
    <footer style="text-align:center;padding:.6rem 1rem;font-size:.72rem;color:#64748b;border-top:1px solid rgba(255,255,255,.06);margin-top:2rem"><a href="https://all-apps.itmartin.dk/vilkaar" target="_blank" style="color:#64748b;text-decoration:underline">Vilkår &amp; Privatlivspolitik</a> · &copy; @DateTime.Now.Year ITMartin - Den digitale kolibri</footer>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private enum UploadStatus { Queued, Uploading, Done, Error, Skipped }
    private record UploadFile(string Id, string Name, long Size, UploadStatus Status, int Progress, string? Error);
    private record ExistingFile(string Name, long Size, DateTime Modified);
    public record FileInfoJs(string Name, long Size);

    private List<UploadFile> _uploads = [];
    private List<ExistingFile> _existing = [];
    private bool _loaded;
    private string _filter = "";

    private IEnumerable<ExistingFile> FilteredExisting =>
        string.IsNullOrWhiteSpace(_filter)
            ? _existing
            : _existing.Where(f => f.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase));
    private bool _authorized = true;
    private string _token = "";
    private ITMartinUpload.Server.Services.UploadCustomer? _customer;

    private string DisplayName => string.IsNullOrWhiteSpace(_customer?.Name) ? Slug : _customer!.Name;
    private string Greeting => _customer?.GreetingOrDefault ?? $"Hej {Slug}!";
    private string Intro => string.IsNullOrWhiteSpace(_customer?.Intro)
        ? "Her sender I jeres billeder direkte til Martins server i Danmark – ingen cloud, ingen mail der er for stor."
        : _customer!.Intro;

    private IJSObjectReference? _js;
    private DotNetObjectReference<Upload>? _ref;

    private int DoneCount => _uploads.Count(f => f.Status == UploadStatus.Done);
    private int ErrorCount => _uploads.Count(f => f.Status == UploadStatus.Error);
    private int SkippedCount => _uploads.Count(f => f.Status == UploadStatus.Skipped);
    private bool AllDone => _uploads.Count > 0 &&
        _uploads.All(f => f.Status is UploadStatus.Done or UploadStatus.Error or UploadStatus.Skipped);

    protected override void OnInitialized()
    {
        var qs = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        _token = qs["token"] ?? "";
        _customer = Options.Value.Find(Slug);

        if (!Options.Value.IsAuthorized(Slug, _token))
        {
            _authorized = false;
            return;
        }
        LoadExisting();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_authorized) return;
        _ref = DotNetObjectReference.Create(this);
        _js = await JS.InvokeAsync<IJSObjectReference>("import", "/upload.js");
        await _js.InvokeVoidAsync("init", "dz", "fi", Slug, _token, _ref);
    }

    /// <summary>
    /// Called from the browser with what the customer just picked. Files we already have
    /// get an empty id, which tells the browser not to send them again - so dropping the
    /// same folder twice costs nothing.
    /// </summary>
    [JSInvokable]
    public async Task<string[]> AddFiles(FileInfoJs[] files)
    {
        var ids = new string[files.Length];
        for (var i = 0; i < files.Length; i++)
        {
            var already = Store.AlreadyHave(Slug, files[i].Name, files[i].Size);
            ids[i] = already ? "" : Guid.NewGuid().ToString();
            _uploads.Add(new(
                already ? $"skip-{i}-{Guid.NewGuid():N}" : ids[i],
                files[i].Name,
                files[i].Size,
                already ? UploadStatus.Skipped : UploadStatus.Queued,
                already ? 100 : 0,
                null));
        }
        await InvokeAsync(StateHasChanged);
        return ids;
    }

    [JSInvokable]
    public async Task OnStart(string id)
    {
        Patch(id, f => f with { Status = UploadStatus.Uploading });
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnProgress(string id, int pct)
    {
        Patch(id, f => f with { Status = UploadStatus.Uploading, Progress = pct });
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnDone(string id, bool ok, string error)
    {
        Patch(id, f => f with
        {
            Status = ok ? UploadStatus.Done : UploadStatus.Error,
            Progress = 100,
            Error = ok ? null : (string.IsNullOrEmpty(error) ? "Ukendt fejl" : error)
        });
        if (ok) LoadExisting();
        await InvokeAsync(StateHasChanged);
    }

    private void Patch(string id, Func<UploadFile, UploadFile> fn)
    {
        var i = _uploads.FindIndex(f => f.Id == id);
        if (i >= 0) _uploads[i] = fn(_uploads[i]);
    }

    private void LoadExisting()
    {
        _existing = Store.List(Slug)
            .Select(f => new ExistingFile(f.Name, f.Size, f.ModifiedUtc))
            .ToList();
        _loaded = true;
    }

    private static string FormatSize(long b)
    {
        if (b < 1024) return $"{b} B";
        if (b < 1024 * 1024) return $"{b / 1024.0:F1} KB";
        if (b < 1024L * 1024 * 1024) return $"{b / (1024.0 * 1024):F1} MB";
        return $"{b / (1024.0 * 1024 * 1024):F2} GB";
    }

    private static string StatusIcon(UploadStatus s)
    {
        return s switch
        {
            UploadStatus.Done => "✅",
            UploadStatus.Skipped => "⏭️",
            UploadStatus.Error => "❌",
            UploadStatus.Uploading => "⬆️",
            _ => "⏳"
        };
    }

    private static string RowClass(UploadStatus s)
    {
        return s switch
        {
            UploadStatus.Done => "done",
            UploadStatus.Skipped => "skip",
            UploadStatus.Error => "err",
            UploadStatus.Uploading => "active",
            _ => ""
        };
    }

    private static string FileIcon(string name)
    {
        return Path.GetExtension(name).ToLowerInvariant() switch
        {
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".heic" or ".heif" => "🖼️",
            ".mp4" or ".mov" or ".avi" or ".mkv" or ".m4v" => "🎬",
            ".mp3" or ".aac" or ".wav" or ".flac" or ".m4a" => "🎵",
            ".pdf" => "📄",
            ".zip" or ".rar" or ".7z" => "🗜️",
            _ => "📎"
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_js is not null) await _js.DisposeAsync();
        _ref?.Dispose();
    }
}
