@using static Microsoft.AspNetCore.Components.Web.RenderMode

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="manifest" href="/manifest.json" />

    <base href="/" />

    <link rel="stylesheet"
          href="bootstrap/css/bootstrap.min.css?v=@CacheBuster" />

    <link rel="stylesheet"
          href="_content/ITMartin.Shared.UI/css/Shared.css" />

    <link rel="stylesheet"
          href="css/Magic.css?v=@CacheBuster" />

    <link rel="stylesheet"
          href="ITMartin.Magic.Server.styles.css" />

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>

<Routes @rendermode="InteractiveServer" />

<script src="js/webcam.js?v=@CacheBuster"></script>

<script src="_framework/blazor.web.js"></script>

<script>
(function(){
    var vid = localStorage.getItem('_mid');
    if (!vid) { vid = Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2); localStorage.setItem('_mid', vid); }
    function track(path, title, referrer) {
        fetch('https://stats.itmartin.dk/api/hit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: path, title: title, referrer: referrer, visitorId: vid, host: location.hostname }),
            keepalive: true
        }).catch(function(){});
    }
    track(location.pathname + location.search, document.title, document.referrer);
    document.addEventListener('click', function(e) {
        var a = e.target.closest('a');
        if (!a || !a.href || a.href.startsWith('javascript')) return;
        var href = a.getAttribute('href') || a.href;
        track('click:' + href, a.textContent.trim().slice(0, 80), location.pathname);
    }, true);
})();
</script>
</body>
</html>

@code {
    // Set once per process (i.e. per deploy/restart) - forces browsers and Cloudflare's
    // edge cache to fetch fresh static assets after every deploy instead of potentially
    // serving a stale cached copy indefinitely, since these files had no versioning at all.
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}