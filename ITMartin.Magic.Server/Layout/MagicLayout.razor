@inherits LayoutComponentBase

@* The same frame as ElPriser (the reference app, 2026-11-13): KolibriHeader with tabs, k-main/k-content, KolibriFooter.
   The active tab is filled, not only coloured. *@
<KolibriTitle />
<KolibriHeader>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/" Match="NavLinkMatch.All">Scan</NavLink>
    <NavLink class="k-btn k-btn-ghost k-btn-sm" href="/knowledge">Sæt og kort</NavLink>
    <button id="themeToggleBtn" class="k-btn k-btn-ghost k-btn-sm" type="button" title="Skift lys/mørk visning">Lys/mørk</button>
</KolibriHeader>
<div class="k-main"><div class="k-content">
    @Body
</div></div>
<KolibriFooter />
