@page "/"
@page "/scanner"

@using System.Threading.Channels
@using ITMartin.Magic.Application.Interfaces
@using ITMartin.Magic.Application.Models
@using ITMartin.Magic.Application.Workflows
@using ITMartin.Magic.Domain.Entities
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject ICardScanOrchestrator CardScanOrchestrator
@inject IMagicKnowledgeService MagicKnowledgeService
@inject IMagicCardRepository CardRepository
@implements IAsyncDisposable

<PageTitle>MTG Scanner</PageTitle>

<div class="scanner-page">

    <div class="scanner-brand">
        itmartin.dk
    </div>

    <ProblemPurposeBanner
        Problem="At finde priser på Magic-kort er besværligt. Priser findes forskellige steder, og det er svært at afgøre præcis hvilket sæt et kort er fra."
        Formaal="Gør processen hurtigere. Ét sted at finde prisen — og du kan stole på den." />

    @if (string.IsNullOrWhiteSpace(_ownerName))
    {
        <div class="alert alert-warning mt-2">
            <div class="fw-bold mb-1">👤 Hvem scanner?</div>
            <div class="small mb-2">Dine kort gemmes under dit navn, så din samling ikke blandes sammen med andres.</div>
            <div class="d-flex gap-2">
                <input class="form-control" placeholder="Dit navn" @bind="_ownerInput" @bind:event="oninput" />
                <button class="btn btn-primary" @onclick="SaveOwnerName" disabled="@string.IsNullOrWhiteSpace(_ownerInput)">Gem</button>
            </div>
        </div>
    }
    else
    {
        <div class="text-muted small mt-1">
            👤 Scanner som <strong>@_ownerName</strong> — <button class="btn btn-link btn-sm p-0" @onclick="ChangeOwnerName">skift</button>
        </div>
    }

    @if (!_cameraStarted && _completedCount == 0)
    {
        <div class="alert alert-info mt-2">
            📷 <strong>Sådan virker det:</strong> Vælg sæt → start kameraet → tryk "Scan kort" for hvert kort du vil have med (de lægges i en bunke, se tallet på knappen).
            Tryk "▶️ Behandl X kort" når du er klar til at få dem genkendt og prissat — helt op til dig hvornår.
        </div>
    }

    <hr class="scanner-divider" />

    @if (!_cameraStarted && _completedCount > 0 && !_showSetPicker)
    {
        <div class="session-summary fade-in-panel">
            <h5 class="mb-2">📋 Denne session — @_completedCount kort</h5>
            @{
                var sessionTotal = _recentResults
                    .Select(r => r.Result?.ScryfallMatchResult?.EurPrice)
                    .Where(p => p.HasValue)
                    .Sum(p => p!.Value);
            }
            @if (sessionTotal > 0)
            {
                <div class="session-total mb-2">Samlet værdi: <strong>€@sessionTotal.ToString("F2")</strong></div>
            }
            <ul class="list-group mb-3">
                @foreach (var item in _recentResults)
                {
                    <li class="list-group-item @(item.Success ? "list-group-item-success" : "list-group-item-warning") @(item.Result is not null ? "feed-item-clickable" : "")"
                        @onclick="() => SelectFeedItem(item)">
                        @item.Text
                        @if (item.Result is not null)
                        {
                            <span class="feed-item-hint">Tryk for detaljer →</span>
                        }
                    </li>
                }
            </ul>
            <button class="btn btn-primary w-100 mb-2"
                    @onclick="StartCamera"
                    disabled="@(string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol)">
                📷 Scan flere kort
            </button>
            <div class="text-center">
                <button class="btn btn-link btn-sm" @onclick="() => _showSetPicker = true">Skift sæt</button>
            </div>
        </div>
    }
    else if (!_cameraStarted)
    {
        <div class="scanner-setup">

            <label class="form-label fw-bold">
                🃏 Sæt
            </label>

            <div class="set-mode-toggle">
                <button type="button"
                        class="@(!NoSetSymbol ? "set-mode-btn active" : "set-mode-btn")"
                        @onclick="() => NoSetSymbol = false">
                    Vælg sæt
                </button>
                <button type="button"
                        class="@(NoSetSymbol ? "set-mode-btn active" : "set-mode-btn")"
                        @onclick="() => NoSetSymbol = true">
                    Kort uden sætsymbol
                </button>
            </div>

            @if (!NoSetSymbol)
            {
                <input class="form-control mt-2"
                       placeholder="🔍 Søg sæt..."
                       @bind="_setSearch" @bind:event="oninput" />

                @if (_selectedSetCode != null)
                {
                    var sel = _sets.FirstOrDefault(s => s.SetCode == _selectedSetCode);
                    <div class="selected-set-display">
                        @if (!string.IsNullOrEmpty(sel?.IconSvgUri))
                        {
                            <img src="@($"/api/set-icon/{_selectedSetCode}")" class="selected-set-icon" width="28" height="28" alt="@_selectedSetCode" />
                        }
                        <div class="selected-set-text">
                            <div class="selected-set-name">@(sel?.SetName ?? _selectedSetCode)</div>
                            <div class="selected-set-code">@_selectedSetCode.ToUpperInvariant()</div>
                        </div>
                        <button class="selected-set-clear" @onclick="() => _selectedSetCode = null">✕</button>
                    </div>
                }

                <div class="set-icon-grid">
                    @foreach (var set in FilteredSets)
                    {
                        <div class="set-tile @(set.SetCode == _selectedSetCode ? "set-tile-selected" : "")"
                             @onclick="() => _selectedSetCode = set.SetCode"
                             title="@set.SetName">
                            @if (!string.IsNullOrEmpty(set.IconSvgUri))
                            {
                                <img src="@($"/api/set-icon/{set.SetCode}")" class="set-tile-icon" width="22" height="22" alt="@set.SetCode" />
                            }
                            <div class="set-tile-code">@set.SetCode.ToUpper()</div>
                            <div class="set-tile-name">@set.SetName</div>
                        </div>
                    }
                    @if (!FilteredSets.Any())
                    {
                        <div class="text-muted small p-2">Ingen sæt matcher søgningen.</div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mt-2">
                    Scanner kort uden sætsymboler.
                </div>
            }

            <button class="btn btn-primary mt-3 w-100"
                    @onclick="StartCamera"
                    disabled="@(string.IsNullOrWhiteSpace(_ownerName) || (string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol))">
                📷 Start kamera
            </button>

        </div>
    }
    else
    {
        <div class="set-bar">
            <div class="set-bar-info">
                <div class="set-bar-label">Sæt</div>
                <div class="set-bar-name">
                    @if (NoSetSymbol)
                    {
                        <span>Uden sætsymbol</span>
                    }
                    else
                    {
                        var sel = _sets.FirstOrDefault(s => s.SetCode == _selectedSetCode);
                        <span>@(sel?.SetName ?? _selectedSetCode) <span class="set-bar-code">(@_selectedSetCode?.ToUpperInvariant())</span></span>
                    }
                </div>
            </div>
            <button class="set-bar-change" @onclick="ChangeSet">Skift sæt</button>
        </div>

        @if (_pendingFrames.Count > 0)
        {
            <button class="btn btn-primary w-100 mb-2 behandl-button" @onclick="SendPendingFrames">
                ▶️ Behandl @_pendingFrames.Count kort
            </button>
        }

        <div class="scanner-wrapper">
            <video id="video"
                   autoplay
                   muted
                   playsinline
                   webkit-playsinline
                   class="scanner-video">
            </video>

            <div class="scanner-guide">
                <div class="guide-text">
                    Placer kort inden for rammen
                </div>
            </div>

            @if (_justCaptured)
            {
                <div class="capture-flash">
                    ✅ Taget! Klar til næste kort
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_detectedText) && !_justCaptured)
        {
            <div class="alert alert-danger mt-2">
                ⚠️ @_detectedText
            </div>
        }

        <div class="scanner-buttons">

            @if (_queuedCount > 0 || _completedCount > 0)
            {
                <div class="scanner-status-row">
                    @if (_queuedCount > 0)
                    {
                        <span class="badge bg-info text-dark">
                            🔄 @_queuedCount kort behandles...
                        </span>
                    }

                    @if (_completedCount > 0)
                    {
                        <span class="badge bg-success">
                            ✅ @_completedCount gemt denne session
                        </span>

                        <button class="btn btn-outline-light btn-sm" @onclick="StopAndShowResults">
                            👁️ Se resultater
                        </button>
                    }
                </div>
            }

            <button class="@(_justCaptured ? "btn btn-lg scan-button scan-button-flash" : "btn btn-success btn-lg scan-button")"
                    @onclick="() => Capture()"
                    disabled="@(!_cameraStarted || (string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol))">
                @(_justCaptured ? "✅ Taget!" : "📷 Scan kort")
                @if (_pendingFrames.Count > 0)
                {
                    <span class="pending-count-badge">@_pendingFrames.Count</span>
                }
            </button>

        </div>
    }

    @if (_recentResults.Count > 0 && _cameraStarted)
    {
        <ul class="list-group mt-3">
            @* Live feed while actively scanning stays compact on purpose - the
               full, uncapped list is what the "Denne session" summary panel
               shows once you stop. *@
            @foreach (var item in _recentResults.Take(10))
            {
                <li class="list-group-item @(item.Success ? "list-group-item-success" : "list-group-item-warning") @(item.Result is not null ? "feed-item-clickable" : "")"
                    @onclick="() => SelectFeedItem(item)">
                    @item.Text
                    @if (item.Result is not null)
                    {
                        <span class="feed-item-hint">Tryk for detaljer →</span>
                    }
                </li>
            }
        </ul>
    }


    @* Full result detail only shows once you stop scanning — a "scan session" (camera +
       compact feed only, distraction-free) followed by a "results session" (full detail,
       reviewed afterward) rather than the last result popping up mid-capture of the next card. *@
    @if (_scanResult != null && !_cameraStarted)
    {
        <div class="result-panel fade-in-panel">

            @if (_scanResult.ScryfallMatchResult != null)
            {
                var match = _scanResult.ScryfallMatchResult;
                var setIcon = _sets.FirstOrDefault(s => s.SetCode == match.SetCode)?.IconSvgUri;

                <div class="card-result card-result-compact">

                    <div class="card-details">

                        <div class="card-name-row">
                            @if (!string.IsNullOrEmpty(match.ImageUrl))
                            {
                                <img src="@match.ImageUrl" class="card-thumb" alt="@match.Name" />
                            }
                            <h2 class="card-name">
                                @match.Name
                            </h2>
                        </div>

                        <div class="set-line">
                            @if (!string.IsNullOrEmpty(setIcon))
                            {
                                <img src="@($"/api/set-icon/{match.SetCode}")" width="18" height="18" alt="@match.SetCode" />
                            }
                            @(match.SetName ?? match.SetCode?.ToUpperInvariant()) (@match.SetCode?.ToUpperInvariant())
                            ·
                            #@match.CollectorNumber
                        </div>

                        @if (match.IsAmbiguous)
                        {
                            <div class="alert alert-warning mt-1 mb-2 py-1 px-2 small">
                                ⚠️ Usikker udgave — flere printninger ser ens ud herfra. Tjek "Andre mulige udgaver" nedenfor.
                            </div>
                        }

                        <div class="price-hero">
                            @(match.EurPrice.HasValue ? $"€{match.EurPrice.Value:F2}" : "Ingen pris")
                        </div>

                        <div class="price-sub">
                            @if (match.UsdPrice.HasValue)
                            {
                                <span>$@match.UsdPrice.Value.ToString("F2") USD</span>
                            }
                            @if (match.EurFoilPrice.HasValue)
                            {
                                <span>· €@match.EurFoilPrice.Value.ToString("F2") Foil</span>
                            }
                        </div>

                        <button class="btn btn-outline-danger btn-sm mt-2" @onclick="() => _showWrongResultForm = !_showWrongResultForm">
                            🐛 Marker som forkert resultat
                        </button>

                        @if (_showWrongResultForm)
                        {
                            <div class="mt-2 p-2 border rounded">
                                <label class="form-label small">Hvad skulle kortet rigtigt have været? (valgfrit)</label>
                                <input class="form-control form-control-sm mb-2" @bind="_wrongResultNote" placeholder="F.eks. 'Skulle være Revised, ikke Unlimited'" />
                                <button class="btn btn-sm btn-danger" @onclick="SaveBadScan">Gem til test-data</button>
                                @if (_badScanSaved)
                                {
                                    <span class="text-success ms-2">✅ Gemt</span>
                                }
                            </div>
                        }

                    </div>

                </div>

                @if (_scanResult.OtherPrintings.Count > 0)
                {
                    <div class="mt-3">
                        <div class="fw-bold small text-muted mb-1">Andre mulige udgaver — tjek disse detaljer for at se forskel:</div>

                        @if (_scanResult.OtherPrintings.Any(a => OldFrameSets.Contains(a.SetCode)) || OldFrameSets.Contains(match.SetCode ?? ""))
                        {
                            <div class="alert alert-secondary small py-2 px-2 mb-2">
                                💡 <strong>Gamle udgaver kan ligne hinanden:</strong>
                                Alpha har <em>runde hjørner</em> (unikt for Alpha).
                                Sort ramme = Alpha/Beta/4th Ed. Foreign Black Border.
                                Hvid ramme = Unlimited/Revised/4th Edition/5th Edition.
                                Revised har <em>ingen</em> synlig copyright-årstal og intet under kunstner-linjen — 4th Edition har begge dele.
                            </div>
                        }

                        <ul class="list-group">
                            @foreach (var alt in _scanResult.OtherPrintings.Take(6))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>
                                        @(alt.SetName != "" ? alt.SetName : alt.SetCode.ToUpperInvariant())
                                        (@alt.SetCode.ToUpperInvariant())
                                        @if (!string.IsNullOrWhiteSpace(alt.ReleasedAt) && alt.ReleasedAt.Length >= 4)
                                        {
                                            <span class="text-muted">— udgivet @alt.ReleasedAt[..4]</span>
                                        }
                                        #@alt.CollectorNumber
                                    </span>
                                    <span>@(alt.EurPrice.HasValue ? $"€{alt.EurPrice.Value:F2}" : "Ingen pris")</span>
                                </li>
                            }
                        </ul>
                    </div>
                }

            }

        </div>
    }
    @if (_scanResult is { Failed: true } && !_cameraStarted)
    {
        <div class="alert alert-warning mt-3">
            <strong>⚠️ Ikke genkendt</strong>
            @if (!string.IsNullOrWhiteSpace(_scanResult.CardName))
            {
                <div>AI læste navnet som: <em>"@_scanResult.CardName"</em></div>
            }
            <div>@_scanResult.FailureReason</div>
        </div>
    }
</div>

@code {
    private sealed record ScanFeedItem(string Text, bool Success, CardScanContext? Result);

    private string? _detectedText;
    private bool _cameraStarted;
    private CardScanContext? _scanResult;
    private string? _selectedSetCode;
    private string _setSearch = "";
    private bool _noSetSymbol;
    private bool _disposed;

    // Cards captured but not yet matched/saved — the queue drains one at a time in the
    // background, but the user isn't blocked from capturing the next card while it does.
    private int _queuedCount;
    private int _completedCount;
    private readonly List<ScanFeedItem> _recentResults = [];
    private bool _showSetPicker;
    private string _ownerName = "";
    private string _ownerInput = "";
    private bool _showWrongResultForm;
    private string _wrongResultNote = "";
    private bool _badScanSaved;

    private bool _justCaptured;

    private async Task FlashCaptureConfirmation()
    {
        _justCaptured = true;
        StateHasChanged();
        await Task.Delay(1200);
        _justCaptured = false;
        StateHasChanged();
    }

    private static readonly HashSet<string> OldFrameSets =
        new(StringComparer.OrdinalIgnoreCase) { "lea", "leb", "2ed", "3ed", "4ed", "4bb" };

    // Unbounded so a fast scanning streak never silently drops a captured card — frame paths
    // are cheap to hold; the JPEGs themselves are already written to disk before enqueueing.
    private const int WorkerConcurrency = 3;
    private readonly Channel<string> _workChannel = Channel.CreateUnbounded<string>();

    // CardRepository is a single scoped EF Core context shared across this circuit -
    // concurrent workers must not call it at the same time (EF Core contexts aren't
    // thread-safe). The AI/Scryfall call itself (the slow part) still runs in parallel.
    private readonly SemaphoreSlim _dbWriteLock = new(1, 1);

    // Captured but not yet sent for processing — the user explicitly triggers
    // processing via "Behandl", rather than it starting invisibly per capture.
    private readonly List<string> _pendingFrames = [];

    private List<MagicSetSymbolDefinition> _sets = [];

    // No cap - a couple hundred small tiles in a scrollable grid is nothing,
    // and silently hiding sets past the 50th made large parts of the picker
    // effectively invisible (and unreachable without knowing to search for
    // the exact set name).
    private IEnumerable<MagicSetSymbolDefinition> FilteredSets =>
        string.IsNullOrWhiteSpace(_setSearch)
            ? _sets
            : _sets.Where(x =>
                x.SetName.Contains(_setSearch, StringComparison.OrdinalIgnoreCase) ||
                x.SetCode.Contains(_setSearch, StringComparison.OrdinalIgnoreCase));

    private bool NoSetSymbol
    {
        get => _noSetSymbol;
        set
        {
            _noSetSymbol = value;
            if (value) { _selectedSetCode = null; _setSearch = ""; }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _sets = (await MagicKnowledgeService.GetSetDefinitionsAsync())
            .OrderByDescending(x => x.SetCode)
            .ToList();

        try
        {
            _ownerName = await JS.InvokeAsync<string?>("localStorage.getItem", "magic_owner_name") ?? "";
        }
        catch { }

        // Multiple concurrent workers draining the same channel - a full batch submitted
        // via "Behandl" would otherwise process strictly one-at-a-time, making later cards
        // in the batch wait behind every earlier one instead of being handled in parallel.
        for (var i = 0; i < WorkerConcurrency; i++)
        {
            _ = RunWorkerAsync();
        }
    }

    private async Task SaveOwnerName()
    {
        if (string.IsNullOrWhiteSpace(_ownerInput)) return;
        _ownerName = _ownerInput.Trim();
        try { await JS.InvokeVoidAsync("localStorage.setItem", "magic_owner_name", _ownerName); } catch { }
    }

    private void ChangeOwnerName()
    {
        _ownerInput = _ownerName;
        _ownerName = "";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _workChannel.Writer.TryComplete();
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
    }

    private async Task StartCamera()
    {
        try
        {
            _cameraStarted = true;
            StateHasChanged();
            await Task.Delay(300);
            await JS.InvokeVoidAsync("webcam.start");
        }
        catch (Exception ex)
        {
            _cameraStarted = false;
            _detectedText = ex.Message;
        }
        StateHasChanged();
    }

    private async Task ChangeSet()
    {
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
        _cameraStarted = false;
        StateHasChanged();
    }

    private async Task StopAndShowResults()
    {
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
        _cameraStarted = false;
        StateHasChanged();
    }

    private async Task RunWorkerAsync()
    {
        await foreach (var framePath in _workChannel.Reader.ReadAllAsync())
        {
            if (_disposed) break;
            try
            {
                var setCode = NoSetSymbol ? null : _selectedSetCode;
                var result = await CardScanOrchestrator.ExecuteAsync(framePath, setCode, CancellationToken.None);

                if (!result.Failed && result.ScryfallMatchResult is { } match)
                {
                    await _dbWriteLock.WaitAsync();
                    try
                    {
                        await CardRepository.UpsertScannedAsync(new MagicCard
                        {
                            Id = Guid.NewGuid(),
                            Name = match.Name,
                            SetCode = match.SetCode ?? "",
                            CollectorNumber = match.CollectorNumber ?? "",
                            Owner = _ownerName,
                            ScryfallId = match.ScryfallId,
                            Quantity = 1,
                            EurPrice = match.EurPrice,
                            UsdPrice = match.UsdPrice,
                            FirstSeenAt = DateTime.UtcNow,
                            LastSeenAt = DateTime.UtcNow
                        });
                    }
                    finally
                    {
                        _dbWriteLock.Release();
                    }
                }

                await InvokeAsync(() =>
                {
                    _scanResult = result;
                    _queuedCount = Math.Max(0, _queuedCount - 1);

                    if (!result.Failed && result.ScryfallMatchResult is { } m)
                    {
                        _detectedText = null;
                        _completedCount++;
                        var price = m.EurPrice.HasValue ? $"€{m.EurPrice.Value:F2}" : "ingen pris fundet";
                        AddFeedItem($"✅ {m.Name} ({m.SetCode?.ToUpperInvariant()}) — {price}", success: true, result);
                    }
                    else if (result.Failed)
                    {
                        _detectedText = result.FailureReason;
                        AddFeedItem($"⚠️ Kunne ikke genkendes: {result.FailureReason}", success: false, null);
                    }

                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _queuedCount = Math.Max(0, _queuedCount - 1);
                    _detectedText = ex.Message;
                    AddFeedItem($"⚠️ Fejl under behandling: {ex.Message}", success: false, null);
                    StateHasChanged();
                });
            }
        }
    }

    private void SaveBadScan()
    {
        if (_scanResult is null) return;

        var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "bad-scans");
        Directory.CreateDirectory(folder);

        var id = Guid.NewGuid().ToString("N");

        var sourceImage = _scanResult.DetectedCardImagePath ?? _scanResult.ImagePath;
        if (File.Exists(sourceImage))
        {
            File.Copy(sourceImage, Path.Combine(folder, $"{id}.jpg"), overwrite: true);
        }

        var record = new
        {
            SavedAtUtc = DateTime.UtcNow,
            UserNote = _wrongResultNote,
            AiResult = _scanResult.AiResult,
            RequestedSetCode = _scanResult.SetCode,
            WrongMatch = _scanResult.ScryfallMatchResult,
            OtherPrintingsShown = _scanResult.OtherPrintings
        };

        var json = System.Text.Json.JsonSerializer.Serialize(record, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        File.WriteAllText(Path.Combine(folder, $"{id}.json"), json);

        _badScanSaved = true;
    }

    private void AddFeedItem(string text, bool success, CardScanContext? result)
    {
        // Uncapped - this list is the only place a whole session's worth of
        // scans is visible at once (see the "Denne session" summary panel
        // below), so silently dropping anything past the 10th card defeated
        // the point of that panel on any real scanning session.
        _recentResults.Insert(0, new ScanFeedItem(text, success, result));
    }

    private async Task SelectFeedItem(ScanFeedItem item)
    {
        if (item.Result is null) return;

        _scanResult = item.Result;

        // The detail panel only renders once the camera is stopped (by design - it
        // shouldn't pop up mid-scan) - so tapping a card while still scanning needs to
        // actually stop the camera too, otherwise the click visibly does nothing at all.
        if (_cameraStarted)
        {
            try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
            _cameraStarted = false;
        }

        StateHasChanged();
    }

    private async Task Capture(bool background = false)
    {
        if (_disposed) return;
        if (!background && (string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol))
        {
            _detectedText = "Vælg et sæt eller 'Kort uden sætsymbol'.";
            return;
        }
        if (!_cameraStarted) return;

        try
        {
            CameraCaptureResult capture;
            try { capture = await JS.InvokeAsync<CameraCaptureResult>("webcam.capture"); }
            catch (TaskCanceledException) { return; }

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(clean);
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "frames");
            Directory.CreateDirectory(folder);
            var framePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(framePath, bytes);

            _pendingFrames.Add(framePath);
            _ = FlashCaptureConfirmation();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (!background) { _detectedText = ex.Message; StateHasChanged(); }
        }
    }

    private void SendPendingFrames()
    {
        if (_pendingFrames.Count == 0) return;

        foreach (var path in _pendingFrames)
        {
            _workChannel.Writer.TryWrite(path);
            _queuedCount++;
        }

        _pendingFrames.Clear();
        StateHasChanged();
    }

    private sealed class CameraCaptureResult { public string Image { get; set; } = ""; }
}
