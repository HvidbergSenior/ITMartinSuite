@page "/scanner"

@using System.Threading.Channels
@using ITMartin.Magic.Application.Interfaces
@using ITMartin.Magic.Application.Models
@using ITMartin.Magic.Application.Workflows
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject ICardScanOrchestrator CardScanOrchestrator
@inject IMagicKnowledgeService MagicKnowledgeService
@implements IAsyncDisposable

<PageTitle>
    MTG Scanner
</PageTitle>

<div class="scanner-page">

    <div class="scanner-header">

        <div>

            <h1 class="scanner-title">
                MTG Scanner
            </h1>

            <div class="scanner-subtitle">
                AI powered printing detection
            </div>

        </div>

        <div class="ai-badge">
            GPT + OCR
        </div>

    </div>
    <div class="scanner-setup">

        <label class="form-label">
            Set Selection
        </label>

        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="radio"
                   name="setMode"
                   checked="@(!NoSetSymbol)"
                   @onchange="() => NoSetSymbol = false" />

            <label class="form-check-label">
                Select Set
            </label>
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input"
                   type="radio"
                   name="setMode"
                   checked="@NoSetSymbol"
                   @onchange="() => NoSetSymbol = true" />

            <label class="form-check-label">
                Card Has No Set Symbol
            </label>
        </div>

        @if (!NoSetSymbol)
        {
            <input class="form-control mb-2"
                   placeholder="Search set..."
                   @bind="_setSearch" />

            <select class="form-select"
                    @bind="_selectedSetCode">

                <option value="">
                    Select a set...
                </option>

                @foreach (var set in FilteredSets.Take(50))
                {
                    <option value="@set.SetCode">
                        @set.SetName (@set.SetCode.ToUpper())
                    </option>
                }

            </select>
        }
    </div>
    
    @if (NoSetSymbol)
    {
        <div class="alert alert-info mt-2">
            Scanning cards without set symbols.
        </div>
    }
    else if (string.IsNullOrWhiteSpace(_selectedSetCode))
    {
        <div class="alert alert-warning mt-2">
            Select a set before scanning.
        </div>
    }
    else
    {
        <div class="alert alert-success mt-2">
            Scanning set: @_selectedSetCode.ToUpperInvariant()
        </div>
    }
   
    <div class="scanner-wrapper">

        @if (!_cameraStarted)
        {
            <div class="camera-start-panel">

                <button @onclick="StartCamera"
                        disabled="@(
                                  string.IsNullOrWhiteSpace(_selectedSetCode)
                                  && !NoSetSymbol)">
                    Start Camera
                </button>

            </div>
        }
        else
        {
            <video id="video"
                   autoplay
                   muted
                   playsinline
                   webkit-playsinline
                   class="scanner-video">
            </video>

            <div class="scanner-guide">

                <div class="guide-text">
                    Align card inside frame
                </div>

            </div>
        }

        @if (_isProcessing)
        {
            <div class="scanner-overlay">

                <div class="scanner-loading">

                    <div class="spinner-border text-light">
                    </div>

                    <div class="mt-4 fw-bold">
                        @_detectedText
                    </div>

                </div>

            </div>
        }

    </div>

    <div class="scanner-buttons" style="gap:12px;">

        <button class="btn btn-success btn-lg scan-button"
                @onclick="() => Capture()"
                disabled="@(_isProcessing || _continuousMode || (string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol))">
            @(_isProcessing ? "Scanning..." : "Scan Card")
        </button>

        <button class="btn btn-lg @(_continuousMode ? "btn-danger" : "btn-warning") scan-button"
                @onclick="ToggleContinuous"
                disabled="@(string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol)">
            @(_continuousMode ? "Stop Auto" : "Auto Scan")
        </button>

    </div>

    @if (_sessionCards.Count > 0)
    {
        <div class="content-card mt-4 session-panel">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <div>
                    <strong>Session — @_sessionCards.Count card(s)</strong>
                    @if (_sessionTotal > 0)
                    {
                        <span class="session-total"> · €@_sessionTotal.ToString("F2") total</span>
                    }
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => { _sessionCards.Clear(); _sessionNames.Clear(); }">Clear</button>
            </div>
            <div class="session-list">
                @foreach (var c in _sessionCards)
                {
                    <div class="session-row">
                        <div class="session-name">@c.Name</div>
                        <div class="session-set">@c.SetCode?.ToUpperInvariant()</div>
                        <div class="session-price">@(c.EurPrice.HasValue ? $"€{c.EurPrice.Value:F2}" : "—")</div>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_detectedText))
    {
        <div class="alert alert-dark scanner-alert mt-4">

            @_detectedText

        </div>
    }

    @if (_scanResult != null)
    {
        <div class="result-panel">

            @if (_scanResult.ScryfallMatchResult != null)
            {
                var match = _scanResult.ScryfallMatchResult;
                var conf = _scanResult.IdentificationConfidence;
                var confClass = conf >= 0.8m ? "score-perfect" : conf >= 0.5m ? "score-good" : "score-weak";

                <div class="card-result">

                    <div class="image-panel">

                        <img src="@match.ImageUrl"
                             class="matched-card-image" />

                    </div>

                    <div class="card-details">

                        <div class="card-header">

                            <div>

                                <h2 class="card-name">
                                    @match.Name
                                </h2>

                                <div class="set-line">
                                    @match.SetCode?.ToUpperInvariant()
                                    ·
                                    #@match.CollectorNumber
                                </div>

                            </div>

                            <span class="score-badge @confClass">
                                @conf.ToString("P0")
                            </span>

                        </div>

                        <div class="price-hero">
                            @(match.EurPrice.HasValue ? $"€{match.EurPrice.Value:F2}" : "No price")
                        </div>

                        <div class="price-sub">
                            @if (match.UsdPrice.HasValue)
                            {
                                <span>$@match.UsdPrice.Value.ToString("F2") USD</span>
                            }
                            @if (match.EurFoilPrice.HasValue)
                            {
                                <span>· €@match.EurFoilPrice.Value.ToString("F2") Foil</span>
                            }
                        </div>

                    </div>

                </div>
            }
            @if (_scanResult.OtherPrintings.Any())
            {
                var maxEur = _scanResult.OtherPrintings.Max(p => p.EurPrice ?? 0);

                <div class="candidate-panel">

                    <h4 class="mb-3">
                        Other Editions
                    </h4>

                    @foreach (var printing in _scanResult.OtherPrintings)
                    {
                        var isHighest = (printing.EurPrice ?? 0) == maxEur && maxEur > 0;

                        <div class="candidate-row @(isHighest ? "candidate-row-highlight" : "")">

                            <img src="@printing.ImageUrl"
                                 class="candidate-image" />

                            <div class="candidate-details">

                                <div class="candidate-name">
                                    @(string.IsNullOrWhiteSpace(printing.SetName) ? printing.SetCode.ToUpperInvariant() : printing.SetName)
                                    @if (isHighest)
                                    {
                                        <span class="highest-badge">Highest</span>
                                    }
                                </div>

                                <div class="candidate-set">
                                    @printing.SetCode.ToUpperInvariant() · #@printing.CollectorNumber
                                </div>

                            </div>

                            <div class="candidate-confidence">

                                @if (printing.EurPrice.HasValue)
                                {
                                    <span>€@printing.EurPrice.Value.ToString("F2")</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }

                            </div>

                        </div>
                    }

                </div>
            }
            <div class="debug-panel">

                <h4 class="mb-3">
                    Workflow Steps
                </h4>

                <div class="debug-grid">

                    @foreach (var step in _scanResult.Steps)
                    {
                        <div class="debug-item">

                            <div class="debug-label">
                                @step.Name
                            </div>

                            <div class="debug-value">

                                @if (step.Success)
                                {
                                    <span>
                                        Success
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Failed
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_capturedImage) && (_scanResult == null || _scanResult.Failed))
    {
        <div class="mt-4">

            <h5>
                Captured Image
            </h5>

            <img src="@_capturedImage"
                 style="max-width:400px;
                    border-radius:12px;
                    border:2px solid #444;" />

        </div>
    }
</div>

@code {
    private string? _capturedImage;
    private string? _detectedText;
    private bool _isProcessing;
    private bool _cameraStarted;
    private CardScanContext? _scanResult;
    private string? _selectedSetCode;
    private string _setSearch = "";
    private bool _noSetSymbol;
    private bool _disposed;

    // Continuous scan
    private bool _continuousMode;
    private CancellationTokenSource? _continuousCts;
    private readonly Channel<string> _workChannel =
        Channel.CreateBounded<string>(new BoundedChannelOptions(4) { FullMode = BoundedChannelFullMode.DropOldest });

    // Session tracking
    private sealed record SessionCard(string Name, string? SetCode, decimal? EurPrice);
    private readonly List<SessionCard> _sessionCards = [];
    private readonly HashSet<string> _sessionNames = new(StringComparer.OrdinalIgnoreCase);
    private decimal _sessionTotal => _sessionCards.Sum(c => c.EurPrice ?? 0);

    private List<MagicSetSymbolDefinition> _sets = [];

    private IEnumerable<MagicSetSymbolDefinition> FilteredSets =>
        string.IsNullOrWhiteSpace(_setSearch)
            ? _sets.Take(50)
            : _sets.Where(x =>
                x.SetName.Contains(_setSearch, StringComparison.OrdinalIgnoreCase) ||
                x.SetCode.Contains(_setSearch, StringComparison.OrdinalIgnoreCase))
              .Take(50);

    private bool NoSetSymbol
    {
        get => _noSetSymbol;
        set
        {
            _noSetSymbol = value;
            if (value) { _selectedSetCode = null; _setSearch = ""; }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _sets = (await MagicKnowledgeService.GetSetDefinitionsAsync())
            .OrderByDescending(x => x.SetCode)
            .ToList();

        _ = RunWorkerAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _continuousCts?.Cancel();
        _workChannel.Writer.TryComplete();
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
    }

    private async Task StartCamera()
    {
        try
        {
            _cameraStarted = true;
            StateHasChanged();
            await Task.Delay(300);
            await JS.InvokeVoidAsync("webcam.start");
        }
        catch (Exception ex)
        {
            _cameraStarted = false;
            _detectedText = ex.Message;
        }
        StateHasChanged();
    }

    private async Task ToggleContinuous()
    {
        if (_continuousMode)
        {
            _continuousMode = false;
            _continuousCts?.Cancel();
            _detectedText = "Auto scan stopped.";
            StateHasChanged();
            return;
        }

        if (!_cameraStarted) await StartCamera();
        _continuousMode = true;
        _continuousCts = new CancellationTokenSource();
        _detectedText = "Auto scan running — point camera at cards...";
        StateHasChanged();
        _ = RunCaptureLoopAsync(_continuousCts.Token);
    }

    private async Task RunCaptureLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested && !_disposed)
        {
            await Capture(background: true);
            try { await Task.Delay(3500, ct); } catch (OperationCanceledException) { break; }
        }
    }

    private async Task RunWorkerAsync()
    {
        await foreach (var framePath in _workChannel.Reader.ReadAllAsync())
        {
            if (_disposed) break;
            try
            {
                var setCode = NoSetSymbol ? null : _selectedSetCode;
                var result = await CardScanOrchestrator.ExecuteAsync(framePath, setCode, CancellationToken.None);

                await InvokeAsync(() =>
                {
                    _scanResult = result;
                    _isProcessing = false;

                    if (!result.Failed && result.ScryfallMatchResult is { } match)
                    {
                        _detectedText = $"Scanned: {match.Name}";
                        if (_sessionNames.Add(match.Name))
                        {
                            _sessionCards.Insert(0, new SessionCard(match.Name, match.SetCode, match.EurPrice));
                            if (_sessionCards.Count > 50) _sessionCards.RemoveAt(_sessionCards.Count - 1);
                        }
                    }
                    else if (result.Failed)
                    {
                        _detectedText = result.FailureReason;
                    }

                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _isProcessing = false;
                    _detectedText = ex.Message;
                    StateHasChanged();
                });
            }
        }
    }

    private async Task Capture(bool background = false)
    {
        if (_disposed) return;
        if (!background && (string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol))
        {
            _detectedText = "Please select a set or choose 'No Set Symbol'.";
            return;
        }
        if (!_cameraStarted) return;

        try
        {
            if (!background) { _isProcessing = true; _scanResult = null; _detectedText = "Capturing..."; StateHasChanged(); }

            CameraCaptureResult capture;
            try { capture = await JS.InvokeAsync<CameraCaptureResult>("webcam.capture"); }
            catch (TaskCanceledException) { return; }

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(clean);
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "frames");
            Directory.CreateDirectory(folder);
            var framePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(framePath, bytes);

            if (!background) _capturedImage = $"data:image/jpeg;base64,{clean}";

            _workChannel.Writer.TryWrite(framePath);

            if (!background) { _isProcessing = true; StateHasChanged(); }
        }
        catch (Exception ex)
        {
            if (!background) { _isProcessing = false; _detectedText = ex.Message; StateHasChanged(); }
        }
    }

    private sealed class CameraCaptureResult { public string Image { get; set; } = ""; }
}