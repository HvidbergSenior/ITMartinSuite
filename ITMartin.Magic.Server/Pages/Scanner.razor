@page "/"
@page "/scanner"

@using System.Threading.Channels
@using ITMartin.Magic.Application.Interfaces
@using ITMartin.Magic.Application.Models
@using ITMartin.Magic.Application.Workflows
@using ITMartin.Magic.Domain.Entities
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject ICardScanOrchestrator CardScanOrchestrator
@inject IMagicKnowledgeService MagicKnowledgeService
@inject IMagicCardRepository CardRepository
@implements IAsyncDisposable

<PageTitle>Magic-kort · Scan</PageTitle>

@* Kolibri look (2026-11-13, user: "much prettier and wauw - look at the template and css and spacing"): k-cards in the ElPriser
   rhythm, numbered steps, no emojis, the cards you scanned shown as real card pictures with the price on top. *@
<div class="mg">

    <section class="k-card mg-hero" data-nofold>
        <div class="mg-hero-text">
            <h1 class="mg-title">Magic-kort</h1>
            <p class="mg-sub">Tag et billede af dine kort – så finder vi navn, sæt og pris.</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(_ownerName))
        {
            <div class="mg-owner">
                <span class="k-muted">Samling</span>
                <strong>@_ownerName</strong>
                <button class="k-btn k-btn-ghost k-btn-sm" @onclick="ChangeOwnerName">Skift</button>
            </div>
        }
    </section>

    @if (string.IsNullOrWhiteSpace(_ownerName))
    {
        <section class="k-card" data-nofold>
            <h2 class="k-card-title"><span class="mg-step">1</span> Hvem scanner?</h2>
            <p class="k-card-sub">Dine kort gemmes under dit navn, så din samling ikke blandes sammen med andres.</p>
            <div class="mg-inline">
                <input class="k-input" placeholder="Dit navn" @bind="_ownerInput" @bind:event="oninput" />
                <button class="k-btn k-btn-primary" @onclick="SaveOwnerName" disabled="@string.IsNullOrWhiteSpace(_ownerInput)">Gem</button>
            </div>
        </section>
    }

    @if (!_cameraStarted && _completedCount > 0 && !_showSetPicker)
    {
        var sessionTotal = _recentResults
            .Select(r => r.Result?.ScryfallMatchResult?.EurPrice)
            .Where(p => p.HasValue)
            .Sum(p => p!.Value);

        <section class="k-card mg-session" data-nofold>
            <div class="mg-session-head">
                <div>
                    <h2 class="k-card-title">Denne session</h2>
                    <p class="k-card-sub">@_completedCount kort gemt @(_queuedCount > 0 ? $"· {_queuedCount} behandles endnu" : "")</p>
                </div>
                @if (sessionTotal > 0)
                {
                    <div class="mg-total">
                        <span class="mg-total-label">Samlet værdi</span>
                        <span class="mg-total-value">€@sessionTotal.ToString("F2")</span>
                    </div>
                }
            </div>
            @if (_queuedCount > 0) { <div class="mg-progress"><span></span></div> }

            <div class="mg-cards">
                @foreach (var item in _recentResults)
                {
                    var m = item.Result?.ScryfallMatchResult;
                    <button type="button" class="mg-card @(item.Success ? "" : "mg-card-fail") @(item.Result == _scanResult ? "is-on" : "")"
                            @onclick="() => SelectFeedItem(item)" disabled="@(item.Result is null)">
                        @if (m is not null && !string.IsNullOrEmpty(m.ImageUrl))
                        {
                            <img src="@m.ImageUrl" alt="@m.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="mg-card-blank">Ikke genkendt</span>
                        }
                        @if (m is not null)
                        {
                            <span class="mg-card-price">@(m.EurPrice.HasValue ? $"€{m.EurPrice.Value:F2}" : "–")</span>
                        }
                        <span class="mg-card-name">@(m?.Name ?? item.Text)</span>
                    </button>
                }
            </div>

            <div class="mg-actions">
                <button class="k-btn k-btn-primary" @onclick="() => _showSetPicker = true">Tilføj flere kort</button>
            </div>
        </section>
    }
    else if (!_cameraStarted)
    {
        <section class="k-card" data-nofold>
            <h2 class="k-card-title"><span class="mg-step">@(string.IsNullOrWhiteSpace(_ownerName) ? "2" : "1")</span> Vælg sæt</h2>
            <p class="k-card-sub">Alle kort i en omgang skal være fra samme sæt. Gamle kort uden symbol: vælg Kort uden sætsymbol.</p>

            <div class="mg-seg" role="group" aria-label="Sæt">
                <button type="button" class="@(!NoSetSymbol ? "is-on" : "")" @onclick="() => NoSetSymbol = false">Vælg sæt</button>
                <button type="button" class="@(NoSetSymbol ? "is-on" : "")" @onclick="() => NoSetSymbol = true">Kort uden sætsymbol</button>
            </div>

            @if (!NoSetSymbol)
            {
                @if (_selectedSetCode != null)
                {
                    var sel = _sets.FirstOrDefault(s => s.SetCode == _selectedSetCode);
                    <div class="mg-chosen">
                        @if (!string.IsNullOrEmpty(sel?.IconSvgUri))
                        {
                            <img src="@($"/api/set-icon/{_selectedSetCode}")" width="32" height="32" alt="" />
                        }
                        <div class="mg-chosen-text">
                            <strong>@(sel?.SetName ?? _selectedSetCode)</strong>
                            <span class="k-muted">@_selectedSetCode.ToUpperInvariant()</span>
                        </div>
                        <button class="k-btn k-btn-ghost k-btn-sm" @onclick="() => _selectedSetCode = null">Skift</button>
                    </div>
                }
                else
                {
                    @* Dine sæt (user 2026-11-13: "hard to find the exact edition - maybe the already used"): the sets you scanned
                       before, newest first, so the next pile is one tap. *@
                    @if (_mySets.Count > 0 && string.IsNullOrWhiteSpace(_setSearch))
                    {
                        <div class="mg-mine-label">Dine sæt</div>
                        <div class="mg-sets mg-sets-mine">
                            @foreach (var set in _mySets)
                            {
                                <button type="button" class="mg-set mg-set-mine" @onclick="() => PickSet(set.SetCode)" title="@set.SetName">
                                    @if (!string.IsNullOrEmpty(set.IconSvgUri))
                                    {
                                        <img src="@($"/api/set-icon/{set.SetCode}")" width="24" height="24" alt="" loading="lazy" />
                                    }
                                    <span class="mg-set-code">@set.SetCode.ToUpper()</span>
                                    <span class="mg-set-name">@set.SetName</span>
                                </button>
                            }
                        </div>
                        <div class="mg-mine-label">Alle sæt</div>
                    }
                    <input class="k-input mg-search" placeholder="Søg sæt, fx Dominaria eller DOM" @bind="_setSearch" @bind:event="oninput" />
                    <div class="mg-sets">
                        @foreach (var set in FilteredSets)
                        {
                            <button type="button" class="mg-set" @onclick="() => PickSet(set.SetCode)" title="@set.SetName">
                                @if (!string.IsNullOrEmpty(set.IconSvgUri))
                                {
                                    <img src="@($"/api/set-icon/{set.SetCode}")" width="24" height="24" alt="" loading="lazy" />
                                }
                                <span class="mg-set-code">@set.SetCode.ToUpper()</span>
                                <span class="mg-set-name">@set.SetName</span>
                            </button>
                        }
                        @if (!FilteredSets.Any())
                        {
                            <p class="k-muted">Ingen sæt matcher søgningen.</p>
                        }
                    </div>
                }
            }
            else
            {
                <div class="mg-chosen"><div class="mg-chosen-text"><strong>Kort uden sætsymbol</strong>
                    <span class="k-muted">Alpha, Beta, Unlimited, Revised, 4th og 5th Edition</span></div></div>
            }
        </section>

        <section class="k-card" data-nofold>
            <h2 class="k-card-title"><span class="mg-step">@(string.IsNullOrWhiteSpace(_ownerName) ? "3" : "2")</span> Tilføj kort</h2>
            <p class="k-card-sub">Ét kort pr. billede, på et roligt underlag. De bliver genkendt og prissat med det samme.</p>

            @{ var ready = !string.IsNullOrWhiteSpace(_ownerName) && (!string.IsNullOrWhiteSpace(_selectedSetCode) || NoSetSymbol); }
            <div class="mg-ways">
                @* Upload (user 2026-11-13: "I want to use my regular camera and just upload like the other products"). *@
                <label class="mg-way mg-way-main @(ready && !_uploading ? "" : "is-off")">
                    <span class="mg-way-title">@(_uploading ? "Henter billeder..." : "Hent billeder")</span>
                    <span class="mg-way-text">Fra dit almindelige kamera eller billeder – højst @MaxUpload ad gangen</span>
                    <InputFile OnChange="UploadPhotos" multiple accept="image/*" class="mg-file" disabled="@(!ready || _uploading)" />
                </label>
                <button type="button" class="mg-way" @onclick="StartCamera" disabled="@(!ready)">
                    <span class="mg-way-title">Brug kameraet her</span>
                    <span class="mg-way-text">Scan ét kort ad gangen i siden</span>
                </button>
            </div>

            @if (string.IsNullOrWhiteSpace(_ownerName))
            {
                <p class="k-help">Skriv dit navn øverst og tryk Gem først.</p>
            }
            else if (string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol)
            {
                <p class="k-help">Vælg et sæt først.</p>
            }
            @if (_queuedCount > 0)
            {
                <div class="mg-progress"><span></span></div>
                <p class="k-help">@_queuedCount kort behandles...</p>
            }
            @if (!string.IsNullOrEmpty(_uploadMessage)) { <p class="k-help"><strong>@_uploadMessage</strong></p> }
            @if (!string.IsNullOrWhiteSpace(_cameraError)) { <div class="k-alert k-alert-danger">@_cameraError</div> }
        </section>
    }
    else
    {
        <section class="k-card mg-cam" data-nofold>
            <div class="mg-chosen">
                <div class="mg-chosen-text">
                    <span class="k-muted">Sæt</span>
                    @if (NoSetSymbol)
                    {
                        <strong>Uden sætsymbol</strong>
                    }
                    else
                    {
                        var sel = _sets.FirstOrDefault(s => s.SetCode == _selectedSetCode);
                        <strong>@(sel?.SetName ?? _selectedSetCode) <span class="k-muted">@_selectedSetCode?.ToUpperInvariant()</span></strong>
                    }
                </div>
                <button class="k-btn k-btn-ghost k-btn-sm" @onclick="ChangeSet">Skift sæt</button>
            </div>

            <div class="scanner-wrapper">
                <video id="video" autoplay muted playsinline webkit-playsinline class="scanner-video"></video>
                <div class="scanner-guide"><div class="guide-text">Placer kortet inden for rammen</div></div>
                @if (_justCaptured) { <div class="capture-flash">Taget – klar til næste kort</div> }
            </div>

            @if (!string.IsNullOrWhiteSpace(_detectedText) && !_justCaptured)
            {
                <div class="k-alert k-alert-danger">@_detectedText</div>
            }

            <div class="mg-cam-buttons">
                <button class="k-btn k-btn-primary mg-shoot @(_justCaptured ? "is-flash" : "")" @onclick="() => Capture()"
                        disabled="@(!_cameraStarted || (string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol))">
                    @(_justCaptured ? "Taget" : "Scan kort")
                    @if (_pendingFrames.Count > 0) { <span class="mg-badge">@_pendingFrames.Count</span> }
                </button>
                @if (_pendingFrames.Count > 0)
                {
                    <button class="k-btn" @onclick="SendPendingFrames">Behandl @_pendingFrames.Count kort</button>
                }
                @if (_completedCount > 0 || _queuedCount > 0)
                {
                    <button class="k-btn k-btn-ghost" @onclick="StopAndShowResults">Se resultater (@_completedCount)</button>
                }
            </div>
            @if (_queuedCount > 0) { <div class="mg-progress"><span></span></div> }

            @if (_recentResults.Count > 0)
            {
                <ul class="k-list mg-feed">
                    @foreach (var item in _recentResults.Take(6))
                    {
                        var m = item.Result?.ScryfallMatchResult;
                        <li class="@(item.Success ? "" : "mg-feed-fail")">
                            <span class="k-dot"></span>
                            <span class="mg-feed-name">@(m?.Name ?? item.Text)</span>
                            @if (m is not null) { <span class="mg-feed-price">@(m.EurPrice.HasValue ? $"€{m.EurPrice.Value:F2}" : "–")</span> }
                        </li>
                    }
                </ul>
            }
        </section>
    }

    @* Full detail only once you stop scanning, so the last result never pops up mid-capture of the next card. *@
    @if (_scanResult?.ScryfallMatchResult is { } match && !_cameraStarted)
    {
        var setIcon = _sets.FirstOrDefault(s => s.SetCode == match.SetCode)?.IconSvgUri;
        <section class="k-card mg-detail" data-nofold>
            @if (!string.IsNullOrEmpty(match.ImageUrl))
            {
                <img class="mg-detail-img" src="@match.ImageUrl" alt="@match.Name" />
            }
            <div class="mg-detail-body">
                <h2 class="mg-detail-name">@match.Name</h2>
                <div class="mg-detail-set">
                    @if (!string.IsNullOrEmpty(setIcon)) { <img src="@($"/api/set-icon/{match.SetCode}")" width="20" height="20" alt="" /> }
                    @(match.SetName ?? match.SetCode?.ToUpperInvariant()) · @match.SetCode?.ToUpperInvariant() · nr. @match.CollectorNumber
                </div>
                <div class="mg-price">@(match.EurPrice.HasValue ? $"€{match.EurPrice.Value:F2}" : "Ingen pris")</div>
                <div class="k-row mg-price-sub">
                    @if (match.UsdPrice.HasValue) { <span class="k-tag">$@match.UsdPrice.Value.ToString("F2") USD</span> }
                    @if (match.EurFoilPrice.HasValue) { <span class="k-tag">€@match.EurFoilPrice.Value.ToString("F2") foil</span> }
                    <span class="k-muted">Cardmarket via Scryfall</span>
                </div>

                @if (match.IsAmbiguous)
                {
                    <div class="k-alert k-alert-warn">Usikker udgave – flere printninger ser ens ud. Tjek Andre mulige udgaver herunder.</div>
                }

                <button class="k-btn k-btn-ghost k-btn-sm k-mt" @onclick="() => _showWrongResultForm = !_showWrongResultForm">Forkert kort?</button>
                @if (_showWrongResultForm)
                {
                    <label class="k-label">Hvad skulle kortet have været? (valgfrit)</label>
                    <input class="k-input" @bind="_wrongResultNote" placeholder="Fx Skulle være Revised, ikke Unlimited" />
                    <div class="k-row k-mt">
                        <button class="k-btn k-btn-sm" @onclick="SaveBadScan">Gem til test</button>
                        @if (_badScanSaved) { <span class="k-tag">Gemt</span> }
                    </div>
                }
            </div>
        </section>

        @if (_scanResult.OtherPrintings.Count > 0)
        {
            <section class="k-card">
                <h2 class="k-card-title">Andre mulige udgaver</h2>
                <p class="k-card-sub">Tjek detaljerne på kortet for at se forskel.</p>
                @if (_scanResult.OtherPrintings.Any(a => OldFrameSets.Contains(a.SetCode)) || OldFrameSets.Contains(match.SetCode ?? ""))
                {
                    <div class="k-alert k-alert-info">
                        <strong>Gamle udgaver ligner hinanden.</strong> Alpha har runde hjørner. Sort ramme = Alpha, Beta, 4th Ed. Foreign Black Border.
                        Hvid ramme = Unlimited, Revised, 4th og 5th Edition. Revised har intet copyright-årstal – 4th Edition har.
                    </div>
                }
                <ul class="k-list">
                    @foreach (var alt in _scanResult.OtherPrintings.Take(6))
                    {
                        <li>
                            <span class="mg-feed-name">
                                @(alt.SetName != "" ? alt.SetName : alt.SetCode.ToUpperInvariant())
                                <span class="k-muted">@alt.SetCode.ToUpperInvariant()@(alt.ReleasedAt is { Length: >= 4 } r ? $" · {r[..4]}" : "") · nr. @alt.CollectorNumber</span>
                            </span>
                            <span class="mg-feed-price">@(alt.EurPrice.HasValue ? $"€{alt.EurPrice.Value:F2}" : "–")</span>
                        </li>
                    }
                </ul>
            </section>
        }
    }
    @if (_scanResult is { Failed: true } && !_cameraStarted)
    {
        <div class="k-alert k-alert-warn">
            <strong>Ikke genkendt.</strong>
            @if (!string.IsNullOrWhiteSpace(_scanResult.CardName)) { <span>Navnet blev læst som "@_scanResult.CardName".</span> }
            <div>@_scanResult.FailureReason</div>
        </div>
    }
</div>

@code {
    private sealed record ScanFeedItem(string Text, bool Success, CardScanContext? Result);

    private string? _detectedText;
    private string? _cameraError;
    private bool _cameraStarted;
    private CardScanContext? _scanResult;
    private string? _selectedSetCode;
    private string _setSearch = "";
    private bool _noSetSymbol;
    private bool _disposed;

    // Cards captured but not yet matched/saved — the queue drains one at a time in the
    // background, but the user isn't blocked from capturing the next card while it does.
    private int _queuedCount;
    private int _completedCount;
    private readonly List<ScanFeedItem> _recentResults = [];
    private bool _showSetPicker;
    private string _ownerName = "";
    private string _ownerInput = "";
    private bool _showWrongResultForm;
    private string _wrongResultNote = "";
    private bool _badScanSaved;

    private bool _justCaptured;

    private async Task FlashCaptureConfirmation()
    {
        _justCaptured = true;
        StateHasChanged();
        await Task.Delay(1200);
        _justCaptured = false;
        StateHasChanged();
    }

    private static readonly HashSet<string> OldFrameSets =
        new(StringComparer.OrdinalIgnoreCase) { "lea", "leb", "2ed", "3ed", "4ed", "4bb" };

    // Unbounded so a fast scanning streak never silently drops a captured card — frame paths
    // are cheap to hold; the JPEGs themselves are already written to disk before enqueueing.
    private const int WorkerConcurrency = 3;
    private readonly Channel<string> _workChannel = Channel.CreateUnbounded<string>();

    // CardRepository is a single scoped EF Core context shared across this circuit -
    // concurrent workers must not call it at the same time (EF Core contexts aren't
    // thread-safe). The AI/Scryfall call itself (the slow part) still runs in parallel.
    private readonly SemaphoreSlim _dbWriteLock = new(1, 1);

    // Captured but not yet sent for processing — the user explicitly triggers
    // processing via "Behandl", rather than it starting invisibly per capture.
    private readonly List<string> _pendingFrames = [];

    private List<MagicSetSymbolDefinition> _sets = [];

    // No cap - a couple hundred small tiles in a scrollable grid is nothing,
    // and silently hiding sets past the 50th made large parts of the picker
    // effectively invisible (and unreachable without knowing to search for
    // the exact set name).
    private IEnumerable<MagicSetSymbolDefinition> FilteredSets =>
        string.IsNullOrWhiteSpace(_setSearch)
            ? _sets
            : _sets.Where(x =>
                x.SetName.Contains(_setSearch, StringComparison.OrdinalIgnoreCase) ||
                x.SetCode.Contains(_setSearch, StringComparison.OrdinalIgnoreCase));

    private bool NoSetSymbol
    {
        get => _noSetSymbol;
        set
        {
            _noSetSymbol = value;
            if (value) { _selectedSetCode = null; _setSearch = ""; }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _sets = (await MagicKnowledgeService.GetSetDefinitionsAsync())
            .OrderBy(x => x.SetName, StringComparer.CurrentCultureIgnoreCase)   // A-Å by name: easier to find than by code
            .ToList();

        try
        {
            _ownerName = await JS.InvokeAsync<string?>("localStorage.getItem", "magic_owner_name") ?? "";
        }
        catch { }
        await LoadMySetsAsync();

        // Multiple concurrent workers draining the same channel - a full batch submitted
        // via "Behandl" would otherwise process strictly one-at-a-time, making later cards
        // in the batch wait behind every earlier one instead of being handled in parallel.
        for (var i = 0; i < WorkerConcurrency; i++)
        {
            _ = RunWorkerAsync();
        }
    }

    private async Task SaveOwnerName()
    {
        if (string.IsNullOrWhiteSpace(_ownerInput)) return;
        _ownerName = _ownerInput.Trim();
        await LoadMySetsAsync();
        try { await JS.InvokeVoidAsync("localStorage.setItem", "magic_owner_name", _ownerName); } catch { }
    }

    private List<MagicSetSymbolDefinition> _mySets = [];

    // The owner's sets from the cards already saved, last scanned first (max 8), so the next pile is one tap.
    private async Task LoadMySetsAsync()
    {
        if (string.IsNullOrWhiteSpace(_ownerName)) { _mySets = []; return; }
        IEnumerable<MagicCard> cards;
        await _dbWriteLock.WaitAsync();   // the same EF context as the scan workers
        try { cards = await CardRepository.GetByOwnerAsync(_ownerName); }
        catch { return; }
        finally { _dbWriteLock.Release(); }
        var byCode = _sets.ToDictionary(s => s.SetCode, StringComparer.OrdinalIgnoreCase);
        _mySets = cards.GroupBy(c => c.SetCode, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Max(c => c.LastSeenAt))
            .Select(g => byCode.GetValueOrDefault(g.Key))
            .Where(s => s is not null).Select(s => s!).Take(8).ToList();
    }

    private void PickSet(string code)
    {
        _selectedSetCode = code;
        _setSearch = "";
        var set = _sets.FirstOrDefault(s => string.Equals(s.SetCode, code, StringComparison.OrdinalIgnoreCase));
        if (set is null) return;
        _mySets.RemoveAll(s => s.SetCode == set.SetCode);
        _mySets.Insert(0, set);
        if (_mySets.Count > 8) _mySets.RemoveAt(8);
    }

    private void ChangeOwnerName()
    {
        _ownerInput = _ownerName;
        _ownerName = "";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _workChannel.Writer.TryComplete();
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
    }

    private async Task StartCamera()
    {
        try
        {
            _cameraError = null;
            _showSetPicker = false;
            _cameraStarted = true;
            StateHasChanged();
            await Task.Delay(300);
            await JS.InvokeVoidAsync("webcam.start");
        }
        catch (Exception ex)
        {
            _cameraStarted = false;
            _cameraError = DescribeCameraError(ex.Message);
        }
        StateHasChanged();
    }

    private static string DescribeCameraError(string message)
    {
        if (message.Contains("NotAllowedError") || message.Contains("SecurityError"))
            return "Browseren har ikke lov til at bruge kameraet. Tryk på låsen/ikonet ved adresselinjen, tillad Kamera, og prøv igen.";
        if (message.Contains("NotFoundError") || message.Contains("OverconstrainedError"))
            return "Der blev ikke fundet noget kamera på enheden.";
        if (message.Contains("NotReadableError") || message.Contains("AbortError"))
            return "Kameraet er i brug af en anden app eller fane. Luk den og prøv igen.";
        return "Kameraet kunne ikke starte: " + message;
    }

    private async Task ChangeSet()
    {
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
        _cameraStarted = false;
        StateHasChanged();
    }

    private async Task StopAndShowResults()
    {
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
        _cameraStarted = false;
        StateHasChanged();
    }

    private async Task RunWorkerAsync()
    {
        await foreach (var framePath in _workChannel.Reader.ReadAllAsync())
        {
            if (_disposed) break;
            try
            {
                var setCode = NoSetSymbol ? null : _selectedSetCode;
                var result = await CardScanOrchestrator.ExecuteAsync(framePath, setCode, CancellationToken.None);

                if (!result.Failed && result.ScryfallMatchResult is { } match)
                {
                    await _dbWriteLock.WaitAsync();
                    try
                    {
                        await CardRepository.UpsertScannedAsync(new MagicCard
                        {
                            Id = Guid.NewGuid(),
                            Name = match.Name,
                            SetCode = match.SetCode ?? "",
                            CollectorNumber = match.CollectorNumber ?? "",
                            Owner = _ownerName,
                            ScryfallId = match.ScryfallId,
                            Quantity = 1,
                            EurPrice = match.EurPrice,
                            UsdPrice = match.UsdPrice,
                            FirstSeenAt = DateTime.UtcNow,
                            LastSeenAt = DateTime.UtcNow
                        });
                    }
                    finally
                    {
                        _dbWriteLock.Release();
                    }
                }

                await InvokeAsync(() =>
                {
                    _scanResult = result;
                    _queuedCount = Math.Max(0, _queuedCount - 1);

                    if (!result.Failed && result.ScryfallMatchResult is { } m)
                    {
                        _detectedText = null;
                        _completedCount++;
                        var price = m.EurPrice.HasValue ? $"€{m.EurPrice.Value:F2}" : "ingen pris fundet";
                        AddFeedItem($"{m.Name} ({m.SetCode?.ToUpperInvariant()}) — {price}", success: true, result);
                    }
                    else if (result.Failed)
                    {
                        _detectedText = result.FailureReason;
                        AddFeedItem($"Ikke genkendt: {result.FailureReason}", success: false, null);
                    }

                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _queuedCount = Math.Max(0, _queuedCount - 1);
                    _detectedText = ex.Message;
                    AddFeedItem($"Fejl: {ex.Message}", success: false, null);
                    StateHasChanged();
                });
            }
        }
    }

    private void SaveBadScan()
    {
        if (_scanResult is null) return;

        var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "bad-scans");
        Directory.CreateDirectory(folder);

        var id = Guid.NewGuid().ToString("N");

        var sourceImage = _scanResult.DetectedCardImagePath ?? _scanResult.ImagePath;
        if (File.Exists(sourceImage))
        {
            File.Copy(sourceImage, Path.Combine(folder, $"{id}.jpg"), overwrite: true);
        }

        var record = new
        {
            SavedAtUtc = DateTime.UtcNow,
            UserNote = _wrongResultNote,
            AiResult = _scanResult.AiResult,
            RequestedSetCode = _scanResult.SetCode,
            WrongMatch = _scanResult.ScryfallMatchResult,
            OtherPrintingsShown = _scanResult.OtherPrintings
        };

        var json = System.Text.Json.JsonSerializer.Serialize(record, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        File.WriteAllText(Path.Combine(folder, $"{id}.json"), json);

        _badScanSaved = true;
    }

    private void AddFeedItem(string text, bool success, CardScanContext? result)
    {
        // Uncapped - this list is the only place a whole session's worth of
        // scans is visible at once (see the "Denne session" summary panel
        // below), so silently dropping anything past the 10th card defeated
        // the point of that panel on any real scanning session.
        _recentResults.Insert(0, new ScanFeedItem(text, success, result));
    }

    private async Task SelectFeedItem(ScanFeedItem item)
    {
        if (item.Result is null) return;

        _scanResult = item.Result;

        // The detail panel only renders once the camera is stopped (by design - it
        // shouldn't pop up mid-scan) - so tapping a card while still scanning needs to
        // actually stop the camera too, otherwise the click visibly does nothing at all.
        if (_cameraStarted)
        {
            try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
            _cameraStarted = false;
        }

        StateHasChanged();
    }

    private async Task Capture(bool background = false)
    {
        if (_disposed) return;
        if (!background && (string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol))
        {
            _detectedText = "Vælg et sæt eller 'Kort uden sætsymbol'.";
            return;
        }
        if (!_cameraStarted) return;

        try
        {
            CameraCaptureResult capture;
            try { capture = await JS.InvokeAsync<CameraCaptureResult>("webcam.capture"); }
            catch (TaskCanceledException) { return; }

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(clean);
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "frames");
            Directory.CreateDirectory(folder);
            var framePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(framePath, bytes);

            _pendingFrames.Add(framePath);
            _ = FlashCaptureConfirmation();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (!background) { _detectedText = ex.Message; StateHasChanged(); }
        }
    }

    private void SendPendingFrames()
    {
        if (_pendingFrames.Count == 0) return;

        foreach (var path in _pendingFrames)
        {
            _workChannel.Writer.TryWrite(path);
            _queuedCount++;
        }

        _pendingFrames.Clear();
        StateHasChanged();
    }

    // Hard cap per upload: each card is one recognition call, so a big gallery pick must not run up the AI bill.
    private const int MaxUpload = 50;
    private bool _uploading;
    private string _uploadMessage = "";

    private async Task UploadPhotos(InputFileChangeEventArgs e)
    {
        if (_disposed || string.IsNullOrWhiteSpace(_ownerName) || (string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol)) return;
        _uploading = true;
        _showSetPicker = false;
        _uploadMessage = "";
        StateHasChanged();
        var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "frames");
        Directory.CreateDirectory(folder);
        int added = 0, failed = 0;
        var files = e.GetMultipleFiles(MaxUpload + 1000);
        foreach (var file in files.Take(MaxUpload))
        {
            try
            {
                // The browser turns the photo upright and makes it small (a phone photo is 3-5 MB) before it is sent.
                var small = await file.RequestImageFileAsync("image/jpeg", 1600, 1600);
                var framePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
                await using (var read = small.OpenReadStream(15 * 1024 * 1024))
                await using (var write = File.Create(framePath))
                    await read.CopyToAsync(write);
                _workChannel.Writer.TryWrite(framePath);
                _queuedCount++;
                added++;
            }
            catch { failed++; }
        }
        _uploading = false;
        _uploadMessage = $"{added} billeder sendt til genkendelse."
            + (failed > 0 ? $" {failed} kunne ikke hentes." : "")
            + (files.Count > MaxUpload ? $" Kun de første {MaxUpload} – tag resten bagefter." : "");
        StateHasChanged();
    }

    private sealed class CameraCaptureResult { public string Image { get; set; } = ""; }
}
