@page "/"
@page "/scanner"

@using System.Threading.Channels
@using ITMartin.Magic.Application.Interfaces
@using ITMartin.Magic.Application.Models
@using ITMartin.Magic.Application.Workflows
@using ITMartin.Magic.Domain.Entities
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject ICardScanOrchestrator CardScanOrchestrator
@inject IMagicKnowledgeService MagicKnowledgeService
@inject IMagicCardRepository CardRepository
@implements IAsyncDisposable

<PageTitle>MTG Scanner</PageTitle>

@if (!_cameraStarted)
{
    <div class="scanner-page">

        <div class="scanner-setup">

            <label class="form-label">Vælg sæt</label>

            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="setMode"
                       checked="@(!NoSetSymbol)" @onchange="() => NoSetSymbol = false" />
                <label class="form-check-label">Vælg sæt</label>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="setMode"
                       checked="@NoSetSymbol" @onchange="() => NoSetSymbol = true" />
                <label class="form-check-label">Kort uden sætsymbol</label>
            </div>

            @if (!NoSetSymbol)
            {
                <input class="form-control mb-3" placeholder="Søg sæt..."
                       @bind="_setSearch" @bind:event="oninput" />

                @if (_selectedSetCode != null)
                {
                    var sel = _sets.FirstOrDefault(s => s.SetCode == _selectedSetCode);
                    <div class="selected-set-display">
                        @if (!string.IsNullOrEmpty(sel?.IconSvgUri))
                        {
                            <img src="@sel.IconSvgUri" class="selected-set-icon" width="28" height="28" alt="@_selectedSetCode" />
                        }
                        <div class="selected-set-text">
                            <div class="selected-set-name">@_selectedSetName</div>
                            <div class="selected-set-code">@_selectedSetCode.ToUpperInvariant()</div>
                        </div>
                        <button class="selected-set-clear" @onclick="() => _selectedSetCode = null">✕</button>
                    </div>
                }

                <div class="set-icon-grid">
                    @foreach (var set in FilteredSets)
                    {
                        <div class="set-tile @(set.SetCode == _selectedSetCode ? "set-tile-selected" : "")"
                             @onclick="() => _selectedSetCode = set.SetCode"
                             title="@set.SetName">
                            @if (!string.IsNullOrEmpty(set.IconSvgUri))
                            {
                                <img src="@set.IconSvgUri" class="set-tile-icon" width="22" height="22" alt="@set.SetCode" />
                            }
                            <div class="set-tile-code">@set.SetCode.ToUpper()</div>
                        </div>
                    }
                </div>
            }

            <button class="btn btn-primary mt-4 w-100"
                    @onclick="StartCamera"
                    disabled="@(string.IsNullOrWhiteSpace(_selectedSetCode) && !NoSetSymbol)">
                Start kamera
            </button>

        </div>

        @if (_sessionCards.Count > 0)
        {
            <div class="session-list mt-4">
                <div class="session-header">Seneste session — @_sessionCards.Count kort</div>
                @foreach (var entry in _sessionCards)
                {
                    <div class="session-row @(entry.Failed ? "session-row-failed" : "")">
                        <div class="session-info">
                            <div class="session-name">@(entry.Failed ? "Ikke genkendt" : entry.Name)</div>
                            <div class="session-meta">
                                @if (entry.Failed)
                                {
                                    @entry.Error
                                }
                                else
                                {
                                    @($"{entry.SetCode.ToUpperInvariant()} · #{entry.CollectorNumber}")
                                }
                            </div>
                        </div>
                        <div class="session-price">@(entry.EurPrice.HasValue ? $"€{entry.EurPrice.Value:F2}" : "—")</div>
                    </div>
                }
            </div>
        }

    </div>
}
else
{
    <div class="scanner-page scanning-mode">

        <div class="set-bar">
            <div class="set-bar-info">
                <div class="set-bar-label">Sæt</div>
                <div class="set-bar-name">
                    @if (NoSetSymbol)
                    {
                        <span>Uden sætsymbol</span>
                    }
                    else
                    {
                        <span>@_selectedSetName <span class="set-bar-code">(@_selectedSetCode?.ToUpperInvariant())</span></span>
                    }
                </div>
            </div>
            <button class="set-bar-change" @onclick="ChangeSet">Skift sæt</button>
        </div>

        <div class="scanner-wrapper">
            <video id="video" autoplay muted playsinline webkit-playsinline class="scanner-video"></video>
            <div class="scanner-guide">
                <div class="guide-text">Placer kort inden for rammen</div>
            </div>
        </div>

        <div class="scanner-buttons">
            <button class="btn btn-lg scan-button @(_isCapturing ? "scan-button-busy" : "")"
                    @onclick="Capture" disabled="@(_isCapturing)">
                @if (_isCapturing)
                {
                    <span class="processing-spinner me-2"></span>
                    <span>Fanger...</span>
                }
                else
                {
                    <span>Scan kort</span>
                    @if (_pendingFrames.Count > 0)
                    {
                        <span class="scan-badge">@_pendingFrames.Count</span>
                    }
                }
            </button>

            @if (_pendingFrames.Count > 0 || _pendingCount > 0)
            {
                <button class="btn btn-lg send-button @(_pendingFrames.Count == 0 ? "send-button-busy" : "")"
                        @onclick="SendFrames" disabled="@(_pendingFrames.Count == 0)">
                    @if (_pendingCount > 0 && _pendingFrames.Count == 0)
                    {
                        <span class="processing-spinner me-2"></span>
                        <span>Behandler @_pendingCount...</span>
                    }
                    else
                    {
                        <span>Send @_pendingFrames.Count kort</span>
                    }
                </button>
            }
        </div>

        @if (_sessionCards.Count > 0)
        {
            <div class="results-list">
                <div class="results-header">Denne session — @_sessionCards.Count kort</div>
                @foreach (var (entry, idx) in _sessionCards.Select((e, i) => (e, i)))
                {
                    <div class="result-card @(entry.Failed ? "result-card-failed" : "result-card-ok") @(idx == 0 ? "result-card-latest" : "")">
                        @if (entry.Failed)
                        {
                            <div class="result-status-icon fail">✕</div>
                            <div class="result-info">
                                <div class="result-name result-name-fail">Ikke genkendt</div>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(entry.ImageUrl))
                            {
                                <img src="@entry.ImageUrl" class="result-thumb" alt="@entry.Name" />
                            }
                            <div class="result-info">
                                <div class="result-name">@entry.Name</div>
                                <div class="result-set">@entry.SetCode.ToUpperInvariant() · #@entry.CollectorNumber</div>
                                <div class="result-pricing">
                                    <span class="result-eur">@(entry.EurPrice.HasValue ? $"€{entry.EurPrice.Value:F2}" : "—")</span>
                                    @if (entry.UsdPrice.HasValue)
                                    {
                                        <span class="result-usd">/ $@entry.UsdPrice.Value.ToString("F2")</span>
                                    }
                                    @if (entry.EurFoilPrice.HasValue)
                                    {
                                        <span class="result-foil">foil €@entry.EurFoilPrice.Value.ToString("F2")</span>
                                    }
                                </div>
                                @if (idx == 0 && entry.OtherPrintings?.Count > 0)
                                {
                                    <div class="result-other-printings">
                                        <span class="result-other-label">Andre udgaver (@entry.OtherPrintings.Count):</span>
                                        @foreach (var p in entry.OtherPrintings.Take(5))
                                        {
                                            <span class="result-other-item">@p.SetCode.ToUpperInvariant() @(p.EurPrice.HasValue ? $"€{p.EurPrice.Value:F2}" : "—")</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

    </div>
}

@code {
    private bool _cameraStarted;
    private string? _selectedSetCode;
    private string _setSearch = "";
    private bool _noSetSymbol;
    private bool _disposed;
    private int _pendingCount;
    private bool _isCapturing;
    private readonly List<string> _pendingFrames = [];

    private record SessionEntry(
        string Name,
        string SetCode,
        string CollectorNumber,
        decimal? EurPrice,
        decimal? EurFoilPrice = null,
        decimal? UsdPrice = null,
        decimal? UsdFoilPrice = null,
        string? ImageUrl = null,
        List<CardCandidateViewModel>? OtherPrintings = null,
        bool Failed = false,
        string? Error = null);
    private readonly List<SessionEntry> _sessionCards = [];

    private readonly Channel<(string Path, string? SetCode)> _workChannel =
        Channel.CreateBounded<(string, string?)>(new BoundedChannelOptions(20) { FullMode = BoundedChannelFullMode.DropOldest });

    private List<MagicSetSymbolDefinition> _sets = [];

    private string _selectedSetName =>
        _sets.FirstOrDefault(s => s.SetCode == _selectedSetCode)?.SetName ?? _selectedSetCode ?? "";

    private IEnumerable<MagicSetSymbolDefinition> FilteredSets =>
        string.IsNullOrWhiteSpace(_setSearch)
            ? _sets
            : _sets.Where(x =>
                x.SetName.Contains(_setSearch, StringComparison.OrdinalIgnoreCase) ||
                x.SetCode.Contains(_setSearch, StringComparison.OrdinalIgnoreCase));

    private bool NoSetSymbol
    {
        get => _noSetSymbol;
        set
        {
            _noSetSymbol = value;
            if (value) { _selectedSetCode = null; _setSearch = ""; }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _sets = (await MagicKnowledgeService.GetSetDefinitionsAsync())
            .OrderBy(x => x.SetCode)
            .ToList();

        _ = RunWorkerAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _workChannel.Writer.TryComplete();
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
    }

    private async Task StartCamera()
    {
        try
        {
            _cameraStarted = true;
            StateHasChanged();
            await Task.Delay(300);
            await JS.InvokeVoidAsync("webcam.start");
        }
        catch (Exception ex)
        {
            _cameraStarted = false;
            _sessionCards.Insert(0, new SessionEntry("", "", "", null, Failed: true, Error: ex.Message));
        }
        StateHasChanged();
    }

    private async Task ChangeSet()
    {
        try { await JS.InvokeVoidAsync("webcam.stop"); } catch { }
        _cameraStarted = false;
        StateHasChanged();
    }

    private async Task RunWorkerAsync()
    {
        await foreach (var (framePath, setCode) in _workChannel.Reader.ReadAllAsync())
        {
            if (_disposed) break;
            try
            {
                var result = await CardScanOrchestrator.ExecuteAsync(framePath, setCode, CancellationToken.None);

                if (!result.Failed && result.ScryfallMatchResult is { } match)
                {
                    await CardRepository.UpsertScannedAsync(new MagicCard
                    {
                        Id = Guid.NewGuid(),
                        Name = match.Name,
                        SetCode = match.SetCode ?? "",
                        CollectorNumber = match.CollectorNumber ?? "",
                        ScryfallId = match.ScryfallId,
                        Quantity = 1,
                        EurPrice = match.EurPrice,
                        UsdPrice = match.UsdPrice,
                        FirstSeenAt = DateTime.UtcNow,
                        LastSeenAt = DateTime.UtcNow
                    });
                }

                await InvokeAsync(() =>
                {
                    _pendingCount = Math.Max(0, _pendingCount - 1);

                    if (!result.Failed && result.ScryfallMatchResult is { } m)
                        _sessionCards.Insert(0, new SessionEntry(
                            m.Name,
                            m.SetCode ?? "",
                            m.CollectorNumber ?? "",
                            m.EurPrice,
                            m.EurFoilPrice,
                            m.UsdPrice,
                            m.UsdFoilPrice,
                            m.ImageUrl,
                            result.OtherPrintings));
                    else
                        _sessionCards.Insert(0, new SessionEntry("", "", "", null, Failed: true, Error: result.FailureReason ?? "Ikke genkendt"));

                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _pendingCount = Math.Max(0, _pendingCount - 1);
                    _sessionCards.Insert(0, new SessionEntry("", "", "", null, Failed: true, Error: ex.Message));
                    StateHasChanged();
                });
            }
        }
    }

    private async Task Capture()
    {
        if (_disposed || !_cameraStarted || _isCapturing) return;
        _isCapturing = true;
        StateHasChanged();

        try
        {
            CameraCaptureResult capture;
            try { capture = await JS.InvokeAsync<CameraCaptureResult>("webcam.capture"); }
            catch (TaskCanceledException) { return; }

            var clean = capture.Image.Replace("data:image/jpeg;base64,", "");
            var bytes = Convert.FromBase64String(clean);
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "data", "frames");
            Directory.CreateDirectory(folder);
            var framePath = Path.Combine(folder, $"{Guid.NewGuid()}.jpg");
            await File.WriteAllBytesAsync(framePath, bytes);

            _pendingFrames.Add(framePath);
        }
        catch (Exception ex)
        {
            _sessionCards.Insert(0, new SessionEntry("", "", "", null, Failed: true, Error: ex.Message));
        }
        finally
        {
            _isCapturing = false;
            StateHasChanged();
        }
    }

    private void SendFrames()
    {
        if (_pendingFrames.Count == 0) return;
        var setCode = NoSetSymbol ? null : _selectedSetCode;
        foreach (var path in _pendingFrames)
        {
            _workChannel.Writer.TryWrite((path, setCode));
            _pendingCount++;
        }
        _pendingFrames.Clear();
        StateHasChanged();
    }

    private sealed class CameraCaptureResult { public string Image { get; set; } = ""; }
}
