@page "/collection"

@using ITMartin.Magic.Application.Interfaces
@using ITMartin.Magic.Domain.Entities

@inject IMagicCardRepository CardRepository
@inject NavigationManager Navigation

<PageTitle>My Collection</PageTitle>

<div class="scanner-page">

    <div class="scanner-header">
        <div>
            <h1 class="scanner-title">My Collection</h1>
            <div class="scanner-subtitle">All scanned cards</div>
        </div>
        <a href="/scanner" class="btn btn-success">Scan Cards</a>
    </div>

    @if (_cards is null)
    {
        <div class="text-muted">Loading...</div>
    }
    else
    {
        <div class="collection-stats">
            <div class="col-stat">
                <div class="col-stat-value">@_cards.Count</div>
                <div class="col-stat-label">Unique Cards</div>
            </div>
            <div class="col-stat">
                <div class="col-stat-value">@_cards.Sum(c => c.Quantity)</div>
                <div class="col-stat-label">Total Copies</div>
            </div>
            <div class="col-stat highlight">
                <div class="col-stat-value">€@_totalValue.ToString("F2")</div>
                <div class="col-stat-label">Collection Value</div>
            </div>
        </div>

        <div class="content-card mt-4" style="padding:12px 16px; display:flex; gap:10px;">
            <input class="inv-search" style="flex:1;"
                   type="search" placeholder="Search name or set..."
                   @bind="_search" @bind:event="oninput" />
            <select class="inv-sort" @bind="_sortBy">
                <option value="value">Highest value</option>
                <option value="name">Name A–Z</option>
                <option value="qty">Most copies</option>
                <option value="recent">Recently scanned</option>
            </select>
        </div>

        @if (_filtered.Any())
        {
            <div class="col-list mt-3">
                @foreach (var card in _filtered)
                {
                    <div class="col-row">
                        <div class="col-info">
                            <div class="col-name">@card.Name</div>
                            <div class="col-meta">
                                @card.SetCode.ToUpperInvariant()
                                · #@card.CollectorNumber
                                · ×@card.Quantity
                                · Last: @card.LastSeenAt.ToLocalTime().ToString("dd MMM yyyy")
                            </div>
                        </div>
                        <div class="col-prices">
                            @if (card.EurPrice.HasValue)
                            {
                                <div class="col-price-eur">€@card.EurPrice.Value.ToString("F2")</div>
                                <div class="col-price-total">×@card.Quantity = €@((card.EurPrice.Value * card.Quantity).ToString("F2"))</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="content-card mt-3" style="text-align:center; padding:40px;">
                <div style="font-size:48px; margin-bottom:12px;">🃏</div>
                <div class="text-muted">@(_cards.Any() ? "No cards match." : "No cards scanned yet.")</div>
            </div>
        }
    }

</div>

<style>
    .collection-stats {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
        margin-bottom: 8px;
    }

    .col-stat {
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 14px;
        padding: 16px;
        text-align: center;
    }

    .col-stat.highlight {
        border-color: rgba(74,222,128,.4);
        background: rgba(74,222,128,.06);
    }

    .col-stat-value {
        font-size: 26px;
        font-weight: 900;
        color: white;
    }

    .col-stat.highlight .col-stat-value { color: #4ade80; }

    .col-stat-label {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 4px;
    }

    .col-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .col-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 12px;
        padding: 12px 16px;
        gap: 12px;
    }

    .col-info { flex: 1; min-width: 0; }

    .col-name {
        font-weight: 600;
        font-size: 15px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .col-meta {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 3px;
    }

    .col-prices { text-align: right; white-space: nowrap; }

    .col-price-eur {
        font-size: 16px;
        font-weight: 700;
        color: #4ade80;
    }

    .col-price-total {
        font-size: 11px;
        color: #94a3b8;
        margin-top: 2px;
    }

    .inv-search {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 10px;
        padding: 10px 14px;
        color: white;
        font-size: 15px;
        outline: none;
    }

    .inv-sort {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 8px;
        padding: 6px 10px;
        color: white;
        font-size: 13px;
        outline: none;
        cursor: pointer;
    }
</style>

@code {
    private List<MagicCard>? _cards;
    private string _search = "";
    private string _sortBy = "value";

    private decimal _totalValue => (_cards ?? []).Sum(c => (c.EurPrice ?? 0) * c.Quantity);

    private IEnumerable<MagicCard> _filtered
    {
        get
        {
            var q = (_cards ?? []).AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
                q = q.Where(c =>
                    c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    c.SetCode.Contains(_search, StringComparison.OrdinalIgnoreCase));

            return _sortBy switch
            {
                "name"   => q.OrderBy(c => c.Name),
                "qty"    => q.OrderByDescending(c => c.Quantity),
                "recent" => q.OrderByDescending(c => c.LastSeenAt),
                _        => q.OrderByDescending(c => (c.EurPrice ?? 0) * c.Quantity)
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _cards = (await CardRepository.GetAllAsync()).ToList();
    }
}
