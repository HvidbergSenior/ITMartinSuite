@page "/knowledge/set/{SetCode}"

@using ITMartin.Magic.Domain.Entities
@using ITMartin.Magic.Application.Interfaces

@inject IMagicKnowledgeService KnowledgeService
@inject NavigationManager Navigation

<PageTitle>
    Set Knowledge
</PageTitle>

@if (_set is null)
{
    <div>Loading...</div>
}
else
{
    <div class="stack">

        <div>

            <h1 class="page-title">
                @_set.SetName
            </h1>

            <div class="meta">
                @_set.SetCode.ToUpperInvariant()
            </div>

        </div>

        <div class="knowledge-editor">

            <div class="knowledge-section">

                <div class="knowledge-section-title">
                    Symbol Knowledge
                </div>

                <div class="knowledge-grid">

                    <div class="knowledge-field knowledge-full">

                        <label>
                            Symbol Description
                        </label>

                        <textarea
                            rows="4"
                            @bind="_set.SymbolDescription">
                        </textarea>

                    </div>

                    <div class="knowledge-field">

                        <label>
                            Symbol Shape
                        </label>

                        <input
                            @bind="_set.SymbolShape" />

                    </div>

                    <div class="knowledge-field">

                        <label>
                            Symbol Color
                        </label>

                        <input
                            @bind="_set.SymbolColor" />

                    </div>

                    <div class="knowledge-field knowledge-full">

                        <label>
                            Symbol Keywords
                        </label>

                        <input
                            @bind="_set.SymbolKeywords" />

                    </div>

                </div>

            </div>

            <div class="knowledge-section">

                <div class="knowledge-section-title">
                    Frame & Copyright
                </div>

                <div class="knowledge-grid">

                    <div class="knowledge-field">

                        <label>
                            Frame Style
                        </label>

                        <input
                            @bind="_set.FrameStyle" />

                    </div>

                    <div class="knowledge-field">

                        <label>
                            Copyright Year
                        </label>

                        <input
                            type="number"
                            @bind="_set.CopyrightYear" />

                    </div>

                    <div class="knowledge-field knowledge-full">

                        <label>
                            Copyright Style
                        </label>

                        <input
                            @bind="_set.CopyrightStyle" />

                    </div>

                </div>

            </div>

            <div class="knowledge-section">

                <div class="knowledge-section-title">
                    Printing Characteristics
                </div>

                <div class="knowledge-checkbox-grid">

                    <div class="knowledge-checkbox">

                        <input
                            type="checkbox"
                            @bind="_set.HasSetSymbol" />

                        <label>
                            Has Set Symbol
                        </label>

                    </div>

                    <div class="knowledge-checkbox">

                        <input
                            type="checkbox"
                            @bind="_set.HasCollectorNumbers" />

                        <label>
                            Has Collector Numbers
                        </label>

                    </div>

                    <div class="knowledge-checkbox">

                        <input
                            type="checkbox"
                            @bind="_set.HasFoils" />

                        <label>
                            Has Foils
                        </label>

                    </div>

                    <div class="knowledge-checkbox">

                        <input
                            type="checkbox"
                            @bind="_set.UsesOldFrame" />

                        <label>
                            Uses Old Frame
                        </label>

                    </div>

                    <div class="knowledge-checkbox">

                        <input
                            type="checkbox"
                            @bind="_set.UsesWhiteBorder" />

                        <label>
                            Uses White Border
                        </label>

                    </div>

                    <div class="knowledge-checkbox">

                        <input
                            type="checkbox"
                            @bind="_set.UsesBlackBorder" />

                        <label>
                            Uses Black Border
                        </label>

                    </div>

                </div>

            </div>

            <div class="knowledge-save">

                <button class="btn btn-success"
                        @onclick="Save">
                    Save Knowledge
                </button>

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public string SetCode { get; set; } = "";

    private MagicSetKnowledge? _set;

    protected override async Task OnInitializedAsync()
    {
        _set =
            await KnowledgeService
                .GetAsync(SetCode);
    }

    private async Task Save()
    {
        if (_set is null)
        {
            return;
        }

        await KnowledgeService
            .UpdateAsync(_set);

        Navigation.NavigateTo(
            "/knowledge");
    }
}