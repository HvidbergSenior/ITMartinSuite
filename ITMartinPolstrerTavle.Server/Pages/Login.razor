@page "/login"
@layout EmptyLayout

<PageTitle>Log ind – Værkstedstavle</PageTitle>

<div class="login-wrap">
    <div class="login-box">
        <div class="login-icon">🪑</div>
        <div class="login-title">Værkstedstavle</div>
        @if (Error == "1")
        {
            <div class="login-error">Forkert PIN – prøv igen</div>
        }
        <form method="post" action="/api/auth/login">
            <input type="password" name="pin" class="login-field" placeholder="PIN-kode" autofocus maxlength="30" />
            <button type="submit" class="btn btn-primary btn-block">Log ind</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
