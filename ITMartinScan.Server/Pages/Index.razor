@page "/"
@using ITMartin.Ai.Interfaces
@using ITMartin.Ai.Models
@inject IJSRuntime JS
@inject IShelfScanService ShelfScan
@implements IAsyncDisposable

<PageTitle>Dagligvare Scanner</PageTitle>

<div style="padding:10px 12px 0;">
    <ProblemPurposeBanner
        Problem="At scanne og digitalisere dokumenter kræver normalt separat software eller en fysisk scanner-app."
        Formaal="Scan direkte fra telefonen eller browseren, klar til brug med det samme." />
</div>

<video id="cam" autoplay playsinline style="width:100%;height:50vh;object-fit:cover;display:block;background:#111;"></video>

<div style="padding:12px;display:flex;flex-direction:column;gap:10px;">

    @if (_analyzing)
    {
        <div style="text-align:center;padding:20px;color:#fff;font-size:16px;font-weight:600;">
            ⏳ Analyserer @_pendingImages.Count hylde(r)…
        </div>
    }
    else
    {
        <div style="display:flex;gap:10px;">
            <button onclick="@CaptureShelf" style="flex:1;padding:16px;background:#2563eb;color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;">
                📷 Hylde @(_pendingImages.Count + 1)
            </button>
            @if (_pendingImages.Count > 0)
            {
                <button onclick="@AnalyzeShelves" style="flex:1;padding:16px;background:#16a34a;color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;">
                    ✅ Analyser @_pendingImages.Count
                </button>
            }
        </div>

        @if (_pendingImages.Count > 0)
        {
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                @for (var i = 0; i < _pendingImages.Count; i++)
                {
                    <span style="background:rgba(34,197,94,.2);border:1px solid rgba(34,197,94,.4);color:#4ade80;border-radius:20px;padding:3px 10px;font-size:12px;font-weight:600;">Hylde @(i+1) ✓</span>
                }
            </div>
        }
    }

    <div style="text-align:center;">
        <a href="/magnifier" style="color:#475569;font-size:13px;text-decoration:none;">🔍 Forstørrelsesglas</a>
    </div>

    @if (_error != null)
    {
        <div style="background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.3);border-radius:10px;padding:10px;color:#f87171;font-size:14px;">@_error</div>
    }

    @if (_groups.Count > 0)
    {
        <button onclick="@Reset" style="padding:12px;background:rgba(255,255,255,.1);color:#94a3b8;border:1px solid rgba(255,255,255,.15);border-radius:12px;font-size:14px;font-weight:600;cursor:pointer;">
            🔄 Ny scanning
        </button>

        <input type="search" placeholder="🔍 Søg produkt…" @bind="_search" @bind:event="oninput"
               style="width:100%;padding:11px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:12px;color:#fff;font-size:15px;outline:none;" />

        @foreach (var group in _filteredGroups)
        {
            <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#64748b;margin-top:8px;margin-bottom:4px;">
                @group.Category <span style="background:rgba(255,255,255,.08);border-radius:8px;padding:1px 6px;color:#94a3b8;">@group.Products.Count</span>
            </div>
            @foreach (var p in group.Products)
            {
                <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);border-radius:10px;padding:10px 13px;margin-bottom:5px;">
                    <div style="font-size:15px;font-weight:600;color:#f1f5f9;line-height:1.3;">@p.Name</div>
                    @if (!string.IsNullOrEmpty(p.Manufacturer))
                    {
                        <div style="font-size:12px;color:#64748b;margin-top:2px;">@p.Manufacturer</div>
                    }
                </div>
            }
        }
    }

</div>

<footer style="text-align:center;padding:.6rem 1rem;font-size:.72rem;color:#64748b;border-top:1px solid rgba(255,255,255,.06)"><a href="https://all-apps.itmartin.dk/vilkaar" target="_blank" style="color:#64748b;text-decoration:underline">Vilkår &amp; Privatlivspolitik</a> · &copy; @DateTime.Now.Year ITMartin - Den digitale kolibri</footer>

@code {
    private bool _analyzing;
    private string? _error;
    private string _search = "";
    private List<string> _pendingImages = [];
    private List<ProductGroup> _groups = [];

    private record ProductGroup(string Category, List<ShelfScanProduct> Products);

    private IEnumerable<ProductGroup> _filteredGroups
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search)) return _groups;
            return _groups
                .Select(g => new ProductGroup(g.Category, g.Products
                    .Where(p =>
                        p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                        (p.Manufacturer ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                        p.Category.Contains(_search, StringComparison.OrdinalIgnoreCase))

                    .ToList()))
                .Where(g => g.Products.Count > 0);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("scan.startCamera", "cam");
    }

    private async Task CaptureShelf()
    {
        _error = null;
        try
        {
            var base64 = await JS.InvokeAsync<string>("scan.capture", "cam");
            _pendingImages.Add(base64);
            await JS.InvokeVoidAsync("scan.flash");
        }
        catch (Exception ex) { _error = ex.Message; }
        StateHasChanged();
    }

    private async Task AnalyzeShelves()
    {
        if (_pendingImages.Count == 0) return;
        _analyzing = true;
        _error = null;
        _groups = [];
        StateHasChanged();
        try
        {
            var result = await ShelfScan.AnalyzeAsync([.._pendingImages]);
            _groups = result.Products
                .GroupBy(p => p.Category)
                .OrderBy(g => g.Key)
                .Select(g => new ProductGroup(g.Key, g.OrderBy(p => p.Name).ToList()))
                .ToList();
            _pendingImages.Clear();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _analyzing = false; StateHasChanged(); }
    }

    private void Reset()
    {
        _pendingImages = [];
        _groups = [];
        _search = "";
        _error = null;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("scan.stopCamera"); } catch { }
    }
}
