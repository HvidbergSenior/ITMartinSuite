@page "/magnifier"
@inject IJSRuntime JS
@implements IAsyncDisposable

<div style="position:fixed;inset:0;background:#000;overflow:hidden;">

    <div id="mag-wrap" style="position:absolute;inset:0;transform-origin:center center;">
        <video id="mag" autoplay playsinline style="width:100%;height:100%;object-fit:cover;display:block;"></video>
        <canvas id="mag-freeze" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none;"></canvas>
    </div>

    <div style="position:fixed;top:16px;right:16px;background:rgba(0,0,0,.6);color:#fff;border-radius:20px;padding:5px 14px;font-size:15px;font-weight:800;">
        @_zoom.ToString("F1")×
    </div>

    <a href="/" style="position:fixed;top:12px;left:12px;background:rgba(0,0,0,.6);color:#fff;border-radius:20px;padding:8px 16px;font-size:14px;font-weight:700;text-decoration:none;">
        ← Tilbage
    </a>

    <div style="position:fixed;bottom:0;left:0;right:0;padding-top:16px;padding-bottom:max(24px,env(safe-area-inset-bottom,24px));background:linear-gradient(transparent,rgba(0,0,0,.75));display:flex;justify-content:center;align-items:center;gap:20px;">

        <button @onclick="ZoomOut" disabled="@(_zoom <= 1)"
                style="width:72px;height:72px;border-radius:50%;background:rgba(255,255,255,.15);border:2px solid rgba(255,255,255,.25);color:#fff;font-size:32px;font-weight:700;cursor:pointer;opacity:@(_zoom <= 1 ? "0.35" : "1");">
            −
        </button>

        <button @onclick="ToggleFreeze"
                style="width:84px;height:84px;border-radius:50%;background:@(_frozen ? "#e11d48" : "rgba(255,255,255,.92)");border:3px solid rgba(255,255,255,.5);color:@(_frozen ? "#fff" : "#111");font-size:26px;cursor:pointer;">
            @(_frozen ? "▶" : "⏸")
        </button>

        <button @onclick="ZoomIn" disabled="@(_zoom >= 6)"
                style="width:72px;height:72px;border-radius:50%;background:rgba(255,255,255,.15);border:2px solid rgba(255,255,255,.25);color:#fff;font-size:32px;font-weight:700;cursor:pointer;opacity:@(_zoom >= 6 ? "0.35" : "1");">
            +
        </button>

    </div>
</div>

@code {
    private double _zoom = 1.0;
    private bool _frozen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("scan.startCamera", "mag");
    }

    private async Task ZoomIn()
    {
        _zoom = Math.Min(6.0, Math.Round(_zoom + 0.5, 1));
        await JS.InvokeVoidAsync("scan.setZoom", "mag-wrap", _zoom);
    }

    private async Task ZoomOut()
    {
        _zoom = Math.Max(1.0, Math.Round(_zoom - 0.5, 1));
        await JS.InvokeVoidAsync("scan.setZoom", "mag-wrap", _zoom);
    }

    private async Task ToggleFreeze()
    {
        _frozen = !_frozen;
        if (_frozen)
            await JS.InvokeVoidAsync("scan.freezeFrame", "mag", "mag-freeze");
        else
            await JS.InvokeVoidAsync("scan.resumeCamera", "mag", "mag-freeze");
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("scan.stopCamera"); } catch { }
    }
}
