@page "/g/{slug}/docs"
@rendermode InteractiveServer
@inject ClubDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ClubBroadcastService Broadcast
@inject ClubAuthService ClubAuth
@implements IDisposable

@if (!_loaded)
{
    <div class="club-loading">Indlæser...</div>
}
else if (_member == null)
{
    <div class="club-loading">Omdirigerer...</div>
}
else
{
    <div class="club-page">
        <ClubNav Slug="@Slug" GroupName="@_group!.Name" MemberLabel="@_member.Name" Active="history" />

        <div class="doc-body">
            @if (!_hasMainTasks)
            {
                <a class="link-card" href="/g/@Slug/opponents" style="margin-bottom:14px">🕵️ Modstandere - se eller tag folk I har mødt</a>
            }

            <div class="doc-toolbar"><h2 class="doc-title">🎬 Seneste resuméer</h2></div>
            @if (_recentRecaps.Count > 0)
            {
                @foreach (var recap in _recentRecaps)
                {
                    <div class="recap-box @(recap.Kind == "Practice" ? "practice" : "")">
                        <div class="recap-kind">@(recap.Kind == "Practice" ? "🎯 Til øvelse" : "🎬 Sjov version")</div>
                        <div class="recap-text">@recap.Text</div>
                        <div class="recap-meta">@recap.CreatedAt.ToLocalTime().ToString("d. MMM HH:mm")</div>
                    </div>
                }
            }
            else
            {
                <div class="doc-empty">Ingen resuméer endnu.</div>
            }
        </div>
    </div>
}

<style>
    .doc-body { padding: 16px; }
    .doc-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .doc-title { font-size: 18px; font-weight: 800; margin: 0; color: var(--text); }
    .doc-empty { text-align: center; color: var(--muted); padding: 60px 0; font-size: 15px; }

    .recap-box { background: rgba(168,85,247,.08); border: 1px solid rgba(168,85,247,.25); border-radius: 14px; padding: 16px; margin-bottom: 12px; }
    .recap-box.practice { background: rgba(14,165,233,.08); border-color: rgba(14,165,233,.25); }
    .recap-kind { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin-bottom: 6px; }
    .recap-text { font-size: 14px; line-height: 1.6; white-space: pre-wrap; color: var(--text); }
    .recap-meta { font-size: 11px; color: var(--muted); margin-top: 10px; }
</style>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Member? _member;
    private Group? _group;
    private bool _loaded;
    private List<SessionRecap> _recentRecaps = [];
    private bool _hasMainTasks;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var session = await ClubAuth.ResolveSessionAsync(JS, Db, Slug);
        if (session is null) { Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true); return; }

        _member = session.Member;
        _group = session.Member.Group;
        _hasMainTasks = await Db.MainTasks.AnyAsync(m => m.GroupId == _group.Id);
        await RefreshAsync();
        Broadcast.Subscribe(_group.Id, OnBroadcast);
        _loaded = true;

        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        _recentRecaps = await Db.SessionRecaps
            .Where(r => r.GroupId == _group!.Id)
            .OrderByDescending(r => r.CreatedAt)
            .Take(5)
            .ToListAsync();
    }

    private void OnBroadcast() => InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
    public void Dispose() { if (_group != null) Broadcast.Unsubscribe(_group.Id, OnBroadcast); }
}
