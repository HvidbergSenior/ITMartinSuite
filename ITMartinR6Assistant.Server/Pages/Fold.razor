@inject SessionStateService Session
@inject CoachService Coach
@implements IDisposable

@* A card that can be shown/hidden by tapping its header (user: "everything, cards, boxes etc should be possible to
   show/hide"). Native <details>, so it works without a server round-trip; wwwroot/js/fold.js remembers each card's
   open/closed state per device under its Key. Blazor only renders "open" as the default, so a re-render never undoes
   what the user chose.
   Coach mode: the coach's open/closed state is shared (per phase) and everyone else follows it - the native toggle
   is blocked and "open" comes from the session. @key recreates the element when the mode flips. *@
@* Owner choice (user 2026-11-11): boxes the owner switched off are not rendered for the others; the owner sees every
   box with a "Vises for andre / Skjult for andre" button in the header. *@
@if (!Coach.CanSee(Key))
{
}
else if (PhaseScreen && Coach.Synced)
{
    <details @key="true" class="fold @Class" data-fold-sync="1" open="@(Session.GetShown(Key) ?? Open)">
        <summary class="fold-head @(Coach.IsCoach ? "" : "fold-locked")" @onclick="CoachToggle" @onclick:preventDefault="true">@Title@ShareButton</summary>
        <div class="fold-body">@ChildContent</div>
    </details>
}
else
{
    <details @key="false" class="fold @Class" data-fold="@Key" open="@Open">
        <summary class="fold-head">@Title@ShareButton</summary>
        <div class="fold-body">@ChildContent</div>
    </details>
}

@code {
    private RenderFragment ShareButton => __builder =>
    {
        if (Coach.IsOwner)
        {
            var on = Session.IsSectionOn(Key);
            <button type="button" class="share-btn @(on ? "share-btn-on" : "")" title="Vælg om de andre spillere kan se boksen"
                    @onclick="() => Session.ToggleSection(Key)" @onclick:preventDefault="true" @onclick:stopPropagation="true">@(on ? "Vises for andre" : "Skjult for andre")</button>
        }
    };

    protected override void OnInitialized() => Session.OnStateChanged += OnChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Coach.EnsureLoadedAsync();
        StateHasChanged();
    }
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Session.OnStateChanged -= OnChanged;

    [Parameter, EditorRequired] public string Key { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool Open { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    // Set by the Kamp page only - stats pages (/maps, /operatorer ...) stay free for everyone.
    [CascadingParameter(Name = "PhaseScreen")] public bool PhaseScreen { get; set; }

    private void CoachToggle()
    {
        if (Coach.IsCoach) Session.SetShown(Key, !(Session.GetShown(Key) ?? Open));
    }
}
