@page "/"
@layout R6AssistantLayout
@inject RecommendationService RecommendationService
@inject NavigationManager NavigationManager

<div class="stack">

    <div>
        <h1>
            Maps
        </h1>

        <div class="text-muted">
            Select a map
        </div>
    </div>

    @if (_loading)
    {
        <div class="content-card" style="text-align:center;padding:40px 20px;">
            <div style="font-size:32px;margin-bottom:10px;">⏳</div>
            <div>Loading maps…</div>
        </div>
    }
    else
    {
        <div class="grid grid-3">

            @foreach (var map in _maps)
            {
                <button class="card btn-secondary"
                        @onclick="() => GoToMap(map)">

                    <h2>
                        @map
                    </h2>

                </button>
            }

        </div>
    }

</div>

@code {

    private List<string> _maps = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _maps = await RecommendationService.GetMaps();
        _loading = false;
    }

    private void GoToMap(string map)
    {
        NavigationManager.NavigateTo($"/map/{map}");
    }

}