@page "/"
@layout R6AssistantLayout
@inject SessionStateService Session
@inject IR6DataService DataService
@inject SettingsGuideService Guide
@inject PlayerIdentityService Identity
@inject PreGameCheckService PreGameCheck
@implements IDisposable
@using System.Text.Json
@using ITMartinR6Assistant.Domain
@using ITMartinR6Assistant.Server.Services

@* One page, no phases (user 2026-10-13: the phase flow was too complicated after testing). Every box can be shown/hidden
   by everyone (Fold remembers it per device), and everything is clickable for all - no coach lock.
   Order: map-ban (pro vs us) -> chosen map: bans + good ops, per site -> our stats from replays -> last match -> loadouts -> PC. *@
<div class="phase-page kamp-page">

    <div class="kamp-intro">Vælg map, se bans og gode operatører for map og site, og få jeres egen statistik fra Siege's replay-filer. Tryk på en overskrift for at vise eller skjule boksen.</div>

    @if (_gameData is not null)
    {

        @* While the match runs the map is what matters (user 2026-10-13): first box, open, big inline viewer. *@
        var liveMap = _gameData.Maps.FirstOrDefault(m => m.Name == Session.Map);
        if (liveMap is not null)
        {
            var liveSite = liveMap.Sites.FirstOrDefault(s => s.Name == Session.Site);
            <Fold Key="k-kort" Title="@($"Kort: {liveMap.Name}{(liveSite is null ? "" : " · " + liveSite.Name)}")" Class="opban-card">
                <div class="site-chips">
                    @foreach (var s in liveMap.Sites)
                    {
                        var siteName = s.Name;
                        <button class="site-chip @(Session.Site == siteName ? "site-chip-on" : "")" @onclick="() => Session.SetSite(siteName)">@siteName <span class="muted small">@s.Floor</span></button>
                    }
                </div>
                <div class="clear-map">
                    @if (!_confirmClear)
                    {
                        <button class="site-chip" @onclick="() => _confirmClear = true">Ryd map (ny kamp)</button>
                    }
                    else
                    {
                        <span class="small">Ryd map, site og bannede maps for hele holdet? Statistikken bliver liggende.</span>
                        <button class="site-chip site-chip-on" @onclick="ClearMap">Ja, ryd</button>
                        <button class="site-chip" @onclick="() => _confirmClear = false">Nej</button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(liveMap.BlueprintSlug)) { <MapViewer Map="liveMap" Site="liveSite" Inline="true" /> }
                else { <div class="small muted">Der er ingen plantegning for @liveMap.Name.</div> }
                @if (liveSite is { Note.Length: > 0 }) { <div class="info-box site-rule">@liveSite.Note</div> }
            </Fold>
        }

        @if (Session.Map is null) { <MapBanBox Data="_gameData" /> }

        var opMap = _gameData.Maps.FirstOrDefault(m => m.Name == Session.Map);
        if (opMap is not null)
        {
            var weAttack = Session.Side == "Attack";
            var attackers = _gameData.Operators.Where(o => o.Side == "Attack").Select(o => o.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var defenders = _gameData.Operators.Where(o => o.Side == "Defense").Select(o => o.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _gameData.Pro.Maps.TryGetValue(opMap.Name, out var pms);
            var mapReplays = Session.Replays.Where(r => r.Map.Equals(opMap.Name, StringComparison.OrdinalIgnoreCase)).ToList();

            <Fold Key="k-map" Title="@($"{opMap.Name}: bans og gode operatører")" Class="opban-card">
                <div class="opban-head">
                    <div class="opban-sub">Map: <b>@opMap.Name</b> · Vi starter som</div>
                    <div class="opban-side">
                        <button class="admin-side-btn @(weAttack ? "side-btn-atk-active" : "")" @onclick='() => Session.SetSide("Attack")'>ATK</button>
                        <button class="admin-side-btn @(!weAttack ? "side-btn-def-active" : "")" @onclick='() => Session.SetSide("Defense")'>DEF</button>
                    </div>
                </div>
                <div class="box-grid">
                    @foreach (var (title, side, set) in new[] { ("Ban en defender (når vi angriber)", "Defense", defenders), ("Ban en attacker (når vi forsvarer)", "Attack", attackers) })
                    {
                        var proBans = pms?.OperatorBanPct.Where(kv => set.Contains(kv.Key)).OrderByDescending(kv => kv.Value).Take(6).ToList() ?? new();
                        var theyKill = ReplayStats.Threats(mapReplays, opMap.Name).Where(t => set.Contains(t.Operator)).Take(4).ToList();
                        <div class="info-box info-box-bad">
                            <div class="info-box-title">@title</div>
                            @if (proBans.Count > 0)
                            {
                                <div class="small muted">Pro league banner på @opMap.Name:</div>
                                <ol class="rank-list rank-list-why">
                                    @foreach (var kv in proBans)
                                    {
                                        var op = _gameData.Operators.FirstOrDefault(o => o.Name.Equals(kv.Key, StringComparison.OrdinalIgnoreCase));
                                        <li>
                                            <span class="rank-name">@kv.Key</span><span class="rank-bar rank-bar-bad"><span style="width:@Bar(kv.Value, proBans[0].Value)%"></span></span><b>@kv.Value.ToString("0") %</b>
                                            @if (op is { Threat.Length: > 0 }) { <div class="rank-why">@op.Threat</div> }
                                        </li>
                                    }
                                </ol>
                            }
                            else { <div class="small muted">Ingen pro-data for @opMap.Name.</div> }
                            <div class="small muted" style="margin-top:6px">Dræber os mest her (replays):</div>
                            @if (theyKill.Count == 0) { <div class="small muted">Ingen replays fra @opMap.Name endnu.</div> }
                            else
                            {
                                <ul class="site-pct">
                                    @foreach (var t in theyKill) { <li><span>@t.Operator</span><b>@t.KilledUs drab på os · vi dræbte @t.WeKilled</b></li> }
                                </ul>
                            }
                        </div>
                    }
                    @foreach (var (title, side) in new[] { ("Gode attackers her", "Attack"), ("Gode defenders her", "Defense") })
                    {
                        // Favourite ops on the map = how many of its sites list the op as a pick (r6coaching per-site data).
                        var favs = opMap.Sites.SelectMany(s => s.PickSuggestions.Take(5))
                            .Where(n => _gameData.Operators.Any(o => o.Side == side && o.Name.Equals(n, StringComparison.OrdinalIgnoreCase)))
                            .GroupBy(n => n, StringComparer.OrdinalIgnoreCase).OrderByDescending(g => g.Count()).Take(6).ToList();
                        var ours = ReplayStats.Operators(mapReplays, true, opMap.Name).Where(o => o.Side == side).Take(5).ToList();
                        <div class="info-box info-box-good">
                            <div class="info-box-title">@title</div>
                            <ol class="opban-list">
                                @foreach (var g in favs) { <li><b>@g.Key</b> <span class="muted small">top-pick på @g.Count() af @opMap.Sites.Count sites</span></li> }
                            </ol>
                            <div class="small muted" style="margin-top:6px">Vi har spillet her (replays):</div>
                            @if (ours.Count == 0) { <div class="small muted">Ingen endnu.</div> }
                            else
                            {
                                <ul class="site-pct">
                                    @foreach (var o in ours) { <li><span>@o.Operator <span class="muted">(@o.Rounds r.)</span></span><b>K/D @o.Kd · <span class="@Cls(o.WinPct)">@o.WinPct %</span> vundet</b></li> }
                                </ul>
                            }
                        </div>
                    }
                </div>
                <ProTips Data="_gameData" Mode="opbans" MapName="@opMap.Name" WeAttack="weAttack" />
            </Fold>

            <Fold Key="k-sites" Title="@($"Sites på {opMap.Name}")" Class="opban-card">
                <div class="mapban-hint">Tryk på et site for bans, gode operatører og kortet. Viser for <b>@(weAttack ? "ATK (vi banner en defender)" : "DEF (vi banner en attacker)")</b> &ndash; skift øverst i boksen ovenfor.</div>
                @{
                    var banSide = weAttack ? "Defense" : "Attack";
                    var ourSide = weAttack ? "Attack" : "Defense";
                    var opsOfSide = weAttack ? defenders : attackers;
                }
                <div class="opban-sites">
                    @foreach (var site in opMap.Sites)
                    {
                        var st = Session.SiteRounds(opMap.Name, site.Name);
                        var bans = site.SuggestedBans.Where(b => opsOfSide.Count == 0 || opsOfSide.Contains(b)).ToList();
                        var isOpen = _openSites.Contains(opMap.Name + "|" + site.Name);
                        var pickList = site.PickSuggestions.Where(n => _gameData.Operators.Any(o => o.Side == ourSide && o.Name.Equals(n, StringComparison.OrdinalIgnoreCase))).ToList();
                        <div class="opban-site @(isOpen ? "opban-site-open" : "")">
                            <div class="opban-site-head" @onclick="() => ToggleSite(opMap.Name, site.Name)">
                                <span class="opban-caret">@(isOpen ? "▾" : "▸")</span>
                                <b>@site.Name</b> <span class="muted small">@site.Floor</span>
                                <span class="opban-stat">@(st.Played > 0 ? $"Vi: {st.Won}–{st.Played - st.Won} ({st.WinPct} %)" : "")</span>
                                @if (!isOpen)
                                {
                                    <span class="small">Ban: <b>@string.Join(", ", bans.Take(2))</b> · Pick: <b>@string.Join(", ", pickList.Take(3))</b></span>
                                }
                            </div>
                            @if (isOpen)
                            {
                                @if (!string.IsNullOrEmpty(opMap.BlueprintSlug))
                                {
                                    <div class="opban-intro"><MapViewer Map="opMap" Site="site" /></div>
                                }
                                @if (site.Note.Length > 0) { <div class="info-box site-rule">@site.Note</div> }
                                <div class="opban-stat-row">
                                    @if (st.Played > 0)
                                    {
                                        <span>Vi: @st.Won&ndash;@(st.Played - st.Won) runder (<b class="@Cls(st.WinPct)">@st.WinPct %</b>)</span>
                                        <span>ATK <b class="@Cls(st.AtkPct)">@st.AtkPct %</b> (@st.AtkWon&ndash;@st.AtkLost)</span>
                                        <span>DEF <b class="@Cls(st.DefPct)">@st.DefPct %</b> (@st.DefWon&ndash;@st.DefLost)</span>
                                    }
                                    else { <span class="muted">Vi har ikke spillet dette site endnu</span> }
                                </div>
                                <div class="box-grid">
                                    <div class="info-box info-box-bad">
                                        <div class="info-box-title">Ban @(weAttack ? "en defender" : "en attacker") &ndash; i denne rækkefølge</div>
                                        <ol class="opban-list">
                                            @foreach (var b in bans)
                                            {
                                                var must = site.MustBans.Contains(b, StringComparer.OrdinalIgnoreCase);
                                                <li class="@(must ? "opban-must" : "")">
                                                    <b>@b</b>@if (must) { <span class="opban-must-tag">SKAL bannes</span> }
                                                    @if (site.BanReasons.TryGetValue(b, out var why)) { <div class="opban-why">@why</div> }
                                                </li>
                                            }
                                        </ol>
                                    </div>
                                    <div class="info-box info-box-good">
                                        <div class="info-box-title">Gode @(weAttack ? "attackers" : "defenders") på @site.Name</div>
                                        <ol class="opban-list">
                                            @foreach (var n in pickList)
                                            {
                                                <li><b>@n</b>@if (site.PickReasons.TryGetValue(n, out var pwhy)) { <div class="opban-why">@pwhy</div> }</li>
                                            }
                                        </ol>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </Fold>
        }
        else
        {
            <div class="info-box small muted">Vælg et map ovenfor for at se bans og gode operatører for mappet og hvert site.</div>
        }
        @if (Session.Map is not null) { <MapBanBox Data="_gameData" /> }

        var replays = Session.Replays.OrderByDescending(r => r.PlayedAtUtc).ToList();
        <Fold Key="k-stats" Title="Vores statistik (fra replays)" Class="stats-card">
            @if (replays.Count == 0)
            {
                <div class="small muted">Ingen kampe endnu. Kør <b>R6Replays.cmd</b> (boksen "Send kampene fra din PC" længere nede).</div>
            }
            else
            {
                var rounds = replays.Sum(r => r.RoundsRead);
                <div class="small muted">@replays.Count kampe · @rounds runder læst · @replays.Min(r => r.PlayedAtUtc).ToLocalTime().ToString("dd.MM") &ndash; @replays.Max(r => r.PlayedAtUtc).ToLocalTime().ToString("dd.MM")</div>
                <div class="info-box">
                    <div class="info-box-title">K/D pr. spiller</div>
                    <div class="table-scroll"><table class="maps-sites">
                        <thead><tr><th>Spiller</th><th>Runder</th><th>Kills</th><th>Døde</th><th>K/D</th><th>Assists</th><th>HS %</th><th>Dræber med</th></tr></thead>
                        <tbody>
                            @foreach (var p in ReplayStats.Players(replays).Where(p => MatchesWith(replays, p.Name) >= 2))
                            {
                                <tr>
                                    <td><b>@p.Name</b></td><td>@p.Rounds</td><td>@p.Kills</td><td>@p.Deaths</td><td><b>@p.Kd</b></td><td>@p.Assists</td><td>@p.HeadshotPct %</td>
                                    <td class="small">@string.Join(", ", ReplayStats.PlayerOperators(replays, p.Name).Where(o => o.Kills > 0).Take(4).Select(o => $"{o.Operator} {o.Kills}"))</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <div class="muted small">Kun spillere, der har været med i mindst 2 kampe &ndash; tilfældige holdkammerater er udeladt.</div>
                </div>
                <div class="box-grid">
                    @foreach (var side in new[] { "Attack", "Defense" })
                    {
                        var ops = ReplayStats.Operators(replays).Where(o => o.Side == side).Take(10).ToList();
                        <div class="info-box">
                            <div class="info-box-title">Vores @(side == "Attack" ? "attackers" : "defenders")</div>
                            <div class="table-scroll"><table class="maps-sites">
                                <thead><tr><th>Operatør</th><th>Runder</th><th>Kills</th><th>K/D</th><th>Runder vundet</th></tr></thead>
                                <tbody>
                                    @foreach (var o in ops) { <tr><td><b>@o.Operator</b></td><td>@o.Rounds</td><td>@o.Kills</td><td>@o.Kd</td><td class="@Cls(o.WinPct)">@o.WinPct %</td></tr> }
                                </tbody>
                            </table></div>
                        </div>
                    }
                    <div class="info-box info-box-bad">
                        <div class="info-box-title">Fjendens operatører, der dræber os mest</div>
                        <ul class="site-pct">
                            @foreach (var t in ReplayStats.Threats(replays).Take(10)) { <li><span>@t.Operator</span><b>@t.KilledUs drab på os · vi dræbte @t.WeKilled</b></li> }
                        </ul>
                    </div>
                </div>
            }
        </Fold>

        @if (replays.Count > 0)
        {
            var shown = replays.FirstOrDefault(r => r.MatchId == _matchId) ?? replays[0];
            <Fold Key="k-match" Title="Kamp for kamp" Class="stats-card">
                <select class="quick-op-select" @bind="_matchId">
                    @foreach (var r in replays)
                    {
                        <option value="@r.MatchId">@r.PlayedAtUtc.ToLocalTime().ToString("dd.MM HH:mm") · @r.Map · @r.OurScore–@r.TheirScore @(r.Won == true ? "vundet" : r.Won == false ? "tabt" : "(resultat ukendt)")</option>
                    }
                </select>
                <div class="match-score">
                    <span class="@(shown.Won == true ? "good" : shown.Won == false ? "bad" : "")">@shown.OurScore – @shown.TheirScore</span>
                    <span class="muted small">@shown.Map · @shown.MatchType · @shown.RoundsRead af @shown.RoundsTotal runder kunne læses@(shown.ScoreComplete ? "" : $" · stillingen efter runde {shown.ScoreRound}, slutresultatet kunne ikke læses")</span>
                </div>
                <div class="table-scroll"><table class="maps-sites">
                    <thead><tr><th>Runde</th><th>Side</th><th>Site</th><th>Resultat</th><th>Første drab</th></tr></thead>
                    <tbody>
                        @foreach (var r in shown.Rounds)
                        {
                            var first = r.Kills.OrderByDescending(k => k.TimeSeconds).FirstOrDefault();
                            <tr>
                                <td>@r.Number</td>
                                <td class="@(r.Side == "Attack" ? "atk-txt" : "def-txt")">@(r.Side == "Attack" ? "ATK" : "DEF")</td>
                                <td>@r.Site</td>
                                <td class="@(r.Won ? "good" : "bad")">@(r.Won ? "Vundet" : "Tabt") <span class="muted small">@WinText(r.WinCondition)</span></td>
                                <td class="small">@if (first is not null) { <span class="@(first.KillerOurs ? "good" : "bad")">@first.Killer (@first.KillerOperator) → @first.Target (@first.TargetOperator)</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
                <div class="table-scroll"><table class="maps-sites">
                    <thead><tr><th>Spiller</th><th>Hold</th><th>Kills</th><th>Døde</th><th>K/D</th><th>HS %</th><th>Operatører</th></tr></thead>
                    <tbody>
                        @foreach (var p in shown.PlayerTotals())
                        {
                            <tr class="@(p.OurTeam ? "" : "muted")"><td><b>@p.Name</b></td><td>@(p.OurTeam ? "Os" : "Dem")</td><td>@p.Kills</td><td>@p.Deaths</td><td>@p.Kd</td><td>@p.HeadshotPct %</td><td class="small">@string.Join(", ", p.Operators)</td></tr>
                        }
                    </tbody>
                </table></div>
            </Fold>
        }

        <Fold Key="k-send" Title="Send kampene fra din PC" Class="specs-card" Open="@(replays.Count == 0)">
            <ol class="small">
                <li>Slå replays til i Siege: <b>Options / Indstillinger → General / Generelt → Match Replay → On</b>.</li>
                <li>Hent <b>R6Replays.cmd</b> herunder, åbn Overførsler (Downloads) og dobbeltklik på den. Siger Windows "Windows beskyttede din pc", så tryk <b>Flere oplysninger / More info → Kør alligevel / Run anyway</b>.</li>
                <li>Første gang sendes alle kampe på PC'en. Lad vinduet stå åbent, mens I spiller &ndash; så sendes hver kamp, når den er slut, og tallene står her.</li>
            </ol>
            <div class="specs-actions">
                <a class="specs-test-btn" href="/scripts/R6Replays.cmd" download>Hent R6Replays.cmd</a>
                <a class="specs-help-btn" href="/scripts/R6Replays.ps1" download>Selve scriptet (.ps1)</a>
            </div>
            <div class="muted small">Scriptet læser kun replay-filerne med det åbne værktøj r6-dissect og sender score, drab og operatører. Omkring en tredjedel af runderne i denne sæson kan ikke læses af værktøjet; resultatet passer alligevel.</div>
        </Fold>

        @if (Session.IsSectionOn(AppSection.Loadouts))
        {
            <Fold Key="k-loadouts" Title="Loadouts" Class="specs-card" Open="false">
                <Loadouts />
            </Fold>
        }

        @if (Session.IsSectionOn(AppSection.PcCheck))
        {
            <Fold Key="k-pc" Title="PC-tjek og Siege-indstillinger" Class="specs-card" Open="false">
                @if (string.IsNullOrEmpty(Identity.Name))
                {
                    <div class="specs-hint">Sæt dit navn (knappen øverst) for at gemme dine specifikationer.</div>
                }
                else
                {
                    @foreach (var field in SpecFields)
                    {
                        var value = ResolveSpec(field.Key);
                        <div class="specs-row">
                            <div class="specs-label">@field.Label</div>
                            <textarea class="specs-input" rows="1" placeholder="@(field.Key == "headset_software" ? "Ingen (normalt)" : "Ikke sat - skriv selv")" title="@value"
                                      @onchange="e => SetManualSpec(field.Key, e.Value?.ToString())">@value</textarea>
                        </div>
                    }
                    <div class="specs-actions">
                        <a class="specs-test-btn" href="/scripts/PreGameCheck.cmd" download>Tjek min PC (dobbeltklik)</a>
                        <button class="specs-help-btn" @onclick="() => _showHelpForm = !_showHelpForm">Noget virker ikke?</button>
                    </div>
                    @if (_showHelpForm)
                    {
                        <div class="specs-help-form">
                            <textarea class="specs-help-input" placeholder="Fx: min lyd virker ikke, eller: spillet stammer hvert par minutter" @bind="_helpProblem"></textarea>
                            <button class="specs-help-submit-btn" @onclick="AskForHelp" disabled="@_helpLoading">Spørg</button>
                            @if (_helpLoading) { <div class="sg-loading"><span class="sg-spinner"></span> Tænker...</div> }
                            else if (!string.IsNullOrWhiteSpace(_helpAnswer)) { <div class="explain-card" style="white-space:pre-wrap">@_helpAnswer</div> }
                        </div>
                    }
                }
                <div class="quick-panel">
                    <div class="quick-intro">Sieges indstillinger forklaret &ndash; vælg én og få en kort forklaring. Ændrer ikke noget på din PC.</div>
                    <select class="quick-op-select" value="@_selectedSetting?.Key" @onchange="OnSettingSelected">
                        <option value="">-- vælg indstilling --</option>
                        @foreach (var group in SettingsGuideService.Settings.GroupBy(s => s.Category))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var entry in group) { <option value="@entry.Key">@entry.Name</option> }
                            </optgroup>
                        }
                    </select>
                    @if (_settingLoading) { <div class="sg-loading"><span class="sg-spinner"></span> Genererer forklaring...</div> }
                    else if (!string.IsNullOrWhiteSpace(_settingExplanation)) { <div class="explain-card" style="white-space:pre-wrap">@_settingExplanation</div> }
                </div>
            </Fold>
        }
    }
</div>

@code {
    private R6GameData? _gameData;
    private string? _matchId;
    private readonly HashSet<string> _openSites = new();
    private bool _confirmClear;

    // "Ryd map" (user 2026-10-13): back to no map before the next match - live choices only, stats stay.
    private void ClearMap() { _confirmClear = false; _openSites.Clear(); Session.Reset(); }

    private static string Bar(double v, double max) => (max > 0 ? Math.Max(4, 100 * v / max) : 0).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
    private static string Cls(int pct) => pct >= 55 ? "good" : pct <= 45 ? "bad" : "";

    private static int MatchesWith(IEnumerable<ReplayMatch> ms, string name) =>
        ms.Count(m => m.Rounds.Any(r => r.Players.Any(p => p.OurTeam && p.Name.Equals(name, StringComparison.OrdinalIgnoreCase))));

    private static string WinText(string c) => c switch
    {
        "KilledOpponents" => "alle dræbt",
        "DefusedBomb" => "bombe desarmeret",
        "DisabledDefuser" => "defuser stoppet",
        "Time" => "tiden løb ud",
        "SecuredArea" => "område sikret",
        _ => "",
    };

    private void ToggleSite(string map, string site)
    {
        var key = map + "|" + site;
        if (!_openSites.Remove(key)) { _openSites.Add(key); Session.SetSite(site); }
    }

    private SettingsGuideService.SettingEntry? _selectedSetting;
    private string? _settingExplanation;
    private bool _settingLoading;
    private bool _showHelpForm;
    private string _helpProblem = "";
    private bool _helpLoading;
    private string? _helpAnswer;

    private static readonly (string Key, string Label)[] SpecFields =
    {
        ("cpu_navn", "CPU"), ("gpu_navn", "Grafikkort"), ("ram_gb", "RAM"), ("mus_navn", "Mus"), ("tastatur_navn", "Tastatur"),
        ("skaerm", "Skærm"), ("headset", "Headset"), ("headset_software", "Headset-software"), ("os_version", "Windows"),
    };

    // Manual override (typed by the player) wins; otherwise the latest PreGameCheck.ps1 submission; otherwise empty.
    private string ResolveSpec(string key)
    {
        var manual = GetManualSpec(key);
        return !string.IsNullOrWhiteSpace(manual) ? manual : FromLatestSubmission(key) ?? "";
    }

    private string GetManualSpec(string key)
    {
        if (Identity.Name is not { } player) return "";
        var specs = Session.GetPlayerSpecs(player);
        return key switch
        {
            "cpu_navn" => specs.Cpu, "gpu_navn" => specs.GraphicsCard, "ram_gb" => specs.Ram, "mus_navn" => specs.Mouse,
            "tastatur_navn" => specs.Keyboard, "skaerm" => specs.Screen, "headset" => specs.Headset,
            "headset_software" => specs.HeadsetSoftware, "os_version" => specs.OperatingSystem, _ => "",
        };
    }

    private void SetManualSpec(string key, string? value)
    {
        if (Identity.Name is not { } player) return;
        var specs = Session.GetPlayerSpecs(player);
        switch (key)
        {
            case "cpu_navn": specs.Cpu = value ?? ""; break;
            case "gpu_navn": specs.GraphicsCard = value ?? ""; break;
            case "ram_gb": specs.Ram = value ?? ""; break;
            case "mus_navn": specs.Mouse = value ?? ""; break;
            case "tastatur_navn": specs.Keyboard = value ?? ""; break;
            case "skaerm": specs.Screen = value ?? ""; break;
            case "headset": specs.Headset = value ?? ""; break;
            case "headset_software": specs.HeadsetSoftware = value ?? ""; break;
            case "os_version": specs.OperatingSystem = value ?? ""; break;
        }
        Session.SetPlayerSpecs(player, specs);
    }

    private string? FromLatestSubmission(string key)
    {
        if (Identity.Name is not { } player || !Session.PlayerSetups.TryGetValue(player, out var setup)) return null;
        try
        {
            using var doc = JsonDocument.Parse(setup.RawJson);
            var root = doc.RootElement;
            if (key is "headset" or "headset_software")
            {
                var prop = key == "headset" ? "lydenheder" : "headset_software";
                return root.TryGetProperty("lyd_discord", out var ld) && ld.TryGetProperty(prop, out var arr) && arr.ValueKind == JsonValueKind.Array
                    ? string.Join(", ", arr.EnumerateArray().Select(d => d.ToString())) : null;
            }
            if (!root.TryGetProperty("system", out var system) || !system.TryGetProperty(key, out var el)) return null;
            return el.ValueKind switch
            {
                JsonValueKind.String => el.GetString(),
                JsonValueKind.Number when key == "ram_gb" => $"{el} GB",
                JsonValueKind.Number => el.ToString(),
                _ => null,
            };
        }
        catch (JsonException) { return null; }
    }

    private async Task AskForHelp()
    {
        if (string.IsNullOrWhiteSpace(_helpProblem)) return;
        _helpLoading = true; _helpAnswer = null; StateHasChanged();
        var context = Identity.Name is { } player && Session.PlayerSetups.TryGetValue(player, out var setup) ? setup.RawJson : "{}";
        _helpAnswer = await PreGameCheck.AskForHelpAsync(_helpProblem, context);
        _helpLoading = false;
    }

    private async Task OnSettingSelected(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        _selectedSetting = SettingsGuideService.Settings.FirstOrDefault(s => s.Key == key);
        _settingExplanation = null;
        if (_selectedSetting is null) return;
        _settingLoading = true; StateHasChanged();
        _settingExplanation = await Guide.ExplainAsync(_selectedSetting.Key);
        _settingLoading = false;
    }

    protected override async Task OnInitializedAsync()
    {
        Session.OnStateChanged += OnSessionChanged;
        Identity.OnChanged += OnSessionChanged;
        _gameData = await DataService.GetData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Identity.EnsureLoadedAsync();
        StateHasChanged();
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnStateChanged -= OnSessionChanged;
        Identity.OnChanged -= OnSessionChanged;
    }
}
