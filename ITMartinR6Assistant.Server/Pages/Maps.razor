@page "/maps"
@layout R6AssistantLayout
@inject SessionStateService Session
@inject IR6DataService DataService
@implements IDisposable
@using ITMartinR6Assistant.Domain

@* Read-only overview of every map with its bomb sites and the stats we
   have (attack win rate, typical picks, suggested bans) plus the team's
   own ban/play mark from the map-ban plan. Editing lives in /admin. *@
<div class="maps-page">
    <h1 style="margin:0 0 4px">🗺 Maps</h1>
    <div class="maps-sub">Alle maps med bombsites og tal. 🚫/⭐ er holdets egen plan fra map-ban-fasen. "Vi" er vores egne loggede kampe (@Session.Matches.Count i alt); Picks er fra r6coaching; bans og 🏆 pro-tal er fra pro league (Liquipedia, sidste to år).</div>

    @if (_gameData is null)
    {
        <div class="sg-loading"><span class="sg-spinner"></span> Henter...</div>
    }
    else
    {
        foreach (var group in new[] { ("Rankede maps", _gameData.Maps.Where(m => m.IsRanked)), ("Andre maps", _gameData.Maps.Where(m => !m.IsRanked)) })
        {
            var maps = group.Item2.OrderBy(m => m.Name).ToList();
            if (maps.Count == 0) continue;
            <div class="maps-section">@group.Item1 (@maps.Count)</div>
            <div class="maps-grid">
                @foreach (var map in maps)
                {
                    var pref = Session.MapPreferences.GetValueOrDefault(map.Name);
                    <div class="maps-card">
                        <div class="maps-head">
                            @if (!string.IsNullOrEmpty(map.ImageUrl)) { <img src="@map.ImageUrl" alt="@map.Name" /> }
                            <div class="maps-title">
                                <b>@map.Name</b>
                                @if (pref == "ban") { <span class="mapban-tag mapban-tag-ban">🚫 vi banner</span> }
                                else if (pref == "play") { <span class="mapban-tag mapban-tag-play">⭐ vi vil spille</span> }
                                @{ var st = Session.MapStats(map.Name); }
                                <small>@map.Sites.Count sites</small>
                                @if (st.Played > 0)
                                {
                                    <small><b>@st.Played kampe</b> · @st.Won–@(st.Played - st.Won) (<span class="@Cls(st.WinPct)">@st.WinPct %</span>) · ATK <span class="@Cls(st.AtkPct)">@st.AtkPct %</span> (@st.AtkWon–@st.AtkLost) · DEF <span class="@Cls(st.DefPct)">@st.DefPct %</span> (@st.DefWon–@st.DefLost) · sidst @st.LastPlayedUtc?.ToLocalTime().ToString("dd.MM.yy")</small>
                                }
                            </div>
                        </div>
                        @if (map.Sites.Count > 0)
                        {
                            <div class="table-scroll"><table class="maps-sites">
                                <tr><th>Site</th><th>Etage</th><th class="n">Vi</th><th class="n">Vi ATK</th><th class="n">Vi DEF</th><th class="n">ATK win</th><th>ATK picks</th><th>DEF picks</th><th>Bans</th></tr>
                                @foreach (var s in map.Sites)
                                {
                                    <tr>
                                        <td><b>@s.Name</b></td>
                                        <td>@s.Floor</td>
                                        @{ var sr = Session.SiteStats(map.Name, s.Name); }
                                        <td class="n @(sr.Played > 0 ? Cls(sr.WinPct) : "")">@(sr.Played > 0 ? $"{sr.Won}–{sr.Played - sr.Won}" : "–")</td>
                                        <td class="n @(sr.AtkWon + sr.AtkLost > 0 ? Cls(sr.AtkPct) : "")">@(sr.AtkWon + sr.AtkLost > 0 ? $"{sr.AtkWon}–{sr.AtkLost}" : "–")</td>
                                        <td class="n @(sr.DefWon + sr.DefLost > 0 ? Cls(sr.DefPct) : "")">@(sr.DefWon + sr.DefLost > 0 ? $"{sr.DefWon}–{sr.DefLost}" : "–")</td>
                                        <td class="n @(s.AttackWinRate >= 55 ? "good" : s.AttackWinRate > 0 && s.AttackWinRate <= 45 ? "bad" : "")">@(s.AttackWinRate > 0 ? s.AttackWinRate + " %" : "–")</td>
                                        <td>@string.Join(", ", s.AttackPicks)</td>
                                        <td>@string.Join(", ", s.DefensePicks)</td>
                                        <td title="@string.Join(", ", s.SuggestedBans)">@string.Join(", ", s.SuggestedBans.Take(5))@(s.SuggestedBans.Count > 5 ? " …" : "")</td>
                                    </tr>
                                }
                            </table></div>
                        }
                        @if (_gameData is not null) { <ProTips Data="_gameData" Mode="map" MapName="@map.Name" /> }
                        @if (map.Sites.Count == 0)
                        {
                            <div class="maps-empty">Ingen sites lagt ind endnu – tilføj dem under <a href="/admin">Admin</a>.</div>
                        }
                    </div>
                }
            </div>
        }
    }

    @if (Session.Matches.Count > 0)
    {
        <div class="maps-section">Loggede kampe (@Session.Matches.Count)</div>
        <div class="table-scroll"><table class="maps-sites maps-log">
            <tr><th>Dato</th><th>Map</th><th>Site</th><th class="n">Resultat</th><th class="n">ATK</th><th class="n">DEF</th><th>Note</th><th></th></tr>
            @foreach (var m in Session.Matches.OrderByDescending(x => x.PlayedAtUtc).Take(50))
            {
                <tr>
                    <td>@m.PlayedAtUtc.ToLocalTime().ToString("dd.MM HH:mm")</td>
                    <td>@m.Map</td><td>@m.Site</td>
                    <td class="n @(m.Won ? "good" : "bad")">@(m.Won ? "W" : "L") @(m.RoundsWon)–@(m.RoundsLost)</td>
                    <td class="n">@m.AtkWon–@m.AtkLost</td><td class="n">@m.DefWon–@m.DefLost</td>
                    <td>@m.Note</td>
                    <td><button class="matchlog-del" title="Slet" @onclick="() => Session.DeleteMatch(m)">✕</button></td>
                </tr>
            }
        </table></div>
    }
</div>

@code {
    private R6GameData? _gameData;
    private static string Cls(int pct) => pct >= 55 ? "good" : pct <= 45 ? "bad" : "";

    protected override async Task OnInitializedAsync()
    {
        _gameData = await DataService.GetData();
        Session.OnStateChanged += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Session.OnStateChanged -= OnChanged;
}
