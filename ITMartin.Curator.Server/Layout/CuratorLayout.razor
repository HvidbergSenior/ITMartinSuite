@inherits LayoutComponentBase
@inject ToastService Toast

<div class="app-shell">

    <header class="app-header">
        <div class="header-title">
            <span class="header-icon">✂️</span>
            Curator
        </div>
        <nav class="header-nav">
            <NavLink href="/" Match="NavLinkMatch.All">Inbox</NavLink>
            <NavLink href="/files">Files</NavLink>
        </nav>
    </header>

    <main class="app-main">
        @Body
    </main>

    <CuratorToast />
    <footer style="text-align:center;padding:.6rem 1rem;font-size:.72rem;color:#64748b;border-top:1px solid rgba(255,255,255,.06)"><a href="https://martin.itmartin.dk/vilkaar" target="_blank" style="color:#64748b;text-decoration:underline">Vilkår &amp; Privatlivspolitik</a> · &copy; @DateTime.Now.Year Den Digitale Rådgiver</footer>

</div>
