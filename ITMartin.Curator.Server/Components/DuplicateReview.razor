@inject ILogger<DuplicateReview> Logger

<div class="dup-groups">
    @foreach (var group in Suggestion.DuplicateGroups)
    {
        <div class="dup-group">
            <div class="dup-name text-muted">@group.FileName</div>
            @foreach (var path in group.Paths)
            {
                <div class="dup-path">
                    <span title="@path">…@TrimPath(path)</span>
                    @if (_deleteConfirm == path)
                    {
                        <button class="btn btn-sm btn-danger"   @onclick="() => DeleteAsync(path, group)">Delete</button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => _deleteConfirm = null">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _deleteConfirm = path">🗑</button>
                    }
                </div>
            }
        </div>
    }
</div>

<div class="suggestion-actions">
    <button class="btn btn-secondary" @onclick="() => OnDismissed.InvokeAsync()">Dismiss</button>
</div>

@code {
    [Parameter, EditorRequired] public Suggestion Suggestion { get; set; } = null!;
    [Parameter, EditorRequired] public string    RootPath   { get; set; } = "";
    [Parameter] public EventCallback OnApplied   { get; set; }
    [Parameter] public EventCallback OnDismissed { get; set; }

    private string? _deleteConfirm;

    private async Task DeleteAsync(string path, DuplicateGroup group)
    {
        try
        {
            MoveToTrash(path);
            group.Paths.Remove(path);
            Suggestion.AffectedFiles.Remove(path);
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Trash failed: {Path}", path); }

        _deleteConfirm = null;

        if (Suggestion.DuplicateGroups.All(g => g.Paths.Count <= 1))
            await OnApplied.InvokeAsync();
    }

    private void MoveToTrash(string filePath)
    {
        var trashDir = Path.Combine(RootPath, "_trash");
        Directory.CreateDirectory(trashDir);
        var stamp    = DateTime.Now.ToString("yyyyMMdd_HHmmssff");
        var destName = $"{stamp}_{Path.GetFileName(filePath)}";
        File.Move(filePath, Path.Combine(trashDir, destName));
    }

    private static string TrimPath(string path)
    {
        var parts = path.Replace("\\", "/").Split('/');
        return parts.Length > 4 ? string.Join("/", parts[^4..]) : path.Replace("\\", "/");
    }
}
