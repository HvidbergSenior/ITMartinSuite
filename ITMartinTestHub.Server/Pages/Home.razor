@page "/"
@rendermode InteractiveServer
@inject TestHubService Svc
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="home-page">
    <div class="home-card">
        <div class="home-logo">🧪</div>
        <h1 class="home-title">TestHub</h1>

        <ProblemPurposeBanner
            Problem="At bede venner og familie teste nye apps ender typisk i glemte opgaver og ingen struktureret feedback."
            Formaal="Navngivne testopgaver til hver tester, og et samlet overblik over hvad der er testet og hvad der mangler." />

        <p class="home-sub">Kvalitetstest for alle ITMartin apps</p>

        <div class="home-section">
            <label class="home-label">Jeg er tester</label>
            <input class="home-input"
                   @bind="_name" @bind:event="oninput"
                   placeholder="Skriv dit navn"
                   maxlength="40"
                   @onkeydown="@(e => { if (e.Key == "Enter") InvokeAsync(EnterAsTester); })" />
            <button class="btn-primary" @onclick="EnterAsTester"
                    disabled="@string.IsNullOrWhiteSpace(_name)">
                Se mine opgaver
            </button>
        </div>

        <div class="home-divider">eller</div>

        <button class="btn-secondary" @onclick="@(() => Nav.NavigateTo("/admin", forceLoad: true))">
            🔧 Admin
        </button>

        <a class="guide-link" href="/guide">📲 Sådan installerer du appen</a>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="home-error">@_error</p>
        }
    </div>
</div>

@code {
    private string _name  = "";
    private string _error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var saved = await JS.InvokeAsync<string?>("th.getItem", "tester_name");
        if (!string.IsNullOrWhiteSpace(saved))
        {
            _name = saved;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnterAsTester()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        var tester = await Svc.GetOrCreateTesterAsync(_name.Trim());
        await JS.InvokeVoidAsync("th.setItem", "tester_name", tester.Name);
        Nav.NavigateTo($"/tester/{tester.Id}", forceLoad: true);
    }
}
