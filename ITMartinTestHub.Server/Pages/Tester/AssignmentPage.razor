@page "/test/{AssignmentId:guid}"
@rendermode InteractiveServer
@inject TestHubService Svc
@inject NavigationManager Nav
@inject ToastService Toast
@inject IJSRuntime JS

@if (_assignment is null)
{
    <div class="loading">Loading…</div>
}
else
{
    <div class="test-page">

        <!-- Header -->
        <div class="test-header">
            <button class="btn-text" @onclick="GoBack">← Back</button>
            <div class="test-header-center">
                <span class="test-app-icon">@_assignment.App?.Icon</span>
                <span class="test-app-name">@_assignment.App?.Name</span>
            </div>
            <a class="btn-open-app" href="@_assignment.App?.Url" target="_blank">
                Åbn app ↗
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(_assignment.Purpose))
        {
            <div class="purpose-bar">
                <span class="purpose-label">🎯 Formål</span>
                <span class="purpose-text">@_assignment.Purpose</span>
            </div>
        }

        @if (_doneCount == 0)
        {
            <div class="install-tip">
                📲 Installer appen på din telefon inden du starter — tryk <strong>Åbn app ↗</strong>, installer den, og kom tilbage hertil.
            </div>
        }

        <div class="test-body">

            <!-- Steps panel -->
            <div class="steps-panel">
                <div class="panel-title">
                    Testrin
                    <span class="step-counter">@_doneCount / @_totalCount</span>
                </div>

                @foreach (var step in _assignment.App?.Steps ?? [])
                {
                    var result = _assignment.Results.FirstOrDefault(r => r.TestStepId == step.Id);
                    var isOpen = _openStepId == step.Id;

                    <div class="step-card @StatusClass(result) @(isOpen ? "step-open" : "")"
                         id="step-@step.Id"
                         @onclick="async () => await ToggleStep(step.Id)">

                        <div class="step-header">
                            <div class="step-status-icon">@StatusIcon(result)</div>
                            <div class="step-num">@step.Order</div>
                            <div class="step-instruction">@step.Instruction</div>
                        </div>

                        @if (isOpen)
                        {
                            <div class="step-body">
                                @if (!string.IsNullOrWhiteSpace(step.ExpectedResult))
                                {
                                    <div class="step-expected">
                                        <span class="step-expected-label">Forventet:</span>
                                        @step.ExpectedResult
                                    </div>
                                }

                                <div class="step-actions">
                                    <button class="btn-pass  @(result?.Status == StepStatus.Pass ? "active" : "")"
                                            @onclick:stopPropagation
                                            @onclick="() => RecordResult(step.Id, StepStatus.Pass)">
                                        ✓ OK
                                    </button>
                                    <button class="btn-fail  @(result?.Status == StepStatus.Fail ? "active" : "")"
                                            @onclick:stopPropagation
                                            @onclick="() => RecordResult(step.Id, StepStatus.Fail)">
                                        ✗ Fejl
                                    </button>
                                    <button class="btn-skip  @(result?.Status == StepStatus.Skip ? "active" : "")"
                                            @onclick:stopPropagation
                                            @onclick="() => RecordResult(step.Id, StepStatus.Skip)">
                                        → Spring over
                                    </button>
                                </div>

                                <textarea class="step-note"
                                          placeholder="Tilføj note…"
                                          @bind="_notes[step.Id]"
                                          @bind:event="oninput"
                                          rows="2"
                                          @onclick:stopPropagation></textarea>

                                @if (!string.IsNullOrWhiteSpace(_notes.GetValueOrDefault(step.Id)))
                                {
                                    <button class="btn-save-note"
                                            @onclick:stopPropagation
                                            @onclick="() => SaveNote(step.Id)">
                                        Gem note
                                    </button>
                                }

                                @if (!string.IsNullOrWhiteSpace(result?.Note))
                                {
                                    <div class="saved-note">📝 @result.Note</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Feedback panel -->
            <div class="feedback-panel">
                <div class="panel-title">Fejl &amp; ideer</div>

                <div class="feedback-type-row">
                    @foreach (var ft in new[] { FeedbackType.Bug, FeedbackType.Idea, FeedbackType.Comment })
                    {
                        <button class="feedback-type-btn @(_feedbackType == ft ? "active" : "")"
                                @onclick="() => _feedbackType = ft">
                            @FeedbackIcon(ft) @FeedbackLabel(ft)
                        </button>
                    }
                </div>

                <textarea class="feedback-input"
                          @bind="_feedbackText"
                          @bind:event="oninput"
                          placeholder="@FeedbackPlaceholder()"
                          rows="3"></textarea>

                <button class="btn-feedback"
                        @onclick="AddFeedback"
                        disabled="@string.IsNullOrWhiteSpace(_feedbackText)">
                    Indsend @FeedbackLabel(_feedbackType).ToLower()
                </button>

                <div class="feedback-list">
                    @foreach (var f in _assignment.Feedbacks.OrderByDescending(f => f.CreatedAt))
                    {
                        <div class="feedback-item">
                            <div class="feedback-item-header">
                                <span class="feedback-type-badge type-@f.Type.ToString().ToLower()">
                                    @FeedbackIcon(f.Type) @FeedbackLabel(f.Type)
                                </span>
                                <span class="feedback-item-who" style="color:@(f.Tester?.Color ?? "#999")">
                                    @f.Tester?.Name
                                </span>
                                <span class="feedback-item-time">@TimeAgo(f.CreatedAt)</span>
                            </div>
                            <div class="feedback-item-text">@f.Text</div>
                        </div>
                    }
                </div>

                @if (_assignment.CompletedAt.HasValue)
                {
                    <div class="complete-badge">✓ Test færdig · @_assignment.CompletedAt.Value.ToString("dd MMM HH:mm")</div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid AssignmentId { get; set; }

    private TestAssignment?      _assignment;
    private Guid?                _openStepId;
    private FeedbackType         _feedbackType = FeedbackType.Idea;
    private string               _feedbackText = "";
    private Dictionary<Guid, string> _notes    = new();

    private int _totalCount => _assignment?.App?.Steps.Count ?? 0;
    private int _doneCount  => _assignment?.Results.Count    ?? 0;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _assignment = await Svc.GetAssignmentAsync(AssignmentId);
        if (_assignment is not null)
        {
            foreach (var step in _assignment.App?.Steps ?? [])
                _notes.TryAdd(step.Id, "");

            foreach (var r in _assignment.Results.Where(r => !string.IsNullOrWhiteSpace(r.Note)))
                _notes[r.TestStepId] = r.Note!;

            if (_openStepId is null)
            {
                var firstPending = _assignment.App?.Steps
                    .FirstOrDefault(s => !_assignment.Results.Any(r => r.TestStepId == s.Id));
                _openStepId = firstPending?.Id;
            }
        }
    }

    private async Task ToggleStep(Guid stepId)
    {
        _openStepId = _openStepId == stepId ? null : stepId;
        var target = _openStepId;
        if (target.HasValue)
        {
            await Task.Delay(80);
            await JS.InvokeVoidAsync("eval",
                $"document.getElementById('step-{target}')?.scrollIntoView({{behavior:'smooth',block:'nearest'}})");
        }
    }

    private async Task RecordResult(Guid stepId, StepStatus status)
    {
        var note = _notes.GetValueOrDefault(stepId);
        await Svc.RecordResultAsync(AssignmentId, stepId, status, note);
        await Reload();

        var icon = status switch { StepStatus.Pass => "✓", StepStatus.Fail => "✗", _ => "→" };
        var type = status switch { StepStatus.Pass => "success", StepStatus.Fail => "error", _ => "info" };
        Toast.Show($"Trin registreret {icon}", type);

        if (_assignment?.CompletedAt.HasValue == true)
            Toast.Show("Alle trin gennemført! 🎉");

        // Auto-advance to next unanswered step
        var nextPending = _assignment?.App?.Steps
            .FirstOrDefault(s => !_assignment.Results.Any(r => r.TestStepId == s.Id));
        _openStepId = nextPending?.Id ?? stepId;
    }

    private async Task SaveNote(Guid stepId)
    {
        var result = _assignment?.Results.FirstOrDefault(r => r.TestStepId == stepId);
        if (result is null) return;
        await Svc.RecordResultAsync(AssignmentId, stepId, result.Status, _notes.GetValueOrDefault(stepId));
        Toast.Show("Note gemt ✓");
        await Reload();
    }

    private async Task AddFeedback()
    {
        if (string.IsNullOrWhiteSpace(_feedbackText) || _assignment is null) return;
        await Svc.AddFeedbackAsync(AssignmentId, _assignment.AppEntryId,
            _assignment.TesterId, _feedbackText.Trim(), _feedbackType);
        Toast.Show("Feedback sendt ✓");
        _feedbackText = "";
        await Reload();
    }

    private void GoBack() =>
        Nav.NavigateTo($"/tester/{_assignment?.TesterId}", forceLoad: true);

    private static string StatusClass(StepResult? r) => r?.Status switch
    {
        StepStatus.Pass => "step-pass",
        StepStatus.Fail => "step-fail",
        StepStatus.Skip => "step-skip",
        _               => "step-pending"
    };

    private static string StatusIcon(StepResult? r) => r?.Status switch
    {
        StepStatus.Pass => "✓",
        StepStatus.Fail => "✗",
        StepStatus.Skip => "→",
        _               => "○"
    };

    private static string FeedbackIcon(FeedbackType t) => t switch
    {
        FeedbackType.Bug     => "🐛",
        FeedbackType.Idea    => "💡",
        FeedbackType.Comment => "💬",
        _                    => "?"
    };

    private static string FeedbackLabel(FeedbackType t) => t switch
    {
        FeedbackType.Bug     => "Fejl",
        FeedbackType.Idea    => "Idé",
        FeedbackType.Comment => "Kommentar",
        _                    => "?"
    };

    private string FeedbackPlaceholder() => _feedbackType switch
    {
        FeedbackType.Bug     => "Beskriv hvad der gik galt…",
        FeedbackType.Idea    => "Del en forbedringsidé…",
        FeedbackType.Comment => "Øvrige kommentarer…",
        _                    => ""
    };

    private static string TimeAgo(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 2)  return "lige nu";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min siden";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours} t siden";
        return dt.ToString("dd MMM");
    }
}
