@page "/admin/rounds/{RoundId:guid}"
@rendermode InteractiveServer
@inject TestHubService Svc
@inject NavigationManager Nav

@if (_round is null)
{
    <div class="loading">Loading…</div>
}
else
{
    <div class="admin-page">

        <div class="admin-header">
            <div>
                <button class="btn-text" @onclick="@(() => Nav.NavigateTo("/admin", forceLoad: true))">← Admin</button>
                <div class="admin-title">@_round.Name</div>
                @if (!_round.IsActive) { <span class="badge-archived">Archived</span> }
            </div>
            @if (_round.IsActive)
            {
                <button class="btn-secondary btn-sm" @onclick="Archive">Archive round</button>
            }
        </div>

        <!-- Assignments table -->
        <div class="detail-section">
            <div class="section-title">Assignments (@_round.Assignments.Count)</div>

            <div class="assignments-table">
                @foreach (var a in _round.Assignments.OrderBy(x => x.App?.SortOrder))
                {
                    var total    = a.App?.Steps.Count ?? 0;
                    var done     = a.Results.Count;
                    var pct      = total > 0 ? (int)((done / (double)total) * 100) : 0;
                    var complete = a.CompletedAt.HasValue;

                    <div class="assignment-row">
                        <div class="ar-app">
                            <span>@(a.App?.Icon)</span> @a.App?.Name
                        </div>
                        <div class="ar-tester" style="color:@(a.Tester?.Color ?? "#999")">
                            @a.Tester?.Name
                        </div>
                        <div class="ar-progress">
                            <div class="progress-bar-wrap" style="width:120px">
                                <div class="progress-bar @(complete ? "progress-done" : "")"
                                     style="width:@pct%"></div>
                            </div>
                            <span class="ar-pct">@done/@total</span>
                            @if (complete) { <span class="badge-done">✓</span> }
                        </div>
                        <div class="ar-actions">
                            <button class="btn-text" @onclick="@(() => Nav.NavigateTo($"/test/{a.Id}", forceLoad: true))">
                                View →
                            </button>
                            @if (_round.IsActive)
                            {
                                <button class="btn-icon-sm danger"
                                        @onclick="() => DeleteAssignment(a.Id)">✕</button>
                            }
                        </div>
                    </div>
                }
                @if (!_round.Assignments.Any())
                {
                    <div class="muted">No assignments yet.</div>
                }
            </div>
        </div>

        <!-- Add assignment -->
        @if (_round.IsActive)
        {
            <div class="detail-section">
                <div class="section-title">Add assignment</div>

                <div class="form-row">
                    <label class="home-label">App</label>
                    <select class="home-input" @bind="_newAppId">
                        <option value="">— select app —</option>
                        @foreach (var app in _apps)
                        {
                            <option value="@app.Id">@app.Icon @app.Name</option>
                        }
                    </select>
                </div>

                <div class="form-row">
                    <label class="home-label">Tester</label>
                    <select class="home-input" @bind="_newTesterId">
                        <option value="">— select tester —</option>
                        @foreach (var t in _testers)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>

                <div class="form-row">
                    <label class="home-label">Or add new tester</label>
                    <div style="display:flex;gap:.5rem">
                        <input class="home-input" @bind="_newTesterName"
                               placeholder="Eigil" maxlength="40" />
                        <button class="btn-secondary btn-sm" @onclick="AddNewTester"
                                disabled="@string.IsNullOrWhiteSpace(_newTesterName)">
                            Add
                        </button>
                    </div>
                </div>

                <button class="btn-primary btn-sm" @onclick="AddAssignment"
                        disabled="@(_newAppId == Guid.Empty || _newTesterId == Guid.Empty)">
                    + Assign
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid RoundId { get; set; }

    private TestRound?        _round;
    private List<AppEntry>    _apps    = [];
    private List<Tester>      _testers = [];
    private Guid              _newAppId;
    private Guid              _newTesterId;
    private string            _newTesterName = "";

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _round   = await Svc.GetRoundAsync(RoundId);
        _apps    = await Svc.GetAppsAsync();
        _testers = await Svc.GetTestersAsync();
    }

    private async Task AddNewTester()
    {
        if (string.IsNullOrWhiteSpace(_newTesterName)) return;
        var t = await Svc.GetOrCreateTesterAsync(_newTesterName.Trim());
        _newTesterName = "";
        _newTesterId   = t.Id;
        await Reload();
    }

    private async Task AddAssignment()
    {
        if (_newAppId == Guid.Empty || _newTesterId == Guid.Empty) return;
        await Svc.CreateAssignmentAsync(RoundId, _newAppId, _newTesterId);
        _newAppId = _newTesterId = Guid.Empty;
        await Reload();
    }

    private async Task DeleteAssignment(Guid id)
    {
        await Svc.DeleteAssignmentAsync(id);
        await Reload();
    }

    private async Task Archive()
    {
        await Svc.ArchiveRoundAsync(RoundId);
        Nav.NavigateTo("/admin", forceLoad: true);
    }
}
