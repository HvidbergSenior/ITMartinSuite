@page "/admin"
@rendermode InteractiveServer
@inject TestHubService Svc
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="admin-page">

    <div class="admin-header">
        <div>
            <div class="admin-title">🧪 TestHub Admin</div>
        </div>
        <div class="admin-header-actions">
            <button class="btn-secondary btn-sm" @onclick="@(() => Nav.NavigateTo("/", forceLoad: true))">← Forside</button>
            <button class="btn-primary   btn-sm" @onclick="CreateRound">+ Ny runde</button>
            <button class="btn-text      btn-sm" @onclick="Logout">🔓 Log ud</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_newRoundError))
    {
        <p class="form-error">@_newRoundError</p>
    }

    @if (_creating)
    {
        <div class="inline-form">
            <input class="home-input" @bind="_newRoundName" placeholder="Årstest — Juni 2026" maxlength="80" />
            <button class="btn-primary btn-sm" @onclick="SaveRound"
                    disabled="@string.IsNullOrWhiteSpace(_newRoundName)">Opret</button>
            <button class="btn-text" @onclick="() => _creating = false">Annuller</button>
        </div>
    }

    <!-- Active round -->
    @if (_activeRound is not null)
    {
        <div class="section-title">
            Aktiv runde: <strong>@_activeRound.Name</strong>
            <button class="btn-text btn-sm" @onclick="@(() => Nav.NavigateTo($"/admin/rounds/{_activeRound.Id}", forceLoad: true))">
                Administrer →
            </button>
        </div>

        <div class="round-grid">
            @foreach (var a in _activeRound.Assignments.OrderBy(a => a.App?.SortOrder))
            {
                var total    = a.App?.Steps.Count ?? 0;
                var done     = a.Results.Count;
                var pct      = total > 0 ? (int)((done / (double)total) * 100) : 0;
                var complete = a.CompletedAt.HasValue;

                <div class="round-card">
                    <div class="round-card-icon">@(a.App?.Icon ?? "🔷")</div>
                    <div class="round-card-info">
                        <div class="round-card-app">@a.App?.Name</div>
                        <div class="round-card-tester" style="color:@(a.Tester?.Color ?? "#999")">
                            @a.Tester?.Name
                        </div>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar @(complete ? "progress-done" : "")"
                                 style="width:@pct%"></div>
                        </div>
                        <div class="round-card-meta">
                            @if (complete)
                            {
                                <span class="badge-done">✓ Done</span>
                            }
                            else
                            {
                                <span>@done / @total</span>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (!_activeRound.Assignments.Any())
            {
                <div class="muted">Ingen opgaver endnu.
                    <button class="btn-text" @onclick="@(() => Nav.NavigateTo($"/admin/rounds/{_activeRound.Id}", forceLoad: true))">
                        Tilføj →
                    </button>
                </div>
            }
        </div>
    }

    <!-- All rounds -->
    <div class="section-title" style="margin-top:2rem">Alle runder</div>
    <div class="rounds-list">
        @foreach (var r in _rounds)
        {
            <div class="rounds-row" @onclick="@(() => Nav.NavigateTo($"/admin/rounds/{r.Id}", forceLoad: true))">
                <div>
                    <span class="rounds-name">@r.Name</span>
                    @if (!r.IsActive) { <span class="badge-archived">Arkiveret</span> }
                </div>
                <div class="rounds-row-actions" @onclick:stopPropagation>
                    <span class="rounds-date">@r.CreatedAt.ToString("dd MMM yyyy")</span>
                    @if (_deleteConfirmRoundId == r.Id)
                    {
                        <button class="btn-icon-sm danger" title="Confirm delete" @onclick="() => ConfirmDeleteRound(r.Id)">✓</button>
                        <button class="btn-icon-sm"        title="Cancel"         @onclick="CancelDeleteRound">✕</button>
                    }
                    else
                    {
                        <button class="btn-icon-sm danger" title="Delete round" @onclick="() => AskDeleteRound(r.Id)">🗑</button>
                    }
                </div>
            </div>
        }
        @if (!_rounds.Any()) { <div class="muted">Ingen runder endnu.</div> }
    </div>

    <!-- Apps -->
    <div class="section-title" style="margin-top:2rem">Apps &amp; testrin</div>
    <div class="apps-grid">
        @foreach (var a in _apps)
        {
            <div class="app-card" @onclick="@(() => Nav.NavigateTo($"/admin/apps/{a.Id}", forceLoad: true))">
                <div class="app-card-icon">@a.Icon</div>
                <div class="app-card-info">
                    <div class="app-card-name">@a.Name</div>
                    <div class="app-card-steps">@a.Steps.Count trin</div>
                </div>
                <div class="app-card-arrow">›</div>
            </div>
        }
    </div>

    <!-- Nulstil testdata -->
    <div class="section-title danger-title" style="margin-top:2rem">Nulstil testdata</div>
    <div class="danger-zone">
        <p class="danger-desc">Sletter alle runder, opgaver, resultater og feedback. Beholder apps, trin og testere.</p>
        @if (_clearConfirm)
        {
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                <span style="color:#f87171;font-size:.875rem">Er du sikker? Dette kan ikke fortrydes.</span>
                <button class="btn-icon-sm danger" @onclick="ConfirmClear">✓ Ja, slet alt</button>
                <button class="btn-icon-sm"        @onclick='() => _clearConfirm = false'>✕ Annuller</button>
            </div>
        }
        else
        {
            <button class="btn-danger-outline btn-sm" @onclick='() => _clearConfirm = true'>🗑 Nulstil alt testdata</button>
        }
    </div>

    <!-- Recent feedback -->
    <div class="section-title" style="margin-top:2rem">Seneste feedback</div>
    <div class="feedback-feed">
        @foreach (var f in _recentFeedback)
        {
            var appName = _appNames.GetValueOrDefault(f.AppEntryId, "?");
            <div class="feed-item">
                <span class="feedback-type-badge type-@f.Type.ToString().ToLower()">
                    @FeedbackIcon(f.Type) @f.Type
                </span>
                <span class="feed-app">@appName</span>
                <span class="feed-text">@f.Text</span>
                <span class="feed-who" style="color:@(f.Tester?.Color ?? "#999")">@f.Tester?.Name</span>
                <span class="feed-time">@f.CreatedAt.ToString("dd MMM HH:mm")</span>
            </div>
        }
        @if (!_recentFeedback.Any()) { <div class="muted">Ingen feedback endnu.</div> }
    </div>
</div>

@code {
    private TestRound?        _activeRound;
    private List<TestRound>   _rounds         = [];
    private List<AppEntry>    _apps           = [];
    private List<Feedback>    _recentFeedback = [];
    private Dictionary<Guid,string> _appNames = new();
    private bool   _creating;
    private string _newRoundName  = "";
    private string _newRoundError = "";
    private Guid?  _deleteConfirmRoundId;
    private bool   _clearConfirm;

    protected override async Task OnInitializedAsync()
    {
        _activeRound    = await Svc.GetActiveRoundAsync();
        _rounds         = await Svc.GetRoundsAsync();
        _apps           = await Svc.GetAppsAsync();
        _recentFeedback = await Svc.GetRecentFeedbackAsync(15);
        _appNames       = _apps.ToDictionary(a => a.Id, a => a.Name);
    }

    private void CreateRound() { _creating = true; _newRoundName = ""; }

    private async Task SaveRound()
    {
        if (string.IsNullOrWhiteSpace(_newRoundName)) return;
        var round = await Svc.CreateRoundAsync(_newRoundName.Trim());
        _creating = false;
        Nav.NavigateTo($"/admin/rounds/{round.Id}", forceLoad: true);
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("adminLogout");
        Nav.NavigateTo("/", forceLoad: true);
    }

    private void AskDeleteRound(Guid id)   => _deleteConfirmRoundId = id;
    private void CancelDeleteRound()       => _deleteConfirmRoundId = null;

    private async Task ConfirmClear()
    {
        _clearConfirm = false;
        await Svc.ClearAllRoundsAsync();
        _activeRound    = null;
        _rounds         = [];
        _recentFeedback = [];
    }

    private async Task ConfirmDeleteRound(Guid id)
    {
        _deleteConfirmRoundId = null;
        await Svc.DeleteRoundAsync(id);
        _rounds = await Svc.GetRoundsAsync();
        _activeRound = await Svc.GetActiveRoundAsync();
    }

    private static string FeedbackIcon(FeedbackType t) => t switch
    {
        FeedbackType.Bug     => "🐛",
        FeedbackType.Idea    => "💡",
        FeedbackType.Comment => "💬",
        _                    => "?"
    };
}
