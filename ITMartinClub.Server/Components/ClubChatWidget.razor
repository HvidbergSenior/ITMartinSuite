@inject ClubDbContext Db
@inject ClubBroadcastService Broadcast
@inject ClubAuthService ClubAuth
@inject ClubPushService PushService
@inject IJSRuntime JS
@implements IAsyncDisposable

<button class="chat-fab" @onclick="Toggle" title="Chat">
    💬
    @if (!_open && _unseenCount > 0)
    {
        <span class="chat-fab-badge">@_unseenCount</span>
    }
</button>

@if (_open)
{
    <div class="chat-widget">
        <div class="chat-widget-header">
            <span>💬 Chat</span>
            <button class="chat-widget-close" @onclick="Toggle">✕</button>
        </div>
        <div class="chat-widget-messages" id="chat-widget-messages">
            @foreach (var m in _messages)
            {
                <div class="chat-widget-msg @(m.MemberId == _memberId ? "mine" : "")">
                    @if (m.MemberId != _memberId)
                    {
                        <div class="chat-widget-sender">@m.SenderName</div>
                    }
                    <div class="chat-widget-bubble">@m.Text</div>
                </div>
            }
            @if (_messages.Count == 0)
            {
                <div class="chat-widget-empty">Ingen beskeder endnu.</div>
            }
        </div>
        <div class="chat-widget-input-row">
            <input class="chat-widget-input" placeholder="Skriv..." value="@_text"
                   @oninput="e => _text = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnKey" />
            <button class="chat-widget-send" @onclick="SendAsync" disabled="@string.IsNullOrWhiteSpace(_text)">➤</button>
        </div>
    </div>
}

<style>
    /* The page-level theme toggle (App.razor) sits at the same bottom:20px;
       right:20px spot with z-index:9999 - it was silently burying this FAB
       underneath it (same click target, higher stacking order), which is why
       "there's no chat bubble, only the theme sun" was reported. Offset this
       one to the left of it instead of overlapping. */
    .chat-fab { position: fixed; bottom: 20px; right: 84px; z-index: 998; width: 52px; height: 52px; border-radius: 50%; border: none; background: var(--accent); color: white; font-size: 22px; cursor: pointer; box-shadow: 0 6px 20px rgba(0,0,0,.35); display: flex; align-items: center; justify-content: center; }
    .chat-fab-badge { position: absolute; top: -2px; right: -2px; background: var(--red); color: white; border-radius: 999px; font-size: 11px; font-weight: 800; min-width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; padding: 0 4px; }
    .chat-widget { position: fixed; bottom: 82px; right: 84px; z-index: 998; width: 320px; max-width: calc(100vw - 32px); height: 420px; max-height: 60vh; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,.4); display: flex; flex-direction: column; overflow: hidden; }
    .chat-widget-header { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--border); font-weight: 700; color: var(--text); font-size: 14px; }
    .chat-widget-close { background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 14px; }
    .chat-widget-messages { flex: 1; overflow-y: auto; padding: 10px 14px; display: flex; flex-direction: column; gap: 8px; }
    .chat-widget-empty { color: var(--muted); font-size: 12px; text-align: center; padding: 20px 0; }
    .chat-widget-msg { display: flex; flex-direction: column; max-width: 85%; align-self: flex-start; }
    .chat-widget-msg.mine { align-self: flex-end; align-items: flex-end; }
    .chat-widget-sender { font-size: 11px; font-weight: 700; color: var(--muted); margin-bottom: 2px; }
    .chat-widget-bubble { background: var(--card); border-radius: 12px 12px 12px 3px; padding: 7px 11px; font-size: 13px; color: var(--text); word-break: break-word; }
    .chat-widget-msg.mine .chat-widget-bubble { background: var(--accent); color: white; border-radius: 12px 12px 3px 12px; }
    .chat-widget-input-row { display: flex; gap: 6px; padding: 10px; border-top: 1px solid var(--border); }
    .chat-widget-input { flex: 1; background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 8px 12px; color: var(--text); font-size: 13px; outline: none; }
    .chat-widget-send { background: var(--accent); color: white; border: none; border-radius: 10px; width: 34px; font-size: 14px; cursor: pointer; }
    .chat-widget-send:disabled { opacity: .4; }
</style>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";

    private bool _open;
    private string _text = "";
    private string _memberName = "";
    private Guid _groupId;
    private Guid _memberId;
    private List<ClubChatMessage> _messages = [];
    private int _unseenCount;
    private DateTime _lastSeenAt = DateTime.UtcNow;
    private bool _subscribed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _subscribed) return;

        var session = await ClubAuth.ResolveSessionAsync(JS, Db, Slug);
        if (session is null) return;

        _memberId = session.MemberId;
        _memberName = session.Member.Name;
        _groupId = session.Member.GroupId;
        await RefreshAsync();
        Broadcast.Subscribe(_groupId, OnBroadcast);
        _subscribed = true;
        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        _messages = await Db.Chat
            .Where(m => m.GroupId == _groupId)
            .OrderByDescending(m => m.SentAt)
            .Take(30)
            .ToListAsync();
        _messages.Reverse();

        if (!_open)
            _unseenCount = _messages.Count(m => m.MemberId != _memberId && m.SentAt > _lastSeenAt);
    }

    private async Task Toggle()
    {
        _open = !_open;
        if (_open)
        {
            _unseenCount = 0;
            _lastSeenAt = DateTime.UtcNow;
            StateHasChanged();
            await Task.Delay(50);
            try { await JS.InvokeVoidAsync("clubJs.scrollToBottom", "chat-widget-messages"); } catch { }
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendAsync();
    }

    private async Task SendAsync()
    {
        var text = _text.Trim();
        if (string.IsNullOrEmpty(text)) return;

        Db.Chat.Add(new ClubChatMessage
        {
            GroupId = _groupId,
            MemberId = _memberId,
            SenderName = _memberName,
            Text = text,
        });
        await Db.SaveChangesAsync();
        _text = "";
        await RefreshAsync();
        Broadcast.Broadcast(_groupId);
        try { await JS.InvokeVoidAsync("clubJs.scrollToBottom", "chat-widget-messages"); } catch { }

        // Chat.razor (the dedicated /chat page) already pushes on send - this
        // floating widget is the other surface people type from, and was
        // missing it, so messages sent from here never notified anyone.
        _ = PushService.SendToGroupAsync(Db, _groupId, _memberName, $"💬 {_memberName}", text);
    }

    private void OnBroadcast() => InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
        if (_open) { try { await JS.InvokeVoidAsync("clubJs.scrollToBottom", "chat-widget-messages"); } catch { } }
    });

    public ValueTask DisposeAsync()
    {
        if (_subscribed) Broadcast.Unsubscribe(_groupId, OnBroadcast);
        return ValueTask.CompletedTask;
    }
}
