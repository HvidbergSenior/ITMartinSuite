@page "/g/{slug}/tasks"
@rendermode InteractiveServer
@inject ClubDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ClubPushService PushService
@inject ClubAuthService ClubAuth

@if (!_loaded) { <div class="club-loading">Indlæser...</div> }
else if (_member == null) { <div class="club-loading">Omdirigerer...</div> }
else
{
    <div class="club-page">
        <ClubNav Slug="@Slug" GroupName="@_group!.Name" MemberLabel="@_member.Name" Active="tasks" />

        <div class="task-body">
            <div class="task-toolbar">
                <h2 class="task-title">Opgaver</h2>
                <button class="task-add-btn" @onclick="ToggleAdding">@(_adding ? "✕ Annuller" : "+ Ny opgave")</button>
            </div>

            @if (_adding)
            {
                <div class="task-form">
                    <div class="task-field"><label>Opgave</label><input @bind="_newTitle" class="task-input" maxlength="200" placeholder="Hvad skal gøres?" /></div>
                    @if (_mainTasks.Any())
                    {
                        <div class="task-field">
                            <label>Hovedopgave</label>
                            <select @bind="_newMainTaskId" class="task-input">
                                <option value="">— vælg hovedopgave —</option>
                                @foreach (var mt in _mainTasks) { <option value="@mt.Id">@mt.Title</option> }
                            </select>
                        </div>
                    }
                    <div class="task-field">
                        <label>Tildelt til (valgfrit, vælg en eller flere)</label>
                        <div class="task-assignee-list">
                            @foreach (var m in _members)
                            {
                                <label class="task-assignee-chip">
                                    <input type="checkbox" checked="@_newAssignedTo.Contains(m.Name)" @onchange="e => ToggleNewAssignee(m.Name, (bool)e.Value!)" />
                                    @m.Name
                                </label>
                            }
                        </div>
                    </div>
                    <div class="task-field"><label>Deadline (valgfrit)</label><input @bind="_newDue" type="date" class="task-input" /></div>
                    @if (_locations.Any())
                    {
                        <div class="task-field">
                            <label>Opbevaringssted (valgfrit)</label>
                            <select @bind="_newStorageLocationId" class="task-input">
                                <option value="">— ingen —</option>
                                @foreach (var loc in _locations) { <option value="@loc.Id">@loc.Name</option> }
                            </select>
                        </div>
                    }
                    <div class="task-field"><label>Beskrivelse (valgfrit)</label><textarea @bind="_newDesc" rows="2" class="task-input task-textarea" /></div>
                    <div class="prep-form-actions">
                        <button class="task-save-btn" @onclick="AddAsync" disabled="@(string.IsNullOrWhiteSpace(_newTitle) || (_mainTasks.Any() && string.IsNullOrEmpty(_newMainTaskId)))">@(_editingTaskId is null ? "Gem opgave" : "Opdater opgave")</button>
                        @if (_editingTaskId is not null)
                        {
                            <button class="task-cancel-btn" @onclick="CancelEditTask">Annuller</button>
                        }
                    </div>
                </div>
            }

            @if (_done.Any())
            {
                <div class="task-section-label">Udførte opgaver</div>
                @foreach (var t in _done)
                {
                    <div class="task-row-item task-done-row">
                        <div class="task-info">
                            <div class="task-item-title">@t.Title</div>
                            <div class="task-badge task-badge-done">✅ Færdig af @t.CompletedByName</div>
                            <div class="task-meta"><span>@t.CompletedAt?.ToString("dd MMM yyyy")</span></div>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:4px">
                            <button class="task-del-btn" @onclick="() => StartEditTask(t)">✏️</button>
                            <button class="task-del-btn" @onclick="() => DeleteAsync(t.Id)">✕</button>
                        </div>
                    </div>
                }
            }

            @if (_open.Any())
            {
                <div class="task-section-label" style="margin-top:24px">Åbne opgaver</div>
                @foreach (var t in _open)
                {
                    <div class="task-row-item @(t.IsAssignedTo(_member!.Name) ? "task-row-mine" : "")">
                        <div class="task-info">
                            <div class="task-item-title">@t.Title</div>
                            @if (!string.IsNullOrEmpty(t.Description)) { <div class="task-item-desc">@t.Description</div> }
                            @if (t.Assignees.Count == 0)
                            {
                                <div class="task-badge task-badge-open">⚡ Ingen har taget den</div>
                            }
                            else
                            {
                                <div class="task-badge task-badge-claimed">✋ @t.AssigneeLabel klarer det</div>
                            }
                            <div class="task-meta">
                                @if (t.DueDate.HasValue) { <span class="@(t.DueDate.Value < DateTime.UtcNow ? "task-overdue" : "")">📅 @t.DueDate.Value.ToString("dd MMM yyyy")</span> }
                                <span>Oprettet af @t.CreatedByName</span>
                            </div>
                            <div style="display:flex;gap:8px">
                                @if (t.IsAssignedTo(_member!.Name))
                                {
                                    <button class="task-complete-btn" @onclick="() => CompleteAsync(t.Id)">Markér som færdig ✓</button>
                                }
                                else
                                {
                                    <button class="task-take-btn" @onclick="() => JoinAsync(t.Id)">@(t.Assignees.Count == 0 ? "Jeg tager den 👋" : "Deltag også 🙋")</button>
                                }
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:4px">
                            <button class="task-del-btn" @onclick="() => StartEditTask(t)">✏️</button>
                            <button class="task-del-btn" @onclick="() => DeleteAsync(t.Id)">✕</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="task-empty">Ingen åbne opgaver 🎉</div>
            }
        </div>
    </div>
}

<style>
    .task-body { padding: 16px; }
    .task-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .task-title { font-size: 18px; font-weight: 800; margin: 0; color: var(--text); }
    .task-add-btn { background: var(--accent); color: white; border: none; border-radius: 10px; padding: 9px 16px; font-size: 13px; font-weight: 700; cursor: pointer; }
    .task-form { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 20px; margin-bottom: 20px; }
    .task-field { margin-bottom: 12px; }
    .task-field label { display: block; font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 5px; }
    .task-row { display: flex; gap: 12px; }
    .task-row .task-field { flex: 1; }
    .task-input { width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; color: var(--text); font-size: 14px; outline: none; }
    .task-input:focus { border-color: var(--accent); }
    .task-input option { background: var(--surface); color: var(--text); }
    .task-textarea { resize: vertical; min-height: 60px; font-family: inherit; }
    .task-save-btn { width: 100%; padding: 12px; border-radius: 10px; border: none; background: #16a34a; color: white; font-size: 14px; font-weight: 700; cursor: pointer; }
    .task-save-btn:disabled { opacity: .4; cursor: default; }
    .task-section-label { font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 10px; }
    .task-empty { color: var(--muted); font-size: 15px; padding: 24px 0; text-align: center; }
    .task-row-item { display: flex; align-items: flex-start; gap: 12px; padding: 12px 10px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 8px; background: var(--card); }
    .task-row-mine { border-color: #6366f1; background: rgba(99,102,241,.08); }
    .task-done-row { opacity: .6; }
    .task-badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; margin: 2px 0 6px; }
    .task-badge-open    { background: var(--red);    color: white; }
    .task-badge-claimed { background: #d97706;       color: white; }
    .task-badge-done    { background: var(--green);  color: white; }
    .task-complete-btn  { width: auto; padding: 8px 16px; border-radius: 10px; border: none; background: var(--accent); color: white; font-size: 13px; font-weight: 700; cursor: pointer; }
    .task-info { flex: 1; }
    .task-item-title { font-size: 15px; font-weight: 600; margin-bottom: 4px; color: var(--text); }
    .task-item-desc { font-size: 13px; color: var(--muted); margin-bottom: 4px; }
    .task-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--muted); }
    .task-overdue { color: var(--red) !important; }
    .task-del-btn { background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 14px; padding: 2px 6px; flex-shrink: 0; }
    .task-del-btn:hover { color: var(--red); }
    .task-take-btn { background: transparent; border: 1px solid rgba(59,130,246,.4); color: #60a5fa; border-radius: 8px; padding: 4px 10px; font-size: 12px; cursor: pointer; margin-top: 8px; }
    .task-take-btn:hover { background: rgba(59,130,246,.1); }
    .task-assignee-list { display: flex; flex-wrap: wrap; gap: 8px; }
    .task-assignee-chip { display: flex; align-items: center; gap: 6px; background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 6px 12px; font-size: 13px; color: var(--text); cursor: pointer; }
    .prep-form-actions { display: flex; gap: 8px; }
    .prep-form-actions .task-save-btn { width: auto; flex: 1; }
    .task-cancel-btn { padding: 10px 16px; border-radius: 10px; border: 1px solid var(--border); background: transparent; color: var(--muted); font-size: 13px; cursor: pointer; }
</style>

@code {
    [Parameter] public string Slug { get; set; } = "";
    private Member? _member;
    private Group? _group;
    private bool _loaded, _adding;
    private Guid? _editingTaskId;
    private string _newTitle = "", _newDesc = "", _newMainTaskId = "", _newStorageLocationId = "";
    private HashSet<string> _newAssignedTo = [];
    private DateTime? _newDue;
    private List<Assignment> _open = [], _done = [];
    private List<Member> _members = [];
    private List<MainTask> _mainTasks = [];
    private List<StorageLocation> _locations = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var session = await ClubAuth.ResolveSessionAsync(JS, Db, Slug);
        if (session is null) { Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true); return; }
        _member = session.Member;
        _group = session.Member.Group;
        await RefreshAsync();
        _loaded = true;

        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        var all = await Db.Assignments.Where(a => a.GroupId == _group!.Id).OrderBy(a => a.CreatedAt).ToListAsync();
        _open = all.Where(a => !a.IsCompleted).OrderBy(a => a.DueDate).ToList();
        _done = all.Where(a => a.IsCompleted).OrderByDescending(a => a.CompletedAt).Take(10).ToList();
        _members = await Db.Members.Where(m => m.GroupId == _group!.Id).OrderBy(m => m.Name).ToListAsync();
        _mainTasks = await Db.MainTasks.Where(m => m.GroupId == _group!.Id).OrderBy(m => m.SortOrder).ToListAsync();
        _locations = await Db.StorageLocations.Where(l => l.GroupId == _group!.Id).OrderBy(l => l.Name).ToListAsync();
    }

    private void ToggleAdding()
    {
        if (_adding) CancelEditTask();
        else _adding = true;
    }

    private void CancelEditTask()
    {
        _editingTaskId = null;
        _newTitle = ""; _newAssignedTo = []; _newDesc = ""; _newDue = null; _newMainTaskId = ""; _newStorageLocationId = ""; _adding = false;
    }

    private async Task StartEditTask(Assignment t)
    {
        _editingTaskId = t.Id;
        var oldMainTaskTitle = t.MainTaskId is { } mtid ? _mainTasks.FirstOrDefault(m => m.Id == mtid)?.Title : null;
        _newTitle = oldMainTaskTitle is not null ? StripMainTaskPrefix(t.Title, oldMainTaskTitle) : t.Title;
        _newMainTaskId = t.MainTaskId?.ToString() ?? "";
        _newStorageLocationId = t.StorageLocationId?.ToString() ?? "";
        _newAssignedTo = t.Assignees.ToHashSet();
        _newDue = t.DueDate?.ToLocalTime();
        _newDesc = t.Description ?? "";
        _adding = true;
        // The edit form renders up near the toolbar, not next to the row you
        // clicked - without this, editing an item further down the list
        // looks like nothing happened because the form opens off-screen.
        StateHasChanged();
        await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private static string StripMainTaskPrefix(string title, string mainTaskTitle)
    {
        var prefix = $"{mainTaskTitle}: ";
        return title.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? title[prefix.Length..] : title;
    }

    private async Task AddAsync()
    {
        if (_mainTasks.Any() && string.IsNullOrEmpty(_newMainTaskId)) return;

        Guid? mainTaskId = string.IsNullOrEmpty(_newMainTaskId) ? null : Guid.Parse(_newMainTaskId);
        Guid? locationId = string.IsNullOrEmpty(_newStorageLocationId) ? null : Guid.Parse(_newStorageLocationId);
        var title = _newTitle.Trim();
        if (mainTaskId is not null)
            title = GroupHome.PrefixWithMainTask(title, _mainTasks.First(mt => mt.Id == mainTaskId).Title);

        var assignedNow = _newAssignedTo.ToList();

        if (_editingTaskId is { } id)
        {
            var t = await Db.Assignments.FindAsync(id);
            if (t is null) return;
            t.MainTaskId = mainTaskId;
            t.StorageLocationId = locationId;
            t.Title = title;
            t.Description = string.IsNullOrWhiteSpace(_newDesc) ? null : _newDesc.Trim();
            t.AssignedToNames = string.Join(';', assignedNow);
            t.DueDate = _newDue?.ToUniversalTime();
            await Db.SaveChangesAsync();
            CancelEditTask();
            await RefreshAsync();

            var recipients = assignedNow.Append(t.CreatedByName)
                .Where(n => n != _member!.Name).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (recipients.Count > 0)
                _ = PushService.SendToMembersAsync(Db, _group!.Id, recipients, "✏️ Opgave opdateret", $"{_member!.Name}: {title}");
            return;
        }

        Db.Assignments.Add(new Assignment
        {
            MainTaskId = mainTaskId,
            StorageLocationId = locationId,
            GroupId = _group!.Id,
            Title = title,
            Description = string.IsNullOrWhiteSpace(_newDesc) ? null : _newDesc.Trim(),
            AssignedToNames = string.Join(';', assignedNow),
            DueDate = _newDue?.ToUniversalTime(),
            CreatedByName = _member!.Name,
        });
        await Db.SaveChangesAsync();
        CancelEditTask();
        await RefreshAsync();

        // Only ping the people it actually concerns: the chosen assignee(s) if
        // any were picked, otherwise the whole group since it's up for grabs.
        var newTaskRecipients = assignedNow.Where(n => n != _member.Name).ToList();
        if (newTaskRecipients.Count > 0)
            _ = PushService.SendToMembersAsync(Db, _group.Id, newTaskRecipients, "✅ Ny opgave", $"{_member.Name}: {title}");
        else if (assignedNow.Count == 0)
            _ = PushService.SendToGroupAsync(Db, _group.Id, _member.Name, "✅ Ny opgave", $"{_member.Name}: {title}");
    }

    private void ToggleNewAssignee(string name, bool isChecked)
    {
        if (isChecked) _newAssignedTo.Add(name);
        else _newAssignedTo.Remove(name);
    }

    private async Task JoinAsync(Guid id)
    {
        var t = await Db.Assignments.FindAsync(id);
        if (t == null) return;
        var priorAssignees = t.Assignees;
        t.AddAssignee(_member!.Name);
        await Db.SaveChangesAsync();
        await RefreshAsync();

        var recipients = priorAssignees.Append(t.CreatedByName)
            .Where(n => n != _member.Name).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (recipients.Count > 0)
            _ = PushService.SendToMembersAsync(Db, _group!.Id, recipients, "👋 Opgave taget", $"{_member.Name} tager: {t.Title}");
    }

    private async Task CompleteAsync(Guid id)
    {
        var t = await Db.Assignments.FindAsync(id);
        if (t == null) return;
        t.IsCompleted = true; t.CompletedAt = DateTime.UtcNow; t.CompletedByName = _member!.Name;
        await Db.SaveChangesAsync();
        await RefreshAsync();

        var recipients = t.Assignees.Append(t.CreatedByName)
            .Where(n => n != _member.Name).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (recipients.Count > 0)
            _ = PushService.SendToMembersAsync(Db, _group!.Id, recipients, "✅ Opgave færdig", $"{_member.Name}: {t.Title}");
    }

    private async Task DeleteAsync(Guid id)
    {
        var t = await Db.Assignments.FindAsync(id);
        if (t != null) { Db.Assignments.Remove(t); await Db.SaveChangesAsync(); await RefreshAsync(); }
    }
}
