@page "/g/{slug}/join"
@rendermode InteractiveServer
@inject ClubDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="join-wrap">
    <div class="join-card">
        <div class="join-logo">🤝</div>
        <h1 class="join-title">@(_group?.Name ?? "Club")</h1>
        <p class="join-sub">@(_group?.Description ?? "")</p>

        @if (_error != null)
        {
            <div class="join-error">@_error</div>
        }

        @if (!_loaded)
        {
            <div class="join-loading">Indlæser...</div>
        }
        else if (_group == null)
        {
            <div class="join-error">Gruppen findes ikke.</div>
        }
        else
        {
            <div class="join-field">
                <label>Dit navn</label>
                <input @bind="_name" placeholder="Fornavn Efternavn" class="join-input" maxlength="60" />
            </div>
            <div class="join-field">
                <label>Invitationskode</label>
                <input @bind="_code" placeholder="Skriv koden her" class="join-input" type="password" />
            </div>
            <button class="join-btn" @onclick="JoinAsync" disabled="@_joining">
                @(_joining ? "Tilmelder..." : "Tilmeld")
            </button>
        }
    </div>
</div>

<style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #0f1117; color: #f0f0f0; font-family: -apple-system, sans-serif; }
    .join-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 16px; background: #0f1117; }
    .join-card { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: 20px; padding: 40px 32px; width: 100%; max-width: 420px; text-align: center; }
    .join-logo { font-size: 48px; margin-bottom: 12px; }
    .join-title { font-size: 26px; font-weight: 900; margin: 0 0 8px; }
    .join-sub { font-size: 14px; color: #64748b; margin: 0 0 28px; }
    .join-field { text-align: left; margin-bottom: 16px; }
    .join-field label { display: block; font-size: 12px; font-weight: 600; color: #64748b; margin-bottom: 6px; }
    .join-input { width: 100%; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); border-radius: 10px; padding: 11px 14px; color: white; font-size: 15px; outline: none; }
    .join-input:focus { border-color: #3b82f6; }
    .join-btn { width: 100%; padding: 13px; border-radius: 12px; border: none; background: #2563eb; color: white; font-size: 16px; font-weight: 700; cursor: pointer; margin-top: 8px; }
    .join-btn:hover:not(:disabled) { background: #1d4ed8; }
    .join-btn:disabled { opacity: .5; cursor: default; }
    .join-error { background: rgba(248,113,113,.15); border: 1px solid rgba(248,113,113,.3); border-radius: 10px; padding: 10px 14px; font-size: 13px; color: #f87171; margin-bottom: 16px; }
    .join-loading { color: #64748b; padding: 20px 0; }
</style>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Group? _group;
    private string _name = "";
    private string _code = "";
    private string? _error;
    private bool _joining;
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var existingSession = await JS.InvokeAsync<string?>("clubJs.getSession");
        if (!string.IsNullOrEmpty(existingSession) && Guid.TryParse(existingSession, out var sid))
        {
            var session = await Db.Sessions.Include(s => s.Member).ThenInclude(m => m.Group)
                .FirstOrDefaultAsync(s => s.Id == sid);
            if (session?.Member.Group.Slug == Slug)
            {
                Nav.NavigateTo($"/g/{Slug}", forceLoad: true);
                return;
            }
        }

        _group = await Db.Groups.FirstOrDefaultAsync(g => g.Slug == Slug);
        _loaded = true;
        StateHasChanged();
    }

    private async Task JoinAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Skriv dit navn."; return; }
        if (_group == null) return;
        if (_code.Trim() != _group.InviteCode) { _error = "Forkert invitationskode."; return; }

        _joining = true;
        StateHasChanged();

        try
        {
            var member = await Db.Members.FirstOrDefaultAsync(m => m.GroupId == _group.Id && m.Name == _name.Trim());
            if (member == null)
            {
                member = new Member { GroupId = _group.Id, Name = _name.Trim() };
                Db.Members.Add(member);
            }

            var session = new MemberSession { MemberId = member.Id };
            Db.Sessions.Add(session);
            await Db.SaveChangesAsync();

            await JS.InvokeVoidAsync("clubJs.setSession", session.Id.ToString());
            Nav.NavigateTo($"/g/{Slug}", forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = $"Noget gik galt: {ex.Message}";
            _joining = false;
        }
    }
}
