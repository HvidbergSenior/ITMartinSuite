@page "/g/{slug}/chat"
@rendermode InteractiveServer
@inject ClubDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ClubBroadcastService Broadcast
@inject ClubPushService PushService
@inject ClubAuthService ClubAuth
@implements IAsyncDisposable

@if (!_loaded) { <div class="club-loading">Indlæser...</div> }
else if (_member == null) { <div class="club-loading">Omdirigerer...</div> }
else
{
    <div class="club-page club-page--chat">
        <ClubNav Slug="@Slug" GroupName="@_group!.Name" MemberLabel="@_member.Name" Active="chat" />

        <div class="chat-body">
            <div class="chat-messages" id="chat-messages">
                @foreach (var m in _messages)
                {
                    <div class="chat-msg @(m.MemberId == _member.Id ? "chat-msg-mine" : "")">
                        @if (m.MemberId != _member.Id)
                        {
                            <div class="chat-sender">@m.SenderName</div>
                        }
                        <div class="chat-bubble">@m.Text</div>
                        <div class="chat-time">@m.SentAt.ToLocalTime().ToString("HH:mm")</div>
                    </div>
                }
            </div>
            <div class="chat-input-row">
                <input class="chat-input" placeholder="Skriv en besked..."
                       @bind="_text" @bind:event="oninput"
                       @onkeydown="OnKey" maxlength="500" />
                <button class="chat-send" @onclick="SendAsync"
                        disabled="@string.IsNullOrWhiteSpace(_text)">Send</button>
            </div>
        </div>
    </div>
}

<style>
    /* Chat needs the page shell to be a sticky-input flex column instead of the
       shared scrolling layout - layers on top of .club-page in app.css rather
       than duplicating its base rules (max-width/margin/padding). */
    .club-page--chat { display: flex; flex-direction: column; height: 100dvh; padding-bottom: 0; }
    .club-page--chat .club-header, .club-page--chat .club-nav { flex-shrink: 0; }
    .chat-body { display: flex; flex-direction: column; flex: 1; min-height: 0; }
    .chat-messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
    .chat-msg { display: flex; flex-direction: column; max-width: 75%; align-self: flex-start; }
    .chat-msg-mine { align-self: flex-end; align-items: flex-end; }
    .chat-sender { font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 3px; }
    .chat-bubble { background: var(--card); border-radius: 16px 16px 16px 4px; padding: 10px 14px; font-size: 15px; line-height: 1.45; word-break: break-word; color: var(--text); }
    .chat-msg-mine .chat-bubble { background: var(--accent); border-radius: 16px 16px 4px 16px; color: #fff; }
    .chat-time { font-size: 11px; color: var(--muted); margin-top: 3px; }
    .chat-input-row { display: flex; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--border); flex-shrink: 0; }
    .chat-input { flex: 1; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 11px 14px; color: var(--text); font-size: 15px; outline: none; }
    .chat-input:focus { border-color: var(--accent); }
    .chat-send { background: var(--accent); border: none; border-radius: 12px; color: white; font-size: 15px; font-weight: 700; padding: 11px 20px; cursor: pointer; }
    .chat-send:disabled { opacity: .4; cursor: default; }
</style>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Member? _member;
    private Group? _group;
    private bool _loaded;
    private string _text = "";
    private List<ClubChatMessage> _messages = [];
    private bool _scrollPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var session = await ClubAuth.ResolveSessionAsync(JS, Db, Slug);
            if (session is null) { Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true); return; }
            _member = session.Member;
            _group = session.Member.Group;
            Broadcast.Subscribe(_group.Id, OnBroadcast);
            await RefreshAsync();
            _loaded = true;
            _scrollPending = true;

            StateHasChanged();
        }
        else if (_scrollPending)
        {
            _scrollPending = false;
            try { await JS.InvokeVoidAsync("clubJs.scrollToBottom", "chat-messages"); } catch { }
        }
    }

    private async Task RefreshAsync()
    {
        _messages = await Db.Chat
            .Where(m => m.GroupId == _group!.Id)
            .OrderByDescending(m => m.SentAt)
            .Take(100)
            .OrderBy(m => m.SentAt)
            .ToListAsync();
    }

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await SendAsync(); }

    private async Task SendAsync()
    {
        var text = _text.Trim();
        if (string.IsNullOrEmpty(text) || _member == null || _group == null) return;

        Db.Chat.Add(new ClubChatMessage
        {
            GroupId    = _group.Id,
            MemberId   = _member.Id,
            SenderName = _member.Name,
            Text       = text
        });
        await Db.SaveChangesAsync();
        _text = "";
        await RefreshAsync();
        _scrollPending = true;
        Broadcast.Broadcast(_group.Id);
        _ = PushService.SendToGroupAsync(Db, _group.Id, _member.Name, $"💬 {_member.Name}", text);
        StateHasChanged();
    }

    private void OnBroadcast() => InvokeAsync(async () =>
    {
        await RefreshAsync();
        _scrollPending = true;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        if (_group != null) Broadcast.Unsubscribe(_group.Id, OnBroadcast);
        await Task.CompletedTask;
    }
}
