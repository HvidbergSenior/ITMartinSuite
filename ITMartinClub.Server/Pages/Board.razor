@page "/g/{slug}/board"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject ClubDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ClubBroadcastService Broadcast
@inject ClubPushService PushService
@inject ClubAuthService ClubAuth
@inject IConfiguration Config
@implements IDisposable

@if (!_loaded) { <div class="club-loading">Indlæser...</div> }
else if (_member == null) { <div class="club-loading">Omdirigerer...</div> }
else
{
    <div class="club-page">
        <ClubNav Slug="@Slug" GroupName="@_group!.Name" MemberLabel="@_member.Name" Active="board" />

        <div class="board-body">
            <div class="board-header-row">
                <h2 class="board-title">Opslagstavle</h2>
            </div>

            <div class="board-filter-row">
                <button class="board-filter-btn @(_filterTag == null ? "active" : "")" @onclick='() => _filterTag = null'>Alle</button>
                <button class="board-filter-btn @(_filterTag == "Game" ? "active" : "")" @onclick='() => _filterTag = "Game"'>🎮 Spil</button>
                <button class="board-filter-btn @(_filterTag == "Personal" ? "active" : "")" @onclick='() => _filterTag = "Personal"'>💬 Privat</button>
            </div>

            <div class="board-compose">
                <textarea @bind="_newContent" @bind:event="oninput" placeholder="Skriv et opslag..." class="board-textarea" maxlength="500" rows="3" />

                <div class="board-tag-row">
                    <button type="button" class="board-tag-pick @(_newTag == "General" ? "active" : "")" @onclick='() => _newTag = "General"'>Generelt</button>
                    <button type="button" class="board-tag-pick @(_newTag == "Game" ? "active" : "")" @onclick='() => _newTag = "Game"'>🎮 Spil</button>
                    <button type="button" class="board-tag-pick @(_newTag == "Personal" ? "active" : "")" @onclick='() => _newTag = "Personal"'>💬 Privat</button>
                </div>

                <div class="board-photo-row">
                    <InputFile OnChange="OnImageSelected" accept="image/*" class="board-photo-input" />
                    @if (_pendingImageName is not null)
                    {
                        <span class="board-photo-selected">📷 @_pendingImageName <button type="button" class="board-photo-clear" @onclick="ClearImage">✕</button></span>
                    }
                </div>

                <div class="board-compose-footer">
                    <span class="board-char">@_newContent.Length/500</span>
                    <button class="board-post-btn" @onclick="PostAsync" disabled="@(_posting || (string.IsNullOrWhiteSpace(_newContent) && _pendingImageBytes is null))">
                        @(_posting ? "Sender..." : "Send")
                    </button>
                </div>
            </div>

            <div class="board-posts" id="board-posts">
                @{ var visiblePosts = _filterTag == null ? _posts : _posts.Where(p => p.Tag == _filterTag).ToList(); }
                @if (!visiblePosts.Any())
                {
                    <div class="board-empty">Ingen opslag endnu — skriv det første!</div>
                }
                @foreach (var p in visiblePosts)
                {
                    <div class="board-post @(p.MemberId == _member.Id ? "board-post-mine" : "")">
                        <div class="board-post-header">
                            <span class="board-post-author">@p.Member.Name</span>
                            @if (p.Tag != "General")
                            {
                                <span class="board-post-tag">@(p.Tag == "Game" ? "🎮" : "💬")</span>
                            }
                            <span class="board-post-time">@p.PostedAt.ToLocalTime().ToString("dd MMM HH:mm")</span>
                            @if (p.MemberId == _member.Id)
                            {
                                <button class="board-del" @onclick="() => DeletePostAsync(p.Id)">✕</button>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.Content))
                        {
                            <div class="board-post-content">@p.Content</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.ImageFileName))
                        {
                            <img class="board-post-image" src="/photo/@p.ImageFileName" loading="lazy" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    .board-body { padding: 16px; }
    .board-header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .board-title { font-size: 18px; font-weight: 800; margin: 0; color: var(--text); }
    .board-limit-info { font-size: 12px; color: var(--muted); }
    .board-filter-row { display: flex; gap: 8px; margin-bottom: 14px; }
    .board-filter-btn { padding: 6px 12px; border-radius: 20px; border: 1px solid var(--border); background: transparent; color: var(--muted); font-size: 12px; font-weight: 600; cursor: pointer; }
    .board-filter-btn.active { background: rgba(59,130,246,.15); border-color: var(--accent); color: #60a5fa; }
    .board-compose { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 14px; margin-bottom: 20px; }
    .board-textarea { width: 100%; background: transparent; border: none; color: var(--text); font-size: 15px; outline: none; resize: none; font-family: inherit; }
    .board-tag-row { display: flex; gap: 6px; margin: 8px 0; }
    .board-tag-pick { padding: 5px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); font-size: 12px; cursor: pointer; }
    .board-tag-pick.active { background: rgba(59,130,246,.15); border-color: var(--accent); color: #60a5fa; }
    .board-photo-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .board-photo-input { color: var(--muted); font-size: 12px; max-width: 100%; }
    .board-photo-selected { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
    .board-photo-clear { background: transparent; border: none; color: var(--red); cursor: pointer; font-size: 12px; }
    .board-compose-footer { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
    .board-char { font-size: 12px; color: var(--muted); }
    .board-quota { font-size: 12px; color: var(--yellow); flex: 1; }
    .board-post-btn { background: var(--accent); color: white; border: none; border-radius: 8px; padding: 8px 18px; font-size: 14px; font-weight: 700; cursor: pointer; margin-left: auto; }
    .board-post-btn:disabled { opacity: .4; cursor: default; }
    .board-post-btn:hover:not(:disabled) { background: #1d4ed8; }
    .board-limit-warn { font-size: 13px; color: var(--red); margin-top: 8px; }
    .board-posts { display: flex; flex-direction: column; gap: 10px; }
    .board-empty { text-align: center; color: var(--muted); padding: 40px 0; font-size: 15px; }
    .board-post { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; }
    .board-post-mine { border-color: rgba(59,130,246,.25); background: rgba(59,130,246,.06); }
    .board-post-header { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    .board-post-author { font-size: 13px; font-weight: 700; color: #60a5fa; }
    .board-post-tag { font-size: 13px; }
    .board-post-time { font-size: 12px; color: var(--muted); flex: 1; }
    .board-post-content { font-size: 15px; white-space: pre-wrap; word-break: break-word; color: var(--text); }
    .board-post-image { max-width: 100%; border-radius: 10px; margin-top: 8px; display: block; }
    .board-del { background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 12px; padding: 2px 4px; }
    .board-del:hover { color: var(--red); }
</style>

@code {
    [Parameter] public string Slug { get; set; } = "";
    private const long MaxImageBytes = 8 * 1024 * 1024;

    private Member? _member;
    private Group? _group;
    private bool _loaded;
    private bool _posting;
    private string _newContent = "";
    private string _newTag = "General";
    private string? _filterTag;
    private List<BulletinPost> _posts = [];
    private byte[]? _pendingImageBytes;
    private string? _pendingImageName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var session = await ClubAuth.ResolveSessionAsync(JS, Db, Slug);
        if (session is null) { Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true); return; }
        _member = session.Member;
        _group = session.Member.Group;
        Broadcast.Subscribe(_group.Id, OnBroadcast);
        await RefreshAsync();
        _loaded = true;

        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        _posts = await Db.Posts
            .Include(p => p.Member)
            .Where(p => p.GroupId == _group!.Id)
            .OrderByDescending(p => p.PostedAt)
            .Take(50)
            .ToListAsync();
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > MaxImageBytes) { await JS.InvokeVoidAsync("alert", "Billedet er for stort (max 8 MB)."); return; }
        using var stream = file.OpenReadStream(MaxImageBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _pendingImageBytes = ms.ToArray();
        _pendingImageName = file.Name;
    }

    private void ClearImage()
    {
        _pendingImageBytes = null;
        _pendingImageName = null;
    }

    private async Task PostAsync()
    {
        if (string.IsNullOrWhiteSpace(_newContent) && _pendingImageBytes is null) return;
        _posting = true;
        StateHasChanged();

        string? imageFileName = null;
        if (_pendingImageBytes is not null)
        {
            imageFileName = $"{Guid.NewGuid():N}.jpg";
            var root = Config["ClubSettings:PhotosRoot"] ?? "/app/data/photos";
            Directory.CreateDirectory(root);
            await File.WriteAllBytesAsync(Path.Combine(root, imageFileName), _pendingImageBytes);
        }

        var content = _newContent.Trim();
        Db.Posts.Add(new BulletinPost
        {
            GroupId = _group!.Id,
            MemberId = _member!.Id,
            Content = content,
            Tag = _newTag,
            ImageFileName = imageFileName,
        });
        await Db.SaveChangesAsync();
        _newContent = "";
        _newTag = "General";
        _pendingImageBytes = null;
        _pendingImageName = null;
        _posting = false;
        await RefreshAsync();
        Broadcast.Broadcast(_group.Id);
        var pushBody = string.IsNullOrWhiteSpace(content) ? "📷 delte et billede" : content;
        _ = PushService.SendToGroupAsync(Db, _group.Id, _member.Name, $"📌 {_member.Name}", pushBody);
        StateHasChanged();
    }

    private async Task DeletePostAsync(Guid id)
    {
        var p = await Db.Posts.FindAsync(id);
        if (p != null && p.MemberId == _member!.Id)
        {
            Db.Posts.Remove(p);
            await Db.SaveChangesAsync();
            await RefreshAsync();
            Broadcast.Broadcast(_group.Id);
        }
    }

    private void OnBroadcast() => InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
    public void Dispose() { if (_group != null) Broadcast.Unsubscribe(_group.Id, OnBroadcast); }
}
