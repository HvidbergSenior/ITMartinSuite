@page "/g/{slug}"
@rendermode InteractiveServer
@inject ClubDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ClubBroadcastService Broadcast
@inject ClubPushService PushService
@inject ClubAuthService ClubAuth
@inject ClubSessionStatusService SessionStatus
@implements IDisposable

@if (!_loaded)
{
    <div class="club-loading">Indlæser...</div>
}
else if (_member == null)
{
    <div class="club-loading">Omdirigerer...</div>
}
else
{
    <div class="club-page">
        <ClubNav Slug="@Slug" GroupName="@_group!.Name" MemberLabel="@($"Hej, {_member.Name} 👋")"
                 Active="home" OnLogout="LeaveAsync" />

        @if (_mainTasks.Any())
        {
            <div class="task-body">
                <div class="task-toolbar">
                    <h2 class="task-title">Åbne opgaver</h2>
                    <button class="task-add-btn" @onclick="() => _adding = !_adding">@(_adding ? "✕ Annuller" : "+ Ny opgave")</button>
                </div>

                <div class="task-filter-row">
                    <label>Vis</label>
                    <select class="task-input" @bind="_filterAssignedTo">
                        <option value="">Alle</option>
                        <option value="@_member!.Name">Kun mine opgaver</option>
                        @foreach (var m in _members.Where(m => m.Name != _member!.Name)) { <option value="@m.Name">@m.Name</option> }
                    </select>
                </div>

                @if (_adding)
                {
                    <div class="task-form">
                        <div class="task-field"><label>Opgave</label><input @bind="_newTitle" class="task-input" maxlength="200" placeholder="Hvad skal gøres?" /></div>
                        <div class="task-field">
                            <label>Hovedopgave</label>
                            <select @bind="_newMainTaskId" class="task-input">
                                <option value="">— vælg hovedopgave —</option>
                                @foreach (var mt in _mainTasks) { <option value="@mt.Id">@mt.Title</option> }
                            </select>
                        </div>
                        <div class="task-row">
                            <div class="task-field">
                                <label>Tildelt til (valgfrit)</label>
                                <select @bind="_newAssignedTo" class="task-input">
                                    <option value="">— ingen tildeling —</option>
                                    @foreach (var m in _members) { <option value="@m.Name">@m.Name</option> }
                                </select>
                            </div>
                            <div class="task-field"><label>Deadline (valgfrit)</label><input @bind="_newDue" type="date" class="task-input" /></div>
                        </div>
                        <div class="task-field"><label>Beskrivelse (valgfrit)</label><textarea @bind="_newDesc" rows="2" class="task-input task-textarea" /></div>
                        <button class="task-save-btn" @onclick="AddTaskAsync" disabled="@(string.IsNullOrWhiteSpace(_newTitle) || string.IsNullOrEmpty(_newMainTaskId))">Gem opgave</button>
                    </div>
                }

                <div class="maintask-grid">
                @foreach (var mt in _mainTasks)
                {
                    var tasksForMain = _openTasksFull.Where(t => t.MainTaskId == mt.Id)
                        .Where(t => string.IsNullOrEmpty(_filterAssignedTo) || t.AssignedToName == _filterAssignedTo)
                        .ToList();
                    <div class="maintask-group">
                        <div class="maintask-header">
                            <div class="maintask-title">@mt.Title</div>
                            <div class="maintask-count">@tasksForMain.Count</div>
                        </div>

                        @if (_editingDodId == mt.Id)
                        {
                            <div class="maintask-dod-edit">
                                <textarea @bind="_editDodText" rows="2" class="task-input task-textarea" placeholder="Hvornår er denne hovedopgave 'færdig'?" />
                                <div style="display:flex;gap:8px;margin-top:6px">
                                    <button class="task-take-btn" @onclick="() => SaveDodAsync(mt.Id)">Gem</button>
                                    <button class="task-take-btn" @onclick="() => _editingDodId = null">Annuller</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="maintask-dod" @onclick="() => StartEditDod(mt)">
                                <span class="dod-label">Definition of Done</span>
                                @(string.IsNullOrWhiteSpace(mt.DefinitionOfDone) ? "— sæt en definition af 'færdig' →" : mt.DefinitionOfDone)
                            </div>
                        }

                        @if (!tasksForMain.Any())
                        {
                            <div class="club-empty">Ingen åbne opgaver.</div>
                        }
                        else
                        {
                            @foreach (var t in tasksForMain)
                            {
                                <div class="task-row-item @(t.AssignedToName == _member!.Name ? "task-row-mine" : "")">
                                    <div class="task-info">
                                        <div class="task-item-title">@t.Title</div>
                                        @if (!string.IsNullOrEmpty(t.Description)) { <div class="task-item-desc">@t.Description</div> }
                                        @if (string.IsNullOrEmpty(t.AssignedToName))
                                        {
                                            <div class="task-badge task-badge-open">⚡ Ingen har taget den</div>
                                        }
                                        else
                                        {
                                            <div class="task-badge task-badge-claimed">✋ @t.AssignedToName klarer det</div>
                                        }
                                        <div class="task-meta">
                                            @if (t.DueDate.HasValue) { <span class="@(t.DueDate.Value < DateTime.UtcNow ? "task-overdue" : "")">📅 @t.DueDate.Value.ToString("dd MMM yyyy")</span> }
                                            <span>Oprettet af @t.CreatedByName</span>
                                        </div>
                                        <div style="display:flex;gap:8px">
                                            @if (t.AssignedToName == _member!.Name)
                                            {
                                                <button class="task-complete-btn" @onclick="() => CompleteTaskAsync(t.Id)">Markér som færdig ✓</button>
                                            }
                                            else
                                            {
                                                <button class="task-take-btn" @onclick="() => TakeTaskAsync(t.Id)">Jeg tager den 👋</button>
                                            }
                                        </div>
                                    </div>
                                    <button class="task-del-btn" @onclick="() => DeleteTaskAsync(t.Id)">✕</button>
                                </div>
                            }
                        }
                    </div>
                }

                @{ var uncategorized = _openTasksFull.Where(t => t.MainTaskId == null)
                    .Where(t => string.IsNullOrEmpty(_filterAssignedTo) || t.AssignedToName == _filterAssignedTo)
                    .ToList(); }
                @if (uncategorized.Any())
                {
                    <div class="maintask-group">
                        <div class="maintask-header"><div class="maintask-title">Ikke kategoriseret</div></div>
                        @foreach (var t in uncategorized)
                        {
                            <div class="task-row-item @(t.AssignedToName == _member!.Name ? "task-row-mine" : "")" @key="t.Id">
                                <div class="task-info">
                                    <div class="task-item-title">@t.Title</div>
                                    <div class="task-meta">
                                        @if (t.DueDate.HasValue) { <span>📅 @t.DueDate.Value.ToString("dd MMM yyyy")</span> }
                                        <span>Oprettet af @t.CreatedByName</span>
                                    </div>
                                    <select class="task-input" style="margin-top:8px" value="" @onchange="e => AssignMainTaskAsync(t.Id, (string)e.Value!)">
                                        <option value="">— vælg hovedopgave —</option>
                                        @foreach (var mt in _mainTasks) { <option value="@mt.Id">@mt.Title</option> }
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                }
                </div>

                @if (_addingMainTask)
                {
                    <div class="task-form">
                        <div class="task-field"><label>Nyt hovedopgave-emne</label><input @bind="_newMainTaskTitle" class="task-input" maxlength="100" placeholder="fx Salg" /></div>
                        <button class="task-save-btn" @onclick="AddMainTaskAsync" disabled="@(string.IsNullOrWhiteSpace(_newMainTaskTitle))">Tilføj hovedopgave</button>
                    </div>
                }
                else
                {
                    <button class="task-take-btn" @onclick="() => _addingMainTask = true">+ Nyt hovedopgave-emne</button>
                }
            </div>
        }
        else
        {
        <div class="club-sections">

            <div class="club-section live-session-card">
                <div class="club-section-title">Lige nu</div>
                @if (_status is null)
                {
                    <div class="club-empty">Ingen spilaften planlagt lige nu.</div>
                    <a class="club-see-all" href="/g/@Slug/ready">🎮 Start en spilaften →</a>
                }
                else if (_status.Session.Phase == "Invitations")
                {
                    @if (_activeCheck is null)
                    {
                        <div class="club-empty">Venter på invitation...</div>
                    }
                    else
                    {
                        <div class="ready-active-header">@(_activeCheck.Phrase ?? $"{_activeCheck.CreatedByName} er klar om {_activeCheck.Minutes} minutter. Er der nogen klar?")</div>
                        <div class="ready-responses">
                            @foreach (var r in _responses)
                            {
                                <span class="ready-chip @(r.Status switch { "Ready" => "ready-yes", "Watching" => "ready-watch", _ => "ready-no" })">
                                    @(r.Status switch { "Ready" => "✅", "Watching" => "👀", _ => "🚫" }) @r.MemberName
                                </span>
                            }
                            @if (_responses.Count == 0)
                            {
                                <span class="ready-none">Ingen har svaret endnu...</span>
                            }
                        </div>
                        <div class="ready-answer-row">
                            <button class="ready-answer-btn yes @(_myResponse?.Status == "Ready" ? "selected" : "")" @onclick='() => RespondAsync("Ready")'>✅ Klar</button>
                            <button class="ready-answer-btn no @(_myResponse?.Status == "NotNow" ? "selected" : "")" @onclick='() => RespondAsync("NotNow")'>🚫 Ikke i aften</button>
                            <button class="ready-answer-btn watch @(_myResponse?.Status == "Watching" ? "selected" : "")" @onclick='() => RespondAsync("Watching")'>👀 Følger med</button>
                        </div>
                        @if (!_addedToCalendar)
                        {
                            <button class="cal-add-inline-btn" @onclick="AddToCalendarAsync">📅 Tilføj til kalender</button>
                        }
                        else
                        {
                            <div class="club-empty">✔ Tilføjet til kalenderen</div>
                        }
                    }
                    <a class="club-see-all" href="/g/@Slug/ready">Se mere →</a>
                }
                else if (_status.Session.Phase == "Playing")
                {
                    @if (_latestLiveUpdate is not null)
                    {
                        <div class="ready-active-header">🎮 @_latestLiveUpdate.Text <span style="color:var(--muted)">(@_latestLiveUpdate.CreatedAt.ToLocalTime().ToString("HH:mm"))</span></div>
                        <div class="club-empty">Så du ved hvor langt de er, før du logger på.</div>
                    }
                    else
                    {
                        <div class="club-empty">🎮 I spiller nu - live highlights og kampstatistik.</div>
                    }
                    <a class="club-see-all" href="/g/@Slug/ready">Se live →</a>
                }
                else
                {
                    <div class="club-empty">🎬 Aftenen opsummeres.</div>
                    <a class="club-see-all" href="/g/@Slug/ready">Se resumé →</a>
                }
            </div>

            <div class="club-section">
                <div class="club-section-title">Kommende begivenheder</div>
                @if (!_upcomingEvents.Any())
                {
                    <div class="club-empty">Ingen kommende begivenheder.</div>
                }
                @foreach (var ev in _upcomingEvents)
                {
                    var rsvps = _rsvpsByEvent.GetValueOrDefault(ev.Id, []);
                    var myRsvp = rsvps.FirstOrDefault(r => r.MemberName == _member.Name);
                    var yes = rsvps.Where(r => r.Status == "Yes").ToList();
                    var no = rsvps.Where(r => r.Status == "No").ToList();
                    <div class="club-event-row">
                        <div class="club-event-date">@ev.EventDate.ToLocalTime().ToString("dd MMM")</div>
                        <div style="flex:1">
                            <div class="club-event-title">@ev.Title</div>
                            @if (!string.IsNullOrEmpty(ev.Location))
                            {
                                <div class="club-event-loc">📍 @ev.Location</div>
                            }
                            <div class="rsvp-row" style="margin-top:8px">
                                <button class="rsvp-btn @(myRsvp?.Status == "Yes" ? "rsvp-active going" : "")" @onclick='() => SetRsvpAsync(ev.Id, "Yes")'>✅ Ja</button>
                                <button class="rsvp-btn @(myRsvp?.Status == "No" ? "rsvp-active cant" : "")" @onclick='() => SetRsvpAsync(ev.Id, "No")'>❌ Nej</button>
                            </div>
                            @if (yes.Count > 0 || no.Count > 0)
                            {
                                <div class="rsvp-reactions">
                                    @if (yes.Count > 0) { <div class="rsvp-reaction-line yes">✅ @string.Join(", ", yes.Select(r => r.MemberName))</div> }
                                    @if (no.Count > 0) { <div class="rsvp-reaction-line no">❌ @string.Join(", ", no.Select(r => r.MemberName))</div> }
                                </div>
                            }
                        </div>
                    </div>
                }
                <a class="club-see-all" href="/g/@Slug/calendar">Se kalender →</a>
            </div>

            <div class="club-section">
                <div class="club-section-title">Opslagstavle</div>
                @if (!_recentPosts.Any())
                {
                    <div class="club-empty">Ingen opslag endnu.</div>
                }
                @foreach (var p in _recentPosts)
                {
                    <div class="club-post-row">
                        <div class="club-post-author">@p.Member.Name</div>
                        <div class="club-post-content">@p.Content</div>
                        @if (!string.IsNullOrWhiteSpace(p.ImageFileName))
                        {
                            <img class="club-post-thumb" src="/photo/@p.ImageFileName" loading="lazy" />
                        }
                        <div class="club-post-time">@p.PostedAt.ToLocalTime().ToString("dd MMM HH:mm")</div>
                    </div>
                }
                <a class="club-see-all" href="/g/@Slug/board">📌 Del noget sjovt →</a>
            </div>

            <div class="club-section">
                <div class="club-section-title">
                    Dokumenter
                    @if (_unreadCount > 0) { <span class="club-badge">@_unreadCount nyt</span> }
                </div>
                @if (!_recentDocs.Any())
                {
                    <div class="club-empty">Ingen dokumenter endnu.</div>
                }
                @foreach (var d in _recentDocs)
                {
                    <div class="club-task-row">
                        <div class="club-task-title">@d.Title</div>
                    </div>
                }
                <a class="club-see-all" href="/g/@Slug/docs">Se alle →</a>
            </div>

            <div class="club-section">
                <div class="club-section-title">Åbne opgaver</div>
                @if (!_openTasks.Any())
                {
                    <div class="club-empty">Ingen åbne opgaver.</div>
                }
                @foreach (var t in _openTasks)
                {
                    <div class="club-task-row">
                        <div class="club-task-title">@t.Title</div>
                        <div class="club-task-meta">
                            @if (!string.IsNullOrEmpty(t.AssignedToName)) { <span>👤 @t.AssignedToName</span> }
                            @if (t.DueDate.HasValue) { <span>📅 @t.DueDate.Value.ToString("dd MMM")</span> }
                        </div>
                    </div>
                }
                <a class="club-see-all" href="/g/@Slug/tasks">Se alle →</a>
            </div>

        </div>
        }
    </div>
}

<style>
    .task-body { padding: 16px; }
    .task-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .task-title { font-size: 18px; font-weight: 800; margin: 0; color: var(--text); }
    .task-add-btn { background: var(--accent); color: white; border: none; border-radius: 10px; padding: 9px 16px; font-size: 13px; font-weight: 700; cursor: pointer; }
    .task-filter-row { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
    .task-filter-row label { font-size: 12px; font-weight: 600; color: var(--muted); }
    .task-filter-row .task-input { width: auto; min-width: 180px; }
    .task-form { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 20px; margin-bottom: 20px; }
    .task-field { margin-bottom: 12px; }
    .task-field label { display: block; font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 5px; }
    .task-row { display: flex; gap: 12px; }
    .task-row .task-field { flex: 1; }
    .task-input { width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; color: var(--text); font-size: 14px; outline: none; }
    .task-input:focus { border-color: var(--accent); }
    .task-input option { background: var(--surface); color: var(--text); }
    .task-textarea { resize: vertical; min-height: 60px; font-family: inherit; }
    .task-save-btn { width: 100%; padding: 12px; border-radius: 10px; border: none; background: #16a34a; color: white; font-size: 14px; font-weight: 700; cursor: pointer; }
    .task-save-btn:disabled { opacity: .4; cursor: default; }
    .task-row-item { display: flex; align-items: flex-start; gap: 12px; padding: 12px 10px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 8px; background: var(--card); }
    .task-row-mine { border-color: #6366f1; background: rgba(99,102,241,.08); }
    .task-badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; margin: 2px 0 6px; }
    .task-badge-open    { background: var(--red);    color: white; }
    .task-badge-claimed { background: #d97706;       color: white; }
    .task-badge-done    { background: var(--green);  color: white; }
    .task-complete-btn  { width: auto; padding: 8px 16px; border-radius: 10px; border: none; background: var(--accent); color: white; font-size: 13px; font-weight: 700; cursor: pointer; }
    .task-info { flex: 1; }
    .task-item-title { font-size: 15px; font-weight: 600; margin-bottom: 4px; color: var(--text); }
    .task-item-desc { font-size: 13px; color: var(--muted); margin-bottom: 4px; }
    .task-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--muted); }
    .task-overdue { color: var(--red) !important; }
    .task-del-btn { background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 14px; padding: 2px 6px; flex-shrink: 0; }
    .task-del-btn:hover { color: var(--red); }
    .task-take-btn { background: transparent; border: 1px solid rgba(59,130,246,.4); color: #60a5fa; border-radius: 8px; padding: 4px 10px; font-size: 12px; cursor: pointer; margin-top: 8px; }
    .task-take-btn:hover { background: rgba(59,130,246,.1); }

    .maintask-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; align-items: start; }
    @@media (max-width: 640px) { .maintask-grid { grid-template-columns: 1fr; } }
    .maintask-group { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 16px; margin-bottom: 0; }
    .maintask-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .maintask-title { font-size: 16px; font-weight: 800; color: var(--text); }
    .maintask-count { font-size: 12px; font-weight: 700; color: var(--muted); background: var(--surface); border-radius: 999px; padding: 2px 10px; }
    .maintask-dod { font-size: 12px; color: var(--muted); background: var(--surface); border-radius: 8px; padding: 8px 10px; margin-bottom: 12px; cursor: pointer; }
    .maintask-dod-edit { margin-bottom: 12px; }
    .dod-label { display: block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--accent); margin-bottom: 3px; }

    .club-sections { padding: 16px; display: flex; flex-direction: column; gap: 20px; }
    .club-section { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 16px; }
    .club-section-title { font-size: 13px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 12px; }
    .club-empty { font-size: 13px; color: var(--muted); padding: 8px 0; }
    .club-see-all { display: block; font-size: 12px; color: var(--accent); text-decoration: none; margin-top: 12px; }
    .club-see-all:hover { text-decoration: underline; }
    .club-event-row { display: flex; gap: 14px; align-items: flex-start; padding: 8px 0; border-bottom: 1px solid var(--border); }
    .club-event-row:last-of-type { border-bottom: none; }
    .club-event-date { font-size: 12px; font-weight: 700; color: var(--accent); min-width: 44px; padding-top: 2px; }
    .club-event-title { font-size: 14px; font-weight: 600; color: var(--text); }
    .club-event-loc { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .club-task-row { padding: 8px 0; border-bottom: 1px solid var(--border); }
    .club-task-row:last-of-type { border-bottom: none; }
    .club-task-title { font-size: 14px; font-weight: 600; margin-bottom: 4px; color: var(--text); }
    .club-task-meta { display: flex; gap: 12px; font-size: 12px; color: var(--muted); }
    .club-post-row { padding: 8px 0; border-bottom: 1px solid var(--border); }
    .club-post-row:last-of-type { border-bottom: none; }
    .club-post-author { font-size: 12px; font-weight: 700; color: #60a5fa; margin-bottom: 3px; }
    .club-post-content { font-size: 14px; margin-bottom: 3px; color: var(--text); }
    .club-post-thumb { max-width: 100%; border-radius: 8px; margin: 4px 0; display: block; }
    .club-post-time { font-size: 11px; color: var(--muted); }

    .ready-active-header { font-size: 13px; color: var(--muted); margin-bottom: 10px; }
    .ready-responses { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
    .ready-chip { padding: 5px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .ready-chip.ready-yes { background: rgba(34,197,94,.15); color: var(--green); }
    .ready-chip.ready-no { background: rgba(148,163,184,.12); color: var(--muted); }
    .ready-chip.ready-watch { background: rgba(96,165,250,.15); color: #60a5fa; }
    .ready-none { font-size: 12px; color: var(--muted); }
    .ready-answer-row { display: flex; gap: 8px; margin-bottom: 12px; }
    .ready-answer-btn { flex: 1; padding: 10px 4px; border-radius: 10px; border: 2px solid var(--border); font-size: 12px; font-weight: 700; cursor: pointer; background: var(--surface); color: var(--muted); }
    .ready-answer-btn.selected { transform: scale(1.02); }
    .ready-answer-btn.yes.selected { background: #16a34a; border-color: #16a34a; color: white; }
    .ready-answer-btn.no.selected { background: rgba(248,113,113,.15); border-color: var(--red); color: var(--red); }
    .ready-answer-btn.watch.selected { background: rgba(96,165,250,.2); border-color: #60a5fa; color: #60a5fa; }
    .cal-add-inline-btn { width: 100%; padding: 10px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); color: var(--text); font-size: 12px; font-weight: 600; cursor: pointer; margin-bottom: 8px; }

    .rsvp-row { display: flex; gap: 6px; }
    .rsvp-btn { flex: 1; padding: 8px 4px; border-radius: 8px; border: 1px solid var(--border); background: var(--card); color: var(--muted); font-size: 12px; font-weight: 700; cursor: pointer; }
    .rsvp-btn.rsvp-active.going { background: rgba(34,197,94,.15); border-color: var(--green); color: var(--green); }
    .rsvp-btn.rsvp-active.cant { background: rgba(248,113,113,.15); border-color: var(--red); color: var(--red); }
    .rsvp-reactions { margin-top: 6px; display: flex; flex-direction: column; gap: 2px; }
    .rsvp-reaction-line { font-size: 11px; color: var(--muted); }
    .rsvp-reaction-line.yes { color: var(--green); }
    .rsvp-reaction-line.no { color: var(--red); }
</style>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Member? _member;
    private Group? _group;
    private bool _loaded;
    private int _unreadCount;
    private List<Document> _recentDocs = [];
    private List<CalendarEvent> _upcomingEvents = [];
    private List<Assignment> _openTasks = [];
    private List<BulletinPost> _recentPosts = [];
    private Dictionary<Guid, List<EventRsvp>> _rsvpsByEvent = [];

    private SessionStatus? _status;
    private LiveUpdate? _latestLiveUpdate;
    private ReadyCheck? _activeCheck;
    private List<ReadyCheckResponse> _responses = [];
    private ReadyCheckResponse? _myResponse;
    private bool _addedToCalendar;

    // Task-board-first front page: active once the group has any MainTasks
    // (see Program.cs seeding for Bogshoppen) - otherwise the dashboard above
    // still renders as before, unaffected.
    private List<MainTask> _mainTasks = [];
    private List<Assignment> _openTasksFull = [];
    private List<Member> _members = [];
    private bool _adding, _addingMainTask;
    private string _newTitle = "", _newMainTaskId = "", _newAssignedTo = "", _newDesc = "", _newMainTaskTitle = "";
    private string _filterAssignedTo = "";
    private DateTime? _newDue;
    private Guid? _editingDodId;
    private string _editDodText = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var session = await ClubAuth.ResolveSessionAsync(JS, Db, Slug);
        if (session is null)
        {
            Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true);
            return;
        }

        _member = session.Member;
        _group = session.Member.Group;

        await RefreshAsync();
        Broadcast.Subscribe(_group.Id, OnBroadcast);
        _loaded = true;

        StateHasChanged();

        try
        {
            var publicKey = PushService.GetPublicKey();
            await JS.InvokeVoidAsync("clubJs.subscribePush", publicKey, _group.Id, _member.Name);
        }
        catch { }
    }

    private async Task RefreshAsync()
    {
        var now = DateTime.UtcNow;

        _unreadCount = await Db.Documents
            .Where(d => d.GroupId == _group!.Id && !d.Reads.Any(r => r.MemberId == _member!.Id))
            .CountAsync();

        _recentDocs = await Db.Documents
            .Where(d => d.GroupId == _group!.Id)
            .OrderByDescending(d => d.UploadedAt)
            .Take(3)
            .ToListAsync();

        _upcomingEvents = await Db.Events
            .Where(e => e.GroupId == _group!.Id && e.EventDate >= now)
            .OrderBy(e => e.EventDate)
            .Take(3)
            .ToListAsync();

        var eventIds = _upcomingEvents.Select(e => e.Id).ToList();
        _rsvpsByEvent = (await Db.EventRsvps.Where(r => eventIds.Contains(r.EventId)).ToListAsync())
            .GroupBy(r => r.EventId).ToDictionary(g => g.Key, g => g.ToList());

        _openTasks = await Db.Assignments
            .Where(a => a.GroupId == _group!.Id && !a.IsCompleted)
            .OrderBy(a => a.DueDate)
            .Take(3)
            .ToListAsync();

        _mainTasks = await Db.MainTasks
            .Where(m => m.GroupId == _group!.Id)
            .OrderBy(m => m.SortOrder)
            .ToListAsync();

        if (_mainTasks.Any())
        {
            _openTasksFull = await Db.Assignments
                .Where(a => a.GroupId == _group!.Id && !a.IsCompleted)
                .OrderBy(a => a.DueDate)
                .ToListAsync();

            _members = await Db.Members
                .Where(m => m.GroupId == _group!.Id)
                .OrderBy(m => m.Name)
                .ToListAsync();
        }

        _recentPosts = await Db.Posts
            .Include(p => p.Member)
            .Where(p => p.GroupId == _group!.Id)
            .OrderByDescending(p => p.PostedAt)
            .Take(3)
            .ToListAsync();

        _status = await SessionStatus.GetActiveSessionAsync(_group!.Id);

        // Surfacing the latest score/side right on Overblik lets someone who
        // isn't playing yet gauge "1-0, I'll wait a bit" vs "3-2, tell them
        // to wait for me" without opening the full Ready page.
        _latestLiveUpdate = _status is not null && _status.Session.Phase == "Playing"
            ? await Db.LiveUpdates.Where(u => u.PlaySessionId == _status.Session.Id).OrderByDescending(u => u.CreatedAt).FirstOrDefaultAsync()
            : null;

        if (_status is not null && _status.Session.Phase == "Invitations")
        {
            _activeCheck = await Db.ReadyChecks
                .Where(r => r.GroupId == _group.Id && r.ExpiresAt > now)
                .OrderByDescending(r => r.CreatedAt)
                .FirstOrDefaultAsync();

            if (_activeCheck is not null)
            {
                _responses = await Db.ReadyCheckResponses.Where(r => r.ReadyCheckId == _activeCheck.Id).ToListAsync();
                _myResponse = _responses.FirstOrDefault(r => r.MemberName == _member!.Name);
                _addedToCalendar = await Db.Events.AnyAsync(e => e.GroupId == _group.Id
                    && e.Title == $"🎮 Spilaften ({_activeCheck.CreatedByName})" && e.EventDate == _activeCheck.CreatedAt.AddMinutes(_activeCheck.Minutes));
            }
            else
            {
                _responses = [];
                _myResponse = null;
            }
        }
        else
        {
            _activeCheck = null;
            _responses = [];
            _myResponse = null;
        }
    }

    private async Task AddTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle) || string.IsNullOrEmpty(_newMainTaskId)) return;

        var mainTaskId = Guid.Parse(_newMainTaskId);
        var mainTaskTitle = _mainTasks.First(mt => mt.Id == mainTaskId).Title;
        var title = PrefixWithMainTask(_newTitle.Trim(), mainTaskTitle);
        Db.Assignments.Add(new Assignment
        {
            GroupId = _group!.Id,
            MainTaskId = mainTaskId,
            Title = title,
            Description = string.IsNullOrWhiteSpace(_newDesc) ? null : _newDesc.Trim(),
            AssignedToName = string.IsNullOrWhiteSpace(_newAssignedTo) ? null : _newAssignedTo,
            DueDate = _newDue?.ToUniversalTime(),
            CreatedByName = _member!.Name,
        });
        await Db.SaveChangesAsync();
        _newTitle = ""; _newMainTaskId = ""; _newAssignedTo = ""; _newDesc = ""; _newDue = null; _adding = false;
        await RefreshAsync();
        _ = PushService.SendToGroupAsync(Db, _group.Id, _member.Name, "✅ Ny opgave", $"{_member.Name}: {title}");
    }

    // Every subtask title starts with its main task's name, e.g. "Salg: Skriv
    // RABAT på skilt" - matches how tasks were already being titled by hand
    // before MainTask existed as a real field, so it stays readable in lists
    // that show tasks without their group header.
    public static string PrefixWithMainTask(string title, string mainTaskTitle)
    {
        var prefix = $"{mainTaskTitle}: ";
        return title.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? title : prefix + title;
    }

    private async Task TakeTaskAsync(Guid id)
    {
        var t = await Db.Assignments.FindAsync(id);
        if (t == null) return;
        t.AssignedToName = _member!.Name;
        await Db.SaveChangesAsync();
        await RefreshAsync();
        _ = PushService.SendToGroupAsync(Db, _group!.Id, _member.Name, "👋 Opgave taget", $"{_member.Name} tager: {t.Title}");
    }

    private async Task CompleteTaskAsync(Guid id)
    {
        var t = await Db.Assignments.FindAsync(id);
        if (t == null) return;
        t.IsCompleted = true; t.CompletedAt = DateTime.UtcNow; t.CompletedByName = _member!.Name;
        await Db.SaveChangesAsync();
        await RefreshAsync();
        _ = PushService.SendToGroupAsync(Db, _group!.Id, _member.Name, "✅ Opgave færdig", $"{_member.Name}: {t.Title}");
    }

    private async Task DeleteTaskAsync(Guid id)
    {
        var t = await Db.Assignments.FindAsync(id);
        if (t != null) { Db.Assignments.Remove(t); await Db.SaveChangesAsync(); await RefreshAsync(); }
    }

    private async Task AssignMainTaskAsync(Guid taskId, string mainTaskId)
    {
        if (string.IsNullOrEmpty(mainTaskId)) return;
        var t = await Db.Assignments.FindAsync(taskId);
        if (t == null) return;
        t.MainTaskId = Guid.Parse(mainTaskId);
        await Db.SaveChangesAsync();
        await RefreshAsync();
    }

    private async Task AddMainTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_newMainTaskTitle)) return;
        Db.MainTasks.Add(new MainTask
        {
            GroupId = _group!.Id,
            Title = _newMainTaskTitle.Trim(),
            SortOrder = _mainTasks.Count,
        });
        await Db.SaveChangesAsync();
        _newMainTaskTitle = ""; _addingMainTask = false;
        await RefreshAsync();
    }

    private void StartEditDod(MainTask mt)
    {
        _editingDodId = mt.Id;
        _editDodText = mt.DefinitionOfDone ?? "";
    }

    private async Task SaveDodAsync(Guid mainTaskId)
    {
        var mt = await Db.MainTasks.FindAsync(mainTaskId);
        if (mt == null) return;
        mt.DefinitionOfDone = string.IsNullOrWhiteSpace(_editDodText) ? null : _editDodText.Trim();
        await Db.SaveChangesAsync();
        _editingDodId = null;
        await RefreshAsync();
    }

    private async Task RespondAsync(string status)
    {
        if (_activeCheck is null) return;

        var existing = await Db.ReadyCheckResponses
            .FirstOrDefaultAsync(r => r.ReadyCheckId == _activeCheck.Id && r.MemberName == _member!.Name);
        if (existing is not null) existing.Status = status;
        else Db.ReadyCheckResponses.Add(new ReadyCheckResponse { ReadyCheckId = _activeCheck.Id, MemberName = _member!.Name, Status = status });

        await Db.SaveChangesAsync();
        await RefreshAsync();
        StateHasChanged();
    }

    // Calendar entries are opt-in per person now, not created automatically
    // for the whole group when the ready-check goes out.
    private async Task AddToCalendarAsync()
    {
        if (_activeCheck is null || _group is null) return;
        Db.Events.Add(new CalendarEvent
        {
            GroupId = _group.Id,
            Title = $"🎮 Spilaften ({_activeCheck.CreatedByName})",
            EventDate = _activeCheck.CreatedAt.AddMinutes(_activeCheck.Minutes),
            CreatedByName = _member!.Name,
        });
        await Db.SaveChangesAsync();
        _addedToCalendar = true;
        StateHasChanged();
    }

    private async Task SetRsvpAsync(Guid eventId, string status)
    {
        var existing = await Db.EventRsvps.FirstOrDefaultAsync(r => r.EventId == eventId && r.MemberName == _member!.Name);
        if (existing is not null)
        {
            existing.Status = status;
            existing.RespondedAt = DateTime.UtcNow;
        }
        else
        {
            Db.EventRsvps.Add(new EventRsvp { EventId = eventId, MemberName = _member!.Name, Status = status });
        }
        await Db.SaveChangesAsync();
        await RefreshAsync();
        StateHasChanged();
    }

    private void OnBroadcast() => InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    private async Task LeaveAsync()
    {
        await JS.InvokeVoidAsync("clubJs.clearSession");
        Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true);
    }

    public void Dispose()
    {
        if (_group != null) Broadcast.Unsubscribe(_group.Id, OnBroadcast);
    }
}
