<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#0f1117" />
    <link rel="manifest" href="/manifest.json" />
    <title>Club</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.server.js"></script>
    <script>
        window.clubJs = {
            getSession: () => localStorage.getItem('club_session'),
            setSession: (v) => localStorage.setItem('club_session', v),
            clearSession: () => localStorage.removeItem('club_session'),
            scrollToBottom: (id) => {
                var el = document.getElementById(id);
                if (el) el.scrollTop = el.scrollHeight;
            }
        };
    </script>
    <div id="components-reconnect-modal">
        <span class="reconnect-msg">Forbinder igen...</span>
        <span class="reconnect-failed-msg">Forbindelsen er tabt — <button onclick="location.reload()">Genindlæs</button></span>
    </div>
</body>
</html>
