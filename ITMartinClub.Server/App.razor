<!DOCTYPE html>
<html lang="da">
<head>
    <script>
        // Applied before first paint to avoid a flash of the wrong theme -
        // must run this early (top of <head>), not deferred like other scripts.
        (function () {
            var theme = localStorage.getItem('club_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#0f1117" />
    <link rel="manifest" href="/manifest.json" />
    <title>Club</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css?v=@CacheBuster" />
    <link rel="stylesheet" href="ITMartinClub.Server.styles.css?v=@CacheBuster" />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.server.js"></script>
    <script>
        window.clubJs = {
            getSession: function () {
                var ls = localStorage.getItem('club_session');
                if (ls) return ls;
                var m = document.cookie.match(/(?:^|;\s*)club_session=([^;]+)/);
                return m ? m[1] : null;
            },
            setSession: function (v) {
                localStorage.setItem('club_session', v);
                document.cookie = 'club_session=' + v + ';path=/;max-age=2592000;samesite=lax';
            },
            clearSession: function () {
                localStorage.removeItem('club_session');
                document.cookie = 'club_session=;path=/;max-age=0';
            },
            scrollToBottom: (id) => { var el = document.getElementById(id); if (el) el.scrollTop = el.scrollHeight; },

            registerSW: async function () {
                if (!('serviceWorker' in navigator)) return;
                try { await navigator.serviceWorker.register('/sw.js'); } catch (e) {}
            },

            subscribePush: async function (publicKey, groupId, memberName) {
                if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
                try {
                    if (Notification.permission === 'default') await Notification.requestPermission();
                    if (Notification.permission !== 'granted') return;
                    var reg = await navigator.serviceWorker.ready;
                    var existing = await reg.pushManager.getSubscription();
                    var sub = existing || await reg.pushManager.subscribe({
                        userVisibleOnly: true,
                        applicationServerKey: clubJs._toBytes(publicKey)
                    });
                    var j = sub.toJSON();
                    await fetch('/api/push/subscribe', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ groupId, memberName, endpoint: j.endpoint, p256dh: j.keys.p256dh, auth: j.keys.auth })
                    });
                } catch (e) {}
            },

            _toBytes: function (b64url) {
                var pad = '='.repeat((4 - b64url.length % 4) % 4);
                var b64 = (b64url + pad).replace(/-/g, '+').replace(/_/g, '/');
                var raw = atob(b64);
                var arr = new Uint8Array(raw.length);
                for (var i = 0; i < raw.length; i++) arr[i] = raw.charCodeAt(i);
                return arr;
            }
        };

        clubJs.registerSW();
    </script>
    <div id="components-reconnect-modal">
        <span class="reconnect-msg">Forbinder igen...</span>
        <span class="reconnect-failed-msg">Forbindelsen er tabt — <button onclick="location.reload()">Genindlæs</button></span>
    </div>

    <button id="themeToggleBtn" title="Skift lys/mørk visning"
            style="position:fixed;bottom:20px;right:20px;z-index:9999;width:52px;height:52px;border-radius:50%;border:2px solid #fff;background:linear-gradient(135deg,#60a5fa,#3b82f6);color:#fff;font-size:22px;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center">
        🌓
    </button>
    <script>
    (function () {
        var btn = document.getElementById('themeToggleBtn');
        function sync() {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            btn.textContent = current === 'light' ? '🌙' : '☀️';
        }
        btn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('club_theme', next);
            sync();
        });
        sync();
    })();
    </script>
<script>
(function(){
    var vid = localStorage.getItem('_mid');
    if (!vid) { vid = Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2); localStorage.setItem('_mid', vid); }
    function track(path, title, referrer) {
        if (location.search.indexOf('claude_test=1') !== -1) return;
        fetch('https://stats.itmartin.dk/api/hit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: path, title: title, referrer: referrer, visitorId: vid, host: location.hostname }),
            keepalive: true
        }).catch(function(){});
    }
    track(location.pathname + location.search, document.title, document.referrer);
    document.addEventListener('click', function(e) {
        var a = e.target.closest('a');
        if (!a || !a.href || a.href.startsWith('javascript')) return;
        var href = a.getAttribute('href') || a.href;
        track('click:' + href, a.textContent.trim().slice(0, 80), location.pathname);
    }, true);
})();
</script>
</body>
</html>

@code {
    // Query-string cache-buster - Cloudflare Tunnel caches static assets like
    // app.css separately from HTML, so a redeploy can keep serving the old
    // CSS until either the cache is purged or the URL changes. Ticks change
    // on every process start, which is enough to force a fresh fetch.
    private static readonly long CacheBuster = DateTime.UtcNow.Ticks;
}
