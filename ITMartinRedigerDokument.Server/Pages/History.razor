@page "/g/{Slug}/history"
@rendermode InteractiveServer
@inject RedigerDbContext Db
@inject RedigerAuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime Js

@if (_group is null)
{
    <p style="padding:20px">Indlæser...</p>
}
else
{
    <div class="home-wrap">
        <RedigerNav Slug="@Slug" GroupName="@_group.Name" MemberLabel="@($"Logget ind som {_me?.Name}")" Active="history" OnLogout="LeaveAsync" />

        <div class="home-body">
            <InfoBanners PageKey="history" Beskrivelse="Her kan I se, hvad der allerede er blevet lavet - hvem der gjorde det, og hvornår." />

            <h2 class="page-title">Udførte opgaver (@_done.Count)</h2>

            @if (_done.Count == 0)
            {
                <div class="hint">Ingen udførte opgaver endnu.</div>
            }
            @foreach (var a in _done)
            {
                <div class="history-row">
                    <div class="history-title">@a.Title</div>
                    <div class="history-meta">
                        <span>@(_mainTaskTitleById.GetValueOrDefault(a.MainTaskId ?? Guid.Empty, "—"))</span>
                        @if (!string.IsNullOrEmpty(a.AssignedToName)) { <span>👤 @a.AssignedToName</span> }
                        @if (a.CompletedAt.HasValue) { <span>✓ @a.CompletedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span> }
                    </div>
                </div>
            }
        </div>
    </div>

    <style>
        .home-wrap { max-width: 900px; margin: 0 auto; color: var(--text); }
        .home-body { padding: 16px 16px 64px; }
        .page-title { font-size: 18px; font-weight: 800; margin: 0 0 16px; color: var(--text); }
        .hint { color: var(--muted); font-size: 13px; padding: 10px 0; }
        .history-row { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 12px 16px; margin-bottom: 8px; }
        .history-title { font-size: 14px; font-weight: 600; margin-bottom: 4px; color: var(--text); text-decoration: line-through; opacity: .8; }
        .history-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--muted); }
    </style>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Group? _group;
    private Member? _me;
    private List<Assignment> _done = [];
    private Dictionary<Guid, string> _mainTaskTitleById = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _group = await Db.Groups.FirstOrDefaultAsync(g => g.Slug == Slug);
        if (_group is null) return;

        var session = await Auth.ResolveSessionAsync(Js, Db, Slug);
        if (session is null)
        {
            Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true);
            return;
        }
        _me = session.Member;

        _mainTaskTitleById = (await Db.MainTasks.Where(m => m.GroupId == _group.Id).ToListAsync())
            .ToDictionary(m => m.Id, m => m.Title);

        _done = await Db.Assignments
            .Where(a => a.GroupId == _group.Id && a.IsCompleted)
            .OrderByDescending(a => a.CompletedAt)
            .Take(100)
            .ToListAsync();

        StateHasChanged();
    }

    private async Task LeaveAsync()
    {
        await Js.InvokeVoidAsync("redigerJs.clearSession");
        Nav.NavigateTo($"/g/{Slug}/join", forceLoad: true);
    }
}
